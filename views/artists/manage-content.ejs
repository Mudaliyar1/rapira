<%- include('../partials/artist-header') %>



<!-- Content Management -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="fw-bold mb-0 section-title">Your Content</h2>
  <a href="/artists/upload-content" class="btn btn-dark">
    Create New
  </a>
</div>
<div class="card mb-5">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-dark text-white">
          <tr>
            <th style="width: 40%;">Content</th>
            <th>Type</th>
            <th>Upload Date</th>
            <th>Views</th>
            <th>Featured</th>
            <th>Actions</th>
          </tr>
        </thead>
          <tbody>
            <% if (content && content.length > 0) { %>
              <% content.forEach(item => { %>
                <tr class="border-bottom">
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="me-3" style="width: 50px; height: 50px;">
                        <img src="<%= item.thumbnailUrl %>" alt="<%= item.title %>" class="img-fluid rounded" style="width: 50px; height: 50px; object-fit: cover;">
                      </div>
                      <div>
                        <h6 class="mb-0 fw-bold"><%= item.title %></h6>
                        <small class="text-muted"><%= item.description ? (item.description.length > 40 ? item.description.substring(0, 40) + '...' : item.description) : '' %></small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge <%= item.type === 'song' ? 'bg-primary' : item.type === 'video' ? 'bg-danger' : 'bg-info' %> rounded-pill">
                      <%= item.type.charAt(0).toUpperCase() + item.type.slice(1) %>
                    </span>
                  </td>
                  <td><%= new Date(item.createdAt).toLocaleDateString() %></td>
                  <td><%= item.views %> <small class="text-muted">views</small></td>
                  <td>
                    <span class="badge <%= item.featured ? 'bg-success' : 'bg-secondary' %> rounded-pill">
                      <%= item.featured ? 'Featured' : 'Not Featured' %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex">
                      <a href="<%= item.fileUrl %>"
                         class="btn btn-sm btn-light me-1 content-link"
                         data-type="<%= item.type %>"
                         data-title="<%= item.title %>"
                         data-artist="<%= artist.user ? artist.user.name : 'Unknown Artist' %>"
                         data-thumbnail="<%= item.thumbnailUrl %>">
                        <i class="bi bi-eye"></i>
                      </a>
                      <a href="/artists/content/<%= item._id %>/edit" class="btn btn-sm btn-light me-1">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <a href="/artists/content/<%= item._id %>/delete" class="btn btn-sm btn-light">
                        <i class="bi bi-trash"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-5">
                  <div class="empty-state">
                    <i class="bi bi-file-earmark-music fs-1 text-muted mb-3"></i>
                    <h5 class="fw-bold">No Content Found</h5>
                    <p class="text-muted mb-3">You haven't uploaded any content yet.</p>
                    <a href="/artists/upload-content" class="btn btn-primary">
                      <i class="bi bi-plus-circle me-2"></i> Upload Your First Content
                    </a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Custom CSS for dashboard styling -->
<style>
  .section-title {
    position: relative;
    padding-bottom: 8px;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 40px;
    background-color: #0d6efd;
  }

  .card {
    border: none;
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    margin-top: 10px;
  }

  .card-header {
    border-bottom: 1px solid #eee;
    background-color: #fff;
  }

  .table {
    margin-bottom: 0;
  }

  .table th {
    font-weight: 600;
    border-top: none;
    border-bottom: none;
    padding: 12px 15px;
  }

  .bg-dark {
    background-color: #212529 !important;
  }

  .text-white {
    color: #fff !important;
  }

  .table td {
    padding: 15px;
    vertical-align: middle;
    border-bottom: 1px solid #f0f0f0;
  }

  .table tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .badge.rounded-pill {
    padding: 0.5em 0.8em;
    font-weight: 500;
  }

  .empty-state {
    padding: 2rem 0;
  }

  .btn-light {
    background-color: #f0f0f0;
    border-color: #ddd;
    color: #666;
  }

  .btn-light:hover {
    background-color: #e0e0e0;
    border-color: #ccc;
    color: #333;
  }

  .btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
  }
</style>

<%- include('../partials/artist-footer') %>
