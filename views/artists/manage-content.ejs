<%- include('../partials/artist-header') %>

<!-- Search and Filter Section -->
<div class="glass-card-dark border border-secondary mb-4">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">Search & Filter Content</h5>
  </div>
  <div class="card-body">
    <form method="GET" action="/artists/manage-content" id="contentSearchForm">
      <div class="row g-3">
        <div class="col-md-3">
          <label for="search" class="form-label text-white">Search Content</label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-white">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control bg-dark border-secondary text-white"
                   id="search" name="search" placeholder="Search by title, description, or tags..."
                   value="<%= searchParams.search %>">
          </div>
        </div>
        <div class="col-md-2">
          <label for="type" class="form-label text-white">Type</label>
          <select class="form-select bg-dark border-secondary text-white" id="type" name="type">
            <option value="all">All Types</option>
            <option value="song" <%= searchParams.type === 'song' ? 'selected' : '' %>>Music</option>
            <option value="video" <%= searchParams.type === 'video' ? 'selected' : '' %>>Video</option>
            <option value="lyrics" <%= searchParams.type === 'lyrics' ? 'selected' : '' %>>Lyrics</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="featured" class="form-label text-white">Featured</label>
          <select class="form-select bg-dark border-secondary text-white" id="featured" name="featured">
            <option value="all">All Content</option>
            <option value="true" <%= searchParams.featured === 'true' ? 'selected' : '' %>>Featured</option>
            <option value="false" <%= searchParams.featured === 'false' ? 'selected' : '' %>>Not Featured</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="dateRange" class="form-label text-white">Date Range</label>
          <select class="form-select bg-dark border-secondary text-white" id="dateRange" name="dateRange">
            <option value="all">All Time</option>
            <option value="today" <%= searchParams.dateRange === 'today' ? 'selected' : '' %>>Today</option>
            <option value="this-week" <%= searchParams.dateRange === 'this-week' ? 'selected' : '' %>>This Week</option>
            <option value="this-month" <%= searchParams.dateRange === 'this-month' ? 'selected' : '' %>>This Month</option>
            <option value="this-year" <%= searchParams.dateRange === 'this-year' ? 'selected' : '' %>>This Year</option>
          </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <button type="submit" class="btn btn-primary me-2">
            <i class="bi bi-search me-1"></i> Search
          </button>
          <a href="/artists/manage-content" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-clockwise me-1"></i> Reset
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Statistics Section -->
<div class="glass-card-dark mb-4" id="statsSection">
  <div class="card-body">
    <div class="row text-center">
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-primary mb-1"><%= stats.total %></h4>
          <small class="text-white">Total Content</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-info mb-1"><%= stats.music %></h4>
          <small class="text-white">Music</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-danger mb-1"><%= stats.video %></h4>
          <small class="text-white">Videos</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-warning mb-1"><%= stats.lyrics %></h4>
          <small class="text-white">Lyrics</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-success mb-1"><%= stats.featured %></h4>
          <small class="text-white">Featured</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-light mb-1"><%= stats.filtered %></h4>
          <small class="text-white">Filtered Results</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Content Management -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="fw-bold mb-0 section-title">Your Content</h2>
  <a href="/artists/upload-content" class="btn btn-dark">
    Create New
  </a>
</div>
<div class="card mb-5">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-dark text-white">
          <tr>
            <th style="width: 40%; color: #000000 !important;">Content</th>
            <th style="color: #000000 !important;">Type</th>
            <th style="color: #000000 !important;">Upload Date</th>
            <th style="color: #000000 !important;">Views</th>
            <th style="color: #000000 !important;">Featured</th>
            <th style="color: #000000 !important;">Actions</th>
          </tr>
        </thead>
          <tbody>
            <% if (content && content.length > 0) { %>
              <% content.forEach(item => { %>
                <tr class="border-bottom">
                  <td style="color: #000000 !important;">
                    <div class="d-flex align-items-center">
                      <div class="me-3" style="width: 50px; height: 50px;">
                        <img src="<%= item.thumbnailUrl %>" alt="<%= item.title %>" class="img-fluid rounded" style="width: 50px; height: 50px; object-fit: cover;">
                      </div>
                      <div>
                        <h6 class="mb-0 fw-bold" style="color: #000000 !important;"><%= item.title %></h6>
                        <small style="color: #6c757d !important;"><%= item.description ? (item.description.length > 40 ? item.description.substring(0, 40) + '...' : item.description) : '' %></small>
                      </div>
                    </div>
                  </td>
                  <td style="color: #000000 !important;">
                    <span class="badge <%= item.type === 'song' ? 'bg-primary' : item.type === 'video' ? 'bg-danger' : 'bg-info' %> rounded-pill">
                      <%= item.type.charAt(0).toUpperCase() + item.type.slice(1) %>
                    </span>
                  </td>
                  <td style="color: #000000 !important;"><%= toISTDateString(item.createdAt) %></td>
                  <td style="color: #000000 !important;"><%= item.views %> <small style="color: #6c757d !important;">views</small></td>
                  <td style="color: #000000 !important;">
                    <span class="badge <%= item.featured ? 'bg-success' : 'bg-secondary' %> rounded-pill">
                      <%= item.featured ? 'Featured' : 'Not Featured' %>
                    </span>
                  </td>
                  <td style="color: #000000 !important;">
                    <div class="d-flex">
                      <a href="/content/<%= item._id %>"
                         class="btn btn-sm btn-light me-1">
                        <i class="bi bi-eye" style="color: #000000 !important;"></i>
                      </a>
                      <a href="/artists/content/<%= item._id %>/edit" class="btn btn-sm btn-light me-1">
                        <i class="bi bi-pencil" style="color: #000000 !important;"></i>
                      </a>
                      <a href="/artists/content/<%= item._id %>/delete" class="btn btn-sm btn-light">
                        <i class="bi bi-trash" style="color: #000000 !important;"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-5" style="color: #000000 !important;">
                  <div class="empty-state">
                    <i class="bi bi-file-earmark-music fs-1 text-muted mb-3"></i>
                    <h5 class="fw-bold" style="color: #000000 !important;">No Content Found</h5>
                    <p class="text-muted mb-3" style="color: #6c757d !important;">You haven't uploaded any content yet.</p>
                    <a href="/artists/upload-content" class="btn btn-primary">
                      <i class="bi bi-plus-circle me-2"></i> Upload Your First Content
                    </a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Custom CSS for dashboard styling -->
<style>
  .section-title {
    position: relative;
    padding-bottom: 8px;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 40px;
    background-color: #0d6efd;
  }

  .card {
    border: none;
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    margin-top: 10px;
  }

  .card-header {
    border-bottom: 1px solid #eee;
    background-color: #fff;
  }

  .table {
    margin-bottom: 0;
  }

  .table th {
    font-weight: 600;
    border-top: none;
    border-bottom: none;
    padding: 12px 15px;
  }

  .bg-dark {
    background-color: #212529 !important;
  }

  .text-white {
    color: #fff !important;
  }

  .table td {
    padding: 15px;
    vertical-align: middle;
    border-bottom: 1px solid #f0f0f0;
  }

  .table tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .badge.rounded-pill {
    padding: 0.5em 0.8em;
    font-weight: 500;
  }

  .empty-state {
    padding: 2rem 0;
  }

  .btn-light {
    background-color: #f0f0f0;
    border-color: #ddd;
    color: #666;
  }

  .btn-light:hover {
    background-color: #e0e0e0;
    border-color: #ccc;
    color: #333;
  }

  .btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
  }

  /* Glass card styling */
  .glass-card-dark {
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    border-radius: 0.375rem;
  }

  /* Form styling */
  .form-control:focus, .form-select:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
  }

  .input-group-text {
    border-color: #495057;
  }

  /* Stats styling */
  .stat-item {
    padding: 1rem;
    border-radius: 0.375rem;
    background: rgba(255, 255, 255, 0.05);
    margin: 0.25rem;
  }

  /* Smooth transitions */
  #statsSection {
    transition: all 0.3s ease;
  }

  /* Enhanced table styles */
  tbody tr {
    transition: all 0.2s ease;
  }

  /* Artist Content Table Readability Fix */
  .table {
    color: #212529 !important;
    background-color: #ffffff !important;
  }

  .table thead th {
    color: #ffffff !important;
    background-color: #212529 !important;
    border-color: #dee2e6 !important;
    font-weight: 600 !important;
  }

  .table tbody tr td {
    color: #212529 !important;
    background-color: #ffffff !important;
    border-color: #dee2e6 !important;
  }

  .table tbody tr td * {
    color: #212529 !important;
  }

  .table tbody tr td h6 {
    color: #212529 !important;
    font-weight: 600 !important;
  }

  .table tbody tr td small {
    color: #6c757d !important;
  }

  .table tbody tr:hover {
    background-color: #f8f9fa !important;
  }

  .table tbody tr:hover td {
    color: #212529 !important;
  }

  .table .badge {
    color: #ffffff !important;
  }

  .table .btn-light {
    background-color: #f8f9fa !important;
    border-color: #dee2e6 !important;
    color: #212529 !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-submit form on filter changes (with debounce for search)
  const searchInput = document.getElementById('search');
  const typeSelect = document.getElementById('type');
  const featuredSelect = document.getElementById('featured');
  const dateRangeSelect = document.getElementById('dateRange');
  const form = document.getElementById('contentSearchForm');

  let searchTimeout;

  // Debounced search
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      form.submit();
    }, 500); // 500ms delay
  });

  // Immediate filtering for dropdowns
  typeSelect.addEventListener('change', () => form.submit());
  featuredSelect.addEventListener('change', () => form.submit());
  dateRangeSelect.addEventListener('change', () => form.submit());

  // Show/hide stats section based on filters
  function toggleStatsSection() {
    const hasFilters = searchInput.value ||
                      typeSelect.value !== 'all' ||
                      featuredSelect.value !== 'all' ||
                      dateRangeSelect.value !== 'all';

    const statsSection = document.getElementById('statsSection');
    if (hasFilters) {
      statsSection.style.display = 'block';
    } else {
      statsSection.style.display = 'block'; // Always show for artist dashboard
    }
  }

  // Initialize stats section visibility
  toggleStatsSection();

  // Update stats section when filters change
  [searchInput, typeSelect, featuredSelect, dateRangeSelect].forEach(element => {
    element.addEventListener('change', toggleStatsSection);
    element.addEventListener('input', toggleStatsSection);
  });
});
</script>

<%- include('../partials/artist-footer') %>
