<%- contentFor('body') %>

<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="glass-card-dark">
          <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
            <h2 class="card-title mb-0 text-white">Pending Upgrade Request</h2>
            <a href="/learning" class="btn btn-sm btn-outline-light">
              <i class="bi bi-arrow-left"></i> Back to Learning
            </a>
          </div>
          <div class="card-body p-4">
            <div class="alert alert-warning mb-4" style="color: #000;">
              <h5 class="alert-heading" style="color: #000;"><i class="bi bi-hourglass-split me-2"></i> Request Under Review</h5>
              <p class="mb-0" style="color: #000;">Your request to upgrade from <strong><%= request.currentLevel %></strong> to <strong><%= request.requestedLevel %></strong> level is currently under review by our administrators.</p>
            </div>

            <div class="card bg-dark mb-4">
              <div class="card-header">
                <h5 class="card-title mb-0 text-white">Request Details</h5>
              </div>
              <div class="card-body">
                <div class="row mb-3">
                  <div class="col-md-4 text-white-50">Current Level:</div>
                  <div class="col-md-8 text-white"><%= request.currentLevel %></div>
                </div>
                <div class="row mb-3">
                  <div class="col-md-4 text-white-50">Requested Level:</div>
                  <div class="col-md-8 text-white"><%= request.requestedLevel %></div>
                </div>
                <div class="row mb-3">
                  <div class="col-md-4 text-white-50">Submitted On:</div>
                  <div class="col-md-8 text-white"><%= new Date(request.createdAt).toLocaleString() %></div>
                </div>
                <div class="row mb-3">
                  <div class="col-md-4 text-white-50">Status:</div>
                  <div class="col-md-8">
                    <span class="badge bg-warning" style="color: #000;">Pending</span>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-4 text-white-50">Your Reason:</div>
                  <div class="col-md-8 text-white"><%= request.reason %></div>
                </div>
              </div>
            </div>

            <div class="alert alert-info" style="color: #000;">
              <h5 class="alert-heading" style="color: #000;"><i class="bi bi-info-circle-fill me-2"></i> What's Next?</h5>
              <p class="mb-0" style="color: #000;">Our administrators will review your request and make a decision. You will be notified via email once your request has been processed. This typically takes 1-3 business days.</p>
            </div>

            <div class="d-grid gap-2">
              <a href="/learning" class="btn btn-outline-light">
                <i class="bi bi-arrow-left me-2"></i> Return to Learning Center
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
