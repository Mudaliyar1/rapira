<%- include('../partials/artist-header') %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center py-3">
          <h5 class="card-title fw-bold mb-0" style="color: white !important;">Delete Ticket Confirmation</h5>
          <a href="/artists/manage-tickets" class="btn btn-sm btn-outline-light">
            <i class="bi bi-arrow-left"></i> Back to Tickets
          </a>
        </div>
        <div class="card-body" style="background-color: #333;">
          <div class="alert alert-danger mb-4">
            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i> Warning!</h5>
            <p class="text-white">You are about to permanently delete this ticket record. This action cannot be undone.</p>
            <p class="text-white mb-0">The user will no longer be able to access this ticket.</p>
          </div>
          
          <div class="card mb-4">
            <div class="card-header bg-dark text-white">
              <h6 class="mb-0">Ticket Details</h6>
            </div>
            <div class="card-body" style="background-color: #444;">
              <div class="row">
                <div class="col-md-6">
                  <p class="mb-2 text-white"><strong>Ticket Number:</strong> <%= ticket.ticketNumber %></p>
                  <p class="mb-2 text-white"><strong>Concert:</strong> <%= ticket.concert ? ticket.concert.title : 'Concert Unavailable' %></p>
                  <p class="mb-2 text-white"><strong>Date:</strong> <%= ticket.concert ? toISTDateString(ticket.concert.date) : 'N/A' %></p>
                  <p class="mb-2 text-white"><strong>Venue:</strong> <%= ticket.concert ? ticket.concert.venue : 'N/A' %></p>
                </div>
                <div class="col-md-6">
                  <p class="mb-2 text-white"><strong>Purchased By:</strong> <%= ticket.user ? ticket.user.name : 'Unknown User' %></p>
                  <p class="mb-2 text-white"><strong>Email:</strong> <%= ticket.user ? ticket.user.email : 'N/A' %></p>
                  <p class="mb-2 text-white"><strong>Purchase Date:</strong> <%= toISTDateString(ticket.purchaseDate) %></p>
                  <p class="mb-2 text-white"><strong>Quantity:</strong> <%= ticket.quantity %> ticket(s)</p>
                  <p class="mb-2 text-white"><strong>Amount:</strong> ₹<%= ticket.totalAmount %></p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="d-flex justify-content-between">
            <a href="/artists/manage-tickets" class="btn btn-secondary">
              <i class="bi bi-x-circle me-2"></i> Cancel
            </a>
            <form action="/artists/tickets/<%= ticket._id %>/delete" method="POST">
              <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-2"></i> Delete Ticket
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .card {
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 20px;
  }
  
  .card-header {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
  }
  
  .alert-danger {
    background-color: #dc3545;
    border-color: #dc3545;
    color: white;
  }
</style>

<%- include('../partials/artist-footer') %>
