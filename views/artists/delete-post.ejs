<%- include('../partials/artist-header') %>

<div class="container py-4">
  <div class="mb-3">
    <a href="/artists/manage-posts" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Manage Posts</a>
  </div>

  <div class="card border-danger">
    <div class="card-header bg-danger text-white">
      <h5 class="mb-0">Delete Post</h5>
    </div>
    <div class="card-body">
      <p class="mb-3">This action cannot be undone. Are you sure you want to delete this post?</p>
      <div class="mb-3">
        <% if (post.media && post.media.mediaType === 'video') { %>
          <video controls style="width:100%; max-height:320px; object-fit:contain; border-radius:8px; background:#000;">
            <source src="<%= post.media.url %>">
          </video>
        <% } else { %>
          <img src="<%= post.media && post.media.url ? post.media.url : '/images/default-profile.svg' %>" alt="post" style="width:100%; max-height:320px; object-fit:contain; border-radius:8px; background:#000;">
        <% } %>
      </div>
      <div class="mb-3 p-3 bg-light border rounded">
        <strong>Caption:</strong>
        <div class="mt-2"><%= post.caption || '(no caption)' %></div>
      </div>
      <form action="/posts/<%= post._id %>?_method=DELETE" method="POST">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a href="/artists/manage-posts" class="btn btn-outline-secondary ms-2">Cancel</a>
      </form>
    </div>
  </div>
</div>
