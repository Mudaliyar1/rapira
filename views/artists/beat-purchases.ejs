<%- include('../partials/artist-header') %>

<!-- Flash Messages -->
<% if (success && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card bg-dark border-secondary mb-4">
  <div class="card-body">
    <h5 class="text-white mb-2">My Receipts</h5>
    <p class="text-white-50 mb-0">View and download transaction receipts for all your beat purchases.</p>
  </div>
</div>

<div class="card bg-dark border-secondary">
  <div class="card-header border-secondary">
    <h5 class="mb-0 text-white">Purchase History</h5>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-dark table-hover mb-0 align-middle text-white" style="background-color: #000000 !important; color: #ffffff !important; --bs-table-bg: #000000 !important; --bs-table-color: #ffffff !important; --bs-table-striped-bg: #000000 !important; --bs-table-hover-bg: #1a1a1a !important;">
        <thead>
          <tr style="border-bottom: 2px solid #333; background-color: #000000 !important;">
            <th class="border-secondary text-white-50" style="background-color: #000000 !important; color: #ffffff !important;">Purchase Date</th>
            <th class="border-secondary text-white-50" style="background-color: #000000 !important; color: #ffffff !important;">Producer</th>
            <th class="border-secondary text-white-50" style="background-color: #000000 !important; color: #ffffff !important;">Beat Title</th>
            <th class="border-secondary text-white-50" style="background-color: #000000 !important; color: #ffffff !important;">Type</th>
            <th class="border-secondary text-white-50" style="background-color: #000000 !important; color: #ffffff !important;">Amount Paid</th>
            <th class="border-secondary text-white-50 text-end" style="background-color: #000000 !important; color: #ffffff !important;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (purchases && purchases.length > 0) { %>
            <% purchases.forEach(purchase => { %>
              <tr style="background-color: #000000 !important;">
                <td class="border-secondary text-white-50" style="background-color: #000000 !important; color: #ffffff !important;"><%= new Date(purchase.createdAt).toLocaleDateString() %> <%= new Date(purchase.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></td>
                <td class="border-secondary" style="background-color: #000000 !important; color: #ffffff !important;">
                  <div class="d-flex align-items-center text-white" style="color: #ffffff !important;">
                    <% if (purchase.producer) { %>
                      <img src="<%= purchase.producer.profileImage || '/images/default-profile.svg' %>" width="32" height="32" class="rounded-circle me-2" alt="">
                      <span><%= purchase.producer.name %></span>
                    <% } else { %>
                      <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 14px;">
                        <i class="bi bi-person-slash"></i>
                      </div>
                      <span class="text-muted fst-italic">Unknown Producer</span>
                    <% } %>
                  </div>
                </td>
                <td class="border-secondary fw-bold text-white" style="background-color: #000000 !important; color: #ffffff !important;"><%= purchase.beat ? purchase.beat.title : (purchase.backupTitle || 'Deleted Beat') %></td>
                <td class="border-secondary text-capitalize text-white-50" style="background-color: #000000 !important; color: #ffffff !important;"><%= purchase.beat ? purchase.beat.mediaType : (purchase.backupMediaType || 'Unknown') %></td>
                <td class="border-secondary text-success fw-bold" style="background-color: #000000 !important;">₹<%= purchase.totalAmountPaid.toFixed(2) %></td>
                <td class="border-secondary text-end" style="background-color: #000000 !important;">
                  <div class="d-flex align-items-center justify-content-end gap-2">
                    <a href="/artists/beat-purchases/<%= purchase._id %>/receipt" class="btn btn-sm btn-outline-info text-nowrap">
                      <i class="bi bi-receipt"></i> View Receipt
                    </a>
                  </div>
                </td>
              </tr>

            <% }); %>
          <% } else { %>
            <tr style="background-color: #000000 !important;">
              <td colspan="6" class="text-center py-4 text-white-50" style="background-color: #000000 !important; color: #ffffff !important;">
                <i class="bi bi-music-note-beamed fs-2 d-block mb-3"></i>
                You haven't purchased any beats yet.
                <div class="mt-3">
                  <a href="/artists/beats" class="btn btn-outline-light">Browse Beats Marketplace</a>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (purchases && purchases.length > 0) { %>
  <!-- Modals removed, functionality moved to Library -->
<% } %>

<%- include('../partials/artist-footer') %>
