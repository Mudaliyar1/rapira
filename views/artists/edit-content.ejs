<%- include('../partials/artist-header') %>

<div class="container py-4">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
          <h5 class="card-title fw-bold mb-0">Edit Content</h5>
        </div>
        <div class="card-body">
          <form action="/artists/content/<%= content._id %>/update" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="title" name="title" value="<%= content.title %>" required>
            </div>

            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" id="description" name="description" rows="4"><%= content.description %></textarea>
              <div class="form-text">Provide a brief description of your content.</div>
            </div>

            <div class="mb-3">
              <label class="form-label">Content Type</label>
              <input type="text" class="form-control" value="<%= content.type.charAt(0).toUpperCase() + content.type.slice(1) %>" disabled>
              <div class="form-text">Content type cannot be changed after upload.</div>
            </div>

            <div class="mb-4">
              <label class="form-label d-block">Current Content</label>
              <% if (content.type === 'song') { %>
                <audio controls class="w-100 mb-2">
                  <source src="<%= content.fileUrl %>" type="audio/mpeg">
                  Your browser does not support the audio element.
                </audio>
              <% } else if (content.type === 'video') { %>
                <video controls class="w-100 mb-2" style="max-height: 300px;">
                  <source src="<%= content.fileUrl %>" type="video/mp4">
                  Your browser does not support the video element.
                </video>
              <% } else { %>
                <a href="<%= content.fileUrl %>" target="_blank" class="btn btn-outline-primary">
                  <i class="bi bi-file-earmark-text me-2"></i> View Current File
                </a>
              <% } %>
            </div>

            <div class="mb-4">
              <label for="contentFile" class="form-label">Replace Content File</label>
              <input type="file" class="form-control" id="contentFile" name="contentFile">
              <div class="form-text">Leave empty to keep the current file.</div>
            </div>

            <div class="row mb-4">
              <div class="col-md-6">
                <label class="form-label d-block">Current Thumbnail</label>
                <img src="<%= content.thumbnailUrl %>" alt="Thumbnail" class="img-thumbnail mb-2" style="max-height: 150px;">
              </div>
              <div class="col-md-6">
                <label for="thumbnailImage" class="form-label">Replace Thumbnail</label>
                <input type="file" class="form-control" id="thumbnailImage" name="thumbnailImage" accept="image/*">
                <div class="form-text">Leave empty to keep the current thumbnail.</div>
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <a href="/artists/dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
              </a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-2"></i> Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Get form elements
  const contentFileInput = document.getElementById('contentFile');
  const uploadForm = document.querySelector('form[action^="/artists/content/"]');
  const contentType = '<%= content.type %>'; // Get content type from server

  // Define allowed file types for each content type
  const allowedFileTypes = {
    song: ['audio/mpeg', 'audio/wav', 'audio/mp3'],
    video: ['video/mp4', 'video/quicktime', 'video/x-msvideo'],
    lyrics: ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
  };

  // Define file extensions for error messages
  const fileExtensions = {
    song: '.mp3, .wav',
    video: '.mp4, .mov',
    lyrics: '.pdf, .doc, .docx'
  };

  // Function to validate file type
  function validateFileType() {
    if (!contentFileInput) return true;

    const file = contentFileInput.files[0];

    // If no file is selected, return true (no validation needed)
    if (!file) return true;

    // Check if file type matches the content type
    const isValidFileType = allowedFileTypes[contentType].includes(file.type);

    // If not valid, show error message
    if (!isValidFileType) {
      const errorMessage = `Invalid file type for ${contentType}. Please upload ${fileExtensions[contentType]} files only.`;
      alert(errorMessage);

      // Clear the file input
      contentFileInput.value = '';
      return false;
    }

    return true;
  }

  // Add event listener to file input
  if (contentFileInput) {
    contentFileInput.addEventListener('change', validateFileType);
  }

  // Add event listener to form submission
  if (uploadForm) {
    uploadForm.addEventListener('submit', function(e) {
      if (!validateFileType()) {
        e.preventDefault();
      }
    });
  }
});
</script>

<%- include('../partials/artist-footer') %>
