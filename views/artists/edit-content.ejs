<%- include('../partials/artist-header') %>

<div class="container py-4">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
          <h5 class="card-title fw-bold mb-0">Edit Content</h5>
        </div>
        <div class="card-body">
          <form action="/artists/content/<%= content._id %>/update" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="title" name="title" value="<%= content.title %>" required>
            </div>

            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" id="description" name="description" rows="4"><%= content.description %></textarea>
              <div class="form-text">Provide a brief description of your content.</div>
            </div>

            <div class="mb-3">
              <label class="form-label">Content Type</label>
              <input type="text" class="form-control" value="<%= content.type.charAt(0).toUpperCase() + content.type.slice(1) %>" disabled>
              <div class="form-text">Content type cannot be changed after upload.</div>
            </div>

            <div class="mb-4">
              <label class="form-label d-block">Current Content (YouTube)</label>
              <% if (content.isYoutubeLink && content.youtubeId) { %>
                <div class="ratio ratio-16x9 mb-2">
                  <iframe
                    src="https://www.youtube.com/embed/<%= content.youtubeId %>"
                    title="<%= content.title %>"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen>
                  </iframe>
                </div>
                <div class="form-text mb-2">Current YouTube Link: <a href="<%= content.fileUrl %>" target="_blank"><%= content.fileUrl %></a></div>
              <% } else { %>
                <div class="alert alert-warning">
                  This content was uploaded before YouTube integration. Please update with a YouTube link.
                </div>
              <% } %>
            </div>

            <div class="mb-4">
              <label for="youtubeLink" class="form-label">Update YouTube Link</label>
              <input type="text" class="form-control" id="youtubeLink" name="youtubeLink" placeholder="https://www.youtube.com/watch?v=...">
              <div class="form-text">Leave empty to keep the current YouTube link. Enter a new link to update.</div>
            </div>

            <div class="row mb-4">
              <div class="col-md-6">
                <label class="form-label d-block">Current Thumbnail</label>
                <img src="<%= content.thumbnailUrl %>" alt="Thumbnail" class="img-thumbnail mb-2" style="max-height: 150px;">
              </div>
              <div class="col-md-6">
                <label for="thumbnailImage" class="form-label">Replace Thumbnail</label>
                <input type="file" class="form-control" id="thumbnailImage" name="thumbnailImage" accept="image/*">
                <div class="form-text">Leave empty to keep the current thumbnail.</div>
              </div>
            </div>

            <!-- Upload Progress Bar -->
            <div id="uploadProgressContainer" class="d-none mb-4">
              <div class="alert alert-warning mb-3 d-none" id="uploadWarning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Important:</strong> Please do not close this page or navigate away while your content is uploading.
              </div>
              <label class="form-label">Upload Progress</label>
              <div class="progress mb-2" style="height: 20px;">
                <div id="uploadProgressBar" class="progress-bar bg-primary progress-bar-striped progress-bar-animated"
                     role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%">
                </div>
              </div>
              <div class="d-flex justify-content-between">
                <span id="uploadProgressText">0%</span>
                <span id="uploadStatus">Waiting to upload...</span>
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <a href="/artists/dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
              </a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-2"></i> Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Get form elements
  const contentFileInput = document.getElementById('contentFile');
  const uploadForm = document.querySelector('form[action^="/artists/content/"]');
  const contentType = '<%= content.type %>'; // Get content type from server

  // Function to validate YouTube link
  function validateYoutubeLink(link) {
    if (!link) return true; // Empty link is valid (no change)

    // YouTube link regex pattern
    const youtubeRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i;
    return youtubeRegex.test(link);
  }

  // Add event listener to form submission
  const youtubeLinkInput = document.getElementById('youtubeLink');

  if (youtubeLinkInput) {
    youtubeLinkInput.addEventListener('change', function() {
      if (this.value && !validateYoutubeLink(this.value)) {
        alert('Please enter a valid YouTube URL (e.g., https://www.youtube.com/watch?v=dQw4w9WgXcQ)');
        this.value = '';
      }
    });
  }

  // Add event listener to form submission
  if (uploadForm) {
    uploadForm.addEventListener('submit', function(e) {
      if (youtubeLinkInput && youtubeLinkInput.value && !validateYoutubeLink(youtubeLinkInput.value)) {
        alert('Please enter a valid YouTube URL');
        e.preventDefault();
      }
    });
  }
});
</script>

<script src="/js/upload-progress.js"></script>

<%- include('../partials/artist-footer') %>
