<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload Content - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="admin-layout">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white p-0">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0 text-primary fw-bold">Artist Dashboard</h5>
        <button class="btn btn-sm btn-outline-light d-md-none" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <% if (artist.user.profileImage) { %>
              <img src="<%= artist.user.profileImage %>" alt="<%= artist.user.name %>" class="rounded-circle" width="48" height="48">
            <% } else { %>
              <i class="bi bi-person-circle fs-1"></i>
            <% } %>
          </div>
          <div>
            <h6 class="mb-0"><%= artist.user.name %></h6>
            <small class="text-muted">Artist</small>
          </div>
        </div>
        <ul class="nav flex-column">
          <li class="nav-item mb-2">
            <a href="/artists/dashboard" class="nav-link text-white p-2 rounded">
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/concerts/create" class="nav-link text-white p-2 rounded">
              <i class="bi bi-calendar-plus me-2"></i> Create Concert
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/upload-content" class="nav-link text-white p-2 rounded active bg-primary">
              <i class="bi bi-cloud-upload me-2"></i> Upload Content
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/edit-profile" class="nav-link text-white p-2 rounded">
              <i class="bi bi-pencil-square me-2"></i> Edit Profile
            </a>
          </li>
          <li class="nav-item mt-4">
            <a href="/artists/<%= artist._id %>" class="nav-link text-white p-2 rounded">
              <i class="bi bi-eye me-2"></i> View Public Profile
            </a>
          </li>
          <li class="nav-item">
            <a href="/" class="nav-link text-white p-2 rounded">
              <i class="bi bi-arrow-left me-2"></i> Back to Site
            </a>
          </li>
          <li class="nav-item">
            <a href="/auth/logout" class="nav-link text-white p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Upload Content</h1>
        <div>
          <a href="/artists/dashboard" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
          </a>
          <button class="btn btn-primary d-md-none" id="adminToggle">
            <i class="bi bi-list"></i>
          </button>
        </div>
      </div>

      <!-- Upload Form -->
      <div class="card">
        <div class="card-body p-4">
          <form action="/artists/upload-content" method="POST" enctype="multipart/form-data">
            <div class="row g-4">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="title" class="form-label">Content Title</label>
                  <input type="text" class="form-control" id="title" name="title" placeholder="Enter title" required>
                </div>
                
                <div class="mb-3">
                  <label for="type" class="form-label">Content Type</label>
                  <select class="form-select" id="type" name="type" required>
                    <option value="" selected disabled>Select content type</option>
                    <option value="song">Song</option>
                    <option value="video">Video</option>
                    <option value="lyrics">Lyrics</option>
                  </select>
                </div>
                
                <div class="mb-3">
                  <label for="description" class="form-label">Description</label>
                  <textarea class="form-control" id="description" name="description" rows="4" placeholder="Enter description"></textarea>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="contentFile" class="form-label">Upload File</label>
                  <input type="file" class="form-control" id="contentFile" name="contentFile" required>
                  <div class="form-text">
                    For songs: MP3, WAV (max 50MB)<br>
                    For videos: MP4, MOV (max 50MB)<br>
                    For lyrics: PDF, DOC (max 5MB)
                  </div>
                </div>
                
                <div class="mb-3">
                  <label for="thumbnailImage" class="form-label">Thumbnail Image</label>
                  <input type="file" class="form-control" id="thumbnailImage" name="thumbnailImage">
                  <div class="form-text">Recommended size: 800x450px (16:9 ratio). JPG, PNG, GIF (max 5MB)</div>
                </div>
                
                <div class="mb-3">
                  <div class="card bg-light">
                    <div class="card-body">
                      <h6 class="card-title">Content Guidelines</h6>
                      <ul class="mb-0 small">
                        <li>Ensure you have the rights to all content you upload</li>
                        <li>Explicit content must be appropriately labeled</li>
                        <li>Content that violates our terms of service will be removed</li>
                        <li>Large files may take longer to upload</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="col-12">
                <hr>
                <div class="d-flex justify-content-end gap-2">
                  <a href="/artists/dashboard" class="btn btn-outline-secondary">Cancel</a>
                  <button type="submit" class="btn btn-primary">
                    <i class="bi bi-cloud-upload me-1"></i> Upload Content
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Admin Toggle -->
  <button class="btn admin-toggle d-md-none" id="adminToggle">
    <i class="bi bi-list"></i>
  </button>

  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
</body>
</html>
