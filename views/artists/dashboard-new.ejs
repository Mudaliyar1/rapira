<%- include('../partials/artist-header') %>

<!-- Stats Cards -->
<div class="row g-4 mb-5">
  <div class="col-md-4">
    <div class="card bg-dark p-3">
      <div class="d-flex align-items-center">
        <div class="me-3 text-center">
          <div class="bg-primary text-white p-3 rounded" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-calendar-event fs-3"></i>
          </div>
        </div>
        <div>
          <h5 style="color: white !important; font-weight: 700; font-size: 1.25rem;" class="mb-1">Concerts</h5>
          <p class="mb-0" style="color: #ccc;"><strong><%= upcomingConcerts.length %></strong> Upcoming</p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card bg-dark p-3">
      <div class="d-flex align-items-center">
        <div class="me-3 text-center">
          <div class="bg-info text-white p-3 rounded" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-music-note-beamed fs-3"></i>
          </div>
        </div>
        <div>
          <h5 style="color: white !important; font-weight: 700; font-size: 1.25rem;" class="mb-1">Content</h5>
          <p class="mb-0" style="color: #ccc;"><strong><%= content.length %></strong> Uploads</p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card bg-dark p-3">
      <div class="d-flex align-items-center">
        <div class="me-3 text-center">
          <div class="bg-warning text-white p-3 rounded" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-hourglass-split fs-3"></i>
          </div>
        </div>
        <div>
          <h5 style="color: white !important; font-weight: 700;" class="mb-1">Pending</h5>
          <p class="mb-0" style="color: #ccc;"><strong><%= pendingConcerts.length %></strong> Approvals</p>
        </div>
      </div>
    </div>
  <div class="col-md-4">
    <div class="card bg-dark p-3">
      <div class="d-flex align-items-center">
        <div class="me-3 text-center">
          <div class="bg-success text-white p-3 rounded" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-people fs-3"></i>
          </div>
        </div>
        <div>
          <h5 style="color: white !important; font-weight: 700;" class="mb-1">Followers</h5>
          <p class="mb-0" style="color: #ccc;"><strong><%= followerCounts.totalFollowers %></strong> Total</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="card mb-5">
  <div class="card-body" style="background-color: #333;">
    <h5 class="card-title fw-bold mb-4" style="color: white !important;">Quick Actions</h5>
    <div class="row g-3">
      <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
      <div class="col-md-3">
        <a href="/concerts/create" class="btn btn-primary w-100 py-3">
          <i class="bi bi-calendar-plus fs-4 d-block mb-2"></i>
          Create Concert
        </a>
      </div>
      <% } %>
      <div class="col-md-<%= (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') ? '3' : '4' %>">
        <a href="/learning" class="btn btn-info w-100 py-3 text-white">
          <i class="bi bi-book fs-4 d-block mb-2"></i>
          Learning Modules
        </a>
      </div>
      <div class="col-md-<%= (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') ? '3' : '3' %>">
        <a href="/artists/manage-concerts" class="btn btn-success w-100 py-3">
          <i class="bi bi-calendar-event fs-4 d-block mb-2"></i>
          Manage Concerts
        </a>
      </div>
      <div class="col-md-<%= (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') ? '3' : '3' %>">
        <a href="/artists/followers" class="btn btn-warning w-100 py-3 text-white">
          <i class="bi bi-people fs-4 d-block mb-2"></i>
          Manage Followers
        </a>
      </div>
      <div class="col-md-<%= (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') ? '3' : '3' %>">
        <a href="/artists/manage-tickets" class="btn btn-danger w-100 py-3 text-white">
          <i class="bi bi-ticket-perforated fs-4 d-block mb-2"></i>
          Manage Tickets
        </a>
      </div>
      <div class="col-md-<%= (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') ? '3' : '3' %>">
        <a href="/artists/edit-profile" class="btn btn-primary w-100 py-3 text-white">
          <i class="bi bi-pencil-square fs-4 d-block mb-2"></i>
          Edit Profile
        </a>
      </div>
      <div class="col-md-3">
        <a href="#post-story" class="btn btn-secondary w-100 py-3 text-white">
          <i class="bi bi-camera-reels fs-4 d-block mb-2"></i>
          Post Story
        </a>
      </div>
      <div class="col-md-3">
        <a href="/artist-distribution/distributors" class="btn btn-dark w-100 py-3 text-white" style="background-color: #6f42c1;">
          <i class="bi bi-cloud-arrow-up fs-4 d-block mb-2"></i>
          Music Distribution
        </a>
      </div>
      <div class="col-md-<%= (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') ? '3' : '3' %>">
        <a href="/messages/find" class="btn btn-info w-100 py-3 text-white">
          <i class="bi bi-chat-dots fs-4 d-block mb-2"></i>
          Connect with Others
        </a>
      </div>
    </div>
  </div>
</div>
<!-- Post Story -->
<div class="card mb-5" id="post-story">
  <div class="card-body" style="background-color: #333;">
    <h5 class="card-title fw-bold mb-4" style="color: white !important;">Post a Story</h5>
    <form action="/artists/stories" method="POST" enctype="multipart/form-data" class="row g-3">
      <div class="col-md-6">
        <label class="form-label" style="color: #fff;">Media (image or short video)</label>
        <input type="file" name="media" accept="image/*,video/*" class="form-control" required />
      </div>
      <div class="col-md-6">
        <label class="form-label" style="color: #fff;">Caption (optional)</label>
        <input type="text" name="caption" maxlength="120" class="form-control" placeholder="Say something..." />
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-primary">Post Story</button>
        <span class="text-muted ms-2" style="color:#ccc !important;">Max 20 stories per 24 hours; up to 20MB.</span>
      </div>
    </form>
  </div>
  
</div>

<!-- My Stories -->
<% if (stories && stories.length > 0) { %>
<div class="card mb-5">
  <div class="card-body" style="background-color: #333;">
    <h5 class="card-title fw-bold mb-4" style="color: white !important;">My Active Stories (<%= stories.length %>)</h5>
    <div class="row g-3">
      <% stories.forEach(story => { %>
      <div class="col-md-3 col-sm-6" id="story-<%= story._id %>">
        <div class="card bg-dark h-100">
          <div class="position-relative">
            <% if (story.mediaType === 'image') { %>
              <img src="<%= story.mediaUrl %>" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Story">
            <% } else { %>
              <video src="<%= story.mediaUrl %>" class="card-img-top" style="height: 200px; object-fit: cover;" muted></video>
            <% } %>
            <div class="position-absolute top-0 end-0 p-2">
              <span class="badge bg-dark"><%= story.mediaType === 'image' ? 'Photo' : 'Video' %></span>
            </div>
          </div>
          <div class="card-body">
            <% if (story.caption) { %>
              <p class="card-text text-white small mb-2"><%= story.caption %></p>
            <% } %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <small class="text-muted" style="cursor: pointer;" onclick="viewStoryViewers('<%= story._id %>')" title="Click to see who viewed">
                <i class="bi bi-eye-fill"></i> <%= story.viewsCount || 0 %> views
              </small>
              <small class="text-muted" style="cursor: pointer;" onclick="viewStoryLikes('<%= story._id %>')" title="Click to see who liked">
                <i class="bi bi-heart-fill text-danger"></i> <%= story.likesCount || 0 %> likes
              </small>
              <small class="text-muted">
                <i class="bi bi-clock"></i> <%= Math.round((new Date(story.expiresAt) - new Date()) / (1000 * 60 * 60)) %>h left
              </small>
            </div>
            <button class="btn btn-danger btn-sm w-100" onclick="deleteStory('<%= story._id %>')">
              <i class="bi bi-trash"></i> Delete Story
            </button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- Story Viewers Modal -->
<div class="modal fade" id="storyViewersModal" tabindex="-1" aria-labelledby="storyViewersModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content bg-dark">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white" id="storyViewersModalLabel">
          <i class="bi bi-eye-fill me-2"></i>Story Viewers (<span id="viewersCount">0</span>)
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="viewersListContainer">
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function deleteStory(storyId) {
  if (!confirm('Are you sure you want to delete this story? This action cannot be undone.')) {
    return;
  }

  fetch(`/artists/stories/${storyId}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Remove the story card from the DOM
      const storyCard = document.getElementById(`story-${storyId}`);
      if (storyCard) {
        storyCard.remove();
      }
      
      // Show success message
      alert('Story deleted successfully');
      
      // Reload page to update story count
      window.location.reload();
    } else {
      alert(data.message || 'Failed to delete story');
    }
  })
  .catch(error => {
    console.error('Delete story error:', error);
    alert('An error occurred while deleting the story');
  });
}

function viewStoryViewers(storyId) {
  // Show modal
  const modal = new bootstrap.Modal(document.getElementById('storyViewersModal'));
  modal.show();
  
  // Reset content
  document.getElementById('viewersCount').textContent = '0';
  document.getElementById('viewersListContainer').innerHTML = `
    <div class="text-center py-4">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>
  `;
  
  // Fetch viewers
  fetch(`/artists/stories/${storyId}/viewers`)
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        document.getElementById('viewersCount').textContent = data.viewsCount;
        
        if (data.viewers.length === 0) {
          document.getElementById('viewersListContainer').innerHTML = `
            <div class="text-center py-4 text-muted">
              <i class="bi bi-eye-slash fs-1"></i>
              <p class="mt-3">No one has viewed this story yet</p>
            </div>
          `;
        } else {
          let viewersHtml = '<div class="list-group list-group-flush">';
          data.viewers.forEach(viewer => {
            viewersHtml += `
              <div class="list-group-item bg-dark border-secondary d-flex align-items-center py-3">
                <img src="${viewer.profileImage}" alt="${viewer.name}" 
                     class="rounded-circle me-3" 
                     style="width: 50px; height: 50px; object-fit: cover;" 
                     onerror="this.src='/images/default-avatar.png'">
                <div class="flex-grow-1">
                  <h6 class="mb-0 text-white">${viewer.name}</h6>
                  <small class="text-muted">${viewer.email}</small>
                </div>
                <span class="badge bg-info">${viewer.role}</span>
              </div>
            `;
          });
          viewersHtml += '</div>';
          document.getElementById('viewersListContainer').innerHTML = viewersHtml;
        }
      } else {
        document.getElementById('viewersListContainer').innerHTML = `
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            ${data.message || 'Failed to load viewers'}
          </div>
        `;
      }
    })
    .catch(error => {
      console.error('Fetch viewers error:', error);
      document.getElementById('viewersListContainer').innerHTML = `
        <div class="alert alert-danger" role="alert">
          <i class="bi bi-exclamation-triangle me-2"></i>
          An error occurred while loading viewers
        </div>
      `;
    });
}

function viewStoryLikes(storyId) {
  // Show modal
  const modal = new bootstrap.Modal(document.getElementById('storyViewersModal'));
  document.getElementById('storyViewersModalLabel').innerHTML = '<i class="bi bi-heart-fill text-danger me-2"></i>Story Likes (<span id="viewersCount">0</span>)';
  modal.show();
  
  // Reset content
  document.getElementById('viewersCount').textContent = '0';
  document.getElementById('viewersListContainer').innerHTML = `
    <div class="text-center py-4">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>
  `;
  
  // Fetch likes
  fetch(`/artists/stories/${storyId}/likes`)
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        document.getElementById('viewersCount').textContent = data.likesCount;
        
        if (data.likes.length === 0) {
          document.getElementById('viewersListContainer').innerHTML = `
            <div class="text-center py-4 text-muted">
              <i class="bi bi-heart fs-1"></i>
              <p class="mt-3">No one has liked this story yet</p>
            </div>
          `;
        } else {
          let likesHtml = '<div class="list-group list-group-flush">';
          data.likes.forEach(user => {
            likesHtml += `
              <div class="list-group-item bg-dark border-secondary d-flex align-items-center py-3">
                <img src="${user.profileImage}" alt="${user.name}" 
                     class="rounded-circle me-3" 
                     style="width: 50px; height: 50px; object-fit: cover;" 
                     onerror="this.src='/images/default-profile.svg'">
                <div class="flex-grow-1">
                  <h6 class="mb-0 text-white">${user.name}</h6>
                  <small class="text-muted">${user.email}</small>
                </div>
                <span class="badge bg-info">${user.role}</span>
              </div>
            `;
          });
          likesHtml += '</div>';
          document.getElementById('viewersListContainer').innerHTML = likesHtml;
        }
      } else {
        document.getElementById('viewersListContainer').innerHTML = `
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            ${data.message || 'Failed to load likes'}
          </div>
        `;
      }
    })
    .catch(error => {
      console.error('Fetch likes error:', error);
      document.getElementById('viewersListContainer').innerHTML = `
        <div class="alert alert-danger" role="alert">
          <i class="bi bi-exclamation-triangle me-2"></i>
          An error occurred while loading likes
        </div>
      `;
    });
}
</script>

<!-- Upcoming Concerts -->
<div class="card mb-5">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
    <h5 class="card-title fw-bold mb-0" style="color: white !important;">Upcoming Concerts</h5>
    <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
    <a href="/concerts/create" class="btn btn-sm btn-outline-light">Create New</a>
    <% } else { %>
    <a href="/learning" class="btn btn-sm btn-outline-light">Complete Learning to Create Concerts</a>
    <% } %>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="color: #000000 !important;">Title</th>
            <th style="color: #000000 !important;">Date & Time</th>
            <th style="color: #000000 !important;">Venue</th>
            <th style="color: #000000 !important;">City</th>
            <th style="color: #000000 !important;">Type</th>
            <th style="color: #000000 !important;">Tickets Sold</th>
            <th style="color: #000000 !important;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (upcomingConcerts && upcomingConcerts.length > 0) { %>
            <% upcomingConcerts.forEach(concert => { %>
              <tr>
                <td style="color: #000000 !important;"><%= concert.title %></td>
                <td style="color: #000000 !important;">
                  <%= toISTDateString(concert.date) %><br>
                  <small class="text-muted" style="color: #6c757d !important;"><%= concert.time %></small>
                </td>
                <td style="color: #000000 !important;"><%= concert.venue && concert.venue.name ? concert.venue.name : concert.venue %></td>
                <td style="color: #000000 !important;"><%= concert.city %></td>
                <td>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                    <%= concert.isPaid ? `₹${concert.price}` : 'Free' %>
                  </span>
                </td>
                <td style="color: #000000 !important;">
                  <%= concert.ticketsSold %> / <%= concert.maxTickets > 0 ? concert.maxTickets : '∞' %>
                </td>
                <td>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                      Actions
                    </button>
                    <ul class="dropdown-menu">
                      <li><a class="dropdown-item" href="/concerts/<%= concert._id %>" target="_blank">
                        <i class="bi bi-eye me-2"></i> View
                      </a></li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelModal<%= concert._id %>">
                          <i class="bi bi-x-circle me-2"></i> Cancel
                        </button>
                      </li>
                    </ul>
                  </div>

                  <!-- Cancel Modal -->
                  <div class="modal fade" id="cancelModal<%= concert._id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title">Confirm Cancellation</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <p>Are you sure you want to cancel the concert "<%= concert.title %>"?</p>
                          <p class="text-danger mb-0">This action cannot be undone. All ticket holders will be notified.</p>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                          <form action="/concerts/<%= concert._id %>/cancel" method="POST">
                            <button type="submit" class="btn btn-danger">Cancel Concert</button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-4" style="color: #000000 !important;">No upcoming concerts</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Pending Concerts -->
<div class="card mb-5">
  <div class="card-header bg-dark text-white py-3">
    <h5 class="card-title fw-bold mb-0" style="color: white !important;">Pending Approval</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="color: #000000 !important;">Title</th>
            <th style="color: #000000 !important;">Date & Time</th>
            <th style="color: #000000 !important;">Venue</th>
            <th style="color: #000000 !important;">City</th>
            <th style="color: #000000 !important;">Type</th>
            <th style="color: #000000 !important;">Status</th>
            <th style="color: #000000 !important;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (pendingConcerts && pendingConcerts.length > 0) { %>
            <% pendingConcerts.forEach(concert => { %>
              <tr>
                <td style="color: #000000 !important;"><%= concert.title %></td>
                <td style="color: #000000 !important;">
                  <%= toISTDateString(concert.date) %><br>
                  <small class="text-muted" style="color: #6c757d !important;"><%= concert.time %></small>
                </td>
                <td style="color: #000000 !important;"><%= concert.venue && concert.venue.name ? concert.venue.name : concert.venue %></td>
                <td style="color: #000000 !important;"><%= concert.city %></td>
                <td>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                    <%= concert.isPaid ? `₹${concert.price}` : 'Free' %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-warning">Pending</span>
                </td>
                <td>
                  <a href="/concerts/<%= concert._id %>/edit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-4" style="color: #000000 !important;">No pending concerts</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Recent Content -->
<div class="card">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
    <h5 class="card-title fw-bold mb-0" style="color: white !important;">Recent Content</h5>
    <div>
      <a href="/artists/manage-content" class="btn btn-sm btn-outline-light me-2">
        <i class="bi bi-grid"></i> Manage All
      </a>
      <a href="/artists/upload-content" class="btn btn-sm btn-outline-light">
        <i class="bi bi-plus"></i> Upload New
      </a>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-4">
      <% if (content && content.length > 0) { %>
        <% content.slice(0, 3).forEach(item => { %>
          <div class="col-md-4">
            <div class="card content-card h-100">
              <div class="position-relative">
                <img src="<%= item.thumbnailUrl %>" class="card-img-top content-thumbnail" alt="<%= item.title %>">
                <span class="badge <%= item.type === 'song' ? 'bg-primary' : item.type === 'video' ? 'bg-danger' : 'bg-info' %> content-type-badge">
                  <i class="bi <%= item.type === 'song' ? 'bi-music-note' : item.type === 'video' ? 'bi-camera-video' : 'bi-file-text' %>"></i>
                  <%= item.type.charAt(0).toUpperCase() + item.type.slice(1) %>
                </span>
              </div>
              <div class="card-body" style="background-color: #333;">
                <h5 class="card-title" style="color: white !important;"><%= item.title %></h5>
                <% if (item.description) { %>
                  <p class="card-text" style="color: #ccc;"><%= item.description.length > 50 ? item.description.substring(0, 50) + '...' : item.description %></p>
                <% } %>
                <p class="card-text">
                  <small style="color: #aaa;">
                    <i class="bi bi-calendar3"></i> <%= toISTDateString(item.releaseDate) %>
                  </small>
                </p>
              </div>
              <div class="card-footer bg-dark border-top-0">
                <div class="d-flex gap-2 mb-2">
                  <a href="/content/<%= item._id %>"
                     class="btn btn-primary flex-grow-1">
                    <%= item.type === 'song' ? 'Listen' : item.type === 'video' ? 'Watch' : 'Read' %>
                  </a>
                </div>
                <div class="d-flex gap-2">
                  <a href="/artists/content/<%= item._id %>/edit" class="btn btn-secondary flex-grow-1">
                    <i class="bi bi-pencil"></i> Edit
                  </a>
                  <a href="/artists/content/<%= item._id %>/delete" class="btn btn-danger flex-grow-1">
                    <i class="bi bi-trash"></i> Delete
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
        <% if (content.length > 3) { %>
          <div class="col-12 text-center mt-3">
            <a href="/artists/<%= artist._id %>" class="btn btn-outline-primary">View All Content</a>
          </div>
        <% } %>
      <% } else { %>
        <div class="col-12 text-center py-4">
          <p class="mb-3">You haven't uploaded any content yet.</p>
          <a href="/artists/upload-content" class="btn btn-primary">Upload Content</a>
        </div>
      <% } %>
    </div>
  </div>
</div>



