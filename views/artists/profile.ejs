<div class="rapira-artist-profile-page">
  <div class="container py-3 py-md-4">

    <!-- Flash / Query Message Notice -->
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-success alert-dismissible fade show rh-ap-alert mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- 1. Top Navigation: Back to Artists Link -->
    <div class="d-flex align-items-center justify-content-between mb-3 mb-md-4">
      <a href="/artists" class="rh-ap-back-btn">
        <i class="bi bi-arrow-left"></i>
        <span>Back to Artists</span>
      </a>

      <!-- Quick More Options Menu -->
      <div class="dropdown">
        <button class="rh-ap-options-btn" type="button" id="artistMoreOptions" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More options">
          <i class="bi bi-three-dots"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end rh-cream-dropdown-menu" aria-labelledby="artistMoreOptions">
          <li>
            <a class="dropdown-item rh-cream-dropdown-item" href="javascript:void(0)" onclick="copyArtistProfileLink()">
              <i class="bi bi-link-45deg me-2"></i> Share Profile
            </a>
          </li>
          <li>
            <a class="dropdown-item rh-cream-dropdown-item" href="/contact?subject=Report+Artist+<%= encodeURIComponent(artist.stageName || (artist.user && artist.user.name) || '') %>">
              <i class="bi bi-flag me-2"></i> Report Artist
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- 2. Artist Profile Hero Card -->
    <%
      const artistName = artist.stageName || (artist.user && artist.user.name) || 'Artist';
      const isVerified = Boolean(artist.verified);
      const bannerImg = artist.bannerImage || (artist.user && artist.user.coverImage) || '/images/default-banner.jpg';
      const dpImg = (artist.user && artist.user.profileImage) ? artist.user.profileImage : '/images/default-profile.svg';
      const genre = artist.genre || 'Hip Hop';
      const activeYears = artist.yearsActive ? `${artist.yearsActive} Years Active` : (`Since ${artist.createdAt ? new Date(artist.createdAt).getFullYear() : '2024'}`);
      const location = artist.city ? `${artist.city}${artist.state ? ', ' + artist.state : ''}` : ((artist.user && artist.user.city) ? artist.user.city : '');
      const totalFollowersCount = (followerCounts && typeof followerCounts.totalFollowers !== 'undefined') ? followerCounts.totalFollowers : 0;
      const fansCount = (followerCounts && typeof followerCounts.userFollowers !== 'undefined') ? followerCounts.userFollowers : 0;
      const concertsCount = Array.isArray(upcomingConcerts) ? upcomingConcerts.length : 0;
      const social = (artist.user && artist.user.socialLinks) || {};
    %>

    <div class="rh-ap-header-card mb-3 mb-md-4">
      <!-- Cover Banner -->
      <div class="rh-ap-banner-wrap">
        <img src="<%= bannerImg %>" alt="<%= artistName %> Cover" class="rh-ap-banner-img" onerror="this.onerror=null; this.src='/images/default-banner.jpg';">
        <div class="rh-ap-banner-overlay" aria-hidden="true"></div>
      </div>

      <!-- Identity & Info Section -->
      <div class="rh-ap-identity-section">
        <div class="row align-items-end g-3 g-md-4">
          <!-- Avatar + Name + Meta Column -->
          <div class="col-12 col-lg-7">
            <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-end text-center text-sm-start gap-3 gap-md-4">
              
              <!-- Circular Overlapping Profile Avatar -->
              <div class="rh-ap-avatar-wrap">
                <img src="<%= dpImg %>" alt="<%= artistName %>" class="rh-ap-avatar-img" onerror="this.onerror=null; this.src='/images/default-profile.svg';">
                <% if (isVerified) { %>
                  <div class="rh-ap-avatar-badge" title="Verified Artist" aria-label="Verified Artist">
                    <i class="bi bi-check-lg"></i>
                  </div>
                <% } %>
              </div>

              <!-- Artist Name and Meta Details -->
              <div class="rh-ap-title-wrap pb-1">
                <div class="d-flex align-items-center justify-content-center justify-content-sm-start gap-2 mb-1">
                  <h1 class="rh-ap-artist-name mb-0"><%= artistName %></h1>
                  <% if (isVerified) { %>
                    <i class="bi bi-patch-check-fill rh-ap-verified-icon" title="Verified Artist" aria-label="Verified"></i>
                  <% } %>
                </div>

                <div class="rh-ap-meta-row">
                  <span class="rh-ap-meta-item">
                    <i class="bi bi-music-note"></i> <%= genre %>
                  </span>
                  <span class="rh-ap-meta-dot">•</span>
                  <span class="rh-ap-meta-item">
                    <i class="bi bi-calendar3"></i> <%= activeYears %>
                  </span>
                  <% if (location) { %>
                    <span class="rh-ap-meta-dot">•</span>
                    <span class="rh-ap-meta-item">
                      <i class="bi bi-geo-alt-fill"></i> <%= location %>
                    </span>
                  <% } %>
                </div>

                <!-- Action Buttons: Follow, Message, Share -->
                <div class="rh-ap-actions-row mt-2 mt-md-3">
                  <% if (currentUser && currentUser.id.toString() !== artist.user._id.toString()) { %>
                    <a href="/follows/confirm/<%= isFollowing ? 'unfollow' : 'follow' %>/<%= artist.user._id %>" 
                       class="<%= isFollowing ? 'rh-ap-btn-following' : 'rh-ap-btn-follow' %> follow-btn">
                      <i class="bi <%= isFollowing ? 'bi-check-lg' : 'bi-plus-lg' %> me-1"></i>
                      <%= isFollowing ? 'Following' : 'Follow' %>
                    </a>
                  <% } else if (!currentUser) { %>
                    <a href="/auth/login" class="rh-ap-btn-follow">
                      <i class="bi bi-plus-lg me-1"></i> Follow
                    </a>
                  <% } %>

                  <a href="/messages/conversation/<%= artist.user._id %>" class="rh-ap-btn-message">
                    <i class="bi bi-envelope me-1"></i> Message
                  </a>

                  <button type="button" class="rh-ap-btn-share" onclick="copyArtistProfileLink()" title="Share Profile" aria-label="Share Profile">
                    <i class="bi bi-share"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Stats Block Column -->
          <div class="col-12 col-lg-5">
            <div class="rh-ap-stats-box">
              <div class="rh-ap-stat-item">
                <span class="rh-ap-stat-num"><%= totalFollowersCount %></span>
                <span class="rh-ap-stat-lbl">Followers</span>
              </div>
              <div class="rh-ap-stat-divider"></div>
              <div class="rh-ap-stat-item">
                <span class="rh-ap-stat-num"><%= fansCount %></span>
                <span class="rh-ap-stat-lbl">Fans</span>
              </div>
              <div class="rh-ap-stat-divider"></div>
              <div class="rh-ap-stat-item">
                <span class="rh-ap-stat-num"><%= concertsCount %></span>
                <span class="rh-ap-stat-lbl">Concerts</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Profile Navigation Tabs -->
    <div class="rh-ap-tabs-wrapper mb-3 mb-md-4">
      <ul class="nav rh-ap-nav-tabs" id="artistTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="rh-ap-tab-btn active" id="tab-posts-btn" data-bs-toggle="tab" data-bs-target="#tab-posts-pane" type="button" role="tab" aria-controls="tab-posts-pane" aria-selected="true">
            <i class="bi bi-grid-3x3"></i>
            <span>Posts</span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="rh-ap-tab-btn" id="tab-concerts-btn" data-bs-toggle="tab" data-bs-target="#tab-concerts-pane" type="button" role="tab" aria-controls="tab-concerts-pane" aria-selected="false">
            <i class="bi bi-calendar-event"></i>
            <span>Concerts</span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="rh-ap-tab-btn" id="tab-community-btn" data-bs-toggle="tab" data-bs-target="#tab-community-pane" type="button" role="tab" aria-controls="tab-community-pane" aria-selected="false">
            <i class="bi bi-people"></i>
            <span>Community</span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="rh-ap-tab-btn" id="tab-about-btn" data-bs-toggle="tab" data-bs-target="#tab-about-pane" type="button" role="tab" aria-controls="tab-about-pane" aria-selected="false">
            <i class="bi bi-person"></i>
            <span>About</span>
          </button>
        </li>
      </ul>
    </div>

    <!-- 4. Tab Panes Content -->
    <div class="tab-content" id="artistTabsContent">
      
      <!-- ==============================================
           TAB 1: POSTS
           Desktop layout: Posts grid (left) + About Card (right)
           Mobile layout: Posts grid (2 columns)
           ============================================== -->
      <div class="tab-pane fade show active" id="tab-posts-pane" role="tabpanel" aria-labelledby="tab-posts-btn">
        <div class="row g-4">
          <!-- Posts Grid Column -->
          <div class="col-12 col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <h2 class="rh-ap-section-title mb-0">Latest Posts</h2>
              <% if (posts && posts.length > 0) { %>
                <span class="rh-ap-count-badge"><%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %></span>
              <% } %>
            </div>
            
            <%- include('../partials/artist-posts-ssr', { posts, user: currentUser }) %>
          </div>

          <!-- About Sidebar Column (Desktop Reference Layout) -->
          <div class="col-12 col-lg-4 d-none d-lg-block">
            <div class="rh-ap-about-card">
              <h3 class="rh-ap-card-heading mb-3">About <%= artistName %></h3>
              <p class="rh-ap-bio-text mb-4">
                <%= artist.about || (artist.user && artist.user.bio) || 'Independent artist sharing original music, stories, and live performance recordings.' %>
              </p>

              <div class="rh-ap-details-list mb-4">
                <div class="rh-ap-detail-item">
                  <i class="bi bi-music-note"></i>
                  <div>
                    <span class="rh-ap-detail-label">Genre:</span>
                    <strong class="rh-ap-detail-val"><%= genre %></strong>
                  </div>
                </div>
                <div class="rh-ap-detail-item">
                  <i class="bi bi-calendar-check"></i>
                  <div>
                    <span class="rh-ap-detail-label">Years Active:</span>
                    <strong class="rh-ap-detail-val"><%= artist.yearsActive ? (artist.yearsActive + ' years') : activeYears %></strong>
                  </div>
                </div>
                <% if (location) { %>
                  <div class="rh-ap-detail-item">
                    <i class="bi bi-geo-alt"></i>
                    <div>
                      <span class="rh-ap-detail-label">Location:</span>
                      <strong class="rh-ap-detail-val"><%= location %></strong>
                    </div>
                  </div>
                <% } %>
              </div>

              <!-- Connect Social Media Icons -->
              <h4 class="rh-ap-card-subheading mb-3">Connect</h4>
              <div class="rh-ap-social-row">
                <% if (social.instagram) { %>
                  <a href="<%= social.instagram %>" target="_blank" rel="noopener noreferrer" class="rh-ap-social-icon-btn" title="Instagram" aria-label="Instagram">
                    <i class="bi bi-instagram"></i>
                  </a>
                <% } %>
                <% if (social.youtube) { %>
                  <a href="<%= social.youtube %>" target="_blank" rel="noopener noreferrer" class="rh-ap-social-icon-btn" title="YouTube" aria-label="YouTube">
                    <i class="bi bi-youtube"></i>
                  </a>
                <% } %>
                <% if (social.spotify) { %>
                  <a href="<%= social.spotify %>" target="_blank" rel="noopener noreferrer" class="rh-ap-social-icon-btn" title="Spotify" aria-label="Spotify">
                    <i class="bi bi-spotify"></i>
                  </a>
                <% } %>
                <% if (social.twitter) { %>
                  <a href="<%= social.twitter %>" target="_blank" rel="noopener noreferrer" class="rh-ap-social-icon-btn" title="Twitter / X" aria-label="Twitter">
                    <i class="bi bi-twitter-x"></i>
                  </a>
                <% } %>
                <% if (!social.instagram && !social.youtube && !social.spotify && !social.twitter) { %>
                  <p class="text-muted small mb-0">No external links connected yet.</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==============================================
           TAB 2: CONCERTS
           Handles both:
           A. No upcoming concerts -> Dashed border empty state with Notify Me
           B. Upcoming concerts available -> Clean cards with date block & arrow
           ============================================== -->
      <div class="tab-pane fade" id="tab-concerts-pane" role="tabpanel" aria-labelledby="tab-concerts-btn">
        <div class="d-flex align-items-center justify-content-between mb-3 mb-md-4">
          <h2 class="rh-ap-section-title mb-0">
            Upcoming Concerts 
            <span class="rh-ap-section-subtitle"><%= (upcomingConcerts && upcomingConcerts.length > 0) ? '(with concerts)' : '(No concerts)' %></span>
          </h2>
        </div>

        <% if (upcomingConcerts && upcomingConcerts.length > 0) { %>
          <div class="row g-3 g-md-4">
            <% upcomingConcerts.forEach(concert => { 
              const concertDate = new Date(concert.date);
              const monthNames = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
              const monthStr = monthNames[concertDate.getMonth()] || 'CON';
              const dayStr = String(concertDate.getDate()).padStart(2, '0');
              const venueName = (concert.venue && concert.venue.name) ? concert.venue.name : (concert.venue || 'Venue TBA');
            %>
              <div class="col-12 col-md-6">
                <div class="rh-ap-concert-card">
                  <!-- Date Badge Box -->
                  <div class="rh-ap-date-badge">
                    <span class="rh-ap-date-month"><%= monthStr %></span>
                    <span class="rh-ap-date-day"><%= dayStr %></span>
                  </div>

                  <!-- Concert Poster Thumbnail -->
                  <div class="rh-ap-concert-thumb-wrap">
                    <img src="<%= concert.posterImage || '/images/default-concert.jpg' %>" alt="<%= concert.title %>" class="rh-ap-concert-thumb" loading="lazy" onerror="this.onerror=null; this.src='/images/default-concert.jpg';">
                  </div>

                  <!-- Concert Details -->
                  <div class="rh-ap-concert-info flex-grow-1 min-w-0">
                    <h4 class="rh-ap-concert-title text-truncate mb-1" title="<%= concert.title %>">
                      <%= concert.title %>
                    </h4>
                    <p class="rh-ap-concert-location text-truncate mb-0">
                      <i class="bi bi-geo-alt-fill me-1"></i>
                      <span><%= concert.city || 'India' %> • <%= concert.time || toISTTimeString(concert.date) %></span>
                    </p>
                  </div>

                  <!-- Right Action Arrow Button -->
                  <a href="/concerts/<%= concert._id %>" class="rh-ap-concert-arrow-btn" aria-label="View <%= concert.title %> details">
                    <i class="bi bi-chevron-right"></i>
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <!-- Elegant Empty State (Matches Reference Spec: Dashed Peach Border + Calendar X Icon) -->
          <div class="rh-ap-concert-empty-box">
            <div class="rh-ap-empty-calendar-icon" aria-hidden="true">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#9F190E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="3" ry="3"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <line x1="10" y1="14" x2="14" y2="18"></line>
                <line x1="14" y1="14" x2="10" y2="18"></line>
              </svg>
            </div>
            <h3 class="rh-ap-empty-heading mb-2">No upcoming concerts</h3>
            <p class="rh-ap-empty-subtext mb-4">This artist doesn't have any upcoming right now.</p>
            <button type="button" class="rh-ap-btn-notify" id="notifyMeBtn" onclick="handleNotifyMe('<%= artistName.replace(/'/g, "\\'") %>')">
              <i class="bi bi-bell me-2"></i> Notify Me
            </button>
          </div>
        <% } %>
      </div>

      <!-- ==============================================
           TAB 3: COMMUNITY
           Followers breakdown, fans and artist network
           ============================================== -->
      <div class="tab-pane fade" id="tab-community-pane" role="tabpanel" aria-labelledby="tab-community-btn">
        <div class="d-flex align-items-center justify-content-between mb-3 mb-md-4">
          <h2 class="rh-ap-section-title mb-0">Community &amp; Followers</h2>
        </div>

        <div class="rh-ap-community-card p-3 p-md-4 mb-4">
          <div class="rh-ap-comm-grid mb-4">
            <div class="rh-ap-comm-stat">
              <span class="rh-ap-comm-num"><%= totalFollowersCount %></span>
              <span class="rh-ap-comm-lbl">Followers</span>
            </div>
            <div class="rh-ap-comm-stat">
              <span class="rh-ap-comm-num"><%= fansCount %></span>
              <span class="rh-ap-comm-lbl">Fans</span>
            </div>
            <div class="rh-ap-comm-stat">
              <span class="rh-ap-comm-num"><%= (followerCounts && followerCounts.artistFollowers) || 0 %></span>
              <span class="rh-ap-comm-lbl">Artists</span>
            </div>
          </div>

          <div id="followers-list" class="rh-ap-followers-container">
            <div class="text-center py-4">
              <div class="spinner-border text-danger" role="status" style="width: 2rem; height: 2rem; color: #9F190E !important;">
                <span class="visually-hidden">Loading community...</span>
              </div>
              <p class="mt-2 text-muted small">Loading community members...</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ==============================================
           TAB 4: ABOUT
           Full artist biography, details, connect & achievements
           ============================================== -->
      <div class="tab-pane fade" id="tab-about-pane" role="tabpanel" aria-labelledby="tab-about-btn">
        <div class="d-flex align-items-center justify-content-between mb-3 mb-md-4">
          <h2 class="rh-ap-section-title mb-0">About <%= artistName %></h2>
        </div>

        <div class="rh-ap-about-card p-4 p-md-5">
          <div class="row g-4">
            <div class="col-12 col-lg-7">
              <h3 class="rh-ap-card-heading mb-3">Biography</h3>
              <p class="rh-ap-bio-text mb-4" style="font-size: 1.02rem; line-height: 1.7;">
                <%= artist.about || (artist.user && artist.user.bio) || 'Independent artist sharing original music, stories, and live performance recordings.' %>
              </p>

              <!-- Achievements Section -->
              <% if (artist.achievements && artist.achievements.length > 0) { %>
                <h4 class="rh-ap-card-subheading mb-3">Achievements</h4>
                <ul class="rh-ap-achievements-list mb-4">
                  <% artist.achievements.forEach(achievement => { %>
                    <li class="rh-ap-achievement-item">
                      <i class="bi bi-award-fill me-2"></i>
                      <span><%= achievement %></span>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </div>

            <div class="col-12 col-lg-5">
              <div class="p-3 p-md-4 rh-ap-details-panel">
                <h3 class="rh-ap-card-heading mb-3">Key Details</h3>
                <div class="rh-ap-details-list mb-4">
                  <div class="rh-ap-detail-item">
                    <i class="bi bi-music-note"></i>
                    <div>
                      <span class="rh-ap-detail-label">Genre:</span>
                      <strong class="rh-ap-detail-val"><%= genre %></strong>
                    </div>
                  </div>
                  <div class="rh-ap-detail-item">
                    <i class="bi bi-calendar-check"></i>
                    <div>
                      <span class="rh-ap-detail-label">Years Active:</span>
                      <strong class="rh-ap-detail-val"><%= artist.yearsActive ? (artist.yearsActive + ' years') : activeYears %></strong>
                    </div>
                  </div>
                  <% if (location) { %>
                    <div class="rh-ap-detail-item">
                      <i class="bi bi-geo-alt"></i>
                      <div>
                        <span class="rh-ap-detail-label">Location:</span>
                        <strong class="rh-ap-detail-val"><%= location %></strong>
                      </div>
                    </div>
                  <% } %>
                </div>

                <h4 class="rh-ap-card-subheading mb-3">Connect</h4>
                <div class="rh-ap-social-row">
                  <% if (social.instagram) { %>
                    <a href="<%= social.instagram %>" target="_blank" rel="noopener noreferrer" class="rh-ap-social-icon-btn" title="Instagram" aria-label="Instagram">
                      <i class="bi bi-instagram"></i>
                    </a>
                  <% } %>
                  <% if (social.youtube) { %>
                    <a href="<%= social.youtube %>" target="_blank" rel="noopener noreferrer" class="rh-ap-social-icon-btn" title="YouTube" aria-label="YouTube">
                      <i class="bi bi-youtube"></i>
                    </a>
                  <% } %>
                  <% if (social.spotify) { %>
                    <a href="<%= social.spotify %>" target="_blank" rel="noopener noreferrer" class="rh-ap-social-icon-btn" title="Spotify" aria-label="Spotify">
                      <i class="bi bi-spotify"></i>
                    </a>
                  <% } %>
                  <% if (social.twitter) { %>
                    <a href="<%= social.twitter %>" target="_blank" rel="noopener noreferrer" class="rh-ap-social-icon-btn" title="Twitter / X" aria-label="Twitter">
                      <i class="bi bi-twitter-x"></i>
                    </a>
                  <% } %>
                  <% if (!social.instagram && !social.youtube && !social.spotify && !social.twitter) { %>
                    <p class="text-muted small mb-0">No external links connected yet.</p>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Interactive Client-side Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // 1. Tab switching controller
  const tabButtons = document.querySelectorAll('.rh-ap-tab-btn');
  const tabPanes = document.querySelectorAll('.tab-pane');

  tabButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();

      tabButtons.forEach(btn => btn.classList.remove('active'));
      tabPanes.forEach(pane => {
        pane.classList.remove('show');
        pane.classList.remove('active');
      });

      button.classList.add('active');
      const targetId = button.getAttribute('data-bs-target').substring(1);
      const targetPane = document.getElementById(targetId);
      if (targetPane) {
        targetPane.classList.add('show');
        targetPane.classList.add('active');
      }

      // If switching to community tab, load community list
      if (targetId === 'tab-community-pane') {
        loadCommunityList();
      }
    });
  });

  // 2. Handle direct URL hash (e.g. #concerts, #about, #community)
  const hash = window.location.hash.toLowerCase();
  if (hash) {
    if (hash === '#concerts') {
      document.getElementById('tab-concerts-btn')?.click();
    } else if (hash === '#community' || hash === '#followers') {
      document.getElementById('tab-community-btn')?.click();
    } else if (hash === '#about') {
      document.getElementById('tab-about-btn')?.click();
    }
  }

  // 3. Load Community List via AJAX
  let communityLoaded = false;
  async function loadCommunityList() {
    if (communityLoaded) return;
    const artistUserId = '<%= artist.user._id %>';
    const container = document.getElementById('followers-list');
    if (!container) return;

    try {
      const response = await fetch('/follows/artist/' + artistUserId + '/followers');
      if (response.ok) {
        const followers = await response.json();
        communityLoaded = true;
        if (Array.isArray(followers) && followers.length > 0) {
          let html = '<div class="row g-3">';
          followers.forEach(follower => {
            const fImg = follower.profileImage || '/images/default-profile.svg';
            const fName = follower.name || 'Fan';
            const fRole = follower.role || 'Member';
            html += `
              <div class="col-12 col-sm-6 col-md-4">
                <div class="rh-ap-follower-card">
                  <img src="${fImg}" alt="${fName}" class="rh-ap-follower-img" onerror="this.onerror=null; this.src='/images/default-profile.svg';">
                  <div class="rh-ap-follower-info text-truncate">
                    <h6 class="rh-ap-follower-name text-truncate mb-0">${fName}</h6>
                    <span class="rh-ap-follower-role">${fRole}</span>
                  </div>
                </div>
              </div>
            `;
          });
          html += '</div>';
          container.innerHTML = html;
        } else {
          container.innerHTML = `
            <div class="rh-ap-empty-card py-4 text-center">
              <i class="bi bi-people mb-2" style="font-size: 2.5rem; color: #EAC8B7;"></i>
              <h5 class="rh-ap-empty-title mb-1">No community members yet</h5>
              <p class="rh-ap-empty-desc mb-0">Be the first to follow ${'<%= artistName.replace(/'/g, "\\'") %>'}.</p>
            </div>
          `;
        }
      } else {
        container.innerHTML = '<p class="text-muted text-center py-4">Unable to load community at this time.</p>';
      }
    } catch (err) {
      console.warn('Community load error:', err);
      container.innerHTML = '<p class="text-muted text-center py-4">Unable to load community at this time.</p>';
    }
  }
});

// Copy Profile Link Toast / Clipboard Handler
function copyArtistProfileLink() {
  const url = window.location.href.split('#')[0];
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(url).then(() => {
      showToastNotice('Artist profile link copied to clipboard!');
    }).catch(() => {
      prompt('Copy this link:', url);
    });
  } else {
    prompt('Copy this link:', url);
  }
}

// Notify Me Handler
function handleNotifyMe(artist) {
  showToastNotice('You will be notified when ' + artist + ' announces new concerts!');
}

// Reusable Toast Notification for Artist Profile
function showToastNotice(msg) {
  let toastEl = document.getElementById('rhApToast');
  if (!toastEl) {
    toastEl = document.createElement('div');
    toastEl.id = 'rhApToast';
    toastEl.className = 'rh-ap-toast';
    document.body.appendChild(toastEl);
  }
  toastEl.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>' + msg;
  toastEl.classList.add('show');
  setTimeout(() => {
    toastEl.classList.remove('show');
  }, 3200);
}
</script>
