
<!-- Artist Banner -->
<div class="artist-banner" style="background-image: url('<%= artist.bannerImage %>');">
  <div class="container position-relative" style="height: 100%;">
    <div class="position-absolute bottom-0 start-0 p-4">
      <h1 class="text-white fw-bold mb-2"><%= artist.user.name %></h1>
      <p class="text-white-50 mb-0"><%= artist.genre %></p>
    </div>
  </div>
</div>

<!-- Artist Profile -->
<section class="py-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-4 text-center text-lg-start">
        <div class="position-relative d-inline-block">
          <img src="<%= artist.user.profileImage %>" alt="<%= artist.user.name %>" class="artist-profile-img">
          <% if (artist.verified) { %>
            <div class="verified-badge">
              <i class="bi bi-patch-check-fill"></i>
            </div>
          <% } %>
        </div>
        
        <div class="mt-4">
          <h3 class="fw-bold mb-1"><%= artist.stageName || artist.user.name %></h3>
          <p class="text-muted mb-3"><%= artist.genre %> • <%= artist.yearsActive %> years</p>
          
          <div class="d-flex justify-content-center justify-content-lg-start gap-3 mb-4">
            <% if (artist.user.socialLinks.instagram) { %>
              <a href="<%= artist.user.socialLinks.instagram %>" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle">
                <i class="bi bi-instagram"></i>
              </a>
            <% } %>
            <% if (artist.user.socialLinks.twitter) { %>
              <a href="<%= artist.user.socialLinks.twitter %>" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle">
                <i class="bi bi-twitter-x"></i>
              </a>
            <% } %>
            <% if (artist.user.socialLinks.youtube) { %>
              <a href="<%= artist.user.socialLinks.youtube %>" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle">
                <i class="bi bi-youtube"></i>
              </a>
            <% } %>
            <% if (artist.user.socialLinks.spotify) { %>
              <a href="<%= artist.user.socialLinks.spotify %>" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle">
                <i class="bi bi-spotify"></i>
              </a>
            <% } %>
          </div>
          
          <% if (artist.about) { %>
            <div class="card mb-4">
              <div class="card-body">
                <h5 class="card-title fw-bold mb-3">About</h5>
                <p class="card-text"><%= artist.about %></p>
              </div>
            </div>
          <% } %>
          
          <% if (artist.achievements && artist.achievements.length > 0) { %>
            <div class="card mb-4">
              <div class="card-body">
                <h5 class="card-title fw-bold mb-3">Achievements</h5>
                <ul class="list-group list-group-flush">
                  <% artist.achievements.forEach(achievement => { %>
                    <li class="list-group-item px-0"><%= achievement %></li>
                  <% }); %>
                </ul>
              </div>
            </div>
          <% } %>
        </div>
      </div>
      
      <div class="col-lg-8">
        <!-- Upcoming Concerts -->
        <div class="mb-5">
          <h4 class="fw-bold mb-4">Upcoming Concerts</h4>
          
          <% if (upcomingConcerts && upcomingConcerts.length > 0) { %>
            <div class="row g-4">
              <% upcomingConcerts.forEach(concert => { %>
                <div class="col-md-6">
                  <div class="card h-100">
                    <img src="<%= concert.posterImage %>" class="card-img-top" alt="<%= concert.title %>" style="height: 180px; object-fit: cover;">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title mb-0"><%= concert.title %></h5>
                        <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                          <%= concert.isPaid ? `₹${concert.price}` : 'Free' %>
                        </span>
                      </div>
                      <p class="card-text text-muted mb-2">
                        <i class="bi bi-geo-alt"></i> <%= concert.venue %>, <%= concert.city %>
                      </p>
                      <p class="card-text text-muted mb-3">
                        <i class="bi bi-calendar3"></i> <%= new Date(concert.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                      </p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                      <a href="/concerts/<%= concert._id %>" class="btn btn-primary w-100">View Details</a>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="alert alert-light text-center py-4">
              <p class="mb-0">No upcoming concerts scheduled.</p>
            </div>
          <% } %>
        </div>
        
        <!-- Content -->
        <div>
          <h4 class="fw-bold mb-4">Latest Content</h4>
          
          <% if (content && content.length > 0) { %>
            <div class="row g-4">
              <% content.forEach(item => { %>
                <div class="col-md-6 col-lg-4">
                  <div class="card content-card h-100">
                    <div class="position-relative">
                      <img src="<%= item.thumbnailUrl %>" class="card-img-top content-thumbnail" alt="<%= item.title %>">
                      <span class="badge <%= item.type === 'song' ? 'bg-primary' : item.type === 'video' ? 'bg-danger' : 'bg-info' %> content-type-badge">
                        <i class="bi <%= item.type === 'song' ? 'bi-music-note' : item.type === 'video' ? 'bi-camera-video' : 'bi-file-text' %>"></i>
                        <%= item.type.charAt(0).toUpperCase() + item.type.slice(1) %>
                      </span>
                    </div>
                    <div class="card-body">
                      <h5 class="card-title"><%= item.title %></h5>
                      <% if (item.description) { %>
                        <p class="card-text"><%= item.description.length > 50 ? item.description.substring(0, 50) + '...' : item.description %></p>
                      <% } %>
                      <p class="card-text">
                        <small class="text-muted">
                          <i class="bi bi-calendar3"></i> <%= new Date(item.releaseDate).toLocaleDateString() %>
                        </small>
                      </p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                      <a href="<%= item.fullFileUrl || item.fileUrl %>"
                         class="btn btn-outline-primary w-100 content-link"
                         data-type="<%= item.type %>"
                         data-title="<%= item.title %>"
                         data-artist="<%= artist.user ? artist.user.name : 'Unknown Artist' %>"
                         data-thumbnail="<%= item.fullThumbnailUrl || item.thumbnailUrl %>">
                        <%= item.type === 'song' ? 'Listen' : item.type === 'video' ? 'Watch' : 'Read' %>
                      </a>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="alert alert-light text-center py-4">
              <p class="mb-0">No content available yet.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
