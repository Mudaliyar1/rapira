<!-- Artist Posts Gallery -->
<div class="container-fluid" style="background: linear-gradient(135deg, #1a1a2e 0%, #0f0f1e 100%); min-height: 100vh; padding: 40px 20px;">
  <div class="container">
    <!-- Header -->
    <div class="mb-5">
      <a href="javascript:history.back()" class="btn btn-outline-light mb-4">
        <i class="bi bi-chevron-left"></i> Back
      </a>
      <div class="d-flex align-items-center gap-4 mb-4">
        <% if (artist.profileImage) { %>
          <img src="<%= artist.profileImage %>" alt="<%= artist.stageName %>" 
               style="width:100px; height:100px; border-radius:50%; object-fit:cover; border:3px solid #00d4ff;">
        <% } else { %>
          <div style="width:100px; height:100px; border-radius:50%; background:#444; display:flex; align-items:center; justify-content:center; border:3px solid #00d4ff;">
            <i class="bi bi-person-fill text-muted" style="font-size:50px;"></i>
          </div>
        <% } %>
        <div>
          <h1 class="text-white fw-bold mb-0"><%= artist.stageName %></h1>
          <p class="text-info mb-2"><i class="bi bi-images"></i> Posts Gallery</p>
          <span class="badge bg-success" id="postCount">Loading...</span>
        </div>
      </div>
    </div>

    <!-- Posts Grid -->
    <div id="postsContainer" class="row g-3">
      <div class="col-12 text-center py-5">
        <i class="bi bi-hourglass-split text-muted" style="font-size:50px; display:block; margin-bottom:15px;"></i>
        <p class="text-muted">Loading posts...</p>
      </div>
    </div>
  </div>
</div>

<!-- Post Modal -->
<div class="modal fade" id="postModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content" style="background:#0f0f1e; border:1px solid #333;">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Post</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="postMediaContainer" style="max-height: 60vh; margin-bottom: 20px; border-radius:8px; overflow:hidden;"></div>
        <div class="text-white">
          <h6 id="postCaption" class="mb-2"></h6>
          <div id="postHashtags" class="text-info small mb-3"></div>
          <div class="d-flex flex-wrap gap-3 mb-3 text-muted">
            <span><i class="bi bi-heart-fill text-danger"></i> <span id="postLikes">0</span></span>
            <span><i class="bi bi-share"></i> <span id="postShares">0</span></span>
            <span style="cursor:pointer; transition: opacity 0.2s;" onmouseover="this.style.opacity=0.7" onmouseout="this.style.opacity=1" onclick="openGalleryComments()"><i class="bi bi-chat-dots text-success"></i> <span id="postCommentsCount">0</span> Comments</span>
            <span style="cursor:pointer; transition: opacity 0.2s;" onmouseover="this.style.opacity=0.7" onmouseout="this.style.opacity=1" onclick="openGalleryReport()"><i class="bi bi-flag text-warning"></i> Report</span>
          </div>
          <div class="d-flex gap-2" id="postActions"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Report Modal -->
<div class="modal fade" id="galleryReportModal" tabindex="-1" style="z-index: 1060;">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background:#0f0f1e; border:1px solid #333;">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white"><i class="bi bi-flag text-danger"></i> Report Post</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-white">Please tell us why you are reporting this post:</p>
        <textarea id="galleryReportReason" class="form-control bg-dark text-white border-secondary" rows="4" placeholder="Reason..."></textarea>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="submitGalleryReportBtn">Submit Report</button>
      </div>
    </div>
  </div>
</div>

<!-- Comments Modal -->
<div class="modal fade" id="galleryCommentsModal" tabindex="-1" style="z-index: 1060;">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="background:#0f0f1e; border:1px solid #333;">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white"><i class="bi bi-chat-dots text-success"></i> Comments</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="max-height: 50vh; overflow-y: auto;">
        <div id="galleryCommentsList" class="d-flex flex-column gap-3 text-white">
          <!-- Comments go here -->
        </div>
      </div>
      <div class="modal-footer border-secondary flex-column align-items-stretch">
        <div class="d-flex gap-2">
          <input type="text" id="galleryNewComment" class="form-control bg-dark text-white border-secondary" placeholder="Add a comment...">
          <button class="btn btn-success" id="submitGalleryCommentBtn"><i class="bi bi-send"></i></button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .post-card-gallery {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 12px;
    background: #1a1a2e;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid #333;
  }

  .post-card-gallery:hover {
    transform: scale(1.02);
    border-color: #00d4ff;
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
  }

  .post-card-gallery img,
  .post-card-gallery video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .audio-gallery-card {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 100%);
    gap: 4px;
    padding: 20px;
  }

  .visualizer-bar {
    width: 5px;
    height: 15px;
    background: #00d4ff;
    border-radius: 3px;
    animation: bar-pulse 1.2s infinite ease-in-out;
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
  }

  @keyframes bar-pulse {
    0%, 100% { height: 10px; background: #00d4ff; }
    50% { height: 40px; background: #7c4dff; }
  }

  .visualizer-bar:nth-child(1) { animation-delay: -1.1s; }
  .visualizer-bar:nth-child(2) { animation-delay: -0.9s; }
  .visualizer-bar:nth-child(3) { animation-delay: -0.7s; }
  .visualizer-bar:nth-child(4) { animation-delay: -0.5s; }
  .visualizer-bar:nth-child(5) { animation-delay: -0.3s; }
  .visualizer-bar:nth-child(6) { animation-delay: -0.1s; }

  .post-overlay-gallery {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .post-card-gallery:hover .post-overlay-gallery {
    opacity: 1;
  }

  .post-overlay-content-gallery {
    display: flex;
    gap: 30px;
    color: white;
    text-align: center;
  }

  .post-overlay-item-gallery {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .post-overlay-item-gallery i {
    font-size: 2rem;
    margin-bottom: 8px;
    color: #00d4ff;
  }

  .post-overlay-item-gallery span {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }

  .empty-state i {
    font-size: 80px;
    color: #444;
    margin-bottom: 20px;
    display: block;
  }

  .empty-state h4 {
    color: #999;
    margin-bottom: 10px;
  }
</style>

<script>
let currentPostId = null;
let postsCache = [];
const artistId = '<%= artist._id %>';
const currentUserId = '<%= (typeof user !== "undefined" && user) ? (user.id || user._id || "") : "" %>';

async function loadPosts() {
  try {
    const res = await fetch(`/artist/${artistId}/posts`);
    const data = await res.json();

    console.log('[loadPosts] API Response:', data);
    console.log('[loadPosts] Total posts:', data.posts.length);
    if (data.posts.length > 0) {
      console.log('[loadPosts] First post:', data.posts[0]);
      console.log('[loadPosts] Audio posts:', data.posts.filter(p => p.media.mediaType === 'audio'));
    }

    if (!data.success || !data.posts.length) {
      document.getElementById('postsContainer').innerHTML = `
        <div class="col-12">
          <div class="empty-state">
            <i class="bi bi-images"></i>
            <h4>No posts yet</h4>
            <p class="text-muted">This artist hasn't shared any posts yet</p>
          </div>
        </div>
      `;
      document.getElementById('postCount').textContent = '0 posts';
      return;
    }

    postsCache = data.posts;
    document.getElementById('postCount').textContent = data.posts.length + (data.posts.length === 1 ? ' post' : ' posts');

    const html = data.posts.map(post => `
      <div class="col-md-6 col-lg-4 col-xl-3">
        <div class="post-card-gallery" onclick="viewPost('${post._id}')">
          ${post.media.mediaType === 'image'
            ? `<img src="${post.media.url}" alt="post">`
            : post.media.mediaType === 'video'
            ? (post.media.thumbnailUrl
               ? `<img src="${post.media.thumbnailUrl}" alt="video thumbnail">`
               : `<video muted><source src="${post.media.url}"></video>`)
            : (post.media.thumbnailUrl
               ? `<img src="${post.media.thumbnailUrl}" alt="audio thumbnail">`
               : `<div class="audio-gallery-card">
                    <div class="visualizer-bar"></div>
                    <div class="visualizer-bar"></div>
                    <div class="visualizer-bar"></div>
                    <div class="visualizer-bar"></div>
                    <div class="visualizer-bar"></div>
                    <div class="visualizer-bar"></div>
                  </div>`)
          }
          <div class="post-overlay-gallery">
            <div class="post-overlay-content-gallery">
              <div class="post-overlay-item-gallery">
                <i class="bi bi-heart-fill"></i>
                <span>${post.likesDisplay || post.fakeLikesLabel || post.likesCount || 0}</span>
              </div>
              <div class="post-overlay-item-gallery">
                <i class="bi bi-share"></i>
                <span>${post.shares || 0}</span>
              </div>
              <div class="post-overlay-item-gallery">
                <i class="bi bi-chat-dots"></i>
                <span>${(post.comments || []).length}</span>
              </div>
              <div class="post-overlay-item-gallery">
                <i class="bi bi-eye"></i>
                <span>${post.viewsDisplay || post.views || 0}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    document.getElementById('postsContainer').innerHTML = html;
  } catch (err) {
    console.error('Load posts error:', err);
    document.getElementById('postsContainer').innerHTML = `
      <div class="col-12">
        <div class="empty-state">
          <i class="bi bi-exclamation-circle"></i>
          <h4>Error loading posts</h4>
          <p class="text-muted">Please try refreshing the page</p>
        </div>
      </div>
    `;
  }
}

function viewPost(postId) {
  const post = postsCache.find(p => p._id === postId);
  if (!post) return;

  currentPostId = postId;

  // Pre-populate modal content BEFORE showing it for instant display
  // Load media
  const mediaContainer = document.getElementById('postMediaContainer');
  if (post.media.mediaType === 'image') {
    mediaContainer.innerHTML = `<img src="${post.media.url}" style="width: 100%; border-radius: 8px;">`;
  } else if (post.media.mediaType === 'video') {
    mediaContainer.innerHTML = `<video controls style="width: 100%; border-radius: 8px;"><source src="${post.media.url}"></video>`;
  } else if (post.media.mediaType === 'audio') {
    mediaContainer.innerHTML = `
      <div class="text-center p-4 bg-dark rounded border border-secondary">
        <div class="audio-gallery-card mb-3" style="height: 120px; border-radius: 8px;">
          <div class="visualizer-bar"></div>
          <div class="visualizer-bar"></div>
          <div class="visualizer-bar"></div>
          <div class="visualizer-bar"></div>
          <div class="visualizer-bar"></div>
          <div class="visualizer-bar"></div>
        </div>
        <div class="mb-3 text-white"><strong>RAPIRA AUDIO POST</strong></div>
        <audio controls style="width: 100%;" autoplay>
          <source src="${post.media.url}">
        </audio>
      </div>
    `;
  }

  // Load info
  document.getElementById('postCaption').textContent = post.caption || '(no caption)';
  document.getElementById('postHashtags').innerHTML = post.hashtags.map(tag => `<span class="me-2">#${tag}</span>`).join('') || '';
  document.getElementById('postLikes').textContent = post.likesDisplay || post.fakeLikesLabel || post.likesCount || 0;
  document.getElementById('postShares').textContent = post.shares || 0;
  document.getElementById('postCommentsCount').textContent = (post.comments || []).length;

  // Update like button
  const isLiked = currentUserId && Array.isArray(post.likes) && post.likes.some(l => {
    const likeId = (l && typeof l === 'object') ? (l._id || l.id) : l;
    return likeId && likeId.toString() === currentUserId.toString();
  });
  
  if (currentUserId) {
    // User is logged in - show like and share buttons
    document.getElementById('postActions').innerHTML = `
      <button class="btn btn-outline-light flex-grow-1" id="likeBtn" onclick="toggleLike()">
        <i class="bi bi-heart${isLiked ? '-fill text-danger' : ''}"></i> ${isLiked ? 'Unlike' : 'Like'}
      </button>
      <button class="btn btn-outline-light flex-grow-1" id="shareBtn" onclick="sharePost()">
        <i class="bi bi-share"></i> Share
      </button>
    `;
  } else {
    // User is not logged in - show login prompt
    document.getElementById('postActions').innerHTML = `
      <a href="/auth/login" class="btn btn-link text-primary flex-grow-1 text-decoration-none">
        <i class="bi bi-lock me-2"></i>Login to like and share
      </a>
    `;
  }

  // Show modal instantly
  const modalElement = document.getElementById('postModal');
  const modal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
  modal.show();
}

async function toggleLike() {
  if (!currentPostId || !currentUserId) {
    alert('Please log in to like posts');
    return;
  }

  try {
    const res = await fetch(`/posts/${currentPostId}/like`, { method: 'POST' });
    
    // Handle 401 Unauthorized (not logged in)
    if (res.status === 401) {
      const data = await res.json();
      alert(data.message || 'You must be logged in to like posts');
      window.location.href = '/auth/login';
      return;
    }
    
    const data = await res.json();
    if (data.success) {
      document.getElementById('postLikes').textContent = data.likesDisplay || data.likesCount;
      const btn = document.getElementById('likeBtn');
      if (data.liked) {
        btn.innerHTML = '<i class="bi bi-heart-fill text-danger"></i> Unlike';
      } else {
        btn.innerHTML = '<i class="bi bi-heart"></i> Like';
      }
      loadPosts();
    }
  } catch (err) {
    console.error('Like error:', err);
  }
}

async function sharePost() {
  if (!currentPostId) return;

  try {
    // Generate a URL that will open the post in a popup modal
    const url = `${window.location.origin}#view-post-${currentPostId}`;
    if (navigator.share) {
      await navigator.share({ title: 'Check out this post', url });
    } else if (navigator.clipboard) {
      await navigator.clipboard.writeText(url);
      alert('Link copied to clipboard!');
    }
    fetch(`/posts/${currentPostId}/share`, { method: 'POST' });
  } catch (err) {
    console.error('Share error:', err);
  }
}

// Comments
async function loadGalleryComments() {
  if (!currentPostId) return;
  try {
    const res = await fetch(`/posts/${currentPostId}/comments`);
    const data = await res.json();
    const list = document.getElementById('galleryCommentsList');
    if (data.success && data.comments.length > 0) {
      document.getElementById('postCommentsCount').textContent = data.comments.length;
      
      // Update local cache so grid icon stays fresh
      const cached = postsCache.find(p => p._id === currentPostId);
      if (cached) cached.comments = data.comments;

      list.innerHTML = data.comments.map(c => `
        <div class="d-flex align-items-start ${c.isPinned ? 'p-2 rounded bg-success bg-opacity-10 border border-success' : ''}">
          <img src="${(c.user && c.user.profileImage) ? c.user.profileImage : '/images/default-profile.svg'}" style="width: 32px; height: 32px; border-radius: 50%; margin-right: 12px; object-fit: cover;">
          <div class="flex-grow-1">
            <strong>${c.user ? escapeHtml(c.user.name) : 'Anonymous'}</strong> 
            ${c.isPinned ? '<span class="badge bg-success ms-1"><i class="bi bi-pin-angle-fill"></i> Pinned</span>' : ''}
            <small class="text-muted ms-2">${new Date(c.createdAt).toLocaleDateString()}</small>
            <p class="mb-0 mt-1" style="word-break: break-word;">${escapeHtml(c.text)}</p>
          </div>
        </div>
      `).join('');
    } else {
      list.innerHTML = '<div class="text-center text-muted">No comments yet. Be the first!</div>';
      document.getElementById('postCommentsCount').textContent = '0';
    }
  } catch (err) {
    console.error('Load comments error:', err);
  }
}

function openGalleryComments() {
  if (!currentPostId) return;
  loadGalleryComments();
  const m = new bootstrap.Modal(document.getElementById('galleryCommentsModal'));
  m.show();
}

function openGalleryReport() {
  if (!currentPostId) return;
  const m = new bootstrap.Modal(document.getElementById('galleryReportModal'));
  m.show();
}

document.getElementById('submitGalleryCommentBtn')?.addEventListener('click', async function() {
  if (!currentPostId || !currentUserId) {
    alert('Please log in to comment');
    window.location.href = '/auth/login';
    return;
  }
  const text = document.getElementById('galleryNewComment').value.trim();
  if (!text) return;
  
  const btn = this;
  btn.disabled = true;
  
  try {
    const res = await fetch(`/posts/${currentPostId}/comments`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text })
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById('galleryNewComment').value = '';
      loadGalleryComments();
      alert('Comment posted!');
    } else {
      alert(data.message || 'Failed to post comment');
    }
  } catch (err) {
    alert('Error posting comment');
  } finally {
    btn.disabled = false;
  }
});

document.getElementById('submitGalleryReportBtn')?.addEventListener('click', async function() {
  if (!currentPostId || !currentUserId) {
    alert('Please log in to report');
    return;
  }
  const reason = document.getElementById('galleryReportReason').value.trim();
  if (!reason) {
    alert('Please enter a reason');
    return;
  }
  
  const btn = this;
  btn.disabled = true;
  btn.innerHTML = 'Submitting...';
  
  try {
    const res = await fetch(`/posts/${currentPostId}/report`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason })
    });
    const data = await res.json();
    if (data.success) {
      alert('Post reported. Thank you for your feedback.');
      bootstrap.Modal.getInstance(document.getElementById('galleryReportModal')).hide();
      document.getElementById('galleryReportReason').value = '';
    } else {
      alert(data.message || 'Failed to report');
    }
  } catch (err) {
    alert('Error sending report');
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Submit Report';
  }
});

// Escape HTML utility for safe rendering
const escapeHtml = (unsafe) => {
  return (unsafe || '').toString()
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
};

document.addEventListener('DOMContentLoaded', loadPosts);
</script>
