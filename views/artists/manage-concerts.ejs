<!-- Custom CSS for dashboard styling -->
<style>
  .section-title {
    position: relative;
    padding-bottom: 8px;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 40px;
    background-color: #0d6efd;
  }

  .card {
    border: none;
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    margin-top: 10px;
  }

  .card-header {
    border-bottom: 1px solid #eee;
  }

  .table {
    margin-bottom: 0;
  }

  .table th {
    font-weight: 600;
    border-top: none;
    border-bottom: none;
    padding: 12px 15px;
  }

  .table td {
    padding: 15px;
    vertical-align: middle;
    border-bottom: 1px solid #f0f0f0;
  }

  .table tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .badge.rounded-pill {
    padding: 0.5em 0.8em;
    font-weight: 500;
  }

  .empty-state {
    padding: 2rem 0;
  }

  .btn-light {
    background-color: #f0f0f0;
    border-color: #ddd;
    color: #666;
  }

  .btn-light:hover {
    background-color: #e0e0e0;
    border-color: #ccc;
    color: #333;
  }

  .btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
  }

  /* Glass card styling */
  .glass-card-dark {
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    border-radius: 0.375rem;
  }

  /* Form styling */
  .form-control:focus, .form-select:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
  }

  .input-group-text {
    border-color: #495057;
  }

  /* Stats styling */
  .stat-item {
    padding: 1rem;
    border-radius: 0.375rem;
    background: rgba(255, 255, 255, 0.05);
    margin: 0.25rem;
  }

  /* Smooth transitions */
  #statsSection {
    transition: all 0.3s ease;
  }

  /* Enhanced table styles */
  tbody tr {
    transition: all 0.2s ease;
  }

  /* Artist Concert Table Readability Fix */
  .table {
    color: #212529 !important;
    background-color: #ffffff !important;
  }

  .table thead th {
    color: #212529 !important;
    background-color: #f8f9fa !important;
    border-color: #dee2e6 !important;
    font-weight: 600 !important;
  }

  .table tbody tr td {
    color: #212529 !important;
    background-color: #ffffff !important;
    border-color: #dee2e6 !important;
  }

  .table tbody tr td * {
    color: #212529 !important;
  }

  .table tbody tr td h6 {
    color: #212529 !important;
    font-weight: 600 !important;
  }

  .table tbody tr td small {
    color: #6c757d !important;
  }

  .table tbody tr:hover {
    background-color: #f8f9fa !important;
  }

  .table tbody tr:hover td {
    color: #212529 !important;
  }

  .table .badge {
    color: #ffffff !important;
  }

  .table .btn-light {
    background-color: #f8f9fa !important;
    border-color: #dee2e6 !important;
    color: #212529 !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-submit form on filter changes (with debounce for search)
  const searchInput = document.getElementById('search');
  const statusSelect = document.getElementById('status');
  const typeSelect = document.getElementById('type');
  const citySelect = document.getElementById('city');
  const form = document.getElementById('concertSearchForm');

  let searchTimeout;

  // Debounced search
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      form.submit();
    }, 500); // 500ms delay
  });

  // Immediate filtering for dropdowns
  statusSelect.addEventListener('change', () => form.submit());
  typeSelect.addEventListener('change', () => form.submit());
  citySelect.addEventListener('change', () => form.submit());

  // Show/hide stats section based on filters
  function toggleStatsSection() {
    const hasFilters = searchInput.value ||
                      statusSelect.value !== 'all' ||
                      typeSelect.value !== 'all' ||
                      citySelect.value !== 'all';

    const statsSection = document.getElementById('statsSection');
    statsSection.style.display = 'block'; // Always show for artist dashboard
  }

  // Initialize stats section visibility
  toggleStatsSection();

  // Update stats section when filters change
  [searchInput, statusSelect, typeSelect, citySelect].forEach(element => {
    element.addEventListener('change', toggleStatsSection);
    element.addEventListener('input', toggleStatsSection);
  });
});
</script>

<%- include('../partials/artist-footer') %>
