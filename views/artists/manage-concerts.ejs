<%- include('../partials/artist-header') %>

<!-- Search and Filter Section -->
<div class="glass-card-dark border border-secondary mb-4">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">Search & Filter Concerts</h5>
  </div>
  <div class="card-body">
    <form method="GET" action="/artists/manage-concerts" id="concertSearchForm">
      <div class="row g-3">
        <div class="col-md-3">
          <label for="search" class="form-label text-white">Search Concerts</label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-white">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control bg-dark border-secondary text-white"
                   id="search" name="search" placeholder="Search by title, venue, city..."
                   value="<%= searchParams.search %>">
          </div>
        </div>
        <div class="col-md-2">
          <label for="status" class="form-label text-white">Status</label>
          <select class="form-select bg-dark border-secondary text-white" id="status" name="status">
            <option value="all">All Status</option>
            <option value="pending" <%= searchParams.status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="approved" <%= searchParams.status === 'approved' ? 'selected' : '' %>>Approved</option>
            <option value="rejected" <%= searchParams.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="type" class="form-label text-white">Type</label>
          <select class="form-select bg-dark border-secondary text-white" id="type" name="type">
            <option value="all">All Types</option>
            <option value="paid" <%= searchParams.type === 'paid' ? 'selected' : '' %>>Paid</option>
            <option value="free" <%= searchParams.type === 'free' ? 'selected' : '' %>>Free</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="city" class="form-label text-white">City</label>
          <select class="form-select bg-dark border-secondary text-white" id="city" name="city">
            <option value="all">All Cities</option>
            <% cities.forEach(cityName => { %>
              <option value="<%= cityName %>" <%= searchParams.city === cityName ? 'selected' : '' %>><%= cityName %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <button type="submit" class="btn btn-primary me-2">
            <i class="bi bi-search me-1"></i> Search
          </button>
          <a href="/artists/manage-concerts" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-clockwise me-1"></i> Reset
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Statistics Section -->
<div class="glass-card-dark mb-4" id="statsSection">
  <div class="card-body">
    <div class="row text-center">
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-primary mb-1"><%= stats.total %></h4>
          <small class="text-white">Total Concerts</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-success mb-1"><%= stats.upcoming %></h4>
          <small class="text-white">Upcoming</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-warning mb-1"><%= stats.pending %></h4>
          <small class="text-white">Pending</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-danger mb-1"><%= stats.rejected %></h4>
          <small class="text-white">Rejected</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-secondary mb-1"><%= stats.past %></h4>
          <small class="text-white">Past</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="stat-item">
          <h4 class="text-light mb-1"><%= stats.filtered %></h4>
          <small class="text-white">Filtered Results</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Concert Management -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="fw-bold mb-0 section-title">Your Concerts</h2>
  <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
    <a href="/concerts/create" class="btn btn-dark">
      <i class="bi bi-plus-circle me-2"></i> Create New
    </a>
  <% } else { %>
    <a href="/learning" class="btn btn-info">
      <i class="bi bi-book me-2"></i> Complete Learning to Create Concerts
    </a>
  <% } %>
</div>

<!-- Pending Concerts -->
<% if (pendingConcerts && pendingConcerts.length > 0) { %>
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark py-3">
      <h5 class="card-title mb-0 fw-bold">Pending Approval</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th style="width: 35%;">Concert</th>
              <th>Date & Time</th>
              <th>Venue</th>
              <th>City</th>
              <th>Type</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% pendingConcerts.forEach(concert => { %>
              <tr class="border-bottom">
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-3" style="width: 50px; height: 50px;">
                      <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="img-fluid rounded" style="width: 50px; height: 50px; object-fit: cover;">
                    </div>
                    <div>
                      <h6 class="mb-0 fw-bold"><%= concert.title %></h6>
                      <small class="text-muted"><%= concert.description ? (concert.description.length > 40 ? concert.description.substring(0, 40) + '...' : concert.description) : '' %></small>
                    </div>
                  </div>
                </td>
                <td><%= new Date(concert.date).toLocaleDateString() %> • <%= concert.time %></td>
                <td><%= concert.venue %></td>
                <td><%= concert.city %></td>
                <td>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %> rounded-pill">
                    <%= concert.isPaid ? 'Paid' : 'Free' %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-warning text-dark rounded-pill">
                    Pending
                  </span>
                </td>
                <td>
                  <div class="d-flex">
                    <a href="/concerts/<%= concert._id %>" class="btn btn-sm btn-light me-1">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/concerts/<%= concert._id %>/edit" class="btn btn-sm btn-light me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

