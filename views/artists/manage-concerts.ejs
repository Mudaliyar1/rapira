<%- include('../partials/artist-header') %>

<!-- Concert Management -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="fw-bold mb-0 section-title">Your Concerts</h2>
  <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
    <a href="/concerts/create" class="btn btn-dark">
      <i class="bi bi-plus-circle me-2"></i> Create New
    </a>
  <% } else { %>
    <a href="/learning" class="btn btn-info">
      <i class="bi bi-book me-2"></i> Complete Learning to Create Concerts
    </a>
  <% } %>
</div>

<!-- Pending Concerts -->
<% if (pendingConcerts && pendingConcerts.length > 0) { %>
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark py-3">
      <h5 class="card-title mb-0 fw-bold">Pending Approval</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th style="width: 35%;">Concert</th>
              <th>Date & Time</th>
              <th>Venue</th>
              <th>City</th>
              <th>Type</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% pendingConcerts.forEach(concert => { %>
              <tr class="border-bottom">
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-3" style="width: 50px; height: 50px;">
                      <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="img-fluid rounded" style="width: 50px; height: 50px; object-fit: cover;">
                    </div>
                    <div>
                      <h6 class="mb-0 fw-bold"><%= concert.title %></h6>
                      <small class="text-muted"><%= concert.description ? (concert.description.length > 40 ? concert.description.substring(0, 40) + '...' : concert.description) : '' %></small>
                    </div>
                  </div>
                </td>
                <td><%= new Date(concert.date).toLocaleDateString() %> • <%= concert.time %></td>
                <td><%= concert.venue %></td>
                <td><%= concert.city %></td>
                <td>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %> rounded-pill">
                    <%= concert.isPaid ? 'Paid' : 'Free' %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-warning text-dark rounded-pill">
                    Pending
                  </span>
                </td>
                <td>
                  <div class="d-flex">
                    <a href="/concerts/<%= concert._id %>" class="btn btn-sm btn-light me-1">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/concerts/<%= concert._id %>/edit" class="btn btn-sm btn-light me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<!-- Rejected Concerts -->
<% if (rejectedConcerts && rejectedConcerts.length > 0) { %>
  <div class="card mb-4">
    <div class="card-header bg-danger text-white py-3">
      <h5 class="card-title mb-0 fw-bold">Rejected Concerts</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th style="width: 35%;">Concert</th>
              <th>Date & Time</th>
              <th>Venue</th>
              <th>City</th>
              <th>Type</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rejectedConcerts.forEach(concert => { %>
              <tr class="border-bottom">
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-3" style="width: 50px; height: 50px;">
                      <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="img-fluid rounded" style="width: 50px; height: 50px; object-fit: cover;">
                    </div>
                    <div>
                      <h6 class="mb-0 fw-bold"><%= concert.title %></h6>
                      <small class="text-muted"><%= concert.description ? (concert.description.length > 40 ? concert.description.substring(0, 40) + '...' : concert.description) : '' %></small>
                    </div>
                  </div>
                </td>
                <td><%= new Date(concert.date).toLocaleDateString() %> • <%= concert.time %></td>
                <td><%= concert.venue %></td>
                <td><%= concert.city %></td>
                <td>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %> rounded-pill">
                    <%= concert.isPaid ? 'Paid' : 'Free' %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-danger rounded-pill">
                    Rejected
                  </span>
                </td>
                <td>
                  <div class="d-flex">
                    <a href="/concerts/<%= concert._id %>" class="btn btn-sm btn-light me-1">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/concerts/<%= concert._id %>/edit" class="btn btn-sm btn-light me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<!-- Upcoming Concerts -->
<% if (upcomingConcerts && upcomingConcerts.length > 0) { %>
  <div class="card mb-4">
    <div class="card-header bg-success text-white py-3">
      <h5 class="card-title mb-0 fw-bold">Upcoming Concerts</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th style="width: 35%;">Concert</th>
              <th>Date & Time</th>
              <th>Venue</th>
              <th>City</th>
              <th>Type</th>
              <th>Tickets Sold</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% upcomingConcerts.forEach(concert => { %>
              <tr class="border-bottom">
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-3" style="width: 50px; height: 50px;">
                      <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="img-fluid rounded" style="width: 50px; height: 50px; object-fit: cover;">
                    </div>
                    <div>
                      <h6 class="mb-0 fw-bold"><%= concert.title %></h6>
                      <small class="text-muted"><%= concert.description ? (concert.description.length > 40 ? concert.description.substring(0, 40) + '...' : concert.description) : '' %></small>
                    </div>
                  </div>
                </td>
                <td><%= new Date(concert.date).toLocaleDateString() %> • <%= concert.time %></td>
                <td><%= concert.venue %></td>
                <td><%= concert.city %></td>
                <td>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %> rounded-pill">
                    <%= concert.isPaid ? 'Paid' : 'Free' %>
                  </span>
                </td>
                <td>
                  <%= concert.ticketsSold %> / <%= concert.maxTickets > 0 ? concert.maxTickets : '∞' %>
                </td>
                <td>
                  <div class="d-flex">
                    <a href="/concerts/<%= concert._id %>" class="btn btn-sm btn-light me-1">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/concerts/<%= concert._id %>/edit" class="btn btn-sm btn-light me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/concerts/<%= concert._id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this concert?');">
                      <button type="submit" class="btn btn-sm btn-light">
                        <i class="bi bi-x-circle"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<!-- Past Concerts -->
<% if (pastConcerts && pastConcerts.length > 0) { %>
  <div class="card mb-4">
    <div class="card-header bg-secondary text-white py-3">
      <h5 class="card-title mb-0 fw-bold">Past Concerts</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th style="width: 35%;">Concert</th>
              <th>Date & Time</th>
              <th>Venue</th>
              <th>City</th>
              <th>Type</th>
              <th>Tickets Sold</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% pastConcerts.forEach(concert => { %>
              <tr class="border-bottom">
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-3" style="width: 50px; height: 50px;">
                      <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="img-fluid rounded" style="width: 50px; height: 50px; object-fit: cover;">
                    </div>
                    <div>
                      <h6 class="mb-0 fw-bold"><%= concert.title %></h6>
                      <small class="text-muted"><%= concert.description ? (concert.description.length > 40 ? concert.description.substring(0, 40) + '...' : concert.description) : '' %></small>
                    </div>
                  </div>
                </td>
                <td><%= new Date(concert.date).toLocaleDateString() %> • <%= concert.time %></td>
                <td><%= concert.venue %></td>
                <td><%= concert.city %></td>
                <td>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %> rounded-pill">
                    <%= concert.isPaid ? 'Paid' : 'Free' %>
                  </span>
                </td>
                <td>
                  <%= concert.ticketsSold %> / <%= concert.maxTickets > 0 ? concert.maxTickets : '∞' %>
                </td>
                <td>
                  <div class="d-flex">
                    <a href="/concerts/<%= concert._id %>" class="btn btn-sm btn-light">
                      <i class="bi bi-eye"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<!-- No Concerts Message -->
<% if (!concerts || concerts.length === 0) { %>
  <div class="card mb-5">
    <div class="card-body text-center py-5">
      <div class="empty-state">
        <i class="bi bi-calendar-event fs-1 text-muted mb-3"></i>
        <h5 class="fw-bold">No Concerts Found</h5>
        <p class="text-muted mb-3">You haven't created any concerts yet.</p>
        <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
          <a href="/concerts/create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i> Create Your First Concert
          </a>
        <% } else { %>
          <a href="/learning" class="btn btn-primary">
            <i class="bi bi-book me-2"></i> Complete Learning to Create Concerts
          </a>
        <% } %>
      </div>
    </div>
  </div>
<% } %>

<!-- Custom CSS for dashboard styling -->
<style>
  .section-title {
    position: relative;
    padding-bottom: 8px;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 40px;
    background-color: #0d6efd;
  }

  .card {
    border: none;
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    margin-top: 10px;
  }

  .card-header {
    border-bottom: 1px solid #eee;
  }

  .table {
    margin-bottom: 0;
  }

  .table th {
    font-weight: 600;
    border-top: none;
    border-bottom: none;
    padding: 12px 15px;
  }

  .table td {
    padding: 15px;
    vertical-align: middle;
    border-bottom: 1px solid #f0f0f0;
  }

  .table tr:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .badge.rounded-pill {
    padding: 0.5em 0.8em;
    font-weight: 500;
  }

  .empty-state {
    padding: 2rem 0;
  }

  .btn-light {
    background-color: #f0f0f0;
    border-color: #ddd;
    color: #666;
  }

  .btn-light:hover {
    background-color: #e0e0e0;
    border-color: #ccc;
    color: #333;
  }

  .btn-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
  }
</style>

<%- include('../partials/artist-footer') %>
