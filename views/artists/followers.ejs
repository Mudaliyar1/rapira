<%- include('../partials/artist-header') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold">
          <i class="bi bi-people me-2"></i>Followers Management
        </h2>
        <a href="/artists/dashboard" class="btn btn-outline-light">
          <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
        </a>
      </div>
    </div>
  </div>

  <!-- Followers Stats -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card bg-dark p-4 text-center">
        <div class="bg-primary text-white p-3 rounded-circle mx-auto mb-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-people fs-3"></i>
        </div>
        <h3 class="text-white fw-bold mb-1"><%= followerCounts.totalFollowers %></h3>
        <p class="text-muted mb-0">Total Followers</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-dark p-4 text-center">
        <div class="bg-success text-white p-3 rounded-circle mx-auto mb-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-person-heart fs-3"></i>
        </div>
        <h3 class="text-white fw-bold mb-1"><%= followerCounts.userFollowers %></h3>
        <p class="text-muted mb-0">Fans (Users)</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-dark p-4 text-center">
        <div class="bg-warning text-white p-3 rounded-circle mx-auto mb-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-mic fs-3"></i>
        </div>
        <h3 class="text-white fw-bold mb-1"><%= followerCounts.artistFollowers %></h3>
        <p class="text-muted mb-0">Artist Followers</p>
      </div>
    </div>
  </div>

  <!-- Followers List -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-dark">
        <div class="card-header d-flex justify-content-between align-items-center py-3">
          <h5 class="card-title fw-bold mb-0 text-white">
            <i class="bi bi-list-ul me-2"></i>Your Followers
          </h5>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-light" onclick="loadFollowers()">
              <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-funnel me-1"></i>Filter
              </button>
              <ul class="dropdown-menu dropdown-menu-dark">
                <li><a class="dropdown-item" href="#" onclick="filterFollowers('all')">All Followers</a></li>
                <li><a class="dropdown-item" href="#" onclick="filterFollowers('user')">Users Only</a></li>
                <li><a class="dropdown-item" href="#" onclick="filterFollowers('artist')">Artists Only</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div id="followers-list" class="followers-container">
            <% if (followers && followers.length > 0) { %>
              <div class="row g-3">
                <% followers.forEach(follower => { %>
                  <div class="col-md-6 col-lg-4 follower-item" data-role="<%= follower.roleOfFollower %>">
                    <div class="card bg-dark border-secondary h-100">
                      <div class="card-body d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center flex-grow-1">
                          <img src="<%= follower.followerId.profileImage || '/images/default-profile.svg' %>" 
                               alt="<%= follower.followerId.name %>" 
                               class="rounded-circle me-3" 
                               style="width: 60px; height: 60px; object-fit: cover;">
                          <div class="flex-grow-1">
                            <h6 class="mb-0 text-white fw-bold"><%= follower.followerId.name %></h6>
                            <small class="text-muted d-block">
                              <% if (follower.followerId.role === 'user') { %>
                                <i class="bi bi-person-heart text-success me-1"></i>Fan
                              <% } else if (follower.followerId.role === 'artist') { %>
                                <i class="bi bi-mic text-warning me-1"></i>Artist
                              <% } else { %>
                                <i class="bi bi-person text-info me-1"></i><%= follower.followerId.role %>
                              <% } %>
                            </small>
                            <small class="text-muted">Following since <%= new Date(follower.createdAt).toLocaleDateString() %></small>
                          </div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger ms-2" 
                                onclick="removeFollower('<%= follower.followerId._id %>', '<%= follower.followerId.name %>')" 
                                title="Remove follower">
                          <i class="bi bi-person-dash"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="bi bi-people display-1 text-muted mb-4"></i>
                <h5 class="text-muted mb-2">No followers yet</h5>
                <p class="text-muted">Start sharing your content and engaging with your audience to gain followers!</p>
                <a href="/artists/upload-content" class="btn btn-primary mt-3">
                  <i class="bi bi-upload me-2"></i>Upload Content
                </a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>



<!-- Store followers data in a data attribute to avoid EJS/JavaScript parsing conflicts -->
<div id="followers-data" data-followers="<%= JSON.stringify(followers).replace(/"/g, '&quot;') %>"></div>

<script>
  // Followers Management Functions
  let currentFilter = 'all';
  let allFollowers = [];
  
  // Load followers data from data attribute
  try {
    const followersDataElement = document.getElementById('followers-data');
    if (followersDataElement && followersDataElement.dataset.followers) {
      allFollowers = JSON.parse(followersDataElement.dataset.followers.replace(/&quot;/g, '"'));
    }
  } catch (error) {
    console.error('Error loading followers data:', error);
    allFollowers = [];
  }

  function filterFollowers(type) {
    currentFilter = type;
    displayFollowers();
  }

  function displayFollowers() {
    const followersList = document.getElementById('followers-list');
    let filteredFollowers = allFollowers;

    if (currentFilter !== 'all') {
      filteredFollowers = allFollowers.filter(f => f.roleOfFollower === currentFilter);
    }

    if (filteredFollowers.length > 0) {
      let html = '<div class="row g-3">';
      filteredFollowers.forEach(follower => {
        const roleIcon = follower.followerId.role === 'user' ? 'bi-person-heart text-success' : 
                        follower.followerId.role === 'artist' ? 'bi-mic text-warning' : 'bi-person text-info';
        const roleText = follower.followerId.role === 'user' ? 'Fan' : 
                        follower.followerId.role === 'artist' ? 'Artist' : follower.followerId.role;

        html += `
          <div class="col-md-6 col-lg-4 follower-item" data-role="${follower.roleOfFollower}">
            <div class="card bg-dark border-secondary h-100">
              <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center flex-grow-1">
                  <img src="${follower.followerId.profileImage || '/images/default-profile.svg'}" 
                       alt="${follower.followerId.name}" 
                       class="rounded-circle me-3" 
                       style="width: 60px; height: 60px; object-fit: cover;">
                  <div class="flex-grow-1">
                    <h6 class="mb-0 text-white fw-bold">${follower.followerId.name}</h6>
                    <small class="text-muted d-block">
                      <i class="bi ${roleIcon} me-1"></i>${roleText}
                    </small>
                    <small class="text-muted">Following since ${new Date(follower.createdAt).toLocaleDateString()}</small>
                  </div>
                </div>
                <button class="btn btn-sm btn-outline-danger ms-2" 
                        onclick="removeFollower('${follower.followerId._id}', '${follower.followerId.name}')" 
                        title="Remove follower">
                  <i class="bi bi-person-dash"></i>
                </button>
              </div>
            </div>
          </div>
        `;
      });
      html += '</div>';
      followersList.innerHTML = html;
    } else {
      followersList.innerHTML = `
        <div class="text-center py-5">
          <i class="bi bi-people display-1 text-muted mb-4"></i>
          <h5 class="text-muted mb-2">No ${currentFilter === 'all' ? '' : currentFilter} followers found</h5>
          <p class="text-muted">${currentFilter === 'all' ? 'Start sharing your content to gain followers!' : 'Try a different filter or check back later.'}</p>
        </div>
      `;
    }
  }

  async function loadFollowers() {
    try {
      const artistId = '<%= artist.user._id %>';
      const response = await fetch(`/follows/artist/${artistId}/followers`);
      
      if (response.ok) {
        const data = await response.json();
        allFollowers = data.followers;
        displayFollowers();
        
        // Update counts
        document.querySelector('.col-md-4 h3').textContent = data.pagination.totalItems;
      } else {
        alert('Error loading followers. Please try again.');
      }
    } catch (error) {
      console.error('Error loading followers:', error);
      alert('Error loading followers. Please try again.');
    }
  }

  async function removeFollower(followerId, followerName) {
    if (confirm(`Are you sure you want to remove ${followerName} from your followers? This action cannot be undone.`)) {
      try {
        const response = await fetch(`/follows/artist/remove-follower/${followerId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        if (response.ok) {
          const result = await response.json();
          if (result.success) {
            // Remove from local array
            allFollowers = allFollowers.filter(f => f.followerId._id !== followerId);
            displayFollowers();
            
            // Show success message
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3';
            alertDiv.style.zIndex = '9999';
            alertDiv.innerHTML = `
              <i class="bi bi-check-circle me-2"></i>${followerName} has been removed from your followers.
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);
            
            // Auto-dismiss after 3 seconds
            setTimeout(() => {
              if (alertDiv.parentNode) {
                alertDiv.remove();
              }
            }, 3000);
          } else {
          alert('Error: ' + result.message);
        }
      } else {
        // Try to get more detailed error message from response
        try {
          const errorData = await response.json();
          alert('Error: ' + (errorData.message || 'Failed to remove follower'));
        } catch (e) {
          alert('Error removing follower. Server responded with status: ' + response.status);
        }
      }
    } catch (error) {
      console.error('Error removing follower:', error);
      alert('Network error: ' + (error.message || 'Failed to remove follower. Please check your connection.'));
    }
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', function() {
    displayFollowers();
  });
</script>

<%- include('../partials/footer') %>