<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Artist Dashboard - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" h    .table tbody tr:hover {
      color: #212529 !important;
      background-color: #f8f9fa !important;
      border-color: #dee2e6 !important;
    }

    /* Venue Booking Success Animation Styles */
    .venue-booking-success-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(10px);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: fadeIn 0.5s ease;
    }

    .success-modal {
      background: white;
      border-radius: 20px;
      padding: 40px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      max-width: 500px;
      width: 90%;
      transform: scale(0.8);
      animation: modalBounceIn 0.6s ease forwards;
    }

    .success-icon {
      font-size: 5rem;
      color: #198754;
      margin-bottom: 20px;
      animation: iconBounce 1s ease infinite alternate;
    }

    .success-title {
      color: #198754;
      font-weight: 700;
      margin-bottom: 15px;
      font-size: 1.8rem;
    }

    .success-message {
      color: #666;
      margin-bottom: 25px;
      font-size: 1.1rem;
    }

    .success-details {
      margin: 25px 0;
    }

    .detail-item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 12px;
      opacity: 0;
      animation: slideInUp 0.5s ease forwards;
      font-weight: 500;
    }

    .detail-item:nth-child(1) { animation-delay: 0.3s; }
    .detail-item:nth-child(2) { animation-delay: 0.5s; }
    .detail-item:nth-child(3) { animation-delay: 0.7s; }

    .detail-item i {
      font-size: 1.2rem;
    }

    /* Animation Keyframes */
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes modalBounceIn {
      0% { 
        opacity: 0;
        transform: scale(0.3);
      }
      50% { 
        opacity: 1;
        transform: scale(1.05);
      }
      70% { transform: scale(0.9); }
      100% { 
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes iconBounce {
      from { transform: scale(1); }
      to { transform: scale(1.1); }
    }

    @keyframes slideInUp {
      from { 
        opacity: 0;
        transform: translateY(20px);
      }
      to { 
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Celebration particles */
    .celebration-particle {
      position: fixed;
      width: 8px;
      height: 8px;
      background: #198754;
      border-radius: 50%;
      pointer-events: none;
      z-index: 10001;
      animation: particleFall 3s linear forwards;
    }

    @keyframes particleFall {
      0% {
        transform: translateY(-100vh) rotate(0deg);
        opacity: 1;
      }
      100% {
        transform: translateY(100vh) rotate(720deg);
        opacity: 0;
      }
    }
  </style>

  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  
  <script>
    // Venue Booking Success Animation
    document.addEventListener('DOMContentLoaded', function() {
      // Check URL parameters for payment success
      const urlParams = new URLSearchParams(window.location.search);
      const paymentSuccess = urlParams.get('payment') === 'success';
      const venueBooking = urlParams.get('venue_booking') === 'true';

      if (paymentSuccess && venueBooking) {
        // Show venue booking success animation
        showVenueBookingSuccess();
        
        // Clean URL without reloading
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
      }

      // Close animation handler
      document.getElementById('closeSuccessAnimation').addEventListener('click', function() {
        hideVenueBookingSuccess();
      });
    });

    function showVenueBookingSuccess() {
      const overlay = document.getElementById('venueBookingSuccessAlert');
      if (overlay) {
        overlay.style.display = 'flex';
        
        // Play success sound
        playSuccessSound();
        
        // Create celebration particles
        createCelebrationParticles();
        
        // Auto-hide after 8 seconds
        setTimeout(() => {
          hideVenueBookingSuccess();
        }, 8000);
      }
    }

    function hideVenueBookingSuccess() {
      const overlay = document.getElementById('venueBookingSuccessAlert');
      if (overlay) {
        overlay.style.animation = 'fadeOut 0.3s ease forwards';
        setTimeout(() => {
          overlay.style.display = 'none';
          overlay.style.animation = '';
        }, 300);
      }
    }

    function createCelebrationParticles() {
      const colors = ['#198754', '#ffc107', '#0d6efd', '#dc3545', '#6f42c1'];
      
      for (let i = 0; i < 30; i++) {
        setTimeout(() => {
          const particle = document.createElement('div');
          particle.className = 'celebration-particle';
          particle.style.left = Math.random() * 100 + 'vw';
          particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
          particle.style.animationDelay = Math.random() * 2 + 's';
          particle.style.animationDuration = Math.random() * 2 + 3 + 's';
          document.body.appendChild(particle);
          
          setTimeout(() => {
            if (particle.parentNode) {
              particle.parentNode.removeChild(particle);
            }
          }, 5000);
        }, i * 100);
      }
    }

    function playSuccessSound() {
      try {
        // Create a simple success sound using Web Audio API
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        
        // Play a pleasant success melody
        const frequencies = [523.25, 659.25, 783.99]; // C, E, G notes
        let noteIndex = 0;
        
        function playNote() {
          if (noteIndex < frequencies.length) {
            oscillator.frequency.setValueAtTime(frequencies[noteIndex], audioContext.currentTime);
            gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
            
            noteIndex++;
            setTimeout(playNote, 150);
          }
        }
        
        oscillator.start();
        playNote();
        
        setTimeout(() => {
          oscillator.stop();
        }, 600);
      } catch (error) {
        console.log('Could not play success sound:', error);
      }
    }

    // Add fadeOut animation
    const style = document.createElement('style');
    style.textContent = `
      @keyframes fadeOut {
        from { opacity: 1; }
        to { opacity: 0; }
      }
    `;
    document.head.appendChild(style);
  </script>

  <!-- Custom JS -->
  <script src="/js/main.js"></script>le.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="admin-layout artist-dashboard">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white p-0">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0 text-primary fw-bold">Artist Dashboard</h5>
        <button class="btn btn-sm btn-outline-light d-md-none" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <% if (artist.user.profileImage) { %>
              <img src="<%= artist.user.profileImage %>" alt="<%= artist.user.name %>" class="rounded-circle" width="48" height="48">
            <% } else { %>
              <i class="bi bi-person-circle fs-1"></i>
            <% } %>
          </div>
          <div>
            <h6 class="mb-0"><%= artist.user.name %></h6>
            <small class="text-muted">Artist</small>
          </div>
        </div>
        <ul class="nav flex-column">
          <li class="nav-item mb-2">
            <a href="/artists/dashboard" class="nav-link text-white p-2 rounded active bg-primary">
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
          </li>
          <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
          <li class="nav-item mb-2">
            <a href="/concerts/create" class="nav-link text-white p-2 rounded">
              <i class="bi bi-calendar-plus me-2"></i> Create Concert
            </a>
          </li>
          <% } else { %>
          <li class="nav-item mb-2">
            <a href="/learning" class="nav-link text-white p-2 rounded">
              <i class="bi bi-book me-2"></i> Learning Modules
            </a>
          </li>
          <% } %>
          <li class="nav-item mb-2">
            <a href="/artists/upload-content" class="nav-link text-white p-2 rounded">
              <i class="bi bi-cloud-upload me-2"></i> Upload Content
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/manage-tickets" class="nav-link text-white p-2 rounded">
              <i class="bi bi-ticket-perforated me-2"></i> Manage Tickets
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/edit-profile" class="nav-link text-white p-2 rounded">
              <i class="bi bi-pencil-square me-2"></i> Edit Profile
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/messages" class="nav-link text-white p-2 rounded">
              <i class="bi bi-chat-dots me-2"></i> Messages
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/messages/find" class="nav-link text-white p-2 rounded">
              <i class="bi bi-people me-2"></i> Connect with Others
            </a>
          </li>
          <li class="nav-item mt-4">
            <a href="/artists/<%= artist._id %>" class="nav-link text-white p-2 rounded">
              <i class="bi bi-eye me-2"></i> View Public Profile
            </a>
          </li>
          <li class="nav-item">
            <a href="/" class="nav-link text-white p-2 rounded">
              <i class="bi bi-arrow-left me-2"></i> Back to Site
            </a>
          </li>
          <li class="nav-item">
            <a href="/auth/logout" class="nav-link text-white p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
          <button class="btn btn-primary d-none d-md-block me-3" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>
          <h1 class="fw-bold mb-0">Artist Dashboard</h1>
        </div>
      </div>

      <!-- Venue Booking Success Animation -->
      <div id="venueBookingSuccessAlert" class="venue-booking-success-overlay" style="display: none;">
        <div class="success-modal">
          <div class="success-animation">
            <div class="success-icon">
              <i class="bi bi-check-circle-fill"></i>
            </div>
            <h3 class="success-title">Venue Booked Successfully!</h3>
            <p class="success-message">Your payment has been processed and venue has been reserved.</p>
            <div class="success-details">
              <div class="detail-item">
                <i class="bi bi-credit-card-fill text-success"></i>
                <span>Payment Verified</span>
              </div>
              <div class="detail-item">
                <i class="bi bi-building text-success"></i>
                <span>Venue Reserved</span>
              </div>
              <div class="detail-item">
                <i class="bi bi-calendar-check text-success"></i>
                <span>Concert Submitted for Approval</span>
              </div>
            </div>
            <button id="closeSuccessAnimation" class="btn btn-primary mt-3">Continue</button>
          </div>
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="row g-4 mb-5">
        <div class="col-md-4">
          <div class="stat-card bg-white">
            <div class="d-flex align-items-center">
              <div class="stat-icon bg-primary-subtle text-primary me-3">
                <i class="bi bi-calendar-event"></i>
              </div>
              <div>
                <h3 class="fw-bold mb-0"><%= upcomingConcerts.length %></h3>
                <p class="text-muted mb-0">Upcoming Concerts</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-card bg-white">
            <div class="d-flex align-items-center">
              <div class="stat-icon bg-success-subtle text-success me-3">
                <i class="bi bi-music-note-beamed"></i>
              </div>
              <div>
                <h3 class="fw-bold mb-0"><%= content.length %></h3>
                <p class="text-muted mb-0">Content Uploads</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-card bg-white">
            <div class="d-flex align-items-center">
              <div class="stat-icon bg-warning-subtle text-warning me-3">
                <i class="bi bi-hourglass-split"></i>
              </div>
              <div>
                <h3 class="fw-bold mb-0"><%= pendingConcerts.length %></h3>
                <p class="text-muted mb-0">Pending Approvals</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="card mb-5">
        <div class="card-body">
          <h5 class="card-title fw-bold mb-4">Quick Actions</h5>
          <div class="row g-3">
            <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
            <div class="col-md-4">
              <a href="/concerts/create" class="btn btn-primary w-100 py-3">
                <i class="bi bi-calendar-plus fs-4 d-block mb-2"></i>
                Create Concert
              </a>
            </div>
            <% } else { %>
            <div class="col-md-4">
              <a href="/learning" class="btn btn-primary w-100 py-3">
                <i class="bi bi-book fs-4 d-block mb-2"></i>
                Complete Learning
              </a>
            </div>
            <% } %>
            <div class="col-md-4">
              <a href="/artists/upload-content" class="btn btn-success w-100 py-3">
                <i class="bi bi-cloud-upload fs-4 d-block mb-2"></i>
                Upload Content
              </a>
            </div>
            <div class="col-md-4">
              <a href="/artists/edit-profile" class="btn btn-info w-100 py-3 text-white">
                <i class="bi bi-pencil-square fs-4 d-block mb-2"></i>
                Edit Profile
              </a>
            </div>
            <div class="col-md-4">
              <a href="/messages/find" class="btn btn-warning w-100 py-3 text-white">
                <i class="bi bi-people fs-4 d-block mb-2"></i>
                Connect with Others
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Upcoming Concerts -->
      <div class="card mb-5">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
          <h5 class="card-title fw-bold mb-0">Upcoming Concerts</h5>
          <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
          <a href="/concerts/create" class="btn btn-sm btn-outline-primary">Create New</a>
          <% } else { %>
          <a href="/learning" class="btn btn-sm btn-outline-primary">Complete Learning to Create Concerts</a>
          <% } %>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th style="color: #000000 !important;">Title</th>
                  <th style="color: #000000 !important;">Date & Time</th>
                  <th style="color: #000000 !important;">Venue</th>
                  <th style="color: #000000 !important;">City</th>
                  <th style="color: #000000 !important;">Type</th>
                  <th style="color: #000000 !important;">Tickets Sold</th>
                  <th style="color: #000000 !important;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (upcomingConcerts && upcomingConcerts.length > 0) { %>
                  <% upcomingConcerts.forEach(concert => { %>
                    <tr>
                      <td style="color: #000000 !important;"><%= concert.title %></td>
                      <td style="color: #000000 !important;">
                        <%= new Date(concert.date).toLocaleDateString() %><br>
                        <small class="text-muted" style="color: #6c757d !important;"><%= concert.time %></small>
                      </td>
                      <td style="color: #000000 !important;">
                        <% if (concert.venue && concert.venue.name) { %>
                          <%= concert.venue.name %>
                        <% } else { %>
                          <%= concert.venue %>
                        <% } %>
                      </td>
                      <td style="color: #000000 !important;"><%= concert.city %></td>
                      <td>
                        <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                          <%= concert.isPaid ? `₹${concert.price}` : 'Free' %>
                        </span>
                      </td>
                      <td style="color: #000000 !important;">
                        <%= concert.ticketsSold %> / <%= concert.maxTickets > 0 ? concert.maxTickets : '∞' %>
                      </td>
                      <td>
                        <div class="dropdown">
                          <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Actions
                          </button>
                          <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/concerts/<%= concert._id %>" target="_blank">
                              <i class="bi bi-eye me-2"></i> View
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                              <button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelModal<%= concert._id %>">
                                <i class="bi bi-x-circle me-2"></i> Cancel
                              </button>
                            </li>
                          </ul>
                        </div>

                        <!-- Cancel Modal -->
                        <div class="modal fade" id="cancelModal<%= concert._id %>" tabindex="-1" aria-hidden="true">
                          <div class="modal-dialog">
                            <div class="modal-content">
                              <div class="modal-header">
                                <h5 class="modal-title">Confirm Cancellation</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                              </div>
                              <div class="modal-body">
                                <p>Are you sure you want to cancel the concert "<%= concert.title %>"?</p>
                                <p class="text-danger mb-0">This action cannot be undone. All ticket holders will be notified.</p>
                              </div>
                              <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                <form action="/concerts/<%= concert._id %>/cancel" method="POST">
                                  <button type="submit" class="btn btn-danger">Cancel Concert</button>
                                </form>
                              </div>
                            </div>
                          </div>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4">No upcoming concerts</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Pending Concerts -->
      <div class="card mb-5">
        <div class="card-header bg-white py-3">
          <h5 class="card-title fw-bold mb-0">Pending Approval</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Title</th>
                  <th>Date & Time</th>
                  <th>Venue</th>
                  <th>City</th>
                  <th>Type</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (pendingConcerts && pendingConcerts.length > 0) { %>
                  <% pendingConcerts.forEach(concert => { %>
                    <tr>
                      <td><%= concert.title %></td>
                      <td>
                        <%= new Date(concert.date).toLocaleDateString() %><br>
                        <small class="text-muted"><%= concert.time %></small>
                      </td>
                      <td>
                        <% if (concert.venue && concert.venue.name) { %>
                          <%= concert.venue.name %>
                        <% } else { %>
                          <%= concert.venue %>
                        <% } %>
                      </td>
                      <td><%= concert.city %></td>
                      <td>
                        <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                          <%= concert.isPaid ? `₹${concert.price}` : 'Free' %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-warning">Pending</span>
                      </td>
                      <td>
                        <a href="/concerts/<%= concert._id %>/edit" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4">No pending concerts</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Recent Content -->
      <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
          <h5 class="card-title fw-bold mb-0">Recent Content</h5>
          <a href="/artists/upload-content" class="btn btn-sm btn-outline-primary">Upload New</a>
        </div>
        <div class="card-body">
          <div class="row g-4">
            <% if (content && content.length > 0) { %>
              <% content.slice(0, 3).forEach(item => { %>
                <div class="col-md-4">
                  <div class="card content-card h-100">
                    <div class="position-relative">
                      <img src="<%= item.thumbnailUrl %>" class="card-img-top content-thumbnail" alt="<%= item.title %>">
                      <span class="badge <%= item.type === 'song' ? 'bg-primary' : item.type === 'video' ? 'bg-danger' : 'bg-info' %> content-type-badge">
                        <i class="bi <%= item.type === 'song' ? 'bi-music-note' : item.type === 'video' ? 'bi-camera-video' : 'bi-file-text' %>"></i>
                        <%= item.type.charAt(0).toUpperCase() + item.type.slice(1) %>
                      </span>
                    </div>
                    <div class="card-body">
                      <h5 class="card-title"><%= item.title %></h5>
                      <% if (item.description) { %>
                        <p class="card-text"><%= item.description.length > 50 ? item.description.substring(0, 50) + '...' : item.description %></p>
                      <% } %>
                      <p class="card-text">
                        <small class="text-muted">
                          <i class="bi bi-calendar3"></i> <%= new Date(item.releaseDate).toLocaleDateString() %>
                        </small>
                      </p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                      <a href="<%= item.fileUrl %>" class="btn btn-outline-primary w-100" target="_blank">
                        <%= item.type === 'song' ? 'Listen' : item.type === 'video' ? 'Watch' : 'Read' %>
                      </a>
                    </div>
                  </div>
                </div>
              <% }); %>
              <% if (content.length > 3) { %>
                <div class="col-12 text-center mt-3">
                  <a href="/artists/<%= artist._id %>" class="btn btn-outline-primary">View All Content</a>
                </div>
              <% } %>
            <% } else { %>
              <div class="col-12 text-center py-4">
                <p class="mb-3">You haven't uploaded any content yet.</p>
                <a href="/artists/upload-content" class="btn btn-primary">Upload Content</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

