<script>
let editingPostId = null;
let deletingPostId = null;
let postCache = [];

// Helper function to convert date to IST string
function toISTDateString(date) {
  if (!date) return 'N/A';
  const d = new Date(date);
  const options = {
    timeZone: 'Asia/Kolkata',
    year: 'numeric',
    month: 'short',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: true
  };
  return d.toLocaleString('en-IN', options);
}

// Helper function to escape HTML
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Media preview and selection handling
document.getElementById('media').addEventListener('change', function(e) {
  const file = this.files[0];
  const preview = document.getElementById('mediaPreview');
  const progContainer = document.getElementById('uploadProgressContainer');
  const progBar = document.getElementById('uploadProgressBar');
  const progStatus = document.getElementById('progressStatus');
  const progPercent = document.getElementById('progressPercent');

  if (file) {
    // Check 100MB limit immediately
    const MAX_SIZE = 100 * 1024 * 1024;
    if (file.size > MAX_SIZE) {
      // Show Lateral Popup (Modal)
      const limitModalEl = document.getElementById('limitModal');
      const modal = new bootstrap.Modal(limitModalEl);
      modal.show();
      
      showAlert('file exceed limit please under 100mb', 'danger');
      this.value = '';
      preview.style.display = 'none';
      progContainer.style.display = 'none';
      return;
    }

    // Success alert for choosing correct file
    showAlert('choose file under 100mb', 'success');

    // Show and start "Preparation" animation
    progContainer.style.display = 'block';
    progBar.style.width = '0%';
    progPercent.textContent = '0%';
    progStatus.textContent = 'Analysing media...';
    progBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-info';

    let preparationProgress = 0;
    const interval = setInterval(() => {
      preparationProgress += 5;
      progBar.style.width = preparationProgress + '%';
      progPercent.textContent = preparationProgress + '%';
      
      if (preparationProgress >= 100) {
        clearInterval(interval);
        progStatus.textContent = 'Ready to post!';
        progBar.className = 'progress-bar bg-success';
        showAlert('Media ready for upload!', 'info');
      }
    }, 50);

    const reader = new FileReader();
    reader.onload = function(event) {
      if (file.type.startsWith('image/')) {
        preview.innerHTML = `<img src="${event.target.result}" style="max-width: 100%; border-radius: 8px; max-height: 250px; object-fit: contain;">`;
      } else if (file.type.startsWith('video/')) {
        preview.innerHTML = `<video muted controls style="max-width: 100%; border-radius: 8px; max-height: 250px;">
          <source src="${event.target.result}">
        </video>`;
      } else if (file.type.startsWith('audio/')) {
        preview.innerHTML = `
          <div class="text-center p-3 bg-dark rounded border border-primary">
            <i class="bi bi-music-note-beamed fs-2 text-primary"></i>
            <div class="small mt-2"><strong>${file.name}</strong></div>
          </div>
        `;
      }
      preview.style.display = 'block';
    };
    reader.readAsDataURL(file);
  } else {
    preview.style.display = 'none';
    progContainer.style.display = 'none';
  }
});

// Character counter
document.getElementById('caption').addEventListener('input', function() {
  document.getElementById('charCount').textContent = this.value.length;
});

// Edit caption character counter
document.getElementById('editCaption').addEventListener('input', function() {
  document.getElementById('editCharCount').textContent = this.value.length;
});

// Submit post
document.getElementById('postForm').addEventListener('submit', async function(e) {
  e.preventDefault();

  // Validate file
  const fileInput = document.getElementById('media');
  if (!fileInput.files.length) {
    showAlert('Please select an image or video', 'danger');
    return;
  }

  // Check 100MB limit
  const MAX_SIZE = 100 * 1024 * 1024;
  if (fileInput.files[0].size > MAX_SIZE) {
    showAlert('file exceed limit please under 100mb', 'danger');
    return;
  }

  const formData = new FormData(this);
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';

  try {
    const res = await fetch('/posts', {
      method: 'POST',
      body: formData
    });

    const contentType = res.headers.get('content-type');
    let data = {};

    if (contentType && contentType.includes('application/json')) {
      data = await res.json();
    } else {
      const text = await res.text();
      console.error('Non-JSON response:', text);
      showAlert(`Server error (${res.status}): ${text.substring(0, 100)}`, 'danger');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-upload"></i> Post';
      return;
    }

    if (res.ok && data.success) {
      showAlert('Post created successfully and is now live!', 'success');
      document.getElementById('postForm').reset();
      document.getElementById('mediaPreview').style.display = 'none';
      document.getElementById('charCount').textContent = '0';
      loadMyPosts();
    } else {
      const errorMsg = data.message || `Failed to create post (Status: ${res.status})`;
      showAlert(errorMsg, 'danger');
      console.error('Upload error:', { status: res.status, data, response: res });
    }
  } catch (err) {
    showAlert(`Error: ${err.message}`, 'danger');
    console.error('Upload error:', err);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-upload"></i> Post';
  }
});

// Load user's posts
async function loadMyPosts() {
  try {
    const res = await fetch('/my-posts');
    const data = await res.json();

    if (!data.success || !data.posts.length) {
      document.getElementById('postsList').innerHTML = `
        <div class="col-12 text-center text-muted py-5">
          <i class="bi bi-images display-4 mb-3 d-block"></i>
          <p>No posts yet. Create your first post!</p>
        </div>
      `;
      document.getElementById('postCount').textContent = '0';
      return;
    }

    postCache = data.posts;
    document.getElementById('postCount').textContent = data.posts.length;

    const html = data.posts.map(post => `
      <div class="col-md-4 col-lg-3 mb-4">
        <div class="post-card">
          ${post.media.mediaType === 'image'
            ? `<img src="${post.media.url}" class="post-media" alt="post">`
            : `<video class="post-media" controls><source src="${post.media.url}"></video>`
          }
          <div class="post-info">
            <div class="post-caption">${escapeHtml(post.caption || '(no caption)')}</div>
            ${post.hashtags.length > 0 ? `<div class="post-hashtags">${post.hashtags.map(tag => `#${tag}`).join(' ')}</div>` : ''}
            <div class="post-stats">
              <span><i class="bi bi-heart-fill text-danger"></i> ${post.likesCount || 0}</span>
              <span><i class="bi bi-share"></i> ${post.shares || 0}</span>
              <span><i class="bi bi-eye"></i> ${post.views || 0}</span>
              <span><i class="bi bi-chat-dots text-success"></i> ${post.comments ? post.comments.length : 0}</span>
              <span><i class="bi bi-flag text-warning"></i> ${post.reports ? post.reports.length : 0}</span>
              <span class="ms-auto">${toISTDateString(post.createdAt)}</span>
            </div>
            <div class="mb-2">
              ${post.isActive ? '<span class="badge bg-success">✅ Active</span>' : '<span class="badge bg-secondary">🔒 Hidden</span>'}
            </div>
            ${!post.isActive && post.rejectionReason ? `<div class="alert alert-danger py-1 mb-2"><small>Hidden Reason: ${escapeHtml(post.rejectionReason)}</small></div>` : ''}
            <div class="post-actions mt-2 d-flex flex-wrap gap-1">
              <a class="btn btn-sm btn-outline-primary" href="/artists/posts/${post._id}/edit" title="Edit">
                <i class="bi bi-pencil"></i>
              </a>
              <button class="btn btn-sm btn-outline-info" onclick="viewPostLikes('${post._id}')" title="Likes">
                <i class="bi bi-heart"></i>
              </button>
              <button class="btn btn-sm btn-outline-warning" onclick="viewPostComments('${post._id}')" title="Comments">
                <i class="bi bi-chat-dots"></i>
              </button>
              <button class="btn btn-sm btn-outline-secondary" onclick="viewPostReports('${post._id}')" title="Reports">
                <i class="bi bi-flag"></i>
              </button>
              <a class="btn btn-sm btn-outline-danger" href="/artists/posts/${post._id}/delete" title="Delete">
                <i class="bi bi-trash"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    document.getElementById('postsList').innerHTML = html;
  } catch (err) {
    console.error('Load posts error:', err);
    showAlert('Failed to load posts', 'danger');
  }
}

// Edit post
function openEditModal(postId) {
  editingPostId = postId;
  const post = postCache.find(p => p._id === postId);
  if (!post) return;

  document.getElementById('editCaption').value = post.caption || '';
  document.getElementById('editCharCount').textContent = (post.caption || '').length;
  const modal = new bootstrap.Modal(document.getElementById('editPostModal'));
  modal.show();
}

document.getElementById('saveEditBtn').addEventListener('click', async function() {
  if (!editingPostId) return;

  const caption = document.getElementById('editCaption').value;
  const btn = this;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

  try {
    const res = await fetch(`/posts/${editingPostId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ caption })
    });

    const data = await res.json();
    if (data.success) {
      showAlert('Post updated', 'success');
      bootstrap.Modal.getInstance(document.getElementById('editPostModal')).hide();
      loadMyPosts();
    } else {
      showAlert(data.message || 'Failed to update', 'danger');
    }
  } catch (err) {
    showAlert('Error updating post', 'danger');
    console.error(err);
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Save Changes';
  }
});

// Delete post
function openDeleteModal(postId) {
  deletingPostId = postId;
  const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
  modal.show();
}

document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
  if (!deletingPostId) return;

  const btn = this;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Deleting...';

  try {
    const res = await fetch(`/posts/${deletingPostId}`, {
      method: 'DELETE'
    });

    const data = await res.json();
    if (data.success) {
      showAlert('Post deleted', 'success');
      bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
      loadMyPosts();
    } else {
      showAlert(data.message || 'Failed to delete', 'danger');
    }
  } catch (err) {
    showAlert('Error deleting post', 'danger');
    console.error(err);
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Delete';
  }
});

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function showAlert(message, type) {
  const alertId = 'alert-' + Date.now();
  const alertHtml = `
    <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  `;
  document.body.insertAdjacentHTML('beforeend', alertHtml);
  setTimeout(() => {
    const alert = document.getElementById(alertId);
    if (alert) alert.remove();
  }, 5000);
}

// View post likes
async function viewPostLikes(postId) {
  try {
    const res = await fetch(`/posts/${postId}/likes`);
    const data = await res.json();
    
    if (!res.ok || !data.success) throw new Error(data.message || 'Failed to load likes');
    
    // Store all likes data for filtering
    window.currentLikes = data.likes || [];
    
    // Display all likes initially
    displayFilteredLikes(window.currentLikes);
    
    // Show modal using vanilla JavaScript
    const modal = document.getElementById('postLikesModal');
    modal.style.display = 'block';
    modal.classList.add('show');
    document.body.classList.add('modal-open');
    
    // Focus search box
    setTimeout(() => {
      document.getElementById('likesSearch').focus();
    }, 100);
  } catch (err) {
    console.error('View likes error:', err);
    showAlert('Failed to load likes: ' + err.message, 'danger');
  }
}

// Display filtered likes
function displayFilteredLikes(likes) {
  const likesList = document.getElementById('likesList');
  const noLikesMessage = document.getElementById('noLikesMessage');
  
  if (!likes || likes.length === 0) {
    likesList.innerHTML = '';
    noLikesMessage.style.display = 'block';
  } else {
    noLikesMessage.style.display = 'none';
    likesList.innerHTML = likes.map(user => `
      <div class="list-group-item d-flex align-items-center">
        <img src="${user.profileImage || '/images/default-profile.svg'}" 
             alt="${user.name}" 
             style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px; border: 2px solid #00d4ff;">
        <div>
          <strong style="color: #000;">${escapeHtml(user.name)}</strong>
        </div>
      </div>
    `).join('');
  }
}

// Search likes
function searchLikes() {
  const searchTerm = document.getElementById('likesSearch').value.toLowerCase().trim();
  
  if (!window.currentLikes) return;
  
  if (!searchTerm) {
    displayFilteredLikes(window.currentLikes);
    return;
  }
  
  const filtered = window.currentLikes.filter(user => 
    user.name && user.name.toLowerCase().includes(searchTerm)
  );
  
  displayFilteredLikes(filtered);
}

// Reports logic
async function viewPostReports(postId) {
  try {
    const res = await fetch(`/posts/${postId}/reports`);
    const data = await res.json();
    
    if (!res.ok || !data.success) throw new Error(data.message || 'Failed to load reports');
    
    window.currentReports = data.reports || [];
    displayFilteredReports(window.currentReports);
    
    const modal = document.getElementById('postReportsModal');
    modal.style.display = 'block';
    modal.classList.add('show');
    document.body.classList.add('modal-open');
    
    // Clear search and focus
    const searchInput = document.getElementById('reportsSearch');
    if(searchInput) {
        searchInput.value = '';
        setTimeout(() => searchInput.focus(), 100);
    }
  } catch (err) {
    console.error('View reports error:', err);
    showAlert('Failed to load reports: ' + err.message, 'danger');
  }
}

function displayFilteredReports(reports) {
    const reportsList = document.getElementById('reportsList');
    const noReportsMessage = document.getElementById('noReportsMessage');
    
    if (!reports || reports.length === 0) {
      reportsList.innerHTML = '';
      noReportsMessage.style.display = 'block';
    } else {
      noReportsMessage.style.display = 'none';
      reportsList.innerHTML = reports.map(report => `
        <div class="p-3 border border-secondary rounded">
          <div class="d-flex align-items-center mb-2">
            <img src="${(report.user && report.user.profileImage) ? report.user.profileImage : '/images/default-profile.svg'}" 
                 style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; margin-right: 10px;">
            <strong class="text-white">${report.user ? escapeHtml(report.user.name) : 'Anonymous'}</strong>
            <small class="ms-auto text-muted">${toISTDateString(report.createdAt)}</small>
          </div>
          <div class="p-2 bg-dark rounded text-danger border border-danger border-opacity-25">
            <strong>Reason:</strong> ${escapeHtml(report.reason)}
          </div>
        </div>
      `).join('');
    }
}

document.getElementById('reportsSearch')?.addEventListener('input', function() {
    const searchTerm = this.value.toLowerCase().trim();
    if (!window.currentReports) return;
    
    if (!searchTerm) {
        displayFilteredReports(window.currentReports);
        return;
    }
    
    const filtered = window.currentReports.filter(report => 
        report.user && report.user.name && report.user.name.toLowerCase().includes(searchTerm)
    );
    displayFilteredReports(filtered);
});

// Comments logic
let currentCommentPostId = null;

async function viewPostComments(postId) {
  currentCommentPostId = postId;
  await refreshCommentsList(postId);
  
  const modal = document.getElementById('postCommentsModal');
  modal.style.display = 'block';
  modal.classList.add('show');
  document.body.classList.add('modal-open');
  
  // Clear search
  const searchInput = document.getElementById('commentsSearch');
  if(searchInput) searchInput.value = '';
}

async function refreshCommentsList(postId) {
  try {
    const res = await fetch(`/posts/${postId}/comments`);
    const data = await res.json();
    
    if (!res.ok || !data.success) throw new Error(data.message || 'Failed to load comments');
    
    window.currentComments = data.comments || [];
    
    // Apply current search filter implicitly upon refresh
    const searchInput = document.getElementById('commentsSearch');
    const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
    
    if(searchTerm) {
        const filtered = window.currentComments.filter(c => 
            c.user && c.user.name && c.user.name.toLowerCase().includes(searchTerm)
        );
        displayFilteredComments(filtered, postId);
    } else {
        displayFilteredComments(window.currentComments, postId);
    }
  } catch (err) {
    console.error('Refresh comments error:', err);
    showAlert('Failed to load comments', 'danger');
  }
}

function displayFilteredComments(comments, postId) {
    const commentsList = document.getElementById('commentsList');
    const noCommentsMessage = document.getElementById('noCommentsMessage');
    
    if (!comments || comments.length === 0) {
      commentsList.innerHTML = '';
      noCommentsMessage.style.display = 'block';
    } else {
      noCommentsMessage.style.display = 'none';
      commentsList.innerHTML = comments.map(c => {
        let repliesHtml = '';
        if (c.replies && c.replies.length > 0) {
          repliesHtml = c.replies.map(r => `
            <div class="p-2 mt-2 ms-5 border-start border-secondary">
              <div class="d-flex w-100 justify-content-between align-items-start mb-1">
                <div class="d-flex align-items-center">
                  <img src="${(r.user && r.user.profileImage) ? r.user.profileImage : '/images/default-profile.svg'}" 
                       style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover; margin-right: 10px;">
                  <strong class="text-white">${r.user ? escapeHtml(r.user.name) : 'Anonymous'}</strong>
                </div>
                <small class="text-muted">${toISTDateString(r.createdAt)}</small>
              </div>
              <p class="mb-2 text-white" style="word-break: break-all; font-size: 0.9rem;">${escapeHtml(r.text)}</p>
              <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-danger p-1" style="font-size: 0.8rem;" onclick="deleteReply('${postId}', '${c._id}', '${r._id}')">
                  <i class="bi bi-trash"></i> Delete
                </button>
              </div>
            </div>
          `).join('');
        }

        return `
        <div class="p-3 border-bottom border-secondary ${c.isPinned ? 'bg-success bg-opacity-10 border border-success rounded' : ''}">
          <div class="d-flex w-100 justify-content-between align-items-start mb-1">
            <div class="d-flex align-items-center">
              <img src="${(c.user && c.user.profileImage) ? c.user.profileImage : '/images/default-profile.svg'}" 
                   style="width: 30px; height: 30px; border-radius: 50%; object-fit: cover; margin-right: 10px;">
              <strong class="text-white">${c.user ? escapeHtml(c.user.name) : 'Anonymous'}</strong>
              ${c.isPinned ? '<span class="badge bg-success ms-2"><i class="bi bi-pin-angle-fill"></i> Pinned</span>' : ''}
              ${c.isHidden ? '<span class="badge bg-secondary ms-2"><i class="bi bi-eye-slash"></i> Hidden</span>' : ''}
            </div>
            <small class="text-muted">${toISTDateString(c.createdAt)}</small>
          </div>
          <p class="mb-2 ms-5 text-white" style="word-break: break-all;">${escapeHtml(c.text)}</p>
          <div class="ms-5 d-flex gap-2 align-items-center">
            <button class="btn btn-sm btn-outline-success" onclick="toggleReplyBoxArtistDashboard('${c._id}')">
              <i class="bi bi-reply"></i> Reply
            </button>
            <button class="btn btn-sm btn-outline-primary" onclick="toggleCommentPin('${postId}', '${c._id}')">
              <i class="bi bi-pin-angle"></i> ${c.isPinned ? 'Unpin' : 'Pin'}
            </button>
            <button class="btn btn-sm btn-outline-secondary" onclick="toggleCommentHide('${postId}', '${c._id}')">
              <i class="bi bi-eye-slash"></i> ${c.isHidden ? 'Unhide' : 'Hide'}
            </button>
            <button class="btn btn-sm btn-outline-danger" onclick="deleteComment('${postId}', '${c._id}')">
              <i class="bi bi-trash"></i> Delete
            </button>
          </div>
          <div id="reply-box-artist-${c._id}" class="d-none ms-5 mt-3 d-flex gap-2">
            <input type="text" id="reply-input-artist-${c._id}" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Write a reply...">
            <button class="btn btn-sm btn-success" onclick="submitReplyArtistDashboard('${postId}', '${c._id}')"><i class="bi bi-send"></i></button>
          </div>
          ${repliesHtml}
        </div>
      `}).join('');
    }
}

document.getElementById('commentsSearch')?.addEventListener('input', function() {
    const searchTerm = this.value.toLowerCase().trim();
    if (!window.currentComments) return;
    
    if (!searchTerm) {
        displayFilteredComments(window.currentComments, currentCommentPostId);
        return;
    }
    
    const filtered = window.currentComments.filter(c => 
        c.user && c.user.name && c.user.name.toLowerCase().includes(searchTerm)
    );
    displayFilteredComments(filtered, currentCommentPostId);
});

document.getElementById('addCommentBtn').addEventListener('click', async function() {
  const input = document.getElementById('newCommentInput');
  const text = input.value.trim();
  if (!text || !currentCommentPostId) return;
  
  const btn = this;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
  
  try {
    const res = await fetch(`/posts/${currentCommentPostId}/comments`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text }),
      skipLoader: true
    });
    
    const data = await res.json();
    if (data.success) {
      input.value = '';
      await refreshCommentsList(currentCommentPostId);
    } else {
      showAlert(data.message || 'Failed to post comment', 'danger');
    }
  } catch (err) {
    console.error('Add comment error:', err);
    showAlert('Error adding comment', 'danger');
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Post';
  }
});

async function toggleCommentPin(postId, commentId) {
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}/pin`, { method: 'PUT', skipLoader: true });
    const data = await res.json();
    if (data.success) await refreshCommentsList(postId);
    else showAlert(data.message || 'Failed to pin comment', 'danger');
  } catch (err) {
    showAlert('Error pinning comment', 'danger');
  }
}

async function toggleCommentHide(postId, commentId) {
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}/hide`, { method: 'PUT', skipLoader: true });
    const data = await res.json();
    if (data.success) await refreshCommentsList(postId);
    else showAlert(data.message || 'Failed to hide comment', 'danger');
  } catch (err) {
    showAlert('Error hiding comment', 'danger');
  }
}

async function deleteComment(postId, commentId) {
  if (!confirm('Are you sure you want to delete this comment?')) return;
  
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}`, { method: 'DELETE', skipLoader: true });
    const data = await res.json();
    if (data.success) {
       await refreshCommentsList(postId);
       if (typeof loadMyPosts === 'function') loadMyPosts();
    }
    else showAlert(data.message || 'Failed to delete comment', 'danger');
  } catch (err) {
    showAlert('Error deleting comment', 'danger');
  }
}

async function deleteReply(postId, commentId, replyId) {
  if (!confirm('Are you sure you want to delete this reply?')) return;
  
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}/replies/${replyId}`, { method: 'DELETE', skipLoader: true });
    const data = await res.json();
    if (data.success) {
      await refreshCommentsList(postId);
    } else showAlert(data.message || 'Failed to delete reply', 'danger');
  } catch (err) {
    showAlert('Error deleting reply', 'danger');
  }
}

function toggleReplyBoxArtistDashboard(commentId) {
  const box = document.getElementById(`reply-box-artist-${commentId}`);
  if (box) box.classList.toggle('d-none');
}

async function submitReplyArtistDashboard(postId, commentId) {
  const input = document.getElementById(`reply-input-artist-${commentId}`);
  if (!input) return;
  const text = input.value.trim();
  if (!text) return;
  
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}/replies`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text }),
      skipLoader: true
    });
    const data = await res.json();
    if (data.success) {
      input.value = '';
      await refreshCommentsList(postId);
    } else {
      showAlert(data.message, 'danger');
    }
  } catch (err) {
    showAlert('Error submitting reply', 'danger');
  }
}

// Close modal function
document.addEventListener('click', function(e) {
  if (e.target.matches('[data-bs-dismiss="modal"]') || e.target.closest('[data-bs-dismiss="modal"]')) {
    const likesModal = document.getElementById('postLikesModal');
    if (likesModal) {
      likesModal.classList.remove('show');
      likesModal.style.display = 'none';
    }
    const reportsModal = document.getElementById('postReportsModal');
    if (reportsModal) {
      reportsModal.classList.remove('show');
      reportsModal.style.display = 'none';
    }
    const commentsModal = document.getElementById('postCommentsModal');
    if (commentsModal) {
      commentsModal.classList.remove('show');
      commentsModal.style.display = 'none';
    }
    document.body.classList.remove('modal-open');
  }
});

// Load posts on page load
document.addEventListener('DOMContentLoaded', loadMyPosts);
</script>
