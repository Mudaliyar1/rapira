<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Artist Profile - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="admin-layout">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white p-0">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0 text-primary fw-bold">Artist Dashboard</h5>
        <button class="btn btn-sm btn-outline-light d-md-none" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <% if (artist.user.profileImage) { %>
              <img src="<%= artist.user.profileImage %>" alt="<%= artist.user.name %>" class="rounded-circle" width="48" height="48">
            <% } else { %>
              <i class="bi bi-person-circle fs-1"></i>
            <% } %>
          </div>
          <div>
            <h6 class="mb-0"><%= artist.user.name %></h6>
            <small class="text-muted">Artist</small>
          </div>
        </div>
        <ul class="nav flex-column">
          <li class="nav-item mb-2">
            <a href="/artists/dashboard" class="nav-link text-white p-2 rounded">
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/concerts/create" class="nav-link text-white p-2 rounded">
              <i class="bi bi-calendar-plus me-2"></i> Create Concert
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/upload-content" class="nav-link text-white p-2 rounded">
              <i class="bi bi-cloud-upload me-2"></i> Upload Content
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/edit-profile" class="nav-link text-white p-2 rounded active bg-primary">
              <i class="bi bi-pencil-square me-2"></i> Edit Profile
            </a>
          </li>
          <li class="nav-item mt-4">
            <a href="/artists/<%= artist._id %>" class="nav-link text-white p-2 rounded">
              <i class="bi bi-eye me-2"></i> View Public Profile
            </a>
          </li>
          <li class="nav-item">
            <a href="/" class="nav-link text-white p-2 rounded">
              <i class="bi bi-arrow-left me-2"></i> Back to Site
            </a>
          </li>
          <li class="nav-item">
            <a href="/auth/logout" class="nav-link text-white p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Edit Artist Profile</h1>
        <div>
          <a href="/artists/dashboard" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
          </a>
          <button class="btn btn-primary d-md-none" id="adminToggle">
            <i class="bi bi-list"></i>
          </button>
        </div>
      </div>

      <!-- Edit Profile Form -->
      <div class="card mb-4">
        <div class="card-header bg-white py-3">
          <h5 class="card-title fw-bold mb-0">Basic Information</h5>
        </div>
        <div class="card-body p-4">
          <form action="/users/update-profile" method="POST" enctype="multipart/form-data">
            <div class="row g-4">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="name" class="form-label">Full Name</label>
                  <input type="text" class="form-control" id="name" name="name" value="<%= artist.user.name %>" required>
                </div>
                
                <div class="mb-3">
                  <label for="bio" class="form-label">Bio</label>
                  <textarea class="form-control" id="bio" name="bio" rows="4"><%= artist.user.bio %></textarea>
                </div>
                
                <div class="mb-3">
                  <label for="city" class="form-label">City</label>
                  <input type="text" class="form-control" id="city" name="city" value="<%= artist.user.city %>">
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="profileImage" class="form-label">Profile Image</label>
                  <input type="file" class="form-control" id="profileImage" name="profileImage">
                  <div class="form-text">Recommended size: 400x400px (square). JPG, PNG, GIF (max 5MB)</div>
                  
                  <% if (artist.user.profileImage) { %>
                    <div class="mt-2">
                      <img src="<%= artist.user.profileImage %>" alt="Current Profile Image" class="img-thumbnail" width="100">
                      <small class="d-block text-muted">Current profile image</small>
                    </div>
                  <% } %>
                </div>
                
                <div class="mb-3">
                  <label class="form-label">Social Media Links</label>
                  <div class="input-group mb-2">
                    <span class="input-group-text"><i class="bi bi-instagram"></i></span>
                    <input type="text" class="form-control" id="instagram" name="instagram" placeholder="Instagram URL" value="<%= artist.user.socialLinks.instagram %>">
                  </div>
                  <div class="input-group mb-2">
                    <span class="input-group-text"><i class="bi bi-twitter-x"></i></span>
                    <input type="text" class="form-control" id="twitter" name="twitter" placeholder="Twitter URL" value="<%= artist.user.socialLinks.twitter %>">
                  </div>
                  <div class="input-group mb-2">
                    <span class="input-group-text"><i class="bi bi-youtube"></i></span>
                    <input type="text" class="form-control" id="youtube" name="youtube" placeholder="YouTube URL" value="<%= artist.user.socialLinks.youtube %>">
                  </div>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-spotify"></i></span>
                    <input type="text" class="form-control" id="spotify" name="spotify" placeholder="Spotify URL" value="<%= artist.user.socialLinks.spotify %>">
                  </div>
                </div>
              </div>
            </div>
            
            <hr class="my-4">
            
            <h5 class="fw-bold mb-3">Artist Information</h5>
            <div class="row g-4">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="stageName" class="form-label">Stage Name</label>
                  <input type="text" class="form-control" id="stageName" name="stageName" value="<%= artist.stageName %>">
                </div>
                
                <div class="mb-3">
                  <label for="genre" class="form-label">Genre</label>
                  <input type="text" class="form-control" id="genre" name="genre" value="<%= artist.genre %>">
                </div>
                
                <div class="mb-3">
                  <label for="yearsActive" class="form-label">Years Active</label>
                  <input type="number" class="form-control" id="yearsActive" name="yearsActive" value="<%= artist.yearsActive %>" min="0">
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="about" class="form-label">About (Artist Bio)</label>
                  <textarea class="form-control" id="about" name="about" rows="4"><%= artist.about %></textarea>
                </div>
                
                <div class="mb-3">
                  <label for="achievements" class="form-label">Achievements</label>
                  <textarea class="form-control" id="achievements" name="achievements" rows="3" placeholder="Enter achievements separated by commas"><%= artist.achievements ? artist.achievements.join(', ') : '' %></textarea>
                  <div class="form-text">Enter each achievement separated by commas</div>
                </div>
              </div>
              
              <div class="col-12">
                <div class="mb-3">
                  <label for="bannerImage" class="form-label">Banner Image</label>
                  <input type="file" class="form-control" id="bannerImage" name="bannerImage">
                  <div class="form-text">Recommended size: 1200x400px (3:1 ratio). JPG, PNG, GIF (max 5MB)</div>
                  
                  <% if (artist.bannerImage && artist.bannerImage !== '/images/default-banner.jpg') { %>
                    <div class="mt-2">
                      <img src="<%= artist.bannerImage %>" alt="Current Banner Image" class="img-thumbnail" width="200">
                      <small class="d-block text-muted">Current banner image</small>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
            
            <div class="d-flex justify-content-end gap-2 mt-4">
              <a href="/artists/dashboard" class="btn btn-outline-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
      
      <!-- Password Change Section -->
      <div class="card">
        <div class="card-header bg-white py-3">
          <h5 class="card-title fw-bold mb-0">Change Password</h5>
        </div>
        <div class="card-body p-4">
          <form action="/users/change-password" method="POST">
            <div class="row g-4">
              <div class="col-md-4">
                <div class="mb-3">
                  <label for="currentPassword" class="form-label">Current Password</label>
                  <input type="password" class="form-control" id="currentPassword" name="currentPassword" required>
                </div>
              </div>
              <div class="col-md-4">
                <div class="mb-3">
                  <label for="newPassword" class="form-label">New Password</label>
                  <input type="password" class="form-control" id="newPassword" name="newPassword" required>
                </div>
              </div>
              <div class="col-md-4">
                <div class="mb-3">
                  <label for="confirmPassword" class="form-label">Confirm New Password</label>
                  <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
                </div>
              </div>
            </div>
            
            <div class="d-flex justify-content-end gap-2 mt-2">
              <button type="submit" class="btn btn-primary">Change Password</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Admin Toggle -->
  <button class="btn admin-toggle d-md-none" id="adminToggle">
    <i class="bi bi-list"></i>
  </button>

  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
</body>
</html>
