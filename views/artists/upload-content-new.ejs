<%- include('../partials/artist-header') %>

<!-- Upload Form -->
<div class="card mb-4">
  <div class="card-body p-4">
    <form action="/artists/upload-content" method="POST" enctype="multipart/form-data">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="title" class="form-label">Content Title</label>
            <input type="text" class="form-control" id="title" name="title" placeholder="Enter title" required>
          </div>

          <div class="mb-3">
            <label for="type" class="form-label">Content Type</label>
            <select class="form-select" id="type" name="type" required>
              <option value="" selected disabled>Select content type</option>
              <option value="song">Song (YouTube)</option>
              <option value="video">Video (YouTube)</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" name="description" rows="4" placeholder="Enter description"></textarea>
          </div>
        </div>

        <div class="col-md-6">
          <div class="mb-3">
            <label for="youtubeLink" class="form-label">YouTube Link</label>
            <input type="text" class="form-control" id="youtubeLink" name="youtubeLink" placeholder="https://www.youtube.com/watch?v=..." required>
            <div class="form-text">
              Paste a YouTube link for your song or video content.<br>
              Supported formats:
              <ul class="mt-1">
                <li>https://www.youtube.com/watch?v=dQw4w9WgXcQ</li>
                <li>https://youtu.be/dQw4w9WgXcQ</li>
                <li>https://youtube.com/embed/dQw4w9WgXcQ</li>
              </ul>
            </div>
          </div>

          <div class="mb-3 alert alert-info">
            <h6><i class="bi bi-info-circle-fill me-2"></i>YouTube Embedding Tips</h6>
            <ul class="mb-0">
              <li>Make sure your YouTube video is set to "Public" or "Unlisted"</li>
              <li>Videos set to "Private" cannot be embedded</li>
              <li>For best quality, upload videos in HD (1080p) resolution</li>
              <li>YouTube automatically generates thumbnails, but you can also upload a custom one below</li>
            </ul>
          </div>

          <div class="mb-3">
            <label for="thumbnailImage" class="form-label">Thumbnail Image</label>
            <input type="file" class="form-control" id="thumbnailImage" name="thumbnailImage">
            <div class="form-text">Recommended size: 800x450px (16:9 ratio). JPG, PNG, GIF (max 5MB)</div>
          </div>

          <div class="mb-3">
            <div class="card bg-light">
              <div class="card-body">
                <h6 class="card-title">Content Guidelines</h6>
                <ul class="mb-0 small">
                  <li>Ensure you have the rights to all content you upload</li>
                  <li>Explicit content must be appropriately labeled</li>
                  <li>Content that violates our terms of service will be removed</li>
                  <li>Large files may take longer to upload</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Upload Progress Bar -->
        <div class="col-12">
          <div id="uploadProgressContainer" class="d-none mb-3">
            <div class="alert alert-warning mb-3 d-none" id="uploadWarning">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <strong>Important:</strong> Please do not close this page or navigate away while your content is uploading.
            </div>
            <label class="form-label">Upload Progress</label>
            <div class="progress mb-2" style="height: 20px;">
              <div id="uploadProgressBar" class="progress-bar bg-primary progress-bar-striped progress-bar-animated"
                   role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%">
              </div>
            </div>
            <div class="d-flex justify-content-between">
              <span id="uploadProgressText">0%</span>
              <span id="uploadStatus">Waiting to upload...</span>
            </div>
          </div>
          <hr>
          <div class="d-flex justify-content-end gap-2">
            <a href="/artists/dashboard" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-cloud-upload me-1"></i> Upload Content
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Your Content -->
<div class="card">
  <div class="card-header bg-white py-3">
    <h5 class="card-title fw-bold mb-0">Your Content</h5>
  </div>
  <div class="card-body">
    <div class="row g-4">
      <% if (artist.content && artist.content.length > 0) { %>
        <% artist.content.forEach(item => { %>
          <div class="col-md-4 col-lg-3">
            <div class="card content-card h-100">
              <div class="position-relative">
                <img src="<%= item.thumbnailUrl %>" class="card-img-top content-thumbnail" alt="<%= item.title %>">
                <span class="badge <%= item.type === 'song' ? 'bg-primary' : item.type === 'video' ? 'bg-danger' : 'bg-info' %> content-type-badge">
                  <i class="bi <%= item.type === 'song' ? 'bi-music-note' : item.type === 'video' ? 'bi-camera-video' : 'bi-file-text' %>"></i>
                  <%= item.type.charAt(0).toUpperCase() + item.type.slice(1) %>
                </span>
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= item.title %></h5>
                <% if (item.description) { %>
                  <p class="card-text"><%= item.description.length > 50 ? item.description.substring(0, 50) + '...' : item.description %></p>
                <% } %>
                <p class="card-text">
                  <small class="text-muted">
                    <i class="bi bi-calendar3"></i> <%= new Date(item.releaseDate).toLocaleDateString() %>
                  </small>
                </p>
              </div>
              <div class="card-footer bg-white border-top-0 d-flex">
                <a href="/content/<%= item._id %>" class="btn btn-outline-primary flex-grow-1 me-2">
                  <%= item.type === 'song' ? 'Listen' : item.type === 'video' ? 'Watch' : 'Read' %>
                </a>
                <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= item._id %>">
                  <i class="bi bi-trash"></i>
                </button>

                <!-- Delete Modal -->
                <div class="modal fade" id="deleteModal<%= item._id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <p>Are you sure you want to delete "<%= item.title %>"?</p>
                        <p class="text-danger mb-0">This action cannot be undone.</p>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form action="/artists/content/<%= item._id %>/delete" method="POST">
                          <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-4">
          <p class="mb-0">You haven't uploaded any content yet.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="/js/content-upload-validation.js"></script>
<script src="/js/upload-progress.js"></script>
<script>
  // Additional scripts if needed
</script>

<%- include('../partials/artist-footer') %>
