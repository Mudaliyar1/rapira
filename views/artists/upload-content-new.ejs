<%- include('../partials/artist-header') %>

<!-- Upload Form -->
<div class="card mb-4">
  <div class="card-body p-4">
    <form action="/artists/upload-content" method="POST" enctype="multipart/form-data">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="title" class="form-label">Content Title</label>
            <input type="text" class="form-control" id="title" name="title" placeholder="Enter title" required>
          </div>

          <div class="mb-3">
            <label for="type" class="form-label" style="color: #ffffff !important;">Content Type</label>
            <select class="form-select" id="type" name="type" required style="color: #ffffff !important; background-color: #000000 !important; border: 1px solid #dee2e6 !important;">
              <option value="" selected disabled style="color: #ffffff !important; background-color: #000000 !important;">Select content type</option>
              <option value="song" style="color: #ffffff !important; background-color: #000000 !important;">Song (YouTube)</option>
              <option value="video" style="color: #ffffff !important; background-color: #000000 !important;">Video (YouTube)</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" name="description" rows="4" placeholder="Enter description"></textarea>
          </div>
        </div>

        <div class="col-md-6">
          <div class="mb-3">
            <label for="youtubeLink" class="form-label">YouTube Link</label>
            <input type="text" class="form-control" id="youtubeLink" name="youtubeLink" placeholder="https://www.youtube.com/watch?v=..." required>
            <div class="form-text">
              Paste a YouTube link for your song or video content.<br>
              Supported formats:
              <ul class="mt-1">
                <li>https://www.youtube.com/watch?v=dQw4w9WgXcQ</li>
                <li>https://youtu.be/dQw4w9WgXcQ</li>
                <li>https://youtube.com/embed/dQw4w9WgXcQ</li>
              </ul>
            </div>
          </div>

          <div class="mb-3 alert" style="background-color: #d1ecf1;">
            <h6 style="color: #000000 !important;"><i class="bi bi-info-circle-fill me-2"></i>YouTube Embedding Tips</h6>
            <ul class="mb-0">
              <li style="color: #000000 !important;">Make sure your YouTube video is set to "Public" or "Unlisted"</li>
              <li style="color: #000000 !important;">Videos set to "Private" cannot be embedded</li>
              <li style="color: #000000 !important;">For best quality, upload videos in HD (1080p) resolution</li>
              <li style="color: #000000 !important;">YouTube automatically generates thumbnails, but you can also upload a custom one below</li>
            </ul>
          </div>

          <div class="mb-3">
            <label for="thumbnailImage" class="form-label">Thumbnail Image</label>
            <input type="file" class="form-control" id="thumbnailImage" name="thumbnailImage">
            <div class="form-text">Recommended size: 800x450px (16:9 ratio). JPG, PNG, GIF (max 5MB)</div>
          </div>

          <div class="mb-3">
            <div class="card bg-light">
              <div class="card-body">
                <h6 class="card-title" style="color: #000000 !important;">Content Guidelines</h6>
                <ul class="mb-0 small">
                  <li style="color: #000000 !important;">Ensure you have the rights to all content you upload</li>
                  <li style="color: #000000 !important;">Explicit content must be appropriately labeled</li>
                  <li style="color: #000000 !important;">Content that violates our terms of service will be removed</li>
                  <li style="color: #000000 !important;">Large files may take longer to upload</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Upload Progress Bar -->
        <div class="col-12">
          <div id="uploadProgressContainer" class="d-none mb-3">
            <div class="alert alert-warning mb-3 d-none" id="uploadWarning">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <strong>Important:</strong> Please do not close this page or navigate away while your content is uploading.
            </div>
            <label class="form-label">Upload Progress</label>
            <div class="progress mb-2" style="height: 20px;">
              <div id="uploadProgressBar" class="progress-bar bg-primary progress-bar-striped progress-bar-animated"
                   role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%">
              </div>
            </div>
            <div class="d-flex justify-content-between">
              <span id="uploadProgressText">0%</span>
              <span id="uploadStatus">Waiting to upload...</span>
            </div>
          </div>
          <hr>
          <div class="d-flex justify-content-end gap-2">
            <a href="/artists/dashboard" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-cloud-upload me-1"></i> Upload Content
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="/js/content-upload-validation.js"></script>
<script src="/js/upload-progress.js"></script>
<script>
  // Additional scripts if needed
</script>

<style>
  /* Fix dropdown styling */
  select.form-select option {
    color: #000 !important;
    background-color: #fff !important;
  }

  /* Ensure dropdown text is visible in all states */
  select.form-select {
    color: #000 !important;
    background-color: #fff !important;
  }
</style>

<%- include('../partials/artist-footer') %>
