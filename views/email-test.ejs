<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Email Test - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Email Test Tool</h3>
          </div>
          <div class="card-body p-4">
            <div class="alert alert-info">
              <i class="bi bi-info-circle-fill me-2"></i> Use this tool to test email delivery. This helps verify that your email configuration is working correctly.
            </div>

            <ul class="nav nav-tabs mb-4" id="emailTestTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">General Test</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="concert-tab" data-bs-toggle="tab" data-bs-target="#concert" type="button" role="tab" aria-controls="concert" aria-selected="false">Concert Submission Test</button>
              </li>
            </ul>

            <div class="tab-content" id="emailTestTabsContent">
              <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                <form id="testEmailForm" class="mb-4">
                  <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                    <div class="form-text">Enter the email address where you want to receive the test email.</div>
                  </div>

                  <button type="submit" class="btn btn-primary" id="sendButton">
                    <i class="bi bi-envelope me-2"></i> Send Test Email
                  </button>
                </form>
              </div>

              <div class="tab-pane fade" id="concert" role="tabpanel" aria-labelledby="concert-tab">
                <form id="concertEmailForm" class="mb-4">
                  <div class="mb-3">
                    <label for="concertEmail" class="form-label">Email Address</label>
                    <input type="email" class="form-control" id="concertEmail" name="email" required>
                    <div class="form-text">Enter the email address where you want to receive the concert submission test email.</div>
                  </div>

                  <div class="mb-3">
                    <label for="artistName" class="form-label">Artist Name (Optional)</label>
                    <input type="text" class="form-control" id="artistName" name="name" placeholder="Enter artist name">
                    <div class="form-text">Enter a name to personalize the email. If left blank, the name will be derived from the email.</div>
                  </div>

                  <button type="submit" class="btn btn-primary" id="concertSendButton">
                    <i class="bi bi-envelope me-2"></i> Send Concert Submission Test Email
                  </button>
                </form>
              </div>
            </div>

            <div id="resultContainer" class="d-none">
              <h5>Test Results:</h5>
              <div id="resultMessage" class="alert"></div>

              <div class="mt-3">
                <h6>Response Details:</h6>
                <pre id="responseDetails" class="bg-light p-3 rounded" style="max-height: 200px; overflow-y: auto;"></pre>
              </div>
            </div>

            <div class="mt-4">
              <h5>Troubleshooting Tips:</h5>
              <ul class="list-group list-group-flush">
                <li class="list-group-item">
                  <i class="bi bi-check-circle-fill text-success me-2"></i> Check your spam/junk folder if you don't see the email in your inbox
                </li>
                <li class="list-group-item">
                  <i class="bi bi-check-circle-fill text-success me-2"></i> Verify that the sender email (vijaymudaliyar224@gmail.com) is authorized in your Brevo account
                </li>
                <li class="list-group-item">
                  <i class="bi bi-check-circle-fill text-success me-2"></i> Make sure your server's IP address is authorized in Brevo at <a href="https://app.brevo.com/security/authorised_ips" target="_blank">https://app.brevo.com/security/authorised_ips</a>
                </li>
                <li class="list-group-item">
                  <i class="bi bi-check-circle-fill text-success me-2"></i> Check the server logs for any error messages
                </li>
              </ul>
            </div>
          </div>
        </div>

        <div class="text-center mt-4">
          <a href="/" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i> Back to Home
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <script>
    $(document).ready(function() {
      // Function to handle AJAX response
      function handleEmailResponse(response, isSuccess, resultContainer, resultMessage, responseDetails) {
        // Show result container
        resultContainer.removeClass('d-none');

        if (isSuccess) {
          // Show success message
          resultMessage.removeClass('alert-danger').addClass('alert-success');
          resultMessage.html(`<i class="bi bi-check-circle-fill me-2"></i> ${response.message}`);
        } else {
          // Show error message
          resultMessage.removeClass('alert-success').addClass('alert-danger');

          let errorMessage = 'Failed to send email';
          try {
            if (typeof response === 'string') {
              response = JSON.parse(response);
            }
            errorMessage = response.message || errorMessage;
          } catch (e) {
            console.error('Error parsing response:', e);
          }

          resultMessage.html(`<i class="bi bi-exclamation-triangle-fill me-2"></i> ${errorMessage}`);
        }

        // Show response details
        try {
          if (typeof response === 'string') {
            responseDetails.text(response || 'No details available');
          } else {
            responseDetails.text(JSON.stringify(response, null, 2));
          }
        } catch (e) {
          responseDetails.text('Error displaying response details');
        }
      }

      // General test email form
      $('#testEmailForm').on('submit', function(e) {
        e.preventDefault();

        const email = $('#email').val();
        const sendButton = $('#sendButton');

        // Disable button and show loading state
        sendButton.prop('disabled', true);
        sendButton.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...');

        // Hide previous results
        $('#resultContainer').addClass('d-none');

        // Send test email
        $.ajax({
          url: `/test-email?email=${encodeURIComponent(email)}`,
          method: 'GET',
          success: function(response) {
            handleEmailResponse(response, true, $('#resultContainer'), $('#resultMessage'), $('#responseDetails'));
          },
          error: function(xhr) {
            let response;
            try {
              response = JSON.parse(xhr.responseText);
            } catch (e) {
              response = xhr.responseText || { message: 'Failed to send test email' };
            }
            handleEmailResponse(response, false, $('#resultContainer'), $('#resultMessage'), $('#responseDetails'));
          },
          complete: function() {
            // Reset button state
            sendButton.prop('disabled', false);
            sendButton.html('<i class="bi bi-envelope me-2"></i> Send Test Email');
          }
        });
      });

      // Concert submission test email form
      $('#concertEmailForm').on('submit', function(e) {
        e.preventDefault();

        const email = $('#concertEmail').val();
        const name = $('#artistName').val();
        const sendButton = $('#concertSendButton');

        // Disable button and show loading state
        sendButton.prop('disabled', true);
        sendButton.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...');

        // Hide previous results
        $('#resultContainer').addClass('d-none');

        // Build URL with parameters
        let url = `/test-concert-email?email=${encodeURIComponent(email)}`;
        if (name) {
          url += `&name=${encodeURIComponent(name)}`;
        }

        // Send concert submission test email
        $.ajax({
          url: url,
          method: 'GET',
          success: function(response) {
            handleEmailResponse(response, true, $('#resultContainer'), $('#resultMessage'), $('#responseDetails'));
          },
          error: function(xhr) {
            let response;
            try {
              response = JSON.parse(xhr.responseText);
            } catch (e) {
              response = xhr.responseText || { message: 'Failed to send concert submission test email' };
            }
            handleEmailResponse(response, false, $('#resultContainer'), $('#resultMessage'), $('#responseDetails'));
          },
          complete: function() {
            // Reset button state
            sendButton.prop('disabled', false);
            sendButton.html('<i class="bi bi-envelope me-2"></i> Send Concert Submission Test Email');
          }
        });
      });
    });
  </script>
</body>
</html>
