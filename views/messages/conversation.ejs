<%- contentFor('body') %>

<section class="py-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-4 mb-4 mb-lg-0 d-none d-lg-block">
        <div class="glass-card-dark h-100">
          <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 text-white">Messages</h5>
            <a href="/messages/find" class="btn btn-sm btn-primary">
              <i class="bi bi-search"></i> Find Users
            </a>
          </div>
          <div class="card-body p-0">
            <div class="list-group list-group-flush border-bottom scrollarea" style="max-height: 600px; overflow-y: auto;">
              <a href="/messages" class="list-group-item list-group-item-action py-3 lh-tight border-secondary bg-dark text-white">
                <div class="d-flex w-100 align-items-center justify-content-between">
                  <strong class="mb-1"><i class="bi bi-arrow-left me-2"></i> Back to Inbox</strong>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-lg-8">
        <div class="glass-card-dark h-100 d-flex flex-column">
          <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <a href="/messages" class="btn btn-sm btn-outline-light me-2 d-lg-none">
                <i class="bi bi-arrow-left"></i>
              </a>
              <div class="d-flex align-items-center">
                <img src="<%= otherUser.profileImage || '/images/default-profile.jpg' %>" class="rounded-circle me-2" width="40" height="40" alt="<%= otherUser.name %>">
                <div>
                  <h5 class="card-title mb-0 text-white"><%= otherUser.name %></h5>
                  <div class="d-flex flex-wrap gap-1">
                    <% if (otherUser.role === 'artist' && otherUserArtist) { %>
                      <span class="badge bg-primary">
                        <%= otherUserArtist.artistLevel %> Artist
                      </span>
                    <% } %>
                    <% if (otherUserRoles && otherUserRoles.length > 0) { %>
                      <% otherUserRoles.forEach(userRole => { %>
                        <% if (userRole.role && userRole.role.name) { %>
                          <span class="badge bg-secondary">
                            <i class="bi <%= userRole.role.icon %> me-1"></i> <%= userRole.role.name %>
                          </span>
                        <% } %>
                      <% }); %>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="card-body p-0 flex-grow-1 d-flex flex-column">
            <div class="chat-messages p-3 scrollarea" style="flex: 1; overflow-y: auto; max-height: 400px;">
              <% if (messages && messages.length > 0) { %>
                <% messages.forEach(message => { %>
                  <%
                    // Ensure both IDs are strings for comparison
                    const isCurrentUser = message.sender.toString() === user.id.toString();
                  %>
                  <div class="row mb-3">
                    <% if (isCurrentUser) { %>
                      <!-- Outgoing message - align right -->
                      <div class="col-2"></div>
                      <div class="col-10">
                        <div class="d-flex justify-content-end">
                          <div class="message-bubble bg-primary text-white rounded-3 p-3" style="max-width: 85%;">
                            <%= message.content %>
                            <div class="message-time text-end mt-1">
                              <small class="opacity-75">
                                <%= new Date(message.createdAt).toLocaleString() %>
                                <i class="bi <%= message.isRead ? 'bi-check-all' : 'bi-check' %> ms-1"></i>
                              </small>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% } else { %>
                      <!-- Incoming message - align left -->
                      <div class="col-10">
                        <div class="d-flex justify-content-start">
                          <div class="message-bubble bg-secondary text-white rounded-3 p-3" style="max-width: 85%;">
                            <%= message.content %>
                            <div class="message-time mt-1">
                              <small class="opacity-75">
                                <%= new Date(message.createdAt).toLocaleString() %>
                              </small>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="col-2"></div>
                    <% } %>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="text-center py-5">
                  <i class="bi bi-chat display-1 text-muted mb-3"></i>
                  <h3 class="text-white">No Messages Yet</h3>
                  <p class="text-white-75">Send a message to start the conversation.</p>
                </div>
              <% } %>
            </div>
            
            <div class="chat-input p-3 border-top border-secondary">
              <form action="/messages/send" method="POST">
                <input type="hidden" name="recipientId" value="<%= otherUser._id %>">
                <div class="input-group">
                  <input type="text" class="form-control" name="content" placeholder="Type your message..." required>
                  <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send"></i>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chat-messages {
    width: 100%;
    scroll-behavior: smooth;
    overflow-anchor: none; /* Prevent automatic scroll adjustments */
  }

  .message-bubble {
    word-wrap: break-word;
    word-break: break-word;
    position: relative;
  }

  .message-bubble::before {
    content: '';
    position: absolute;
    width: 0;
    height: 0;
    top: 15px;
  }

  /* Outgoing message tail (right side) */
  .bg-primary.message-bubble::before {
    right: -8px;
    border-left: 8px solid var(--bs-primary);
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
  }

  /* Incoming message tail (left side) */
  .bg-secondary.message-bubble::before {
    left: -8px;
    border-right: 8px solid var(--bs-secondary);
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
  }

  .message-time {
    font-size: 0.75rem;
  }
  
  .scrollarea {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }
  
  .scrollarea::-webkit-scrollbar {
    width: 6px;
  }
  
  .scrollarea::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .scrollarea::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }
</style>

<script>
  // Robust chat scroll management
  (function() {
    'use strict';

    let chatMessages;
    let messageForm;
    let messageInput;
    let isUserAtBottom = true;

    // Function to force scroll to bottom with multiple fallbacks
    function forceScrollToBottom() {
      if (!chatMessages) return;

      // Method 1: Direct scroll
      chatMessages.scrollTop = chatMessages.scrollHeight;

      // Method 2: Smooth scroll (fallback)
      setTimeout(() => {
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 10);

      // Method 3: Force with requestAnimationFrame
      requestAnimationFrame(() => {
        chatMessages.scrollTop = chatMessages.scrollHeight;
      });

      // Method 4: Final fallback
      setTimeout(() => {
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 100);
    }

    // Check if user is at bottom of chat
    function checkIfAtBottom() {
      if (!chatMessages) return true;
      const threshold = 50; // pixels from bottom
      return chatMessages.scrollTop >= (chatMessages.scrollHeight - chatMessages.clientHeight - threshold);
    }

    // Initialize chat
    function initializeChat() {
      chatMessages = document.querySelector('.chat-messages');
      messageForm = document.querySelector('form[action="/messages/send"]');
      messageInput = document.querySelector('input[name="content"]');

      if (!chatMessages) {
        console.warn('Chat messages container not found');
        return;
      }

      // Always scroll to bottom on page load
      forceScrollToBottom();

      // Set up scroll listener
      chatMessages.addEventListener('scroll', () => {
        isUserAtBottom = checkIfAtBottom();
      });

      // Handle form submission
      if (messageForm) {
        messageForm.addEventListener('submit', function(e) {
          if (!messageInput || messageInput.value.trim() === '') {
            e.preventDefault();
            return false;
          }

          // Mark that we should scroll to bottom after page reload
          localStorage.setItem('chatScrollToBottom', 'true');
          localStorage.setItem('chatScrollTimestamp', Date.now().toString());
        });
      }

      // Auto-focus message input
      if (messageInput) {
        messageInput.focus();

        // Handle Enter key
        messageInput.addEventListener('keypress', function(e) {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (messageInput.value.trim() !== '') {
              messageForm.submit();
            }
          }
        });
      }

      // Check if we need to scroll after form submission
      const shouldScroll = localStorage.getItem('chatScrollToBottom');
      const scrollTimestamp = localStorage.getItem('chatScrollTimestamp');

      if (shouldScroll === 'true') {
        // Only scroll if the timestamp is recent (within 5 seconds)
        const now = Date.now();
        const timestamp = parseInt(scrollTimestamp) || 0;

        if (now - timestamp < 5000) {
          // Clear the flags
          localStorage.removeItem('chatScrollToBottom');
          localStorage.removeItem('chatScrollTimestamp');

          // Force scroll to bottom with multiple attempts
          forceScrollToBottom();
          setTimeout(forceScrollToBottom, 50);
          setTimeout(forceScrollToBottom, 200);
          setTimeout(forceScrollToBottom, 500);
        }
      }
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeChat);
    } else {
      initializeChat();
    }

    // Also initialize on window load as a fallback
    window.addEventListener('load', () => {
      setTimeout(forceScrollToBottom, 100);
    });

    // Handle page visibility change (when user returns to tab)
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && isUserAtBottom) {
        setTimeout(forceScrollToBottom, 100);
      }
    });

  })();
</script>
