<% const headerPartial = dashboardType === 'artist' ? '../partials/artist-header' : '../partials/producer-header'; %>
<% const footerPartial = dashboardType === 'artist' ? '../partials/artist-footer' : '../partials/producer-footer'; %>
<%- include(headerPartial) %>

<section>
  <div class="container-fluid">
    <div class="row">
      <div class="col-lg-4 mb-4 mb-lg-0">
        <div class="glass-card-dark h-100">
          <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 text-white">Messages</h5>
            <a href="/messages/find" class="btn btn-sm btn-primary">
              <i class="bi bi-search"></i> Find Users
            </a>
          </div>
          <div class="card-body p-0">
            <div class="list-group list-group-flush border-bottom scrollarea" style="max-height: 600px; overflow-y: auto;">
              <% if (conversations && conversations.length > 0) { %>
                <% conversations.forEach(conversation => { %>
                  <% const otherUser = userMap[conversation._id.toString()]; %>
                  <% if (otherUser) { %>
                    <a href="/messages/conversation/<%= otherUser._id %>" class="list-group-item list-group-item-action py-3 lh-tight border-secondary bg-dark text-white">
                      <div class="d-flex w-100 align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                          <img src="<%= otherUser.profileImage || '/images/default-profile.jpg' %>" class="rounded-circle me-2" width="40" height="40" alt="<%= otherUser.name %>">
                          <div>
                            <strong class="mb-1"><%= otherUser.name %></strong>
                            <% if (otherUser.role === 'artist' && artistMap[otherUser._id.toString()]) { %>
                              <span class="badge bg-primary ms-1"><%= artistMap[otherUser._id.toString()].artistLevel %></span>
                            <% } %>
                          </div>
                        </div>
                        <% if (conversation.unreadCount > 0) { %>
                          <span class="badge bg-danger rounded-pill"><%= conversation.unreadCount %></span>
                        <% } %>
                      </div>
                      <div class="col-10 mb-1 small text-white-75 text-truncate">
                        <% if (conversation.lastMessage.sender.toString() === user.id) { %>
                          <i class="bi bi-arrow-right-short me-1"></i>
                        <% } else { %>
                          <i class="bi bi-arrow-left-short me-1"></i>
                        <% } %>
                        <%= conversation.lastMessage.content %>
                      </div>
                      <small class="text-muted"><%= toISTLocaleString(conversation.lastMessage.createdAt) %></small>
                    </a>
                  <% } %>
                <% }); %>
              <% } else { %>
                <div class="text-center py-5">
                  <i class="bi bi-chat-left-text display-1 text-muted mb-3"></i>
                  <h3 class="text-white">No Messages Yet</h3>
                  <p class="text-white-75 mb-4">Start a conversation by finding users to message.</p>
                  <a href="/messages/find" class="btn btn-primary">Find Users</a>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="glass-card-dark h-100 d-flex flex-column">
          <div class="card-body d-flex flex-column justify-content-center align-items-center py-5">
            <i class="bi bi-chat-square-text display-1 text-muted mb-3"></i>
            <h3 class="text-white">Select a Conversation</h3>
            <p class="text-white-75 text-center mb-4">Choose a conversation from the list or start a new one by finding users.</p>
            <a href="/messages/find" class="btn btn-primary mt-3">
              <i class="bi bi-search me-2"></i> Find Users to Message
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include(footerPartial) %>
