<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Concert - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="admin-layout">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white p-0">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0 text-primary fw-bold">Artist Dashboard</h5>
        <button class="btn btn-sm btn-outline-light d-md-none" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <% if (artist.user.profileImage) { %>
              <img src="<%= artist.user.profileImage %>" alt="<%= artist.user.name %>" class="rounded-circle" width="48" height="48">
            <% } else { %>
              <i class="bi bi-person-circle fs-1"></i>
            <% } %>
          </div>
          <div>
            <h6 class="mb-0"><%= artist.user.name %></h6>
            <small class="text-muted">Artist</small>
          </div>
        </div>
        <ul class="nav flex-column">
          <li class="nav-item mb-2">
            <a href="/artists/dashboard" class="nav-link text-white p-2 rounded">
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/concerts/create" class="nav-link text-white p-2 rounded active bg-primary">
              <i class="bi bi-calendar-plus me-2"></i> Create Concert
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/upload-content" class="nav-link text-white p-2 rounded">
              <i class="bi bi-cloud-upload me-2"></i> Upload Content
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/edit-profile" class="nav-link text-white p-2 rounded">
              <i class="bi bi-pencil-square me-2"></i> Edit Profile
            </a>
          </li>
          <li class="nav-item mt-4">
            <a href="/artists/<%= artist._id %>" class="nav-link text-white p-2 rounded">
              <i class="bi bi-eye me-2"></i> View Public Profile
            </a>
          </li>
          <li class="nav-item">
            <a href="/" class="nav-link text-white p-2 rounded">
              <i class="bi bi-arrow-left me-2"></i> Back to Site
            </a>
          </li>
          <li class="nav-item">
            <a href="/auth/logout" class="nav-link text-white p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Create Concert</h1>
        <div>
          <a href="/artists/dashboard" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
          </a>
          <button class="btn btn-primary d-md-none" id="adminToggle">
            <i class="bi bi-list"></i>
          </button>
        </div>
      </div>

      <!-- Create Concert Form -->
      <div class="card">
        <div class="card-body p-4">
          <form action="/concerts/create" method="POST" enctype="multipart/form-data">
            <div class="row g-4">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="title" class="form-label">Concert Title</label>
                  <input type="text" class="form-control" id="title" name="title" placeholder="Enter concert title" required>
                </div>

                <div class="mb-3">
                  <label for="description" class="form-label">Description</label>
                  <textarea class="form-control" id="description" name="description" rows="4" placeholder="Enter concert description" required></textarea>
                </div>

                <div class="mb-3">
                  <label for="date" class="form-label">Date</label>
                  <input type="date" class="form-control" id="date" name="date" required>
                </div>

                <div class="mb-3">
                  <label for="time" class="form-label">Time</label>
                  <input type="time" class="form-control" id="time" name="time" required>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <label for="venue" class="form-label">Venue</label>
                  <input type="text" class="form-control" id="venue" name="venue" placeholder="Enter venue name" required>
                </div>

                <div class="mb-3">
                  <label for="city" class="form-label">City</label>
                  <input type="text" class="form-control" id="city" name="city" placeholder="Enter city" required>
                </div>

                <div class="mb-3">
                  <label for="posterImage" class="form-label">Concert Poster</label>
                  <input type="file" class="form-control" id="posterImage" name="posterImage">
                  <div class="form-text">Recommended size: 800x1200px (2:3 ratio). JPG, PNG, GIF (max 5MB)</div>
                </div>

                <div class="mb-3">
                  <div class="highlighted-toggle-section">
                    <div class="form-check form-switch">
                      <input class="form-check-input enhanced-toggle" type="checkbox" id="isPaid" name="isPaid" onclick="$('#priceContainer').toggle(this.checked); $('#price').prop('required', this.checked);">
                      <label class="form-check-label highlighted-label" for="isPaid">This is a paid concert</label>
                    </div>
                  </div>
                </div>

                <div class="mb-3" id="priceContainer" style="display: none;">
                  <label for="price" class="form-label">Ticket Price (₹) <span class="text-danger">*</span></label>
                  <input type="number" class="form-control" id="price" name="price" placeholder="Enter ticket price" min="0" step="0.01">
                </div>

                <div class="mb-3">
                  <label for="maxTickets" class="form-label">Maximum Tickets</label>
                  <input type="number" class="form-control" id="maxTickets" name="maxTickets" placeholder="Leave empty for unlimited tickets" min="0">
                  <div class="form-text">Leave empty or set to 0 for unlimited tickets</div>
                </div>
              </div>

              <div class="col-12">
                <div class="alert alert-info">
                  <i class="bi bi-info-circle-fill me-2"></i> Your concert will be submitted for admin approval. You'll receive an email notification once it's approved or rejected.
                </div>
              </div>

              <div class="col-12">
                <hr>
                <div class="d-flex justify-content-end gap-2">
                  <a href="/artists/dashboard" class="btn btn-outline-secondary">Cancel</a>
                  <button type="submit" class="btn btn-primary">
                    <i class="bi bi-calendar-plus me-1"></i> Create Concert
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Admin Toggle -->
  <button class="btn admin-toggle d-md-none" id="adminToggle">
    <i class="bi bi-list"></i>
  </button>

  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>

  <script>
    // Initialize price container visibility on page load
    $(document).ready(function() {
      // Check initial state and toggle price container
      $('#priceContainer').toggle($('#isPaid').is(':checked'));
      $('#price').prop('required', $('#isPaid').is(':checked'));

      console.log('Price container initialized, isPaid checked:', $('#isPaid').is(':checked'));
    });
  </script>

  <style>
    /* Highlighted Toggle Section */
    .highlighted-toggle-section {
      padding: 15px 20px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(13, 110, 253, 0.1), rgba(13, 110, 253, 0.05));
      border: 2px solid rgba(13, 110, 253, 0.3);
      backdrop-filter: blur(10px);
      box-shadow:
        0 4px 15px rgba(13, 110, 253, 0.2),
        0 2px 8px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
    }

    .highlighted-toggle-section:hover {
      border-color: rgba(13, 110, 253, 0.5);
      box-shadow:
        0 6px 20px rgba(13, 110, 253, 0.3),
        0 2px 10px rgba(0, 0, 0, 0.15);
      transform: translateY(-2px);
    }

    /* Enhanced Toggle Switch */
    .enhanced-toggle {
      width: 3rem !important;
      height: 1.5rem !important;
      background-color: #6c757d !important;
      border: 2px solid #495057 !important;
      border-radius: 1rem !important;
      transition: all 0.3s ease !important;
      cursor: pointer;
    }

    .enhanced-toggle:checked {
      background-color: #0d6efd !important;
      border-color: #0d6efd !important;
      box-shadow: 0 0 15px rgba(13, 110, 253, 0.4) !important;
    }

    .enhanced-toggle:focus {
      border-color: #86b7fe !important;
      box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }

    .enhanced-toggle:hover {
      border-color: #86b7fe !important;
      transform: scale(1.05);
    }

    /* Highlighted Label */
    .highlighted-label {
      color: #ffffff !important;
      font-weight: 600 !important;
      font-size: 1.1rem !important;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
      margin-left: 0.75rem !important;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .enhanced-toggle:checked + .highlighted-label {
      color: #86b7fe !important;
      text-shadow: 0 0 10px rgba(134, 183, 254, 0.5);
    }

    .highlighted-toggle-section:hover .highlighted-label {
      transform: translateX(3px);
    }

    /* Disabled state */
    .enhanced-toggle:disabled {
      background-color: #343a40 !important;
      border-color: #495057 !important;
      opacity: 0.6;
      cursor: not-allowed;
    }

    .enhanced-toggle:disabled + .highlighted-label {
      color: #6c757d !important;
      text-shadow: none;
    }
  </style>
</body>
</html>
