<!-- Booking Page -->
<section class="py-4">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <!-- Booking Form -->
        <div class="glass-card-dark mb-4">
          <div class="card-header py-3">
            <h3 class="card-title fw-bold mb-0">Book Tickets</h3>
          </div>
          <div class="card-body p-4">
            <div class="mb-4">
              <div class="d-flex align-items-center mb-2">
                <h5 class="fw-bold mb-0"><%= concert.title %></h5>
                <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %> ms-2">
                  <%= concert.isPaid ? `₹${concert.price}` : 'Free' %>
                </span>
              </div>
              <p class="text-white mb-0">
                <% 
                  // Convert time to 12-hour format with AM/PM
                  let timeMatch = concert.time.match(/^(\d{1,2}):(\d{2})$/);
                  let displayTime = concert.time;
                  if (timeMatch) {
                    let hours = parseInt(timeMatch[1]);
                    let minutes = timeMatch[2];
                    let amPm = hours >= 12 ? 'PM' : 'AM';
                    let hour12 = hours % 12;
                    if (hour12 === 0) hour12 = 12;
                    displayTime = `${hour12}:${minutes} ${amPm}`;
                  }
                %>
                <i class="bi bi-calendar3 me-1 text-primary"></i> <%= toISTDateString(concert.date) %> • <%= displayTime %>
              </p>
              <p class="text-white mb-0">
                <i class="bi bi-geo-alt me-1 text-primary"></i> <%= concert.venue && concert.venue.name ? concert.venue.name : concert.venue %>, <%= concert.city %>
              </p>
            </div>

            <hr class="my-4">

            <% if (concert.isPaid) { %>
              <!-- Paid Concert Booking Form -->
              <form id="razorpayForm" method="POST">
                <input type="hidden" name="concertId" value="<%= concert._id %>">
                <input type="hidden" id="userName" value="<%= currentUser.name %>">
                <input type="hidden" id="userEmail" value="<%= currentUser.email %>">
                <!-- This div will hold the attendee data inputs -->
                <div id="attendeeDataInputs"></div>

                <div class="mb-4">
                  <label for="ticketQuantity" class="form-label fw-medium text-white">Number of Tickets</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-ticket-perforated"></i></span>
                    <select class="form-select" id="ticketQuantity" name="quantity" required>
                      <% for (let i = 1; i <= maxTicketsPerBooking; i++) { %>
                        <option value="<%= i %>"><%= i %></option>
                      <% } %>
                    </select>
                  </div>
                  <div class="form-text text-primary mt-2">
                    <i class="bi bi-info-circle me-1"></i>
                    <% if (ticketsRemaining === 'Unlimited') { %>
                      Unlimited tickets available
                    <% } else { %>
                      <%= ticketsRemaining %> tickets remaining
                    <% } %>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-medium text-white">Attendee Details</label>
                  <div id="attendeesContainer">
                    <!-- Attendee forms will be dynamically added here -->
                  </div>
                </div>

                <div class="glass-card-dark mb-4 border-gradient">
                  <div class="border-gradient-content">
                    <div class="card-body">
                      <h5 class="card-title fw-bold mb-3 text-white" style="color: white !important;">Price Summary</h5>
                      <div class="d-flex justify-content-between mb-2">
                        <span class="text-white">Ticket Price:</span>
                        <span class="text-white">₹<span id="ticketPrice" data-price="<%= discountedPrice %>"><%= discountedPrice %></span> × <span id="ticketCount" class="text-primary fw-bold">1</span></span>
                      </div>

                      <% if (typeof subscriptionDiscount !== 'undefined' && subscriptionDiscount > 0) { %>
                      <div class="d-flex justify-content-between mb-2 text-success">
                        <span><i class="bi bi-star-fill me-1"></i> Subscription Discount:</span>
                        <span><%= subscriptionDiscount %>% off</span>
                      </div>
                      <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Original Price:</span>
                        <span><s>₹<%= originalPrice %></s></span>
                      </div>
                      <% } %>

                      <!-- Commission display - shown differently based on commission settings -->
                      <% if (typeof ticketCommissionEnabled !== 'undefined' && ticketCommissionEnabled) { %>
                      <div class="d-flex justify-content-between mb-2 text-warning">
                        <span><i class="bi bi-currency-rupee me-1"></i> Platform Commission:</span>
                        <span><%= ticketCommissionPercentage %>%</span>
                      </div>
                      <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Platform Charges:</span>
                        <span>Excluded from ticket pricing</span>
                      </div>
                      <% } %>

                      <hr class="border-secondary">
                      <div class="d-flex justify-content-between fw-bold">
                        <span class="text-white">Total Amount:</span>
                        <span class="gradient-text-purple fs-5">₹<span id="totalAmount"><%= discountedPrice %></span></span>
                      </div>
                      <input type="hidden" id="totalAmountInput" name="totalAmount" value="<%= discountedPrice %>">
                    </div>
                  </div>
                </div>

                <button type="submit" class="btn btn-gradient-purple btn-lg w-100 animate-pulse"><i class="bi bi-credit-card me-2"></i>Proceed to Payment</button>
              </form>
            <% } else { %>
              <!-- Free Concert Booking Form -->
              <form action="/tickets/book-free" method="POST">
                <input type="hidden" name="concertId" value="<%= concert._id %>">
                <!-- This div will hold the attendee data inputs -->
                <div id="attendeeDataInputs"></div>

                <div class="mb-4">
                  <label for="ticketQuantity" class="form-label fw-medium text-white">Number of Tickets</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-ticket-perforated"></i></span>
                    <select class="form-select" id="ticketQuantity" name="quantity" required>
                      <% for (let i = 1; i <= maxTicketsPerBooking; i++) { %>
                        <option value="<%= i %>"><%= i %></option>
                      <% } %>
                    </select>
                  </div>
                  <div class="form-text text-primary mt-2">
                    <i class="bi bi-info-circle me-1"></i>
                    <% if (ticketsRemaining === 'Unlimited') { %>
                      Unlimited tickets available
                    <% } else { %>
                      <%= ticketsRemaining %> tickets remaining
                    <% } %>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-medium text-white">Attendee Details</label>
                  <div id="attendeesContainer">
                    <!-- Attendee forms will be dynamically added here -->
                  </div>
                </div>

                <button type="submit" class="btn btn-gradient-purple btn-lg w-100 animate-pulse"><i class="bi bi-ticket-perforated me-2"></i>Book Free Tickets</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <!-- Concert Summary -->
        <div class="glass-card-dark mb-4 sticky-top" style="top: 20px; z-index: 100;">
          <img src="<%= concert.posterImage %>" class="card-img-top" alt="<%= concert.title %>" style="max-height: 200px; object-fit: cover;">
          <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3" style="color: white !important;">Concert Details</h5>

            <div class="d-flex align-items-center mb-3">
              <div class="concert-date me-3">
                <div class="month"><%= toISTDateString(concert.date) %></div>
                <div class="day"><%= new Date(concert.date).getDate() %></div>
              </div>
              <div>
                <h6 class="mb-0 text-white"><%= concert.title %></h6>
                <p class="text-white-50 mb-0"><%= displayTime %></p>
                <% 
                  let bookingHours = concert.bookingHours || 2;
                  // Calculate end time using the same logic
                  let endDisplayTime = concert.time;
                  if (timeMatch) {
                    let startHours = parseInt(timeMatch[1]);
                    let minutes = timeMatch[2];
                    let endHours = startHours + bookingHours;
                    let endAmPm = endHours >= 12 ? 'PM' : 'AM';
                    let endHour12 = endHours % 12;
                    if (endHour12 === 0) endHour12 = 12;
                    
                    if (endHours >= 24) {
                      endHours = endHours - 24;
                      endAmPm = endHours >= 12 ? 'PM' : 'AM';
                      endHour12 = endHours % 12;
                      if (endHour12 === 0) endHour12 = 12;
                      endDisplayTime = `${endHour12}:${minutes} ${endAmPm} (+1 day)`;
                    } else {
                      endDisplayTime = `${endHour12}:${minutes} ${endAmPm}`;
                    }
                  }
                %>
                <small class="text-white-50">Duration: <%= bookingHours %> hours</small><br>
                <small class="text-success">Start: <%= displayTime %></small><br>
                <small class="text-danger">End: <%= endDisplayTime %></small>
              </div>
            </div>

            <div class="mb-3">
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-geo-alt text-primary me-2"></i>
                <span class="text-white"><%= concert.venue && concert.venue.name ? concert.venue.name : concert.venue %>, <%= concert.city %></span>
              </div>
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-person text-primary me-2"></i>
                <span class="text-white">By <%= concert.artist && concert.artist.user ? concert.artist.user.name : 'Artist' %></span>
              </div>
              <div class="d-flex align-items-center">
                <i class="bi bi-ticket-perforated text-primary me-2"></i>
                <span class="text-white">
                  <% if (ticketsRemaining === 'Unlimited') { %>
                    Unlimited tickets available
                  <% } else { %>
                    <%= ticketsRemaining %> tickets remaining
                  <% } %>
                </span>
              </div>
            </div>

            <div class="glass-card-dark p-3 mb-0 border-start border-4 border-info">
              <i class="bi bi-info-circle-fill me-2 text-info"></i>
              <span class="text-white">
                <% if (concert.isPaid) { %>
                  Payment will be processed securely via Razorpay.
                <% } else { %>
                  This is a free concert. No payment required.
                <% } %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Razorpay Script -->
<% if (concert.isPaid) { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>










  document.addEventListener('DOMContentLoaded', function() {
    const ticketQuantitySelect = document.getElementById('ticketQuantity');
    const ticketPriceElement = document.getElementById('ticketPrice');
    const ticketCountElement = document.getElementById('ticketCount');
    const totalAmountElement = document.getElementById('totalAmount');
    const totalAmountInput = document.getElementById('totalAmountInput');
    const razorpayForm = document.getElementById('razorpayForm');

    // Get the ticket price from the data attribute
    const ticketPrice = parseFloat(ticketPriceElement.getAttribute('data-price'));

    // Update the total amount when the ticket quantity changes
    ticketQuantitySelect.addEventListener('change', function() {
      const quantity = parseInt(this.value);
      
      // Calculate base total (ticket price * quantity)
      const baseTotal = ticketPrice * quantity;
      
      // Calculate commission if enabled
      let commissionAmount = 0;
      let totalWithCommission = baseTotal;
      
      <% if (typeof ticketCommissionEnabled !== 'undefined' && ticketCommissionEnabled) { %>
        const commissionPercentage = <%= ticketCommissionPercentage %>;
        commissionAmount = (baseTotal * commissionPercentage) / 100;
        totalWithCommission = baseTotal + commissionAmount;
      <% } %>
      
      // Update the ticket count
      ticketCountElement.textContent = quantity;
      
      // Update commission display if commission is enabled
      <% if (typeof ticketCommissionEnabled !== 'undefined' && ticketCommissionEnabled) { %>
        document.getElementById('commissionAmount').textContent = '₹' + commissionAmount.toFixed(2);
      <% } %>

      // Update the total amount
      totalAmountElement.textContent = totalWithCommission;
      totalAmountInput.value = totalWithCommission;

      // Update attendee forms
      updateAttendeeForms(quantity);
    });

    // Initialize attendee forms
    updateAttendeeForms(1);

    // Function to update attendee forms
    function updateAttendeeForms(count) {
      const container = document.getElementById('attendeesContainer');
      const dataInputs = document.getElementById('attendeeDataInputs');

      // Clear existing forms
      container.innerHTML = '';
      dataInputs.innerHTML = '';

      // Add forms for each attendee
      for (let i = 1; i <= count; i++) {
        const attendeeForm = document.createElement('div');
        attendeeForm.className = 'glass-card-dark p-3 mb-3';
        attendeeForm.innerHTML = `
          <h6 class="mb-3 text-white">Attendee #${i}</h6>
          <div class="mb-3">
            <label for="attendeeName${i}" class="form-label">Name</label>
            <input type="text" class="form-control" id="attendeeName${i}" name="attendeeName${i}" required>
          </div>
          <div class="mb-0">
            <label for="attendeeEmail${i}" class="form-label">Email</label>
            <input type="email" class="form-control" id="attendeeEmail${i}" name="attendeeEmail${i}" required>
          </div>
        `;

        container.appendChild(attendeeForm);

        // Add hidden inputs for form submission
        const nameInput = document.createElement('input');
        nameInput.type = 'hidden';
        nameInput.name = `attendeeName${i}`;
        nameInput.id = `attendeeNameHidden${i}`;

        const emailInput = document.createElement('input');
        emailInput.type = 'hidden';
        emailInput.name = `attendeeEmail${i}`;
        emailInput.id = `attendeeEmailHidden${i}`;

        dataInputs.appendChild(nameInput);
        dataInputs.appendChild(emailInput);
      }
    }

    // Handle form submission for paid concerts
    if (razorpayForm) {
      razorpayForm.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Validate the form
        if (!this.checkValidity()) {
          this.reportValidity();
          return;
        }

        // Get form data
        const concertId = this.querySelector('input[name="concertId"]').value;
        const quantity = parseInt(ticketQuantitySelect.value);
        const totalAmount = parseFloat(totalAmountInput.value);

        // Collect attendee data
        const attendeeData = [];
        for (let i = 1; i <= quantity; i++) {
          const name = document.getElementById(`attendeeName${i}`).value;
          const email = document.getElementById(`attendeeEmail${i}`).value;

          // Update hidden inputs
          document.getElementById(`attendeeNameHidden${i}`).value = name;
          document.getElementById(`attendeeEmailHidden${i}`).value = email;

          attendeeData.push({ name, email });
        }

        try {
          // Create order
          const response = await fetch('/tickets/create-order', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              concertId,
              quantity,
              totalAmount,
              attendeeData
            })
          });

          const data = await response.json();

          if (!data.success) {
            throw new Error(data.message || 'Failed to create order');
          }

          // Initialize Razorpay
          const options = {
            key: data.key,
            amount: data.order.amount,
            currency: data.order.currency,
            name: 'Rapira',
            description: 'Concert Ticket Purchase',
            order_id: data.order.id,
            handler: function(response) {
              console.log('Ticket payment successful:', response);
              
              // Create hidden form for payment verification
              const form = document.createElement('form');
              form.method = 'POST';
              form.action = '/tickets/verify-payment';

              const fields = {
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_signature: response.razorpay_signature,
                ticket_id: data.ticket
              };

              for (const key in fields) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = fields[key];
                form.appendChild(input);
              }

              // Submit form after payment verification
              document.body.appendChild(form);
              form.submit();
            },
            prefill: {
              name: document.getElementById('userName').value,
              email: document.getElementById('userEmail').value
            },
            theme: {
              color: '#6366f1'
            }
          };

          const rzp = new Razorpay(options);
          rzp.open();

        } catch (error) {
          console.error('Payment error:', error);
          alert('Payment failed: ' + error.message);
        }
      });
    }


  });
</script>

<style>



</style>
<% } %>

