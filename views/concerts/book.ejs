<%
  // Helper for date formatting
  const dateObj = new Date(concert.date);
  const monthNames = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
  const monthStr = monthNames[dateObj.getMonth()];
  const dayStr = dateObj.getDate();

  const dateFormatted = dateObj.toLocaleDateString('en-IN', {
    weekday: 'short',
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'Asia/Kolkata'
  });

  let displayTime = concert.time || '';
  const timeMatch = displayTime.match(/^(\d+):(\d+)/);
  if (timeMatch) {
    let hours = parseInt(timeMatch[1]);
    let minutes = timeMatch[2];
    let amPm = hours >= 12 ? 'PM' : 'AM';
    let hour12 = hours % 12;
    if (hour12 === 0) hour12 = 12;
    displayTime = `${hour12}:${minutes} ${amPm}`;
  }

  const venueName = concert.venue && concert.venue.name ? concert.venue.name : (concert.venue || 'RAPIRA Arena');
  const artistName = concert.artist && concert.artist.user ? concert.artist.user.name : (concert.artist ? concert.artist.name : 'Riona');
  const city = concert.city || (concert.venue && concert.venue.city ? concert.venue.city : 'Ahmedabad');

  const unitPrice = typeof discountedPrice !== 'undefined' ? discountedPrice : (concert.price || 0);
  const baseTotal = parseFloat((unitPrice * selectedQuantity).toFixed(2));
  let initialCommissionAmount = 0;
  let initialTotalWithCommission = baseTotal;

  if (typeof ticketCommissionEnabled !== 'undefined' && ticketCommissionEnabled) {
    initialCommissionAmount = parseFloat(((baseTotal * ticketCommissionPercentage) / 100).toFixed(2));
    initialTotalWithCommission = parseFloat((baseTotal + initialCommissionAmount).toFixed(2));
  }
%>

<div 
  class="rapira-checkout-page"
  data-concert-id="<%= concert._id %>"
  data-is-paid="<%= concert.isPaid ? 'true' : 'false' %>"
  data-unit-price="<%= unitPrice %>"
  data-commission-enabled="<%= (typeof ticketCommissionEnabled !== 'undefined' && ticketCommissionEnabled) ? 'true' : 'false' %>"
  data-commission-pct="<%= (typeof ticketCommissionPercentage !== 'undefined') ? ticketCommissionPercentage : 0 %>"
  data-selected-qty="<%= selectedQuantity %>"
  data-max-tickets="<%= maxTicketsPerBooking %>"
  data-user-name="<%= currentUser ? currentUser.name : '' %>"
  data-user-email="<%= currentUser ? currentUser.email : '' %>"
>
  <div class="container-xl">
    <!-- Header with Back Button -->
    <header class="rapira-checkout-header d-flex align-items-center gap-3">
      <a href="/concerts/<%= concert._id %>/select-quantity?step=seats&quantity=<%= selectedQuantity %>" class="rapira-checkout-back-btn" title="Back to seat selection">
        <i class="bi bi-arrow-left"></i>
      </a>
      <div>
        <h1 class="rapira-checkout-title">Complete Your Booking</h1>
        <p class="rapira-checkout-subtitle">Review your details and proceed to payment</p>
      </div>
    </header>

    <!-- Mobile-Only Compact Concert Details (Shown at top on mobile) -->
    <div class="d-lg-none mb-3">
      <div class="rapira-checkout-card p-3 mb-0">
        <div class="rapira-mobile-concert-card">
          <div class="rapira-mobile-thumb-wrap">
            <img src="<%= concert.posterImage || '/images/festival-hero.jpg' %>" alt="<%= concert.title %>" class="rapira-mobile-thumb-img">
            <div class="rapira-mobile-thumb-date-badge"><%= monthStr %> <%= dayStr %></div>
          </div>
          <div class="rapira-concert-info-wrap">
            <h3 class="rapira-concert-title-right mb-1"><%= concert.title %></h3>
            <div class="rapira-concert-detail-line">
              <i class="bi bi-calendar3"></i>
              <span><%= dateFormatted %> • <%= displayTime %></span>
            </div>
            <div class="rapira-concert-detail-line">
              <i class="bi bi-geo-alt-fill"></i>
              <span><%= venueName %>, <%= city %></span>
            </div>
            <div class="rapira-concert-detail-line">
              <i class="bi bi-person-fill"></i>
              <span>By <%= artistName %></span>
            </div>
            <% if (typeof selectedSeats !== 'undefined' && selectedSeats) { 
              const mobileSeatList = selectedSeats.split(',').filter(Boolean);
            %>
              <div class="d-flex flex-wrap gap-1 mt-2">
                <% mobileSeatList.forEach(s => { %>
                  <span class="badge px-2 py-1" style="background-color: #FAF0E6; color: #9F190E; border: 1px solid #EAC8B7; font-size: 0.72rem;"><%= s %></span>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Checkout Grid -->
    <div class="row g-4">
      <!-- Left Column: Attendee Forms, Instructions & Payment Action -->
      <div class="col-lg-7">
        <% if (concert.isPaid) { %>
          <form id="razorpayForm" method="POST" novalidate>
        <% } else { %>
          <form id="freeConcertForm" action="/tickets/book-free" method="POST" novalidate>
        <% } %>

          <input type="hidden" name="concertId" value="<%= concert._id %>">
          <input type="hidden" id="userName" value="<%= currentUser ? currentUser.name : '' %>">
          <input type="hidden" id="userEmail" value="<%= currentUser ? currentUser.email : '' %>">
          <input type="hidden" id="ticketQuantity" name="quantity" value="<%= selectedQuantity %>">
          <input type="hidden" id="totalAmountInput" name="totalAmount" value="<%= Number(initialTotalWithCommission).toFixed(2) %>">
          
          <!-- Hidden attendee data container for form submit fallback -->
          <div id="attendeeDataInputs"></div>

          <!-- Card 1: Attendee Details -->
          <section class="rapira-checkout-card" aria-label="Attendee Details">
            <div class="rapira-checkout-card-header">
              <div class="rapira-checkout-icon-badge">
                <i class="bi bi-person"></i>
              </div>
              <div>
                <h2 class="rapira-checkout-card-title">Attendee Details</h2>
                <p class="rapira-checkout-card-subtitle">Enter details for each ticket holder.</p>
              </div>
            </div>

            <!-- Dynamic Attendee Forms Generated by JS -->
            <div id="rapiraAttendeesContainer">
              <!-- Attendee #1, #2, etc. dynamically rendered -->
            </div>
          </section>

          <!-- Card 2: Important Payment Instructions -->
          <section class="rapira-checkout-card" aria-label="Payment Instructions">
            <div class="rapira-checkout-card-header">
              <div class="rapira-checkout-icon-badge">
                <i class="bi bi-exclamation-triangle"></i>
              </div>
              <div>
                <h2 class="rapira-checkout-card-title">Important Payment Instructions</h2>
                <p class="rapira-checkout-card-subtitle">Please read before initiating your transaction.</p>
              </div>
            </div>

            <div class="rapira-instructions-list">
              <div class="rapira-instruction-item warn">
                <i class="bi bi-exclamation-triangle-fill rapira-instruction-icon"></i>
                <span><strong>Do not refresh</strong> this page during payment.</span>
              </div>
              <div class="rapira-instruction-item warn">
                <i class="bi bi-exclamation-triangle-fill rapira-instruction-icon"></i>
                <span><strong>Do not close</strong> this tab until payment completes.</span>
              </div>
              <div class="rapira-instruction-item info">
                <i class="bi bi-info-circle-fill rapira-instruction-icon"></i>
                <span>You will be automatically redirected after successful payment.</span>
              </div>
            </div>
          </section>

          <!-- Mobile-Only Price Summary Position (Placed below Payment Instructions on mobile) -->
          <div class="d-lg-none mb-3">
            <section class="rapira-checkout-card" aria-label="Mobile Price Summary">
              <h2 class="rapira-checkout-card-title mb-3">Price Summary</h2>
              <div class="rapira-price-line">
                <span class="label">Ticket Price:</span>
                <span class="val">₹<%= Number(unitPrice).toFixed(2) %></span>
              </div>
              <div class="rapira-price-line">
                <span class="label">Quantity:</span>
                <span class="val"><span id="mobileSummaryQuantity"><%= selectedQuantity %></span></span>
              </div>
              <% if (typeof ticketCommissionEnabled !== 'undefined' && ticketCommissionEnabled) { %>
                <div class="rapira-price-line">
                  <span class="label">Platform Charges (<%= ticketCommissionPercentage %>%):</span>
                  <span class="val">₹<span id="mobileSummaryCharges"><%= initialCommissionAmount.toFixed(2) %></span></span>
                </div>
              <% } %>

              <div class="rapira-price-total-box">
                <span class="rapira-price-total-label">Total Amount:</span>
                <span class="rapira-price-total-amount" id="mobileSummaryTotal">₹<%= Number(initialTotalWithCommission).toFixed(2) %></span>
              </div>
            </section>
          </div>

          <!-- Card 3: Payment Agreement Checkbox -->
          <div class="rapira-agreement-card">
            <input 
              type="checkbox" 
              class="rapira-agreement-checkbox" 
              id="paymentAgreement" 
              name="paymentAgreement" 
              required
            >
            <label class="rapira-agreement-label" for="paymentAgreement">
              I understand the payment instructions and will not close, refresh, or navigate away from this page until the payment is complete.
            </label>
          </div>
          <div class="rapira-agreement-error" id="checkboxError">
            <i class="bi bi-exclamation-circle-fill me-1"></i> You must confirm the payment instructions to proceed
          </div>

          <!-- Card 4: Action Button & Policy Link -->
          <div class="mt-3">
            <button type="submit" class="rapira-payment-btn" id="proceedPaymentBtn">
              <i class="bi bi-credit-card me-2"></i>
              <span><%= concert.isPaid ? 'Proceed to Payment' : 'Confirm Free Booking' %></span>
              <i class="bi bi-arrow-right ms-1"></i>
            </button>

            <div class="rapira-refund-notice">
              By proceeding, you agree to our 
              <a href="/refund-policy" target="_blank" class="rapira-refund-link">Refund Policy</a>
            </div>
          </div>

        </form>
      </div>

      <!-- Right Column: Desktop Concert Details & Price Summary -->
      <div class="col-lg-5 d-none d-lg-block">
        <div class="sticky-top" style="top: 24px; z-index: 10;">
          <!-- Desktop Concert Details Card -->
          <section class="rapira-checkout-card" aria-label="Desktop Concert Summary">
            <!-- Concert Banner Image -->
            <img 
              src="<%= concert.posterImage || '/images/festival-hero.jpg' %>" 
              alt="<%= concert.title %>" 
              class="rapira-concert-banner-img"
            >

            <h2 class="rapira-checkout-card-title mb-3">Concert Details</h2>

            <!-- Meta Row: Date Badge + Information -->
            <div class="rapira-concert-meta-row">
              <div class="rapira-date-badge" aria-label="Concert Date">
                <span class="rapira-date-badge-month"><%= monthStr %></span>
                <span class="rapira-date-badge-day"><%= dayStr %></span>
              </div>
              <div class="rapira-concert-info-wrap">
                <h3 class="rapira-concert-title-right"><%= concert.title %></h3>
                <div class="rapira-concert-detail-line">
                  <i class="bi bi-calendar3"></i>
                  <span><%= dateFormatted %> • <%= displayTime %></span>
                </div>
                <div class="rapira-concert-detail-line">
                  <i class="bi bi-geo-alt-fill"></i>
                  <span><%= venueName %>, <%= city %></span>
                </div>
                <div class="rapira-concert-detail-line">
                  <i class="bi bi-person-fill"></i>
                  <span>By <%= artistName %></span>
                </div>
              </div>
            </div>

            <!-- Optional Selected Seats Pill -->
            <% if (typeof selectedSeats !== 'undefined' && selectedSeats) { 
              const seatList = selectedSeats.split(',').filter(Boolean);
            %>
              <div class="mt-3 pt-3 border-top" style="border-color: #F0D9CC !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="small fw-semibold text-muted">Selected Seats:</span>
                  <% if (typeof selectedVehicle !== 'undefined' && selectedVehicle) { %>
                    <span class="badge rounded-pill px-2 py-1 text-capitalize" style="background-color: #FAF0E6; color: #9F190E; border: 1px solid #EAC8B7;">
                      <%= selectedVehicle %>
                    </span>
                  <% } %>
                </div>
                <div class="d-flex flex-wrap gap-1">
                  <% seatList.forEach(s => { %>
                    <span class="badge px-2 py-1" style="background-color: #FAF0E6; color: #9F190E; border: 1px solid #EAC8B7;"><%= s %></span>
                  <% }); %>
                </div>
              </div>
            <% } %>
            <div class="rapira-selected-seats-strip" id="selectedSeatsDisplay" style="display: none;"></div>
          </section>

          <!-- Desktop Price Summary Card -->
          <section class="rapira-checkout-card" aria-label="Desktop Price Summary">
            <h2 class="rapira-checkout-card-title mb-3">Price Summary</h2>
            
            <div class="rapira-price-line">
              <span class="label">Ticket Price:</span>
              <span class="val">₹<%= Number(unitPrice).toFixed(2) %></span>
            </div>

            <div class="rapira-price-line">
              <span class="label">Quantity:</span>
              <span class="val"><span id="summaryQuantity"><%= selectedQuantity %></span></span>
            </div>

            <% if (typeof subscriptionDiscount !== 'undefined' && subscriptionDiscount > 0) { %>
              <div class="rapira-price-line text-success">
                <span class="label"><i class="bi bi-star-fill me-1"></i> Subscription Discount:</span>
                <span class="val"><%= subscriptionDiscount %>% off</span>
              </div>
            <% } %>

            <% if (typeof ticketCommissionEnabled !== 'undefined' && ticketCommissionEnabled) { %>
              <div class="rapira-price-line">
                <span class="label">
                  Platform Charges (<%= ticketCommissionPercentage %>%):
                  <i class="bi bi-info-circle ms-1 small text-muted" title="Platform maintenance & payment processing charges"></i>
                </span>
                <span class="val">₹<span id="summaryCharges"><%= initialCommissionAmount.toFixed(2) %></span></span>
              </div>
            <% } %>

            <!-- Total Amount Highlight Box -->
            <div class="rapira-price-total-box">
              <span class="rapira-price-total-label">Total Amount:</span>
              <span class="rapira-price-total-amount" id="summaryTotal">₹<%= Number(initialTotalWithCommission).toFixed(2) %></span>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================================
     CLIENT-SIDE INTERACTIVE CHECKOUT LOADER
     ======================================================== -->
<img 
  src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" 
  onload="if(!window.__rapiraCheckoutLoaded){window.__rapiraCheckoutLoaded=true;const s=document.createElement('script');s.src='/js/checkout-payment.js?v=20261106a';document.body.appendChild(s);}" 
  style="display:none;" 
  alt=""
>
