    // Verify payment and create concert
    async function verifyPaymentAndCreateConcert(razorpayResponse) {
      try {
        // Show payment processing animation
        payAndSubmitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1 animate-spin"></i> Verifying Payment...';
        
        // Skip payment success animation overlay for immediate redirect

        // Prepare verification data
        const formData = new FormData(concertForm);
        formData.append('razorpay_order_id', razorpayResponse.razorpay_order_id);
        formData.append('razorpay_payment_id', razorpayResponse.razorpay_payment_id);
        formData.append('razorpay_signature', razorpayResponse.razorpay_signature);

        // Verify payment and create concert
        const response = await fetch('/concerts/verify-payment', {
          method: 'POST',
          body: formData
        });

        // Parse response
        const responseText = await response.text();
        
        // Check if response is JSON
        let responseData;
        try {
          responseData = JSON.parse(responseText);
        } catch (e) {
          // Not JSON, might be a redirect or plain text
          responseData = { success: response.ok };
        }
        
        // Check if payment was successful
        if (response.ok && responseData.success) {
          // Skip animation and redirect immediately
          // Use redirect URL from response if available, otherwise default
          const redirectUrl = responseData.redirectUrl || '/artists/manage-concerts';
          window.location.href = redirectUrl;
        } else {
          // We've already parsed the response above, use that data
          console.error('Payment verification failed:', responseText);
          
          let errorMessage = 'Payment verification failed';
          if (responseData.error) {
            errorMessage = responseData.error;
              
              // Special handling for venue conflicts during verification
              if (responseData.error === 'Venue booking conflict detected' && responseData.conflicts) {
                const conflictDetails = responseData.conflicts.map(c => 
                  `• ${c.title} at ${c.time} for ${c.duration} hours (${c.status})`
                ).join('\n');
                
                hidePaymentOverlay();
                // Skip alert for immediate redirect
                // Redirect to manage concerts page even on conflict to avoid getting stuck
                window.location.href = '/artists/manage-concerts';
                
                // Re-check availability to show current status
                if (venueSelect.value && dateInput.value && timeInput.value && bookingHours.value) {
                  setTimeout(checkVenueAvailability, 500);
                }
                
                payAndSubmitBtn.disabled = false;
                payAndSubmitBtn.innerHTML = '<i class="bi bi-credit-card me-1"></i> Pay ₹<span id="payButtonAmount">' + payButtonAmount.textContent + '</span> & Submit Concert';
                return;
              }
            }
          
          throw new Error(errorMessage);
        }

      } catch (error) {
        console.error('Error verifying payment:', error);
        hidePaymentOverlay();
        // Skip error animation and alerts for immediate redirect
        // Redirect to manage concerts page even on error to avoid getting stuck
        window.location.href = '/artists/manage-concerts';
      }
    }

