    function resetAvailabilityResults() {
      availabilityResults.innerHTML = `
        <div class="text-center text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Select venue, date, time, and duration to check availability
        </div>
      `;
      availabilityCard.className = 'card';
      availabilityHeader.className = 'card-header';
    }

    // Auto-check availability when values change
    let availabilityCheckTimeout;
    function autoCheckAvailability() {
      // Clear existing timeout to avoid rapid API calls
      if (availabilityCheckTimeout) {
        clearTimeout(availabilityCheckTimeout);
      }
      
      // Add visual feedback - highlight the availability section
      const availabilitySection = document.getElementById('availabilityResults');
      const formControls = [venueSelect, dateInput, timeInput, bookingHours];
      
      // Add checking class to form controls that have values
      formControls.forEach(control => {
        if (control.value) {
          control.classList.add('checking');
        }
      });
      
      // Show checking indicator immediately if we have some required fields
      if (venueSelect.value && (dateInput.value || timeInput.value || bookingHours.value)) {
        availabilityResults.classList.add('availability-checking');
        availabilityResults.innerHTML = `
          <div class="text-center text-info">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
            <span>Checking availability...</span>
          </div>
        `;
      }
      
      // Debounce the actual check
      availabilityCheckTimeout = setTimeout(() => {
        // Remove checking visual feedback
        formControls.forEach(control => {
          control.classList.remove('checking');
        });
        
        if (venueSelect.value && dateInput.value && timeInput.value && bookingHours.value) {
          checkVenueAvailability();
        } else if (venueSelect.value) {
          // Show partial message when some fields are missing
          availabilityResults.classList.remove('availability-checking');
          availabilityResults.innerHTML = `
            <div class="alert alert-info mb-0">
              <i class="bi bi-info-circle me-2" style="color: #000000 !important;"></i>
              <span style="color: #000000 !important;">Please complete all fields (date, time, duration) to check availability.</span>
            </div>
          `;
        } else {
          availabilityResults.classList.remove('availability-checking');
          availabilityResults.innerHTML = '';
        }
      }, 800); // Reduced debounce time for faster response
    }

    // Event listeners for auto-checking (enhanced)
    dateInput.addEventListener('change', autoCheckAvailability);
    dateInput.addEventListener('input', autoCheckAvailability);
    dateInput.addEventListener('blur', autoCheckAvailability); // When user clicks away
    
    timeInput.addEventListener('change', autoCheckAvailability);
    timeInput.addEventListener('input', autoCheckAvailability);
    timeInput.addEventListener('blur', autoCheckAvailability);
    
    bookingHours.addEventListener('change', autoCheckAvailability);
    bookingHours.addEventListener('input', autoCheckAvailability);
    
