      if (!feedback) {
        feedback = document.createElement('div');
        feedback.id = 'selectionFeedback';
        feedback.className = 'alert alert-success alert-dismissible fade show mt-2';
        feedback.style.position = 'relative';
        availabilityResults.parentNode.insertBefore(feedback, availabilityResults.nextSibling);
      }
      
      feedback.innerHTML = `
        <i class="bi bi-check-circle me-2"></i>
        <strong>Updated!</strong> ${message}
        <button type="button" class="btn-close" onclick="this.parentElement.remove()"></button>
      `;
      
      // Auto-hide after 3 seconds
      setTimeout(() => {
        if (feedback && feedback.parentNode) {
          feedback.remove();
        }
      }, 3000);
    }
    
