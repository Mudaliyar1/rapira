        autoCheckAvailability();
      }
    });
    
    // Also check when venue changes (integrated with existing venue change handler)
    const originalVenueChangeHandler = venueSelect.onchange;
    venueSelect.addEventListener('change', function() {
      updateVenuePricing();
      showAvailabilitySection();
      resetAvailabilityResults();
      // Auto-check if all required fields are filled
      setTimeout(autoCheckAvailability, 500);
    });

    // Manual availability check
    checkAvailabilityBtn.addEventListener('click', checkVenueAvailability);

    async function checkVenueAvailability() {
      const venueId = venueSelect.value;
      const date = dateInput.value;
      const startTime = timeInput.value;
      const duration = bookingHours.value;

      if (!venueId || !date || !startTime || !duration) {
        availabilityResults.innerHTML = `
          <div class="alert alert-warning mb-0">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Please select venue, date, start time, and duration first.
          </div>
        `;
        return;
      }

      // Show loading state
      availabilityResults.innerHTML = `
        <div class="text-center">
          <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
          <span>Checking availability...</span>
        </div>
      `;

      try {
        const response = await fetch('/venue-availability/check-availability', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            venueId,
            date,
            startTime,
            duration: parseInt(duration)
          })
        });

        const result = await response.json();

        if (result.success) {
          displayAvailabilityResults(result);
        } else {
          availabilityResults.innerHTML = `
            <div class="alert alert-danger mb-0">
              <i class="bi bi-x-circle me-2"></i>
              Error: ${result.message}
            </div>
          `;
        }
      } catch (error) {
        console.error('Error checking availability:', error);
        availabilityResults.innerHTML = `
          <div class="alert alert-danger mb-0">
            <i class="bi bi-x-circle me-2"></i>
            Error checking availability. Please try again.
          </div>
        `;
      }
    }

    function displayAvailabilityResults(result) {
      // Remove visual feedback classes
      availabilityResults.classList.remove('availability-checking');
      const formControls = [venueSelect, dateInput, timeInput, bookingHours];
      formControls.forEach(control => {
        control.classList.remove('checking');
      });
      
      const { available, requestedSlot, venue, conflicts, suggestions, existingBookings } = result;

      let html = '';

      if (available) {
        // Venue is available
        html = `
          <div class="alert alert-success mb-3">
            <i class="bi bi-check-circle me-2"></i>
            <strong>Available!</strong> The venue is free for your requested time slot.
          </div>
          <div class="row">
            <div class="col-md-6">
              <h6 class="text-success mb-2">Your Booking Slot</h6>
              <div class="border rounded p-2 bg-dark text-light">
                <strong class="text-light">${venue.name}</strong><br>
                <i class="bi bi-calendar3 me-1"></i> ${toISTDateString(dateInput.value)}<br>
                <i class="bi bi-clock me-1"></i> ${requestedSlot.startTime} - ${requestedSlot.endTime}<br>
                <i class="bi bi-hourglass-split me-1"></i> ${requestedSlot.duration} hour(s)
              </div>
            </div>
        `;

        if (existingBookings.length > 0) {
          html += `
            <div class="col-md-6">
              <h6 class="text-info mb-2">Other Bookings Today</h6>
              <div style="max-height: 150px; overflow-y: auto;">
          `;
          existingBookings.forEach(booking => {
            html += `
              <div class="border rounded p-2 mb-2 small bg-dark text-light">
                <strong class="text-light">${booking.title}</strong><br>
                <span class="text-light">${booking.artistName} • ${booking.startTime} (${booking.duration}h) • ${booking.status}</span>
              </div>
            `;
          });
          html += `</div></div>`;
        }
        html += `</div>`;

        availabilityCard.className = 'card border-success';
        availabilityHeader.className = 'card-header bg-success text-white';
      } else {
        // Venue has conflicts
        html = `
          <div class="alert alert-danger mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Booking Conflict!</strong> This time slot overlaps with existing bookings.
          </div>
        `;

        if (conflicts.length > 0) {
          html += `
            <h6 class="text-danger mb-2">⚠️ Venue Booking Restrictions</h6>
            <div class="alert alert-warning small mb-3">
              <strong class="text-dark">New Venue Booking Rules:</strong><br>
              <span class="text-dark">• <strong class="text-dark">Multiple concerts allowed per venue per day</strong><br>
              • <strong class="text-dark">12-hour minimum gap</strong> between any concerts<br>
              • Concerts can extend past midnight with proper gaps</span>
            </div>
            <div class="mb-3">
          `;
          conflicts.forEach(conflict => {
            html += `
              <div class="border-start border-3 border-danger ps-3 mb-2 bg-dark text-light rounded p-2">
                <h6 class="mb-1 text-danger">${conflict.title}</h6>
                <div class="text-light small">
                  <i class="bi bi-person me-1"></i>${conflict.artistName}<br>
                  <i class="bi bi-clock me-1"></i>${conflict.startTime} - ${conflict.endTime} (${conflict.duration}h)<br>
                  <i class="bi bi-info-circle me-1"></i>Status: ${conflict.status}
                  ${conflict.reason ? `<br><i class="bi bi-exclamation-triangle me-1"></i><strong>Issue:</strong> ${conflict.reason}` : ''}
                  ${conflict.conflictDate ? `<br><i class="bi bi-calendar me-1"></i>Date: ${conflict.conflictDate}` : ''}
                </div>
              </div>
            `;
          });
          html += `</div>`;
        }

        if (suggestions.length > 0) {
          html += `
            <h6 class="text-success mb-2">💡 Alternative Options</h6>
            <div class="row">
