    function populateBookingHoursDropdown() {
      // Clear existing options
      bookingHours.innerHTML = '<option value="">Select hours</option>';
      
      console.log('=== BOOKING HOURS DEBUG ===');
      console.log('Current venue:', currentVenue);
      console.log('Venue pricing:', currentVenue ? currentVenue.pricing : null);
      console.log('Hourly rates array:', currentVenue && currentVenue.pricing ? currentVenue.pricing.hourlyRates : null);
      
      if (currentVenue && currentVenue.pricing && currentVenue.pricing.hourlyRates && currentVenue.pricing.hourlyRates.length > 0) {
        // Sort rates by hour count and enforce venue minimum hours
        const sortedRates = [...currentVenue.pricing.hourlyRates].sort((a, b) => a.hours - b.hours);
        const filteredRates = sortedRates.filter(rateObj => rateObj.hours >= currentVenueMinimumHours);
        console.log('Sorted rates:', sortedRates);
        console.log('Filtered rates (respecting minimum hours):', filteredRates);
        
        let validOptionsCount = 0;
        
        // Add options for each available hour rate WITH commission
        filteredRates.forEach(rateObj => {
          console.log('Processing rate object:', rateObj);
          
          // Only add if has rate, commission percentage, and commission amount
          if (rateObj.hours && rateObj.rate && parseFloat(rateObj.rate) > 0 &&
              rateObj.commissionPercentage !== undefined && rateObj.commissionPercentage >= 0) {
