        if (currentVenue.pricing.hourlyRates.length > 0) {
          const firstRateObj = currentVenue.pricing.hourlyRates[0];
          const firstHourRate = firstRateObj ? parseFloat(firstRateObj.rate) || 0 : 0;
          displayHourlyRate.textContent = firstHourRate.toLocaleString('en-IN');
          displayMinHours.textContent = minimumHours;
          
