    // Helper function to show conflict popup
    function showConflictPopup(conflicts, suggestions = null) {
      let message = '⚠️ Venue Booking Restriction!\n\n';
      message += '🔒 NEW BOOKING RULES:\n';
      message += '• Multiple concerts allowed per venue per day\n';
      message += '• 12-hour minimum gap between any concerts\n';
      message += '• Concerts can extend past midnight\n\n';
      
      if (typeof conflicts === 'string') {
        message += conflicts;
      } else if (Array.isArray(conflicts)) {
        message += '❌ Your booking conflicts with:\n\n';
        conflicts.forEach((conflict, index) => {
          message += `${index + 1}. ${conflict.title}\n`;
          message += `   Artist: ${conflict.artistName}\n`;
          message += `   Time: ${conflict.startTime} - ${conflict.endTime}\n`;
          if (conflict.reason) {
            message += `   Issue: ${conflict.reason}\n`;
          }
          message += '\n';
        });
        
        if (suggestions && suggestions.length > 0) {
          message += '💡 Alternative Slots Available:\n\n';
          suggestions.slice(0, 3).forEach((suggestion, index) => {
            if (suggestion.date) {
              message += `${index + 1}. ${suggestion.date} at ${suggestion.startTime}\n`;
            } else {
              message += `${index + 1}. ${suggestion.startTime} - ${suggestion.endTime}\n`;
            }
          });
          if (suggestions.length > 3) {
            message += `\n...and ${suggestions.length - 3} more slots available\n`;
          }
        }
      }
      
      message += '\n📅 Please choose a different time slot with proper 12-hour gap.';
      alert(message);
    }

    // Helper function to reset pay button
    function resetPayButton() {
      payAndSubmitBtn.innerHTML = '<i class="bi bi-credit-card me-1"></i> Pay & Submit Concert';
      payAndSubmitBtn.disabled = false;
    }
    
    // Initial auto-check when form loads (if fields are pre-filled)
    setTimeout(() => {
      if (venueSelect.value || dateInput.value || timeInput.value || bookingHours.value) {
        autoCheckAvailability();
      }
    }, 1000);
  });
</script>

