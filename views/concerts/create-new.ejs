            // Show conflict popup with details
            showConflictPopup(availabilityResult.conflicts, availabilityResult.suggestions);
            resetPayButton();
            return;
          }

          // If available, continue with payment
          console.log('Venue is available, proceeding with payment...');
          
        } catch (error) {
          console.error('Error checking venue availability:', error);
          showConflictPopup('Unable to verify venue availability. Please check your internet connection and try again.');
          resetPayButton();
          return;
        }
      }

      try {
        payAndSubmitBtn.disabled = true;
        payAndSubmitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Creating Payment Order...';

        // Validate poster image if uploaded
        const posterImageInput = document.getElementById('posterImage');
        if (posterImageInput && posterImageInput.files.length > 0) {
          const file = posterImageInput.files[0];
          const maxSize = 5 * 1024 * 1024; // 5MB
          const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
          
          // Check file size
          if (file.size > maxSize) {
            alert(`File size too large! Maximum size is 5MB. Your file is ${(file.size / (1024 * 1024)).toFixed(2)}MB.`);
            resetPayButton();
            return;
          }
          
          // Check file type
          if (!allowedTypes.includes(file.type)) {
            alert(`Invalid file type! Only JPG, PNG, and GIF files are allowed. You uploaded: ${file.type}`);
            resetPayButton();
            return;
          }
        }

        console.log('Form element found:', concertForm);
        console.log('Form elements count:', concertForm.elements.length);

        // Prepare form data
        const formData = new FormData(concertForm);
        
        // Add hourly rate for the selected booking hours
        const selectedHourOption = bookingHours.options[bookingHours.selectedIndex];
        if (selectedHourOption && selectedHourOption.dataset.rate) {
          formData.append('hourlyRate', selectedHourOption.dataset.rate);
        }
        
        // Debug: Log form data being sent
        console.log('Preparing to send form data...');
        console.log('FormData entries:');
        for (let [key, value] of formData.entries()) {
          console.log(`${key}: ${value}`);
        }

        // Check if FormData is empty
        let hasData = false;
        for (let [key, value] of formData.entries()) {
          hasData = true;
          break;
        }

        if (!hasData) {
          throw new Error('Form data is empty - no form fields found');
