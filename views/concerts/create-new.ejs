                       onclick="selectSuggestedDate('${suggestion.date}', '${suggestion.startTime}')"
                       style="transition: all 0.3s ease;">
                    <i class="bi bi-calendar-check text-success me-1"></i>
                    <strong>${suggestion.date}</strong><br>
                    <small class="text-success">${suggestion.startTime} - ${suggestion.endTime}</small><br>
                    <small class="text-muted">${suggestion.note || 'Available date'}</small>
                    <div class="mt-1">
                      <small class="text-success fw-bold">🖱️ Click to select this date & time</small>
                    </div>
                  </div>
                </div>
              `;
            } else {
              // Time slot suggestion
              html += `
                <div class="col-md-6 mb-2">
                  <div class="border rounded p-2 bg-success bg-opacity-10 border-success cursor-pointer hover-effect" 
                       onclick="selectSuggestedTime('${suggestion.startTime}')"
                       style="transition: all 0.3s ease;">
                    <i class="bi bi-clock text-success me-1"></i>
                    ${suggestion.startTime} - ${suggestion.endTime}
