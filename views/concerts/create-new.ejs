          html += `</div>`;

          if (suggestions.length > 6) {
            html += `<p class="text-muted small mt-2">+${suggestions.length - 6} more dates available</p>`;
          }
        }

        availabilityCard.className = 'card border-danger';
        availabilityHeader.className = 'card-header bg-danger text-white';
      }

      availabilityResults.innerHTML = html;
    }

    // Function to select suggested time
    window.selectSuggestedTime = function(timeString) {
      // Parse time string like "2:00 PM" to 24-hour format
      const [time, period] = timeString.split(' ');
      let [hours, minutes] = time.split(':').map(Number);
      
      if (period === 'PM' && hours !== 12) hours += 12;
      if (period === 'AM' && hours === 12) hours = 0;
      
      const timeValue = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
      timeInput.value = timeValue;
      
      // Show success feedback
      showSelectionFeedback('Time updated to ' + timeString);
      
      // Re-check availability with new time
      setTimeout(checkVenueAvailability, 300);
    };

    // Function to select suggested date and time
    window.selectSuggestedDate = function(dateString, timeString) {
      // Update date field
      dateInput.value = dateString;
      
      // Parse and update time field
      const [time, period] = timeString.split(' ');
      let [hours, minutes] = time.split(':').map(Number);
      
      if (period === 'PM' && hours !== 12) hours += 12;
      if (period === 'AM' && hours === 12) hours = 0;
      
      const timeValue = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
      timeInput.value = timeValue;
      
      // Show success feedback
      showSelectionFeedback(`Date & time updated to ${dateString} at ${timeString}`);
      
      // Re-check availability with new date and time
      setTimeout(checkVenueAvailability, 300);
    };

    // Function to show selection feedback
