<!-- Hero Section -->
<section class="bg-dark text-white py-5 mb-4">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <h1 class="fw-bold mb-3">Upcoming Concerts</h1>
        <p class="lead mb-0">Discover and book tickets for the hottest rap concerts across India</p>
      </div>
      <div class="col-lg-4">
        <div class="text-center">
          <i class="bi bi-music-note-beamed display-1 text-primary"></i>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Filter Section -->
<section class="py-4" style="background-color: var(--bg);">
  <div class="container">
    <!-- Search and Filter Form -->
    <div class="card border-0 shadow-lg mb-4 glass-card-dark">
      <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            <i class="bi bi-funnel me-2"></i>Search & Filter Concerts
          </h5>
          <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
            <i class="bi bi-chevron-down" id="filterToggleIcon"></i>
            <span class="d-none d-md-inline ms-1">Toggle Filters</span>
          </button>
        </div>
      </div>
      <div class="collapse" id="filterCollapse">
        <div class="card-body">
        <form action="/concerts" method="GET" id="concertFilterForm">
          <div class="row g-3">
            <!-- Search Input -->
            <div class="col-md-4">
              <label for="searchInput" class="form-label fw-semibold">Search Concerts</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                  <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text" class="form-control border-start-0" id="searchInput" name="search"
                       placeholder="Search by title, artist, or venue..."
                       value="<%= filters.search || '' %>">
              </div>
            </div>

            <!-- City Filter -->
            <div class="col-md-2">
              <label for="cityFilter" class="form-label fw-semibold">City</label>
              <select class="form-select" id="cityFilter" name="city">
                <option value="">All Cities</option>
                <% if (cities && cities.length > 0) { %>
                  <% cities.forEach(city => { %>
                    <option value="<%= city %>" <%= filters.city === city ? 'selected' : '' %>><%= city %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <!-- Date Filter -->
            <div class="col-md-2">
              <label for="dateFilter" class="form-label fw-semibold">Date</label>
              <input type="date" class="form-control" id="dateFilter" name="date" value="<%= filters.date || '' %>">
            </div>

            <!-- Type Filter -->
            <div class="col-md-2">
              <label for="typeFilter" class="form-label fw-semibold">Type</label>
              <select class="form-select" id="typeFilter" name="type">
                <option value="" <%= !filters.type ? 'selected' : '' %>>All Types</option>
                <option value="free" <%= filters.type === 'free' ? 'selected' : '' %>>Free</option>
                <option value="paid" <%= filters.type === 'paid' ? 'selected' : '' %>>Paid</option>
              </select>
            </div>

            <!-- Sort Filter -->
            <div class="col-md-2">
              <label for="sortFilter" class="form-label fw-semibold">Sort By</label>
              <select class="form-select" id="sortFilter" name="sort">
                <option value="date" <%= filters.sort === 'date' ? 'selected' : '' %>>Date</option>
                <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title</option>
                <option value="city" <%= filters.sort === 'city' ? 'selected' : '' %>>City</option>
                <option value="price" <%= filters.sort === 'price' ? 'selected' : '' %>>Price</option>
              </select>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="row mt-4">
            <div class="col-12">
              <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-search me-1"></i> Search
                </button>
                <a href="/concerts" class="btn btn-outline-secondary px-4">
                  <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </a>
              </div>
            </div>
          </div>
        </form>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Concerts List -->
<section class="py-5">
  <div class="container">
    <div class="row g-4">
      <% if (concerts && concerts.length > 0) { %>
        <% concerts.forEach(concert => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card card-concert h-100">
              <div class="position-relative overflow-hidden">
                <img src="<%= concert.posterImage %>" class="card-img-top concert-thumbnail" alt="<%= concert.title %>">
                <div class="position-absolute top-0 end-0 m-2">
                  <% if(new Date(concert.date) < new Date()) { %>
                    <span class="badge bg-secondary me-1 px-3 py-2">Past</span>
                  <% } %>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %> px-3 py-2">
                    <%= concert.isPaid ? (concert.price !== null && concert.price !== undefined ? `₹${concert.price}` : '₹ 0') : 'Free' %>
                  </span>
                </div>
              </div>
              <div class="card-body">
                <h5 class="card-title fw-bold text-white" style="color: white !important;"><%= concert.title %></h5>
                <p class="card-text mb-2">
                  <i class="bi bi-geo-alt me-2"></i> <%= concert.venue && concert.venue.name ? concert.venue.name : concert.venue %>, <%= concert.city %>
                </p>
                <p class="card-text mb-3">
                  <i class="bi bi-calendar3 me-2"></i> <%= new Date(concert.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %> • <%= concert.time %>
                </p>
                <p class="card-text mb-3">By
                <% if (concert.artist) { %>
                  <a href="/artists/<%= concert.artist._id %>" class="text-decoration-none fw-medium gradient-text">
                    <%= concert.artist.user ? concert.artist.user.name : 'Unknown Artist' %>
                  </a>
                <% } else { %>
                  <span class="fw-medium">Unknown Artist</span>
                <% } %>
                </p>
              </div>
              <div class="card-footer">
                <a href="/concerts/<%= concert._id %>" class="btn btn-primary w-100">View Details</a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <div class="py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h3 class="mt-4">No Concerts Found</h3>
            <p class="text-muted mb-4">There are no concerts matching your filters.</p>
            <a href="/concerts" class="btn btn-primary">Clear Filters</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- JavaScript for Enhanced Functionality -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Enhanced form handling with auto-submit for filters
  const form = document.getElementById('concertFilterForm');
  const searchInput = document.getElementById('searchInput');
  const cityFilter = document.getElementById('cityFilter');
  const dateFilter = document.getElementById('dateFilter');
  const typeFilter = document.getElementById('typeFilter');
  const sortFilter = document.getElementById('sortFilter');

  let searchTimeout;

  // Debounced search input
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        form.submit();
      }, 800); // 800ms delay for better UX
    });

    // Immediate search on Enter key
    searchInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        clearTimeout(searchTimeout);
        form.submit();
      }
    });
  }

  // Auto-submit on filter changes
  [cityFilter, dateFilter, typeFilter, sortFilter].forEach(filter => {
    if (filter) {
      filter.addEventListener('change', function() {
        clearTimeout(searchTimeout);
        form.submit();
      });
    }
  });

  // Enhanced form submission with loading state
  if (form) {
    form.addEventListener('submit', function() {
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Searching...';
        submitBtn.disabled = true;
        submitBtn.classList.add('loading');

        // Re-enable after a delay (in case of errors)
        setTimeout(() => {
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
          submitBtn.classList.remove('loading');
        }, 5000);
      }
    });
  }

  // Highlight search terms in results
  const searchTerm = '<%= filters.search || "" %>';
  if (searchTerm.trim()) {
    highlightSearchTerms(searchTerm.trim());
  }

  // Function to highlight search terms
  function highlightSearchTerms(term) {
    if (!term) return;

    const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    const concertCards = document.querySelectorAll('.card-concert');

    concertCards.forEach(card => {
      const title = card.querySelector('.card-title');
      const venue = card.querySelector('.card-text');

      if (title && !title.querySelector('mark')) {
        const originalText = title.textContent;
        if (regex.test(originalText)) {
          title.innerHTML = originalText.replace(regex, '<mark class="bg-warning text-dark rounded px-1">$1</mark>');
        }
      }

      if (venue && !venue.querySelector('mark')) {
        const originalText = venue.textContent;
        if (regex.test(originalText)) {
          venue.innerHTML = originalText.replace(regex, '<mark class="bg-warning text-dark rounded px-1">$1</mark>');
        }
      }
    });
  }

  // Show active filter indicators
  function updateFilterIndicators() {
    const hasFilters = '<%= filters.search || filters.city || filters.date || filters.type || filters.sort !== "date" %>';

    if (hasFilters) {
      const filterHeader = document.querySelector('.card-header h5');
      if (filterHeader && !filterHeader.querySelector('.badge')) {
        filterHeader.innerHTML += ' <span class="badge bg-light text-primary ms-2">Filters Active</span>';
      }
    }
  }

  updateFilterIndicators();

  // Handle filter toggle icon rotation
  const filterCollapse = document.getElementById('filterCollapse');
  const filterToggleIcon = document.getElementById('filterToggleIcon');

  if (filterCollapse && filterToggleIcon) {
    filterCollapse.addEventListener('show.bs.collapse', function () {
      filterToggleIcon.classList.remove('bi-chevron-down');
      filterToggleIcon.classList.add('bi-chevron-up');
    });

    filterCollapse.addEventListener('hide.bs.collapse', function () {
      filterToggleIcon.classList.remove('bi-chevron-up');
      filterToggleIcon.classList.add('bi-chevron-down');
    });
  }
});
</script>

<style>
/* Enhanced styles for concerts page */
.card-concert {
  transition: all 0.3s ease;
  border: none;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  overflow: hidden;
}

.card-concert:hover {
  transform: translateY(-8px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

.concert-thumbnail {
  height: 200px;
  object-fit: cover;
  transition: all 0.3s ease;
}

.card-concert:hover .concert-thumbnail {
  transform: scale(1.05);
}

/* Enhanced form styling */
.form-control:focus, .form-select:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
}

.input-group-text {
  border-color: #dee2e6;
}

.form-label {
  color: #495057;
  margin-bottom: 0.5rem;
}

/* Button enhancements */
.btn {
  border-radius: 8px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border: none;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #5b5bd6 0%, #7c3aed 100%);
}

/* Card enhancements */
.card {
  transition: all 0.3s ease;
  border-radius: 12px;
  overflow: hidden;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.1);
}

.card-header {
  border-radius: 12px 12px 0 0 !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

/* Badge styling */
.badge {
  font-size: 0.75em;
  padding: 0.5em 0.75em;
  border-radius: 6px;
}

/* Search highlighting */
mark {
  padding: 0.1em 0.3em;
  border-radius: 4px;
  background-color: #fff3cd;
  color: #856404;
  font-weight: 500;
}

/* Loading animation */
@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.6; }
  100% { opacity: 1; }
}

.loading {
  animation: pulse 1.5s infinite;
}

/* Filter indicator */
.badge.bg-light {
  color: #6366f1 !important;
  background-color: rgba(99, 102, 241, 0.1) !important;
  border: 1px solid rgba(99, 102, 241, 0.2);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .card-concert {
    margin-bottom: 1.5rem;
  }

  .concert-thumbnail {
    height: 150px;
  }

  .btn {
    margin-bottom: 0.5rem;
  }

  .d-flex.flex-wrap.gap-2 {
    justify-content: center;
  }
}

/* Smooth transitions for all interactive elements */
* {
  transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}
</style>
