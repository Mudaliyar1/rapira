<!-- Hero Section -->
<section class="bg-dark text-white py-5 mb-4">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <h1 class="fw-bold mb-3">Upcoming Concerts</h1>
        <p class="lead mb-0">Discover and book tickets for the hottest rap concerts across India</p>
      </div>
      <div class="col-lg-4">
        <form action="/concerts" method="GET" class="mt-4 mt-lg-0">
          <div class="card bg-dark border border-secondary">
            <div class="card-body">
              <h5 class="card-title mb-3">Filter Concerts</h5>

              <div class="mb-3">
                <label for="city" class="form-label">City</label>
                <select class="form-select" id="city" name="city">
                  <option value="">All Cities</option>
                  <% if (cities && cities.length > 0) { %>
                    <% cities.forEach(city => { %>
                      <option value="<%= city %>" <%= filters.city === city ? 'selected' : '' %>><%= city %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>

              <div class="mb-3">
                <label for="date" class="form-label">Date</label>
                <input type="date" class="form-control" id="date" name="date" value="<%= filters.date || '' %>">
              </div>

              <div class="mb-3">
                <label for="type" class="form-label">Type</label>
                <select class="form-select" id="type" name="type">
                  <option value="" <%= !filters.type ? 'selected' : '' %>>All Types</option>
                  <option value="free" <%= filters.type === 'free' ? 'selected' : '' %>>Free</option>
                  <option value="paid" <%= filters.type === 'paid' ? 'selected' : '' %>>Paid</option>
                </select>
              </div>

              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Apply Filters</button>
                <a href="/concerts" class="btn btn-secondary">
                  <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Concerts List -->
<section class="py-4">
  <div class="container">
    <div class="row g-4">
      <% if (concerts && concerts.length > 0) { %>
        <% concerts.forEach(concert => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card card-concert h-100">
              <div class="position-relative overflow-hidden">
                <img src="<%= concert.posterImage %>" class="card-img-top" alt="<%= concert.title %>">
                <div class="position-absolute top-0 end-0 m-2">
                  <% if(new Date(concert.date) < new Date()) { %>
                    <span class="badge bg-secondary me-1 px-3 py-2">Past</span>
                  <% } %>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %> px-3 py-2">
                    <%= concert.isPaid ? (concert.price !== null && concert.price !== undefined ? `₹${concert.price}` : '₹ 0') : 'Free' %>
                  </span>
                </div>
              </div>
              <div class="card-body">
                <h5 class="card-title fw-bold"><%= concert.title %></h5>
                <p class="card-text mb-2">
                  <i class="bi bi-geo-alt me-2"></i> <%= concert.venue %>, <%= concert.city %>
                </p>
                <p class="card-text mb-3">
                  <i class="bi bi-calendar3 me-2"></i> <%= new Date(concert.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %> • <%= concert.time %>
                </p>
                <p class="card-text mb-3">By
                <% if (concert.artist) { %>
                  <a href="/artists/<%= concert.artist._id %>" class="text-decoration-none fw-medium gradient-text">
                    <%= concert.artist.user ? concert.artist.user.name : 'Unknown Artist' %>
                  </a>
                <% } else { %>
                  <span class="fw-medium">Unknown Artist</span>
                <% } %>
                </p>
              </div>
              <div class="card-footer">
                <a href="/concerts/<%= concert._id %>" class="btn btn-primary w-100">View Details</a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <div class="py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h3 class="mt-4">No Concerts Found</h3>
            <p class="text-muted mb-4">There are no concerts matching your filters.</p>
            <a href="/concerts" class="btn btn-primary">Clear Filters</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>
