<div class="rapira-concerts-page">
  <!-- 1. Hero Section -->
  <section class="rh-concerts-hero">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 text-center text-lg-start">
          <div class="rh-hero-badge-pill mb-2">
            <i class="bi bi-broadcast me-1"></i> Live Music &amp; Events
          </div>
          <h1 class="rh-concerts-hero-title">Upcoming Concerts</h1>
          <p class="rh-concerts-hero-desc">Discover and book tickets for the hottest rap concerts across India</p>
        </div>
        <div class="col-lg-4 d-none d-lg-block">
          <div class="rh-concerts-hero-art">
            <div class="rh-hero-motif-wrap">
              <div class="rh-hero-waveform" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
              </div>
              <div class="rh-hero-icon-bubble" aria-hidden="true">
                <i class="bi bi-music-note-beamed"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Search & Filter Section -->
  <section class="rh-concerts-filter-section">
    <div class="container">
      <div class="rh-concerts-filter-container">
        <!-- Filter Header with Toggle -->
        <div class="rh-concerts-filter-header d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <div class="rh-filter-header-icon">
              <i class="bi bi-funnel-fill"></i>
            </div>
            <h2 class="rh-filter-header-title mb-0">Search &amp; Filter Concerts</h2>
            <% 
              const isFilterActive = Boolean(filters.search || filters.city || filters.date || filters.type || (filters.sort && filters.sort !== 'date'));
            %>
            <% if (isFilterActive) { %>
              <span class="rh-filter-active-pill" id="filterActiveBadge">
                <i class="bi bi-check-circle-fill me-1"></i> Filters Active
              </span>
            <% } %>
          </div>
          <button class="rh-filter-toggle-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#concertFilterCollapse" aria-expanded="false" aria-controls="concertFilterCollapse" id="filterToggleBtn" aria-label="Toggle Filters">
            <span class="me-1" id="filterToggleText">Show Filters</span>
            <i class="bi bi-chevron-down" id="filterToggleIcon"></i>
          </button>
        </div>

        <!-- Collapsible Filter Form Body (Collapsed by default, expandable via button) -->
        <div class="collapse" id="concertFilterCollapse">
          <form action="/concerts" method="GET" id="concertFilterForm" class="rh-concerts-filter-form mt-3">
            
            <!-- Hidden Inputs to preserve form field state for standard submission -->
            <input type="hidden" id="cityInput" name="city" value="<%= filters.city || '' %>">
            <input type="hidden" id="typeInput" name="type" value="<%= filters.type || '' %>">
            <input type="hidden" id="sortInput" name="sort" value="<%= filters.sort || 'date' %>">

            <div class="row g-3 align-items-end">
              <!-- 1. Search Field -->
              <div class="col-12 col-lg-4">
                <label for="searchInput" class="rh-filter-label">Search Concerts</label>
                <div class="rh-filter-search-wrap">
                  <i class="bi bi-search rh-filter-search-icon" aria-hidden="true"></i>
                  <input type="text" 
                         class="rh-filter-input rh-filter-search-field" 
                         id="searchInput" 
                         name="search" 
                         placeholder="Search by title, artist, or venue..." 
                         value="<%= filters.search || '' %>"
                         autocomplete="off"
                         aria-label="Search by title, artist, or venue">
                  <% if (filters.search) { %>
                    <button type="button" class="rh-filter-clear-btn" id="searchClearBtn" aria-label="Clear search input">
                      <i class="bi bi-x-circle-fill"></i>
                    </button>
                  <% } %>
                </div>
              </div>

              <!-- 2. City Custom Dropdown -->
              <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                <label class="rh-filter-label" id="cityFilterLabel">City</label>
                <div class="rh-custom-dropdown" id="cityDropdown" data-name="city">
                  <button type="button" 
                          class="rh-custom-dropdown-btn" 
                          id="cityDropdownBtn" 
                          aria-haspopup="listbox" 
                          aria-expanded="false" 
                          aria-labelledby="cityFilterLabel cityDropdownLabel"
                          aria-controls="cityDropdownMenu">
                    <span class="rh-dropdown-btn-inner">
                      <i class="bi bi-geo-alt rh-dropdown-icon" aria-hidden="true"></i>
                      <span class="rh-dropdown-label" id="cityDropdownLabel"><%= filters.city || 'All Cities' %></span>
                    </span>
                    <i class="bi bi-chevron-down rh-dropdown-caret" aria-hidden="true"></i>
                  </button>
                  <ul class="rh-custom-dropdown-menu" id="cityDropdownMenu" role="listbox" aria-labelledby="cityFilterLabel">
                    <li class="rh-dropdown-option <%= !filters.city ? 'selected' : '' %>" 
                        role="option" 
                        data-value="" 
                        aria-selected="<%= !filters.city ? 'true' : 'false' %>" 
                        tabindex="0">
                      <span>All Cities</span>
                      <i class="bi bi-check2 rh-option-check" aria-hidden="true"></i>
                    </li>
                    <% if (cities && cities.length > 0) { %>
                      <% cities.forEach(city => { %>
                        <li class="rh-dropdown-option <%= filters.city === city ? 'selected' : '' %>" 
                            role="option" 
                            data-value="<%= city %>" 
                            aria-selected="<%= filters.city === city ? 'true' : 'false' %>" 
                            tabindex="0">
                          <span><%= city %></span>
                          <i class="bi bi-check2 rh-option-check" aria-hidden="true"></i>
                        </li>
                      <% }); %>
                    <% } %>
                  </ul>
                </div>
              </div>

              <!-- 3. Date Input -->
              <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                <label for="dateFilter" class="rh-filter-label">Date</label>
                <div class="rh-filter-date-wrap">
                  <i class="bi bi-calendar-event rh-filter-date-icon" aria-hidden="true"></i>
                  <input type="date" 
                         class="rh-filter-input rh-filter-date-field" 
                         id="dateFilter" 
                         name="date" 
                         value="<%= filters.date || '' %>"
                         aria-label="Filter by date">
                  <% if (filters.date) { %>
                    <button type="button" class="rh-filter-clear-btn" id="dateClearBtn" aria-label="Clear date">
                      <i class="bi bi-x-circle-fill"></i>
                    </button>
                  <% } %>
                </div>
              </div>

              <!-- 4. Concert Type Custom Dropdown -->
              <%
                const typeOptions = [
                  { value: '', label: 'All Types' },
                  { value: 'free', label: 'Free' },
                  { value: 'paid', label: 'Paid' }
                ];
                const activeType = filters.type || '';
                const activeTypeOpt = typeOptions.find(o => o.value === activeType) || typeOptions[0];
              %>
              <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                <label class="rh-filter-label" id="typeFilterLabel">Concert Type</label>
                <div class="rh-custom-dropdown" id="typeDropdown" data-name="type">
                  <button type="button" 
                          class="rh-custom-dropdown-btn" 
                          id="typeDropdownBtn" 
                          aria-haspopup="listbox" 
                          aria-expanded="false" 
                          aria-labelledby="typeFilterLabel typeDropdownLabel"
                          aria-controls="typeDropdownMenu">
                    <span class="rh-dropdown-btn-inner">
                      <i class="bi bi-ticket-perforated rh-dropdown-icon" aria-hidden="true"></i>
                      <span class="rh-dropdown-label" id="typeDropdownLabel"><%= activeTypeOpt.label %></span>
                    </span>
                    <i class="bi bi-chevron-down rh-dropdown-caret" aria-hidden="true"></i>
                  </button>
                  <ul class="rh-custom-dropdown-menu" id="typeDropdownMenu" role="listbox" aria-labelledby="typeFilterLabel">
                    <% typeOptions.forEach(opt => { %>
                      <li class="rh-dropdown-option <%= activeType === opt.value ? 'selected' : '' %>" 
                          role="option" 
                          data-value="<%= opt.value %>" 
                          aria-selected="<%= activeType === opt.value ? 'true' : 'false' %>" 
                          tabindex="0">
                        <span><%= opt.label %></span>
                        <i class="bi bi-check2 rh-option-check" aria-hidden="true"></i>
                      </li>
                    <% }); %>
                  </ul>
                </div>
              </div>

              <!-- 5. Sort By Custom Dropdown -->
              <%
                const sortOptions = [
                  { value: 'date', label: 'Date' },
                  { value: 'title', label: 'Title' },
                  { value: 'city', label: 'City' },
                  { value: 'price', label: 'Price' }
                ];
                const activeSort = filters.sort || 'date';
                const activeSortOpt = sortOptions.find(o => o.value === activeSort) || sortOptions[0];
              %>
              <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                <label class="rh-filter-label" id="sortFilterLabel">Sort By</label>
                <div class="rh-custom-dropdown" id="sortDropdown" data-name="sort">
                  <button type="button" 
                          class="rh-custom-dropdown-btn" 
                          id="sortDropdownBtn" 
                          aria-haspopup="listbox" 
                          aria-expanded="false" 
                          aria-labelledby="sortFilterLabel sortDropdownLabel"
                          aria-controls="sortDropdownMenu">
                    <span class="rh-dropdown-btn-inner">
                      <i class="bi bi-arrow-down-up rh-dropdown-icon" aria-hidden="true"></i>
                      <span class="rh-dropdown-label" id="sortDropdownLabel"><%= activeSortOpt.label %></span>
                    </span>
                    <i class="bi bi-chevron-down rh-dropdown-caret" aria-hidden="true"></i>
                  </button>
                  <ul class="rh-custom-dropdown-menu" id="sortDropdownMenu" role="listbox" aria-labelledby="sortFilterLabel">
                    <% sortOptions.forEach(opt => { %>
                      <li class="rh-dropdown-option <%= activeSort === opt.value ? 'selected' : '' %>" 
                          role="option" 
                          data-value="<%= opt.value %>" 
                          aria-selected="<%= activeSort === opt.value ? 'true' : 'false' %>" 
                          tabindex="0">
                        <span><%= opt.label %></span>
                        <i class="bi bi-check2 rh-option-check" aria-hidden="true"></i>
                      </li>
                    <% }); %>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Action Buttons Row -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4 pt-2 border-top border-peach-subtle">
              <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="rh-btn-crimson-solid" id="concertFilterSubmitBtn">
                  <i class="bi bi-search me-1"></i> Search
                </button>
                <a href="/concerts" class="rh-btn-outline-pill" id="concertFilterResetBtn">
                  <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </a>
              </div>
              <% if (concerts && concerts.length > 0) { %>
                <div class="rh-filter-results-count text-muted small">
                  Showing <strong class="text-dark"><%= concerts.length %></strong> concert<%= concerts.length === 1 ? '' : 's' %>
                </div>
              <% } %>
            </div>

          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Concerts Grid -->
  <section class="rh-concerts-grid-section pb-5">
    <div class="container">
      <div class="row g-4" id="concertsGrid">
        <% if (concerts && concerts.length > 0) { %>
          <% concerts.forEach((concert, index) => { 
               const concertPoster = concert.posterImage || '/images/default-concert.jpg';
               const isPastEvent = new Date(concert.date) < new Date();
               const artistName = (concert.artist && concert.artist.user && concert.artist.user.name)
                 ? concert.artist.user.name
                 : ((concert.artist && concert.artist.stageName) ? concert.artist.stageName : 'Featured Artist');
               const venueName = (concert.venue && concert.venue.name) ? concert.venue.name : (concert.venue || 'Venue TBA');
          %>
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= (index % 6) * 50 %>">
              <div class="rh-concert-card">
                <div class="rh-concert-card-frame">
                  <!-- Ambient blurred backdrop for letterbox artwork -->
                  <div class="rh-concert-poster-blur" style="background-image: url('<%= concertPoster %>');" aria-hidden="true"></div>
                  <!-- Crisp foreground poster -->
                  <img src="<%= concertPoster %>" alt="<%= concert.title %>" class="rh-concert-card-img" loading="lazy" onerror="this.onerror=null; this.src='/images/default-concert.jpg';">
                  
                  <div class="position-absolute top-0 end-0 m-2 d-flex gap-1" style="z-index: 3;">
                    <% if (isPastEvent) { %>
                      <span class="rh-pill-past">Past</span>
                    <% } %>
                    <span class="rh-concert-price-pill <%= !concert.isPaid ? 'rh-pill-free' : '' %>">
                      <%= concert.isPaid ? (concert.price !== null && concert.price !== undefined ? `₹${concert.price}` : '₹ 0') : 'FREE' %>
                    </span>
                  </div>
                </div>

                <div class="rh-concert-card-body p-3 text-start">
                  <div class="rh-concert-meta-row mb-1">
                    <i class="bi bi-calendar3"></i>
                    <span><%= toISTDateString(concert.date) %> • <%= concert.time %></span>
                  </div>
                  
                  <h3 class="rh-concert-card-title mb-1 text-truncate w-100" title="<%= concert.title %>">
                    <a href="/concerts/<%= concert._id %>" class="text-decoration-none"><%= concert.title %></a>
                  </h3>

                  <div class="rh-concert-meta-row mb-2">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span class="text-truncate"><%= venueName %>, <%= concert.city %></span>
                  </div>

                  <div class="rh-concert-meta-row mb-3">
                    <i class="bi bi-person-fill"></i>
                    <span class="text-truncate">
                      <% if (concert.artist && concert.artist._id) { %>
                        By <a href="/artists/<%= concert.artist._id %>" class="rh-artist-link"><%= artistName %></a>
                      <% } else { %>
                        By <%= artistName %>
                      <% } %>
                    </span>
                  </div>

                  <div class="mt-auto">
                    <a href="/concerts/<%= concert._id %>" class="rh-btn-outline-pill w-100 text-center justify-content-center">
                      View Details &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-12 text-center py-5">
            <div class="rh-empty-state-card mx-auto" style="max-width: 520px;">
              <div class="rh-empty-state-icon mb-3">
                <div class="rh-calendar-box" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#9F190E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="3" ry="3"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                    <line x1="10" y1="14" x2="14" y2="18"></line>
                    <line x1="14" y1="14" x2="10" y2="18"></line>
                  </svg>
                </div>
              </div>
              <h3 class="rh-empty-state-title mb-2">No Concerts Found</h3>
              <p class="rh-empty-state-desc text-muted mb-4">There are no concerts matching your search or active filters.</p>
              <a href="/concerts" class="rh-btn-crimson-solid px-4">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </section>
</div>

<!-- Client-side Interactive Functionality -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('concertFilterForm');
  const searchInput = document.getElementById('searchInput');
  const searchClearBtn = document.getElementById('searchClearBtn');
  const dateFilter = document.getElementById('dateFilter');
  const dateClearBtn = document.getElementById('dateClearBtn');
  const cityInput = document.getElementById('cityInput');
  const typeInput = document.getElementById('typeInput');
  const sortInput = document.getElementById('sortInput');

  // 1. Custom Dropdowns Controller
  const customDropdowns = document.querySelectorAll('.rh-custom-dropdown');

  function closeAllDropdowns(except) {
    customDropdowns.forEach(dd => {
      if (dd !== except) {
        dd.classList.remove('open');
        const btn = dd.querySelector('.rh-custom-dropdown-btn');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  customDropdowns.forEach(dropdown => {
    const btn = dropdown.querySelector('.rh-custom-dropdown-btn');
    const label = dropdown.querySelector('.rh-dropdown-label');
    const menu = dropdown.querySelector('.rh-custom-dropdown-menu');
    const options = dropdown.querySelectorAll('.rh-dropdown-option');
    const fieldName = dropdown.dataset.name;
    const targetInput = document.getElementById(fieldName + 'Input');

    if (!btn || !menu) return;

    // Toggle dropdown
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = dropdown.classList.contains('open');
      closeAllDropdowns(dropdown);
      if (!isOpen) {
        dropdown.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        // Focus selected option
        const selectedOpt = menu.querySelector('.rh-dropdown-option.selected') || options[0];
        if (selectedOpt) selectedOpt.focus();
      } else {
        dropdown.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    // Keyboard support for button
    btn.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        dropdown.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        const selectedOpt = menu.querySelector('.rh-dropdown-option.selected') || options[0];
        if (selectedOpt) selectedOpt.focus();
      }
    });

    // Option selection
    options.forEach(opt => {
      function selectThisOption() {
        const val = opt.dataset.value;
        const text = opt.querySelector('span') ? opt.querySelector('span').textContent.trim() : opt.textContent.trim();

        // Update active UI
        options.forEach(o => {
          o.classList.remove('selected');
          o.setAttribute('aria-selected', 'false');
        });
        opt.classList.add('selected');
        opt.setAttribute('aria-selected', 'true');

        if (label) label.textContent = text;
        if (targetInput) targetInput.value = val;

        dropdown.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();

        // Submit form on filter change
        if (form) form.submit();
      }

      opt.addEventListener('click', function(e) {
        e.stopPropagation();
        selectThisOption();
      });

      opt.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectThisOption();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          const next = opt.nextElementSibling;
          if (next && next.classList.contains('rh-dropdown-option')) next.focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = opt.previousElementSibling;
          if (prev && prev.classList.contains('rh-dropdown-option')) prev.focus();
        } else if (e.key === 'Escape') {
          e.preventDefault();
          dropdown.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        }
      });
    });
  });

  // Close dropdowns on outside click or Escape
  document.addEventListener('click', function() {
    closeAllDropdowns(null);
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeAllDropdowns(null);
    }
  });

  // 2. Search Field Logic
  let searchTimeout;
  if (searchInput) {
    // Immediate search on Enter
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        clearTimeout(searchTimeout);
        if (form) form.submit();
      }
    });

    // Debounced search on input
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        if (form) form.submit();
      }, 700);
    });
  }

  // Clear search button
  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', function() {
      if (searchInput) searchInput.value = '';
      if (form) form.submit();
    });
  }

  // 3. Date Filter Logic
  if (dateFilter) {
    dateFilter.addEventListener('change', function() {
      if (form) form.submit();
    });
  }

  if (dateClearBtn) {
    dateClearBtn.addEventListener('click', function() {
      if (dateFilter) dateFilter.value = '';
      if (form) form.submit();
    });
  }

  // 4. Form Submission State
  if (form) {
    form.addEventListener('submit', function() {
      const submitBtn = document.getElementById('concertFilterSubmitBtn');
      if (submitBtn) {
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Searching...';
        submitBtn.disabled = true;
      }
    });
  }

  // 5. Toggle Filter Chevron Rotation & Collapse State
  const filterCollapse = document.getElementById('concertFilterCollapse');
  const filterToggleBtn = document.getElementById('filterToggleBtn');
  const filterToggleIcon = document.getElementById('filterToggleIcon');
  const filterToggleText = document.getElementById('filterToggleText');

  if (filterCollapse && filterToggleIcon) {
    // Ensure initial collapsed state
    if (!filterCollapse.classList.contains('show')) {
      filterToggleIcon.classList.remove('bi-chevron-up');
      filterToggleIcon.classList.add('bi-chevron-down');
      if (filterToggleText) filterToggleText.textContent = 'Show Filters';
      if (filterToggleBtn) {
        filterToggleBtn.setAttribute('aria-expanded', 'false');
        filterToggleBtn.classList.add('collapsed');
      }
    }

    // Bootstrap collapse events
    filterCollapse.addEventListener('show.bs.collapse', function() {
      filterToggleIcon.classList.remove('bi-chevron-down');
      filterToggleIcon.classList.add('bi-chevron-up');
      if (filterToggleText) filterToggleText.textContent = 'Hide Filters';
      if (filterToggleBtn) {
        filterToggleBtn.setAttribute('aria-expanded', 'true');
        filterToggleBtn.classList.remove('collapsed');
      }
    });

    filterCollapse.addEventListener('hide.bs.collapse', function() {
      filterToggleIcon.classList.remove('bi-chevron-up');
      filterToggleIcon.classList.add('bi-chevron-down');
      if (filterToggleText) filterToggleText.textContent = 'Show Filters';
      if (filterToggleBtn) {
        filterToggleBtn.setAttribute('aria-expanded', 'false');
        filterToggleBtn.classList.add('collapsed');
      }
    });

    // Fallback click listener in case Bootstrap bundle is unavailable
    if (filterToggleBtn) {
      filterToggleBtn.addEventListener('click', function(e) {
        if (typeof bootstrap === 'undefined' || !bootstrap.Collapse) {
          e.preventDefault();
          const isCurrentlyOpen = filterCollapse.classList.contains('show');
          if (isCurrentlyOpen) {
            filterCollapse.classList.remove('show');
            filterCollapse.style.display = 'none';
            filterToggleIcon.classList.remove('bi-chevron-up');
            filterToggleIcon.classList.add('bi-chevron-down');
            if (filterToggleText) filterToggleText.textContent = 'Show Filters';
            filterToggleBtn.setAttribute('aria-expanded', 'false');
            filterToggleBtn.classList.add('collapsed');
          } else {
            filterCollapse.classList.add('show');
            filterCollapse.style.display = 'block';
            filterToggleIcon.classList.remove('bi-chevron-down');
            filterToggleIcon.classList.add('bi-chevron-up');
            if (filterToggleText) filterToggleText.textContent = 'Hide Filters';
            filterToggleBtn.setAttribute('aria-expanded', 'true');
            filterToggleBtn.classList.remove('collapsed');
          }
        }
      });
    }
  }

  // 6. Highlight Search Terms in Results
  const searchTerm = '<%= (filters && filters.search) ? filters.search.replace(/"/g, "\\\"") : "" %>';
  if (searchTerm && searchTerm.trim()) {
    highlightTerms(searchTerm.trim());
  }

  function highlightTerms(term) {
    try {
      const safeRegex = new RegExp(`(${term.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')})`, 'gi');
      const cards = document.querySelectorAll('.rh-concert-card');

      cards.forEach(card => {
        const titleLink = card.querySelector('.rh-concert-card-title a');
        const venueSpan = card.querySelector('.rh-concert-meta-row:nth-of-type(2) span');

        if (titleLink && !titleLink.querySelector('.rh-highlight-mark')) {
          const original = titleLink.textContent;
          if (safeRegex.test(original)) {
            titleLink.innerHTML = original.replace(safeRegex, '<mark class="rh-highlight-mark">$1</mark>');
          }
        }
        if (venueSpan && !venueSpan.querySelector('.rh-highlight-mark')) {
          const original = venueSpan.textContent;
          if (safeRegex.test(original)) {
            venueSpan.innerHTML = original.replace(safeRegex, '<mark class="rh-highlight-mark">$1</mark>');
          }
        }
      });
    } catch (e) {
      console.warn('Highlight regex error:', e);
    }
  }
});
</script>
