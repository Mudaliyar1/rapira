<%- include('../partials/artist-header') %>

<style>
  .venue-tap-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(13, 202, 240, 0.2);
    border-color: rgba(13, 202, 240, 0.5) !important;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(13, 202, 240, 0.3);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(13, 202, 240, 0.5);
  }

  .selection-feedback {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: #0dcaf0;
    color: #000;
    padding: 12px 24px;
    border-radius: 50px;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(13, 202, 240, 0.3);
    backdrop-filter: blur(5px);
    z-index: 9999;
    transform: translateY(100px);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    opacity: 0;
  }
  .selection-feedback.show {
    transform: translateY(0);
    opacity: 1;
  }
  
  .venue-filter-card {
    transition: all 0.3s ease;
    border-style: dashed !important;
  }

  .venue-filter-card:hover {
    background-color: rgba(13, 202, 240, 0.05) !important;
    border-style: solid !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(13, 202, 240, 0.1);
  }
</style>

<!-- Concert Edit Status Check -->
<% if (concert.status === 'approved') { %>
  <!-- Edit Request Form for Approved Concerts -->
  <div class="card border-warning">
    <div class="card-header bg-warning text-dark">
      <h5 class="card-title mb-0">
        <i class="bi bi-lock"></i> Request Concert Edit
      </h5>
      <p class="mb-0 small">This concert has been approved. Any changes require admin approval.</p>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <h6><i class="bi bi-info-circle"></i> Current Concert Details:</h6>
        <div class="row">
          <div class="col-md-6">
            <p><strong>Title:</strong> <%= concert.title %></p>
            <p><strong>Date:</strong> <%= toISTDateString(concert.date) %></p>
            <p><strong>Time:</strong> <%= concert.time %></p>
            <p><strong>Venue:</strong> <%= concert.venue ? concert.venue.name : 'N/A' %></p>
          </div>
          <div class="col-md-6">
            <p><strong>City:</strong> <%= concert.city %></p>
            <p><strong>Price:</strong> ₹<%= concert.price %></p>
            <p><strong>Max Tickets:</strong> <%= concert.maxTickets || 'Unlimited' %></p>
            <p><strong>Status:</strong> <span class="badge bg-success">Approved</span></p>
          </div>
        </div>
      </div>

      <form action="/concerts/<%= concert._id %>/request-edit" method="POST" enctype="multipart/form-data">
        <h6 class="text-primary">Requested Changes:</h6>
        
        <div class="row g-4">
          <div class="col-md-6">
            <div class="mb-3">
              <label for="title" class="form-label">Concert Title</label>
              <input type="text" class="form-control" id="title" name="title" value="<%= concert.title %>">
              <div class="form-text">Leave unchanged if you don't want to modify</div>
            </div>

            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" id="description" name="description" rows="3"><%= concert.description %></textarea>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="date" class="form-label">Date</label>
                  <input type="date" class="form-control" id="date" name="date" value="<%= concert.date.toISOString().split('T')[0] %>">
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="time" class="form-label">Time</label>
                  <input type="time" class="form-control" id="time" name="time" value="<%= concert.time %>">
                </div>
              </div>
            </div>

            <!-- Venue: LOCKED - cannot be changed -->
            <div class="mb-3">
              <label class="form-label d-flex align-items-center gap-2">
                <i class="bi bi-lock-fill text-warning"></i> Venue
                <span class="badge bg-warning text-dark" style="font-size:0.65rem;">Cannot be changed</span>
              </label>
              <input type="text" class="form-control bg-dark text-white border-warning opacity-75"
                     value="<%= concert.venue ? concert.venue.name + ' — ' + concert.venue.city + (concert.venue.state ? ', ' + concert.venue.state : '') : 'Unknown Venue' %>"
                     readonly disabled>
              <input type="hidden" name="venue" value="<%= concert.venue ? concert.venue._id : '' %>">
              <input type="hidden" id="req_venueId" value="<%= concert.venue ? concert.venue._id : '' %>">
              <input type="hidden" id="req_bookingHours" value="<%= concert.venueBooking && concert.venueBooking.bookingHours ? concert.venueBooking.bookingHours : '2' %>">
            </div>

            <!-- Auto Availability Check -->
            <div id="availabilityCard_request" class="card border-warning mb-3" style="background: rgba(255,193,7,0.05); display: none;">
              <div class="card-header bg-warning text-dark py-2">
                <h6 class="mb-0 small fw-bold"><i class="bi bi-calendar-check me-1"></i> Venue Availability</h6>
              </div>
              <div class="card-body p-2" id="availabilityResults_request">
                <div class="text-center text-muted small">
                  <i class="bi bi-hourglass-split me-1"></i> Checking...
                </div>
              </div>
            </div>
          </div>

        <div class="col-md-6">
            <div class="mb-3">
              <label for="posterImage" class="form-label">New Poster Image</label>
              <input type="file" class="form-control" id="posterImage" name="posterImage">
              <div class="form-text">Upload only if you want to change the poster</div>
            </div>

            <div class="mb-3">
              <label for="price" class="form-label">Ticket Price (₹)</label>
              <input type="number" class="form-control" id="price" name="price" min="1" value="<%= concert.price %>">
            </div>

            <div class="mb-3">
              <label for="maxTickets" class="form-label">Max Tickets</label>
              <input type="number" class="form-control" id="maxTickets" name="maxTickets" min="0" value="<%= concert.maxTickets %>">
              <div class="form-text" id="capacityInfo">
                Current venue capacity: <%= concert.venue && concert.venue.capacity ? concert.venue.capacity : 'Unlimited' %>
              </div>
            </div>

            <div class="mb-3">
              <label for="city" class="form-label">City</label>
              <input type="text" class="form-control" id="city" name="city" value="<%= concert.city %>" readonly>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label for="reason" class="form-label">Reason for Edit Request <span class="text-danger">*</span></label>
          <textarea class="form-control" id="reason" name="reason" rows="3" required placeholder="Please explain why you need to make these changes..."></textarea>
          <div class="form-text">This will help admin understand your request better</div>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/artists/dashboard" class="btn btn-outline-secondary">Cancel</a>
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-send"></i> Request Changes
          </button>
        </div>
      </form>
    </div>
  </div>

<% } else { %>
  <!-- Normal Edit Form for Non-Approved Concerts -->
  <div class="card">
    <div class="card-body p-4">
      <form action="/concerts/<%= concert._id %>/edit" method="POST" enctype="multipart/form-data">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="title" class="form-label">Concert Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="title" name="title" value="<%= concert.title %>" required>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description <span class="text-danger">*</span></label>
            <textarea class="form-control" id="description" name="description" rows="4" required><%= concert.description %></textarea>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="date" class="form-label">Date <span class="text-danger">*</span></label>
                <input type="date" class="form-control" id="date" name="date" value="<%= concert.date.toISOString().split('T')[0] %>" required>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="time" class="form-label">Time <span class="text-danger">*</span></label>
                <input type="time" class="form-control" id="time" name="time" value="<%= concert.time %>" required>
              </div>
            </div>
          </div>

          <div class="card mb-3 bg-dark border-info bg-opacity-25 venue-filter-card">
            <div class="card-body p-3">
              <h6 class="mb-3 text-info d-flex align-items-center">
                <i class="bi bi-funnel me-2"></i> Filter Venues
                <span class="ms-auto badge bg-info text-dark" id="venueCountBadge">0 venues</span>
              </h6>
              <div class="row g-2">
                <div class="col-md-4">
                  <label class="form-label small mb-1 text-info opacity-75">State</label>
                  <select class="form-select form-select-sm bg-dark text-white border-info opacity-75" id="stateFilter">
                    <option value="">All States</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label small mb-1 text-info opacity-75">City</label>
                  <select class="form-select form-select-sm bg-dark text-white border-info opacity-75" id="cityFilter">
                    <option value="">All Cities</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label small mb-1 text-info opacity-75">Budget</label>
                  <select class="form-select form-select-sm bg-dark text-white border-info opacity-75" id="budgetFilter">
                    <option value="">All Budgets</option>
                    <option value="Budget">Budget (< ₹1k/hr)</option>
                    <option value="Mid-Range">Mid-Range (₹1k-5k/hr)</option>
                    <option value="Premium">Premium (₹5k-15k/hr)</option>
                    <option value="Luxury">Luxury (> ₹15k/hr)</option>
                  </select>
                </div>
              </div>
              <div class="mt-2 text-end">
                <button type="button" class="btn btn-link btn-sm text-info p-0 text-decoration-none" id="resetFilters">
                  <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label d-flex justify-content-between align-items-center">
              <span>Select Venue <span class="text-danger">*</span></span>
              <small class="text-info opacity-75" id="venueSearchStatus_normal">Filter to find venues</small>
            </label>
            <select class="form-control d-none" id="venue" name="venue" required>
              <option value="">Select a venue</option>
              <% if (venues && venues.length > 0) { %>
                <% venues.forEach(venue => { %>
                  <option value="<%= venue._id %>" 
                          data-city="<%= venue.city %>"
                          data-state="<%= venue.state %>"
                          data-city-full="<%= venue.city %>, <%= venue.state %>"
                          data-price-range="<%= venue.priceRange || 'Mid-Range' %>"
                          data-hourly-rates='<%- JSON.stringify(venue.pricing && venue.pricing.hourlyRates ? venue.pricing.hourlyRates : []) %>'
                          data-minimum-hours="<%= venue.pricing && venue.pricing.minimumHours ? venue.pricing.minimumHours : 1 %>"
                          data-min-ticket-price="<%= venue.pricing && venue.pricing.ticketPricing && venue.pricing.ticketPricing.minimumPrice ? venue.pricing.ticketPricing.minimumPrice : 0 %>"
                          data-suggested-ticket-price="<%= venue.pricing && venue.pricing.ticketPricing && venue.pricing.ticketPricing.suggestedPrice ? venue.pricing.ticketPricing.suggestedPrice : 100 %>"
                          data-venue-name="<%= venue.name %>"
                          data-venue-type="<%= venue.venueType || 'Not specified' %>"
                          data-capacity="<%= venue.capacity || 'Unlimited' %>"
                          data-facilities='<%- JSON.stringify(venue.facilities || []) %>'
                          data-address="<%= venue.address %>"
                          data-description="<%= venue.description || '' %>"
                          <%= concert.venue && concert.venue._id && concert.venue._id.toString() === venue._id.toString() ? 'selected' : '' %>>
                    <%= venue.name %>
                  </option>
                <% }); %>
              <% } %>
            </select>
            
            <div id="venueSelectionList_normal" class="venue-cards-container custom-scrollbar mb-2" style="max-height: 300px; overflow-y: auto;">
              <!-- Venue cards will be injected here via JS -->
            </div>
            <div class="form-text">Tap on a venue card above to select it</div>

            <!-- Auto Availability Check for Normal Edit -->
            <div id="availabilityCard_normal" class="card border-info mt-2 mb-3" style="display:none; background: rgba(0,0,0,0.2);">
              <div class="card-header bg-info text-white py-2">
                <h6 class="mb-0 small fw-bold"><i class="bi bi-calendar-check me-1"></i> Venue Availability</h6>
              </div>
              <div class="card-body p-2" id="availabilityResults_normal">
                <div class="text-center text-muted small">
                  <i class="bi bi-hourglass-split me-1"></i> Checking...
                </div>
              </div>
            </div>
          </div>

          <!-- Venue Pricing Information -->
          <div id="venuePricing" class="mb-3 d-none">
            <div class="card border-info">
              <div class="card-header bg-info text-white">
                <h6 class="mb-0">Venue Pricing</h6>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-4">
                    <strong style="color: #ffffff !important;">Available Rate:</strong> <span style="color: #ffffff !important;">₹</span><span id="displayHourlyRate">0</span>
                  </div>
                  <div class="col-md-4">
                    <strong style="color: #ffffff !important;">Duration:</strong> <span id="displayMinHours">1</span> <span style="color: #ffffff !important;">hour(s)</span>
                  </div>
                  <div class="col-md-4">
                    <strong style="color: #ffffff !important;">Total Cost:</strong> <span style="color: #ffffff !important;">₹</span><span id="displayBaseCost">0</span>
                  </div>
                </div>
                <div class="row mt-2">
                  <div class="col-md-6">
                    <label for="bookingHours" class="form-label">Booking Duration (Hours) <span class="text-danger">*</span></label>
                    <select class="form-control" id="bookingHours" name="bookingHours">
                      <option value="">Select hours</option>
                    </select>
                    <div class="form-text">
                      <i class="bi bi-info-circle"></i> Only hours with defined rates are available
                      <br><small class="text-muted">Contact admin to request additional booking durations</small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Total Venue Cost</label>
                    <div class="form-control-plaintext bg-light p-2 rounded border">
                      <strong style="color: #000000 !important;">₹<span id="totalVenueCost" style="color: #000000 !important;">0</span></strong>
                      <br><small style="color: #000000 !important;">For reference only</small>
                    </div>
                  </div>
                </div>
                
                <!-- Pricing Explanation -->
                <div class="row mt-3">
                  <div class="col-12">
                    <div class="alert alert-info py-2" style="color: #000000 !important;">
                      <small style="color: #000000 !important;">
                        <i class="bi bi-lightbulb" style="color: #000000 !important;"></i> 
                        <strong style="color: #000000 !important;">Pricing Note:</strong> The venue rates shown are configured by the admin. 
                        Changes to venue pricing require admin approval.
                      </small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Venue Details Section -->
          <div id="venueDetailsSection" style="display: none;" class="mb-4">
            <div class="card border-info">
              <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-building"></i> Venue Details</h6>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <h6 id="selectedVenueName" class="text-primary"></h6>
                    <p class="mb-2"><strong>Type:</strong> <span id="selectedVenueType"></span></p>
                    <p class="mb-2"><strong>Capacity:</strong> <span id="selectedVenueCapacity"></span></p>
                    <p class="mb-2"><strong>Address:</strong> <span id="selectedVenueAddress"></span></p>
                    <p class="mb-0"><strong>Description:</strong> <span id="selectedVenueDescription"></span></p>
                  </div>
                  <div class="col-md-6">
                    <h6 class="text-success">Available Facilities</h6>
                    <div id="selectedVenueFacilities" class="d-flex flex-wrap gap-1">
                      <!-- Facilities will be populated here -->
                    </div>
                    
                    <div class="mt-3">
                      <h6 class="text-warning">Commission Details</h6>
                      <p class="mb-1"><strong>Commission for Selected Hours:</strong> <span id="adminCommissionPercentage">0</span>%</p>
                      <p class="mb-0"><strong>Commission Amount:</strong> ₹<span id="calculatedCommission">0</span></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="city" class="form-label">City <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="city" name="city" value="<%= concert.city %>" readonly required>
            <div class="form-text">City is automatically set based on selected venue</div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="mb-3">
            <label for="posterImage" class="form-label">Poster Image</label>
            <input type="file" class="form-control" id="posterImage" name="posterImage">
            <div class="form-text">Recommended size: 800x1200px. JPG, PNG, GIF (max 5MB)</div>

            <% if (concert.posterImage) { %>
              <div class="mt-2">
                <p class="mb-1">Current poster:</p>
                <img src="<%= concert.posterImage %>" alt="Current poster" class="img-fluid rounded" style="max-height: 150px;">
              </div>
            <% } %>
          </div>

          <!-- Ticket Pricing (Always Required - No Free Concert Option) -->
          <div id="paidOptions" class="mb-3">
            <div class="row">
              <div class="col-md-6">
                <label for="price" class="form-label">Ticket Price (₹) <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="price" name="price" min="1" step="1" value="<%= concert.price %>" required>
                <div class="form-text">
                  Minimum: ₹<span id="minTicketPrice">0</span> | 
                  Suggested: ₹<span id="suggestedTicketPrice">100</span>
                </div>
              </div>
              <div class="col-md-6">
                <label for="maxTickets" class="form-label">Max Tickets</label>
                <input type="number" class="form-control" id="maxTickets" name="maxTickets" min="0" value="<%= concert.maxTickets %>">
                <div class="form-text">Leave at 0 for unlimited tickets</div>
                <div class="form-text text-info" id="venueCapacityInfo" style="display: none;">
                  <i class="bi bi-info-circle"></i> Venue capacity: <span id="venueCapacityValue">0</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Hidden field to always mark as paid -->
          <input type="hidden" id="isPaid" name="isPaid" value="on">
          
          <!-- Hidden field for current booking hours -->
          <input type="hidden" id="currentBookingHours" value="<%= concert.venueBooking && concert.venueBooking.bookingHours ? concert.venueBooking.bookingHours : '' %>">

          <div class="mb-3 mt-4">
            <div class="card" style="background-color: #000000 !important; border: 1px solid #dee2e6 !important;">
              <div class="card-body">
                <h6 class="card-title" style="color: #ffffff !important;">Status: <span class="badge bg-<%= concert.status === 'pending' ? 'warning' : concert.status === 'rejected' ? 'danger' : 'success' %>"><%= concert.status.charAt(0).toUpperCase() + concert.status.slice(1) %></span></h6>
                <% if (concert.status === 'rejected' && concert.rejectionReason) { %>
                  <p class="mb-2 small" style="color: #ffffff !important;">Rejection reason: <%= concert.rejectionReason %></p>
                <% } %>
                <p class="mb-0 small" style="color: #ffffff !important;">Your changes will be reviewed again before the concert is published.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12">
          <hr>
          <div class="d-flex justify-content-end gap-2">
            <a href="/artists/dashboard" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i> Save Changes
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
  // Concert data for initialization - will be set in DOM ready function
  var currentConcertBookingHours;
  var CURRENT_CONCERT_ID = '<%= concert._id %>';
  
  // Set minimum date to today and initialize
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize concert booking hours from server data (set via hidden element)
    const bookingHoursElement = document.getElementById('currentBookingHours');
    currentConcertBookingHours = bookingHoursElement ? parseInt(bookingHoursElement.value) || null : null;
    console.log('Current concert booking hours:', currentConcertBookingHours);
    
    // Set minimum date to today
    const today = new Date().toISOString().split('T')[0];
    const dateInput = document.getElementById('date');
    if (dateInput) {
      dateInput.min = today;
    }

    // Check if this is an approved concert (edit request form)
    const isApprovedConcert = document.querySelector('.card-header.bg-warning') !== null;
    
    if (isApprovedConcert) {
      // Handle edit request form for approved concerts
      handleApprovedConcertForm();
    } else {
      // Handle normal edit form for non-approved concerts
      handleNormalEditForm();
    }
  });

  function handleApprovedConcertForm() {
    // Venue is LOCKED — only date/time can change.
    const venueId = (document.getElementById('req_venueId') || {}).value;
    const bookingHoursVal = (document.getElementById('req_bookingHours') || {}).value || '2';
    const dateInput = document.querySelector('form[action*="request-edit"] input[name="date"]');
    const timeInput = document.querySelector('form[action*="request-edit"] input[name="time"]');
    const availCard = document.getElementById('availabilityCard_request');
    const resultsDiv = document.getElementById('availabilityResults_request');
    const requestForm = document.querySelector('form[action*="request-edit"]');

    let isAvailable = null; // null = not checked yet, true = available, false = not available

    let debounceTimer;
    async function autoCheckAvailability() {
      if (!venueId || !dateInput || !dateInput.value || !timeInput || !timeInput.value) return;
      isAvailable = null; // reset while checking
      if (availCard) { availCard.style.display = 'block'; availCard.className = 'card border-warning mb-3'; }
      if (resultsDiv) resultsDiv.innerHTML = '<div class="text-center text-muted small"><span class="spinner-border spinner-border-sm text-warning"></span> Checking availability...</div>';
      try {
        const res = await fetch('/venue-availability/check-availability', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ venueId, date: dateInput.value, startTime: timeInput.value, duration: parseInt(bookingHoursVal) || 2, concertId: CURRENT_CONCERT_ID })
        });
        const data = await res.json();
        if (data.success) {
          if (data.available) {
            isAvailable = true;
            if (availCard) availCard.className = 'card border-success mt-2 mb-3';
            if (resultsDiv) resultsDiv.innerHTML = `<div class="alert alert-success p-2 mb-0 small"><i class="bi bi-check-circle-fill"></i> <strong>Available!</strong> ${data.requestedSlot.startTime} – ${data.requestedSlot.endTime}</div>`;
          } else {
            isAvailable = false;
            if (availCard) availCard.className = 'card border-danger mt-2 mb-3';
            let suggestionsHtml = '';
            if (data.suggestions && data.suggestions.length > 0) {
              suggestionsHtml = `<div class="mt-2 pt-2 border-top border-danger">
                <small class="fw-bold text-warning"><i class="bi bi-lightbulb-fill me-1"></i>Suggested free slots (click to select):</small>
                <div class="mt-1">` +
                data.suggestions.slice(0, 5).map(s =>
                  `<span class="badge bg-secondary me-1 mb-1" style="font-size:0.7rem;cursor:pointer;"
                    onclick="(function(){var d=document.querySelector('form[action*=\\'request-edit\\'] input[name=\\'date\\']');var t=document.querySelector('form[action*=\\'request-edit\\'] input[name=\\'time\\']');if(d)d.value='${s.date}';if(t)t.value='${s.startTime}';if(d)d.dispatchEvent(new Event('change'));})()">
                    <i class="bi bi-calendar2-check me-1"></i>${s.date} at ${s.startTime}</span>`
                ).join('') +
                `</div></div>`;
            }
            if (resultsDiv) resultsDiv.innerHTML = `<div class="alert alert-danger p-2 mb-0 small"><i class="bi bi-x-circle-fill"></i> <strong>Not Available.</strong> Conflicts with ${data.conflicts.length} booking(s). Try a different time.${suggestionsHtml}</div>`;
          }
        } else {
          isAvailable = null;
          if (resultsDiv) resultsDiv.innerHTML = `<div class="alert alert-danger p-2 mb-0 small">Error: ${data.message}</div>`;
        }
      } catch(e) {
        isAvailable = null;
        if (resultsDiv) resultsDiv.innerHTML = '<div class="alert alert-danger p-2 mb-0 small">Network error.</div>';
      }
    }

    function debounceCheck() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(autoCheckAvailability, 600);
    }

    if (dateInput) dateInput.addEventListener('change', debounceCheck);
    if (timeInput) timeInput.addEventListener('change', debounceCheck);

    // Block submission if venue is not available
    if (requestForm) {
      requestForm.addEventListener('submit', function(e) {
        if (isAvailable === false) {
          e.preventDefault();
          if (availCard) availCard.className = 'card border-danger mt-2 mb-3';
          if (resultsDiv) resultsDiv.innerHTML = '<div class="alert alert-danger p-2 mb-0"><i class="bi bi-x-circle-fill"></i> <strong>Cannot submit!</strong> The venue is not available at the selected date &amp; time. Please choose a different date or time.</div>';
          availCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return false;
        }
        if (isAvailable === null && dateInput && dateInput.value && timeInput && timeInput.value) {
          e.preventDefault();
          if (availCard) { availCard.style.display = 'block'; availCard.className = 'card border-warning mt-2 mb-3'; }
          if (resultsDiv) resultsDiv.innerHTML = '<div class="alert alert-warning p-2 mb-0"><i class="bi bi-hourglass-split"></i> Please wait for availability check to complete before submitting.</div>';
          availCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          autoCheckAvailability();
          return false;
        }
      });
    }

    // Auto-check on load if all fields are present
    if (venueId && dateInput && dateInput.value && timeInput && timeInput.value) {
      if (availCard) availCard.style.display = 'block';
      setTimeout(autoCheckAvailability, 400);
    }
  }

  function handleNormalEditForm() {
    // Elements for normal edit form
    const venueSelect = document.getElementById('venue');
    const cityInput = document.getElementById('city');
    const bookingHours = document.getElementById('bookingHours');
    const ticketPriceInput = document.getElementById('price');
    const maxTicketsInput = document.getElementById('maxTickets');
    const minPriceSpan = document.getElementById('minTicketPrice');
    const suggestedPriceSpan = document.getElementById('suggestedTicketPrice');
    const venuePricing = document.getElementById('venuePricing');
    const displayHourlyRate = document.getElementById('displayHourlyRate');
    const displayMinHours = document.getElementById('displayMinHours');
    const displayBaseCost = document.getElementById('displayBaseCost');
    const totalVenueCost = document.getElementById('totalVenueCost');
    const venueCapacityInfo = document.getElementById('venueCapacityInfo');
    const venueCapacityValue = document.getElementById('venueCapacityValue');
    
    let hourlyRates = [];
    let currentVenueMinTicketPrice = 0;
    let selectedVenueHourlyCommission = {}; // Store commission data for selected hour
    let currentVenue = null;
    let currentVenueCapacity = 0;
    let currentVenueMinimumHours = 1; // Enforce venue-specific minimum hours

    // Initialize filters
    initVenueFilters(venueSelect);

    function updateVenuePricing() {
      const selectedOption = venueSelect.options[venueSelect.selectedIndex];
      
      if (selectedOption && selectedOption.value) {
        const city = selectedOption.dataset.city || '';
        const venueName = selectedOption.dataset.venueName || '';
        const venueType = selectedOption.dataset.venueType || '';
        const capacity = parseInt(selectedOption.dataset.capacity) || 0;
        const address = selectedOption.dataset.address || '';
        const description = selectedOption.dataset.description || '';
        const rates = selectedOption.dataset.hourlyRates;
        const minimumHours = parseInt(selectedOption.dataset.minimumHours) || 1;
        const minTicketPrice = parseFloat(selectedOption.dataset.minTicketPrice) || 0;
        const suggestedTicketPrice = parseFloat(selectedOption.dataset.suggestedTicketPrice) || 100;
        const facilities = selectedOption.dataset.facilities;
        
        // Store current venue data
        currentVenue = {
          id: selectedOption.value,
          name: venueName,
          capacity: capacity,
          pricing: {
            hourlyRates: []
          }
        };
        
        currentVenueCapacity = capacity;
        currentVenueMinimumHours = minimumHours;
        
        // Update venue capacity info and max tickets validation
        if (venueCapacityInfo && venueCapacityValue && maxTicketsInput) {
          if (capacity > 0) {
            venueCapacityValue.textContent = capacity;
            venueCapacityInfo.style.display = 'block';
            maxTicketsInput.max = capacity;
            
            // Validate current max tickets value
            if (parseInt(maxTicketsInput.value) > capacity) {
              maxTicketsInput.value = capacity;
            }
          } else {
            venueCapacityInfo.style.display = 'none';
            maxTicketsInput.removeAttribute('max');
          }
        }
        
        // Parse hourly rates
        try {
          const rawRates = rates ? JSON.parse(rates) : [];
          hourlyRates = [];
          
          // Handle new structure: array of objects with hours and rate
          if (rawRates.length > 0 && rawRates[0].hasOwnProperty('hours') && rawRates[0].hasOwnProperty('rate')) {
            currentVenue.pricing.hourlyRates = rawRates;
            
            // Create legacy array for backward compatibility
            rawRates.forEach(rateObj => {
              if (rateObj.hours && rateObj.rate) {
                hourlyRates[rateObj.hours - 1] = rateObj.rate;
              }
            });
          } else if (rawRates.length > 0) {
            // Legacy structure: simple array of rates
            hourlyRates = rawRates;
            
            // Convert to new structure
            rawRates.forEach((rate, index) => {
              if (rate && parseFloat(rate) > 0) {
                const hoursCount = index + 1;
                currentVenue.pricing.hourlyRates.push({
                  hours: hoursCount,
                  rate: parseFloat(rate)
                });
              }
            });
          }
          
        } catch (e) {
          console.error('Error parsing hourly rates:', e);
          hourlyRates = [];
          currentVenue.pricing.hourlyRates = [];
        }
        
        // Parse facilities
        let parsedFacilities = [];
        try {
          parsedFacilities = facilities ? JSON.parse(facilities) : [];
        } catch (e) {
          parsedFacilities = [];
        }
        
        // Set city
        if (cityInput) {
          cityInput.value = city;
        }
        
        // Update venue details section if elements exist
        const selectedVenueName = document.getElementById('selectedVenueName');
        const selectedVenueType = document.getElementById('selectedVenueType');
        const selectedVenueCapacity = document.getElementById('selectedVenueCapacity');
        const selectedVenueAddress = document.getElementById('selectedVenueAddress');
        const selectedVenueDescription = document.getElementById('selectedVenueDescription');
        
        if (selectedVenueName) selectedVenueName.textContent = venueName;
        if (selectedVenueType) selectedVenueType.textContent = venueType;
        if (selectedVenueCapacity) selectedVenueCapacity.textContent = capacity || 'Not specified';
        if (selectedVenueAddress) selectedVenueAddress.textContent = address;
        if (selectedVenueDescription) selectedVenueDescription.textContent = description || 'No description available';
        
        // Update facilities
        const facilitiesContainer = document.getElementById('selectedVenueFacilities');
        if (facilitiesContainer) {
          facilitiesContainer.innerHTML = '';
          if (parsedFacilities.length > 0) {
            parsedFacilities.forEach(facility => {
              const badge = document.createElement('span');
              badge.className = 'badge bg-success';
              badge.textContent = facility;
              facilitiesContainer.appendChild(badge);
            });
          } else {
            facilitiesContainer.innerHTML = '<span class="text-muted">No facilities listed</span>';
          }
        }
        
        // Update commission details - will be updated when hour is selected
        const adminCommissionPercentage = document.getElementById('adminCommissionPercentage');
        const calculatedCommission = document.getElementById('calculatedCommission');
        
        if (adminCommissionPercentage) adminCommissionPercentage.textContent = '0';
        if (calculatedCommission) calculatedCommission.textContent = '0';
        
        // Clear commission data since it depends on selected hours
        // Commission will be updated when booking hours are selected
        
        // Update ticket pricing information
        currentVenueMinTicketPrice = minTicketPrice;
        if (minPriceSpan) minPriceSpan.textContent = minTicketPrice;
        if (suggestedPriceSpan) suggestedPriceSpan.textContent = suggestedTicketPrice;
        
        // Set minimum ticket price validation
        if (ticketPriceInput) {
          ticketPriceInput.min = minTicketPrice;
          if (parseFloat(ticketPriceInput.value || 0) < minTicketPrice) {
            ticketPriceInput.value = minTicketPrice;
          }
        }
        
        // Populate booking hours dropdown
        if (bookingHours) {
          populateBookingHoursDropdown();
        }
        
        // Show venue pricing if rates available
        if (venuePricing && currentVenue.pricing.hourlyRates.length > 0) {
          const firstRateObj = currentVenue.pricing.hourlyRates[0];
          const firstHourRate = firstRateObj ? parseFloat(firstRateObj.rate) || 0 : 0;
          if (displayHourlyRate) displayHourlyRate.textContent = firstHourRate.toLocaleString('en-IN');
          if (displayMinHours) displayMinHours.textContent = minimumHours;
          
          venuePricing.classList.remove('d-none');
          calculateTotalCost();
        } else if (venuePricing) {
          venuePricing.classList.add('d-none');
        }
        
        // Show venue details
        const venueDetailsSection = document.getElementById('venueDetailsSection');
        if (venueDetailsSection) {
          venueDetailsSection.style.display = 'block';
        }
      } else {
        if (cityInput) cityInput.value = '';
        hourlyRates = [];
        currentVenueMinTicketPrice = 0;
        currentCommissionPercentage = 0;
        currentAdvanceAmount = 0;
        currentVenueCapacity = 0;
        if (minPriceSpan) minPriceSpan.textContent = '0';
        if (suggestedPriceSpan) suggestedPriceSpan.textContent = '100';
        if (venuePricing) venuePricing.classList.add('d-none');
        const venueDetailsSection = document.getElementById('venueDetailsSection');
        if (venueDetailsSection) venueDetailsSection.style.display = 'none';
        if (venueCapacityInfo) venueCapacityInfo.style.display = 'none';
        if (maxTicketsInput) maxTicketsInput.removeAttribute('max');
        
        // Clear booking hours dropdown
        if (bookingHours) {
          bookingHours.innerHTML = '<option value="">Select hours</option>';
        }
      }
    }

    function populateBookingHoursDropdown() {
      // Clear existing options
      if (bookingHours) {
        bookingHours.innerHTML = '<option value="">Select hours</option>';
        
        if (currentVenue && currentVenue.pricing && currentVenue.pricing.hourlyRates && currentVenue.pricing.hourlyRates.length > 0) {
          // Sort rates by hour count and enforce venue minimum hours
          const sortedRates = [...currentVenue.pricing.hourlyRates].sort((a, b) => a.hours - b.hours);
          const filteredRates = sortedRates.filter(rateObj => rateObj.hours >= currentVenueMinimumHours);
          
          let validOptionsCount = 0;
          
          // Add options for each available hour rate WITH commission
          filteredRates.forEach(rateObj => {
            // Only add if has rate, commission percentage, and commission amount
            if (rateObj.hours && rateObj.rate && parseFloat(rateObj.rate) > 0 &&
                rateObj.commissionPercentage !== undefined && rateObj.commissionPercentage >= 0) {
              const option = document.createElement('option');
              option.value = rateObj.hours;
              option.textContent = `${rateObj.hours} Hour${rateObj.hours > 1 ? 's' : ''} - ₹${parseFloat(rateObj.rate).toLocaleString('en-IN')}`;
              option.dataset.rate = rateObj.rate;
              option.dataset.commissionPercentage = rateObj.commissionPercentage;
              option.dataset.commissionAmount = rateObj.commissionAmount || 0;
              bookingHours.appendChild(option);
              validOptionsCount++;
            }
          });
          
          // Auto-select first available option
          if (filteredRates.length > 0 && validOptionsCount > 0) {
            bookingHours.value = filteredRates[0].hours;
            calculateTotalCost();
          }
        } else {
          // Add informational option for no rates
          const noRatesOption = document.createElement('option');
          noRatesOption.disabled = true;
          noRatesOption.textContent = filteredRates && filteredRates.length === 0 && currentVenueMinimumHours > 1
            ? `No rates meet the minimum of ${currentVenueMinimumHours} hour(s) - contact admin`
            : 'No booking rates configured - Contact admin';
          noRatesOption.style.fontStyle = 'italic';
          noRatesOption.style.color = '#dc3545';
          bookingHours.appendChild(noRatesOption);
        }
      }
    }

    function calculateTotalCost() {
      let hours = parseInt(bookingHours ? bookingHours.value : 1) || 1;
      // Enforce venue minimum hours on selection
      if (hours < currentVenueMinimumHours && bookingHours) {
        const minOption = Array.from(bookingHours.options).find(opt => parseInt(opt.value) >= currentVenueMinimumHours);
        if (minOption) {
          bookingHours.value = minOption.value;
          hours = parseInt(minOption.value);
        } else {
          hours = currentVenueMinimumHours;
        }
      }
      let totalCost = 0;
      let commissionPercentage = 0;
      let commissionAmount = 0;
      
      console.log('=== EDIT PAGE: CALCULATE TOTAL COST ===');
      console.log('Selected hours:', hours);
      
      // Get commission data from selected option
      if (bookingHours) {
        const selectedOption = bookingHours.options[bookingHours.selectedIndex];
        if (selectedOption && selectedOption.dataset.rate) {
          totalCost = parseFloat(selectedOption.dataset.rate) || 0;
          commissionPercentage = parseFloat(selectedOption.dataset.commissionPercentage) || 0;
          commissionAmount = parseFloat(selectedOption.dataset.commissionAmount) || 0;
          
          // Store commission data for this selection
          selectedVenueHourlyCommission = {
            hours: hours,
            rate: totalCost,
            commissionPercentage: commissionPercentage,
            commissionAmount: commissionAmount
          };
          
          console.log('Commission data from selected option:', selectedVenueHourlyCommission);
        }
      }
      
      // Update displays
      if (displayBaseCost) displayBaseCost.textContent = totalCost.toLocaleString('en-IN');
      if (totalVenueCost) totalVenueCost.textContent = totalCost.toLocaleString('en-IN');
      if (displayHourlyRate) displayHourlyRate.textContent = totalCost.toLocaleString('en-IN');
      
      // Update commission display
      const adminCommissionPercentage = document.getElementById('adminCommissionPercentage');
      const calculatedCommission = document.getElementById('calculatedCommission');
      if (adminCommissionPercentage) adminCommissionPercentage.textContent = commissionPercentage;
      if (calculatedCommission) calculatedCommission.textContent = commissionAmount.toLocaleString('en-IN');
      
      console.log('Updated displays with commission:', { commissionPercentage, commissionAmount });
    }

    // Ticket price validation
    function validateTicketPrice() {
      if (!ticketPriceInput) return true;
      
      const currentPrice = parseFloat(ticketPriceInput.value || 0);
      
      if (currentPrice < currentVenueMinTicketPrice) {
        ticketPriceInput.setCustomValidity(`Ticket price cannot be less than ₹${currentVenueMinTicketPrice} for this venue`);
        return false;
      } else {
        ticketPriceInput.setCustomValidity('');
        return true;
      }
    }

    // Max tickets validation based on venue capacity
    function validateMaxTickets() {
      if (!maxTicketsInput) return true;
      
      const maxTickets = parseInt(maxTicketsInput.value);
      if (currentVenueCapacity > 0 && maxTickets > currentVenueCapacity) {
        maxTicketsInput.setCustomValidity(`Cannot exceed venue capacity of ${currentVenueCapacity}`);
        return false;
      } else {
        maxTicketsInput.setCustomValidity('');
        return true;
      }
    }

    // Event listeners
    if (venueSelect) venueSelect.addEventListener('change', updateVenuePricing);
    if (bookingHours) bookingHours.addEventListener('change', calculateTotalCost);
    if (ticketPriceInput) ticketPriceInput.addEventListener('input', validateTicketPrice);
    if (maxTicketsInput) maxTicketsInput.addEventListener('input', validateMaxTickets);
    
    // Initialize if venue is pre-selected
    if (venueSelect && venueSelect.value) {
      updateVenuePricing();
      // Set the booking hours if we have a value
      if (currentConcertBookingHours && bookingHours) {
        setTimeout(() => {
          bookingHours.value = currentConcertBookingHours;
          calculateTotalCost();
        }, 100); // Small delay to ensure options are populated
      }
    }
  }

  function initVenueFilters(venueSelect) {
    const parentContainer = venueSelect.closest('.mb-3');
    const isRequestForm = venueSelect.id === 'venue' && !parentContainer.querySelector('#venueSelectionList_normal');
    
    // In edit-new.ejs, we have two sections. We need to find the correct filters.
    // The filters are actually outside the containers in the current HTML.
    
    const stateFilter = isRequestForm ? document.querySelectorAll('#stateFilter')[0] : document.querySelectorAll('#stateFilter')[1];
    const cityFilter = isRequestForm ? document.querySelectorAll('#cityFilter')[0] : document.querySelectorAll('#cityFilter')[1];
    const budgetFilter = isRequestForm ? document.querySelectorAll('#budgetFilter')[0] : document.querySelectorAll('#budgetFilter')[1];
    const resetFiltersBtn = isRequestForm ? document.querySelectorAll('#resetFilters')[0] : document.querySelectorAll('#resetFilters')[1];
    const venueCountBadge = isRequestForm ? document.querySelectorAll('#venueCountBadge')[0] : document.querySelectorAll('#venueCountBadge')[1];
    const venueSelectionList = isRequestForm ? document.getElementById('venueSelectionList_request') : document.getElementById('venueSelectionList_normal');
    
    if (!venueSelect || !stateFilter || !venueSelectionList) return;

    const venueOptions = Array.from(venueSelect.options).slice(1);

    function updateCityOptions() {
      const selectedState = stateFilter.value;
      const currentCity = cityFilter.value;
      cityFilter.innerHTML = '<option value="">All Cities</option>';
      
      const cities = new Set();
      venueOptions.forEach(opt => {
        if (!selectedState || opt.dataset.state === selectedState) {
          if (opt.dataset.city) cities.add(opt.dataset.city);
        }
      });

      Array.from(cities).sort().forEach(city => {
        const option = document.createElement('option');
        option.value = city;
        option.textContent = city;
        cityFilter.appendChild(option);
      });

      if (Array.from(cities).includes(currentCity)) {
        cityFilter.value = currentCity;
      }
    }

    function applyVenueFilters() {
      const selectedState = stateFilter.value;
      const selectedCity = cityFilter.value;
      const selectedBudget = budgetFilter.value;
      
      const filteredOptions = venueOptions.filter(opt => {
        const stateMatch = !selectedState || opt.dataset.state === selectedState;
        const cityMatch = !selectedCity || opt.dataset.city === selectedCity;
        const budgetMatch = !selectedBudget || opt.dataset.priceRange === selectedBudget;
        return stateMatch && cityMatch && budgetMatch;
      });

      renderVenueCards(filteredOptions);
      updateVenueCount(filteredOptions.length);
    }

    function renderVenueCards(options) {
      if (!venueSelectionList) return;
      venueSelectionList.innerHTML = '';
      if (options.length === 0) {
        venueSelectionList.innerHTML = '<div class="text-center p-4 opacity-50 bg-dark rounded border border-secondary border-opacity-25">No venues match filters</div>';
        return;
      }

      const grid = document.createElement('div');
      grid.className = 'row g-2 p-1';
      
      options.forEach(opt => {
        const isSelected = venueSelect.value === opt.value;
        const col = document.createElement('div');
        col.className = 'col-md-6';
        
        col.innerHTML = `
          <div class="card h-100 venue-tap-card ${isSelected ? 'border-info bg-info bg-opacity-10' : 'bg-dark border-secondary border-opacity-50'}" 
               data-venue-id="${opt.value}" style="cursor: pointer; transition: all 0.2s ease;">
            <div class="card-body p-2">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="fw-bold text-truncate" style="max-width: 120px;">${opt.dataset.venueName}</small>
                <span class="badge ${isSelected ? 'bg-info text-dark' : 'bg-secondary'} rounded-pill" style="font-size: 0.6rem;">
                  ${isSelected ? 'Selected' : opt.dataset.priceRange}
                </span>
              </div>
              <p style="font-size: 0.7rem;" class="text-muted mb-0">
                <i class="bi bi-geo-alt"></i> ${opt.dataset.cityFull} | Cap: ${opt.dataset.capacity}
              </p>
            </div>
          </div>
        `;

        col.querySelector('.venue-tap-card').addEventListener('click', function() {
          venueSelect.value = this.dataset.venueId;
          venueSelect.dispatchEvent(new Event('change'));
          applyVenueFilters();
          
          if (typeof showSelectionFeedback === 'function') {
            showSelectionFeedback(`Selected ${opt.dataset.venueName}`);
          }
        });

        grid.appendChild(col);
      });

      venueSelectionList.appendChild(grid);
    }

    function updateVenueCount(count) {
      if (venueCountBadge) {
        venueCountBadge.textContent = `${count} venue${count !== 1 ? 's' : ''}`;
        venueCountBadge.className = count > 0 ? 'ms-auto badge bg-info text-dark' : 'ms-auto badge bg-danger text-white';
      }
    }

    // Initialize States
    if (stateFilter) {
      const states = new Set();
      venueOptions.forEach(opt => {
        if (opt.dataset.state) states.add(opt.dataset.state);
      });

      Array.from(states).sort().forEach(state => {
        const option = document.createElement('option');
        option.value = state;
        option.textContent = state;
        stateFilter.appendChild(option);
      });

      stateFilter.addEventListener('change', () => {
        updateCityOptions();
        applyVenueFilters();
      });
    }

    if (cityFilter) cityFilter.addEventListener('change', applyVenueFilters);
    if (budgetFilter) budgetFilter.addEventListener('change', applyVenueFilters);

    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        stateFilter.value = '';
        updateCityOptions();
        budgetFilter.value = '';
        applyVenueFilters();
      });
    }

    // --- Auto Availability Check for normal edit ---
    const availCardNormal = document.getElementById('availabilityCard_normal');
    const availResultsNormal = document.getElementById('availabilityResults_normal');
    const editForm = venueSelect.closest('form');

    let availTimer;
    let isAvailableNormal = null; // null=not checked, true=available, false=unavailable

    async function autoCheckNormal() {
      if (!venueSelect.value) return;
      const dateEl = editForm ? editForm.querySelector('input[name="date"]') : null;
      const timeEl = editForm ? editForm.querySelector('input[name="time"]') : null;
      const hoursEl = editForm ? editForm.querySelector('select[name="bookingHours"]') : null;
      // Use booking hours dropdown value, OR fall back to existing concert booking hours
      const duration = (hoursEl && hoursEl.value) ? hoursEl.value : (currentConcertBookingHours || 2);
      if (!dateEl || !dateEl.value || !timeEl || !timeEl.value) return;

      isAvailableNormal = null;
      if (availCardNormal) { availCardNormal.style.display = 'block'; availCardNormal.className = 'card border-info mt-2 mb-3'; }
      if (availResultsNormal) availResultsNormal.innerHTML = '<div class="text-center text-muted small"><span class="spinner-border spinner-border-sm text-info"></span> Checking availability...</div>';
      try {
        const res = await fetch('/venue-availability/check-availability', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ venueId: venueSelect.value, date: dateEl.value, startTime: timeEl.value, duration: parseInt(duration), concertId: CURRENT_CONCERT_ID })
        });
        const data = await res.json();
        if (data.success) {
          if (data.available) {
            isAvailableNormal = true;
            if (availCardNormal) availCardNormal.className = 'card border-success mt-2 mb-3';
            if (availResultsNormal) availResultsNormal.innerHTML = `<div class="alert alert-success p-2 mb-0 small"><i class="bi bi-check-circle-fill"></i> <strong>Available!</strong> ${data.requestedSlot.startTime} – ${data.requestedSlot.endTime}</div>`;
          } else {
            isAvailableNormal = false;
            if (availCardNormal) availCardNormal.className = 'card border-danger mt-2 mb-3';
            let suggestionsHtml2 = '';
            if (data.suggestions && data.suggestions.length > 0) {
              suggestionsHtml2 = `<div class="mt-2 pt-2 border-top border-danger">
                <small class="fw-bold text-warning"><i class="bi bi-lightbulb-fill me-1"></i>Suggested free slots:</small>
                <div class="mt-1">` +
                data.suggestions.slice(0, 5).map(s => {
                  const formDateEl = editForm ? editForm.querySelector('input[name="date"]') : null;
                  const formTimeEl = editForm ? editForm.querySelector('input[name="time"]') : null;
                  return `<span class="badge bg-secondary me-1 mb-1" style="font-size:0.7rem;cursor:pointer;" onclick="${formDateEl ? '' : ''}document.getElementById('date') && (document.getElementById('date').value='${s.date}'); document.getElementById('time') && (document.getElementById('time').value='${s.startTime}'); debounceNormal();"><i class="bi bi-calendar2-check me-1"></i>${s.date} ${s.startTime}</span>`;
                }).join('') +
                `</div></div>`;
            }
            if (availResultsNormal) availResultsNormal.innerHTML = `<div class="alert alert-danger p-2 mb-0 small"><i class="bi bi-x-circle-fill"></i> <strong>Not Available.</strong> Conflicts with ${data.conflicts.length} booking(s).${suggestionsHtml2}</div>`;
          }
        } else {
          isAvailableNormal = null;
          if (availResultsNormal) availResultsNormal.innerHTML = `<div class="alert alert-danger p-2 mb-0 small">Error: ${data.message}</div>`;
        }
      } catch(e) {
        isAvailableNormal = null;
        if (availResultsNormal) availResultsNormal.innerHTML = '<div class="alert alert-danger p-2 mb-0 small">Network error.</div>';
      }
    }

    function debounceNormal() {
      clearTimeout(availTimer);
      availTimer = setTimeout(autoCheckNormal, 600);
    }

    // Trigger check when venue changes
    venueSelect.addEventListener('change', () => { if (venueSelect.value) debounceNormal(); });

    // Trigger check when date/time/hours change
    if (editForm) {
      const dateEl = editForm.querySelector('input[name="date"]');
      const timeEl = editForm.querySelector('input[name="time"]');
      const hoursEl = editForm.querySelector('select[name="bookingHours"]');
      if (dateEl) dateEl.addEventListener('change', debounceNormal);
      if (timeEl) timeEl.addEventListener('change', debounceNormal);
      if (hoursEl) hoursEl.addEventListener('change', debounceNormal);
    }

    // Block submission if venue is not available
    if (editForm) {
      editForm.addEventListener('submit', function(e) {
        if (!venueSelect.value) return; // no venue selected, allow normal form validation
        if (isAvailableNormal === false) {
          e.preventDefault();
          if (availCardNormal) availCardNormal.className = 'card border-danger mt-2 mb-3';
          if (availResultsNormal) availResultsNormal.innerHTML = '<div class="alert alert-danger p-2 mb-0"><i class="bi bi-x-circle-fill"></i> <strong>Cannot submit!</strong> The venue is not available at the selected date &amp; time. Please pick a different time.</div>';
          if (availCardNormal) availCardNormal.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return false;
        }
        if (isAvailableNormal === null && venueSelect.value) {
          e.preventDefault();
          if (availCardNormal) { availCardNormal.style.display = 'block'; availCardNormal.className = 'card border-warning mt-2 mb-3'; }
          if (availResultsNormal) availResultsNormal.innerHTML = '<div class="alert alert-warning p-2 mb-0"><i class="bi bi-hourglass-split"></i> Please wait for availability check to complete.</div>';
          if (availCardNormal) availCardNormal.scrollIntoView({ behavior: 'smooth', block: 'center' });
          autoCheckNormal();
          return false;
        }
      });
    }

    // Auto-check on page load if venue already selected
    if (venueSelect.value) {
      setTimeout(autoCheckNormal, 800); // slight delay so updateVenuePricing populates bookingHours first
    }

    updateCityOptions();
    applyVenueFilters();
  }

  function showSelectionFeedback(message) {
    const feedback = document.createElement('div');
    feedback.className = 'selection-feedback';
    feedback.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i> ${message}`;
    document.body.appendChild(feedback);
    setTimeout(() => feedback.classList.add('show'), 10);
    setTimeout(() => {
      feedback.classList.remove('show');
      setTimeout(() => feedback.remove(), 300);
    }, 3000);
  }
</script>

