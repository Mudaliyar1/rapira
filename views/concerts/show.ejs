<!-- Dynamic RAPIRA Editorial Stylesheet Activator -->
<svg width="0" height="0" style="position:absolute;visibility:hidden;" onload="
  document.documentElement.classList.add('rh-homepage-active');
  document.body.classList.add('rh-homepage-active');
  if (!document.getElementById('rapira-homepage-css')) {
    const l = document.createElement('link');
    l.id = 'rapira-homepage-css';
    l.rel = 'stylesheet';
    l.href = '/css/homepage.css';
    document.head.appendChild(l);
  }
"></svg>

<% 
  // Calculate display times
  let timeMatch = concert.time ? concert.time.match(/^(\d{1,2}):(\d{2})$/) : null;
  let displayTime = concert.time || 'TBA';
  let bookingHours = (concert.venueBooking && concert.venueBooking.bookingHours) ? concert.venueBooking.bookingHours : 1;
  let endDisplayTime = concert.time || 'TBA';

  if (timeMatch) {
    let hours = parseInt(timeMatch[1], 10);
    let minutes = timeMatch[2];
    let amPm = hours >= 12 ? 'PM' : 'AM';
    let hour12 = hours % 12;
    if (hour12 === 0) hour12 = 12;
    displayTime = `${hour12}:${minutes} ${amPm}`;

    let startHours = parseInt(timeMatch[1], 10);
    let endHours = startHours + bookingHours;
    let endAmPm = endHours >= 12 ? 'PM' : 'AM';
    let endHour12 = endHours % 12;
    if (endHour12 === 0) endHour12 = 12;
    
    if (endHours >= 24) {
      endHours = endHours - 24;
      endAmPm = endHours >= 12 ? 'PM' : 'AM';
      endHour12 = endHours % 12;
      if (endHour12 === 0) endHour12 = 12;
      endDisplayTime = `${endHour12}:${minutes} ${endAmPm} (+1 day)`;
    } else {
      endDisplayTime = `${endHour12}:${minutes} ${endAmPm}`;
    }
  }

  // Build Google Maps destination link
  let mapsUrl = '';
  if (concert.venue && concert.venue.googleMapsLink && concert.venue.googleMapsLink.trim().length > 0) {
    mapsUrl = concert.venue.googleMapsLink;
  } else {
    let venueQueryParts = [];
    if (concert.venue && concert.venue.name) venueQueryParts.push(concert.venue.name);
    if (concert.venue && concert.venue.address) venueQueryParts.push(concert.venue.address);
    if (concert.venue && concert.venue.city) venueQueryParts.push(concert.venue.city);
    if (concert.venue && concert.venue.state) venueQueryParts.push(concert.venue.state);
    if (concert.venue && concert.venue.pincode) venueQueryParts.push(concert.venue.pincode);
    if (venueQueryParts.length === 0) venueQueryParts.push(concert.city || 'India');
    mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venueQueryParts.join(', '))}`;
  }

  // Base share URL
  let siteBase = (typeof process !== 'undefined' && process.env && process.env.BASE_URL) ? process.env.BASE_URL : '';
  let shareConcertUrl = siteBase ? `${siteBase}/concerts/${concert._id}` : `https://rapira.live/concerts/${concert._id}`;
  let posterSrc = locals.getImageUrl ? getImageUrl(concert.posterImage, '/images/default-concert.jpg') : (concert.posterImage || '/images/default-concert.jpg');
%>

<div class="rapira-homepage rh-concert-detail-page">
  <!-- Breadcrumb Navigation Bar -->
  <div class="container mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <nav aria-label="breadcrumb" class="rh-concert-breadcrumb mb-0">
        <a href="/"><i class="bi bi-house-door-fill me-1"></i>Home</a>
        <span class="breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
        <a href="/concerts">Concerts</a>
        <span class="breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
        <span class="fw-semibold text-truncate" style="max-width: 280px; color: var(--rh-crimson);"><%= concert.title %></span>
      </nav>
      <a href="/concerts" class="rh-btn-crimson-outline btn-sm py-1 px-3">
        <i class="bi bi-arrow-left"></i> Back to Concerts
      </a>
    </div>
  </div>

  <!-- Concert Hero Card -->
  <div class="container mb-4">
    <div class="rh-concert-hero-card">
      <div class="row g-4 align-items-center">
        <!-- Poster Column -->
        <div class="col-lg-5">
          <div class="rh-concert-poster-frame">
            <!-- Ambient Blur Backdrop -->
            <div class="rh-concert-poster-blur" style="background-image: url('<%= posterSrc %>');"></div>
            <!-- Foreground Poster -->
            <img src="<%= posterSrc %>"
                 alt="<%= concert.title %>"
                 class="rh-concert-poster-img"
                 onerror="this.onerror=null; this.src='/images/default-concert.jpg';">
            <!-- Price Pill -->
            <div class="rh-concert-price-pill">
              <%= concert.isPaid ? (concert.price ? `₹${concert.price}` : '₹0') : 'FREE' %>
            </div>
          </div>
        </div>

        <!-- Info / Meta Column -->
        <div class="col-lg-7">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <span class="rh-concert-status-badge">
              <i class="bi bi-broadcast"></i> Live Concert Event
            </span>
            <% if (ticketsRemaining === 'Unlimited') { %>
              <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-check-circle-fill me-1"></i> Unlimited Tickets
              </span>
            <% } else if (ticketsRemaining > 0) { %>
              <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-ticket-perforated me-1"></i> <%= ticketsRemaining %> Tickets Left
              </span>
            <% } else { %>
              <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-x-circle-fill me-1"></i> Sold Out
              </span>
            <% } %>
          </div>

          <h1 class="rh-concert-title mb-3"><%= concert.title %></h1>

          <!-- Artist Credit Strip -->
          <div class="rh-concert-artist-strip">
            <% if (concert.artist && concert.artist.user) { %>
              <img src="<%= locals.getImageUrl ? getImageUrl(concert.artist.user.profileImage, '/images/default-profile.png') : (concert.artist.user.profileImage || '/images/default-profile.png') %>"
                   alt="<%= concert.artist.user.name || 'Artist' %>"
                   class="rh-concert-artist-avatar"
                   onerror="this.onerror=null; this.src='/images/default-profile.png';">
              <div>
                <div class="d-flex align-items-center gap-1">
                  <a href="/artists/<%= concert.artist._id %>" class="rh-concert-artist-name">
                    <%= concert.artist.user.name || 'Artist' %>
                  </a>
                  <% if (concert.artist.verified) { %>
                    <i class="bi bi-patch-check-fill text-primary" title="Verified Artist"></i>
                  <% } %>
                </div>
                <span class="rh-artist-genre-pill"><%= concert.artist.genre || 'Hip-Hop' %></span>
              </div>
            <% } else { %>
              <img src="/images/default-profile.png" alt="Artist" class="rh-concert-artist-avatar">
              <div>
                <span class="rh-concert-artist-name">Featured Artist</span>
                <span class="rh-artist-genre-pill">Musician</span>
              </div>
            <% } %>
          </div>

          <!-- Quick Summary Details -->
          <div class="row g-3 <%= currentUser ? 'mb-4' : 'mb-0' %>">
            <div class="col-sm-6">
              <div class="d-flex align-items-center gap-3">
                <div class="rh-info-icon-box">
                  <i class="bi bi-calendar3"></i>
                </div>
                <div>
                  <div class="rh-info-tile-label">Date</div>
                  <div class="rh-info-tile-value"><%= toISTDateString(concert.date) %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="d-flex align-items-center gap-3">
                <div class="rh-info-icon-box">
                  <i class="bi bi-clock"></i>
                </div>
                <div>
                  <div class="rh-info-tile-label">Showtime</div>
                  <div class="rh-info-tile-value"><%= displayTime %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-12">
              <div class="d-flex align-items-center gap-3">
                <div class="rh-info-icon-box">
                  <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                  <div class="rh-info-tile-label">Venue & City</div>
                  <div class="rh-info-tile-value">
                    <% if (concert.venue && concert.venue.name) { %>
                      <%= concert.venue.name %>, <%= concert.venue.city %>
                    <% } else { %>
                      <%= concert.city %>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Hero Action CTA (Only displayed for authenticated actions; duplicate guest auth buttons removed) -->
          <% if (currentUser) { %>
            <div class="pt-2">
              <% if (userTickets && userTickets.length > 0) { %>
                <div class="rh-concert-booking-actions">
                  <a href="/tickets/<%= userTickets[0]._id %>" class="rh-btn-crimson rh-concert-booking-btn rh-concert-btn-login">
                    <i class="bi bi-ticket-detailed-fill"></i> <span>View My Ticket</span>
                  </a>
                  <% if (ticketsRemaining !== 0 && ticketsRemaining !== 'Sold Out') { %>
                    <a href="/concerts/<%= concert._id %>/select-quantity" class="rh-btn-crimson-outline rh-concert-booking-btn rh-concert-btn-register">
                      <span>Book More Tickets</span>
                    </a>
                  <% } %>
                </div>
              <% } else if (new Date(concert.date) < new Date()) { %>
                <button class="rh-btn-crimson-outline rh-btn-lg opacity-75" disabled>
                  <i class="bi bi-calendar-x"></i> Concert Concluded
                </button>
              <% } else if (ticketsRemaining === 0 || ticketsRemaining === 'Sold Out') { %>
                <button class="rh-btn-crimson-outline rh-btn-lg opacity-75" disabled>
                  <i class="bi bi-x-circle"></i> Sold Out
                </button>
              <% } else { %>
                <a href="/concerts/<%= concert._id %>/select-quantity" class="rh-btn-crimson rh-btn-lg">
                  <i class="bi bi-ticket-perforated-fill"></i> Book Tickets Now
                </a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Body Content Grid -->
  <div class="container">
    <div class="row g-4">
      <!-- Left Column: Primary Concert Content (8 cols) -->
      <div class="col-lg-8">
        <!-- 1. Detailed Information Grid -->
        <div class="rh-editorial-card">
          <h2 class="rh-card-title">
            <i class="bi bi-info-circle-fill"></i> Concert Information
          </h2>
          <div class="rh-concert-info-grid">
            <!-- Date -->
            <div class="rh-info-tile">
              <div class="rh-info-icon-box">
                <i class="bi bi-calendar3"></i>
              </div>
              <div>
                <div class="rh-info-tile-label">Date</div>
                <div class="rh-info-tile-value"><%= toISTDateString(concert.date) %></div>
              </div>
            </div>

            <!-- Start Time -->
            <div class="rh-info-tile">
              <div class="rh-info-icon-box text-success" style="background-color: rgba(40, 167, 69, 0.1);">
                <i class="bi bi-play-circle"></i>
              </div>
              <div>
                <div class="rh-info-tile-label">Start Time</div>
                <div class="rh-info-tile-value"><%= displayTime %></div>
              </div>
            </div>

            <!-- End Time -->
            <div class="rh-info-tile">
              <div class="rh-info-icon-box text-danger" style="background-color: rgba(220, 53, 69, 0.1);">
                <i class="bi bi-stop-circle"></i>
              </div>
              <div>
                <div class="rh-info-tile-label">End Time</div>
                <div class="rh-info-tile-value"><%= endDisplayTime %></div>
              </div>
            </div>

            <!-- Duration -->
            <div class="rh-info-tile">
              <div class="rh-info-icon-box">
                <i class="bi bi-hourglass-split"></i>
              </div>
              <div>
                <div class="rh-info-tile-label">Duration</div>
                <div class="rh-info-tile-value"><%= bookingHours %> hour<%= bookingHours > 1 ? 's' : '' %></div>
              </div>
            </div>

            <!-- Venue -->
            <div class="rh-info-tile">
              <div class="rh-info-icon-box">
                <i class="bi bi-geo-alt"></i>
              </div>
              <div>
                <div class="rh-info-tile-label">Venue</div>
                <div class="rh-info-tile-value">
                  <% if (concert.venue && concert.venue.name) { %>
                    <%= concert.venue.name %>, <%= concert.venue.city %>
                  <% } else { %>
                    <%= concert.city %>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Availability -->
            <div class="rh-info-tile">
              <div class="rh-info-icon-box">
                <i class="bi bi-ticket-perforated"></i>
              </div>
              <div>
                <div class="rh-info-tile-label">Ticket Availability</div>
                <div class="rh-info-tile-value">
                  <% if (ticketsRemaining === 'Unlimited') { %>
                    <span class="text-success fw-bold">Unlimited tickets available</span>
                  <% } else if (ticketsRemaining > 0) { %>
                    <span class="text-success fw-bold"><%= ticketsRemaining %> tickets remaining</span>
                  <% } else { %>
                    <span class="text-danger fw-bold">Sold Out</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. About This Concert -->
        <div class="rh-editorial-card">
          <h2 class="rh-card-title">
            <i class="bi bi-file-text-fill"></i> About This Concert
          </h2>
          <div class="rh-concert-desc-text">
            <%= concert.description %>
          </div>
        </div>

        <!-- 3. Ticket Booking & Status Card -->
        <div class="rh-editorial-card">
          <h2 class="rh-card-title">
            <i class="bi bi-ticket-detailed-fill"></i> Ticket Booking
          </h2>
          <% if (currentUser) { %>
            <% if (userTickets && userTickets.length > 0) { %>
              <div class="rh-booking-banner rh-booking-banner-success">
                <div class="d-flex align-items-start gap-3">
                  <div class="rh-info-icon-box text-success" style="background-color: rgba(40, 167, 69, 0.15); font-size: 1.5rem;">
                    <i class="bi bi-check-circle-fill"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h5 class="fw-bold mb-1" style="color: #28a745;">You have tickets for this concert!</h5>
                    <p class="rh-booking-muted-text mb-3">
                      You have already booked <strong><%= userTickets.reduce((sum, ticket) => sum + ticket.quantity, 0) %></strong> ticket(s) for this concert.
                    </p>
                    <div class="rh-booking-actions-row">
                      <a href="/tickets/<%= userTickets[0]._id %>" class="rh-btn-crimson rh-booking-btn">
                        <i class="bi bi-qr-code"></i> View Ticket
                      </a>
                      <% if (ticketsRemaining !== 0 && ticketsRemaining !== 'Sold Out') { %>
                        <a href="/concerts/<%= concert._id %>/select-quantity" class="rh-btn-crimson-outline rh-booking-btn">
                          Book More Tickets
                        </a>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% } else if (new Date(concert.date) < new Date()) { %>
              <div class="rh-booking-banner rh-booking-banner-warning">
                <div class="d-flex align-items-center gap-3">
                  <div class="rh-info-icon-box text-warning" style="background-color: rgba(224, 168, 0, 0.15); font-size: 1.5rem;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                  </div>
                  <div>
                    <h5 class="fw-bold mb-1" style="color: #b38600;">Event Concluded</h5>
                    <p class="text-muted mb-0">This concert has already taken place. Browse our upcoming concerts list for future live music events.</p>
                  </div>
                </div>
              </div>
            <% } else if (ticketsRemaining === 0 || ticketsRemaining === 'Sold Out') { %>
              <div class="rh-booking-banner rh-booking-banner-danger">
                <div class="d-flex align-items-center gap-3">
                  <div class="rh-info-icon-box text-danger" style="background-color: rgba(220, 53, 69, 0.15); font-size: 1.5rem;">
                    <i class="bi bi-x-circle-fill"></i>
                  </div>
                  <div>
                    <h5 class="fw-bold mb-1" style="color: #dc3545;">Sold Out</h5>
                    <p class="text-muted mb-0">All tickets for this concert are sold out. Follow the artist to be notified of upcoming tour dates.</p>
                  </div>
                </div>
              </div>
            <% } else { %>
              <div class="p-3 rounded-4" style="background-color: rgba(255, 255, 255, 0.6); border: 1px dashed var(--rh-border);">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                  <div>
                    <span class="text-muted small d-block">Price per ticket</span>
                    <span class="fs-3 fw-bold" style="color: var(--rh-crimson);">
                      <%= concert.isPaid ? (concert.price ? `₹${concert.price}` : '₹0') : 'FREE' %>
                    </span>
                  </div>
                  <a href="/concerts/<%= concert._id %>/select-quantity" class="rh-btn-crimson rh-btn-lg">
                    <i class="bi bi-ticket-perforated-fill"></i> Book Tickets Now
                  </a>
                </div>
              </div>
            <% } %>
          <% } else { %>
            <div class="rh-booking-banner rh-booking-banner-guest">
              <div class="d-flex align-items-start gap-3">
                <div class="rh-info-icon-box" style="font-size: 1.5rem;">
                  <i class="bi bi-person-lock"></i>
                </div>
                <div class="flex-grow-1">
                  <h5 class="fw-bold mb-1" style="color: var(--rh-crimson);">Want to book tickets?</h5>
                  <p class="rh-booking-muted-text mb-3">Please sign in to your Rapira account or create one to book tickets for this live experience.</p>
                  <div class="rh-booking-actions-row">
                    <a href="/auth/login" class="rh-btn-crimson rh-booking-btn">
                      <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    <a href="/auth/register" class="rh-btn-crimson-outline rh-booking-btn">
                      <i class="bi bi-person-plus"></i> Register
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right Column: Sidebar (4 cols) -->
      <div class="col-lg-4">
        <!-- 1. Featured Artist Card -->
        <div class="rh-editorial-card rh-artist-sidebar-card">
          <h2 class="rh-card-title justify-content-center mb-3">
            Featured Artist
          </h2>
          <% if (concert.artist && concert.artist.user) { %>
            <div class="position-relative d-inline-block">
              <img src="<%= locals.getImageUrl ? getImageUrl(concert.artist.user.profileImage, '/images/default-profile.png') : (concert.artist.user.profileImage || '/images/default-profile.png') %>"
                   alt="<%= concert.artist.user.name || 'Artist' %>"
                   class="rh-artist-sidebar-avatar"
                   onerror="this.onerror=null; this.src='/images/default-profile.png';">
              <% if (concert.artist.verified) { %>
                <span class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 26px; height: 26px; font-size: 0.85rem;" title="Verified Artist">
                  <i class="bi bi-patch-check-fill"></i>
                </span>
              <% } %>
            </div>
            <h4 class="fw-bold mb-1" style="color: var(--rh-crimson);"><%= concert.artist.user.name || 'Artist' %></h4>
            <div class="mb-3">
              <span class="rh-artist-genre-pill"><%= concert.artist.genre || 'Hip-Hop Musician' %></span>
            </div>
            <% if (concert.artist._id) { %>
              <a href="/artists/<%= concert.artist._id %>" class="rh-btn-crimson-outline w-100">
                View Artist Profile <i class="bi bi-arrow-right ms-1"></i>
              </a>
            <% } %>
          <% } else { %>
            <img src="/images/default-profile.png" alt="Artist" class="rh-artist-sidebar-avatar">
            <h4 class="fw-bold mb-1" style="color: var(--rh-crimson);">Featured Artist</h4>
            <div class="mb-3">
              <span class="rh-artist-genre-pill">Musician</span>
            </div>
            <button class="rh-btn-crimson-outline w-100 opacity-50" disabled>Artist Profile Unavailable</button>
          <% } %>
        </div>

        <!-- 2. Share This Concert Card -->
        <div class="rh-editorial-card">
          <h2 class="rh-card-title mb-3">
            <i class="bi bi-share-fill"></i> Share Concert
          </h2>
          <div class="rh-share-btn-group">
            <!-- WhatsApp -->
            <a href="https://wa.me/?text=<%= encodeURIComponent(`Check out ${concert.title} live on RAPIRA! ${shareConcertUrl}`) %>"
               target="_blank"
               rel="noopener noreferrer"
               class="rh-share-pill-btn"
               title="Share on WhatsApp">
              <i class="bi bi-whatsapp"></i> WhatsApp
            </a>
            <!-- Facebook -->
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareConcertUrl) %>"
               target="_blank"
               rel="noopener noreferrer"
               class="rh-share-pill-btn"
               title="Share on Facebook">
              <i class="bi bi-facebook"></i> Facebook
            </a>
            <!-- X / Twitter -->
            <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(`Experience ${concert.title} live on RAPIRA!`) %>&url=<%= encodeURIComponent(shareConcertUrl) %>"
               target="_blank"
               rel="noopener noreferrer"
               class="rh-share-pill-btn"
               title="Tweet on X">
              <i class="bi bi-twitter-x"></i> X (Twitter)
            </a>
            <!-- Copy Link -->
            <button type="button"
                    class="rh-share-pill-btn"
                    onclick="copyConcertLink()"
                    title="Copy Concert Link">
              <i class="bi bi-link-45deg"></i> Copy Link
            </button>
          </div>
        </div>

        <!-- 3. Venue Location Card with Embedded Google Maps Preview -->
        <div class="rh-editorial-card">
          <h2 class="rh-card-title mb-3">
            <i class="bi bi-geo-alt-fill"></i> Venue Location
          </h2>
          
          <!-- Embedded Google Map Preview -->
          <% 
            let embedQueryParts = [];
            if (concert.venue && concert.venue.name) embedQueryParts.push(concert.venue.name);
            if (concert.venue && concert.venue.address) embedQueryParts.push(concert.venue.address);
            if (concert.venue && concert.venue.city) embedQueryParts.push(concert.venue.city);
            if (concert.venue && concert.venue.state) embedQueryParts.push(concert.venue.state);
            if (concert.venue && concert.venue.pincode) embedQueryParts.push(concert.venue.pincode);
            if (embedQueryParts.length === 0) embedQueryParts.push(concert.city || 'India');
            let mapEmbedQuery = encodeURIComponent(embedQueryParts.join(', '));
          %>
          <div class="rh-venue-map-embed-container mb-3">
            <iframe
              src="https://maps.google.com/maps?q=<%= mapEmbedQuery %>&t=&z=14&ie=UTF8&iwloc=&output=embed"
              class="rh-venue-map-iframe"
              title="Venue Location Map"
              loading="lazy"
              allowfullscreen>
            </iframe>
          </div>

          <div class="rh-venue-info-box mb-3">
            <h5 class="rh-venue-name mb-1">
              <% if (concert.venue && concert.venue.name) { %>
                <%= concert.venue.name %>
              <% } else { %>
                <%= concert.city || 'Concert Venue' %>
              <% } %>
            </h5>
            <p class="rh-venue-address-text">
              <i class="bi bi-geo-alt-fill text-crimson me-1"></i>
              <% if (concert.venue && concert.venue.address) { %>
                <%= concert.venue.address %><% if (concert.venue.city) { %>, <%= concert.venue.city %><% } %><% if (concert.venue.state) { %>, <%= concert.venue.state %><% } %><% if (concert.venue.pincode) { %> - <%= concert.venue.pincode %><% } %>
              <% } else { %>
                <%= concert.city || 'Address provided upon booking' %>
              <% } %>
            </p>
          </div>

          <a href="<%= mapsUrl %>"
             target="_blank"
             rel="noopener noreferrer"
             class="rh-btn-crimson w-100">
            <i class="bi bi-compass-fill"></i> Open in Google Maps
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Copy Link Toast Notification -->
<div id="rh-copy-toast" class="rh-toast-notification">
  <i class="bi bi-check-circle-fill"></i> Concert link copied to clipboard!
</div>

<script>
  function copyConcertLink() {
    const url = window.location.href;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(url).then(showToast).catch(fallbackCopy);
    } else {
      fallbackCopy();
    }

    function fallbackCopy() {
      const input = document.createElement('input');
      input.value = url;
      document.body.appendChild(input);
      input.select();
      try {
        document.execCommand('copy');
        showToast();
      } catch (err) {
        console.error('Copy failed', err);
      }
      document.body.removeChild(input);
    }

    function showToast() {
      const toast = document.getElementById('rh-copy-toast');
      if (toast) {
        toast.classList.add('show');
        setTimeout(function() {
          toast.classList.remove('show');
        }, 2500);
      }
    }
  }
</script>
