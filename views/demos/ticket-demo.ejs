<!-- Ticket Purchase Demo Page -->
<div class="container-fluid py-4">
  <!-- Demo Header -->
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h1 class="display-5 fw-bold mb-3">Ticket Purchase <span class="gradient-text-orange">Demo</span></h1>
      <p class="lead mb-4">Experience how to purchase concert tickets on Rapira</p>
      <div class="alert alert-info d-inline-block">
        <i class="bi bi-info-circle-fill me-2"></i> This is a demo. No actual purchases will be made.
      </div>
    </div>
  </div>

  <!-- Concert Details Section -->
  <div class="row">
    <div class="col-lg-10 mx-auto">
      <div class="glass-card-dark p-0 rounded-4 overflow-hidden">
        <!-- Concert Banner -->
        <div class="position-relative">
          <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="w-100" style="height: 300px; object-fit: cover;">
          <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
            <div class="d-flex justify-content-between align-items-end">
              <div>
                <h2 class="text-white mb-1 fw-bold"><%= concert.title %></h2>
                <p class="text-white-50 mb-0">
                  By <span class="text-white"><%= concert.artist.name %></span>
                </p>
              </div>
              <div>
                <span class="badge <%= concert.isPaid ? 'bg-gradient-primary' : 'bg-gradient-success' %> px-3 py-2 fs-5">
                  <%= concert.isPaid ? `₹${concert.price}` : 'Free' %>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Concert Info -->
        <div class="p-4">
          <div class="row">
            <div class="col-md-8">
              <div class="mb-4">
                <h4 class="text-white mb-3">Event Details</h4>
                <p class="mb-3">
                  <i class="bi bi-calendar3 me-2 text-primary"></i>
                  <strong>Date & Time:</strong> 
                  <%= new Date(concert.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %> • <%= concert.time %>
                </p>
                <p class="mb-3">
                  <i class="bi bi-geo-alt me-2 text-primary"></i>
                  <strong>Venue:</strong> 
                  <%= concert.venue %>, <%= concert.address %>
                </p>
                <p class="mb-3">
                  <i class="bi bi-ticket-perforated me-2 text-primary"></i>
                  <strong>Availability:</strong> 
                  <%= concert.ticketsAvailable - concert.ticketsSold %> tickets left
                </p>
              </div>

              <div class="mb-4">
                <h4 class="text-white mb-3">Description</h4>
                <p><%= concert.description %></p>
              </div>
            </div>
            <div class="col-md-4">
              <div class="glass-card p-3 rounded-4 mb-3">
                <h5 class="text-white mb-3">Ticket Information</h5>
                <ul class="list-unstyled mb-0">
                  <li class="mb-2">
                    <i class="bi bi-check-circle-fill text-success me-2"></i> Instant confirmation
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle-fill text-success me-2"></i> Mobile tickets
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle-fill text-success me-2"></i> Secure payment
                  </li>
                  <li>
                    <i class="bi bi-check-circle-fill text-success me-2"></i> Refund available (T&C apply)
                  </li>
                </ul>
              </div>

              <div class="glass-card p-3 rounded-4">
                <h5 class="text-white mb-3">Artist</h5>
                <div class="d-flex align-items-center mb-3">
                  <img src="<%= concert.artist.profileImage %>" alt="<%= concert.artist.name %>" class="rounded-circle me-3" width="50" height="50" style="object-fit: cover;">
                  <div>
                    <h6 class="text-white mb-0"><%= concert.artist.name %></h6>
                    <p class="text-muted mb-0 small">Hip-Hop/Rap Artist</p>
                  </div>
                </div>
                <a href="/demo/artist" class="btn btn-outline-light btn-sm w-100">
                  <i class="bi bi-person me-2"></i> View Artist Profile
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Ticket Purchase Section -->
  <div class="row mt-4">
    <div class="col-lg-10 mx-auto">
      <div class="glass-card-dark p-4 rounded-4">
        <h4 class="text-white mb-4">Purchase Tickets</h4>
        
        <form id="ticketForm">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="form-floating mb-3">
                <select class="form-select bg-dark text-white" id="ticketQuantity" required>
                  <option value="1">1 Ticket</option>
                  <option value="2">2 Tickets</option>
                  <option value="3">3 Tickets</option>
                  <option value="4">4 Tickets</option>
                  <option value="5">5 Tickets</option>
                </select>
                <label for="ticketQuantity">Number of Tickets</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating mb-3">
                <input type="text" class="form-control bg-dark text-white" id="attendeeName" placeholder="Attendee Name" required>
                <label for="attendeeName">Attendee Name</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating mb-3">
                <input type="email" class="form-control bg-dark text-white" id="attendeeEmail" placeholder="Email" required>
                <label for="attendeeEmail">Email</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating mb-3">
                <input type="tel" class="form-control bg-dark text-white" id="attendeePhone" placeholder="Phone" required>
                <label for="attendeePhone">Phone</label>
              </div>
            </div>
            
            <div class="col-12 mb-3">
              <div class="card bg-dark border-primary">
                <div class="card-header bg-primary text-white">
                  <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                  <div class="d-flex justify-content-between mb-2">
                    <span>Ticket Price:</span>
                    <span>₹<%= concert.price %> x <span id="summaryQuantity">1</span></span>
                  </div>
                  <div class="d-flex justify-content-between mb-2">
                    <span>Booking Fee:</span>
                    <span>₹50 x <span id="summaryFeeQuantity">1</span></span>
                  </div>
                  <hr>
                  <div class="d-flex justify-content-between fw-bold">
                    <span>Total:</span>
                    <span id="summaryTotal">₹<%= concert.price + 50 %></span>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="col-12 mb-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="termsCheck" required>
                <label class="form-check-label" for="termsCheck">
                  I agree to the <a href="/terms-of-service" target="_blank">Terms of Service</a> and <a href="/refund-policy" target="_blank">Refund Policy</a>
                </label>
              </div>
            </div>
            
            <div class="col-12">
              <button type="submit" class="btn btn-gradient-orange btn-lg w-100">
                <i class="bi bi-credit-card me-2"></i> Proceed to Payment
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Back to Demo Home -->
  <div class="row mt-4 mb-5">
    <div class="col-12 text-center">
      <a href="/demo" class="btn btn-outline-light">
        <i class="bi bi-arrow-left me-2"></i> Back to Demo Home
      </a>
    </div>
  </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg">
    <div class="modal-content bg-dark">
      <div class="modal-header border-0">
        <h5 class="modal-title text-white" id="paymentModalLabel">Complete Payment</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-6 mb-4 mb-md-0">
            <h6 class="text-white mb-3">Payment Details</h6>
            <div class="form-floating mb-3">
              <input type="text" class="form-control bg-dark text-white" id="cardName" placeholder="Name on Card" required>
              <label for="cardName">Name on Card</label>
            </div>
            <div class="form-floating mb-3">
              <input type="text" class="form-control bg-dark text-white" id="cardNumber" placeholder="Card Number" required>
              <label for="cardNumber">Card Number</label>
            </div>
            <div class="row g-2">
              <div class="col-6">
                <div class="form-floating mb-3">
                  <input type="text" class="form-control bg-dark text-white" id="cardExpiry" placeholder="MM/YY" required>
                  <label for="cardExpiry">Expiry (MM/YY)</label>
                </div>
              </div>
              <div class="col-6">
                <div class="form-floating mb-3">
                  <input type="text" class="form-control bg-dark text-white" id="cardCvv" placeholder="CVV" required>
                  <label for="cardCvv">CVV</label>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <h6 class="text-white mb-3">Order Summary</h6>
            <div class="glass-card p-3 rounded-4 mb-3">
              <div class="d-flex justify-content-between mb-2">
                <span><%= concert.title %></span>
                <span id="modalQuantity">1 ticket</span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span>Date</span>
                <span><%= new Date(concert.date).toLocaleDateString() %></span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span>Venue</span>
                <span><%= concert.venue %></span>
              </div>
              <hr>
              <div class="d-flex justify-content-between fw-bold">
                <span>Total</span>
                <span id="modalTotal">₹<%= concert.price + 50 %></span>
              </div>
            </div>
            <div class="alert alert-info mb-0">
              <i class="bi bi-info-circle-fill me-2"></i> This is a demo. No actual payment will be processed.
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-gradient-orange" id="completePaymentBtn">
          <i class="bi bi-lock-fill me-2"></i> Complete Payment
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark">
      <div class="modal-body text-center py-4">
        <div class="mb-3 text-success">
          <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
        </div>
        <h4 class="text-white mb-3">Payment Successful!</h4>
        <p class="mb-4">Your tickets have been booked successfully. A confirmation email has been sent to your registered email address.</p>
        <div class="d-grid gap-2">
          <button type="button" class="btn btn-gradient-orange" id="viewTicketsBtn">
            <i class="bi bi-ticket-perforated me-2"></i> View My Tickets
          </button>
          <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Loading Spinner Modal -->
<div class="modal fade" id="loadingModal" tabindex="-1" aria-labelledby="loadingModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark">
      <div class="modal-body text-center py-4">
        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
          <span class="visually-hidden">Loading...</span>
        </div>
        <h5 class="text-white mb-0">Processing payment...</h5>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize modals
    const paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));
    const successModal = new bootstrap.Modal(document.getElementById('successModal'));
    const loadingModal = new bootstrap.Modal(document.getElementById('loadingModal'));
    
    // Update order summary when quantity changes
    document.getElementById('ticketQuantity').addEventListener('change', function() {
      const quantity = parseInt(this.value);
      const ticketPrice = <%= concert.price %>;
      const bookingFee = 50;
      const total = (ticketPrice + bookingFee) * quantity;
      
      document.getElementById('summaryQuantity').textContent = quantity;
      document.getElementById('summaryFeeQuantity').textContent = quantity;
      document.getElementById('summaryTotal').textContent = `₹${total}`;
    });
    
    // Ticket form submission
    document.getElementById('ticketForm').addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Get form values
      const quantity = document.getElementById('ticketQuantity').value;
      const total = document.getElementById('summaryTotal').textContent;
      
      // Update payment modal
      document.getElementById('modalQuantity').textContent = `${quantity} ticket${quantity > 1 ? 's' : ''}`;
      document.getElementById('modalTotal').textContent = total;
      
      // Show payment modal
      paymentModal.show();
    });
    
    // Complete payment button
    document.getElementById('completePaymentBtn').addEventListener('click', function() {
      // Hide payment modal
      paymentModal.hide();
      
      // Show loading modal
      loadingModal.show();
      
      // Simulate payment processing
      setTimeout(() => {
        // Hide loading modal
        loadingModal.hide();
        
        // Show success modal
        successModal.show();
      }, 2000);
    });
    
    // View tickets button
    document.getElementById('viewTicketsBtn').addEventListener('click', function() {
      // Redirect to tickets page (in demo, just reload the page)
      window.location.reload();
    });
  });
</script>
