<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="text-center mb-5">
        <div class="mb-4">
          <i class="bi bi-person-x-fill text-danger" style="font-size: 6rem;"></i>
        </div>
        <h1 class="h2 fw-bold text-danger mb-3">Account Deleted</h1>
        <p class="lead text-muted mb-4">Your account has been removed from our system</p>
      </div>

      <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
            <div>
              <%= message || 'Your account has been deleted by the website administrator.' %>
            </div>
          </div>
          
          <p class="mb-3">
            <strong>What happened?</strong>
          </p>
          <p class="text-muted">
            Your user account has been permanently deleted from our system. This could be due to:
          </p>
          <ul class="text-muted mb-4">
            <li>Administrative action by website moderators</li>
            <li>Account policy violations</li>
            <li>Your own deletion request</li>
          </ul>
          
          <p class="mb-3">
            <strong>What's next?</strong>
          </p>
          <p class="text-muted mb-4">
            If you believe this is an error or would like to inquire about your account deletion, 
            please contact our support team at <a href="mailto:support@rapira.com" class="text-decoration-none">support@rapira.com</a>
          </p>

          <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-primary px-4">
              <i class="bi bi-house-fill me-2"></i>Go to Home
            </a>
            <a href="/contact" class="btn btn-outline-secondary px-4">
              <i class="bi bi-chat-dots me-2"></i>Contact Support
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
