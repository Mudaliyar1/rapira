<div class="container py-5">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="display-5 fw-bold text-center mb-4">Subscription Plans</h1>
      <p class="lead text-center mb-5">Enhance your Rapira experience with exclusive benefits and discounts</p>
    </div>
  </div>

  <% if (!currentUser) { %>
    <div class="alert alert-info text-center mb-5">
      <i class="bi bi-info-circle me-2"></i>
      You need to <a href="/auth/login" class="alert-link">log in</a> to purchase a subscription.
    </div>
  <% } %>

  <% if (plans.length === 0) { %>
    <div class="alert alert-warning text-center">
      <i class="bi bi-exclamation-triangle me-2"></i>
      No subscription plans are currently available. Please check back later.
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
      <% plans.forEach(plan => { %>
        <div class="col">
          <div class="card h-100 glass-card-dark border border-secondary">
            <div class="card-header bg-primary text-white text-center py-3">
              <h3 class="card-title mb-0"><%= plan.name %></h3>
            </div>
            <div class="card-body d-flex flex-column">
              <div class="text-center mb-3">
                <span class="display-5 fw-bold text-white">₹<%= plan.price %></span>
                <% if (plan.durationUnit === 'days' && plan.duration >= 30) { %>
                  <span class="text-muted">/ <%= Math.floor(plan.duration / 30) %> month<%= Math.floor(plan.duration / 30) > 1 ? 's' : '' %></span>
                <% } else { %>
                  <span class="text-muted">/ <%= plan.duration %> <%= plan.durationUnit %></span>
                <% } %>
              </div>

              <div class="mb-4">
                <h5 class="text-white mb-3">Benefits:</h5>
                <div class="text-white-50">
                  <%= plan.benefits %>
                </div>
              </div>

              <% if (plan.discountPercentage > 0) { %>
                <div class="alert alert-success mb-4">
                  <i class="bi bi-tag-fill me-2"></i>
                  <strong><%= plan.discountPercentage %>% discount</strong> on all ticket purchases
                </div>
              <% } %>

              <div class="mt-auto">
                <ul class="list-group list-group-flush mb-4">
                  <li class="list-group-item bg-transparent text-white-50 border-secondary">
                    <i class="bi bi-calendar-check me-2"></i>
                    <%= plan.duration %> <%= plan.durationUnit %> of access
                  </li>
                  <% if (plan.discountPercentage > 0) { %>
                    <li class="list-group-item bg-transparent text-white-50 border-secondary">
                      <i class="bi bi-percent me-2"></i>
                      <%= plan.discountPercentage %>% off on tickets
                    </li>
                  <% } %>
                </ul>

                <% if (currentUser) { %>
                  <a href="/subscriptions/purchase/<%= plan._id %>" class="btn btn-primary w-100">
                    <i class="bi bi-credit-card me-2"></i>
                    Subscribe Now
                  </a>
                <% } else { %>
                  <a href="/auth/login" class="btn btn-outline-primary w-100">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Login to Subscribe
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="row mt-5">
    <div class="col-md-8 mx-auto">
      <div class="card glass-card-dark border border-secondary">
        <div class="card-header bg-dark text-white">
          <h4 class="mb-0"><i class="bi bi-info-circle me-2"></i>Subscription Information</h4>
        </div>
        <div class="card-body text-white-50">
          <h5 class="text-white">How Subscriptions Work</h5>
          <ul>
            <li>Subscriptions are active from the moment of purchase until the expiry date.</li>
            <li>You can view your active subscription details in your user dashboard.</li>
            <li>Subscription benefits apply automatically to your account.</li>
            <li>Ticket discounts are applied automatically during checkout.</li>
            <li>You will receive an email confirmation after subscribing.</li>
          </ul>

          <h5 class="text-white mt-4">Renewal Policy</h5>
          <p>Subscriptions do not auto-renew. You will need to manually renew your subscription before or after it expires.</p>

          <h5 class="text-white mt-4">Need Help?</h5>
          <p>If you have any questions about our subscription plans, please <a href="/contact" class="text-primary">contact our support team</a>.</p>
        </div>
      </div>
    </div>
  </div>
</div>


