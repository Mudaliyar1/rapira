<div class="rapira-subscriptions-page">
  <!-- Warm Wave Background Overlay -->
  <div class="rh-sub-bg-wave" aria-hidden="true"></div>

  <div class="container rh-sub-container">
    <!-- Hero Header -->
    <div class="rh-sub-hero">
      <div class="rh-sub-crown-icon" aria-hidden="true">
        <svg width="42" height="34" viewBox="0 0 24 20" fill="none" stroke="#9F190E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 18h20v2H2v-2z"/>
          <path d="M4 18l-2-12 6 4 4-7 4 7 6-4-2 12H4z"/>
          <circle cx="12" cy="13" r="1.5" fill="#9F190E"/>
        </svg>
      </div>
      <h1 class="rh-sub-hero-title">Subscription Plans</h1>
      <p class="rh-sub-hero-subtitle">ENHANCE YOUR RAPIRA EXPERIENCE WITH EXCLUSIVE BENEFITS AND DISCOUNTS</p>
    </div>

    <!-- Login Notice for Guests -->
    <% if (typeof currentUser === 'undefined' || !currentUser) { %>
      <div class="alert text-center mb-4 mx-auto" style="max-width: 680px; background-color: #FAF0E6; border: 1px solid #EAC8B7; color: #5C524C; border-radius: 14px;">
        <i class="bi bi-info-circle me-2" style="color: #9F190E;"></i>
        You need to <a href="/auth/login" class="rh-sub-help-link">log in</a> to purchase a subscription.
      </div>
    <% } %>

    <%
      const planCount = (typeof plans !== 'undefined' && plans) ? plans.length : 0;
    %>

    <!-- Adaptive Plans Layout -->
    <% if (planCount === 0) { %>
      <!-- Zero Plans: Polished Empty State -->
      <div class="rh-sub-empty-state">
        <div class="rh-sub-empty-icon" aria-hidden="true">
          <i class="bi bi-calendar-x"></i>
        </div>
        <h3 class="rh-sub-empty-title">No Subscription Plans Available</h3>
        <p class="rh-sub-empty-desc">There are currently no active subscription plans. Please check back later or contact our support team.</p>
        <a href="/" class="rh-sub-btn-primary" style="display: inline-flex; width: auto; padding: 10px 28px;">
          Back to Home
        </a>
      </div>
    <% } else if (planCount === 1) { %>
      <!-- 1 Plan: Balanced 2-column layout matching reference image side-by-side -->
      <div class="row g-4 align-items-stretch justify-content-center">
        <div class="col-lg-5 col-xl-5">
          <%- include('../partials/subscription-plan-card', { plan: plans[0] }) %>
        </div>
        <div class="col-lg-7 col-xl-7">
          <%- include('../partials/subscription-info-card') %>
        </div>
      </div>
    <% } else if (planCount === 2) { %>
      <!-- 2 Plans: Equal side-by-side cards, Info Card below -->
      <div class="row row-cols-1 row-cols-md-2 g-4 justify-content-center mb-5">
        <% plans.forEach(plan => { %>
          <div class="col">
            <%- include('../partials/subscription-plan-card', { plan }) %>
          </div>
        <% }); %>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
          <%- include('../partials/subscription-info-card') %>
        </div>
      </div>
    <% } else { %>
      <!-- 3 or More Plans: 3-column responsive grid (wrapping automatically for 4, 5, 6+ plans), Info Card below -->
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center mb-5">
        <% plans.forEach(plan => { %>
          <div class="col">
            <%- include('../partials/subscription-plan-card', { plan }) %>
          </div>
        <% }); %>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
          <%- include('../partials/subscription-info-card') %>
        </div>
      </div>
    <% } %>
  </div>
</div>
