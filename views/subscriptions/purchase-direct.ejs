<%- contentFor('body') %>

<div class="container py-5">
  <h1 class="text-center mb-4">Purchase Subscription</h1>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card glass-card-dark border border-secondary mb-4">
        <div class="card-header bg-primary text-white">
          <h3 class="mb-0"><%= plan.name %> Subscription</h3>
        </div>

        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h5 class="text-white">Subscription Details</h5>
              <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item bg-transparent text-white-50 border-secondary d-flex justify-content-between">
                  <span>Price:</span>
                  <span class="fw-bold text-white">₹<%= plan.price %></span>
                </li>
                <li class="list-group-item bg-transparent text-white-50 border-secondary d-flex justify-content-between">
                  <span>Duration:</span>
                  <span>
                    <%= plan.duration %> <%= plan.durationUnit %>
                    <% if (plan.durationUnit === 'days' && plan.duration >= 30) { %>
                      (<%= Math.floor(plan.duration / 30) %> month<%= Math.floor(plan.duration / 30) > 1 ? 's' : '' %>)
                    <% } %>
                  </span>
                </li>
                <% if (plan.discountPercentage > 0) { %>
                  <li class="list-group-item bg-transparent text-white-50 border-secondary d-flex justify-content-between">
                    <span>Ticket Discount:</span>
                    <span class="text-success"><%= plan.discountPercentage %>%</span>
                  </li>
                <% } %>
              </ul>
            </div>

            <div class="col-md-6">
              <h5 class="text-white">Benefits</h5>
              <p class="text-white-50"><%= plan.benefits %></p>

              <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                <span style="color: black;">Your subscription will be active immediately after successful payment.</span>
              </div>
            </div>
          </div>

          <hr class="border-secondary">

          <div class="text-center">
            <h4 class="text-white mb-3">Total Amount: ₹<%= plan.price %></h4>

            <form action="/subscriptions/create-order/<%= plan._id %>" method="POST">
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-credit-card me-2"></i>
                Pay Now
              </button>
            </form>

            <p class="mt-3 small text-white-50">
              <i class="bi bi-shield-lock me-1"></i>
              Secure payment powered by Razorpay
            </p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="/subscriptions" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i> Back to Subscriptions
        </a>
      </div>
    </div>
  </div>
</div>

<!-- No JavaScript needed for form submission approach -->
