<div class="my-subscriptions-page">
  <div class="my-subscriptions-bg-decor" aria-hidden="true"></div>

  <div class="container my-subscriptions-container">

    <!-- Top Hero Header (Exact Reference Match) -->
    <header class="my-subscriptions-hero">
      <div class="my-subscriptions-crown-icon" aria-hidden="true">
        <svg viewBox="0 0 38 28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 24H35M5 24L3 8L12 14L19 4L26 14L35 8L33 24H5Z" />
          <circle cx="3" cy="8" r="1.5" fill="currentColor"/>
          <circle cx="19" cy="4" r="1.5" fill="currentColor"/>
          <circle cx="35" cy="8" r="1.5" fill="currentColor"/>
        </svg>
      </div>
      <h1 class="my-subscriptions-title">My Subscriptions</h1>
      <nav class="my-subscriptions-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="my-subscriptions-breadcrumb-sep">/</span>
        <a href="/users/profile">My Profile</a>
        <span class="my-subscriptions-breadcrumb-sep">/</span>
        <span class="my-subscriptions-breadcrumb-active">My Subscriptions</span>
      </nav>
    </header>

    <%
      const formatDate = (d) => {
        if (!d) return 'N/A';
        try {
          if (typeof toISTDateString === 'function') return toISTDateString(d);
          return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
        } catch(e) {
          return new Date(d).toLocaleDateString('en-IN');
        }
      };

      // Check if user has an active subscription
      const hasActiveSub = !!(activeSubscription && activeSubscription.plan);

      // Check if user has expired subscription (no active sub, but latest history sub is expired)
      let latestExpired = null;
      if (!hasActiveSub && subscriptionHistory && subscriptionHistory.length > 0) {
        latestExpired = subscriptionHistory[0];
      }
    %>

    <% if (hasActiveSub) { %>
      <!-- =============================================================== -->
      <!-- STATE B: ACTIVE SUBSCRIPTION CARD                               -->
      <!-- =============================================================== -->
      <%
        const now = new Date();
        const purchaseDate = new Date(activeSubscription.purchaseDate || activeSubscription.createdAt || now);
        const expiryDate = new Date(activeSubscription.expiryDate);
        const totalDurationMs = Math.max(1, expiryDate - purchaseDate);
        const elapsedMs = Math.max(0, now - purchaseDate);
        const progressPercent = Math.min(100, Math.max(0, Math.round((elapsedMs / totalDurationMs) * 100)));
        const timeRemainingMs = Math.max(0, expiryDate - now);

        const daysRemaining = Math.floor(timeRemainingMs / (1000 * 60 * 60 * 24));
        const hoursRemaining = Math.floor((timeRemainingMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minsRemaining = Math.floor((timeRemainingMs % (1000 * 60 * 60)) / (1000 * 60));
        const secsRemaining = Math.floor((timeRemainingMs % (1000 * 60)) / 1000);

        // Check if renewal CTA should be shown (< 7 days or plan duration < 7 days and 80% elapsed)
        let isExpiringSoon = daysRemaining < 7;
        if (activeSubscription.plan && activeSubscription.plan.durationUnit === 'hours') {
          isExpiringSoon = hoursRemaining < 24;
        }

        // Parse benefits
        let benefitsList = [];
        if (activeSubscription.plan && activeSubscription.plan.benefits) {
          if (Array.isArray(activeSubscription.plan.benefits)) {
            benefitsList = activeSubscription.plan.benefits;
          } else {
            benefitsList = activeSubscription.plan.benefits
              .split(/[\r\n]+|,|•/)
              .map(b => b.trim())
              .filter(Boolean);
          }
        }
      %>

      <section class="my-subscriptions-active-card" aria-labelledby="active-plan-title">
        <div class="my-subscriptions-card-top">
          <div>
            <div class="my-subscriptions-plan-tag">Current Plan</div>
            <h2 id="active-plan-title" class="my-subscriptions-plan-title">
              <%= activeSubscription.plan.name %>
            </h2>
          </div>
          <span class="my-subscriptions-status-pill active">
            <i class="bi bi-check-circle-fill"></i> Active
          </span>
        </div>

        <div class="my-subscriptions-card-body">
          <!-- Price & Live Countdown Row -->
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div class="my-subscriptions-price-row mb-0">
              <span class="my-subscriptions-price-val">₹<%= activeSubscription.amount || activeSubscription.plan.price %></span>
              <span class="my-subscriptions-price-unit">/ <%= activeSubscription.plan.duration %> <%= activeSubscription.plan.durationUnit || 'days' %></span>
            </div>

            <!-- Live Countdown Timer -->
            <div class="p-2 px-3 rounded-4 border d-flex align-items-center gap-3" style="background-color: #FAF2EC; border-color: var(--rh-peach, #EAC8B7) !important;">
              <div class="d-flex align-items-center gap-1">
                <span class="fw-bold small text-dark">Time Left:</span>
                <span class="badge d-inline-flex align-items-center gap-1" style="background-color: var(--rh-crimson, #9F190E); font-size: 0.65rem; padding: 3px 6px;">
                  <span>LIVE</span>
                  <span id="live-indicator" style="display: inline-block; width: 5px; height: 5px; border-radius: 50%; background-color: #fff;"></span>
                </span>
              </div>
              <div id="countdown-container"
                   class="d-flex justify-content-center gap-2"
                   data-expiry="<%= activeSubscription.expiryDate %>"
                   data-unit="<%= activeSubscription.plan.durationUnit || 'days' %>"
                   data-original-duration="<%= activeSubscription.plan.duration || 0 %>">
                <div class="rh-timer-cell">
                  <div class="rh-timer-val" id="countdown-days"><%= daysRemaining.toString().padStart(2, '0') %></div>
                  <div class="rh-timer-lbl">Days</div>
                </div>
                <div class="rh-timer-cell">
                  <div class="rh-timer-val" id="countdown-hours"><%= hoursRemaining.toString().padStart(2, '0') %></div>
                  <div class="rh-timer-lbl">Hours</div>
                </div>
                <div class="rh-timer-cell">
                  <div class="rh-timer-val" id="countdown-minutes"><%= minsRemaining.toString().padStart(2, '0') %></div>
                  <div class="rh-timer-lbl">Mins</div>
                </div>
                <div class="rh-timer-cell">
                  <div class="rh-timer-val" id="countdown-seconds"><%= secsRemaining.toString().padStart(2, '0') %></div>
                  <div class="rh-timer-lbl">Secs</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Validity Progress Bar -->
          <div class="my-subscriptions-progress-wrap">
            <div class="my-subscriptions-progress-labels">
              <span>Plan Validity Progress</span>
              <span><%= daysRemaining %> days remaining (<%= 100 - progressPercent %>% left)</span>
            </div>
            <div class="my-subscriptions-progress-bar-bg" role="progressbar" aria-valuenow="<%= progressPercent %>" aria-valuemin="0" aria-valuemax="100">
              <div class="my-subscriptions-progress-bar-fill" style="width: <%= progressPercent %>%;"></div>
            </div>
          </div>

          <!-- Metadata Grid -->
          <div class="my-subscriptions-meta-grid">
            <div class="my-subscriptions-meta-cell">
              <div class="my-subscriptions-meta-label">Started On</div>
              <div class="my-subscriptions-meta-value"><%= formatDate(activeSubscription.purchaseDate) %></div>
            </div>
            <div class="my-subscriptions-meta-cell">
              <div class="my-subscriptions-meta-label">Expires On</div>
              <div class="my-subscriptions-meta-value"><%= formatDate(activeSubscription.expiryDate) %></div>
            </div>
            <div class="my-subscriptions-meta-cell">
              <div class="my-subscriptions-meta-label">Plan Duration</div>
              <div class="my-subscriptions-meta-value"><%= activeSubscription.plan.duration %> <%= activeSubscription.plan.durationUnit || 'days' %></div>
            </div>
            <div class="my-subscriptions-meta-cell">
              <div class="my-subscriptions-meta-label">Payment ID</div>
              <div class="my-subscriptions-meta-value text-truncate" style="font-size: 0.9rem;" title="<%= activeSubscription.paymentId || activeSubscription.orderId || activeSubscription._id %>">
                <%= activeSubscription.paymentId || activeSubscription.orderId || activeSubscription._id %>
              </div>
            </div>
            <% if (activeSubscription.plan.discountPercentage > 0) { %>
              <div class="my-subscriptions-meta-cell" style="background-color: #EBF8F0; border-color: #A3E0BA;">
                <div class="my-subscriptions-meta-label text-success">Ticket Discount</div>
                <div class="my-subscriptions-meta-value text-success"><%= activeSubscription.plan.discountPercentage %>% Off All Tickets</div>
              </div>
            <% } %>
          </div>

          <!-- Dynamic Benefits List -->
          <% if (benefitsList.length > 0) { %>
            <div class="my-subscriptions-benefits-wrap">
              <div class="my-subscriptions-benefits-title">
                <i class="bi bi-stars text-danger"></i>
                <span>Included Benefits & Perks</span>
              </div>
              <div class="my-subscriptions-benefits-grid">
                <% benefitsList.forEach(benefit => { %>
                  <div class="my-subscriptions-benefit-pill">
                    <i class="bi bi-check-circle-fill"></i>
                    <span><%= benefit %></span>
                  </div>
                <% }) %>
                <% if (activeSubscription.plan.discountPercentage > 0) { %>
                  <div class="my-subscriptions-benefit-pill">
                    <i class="bi bi-ticket-perforated-fill"></i>
                    <span><%= activeSubscription.plan.discountPercentage %>% Discount on concert tickets</span>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Action Strip -->
        <div class="my-subscriptions-actions-strip">
          <a href="/subscriptions" class="my-subscriptions-btn-secondary">
            <i class="bi bi-grid-fill"></i> Browse Other Plans
          </a>
          <% if (isExpiringSoon) { %>
            <a href="/subscriptions" class="my-subscriptions-btn-primary">
              <i class="bi bi-arrow-repeat"></i> Renew Subscription
            </a>
          <% } %>
        </div>
      </section>

    <% } else if (latestExpired) { %>
      <!-- =============================================================== -->
      <!-- STATE C: EXPIRED SUBSCRIPTION CARD                              -->
      <!-- =============================================================== -->
      <%
        let expiredBenefitsList = [];
        if (latestExpired.plan && latestExpired.plan.benefits) {
          if (Array.isArray(latestExpired.plan.benefits)) {
            expiredBenefitsList = latestExpired.plan.benefits;
          } else {
            expiredBenefitsList = latestExpired.plan.benefits
              .split(/[\r\n]+|,|•/)
              .map(b => b.trim())
              .filter(Boolean);
          }
        }
      %>
      <section class="my-subscriptions-active-card" aria-labelledby="expired-plan-title">
        <div class="my-subscriptions-card-top">
          <div>
            <div class="my-subscriptions-plan-tag">Previous Plan</div>
            <h2 id="expired-plan-title" class="my-subscriptions-plan-title">
              <%= latestExpired.plan ? latestExpired.plan.name : 'Subscription' %>
            </h2>
          </div>
          <span class="my-subscriptions-status-pill expired">
            <i class="bi bi-exclamation-circle-fill"></i> Expired
          </span>
        </div>

        <div class="my-subscriptions-card-body">
          <div class="alert mb-4 d-flex align-items-center gap-3 p-3 rounded-4" style="background-color: #FAF2EC; border: 1.5px solid var(--rh-peach, #EAC8B7); color: var(--rh-dark, #2B1810);">
            <div class="flex-shrink-0" aria-hidden="true">
              <i class="bi bi-clock-history fs-3 text-danger"></i>
            </div>
            <div>
              <div class="fw-bold mb-1">Your subscription expired on <%= formatDate(latestExpired.expiryDate) %>.</div>
              <div class="small" style="color: #75645C;">Renew your plan to regain exclusive discounts, ticket presales, and member privileges.</div>
            </div>
          </div>

          <!-- 100% Progress Bar -->
          <div class="my-subscriptions-progress-wrap">
            <div class="my-subscriptions-progress-labels">
              <span>Plan Validity</span>
              <span class="text-danger fw-bold">Expired (0 days left)</span>
            </div>
            <div class="my-subscriptions-progress-bar-bg" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
              <div class="my-subscriptions-progress-bar-fill" style="width: 100%; background: #9E9E9E;"></div>
            </div>
          </div>

          <!-- Metadata Grid -->
          <div class="my-subscriptions-meta-grid">
            <div class="my-subscriptions-meta-cell">
              <div class="my-subscriptions-meta-label">Started On</div>
              <div class="my-subscriptions-meta-value"><%= formatDate(latestExpired.purchaseDate) %></div>
            </div>
            <div class="my-subscriptions-meta-cell">
              <div class="my-subscriptions-meta-label">Expired On</div>
              <div class="my-subscriptions-meta-value text-danger"><%= formatDate(latestExpired.expiryDate) %></div>
            </div>
            <div class="my-subscriptions-meta-cell">
              <div class="my-subscriptions-meta-label">Last Plan Duration</div>
              <div class="my-subscriptions-meta-value"><%= latestExpired.plan ? (latestExpired.plan.duration + ' ' + (latestExpired.plan.durationUnit || 'days')) : 'N/A' %></div>
            </div>
          </div>

          <!-- Benefits Recap -->
          <% if (expiredBenefitsList.length > 0) { %>
            <div class="my-subscriptions-benefits-wrap">
              <div class="my-subscriptions-benefits-title">
                <i class="bi bi-stars text-danger"></i>
                <span>Previous Plan Benefits</span>
              </div>
              <div class="my-subscriptions-benefits-grid">
                <% expiredBenefitsList.forEach(benefit => { %>
                  <div class="my-subscriptions-benefit-pill">
                    <i class="bi bi-check-circle-fill"></i>
                    <span><%= benefit %></span>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>

        <div class="my-subscriptions-actions-strip">
          <a href="/subscriptions" class="my-subscriptions-btn-primary">
            <i class="bi bi-crown me-1"></i> Subscribe Again / Browse Plans
          </a>
        </div>
      </section>

    <% } else { %>
      <!-- =============================================================== -->
      <!-- STATE A: NO ACTIVE SUBSCRIPTION (EXACT REFERENCE MATCH)        -->
      <!-- =============================================================== -->
      <section class="my-subscriptions-empty-card" aria-labelledby="empty-heading">
        <div class="my-subscriptions-ticket-illus" aria-hidden="true">
          <svg width="110" height="74" viewBox="0 0 110 74" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Sparkle rays on top-left -->
            <path d="M22 14L16 8" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M28 8L27 2" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M38 12L42 6" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <!-- Ticket body with notches -->
            <g transform="rotate(-6 55 42)">
              <path d="M12 20C12 16.6863 14.6863 14 18 14H82C85.3137 14 88 16.6863 88 20V31C83.5817 31 80 34.5817 80 39C80 43.4183 83.5817 47 88 47V58C88 61.3137 85.3137 64 82 64H18C14.6863 64 12 61.3137 12 58V47C16.4183 47 20 43.4183 20 39C20 34.5817 16.4183 31 12 31V20Z" fill="#FFF8F3" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M32 15V63" stroke="#EAC8B7" stroke-width="2" stroke-dasharray="3 3"/>
              <!-- Crown stamped inside ticket -->
              <path d="M46 45L42 32L51 36L55 28L59 36L68 32L64 45H46Z" fill="#9F190E" stroke="#9F190E" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="42" cy="30" r="1.5" fill="#9F190E"/>
              <circle cx="55" cy="26" r="1.5" fill="#9F190E"/>
              <circle cx="68" cy="30" r="1.5" fill="#9F190E"/>
            </g>
          </svg>
        </div>
        <h2 id="empty-heading" class="my-subscriptions-empty-heading">No Active Subscription</h2>
        <p class="my-subscriptions-empty-desc">You don't have an active subscription at the moment.</p>
        <a href="/subscriptions" class="my-subscriptions-btn-primary">
          <i class="bi bi-crown me-1"></i> Browse Subscription Plans
        </a>
      </section>
    <% } %>

    <!-- ================================================================= -->
    <!-- STATE D: SUBSCRIPTION HISTORY                                     -->
    <!-- ================================================================= -->
    <% if (subscriptionHistory && subscriptionHistory.length > 0) { %>
      <section class="my-subscriptions-history-card mt-4" aria-labelledby="history-heading">
        <div class="my-subscriptions-history-header">
          <i class="bi bi-clock-history text-danger fs-5" aria-hidden="true"></i>
          <h2 id="history-heading" class="my-subscriptions-history-title">Subscription History</h2>
        </div>

        <!-- Desktop Table View -->
        <div class="d-none d-md-block rh-profile-table-wrap">
          <table class="rh-profile-table">
            <thead>
              <tr>
                <th>Plan Name</th>
                <th>Amount</th>
                <th>Purchase Date</th>
                <th>Expiry Date</th>
                <th>Status</th>
                <th>Payment / Order ID</th>
              </tr>
            </thead>
            <tbody>
              <% subscriptionHistory.forEach(subscription => { %>
                <tr>
                  <td class="fw-bold">
                    <%= subscription.plan ? subscription.plan.name : 'Unknown Plan (Deleted)' %>
                  </td>
                  <td class="fw-semibold">
                    ₹<%= subscription.amount || (subscription.plan ? subscription.plan.price : 0) %>
                  </td>
                  <td><%= formatDate(subscription.purchaseDate || subscription.createdAt) %></td>
                  <td><%= formatDate(subscription.expiryDate) %></td>
                  <td>
                    <% if (subscription.status === 'active' && new Date(subscription.expiryDate) > new Date()) { %>
                      <span class="rh-badge-completed"><i class="bi bi-check-circle-fill"></i> Active</span>
                    <% } else if (subscription.status === 'pending') { %>
                      <span class="rh-badge-pending"><i class="bi bi-hourglass-split"></i> Pending</span>
                    <% } else if (subscription.status === 'cancelled') { %>
                      <span class="rh-badge-rejected"><i class="bi bi-x-circle-fill"></i> Cancelled</span>
                    <% } else { %>
                      <span class="my-subscriptions-status-pill expired" style="padding: 2px 8px; font-size: 0.75rem;">Expired</span>
                    <% } %>
                  </td>
                  <td class="text-muted small text-truncate" style="max-width: 140px;" title="<%= subscription.paymentId || subscription.orderId || subscription._id %>">
                    <%= subscription.paymentId || subscription.orderId || subscription._id %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Mobile Stacked Card View -->
        <div class="d-md-none my-subscriptions-history-cards-mobile">
          <% subscriptionHistory.forEach(subscription => { %>
            <div class="my-subscriptions-history-item-mobile">
              <div class="my-subscriptions-him-top">
                <div class="my-subscriptions-him-title">
                  <%= subscription.plan ? subscription.plan.name : 'Unknown Plan (Deleted)' %>
                </div>
                <div>
                  <% if (subscription.status === 'active' && new Date(subscription.expiryDate) > new Date()) { %>
                    <span class="rh-badge-completed"><i class="bi bi-check-circle-fill"></i> Active</span>
                  <% } else if (subscription.status === 'pending') { %>
                    <span class="rh-badge-pending"><i class="bi bi-hourglass-split"></i> Pending</span>
                  <% } else if (subscription.status === 'cancelled') { %>
                    <span class="rh-badge-rejected"><i class="bi bi-x-circle-fill"></i> Cancelled</span>
                  <% } else { %>
                    <span class="my-subscriptions-status-pill expired" style="padding: 2px 8px; font-size: 0.72rem;">Expired</span>
                  <% } %>
                </div>
              </div>
              <div class="my-subscriptions-him-meta">
                <div><strong>Amount:</strong> ₹<%= subscription.amount || (subscription.plan ? subscription.plan.price : 0) %></div>
                <div><strong>Purchased:</strong> <%= formatDate(subscription.purchaseDate || subscription.createdAt) %></div>
                <div><strong>Expires:</strong> <%= formatDate(subscription.expiryDate) %></div>
                <% if (subscription.paymentId || subscription.orderId) { %>
                  <div class="text-truncate"><strong>Ref:</strong> <%= subscription.paymentId || subscription.orderId %></div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

  </div>
</div>

<% if (hasActiveSub) { %>
<script>
  (function() {
    if (window.self !== window.top) return;

    const countdownContainer = document.getElementById('countdown-container');
    const daysElement = document.getElementById('countdown-days');
    const hoursElement = document.getElementById('countdown-hours');
    const minutesElement = document.getElementById('countdown-minutes');
    const secondsElement = document.getElementById('countdown-seconds');
    const liveIndicator = document.getElementById('live-indicator');

    if (!countdownContainer) return;

    const expiryDate = new Date(countdownContainer.getAttribute('data-expiry'));

    let prevSeconds = -1;
    let prevMinutes = -1;
    let prevHours = -1;
    let prevDays = -1;

    function updateCountdown() {
      try {
        const now = new Date();
        const timeRemaining = expiryDate - now;

        if (timeRemaining <= 0) {
          location.reload();
          return;
        }

        const totalSeconds = Math.floor(timeRemaining / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = Math.floor(totalSeconds % 60);

        const formattedDays = days.toString().padStart(2, '0');
        const formattedHours = hours.toString().padStart(2, '0');
        const formattedMinutes = minutes.toString().padStart(2, '0');
        const formattedSeconds = seconds.toString().padStart(2, '0');

        if (daysElement && prevDays !== days) {
          daysElement.textContent = formattedDays;
          prevDays = days;
        }
        if (hoursElement && prevHours !== hours) {
          hoursElement.textContent = formattedHours;
          prevHours = hours;
        }
        if (minutesElement && prevMinutes !== minutes) {
          minutesElement.textContent = formattedMinutes;
          prevMinutes = minutes;
        }
        if (secondsElement && prevSeconds !== seconds) {
          secondsElement.textContent = formattedSeconds;
          prevSeconds = seconds;
        }

        if (liveIndicator) {
          liveIndicator.style.opacity = (Math.floor(Date.now() / 500) % 2) ? '1' : '0.3';
        }
      } catch (error) {
        console.error('Error updating countdown:', error);
      }
    }

    updateCountdown();
    const countdownInterval = setInterval(updateCountdown, 1000);

    window.addEventListener('beforeunload', function() {
      clearInterval(countdownInterval);
    });
  })();
</script>
<% } %>
