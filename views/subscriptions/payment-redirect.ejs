<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rapira - Processing Payment for <%= plan.name %> Subscription</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
  <style>
    body {
      background-color: #121212;
      color: #fff;
      font-family: 'Poppins', sans-serif;
    }
    .card {
      background-color: #1e1e1e;
      border: 1px solid #333;
    }
    .btn-primary {
      background-color: #6366f1;
      border-color: #6366f1;
    }
  </style>
</head>
<body>
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8 text-center">
        <div class="card border-secondary">
          <div class="card-body py-5">
            <div class="spinner-border text-primary mb-4" role="status" style="width: 3rem; height: 3rem;">
              <span class="visually-hidden">Loading...</span>
            </div>

            <h2 class="mb-3">Processing Your Payment</h2>
            <p class="text-muted mb-4">Please wait while we redirect you to the payment gateway...</p>

            <div class="alert alert-warning mb-4">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <strong>If the payment window doesn't open automatically:</strong>
              <ul class="mb-0 mt-2 text-start">
                <li>Check if your browser is blocking pop-ups</li>
                <li>Click the "Click here to open payment" button below</li>
                <li>Make sure you have a stable internet connection</li>
              </ul>
            </div>

            <div class="progress mb-4" style="height: 10px;">
              <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%"></div>
            </div>

            <div id="debug-info" class="alert alert-info mt-4 text-start">
              <h5>Debug Information:</h5>
              <p><strong>Key:</strong> <%= key %></p>
              <p><strong>Order ID:</strong> <%= order.id %></p>
              <p><strong>Amount:</strong> <%= order.amount %> paise (₹<%= order.amount/100 %>)</p>
              <p><strong>Plan Price:</strong> ₹<%= plan.price %></p>
              <p><strong>Subscription ID:</strong> <%= subscription %></p>
              <p class="text-muted small">Note: Razorpay requires amounts in paise (1 rupee = 100 paise). The amount shown is correct.</p>
            </div>

            <div class="d-grid gap-2 mt-3">
              <button id="manual-open" class="btn btn-lg btn-primary pulse-animation">
                <i class="bi bi-credit-card me-2"></i> Click here to open payment
              </button>

              <a href="/subscriptions/cancel-payment/<%= subscription %>" class="btn btn-outline-secondary mt-2">
                <i class="bi bi-x-circle me-2"></i> Cancel payment
              </a>
            </div>

            <style>
              .pulse-animation {
                animation: pulse 1.5s infinite;
              }
              @keyframes pulse {
                0% {
                  box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.7);
                }
                70% {
                  box-shadow: 0 0 0 10px rgba(99, 102, 241, 0);
                }
                100% {
                  box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
                }
              }
            </style>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    // Log to console for debugging
    console.log('Payment redirect page loaded');
    console.log('Key:', '<%= key %>');
    console.log('Order ID:', '<%= order.id %>');
    console.log('Amount:', '<%= order.amount %>');

    function openRazorpay() {
      console.log('Opening Razorpay...');

      // Initialize Razorpay options
      const options = {
        key: '<%= key %>',
        amount: '<%= order.amount %>',
        currency: '<%= order.currency || "INR" %>',
        name: 'Rapira',
        description: '<%= plan.name %> Subscription',
        order_id: '<%= order.id %>',
        handler: function(response) {
          console.log('Payment successful, creating verification form');

          // Create hidden form for payment verification
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = '/subscriptions/verify-payment';

          const fields = {
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_order_id: response.razorpay_order_id,
            razorpay_signature: response.razorpay_signature,
            subscription_id: '<%= subscription %>'
          };

          for (const key in fields) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = fields[key];
            form.appendChild(input);
          }

          document.body.appendChild(form);
          form.submit();
        },
        prefill: {
          name: '<%= currentUser.name %>',
          email: '<%= currentUser.email %>'
        },
        theme: {
          color: '#6366f1'
        },
        modal: {
          ondismiss: function() {
            console.log('Payment modal dismissed');
            // Redirect to cancel-payment route to mark subscription as cancelled
            window.location.href = '/subscriptions/cancel-payment/<%= subscription %>';
          }
        }
      };

      try {
        // Create Razorpay instance and open checkout
        window.rzp = new Razorpay(options);
        window.rzp.open();
        console.log('Razorpay opened successfully');
      } catch (error) {
        console.error('Error opening Razorpay:', error);
        document.getElementById('debug-info').innerHTML += '<p class="text-danger">Error: ' + error.message + '</p>';
      }
    }

    // Add event listener for manual button
    document.getElementById('manual-open').addEventListener('click', function() {
      openRazorpay();
    });

    // Try to open Razorpay automatically
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM loaded, opening Razorpay in 1 second...');
      setTimeout(openRazorpay, 1000);
    });
  </script>
</body>
</html>
