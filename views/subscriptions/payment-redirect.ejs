<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rapira - Processing Payment for <%= plan.name %> Subscription</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Titan+One&display=swap" rel="stylesheet">
  <style>
    :root {
      --rh-cream: #FCF0E4;
      --rh-card-bg: #FAF0E6;
      --rh-crimson: #9F190E;
      --rh-crimson-hover: #82140B;
      --rh-peach-border: #EAC8B7;
      --rh-text-main: #292523;
      --rh-text-muted: #75645C;
    }
    body {
      background-color: var(--rh-cream);
      color: var(--rh-text-main);
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
      margin: 0;
    }
    .rh-payment-card {
      background-color: var(--rh-card-bg);
      border: 1.5px solid var(--rh-peach-border);
      border-radius: 24px;
      box-shadow: 0 10px 32px rgba(159, 25, 14, 0.08);
      max-width: 580px;
      width: 100%;
      overflow: hidden;
      margin: 0 auto;
    }
    .rh-payment-card-body {
      padding: 2.5rem 2rem;
      text-align: center;
    }
    .rh-payment-title {
      font-family: 'Titan One', cursive, sans-serif;
      color: var(--rh-crimson);
      font-size: 1.85rem;
      margin-bottom: 0.5rem;
      line-height: 1.2;
    }
    .rh-payment-subtitle {
      color: var(--rh-text-muted);
      font-size: 0.95rem;
      margin-bottom: 1.75rem;
    }
    .rh-spinner {
      color: var(--rh-crimson) !important;
      width: 3.5rem;
      height: 3.5rem;
      border-width: 0.25rem;
      margin-bottom: 1.5rem;
    }
    .rh-payment-info-box {
      background-color: #FFFDF8;
      border: 1.5px solid var(--rh-peach-border);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      text-align: start;
      margin-bottom: 1.5rem;
    }
    .rh-payment-info-box ul {
      margin: 0.5rem 0 0 0;
      padding-left: 1.2rem;
      font-size: 0.88rem;
      color: var(--rh-text-muted);
    }
    .rh-payment-info-box ul li {
      margin-bottom: 4px;
    }
    .progress {
      background-color: #EAC8B7;
      border-radius: 9999px;
      overflow: hidden;
      height: 8px;
    }
    .progress-bar {
      background-color: var(--rh-crimson);
    }
    .rh-btn-primary {
      background-color: var(--rh-crimson);
      color: #FFFFFF;
      border-radius: 9999px;
      padding: 12px 28px;
      font-size: 0.95rem;
      font-weight: 700;
      border: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(159, 25, 14, 0.25);
      transition: all 0.2s ease;
      width: 100%;
    }
    .rh-btn-primary:hover {
      background-color: var(--rh-crimson-hover);
      color: #FFFFFF;
      transform: translateY(-1px);
    }
    .rh-btn-secondary {
      background-color: #FFFDF8;
      color: var(--rh-crimson);
      border: 1.5px solid var(--rh-peach-border);
      border-radius: 9999px;
      padding: 10px 24px;
      font-size: 0.9rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: all 0.2s ease;
      width: 100%;
    }
    .rh-btn-secondary:hover {
      background-color: var(--rh-card-bg);
      border-color: var(--rh-crimson);
      color: var(--rh-crimson);
    }
    .pulse-animation {
      animation: pulse 1.6s infinite;
    }
    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(159, 25, 14, 0.45);
      }
      70% {
        box-shadow: 0 0 0 10px rgba(159, 25, 14, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(159, 25, 14, 0);
      }
    }
  </style>
</head>
<body>
  <div class="rh-payment-card">
    <div class="rh-payment-card-body">
      <div class="spinner-border rh-spinner" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>

      <h1 class="rh-payment-title">Processing Your Payment</h1>
      <p class="rh-payment-subtitle">Please wait while we open the secure payment gateway for <strong><%= plan.name %></strong> subscription...</p>

      <div class="rh-payment-info-box">
        <div class="fw-semibold" style="color: #9F190E;">
          <i class="bi bi-info-circle-fill me-2"></i> If the payment window does not open automatically:
        </div>
        <ul>
          <li>Check if your browser is blocking pop-ups</li>
          <li>Click the "Click here to open payment" button below</li>
          <li>Ensure you have a stable internet connection</li>
        </ul>
      </div>

      <div class="progress mb-4">
        <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
      </div>

      <div class="d-flex flex-column gap-2 mt-3">
        <button id="manual-open" class="rh-btn-primary pulse-animation" type="button">
          <i class="bi bi-credit-card me-2"></i> Click here to open payment
        </button>

        <a href="/subscriptions/cancel-payment/<%= subscription %>" class="rh-btn-secondary mt-1">
          <i class="bi bi-x-circle me-2"></i> Cancel payment
        </a>
      </div>
    </div>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    function openRazorpay() {
      console.log('Opening Razorpay...');

      const options = {
        key: '<%= key %>',
        amount: '<%= order.amount %>',
        currency: '<%= order.currency || "INR" %>',
        name: 'Rapira',
        description: '<%= plan.name %> Subscription',
        order_id: '<%= order.id %>',
        handler: function(response) {
          console.log('Payment successful, creating verification form');

          const form = document.createElement('form');
          form.method = 'POST';
          form.action = '/subscriptions/verify-payment';

          const fields = {
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_order_id: response.razorpay_order_id,
            razorpay_signature: response.razorpay_signature,
            subscription_id: '<%= subscription %>'
          };

          for (const key in fields) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = fields[key];
            form.appendChild(input);
          }

          document.body.appendChild(form);
          form.submit();
        },
        prefill: {
          name: '<%= (currentUser && currentUser.name) ? currentUser.name : "" %>',
          email: '<%= (currentUser && currentUser.email) ? currentUser.email : "" %>'
        },
        theme: {
          color: '#9F190E'
        },
        modal: {
          ondismiss: function() {
            console.log('Payment modal dismissed');
            window.location.href = '/subscriptions/cancel-payment/<%= subscription %>';
          }
        }
      };

      try {
        window.rzp = new Razorpay(options);
        window.rzp.open();
        console.log('Razorpay opened successfully');
      } catch (error) {
        console.error('Error opening Razorpay:', error);
        alert('Error opening payment gateway: ' + error.message);
      }
    }

    document.getElementById('manual-open').addEventListener('click', function() {
      openRazorpay();
    });

    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM loaded, opening Razorpay in 1 second...');
      setTimeout(openRazorpay, 1000);
    });
  </script>
</body>
</html>
