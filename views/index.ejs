<!-- Main Slider Section -->
<section class="main-slider-section">
  <div id="mainCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
    </div>

    <div class="carousel-inner">
      <!-- Slide 1 - Main Hero -->
      <div class="carousel-item active">
        <div class="carousel-overlay"></div>
        <div class="carousel-bg bg-dark" style="height: 80vh; min-height: 500px;">
          <div class="carousel-pattern pattern-dots"></div>
        </div>
        <div class="carousel-caption">
          <div class="container">
            <div class="row justify-content-center">
              <div class="col-lg-8 text-center">
                <h1 class="display-3 fw-bold mb-4 animate__animated animate__fadeInDown">Experience the Best of <span class="gradient-text-purple">Indian Rap</span></h1>
                <p class="lead mb-5 animate__animated animate__fadeInUp animate__delay-1s">Discover artists, book concerts, and connect with the hip-hop community</p>
                <div class="d-flex justify-content-center gap-3 animate__animated animate__fadeInUp animate__delay-2s">
                  <a href="/concerts" class="btn btn-gradient-purple btn-lg">Explore Concerts</a>
                  <a href="/artists" class="btn btn-glass btn-lg">Discover Artists</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 2 - Featured Concert -->
      <div class="carousel-item">
        <div class="carousel-overlay"></div>
        <div class="carousel-bg bg-primary" style="height: 80vh; min-height: 500px;">
          <div class="carousel-pattern pattern-waves"></div>
        </div>
        <div class="carousel-caption">
          <div class="container">
            <div class="row justify-content-start">
              <div class="col-lg-6 text-start">
                <div class="badge bg-danger mb-3 animate__animated animate__fadeInDown">FEATURED EVENT</div>
                <h2 class="display-4 fw-bold mb-3 animate__animated animate__fadeInDown">Summer Rap Festival 2023</h2>
                <p class="lead mb-4 animate__animated animate__fadeInUp animate__delay-1s">Join the biggest hip-hop event of the year with top artists performing live!</p>
                <div class="d-flex gap-3 animate__animated animate__fadeInUp animate__delay-2s">
                  <a href="/concerts" class="btn btn-danger btn-lg">Book Now</a>
                  <div class="d-flex align-items-center">
                    <i class="bi bi-calendar-event me-2"></i> June 15-17, 2023
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 3 - Premium Subscription -->
      <div class="carousel-item">
        <div class="carousel-overlay"></div>
        <div class="carousel-bg bg-warning" style="height: 80vh; min-height: 500px;">
          <div class="carousel-pattern pattern-grid"></div>
        </div>
        <div class="carousel-caption">
          <div class="container">
            <div class="row justify-content-end">
              <div class="col-lg-6 text-end">
                <div class="badge bg-warning text-dark mb-3 animate__animated animate__fadeInDown">NEW FEATURE</div>
                <h2 class="display-4 fw-bold mb-3 animate__animated animate__fadeInDown">Go Premium</h2>
                <p class="lead mb-4 animate__animated animate__fadeInUp animate__delay-1s">Get exclusive access to VIP tickets, backstage passes, and special discounts!</p>
                <div class="animate__animated animate__fadeInUp animate__delay-2s">
                  <a href="/subscriptions" class="btn btn-warning btn-lg text-dark">Upgrade Now</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 4 - Artist Spotlight -->
      <div class="carousel-item">
        <div class="carousel-overlay"></div>
        <div class="carousel-bg bg-info" style="height: 80vh; min-height: 500px;">
          <div class="carousel-pattern pattern-circles"></div>
        </div>
        <div class="carousel-caption">
          <div class="container">
            <div class="row justify-content-center">
              <div class="col-lg-8 text-center">
                <div class="badge bg-info mb-3 animate__animated animate__fadeInDown">ARTIST SPOTLIGHT</div>
                <h2 class="display-4 fw-bold mb-3 animate__animated animate__fadeInDown">Become a Featured Artist</h2>
                <p class="lead mb-4 animate__animated animate__fadeInUp animate__delay-1s">Showcase your talent and reach thousands of fans on our platform!</p>
                <div class="animate__animated animate__fadeInUp animate__delay-2s">
                  <a href="/artists/register" class="btn btn-info btn-lg">Join as Artist</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
</section>





<!-- Upcoming Concerts Section -->
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-up">
      <h2 class="fw-bold gradient-text">Upcoming Concerts</h2>
      <a href="/concerts" class="btn btn-outline-primary">View All</a>
    </div>

    <div class="row g-4">
      <% if (upcomingConcerts && upcomingConcerts.length > 0) { %>
        <% upcomingConcerts.forEach((concert, index) => { %>
          <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
            <div class="glass-card-dark card card-concert h-100">
              <div class="position-relative overflow-hidden">
                <img src="<%= concert.posterImage %>" class="card-img-top" alt="<%= concert.title %>">
                <div class="position-absolute top-0 end-0 m-3">
                  <span class="badge <%= concert.isPaid ? 'bg-gradient-primary' : 'bg-gradient-success' %> px-3 py-2">
                    <%= concert.isPaid ? (concert.price !== null && concert.price !== undefined ? `₹${concert.price}` : '₹ 0') : 'Free' %>
                  </span>
                </div>
              </div>
              <div class="card-body">
                <h5 class="card-title fw-bold"><%= concert.title %></h5>
                <p class="card-text mb-2">
                  <i class="bi bi-geo-alt me-2"></i> <%= concert.venue && concert.venue.name ? concert.venue.name : concert.venue %>, <%= concert.city %>
                </p>
                <p class="card-text mb-3">
                  <i class="bi bi-calendar3 me-2"></i> <%= new Date(concert.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %> • <%= concert.time %>
                </p>
                <p class="card-text mb-3">By
                <% if (concert.artist) { %>
                  <a href="/artists/<%= concert.artist._id %>" class="text-decoration-none fw-medium gradient-text">
                    <%= concert.artist.user ? concert.artist.user.name : 'Unknown Artist' %>
                  </a>
                <% } else { %>
                  <span class="fw-medium">Unknown Artist</span>
                <% } %>
                </p>
              </div>
              <div class="card-footer">
                <a href="/concerts/<%= concert._id %>" class="btn btn-gradient-purple w-100">View Details</a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5" data-aos="fade-up">
          <div class="glass-card-dark p-5 rounded-4">
            <i class="bi bi-calendar-x display-1 text-muted mb-3"></i>
            <p class="text-muted">No upcoming concerts at the moment. Check back soon!</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Featured Artists Section -->
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-up">
      <h2 class="fw-bold gradient-text-blue">Featured Artists</h2>
      <a href="/artists" class="btn btn-outline-primary">View All</a>
    </div>

    <div class="row g-4">
      <% if (featuredArtists && featuredArtists.length > 0) { %>
        <% featuredArtists.forEach((artist, index) => { %>
          <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
            <div class="glass-card-dark card card-artist h-100">
              <div class="position-relative overflow-hidden">
                <img src="<%= artist.user.profileImage %>" class="card-img-top" alt="<%= artist.user.name %>">
                <% if (artist.verified) { %>
                  <div class="position-absolute top-0 end-0 m-3">
                    <span class="badge bg-gradient-blue px-3 py-2">
                      <i class="bi bi-patch-check-fill me-1"></i> Verified
                    </span>
                  </div>
                <% } %>
              </div>
              <div class="card-body text-center">
                <h5 class="card-title mb-2"><%= artist.user.name %></h5>
                <p class="card-text text-muted mb-3"><%= artist.genre %></p>
              </div>
              <div class="card-footer text-center">
                <a href="/artists/<%= artist._id %>" class="btn btn-gradient-blue w-100">View Profile</a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5" data-aos="fade-up">
          <div class="glass-card-dark p-5 rounded-4">
            <i class="bi bi-person-x display-1 text-muted mb-3"></i>
            <p class="text-muted">No featured artists at the moment. Check back soon!</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Latest Content Section -->
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-up">
      <h2 class="fw-bold gradient-text-orange">Latest Releases</h2>
      <a href="/content" class="btn btn-outline-primary">View All <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    <div class="row g-4">
      <% if (latestContent && latestContent.length > 0) { %>
        <% latestContent.forEach((content, index) => { %>
          <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
            <div class="glass-card-dark card content-card h-100">
              <div class="position-relative overflow-hidden">
                <img src="<%= content.thumbnailUrl %>" class="card-img-top content-thumbnail" alt="<%= content.title %>">
                <span class="badge <%= content.type === 'song' ? 'bg-gradient-primary' : content.type === 'video' ? 'bg-gradient-danger' : 'bg-gradient-blue' %> content-type-badge px-3 py-2">
                  <i class="bi <%= content.type === 'song' ? 'bi-music-note' : content.type === 'video' ? 'bi-camera-video' : 'bi-file-text' %> me-1"></i>
                  <%= content.type.charAt(0).toUpperCase() + content.type.slice(1) %>
                </span>
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= content.title %></h5>
                <p class="card-text text-muted">
                  By <span class="gradient-text-orange"><%= content.artist && content.artist.user ? content.artist.user.name : 'Unknown Artist' %></span>
                </p>
                <p class="card-text">
                  <small class="text-muted">
                    <i class="bi bi-calendar3 me-1"></i> <%= new Date(content.releaseDate).toLocaleDateString() %>
                  </small>
                </p>
              </div>
              <div class="card-footer bg-transparent border-0 pb-3">
                <a href="/content/<%= content._id %>"
                   class="btn btn-outline-light btn-sm w-100">
                  <%= content.type === 'song' ? 'Listen' : content.type === 'video' ? 'Watch' : 'Read' %>
                </a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5" data-aos="fade-up">
          <div class="glass-card-dark p-5 rounded-4">
            <i class="bi bi-music-note-list display-1 text-muted mb-3"></i>
            <p class="text-muted">No content available at the moment. Check back soon!</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Featured Merchandise Section -->
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-up">
      <h2 class="fw-bold gradient-text-green">Featured Merchandise</h2>
      <a href="/shop" class="btn btn-outline-primary">Shop All <i class="bi bi-bag ms-1"></i></a>
    </div>

    <div class="row g-4">
      <% if (featuredProducts && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach((product, index) => { %>
          <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
            <div class="glass-card-dark card product-card h-100">
              <div class="position-relative overflow-hidden">
                <img src="<%= product.images[0] %>" class="card-img-top product-image" alt="<%= product.name %>" style="height: 250px; object-fit: cover;">

                <!-- Featured Badge -->
                <div class="position-absolute top-0 start-0 m-3">
                  <span class="badge bg-gradient-green px-3 py-2">
                    <i class="bi bi-star-fill me-1"></i> Featured
                  </span>
                </div>

                <!-- Stock Status -->
                <% if (product.totalStock === 0) { %>
                  <div class="position-absolute top-0 end-0 m-3">
                    <span class="badge bg-danger px-3 py-2">Out of Stock</span>
                  </div>
                <% } else if (product.totalStock < 10) { %>
                  <div class="position-absolute top-0 end-0 m-3">
                    <span class="badge bg-warning px-3 py-2">Low Stock</span>
                  </div>
                <% } %>

                <!-- Discount Badge -->
                <% if (product.comparePrice && product.comparePrice > product.price) { %>
                  <div class="position-absolute bottom-0 start-0 m-3">
                    <span class="badge bg-gradient-danger px-3 py-2">
                      <%= Math.round(((product.comparePrice - product.price) / product.comparePrice) * 100) %>% OFF
                    </span>
                  </div>
                <% } %>
              </div>

              <div class="card-body">
                <h5 class="card-title mb-2"><%= product.name %></h5>
                <p class="card-text text-muted mb-2">
                  <small><%= product.category %></small>
                </p>

                <div class="d-flex align-items-center justify-content-between mb-3">
                  <div class="price-section">
                    <span class="h5 mb-0 text-success fw-bold">₹<%= product.price.toLocaleString() %></span>
                    <% if (product.comparePrice && product.comparePrice > product.price) { %>
                      <span class="text-muted text-decoration-line-through ms-2">₹<%= product.comparePrice.toLocaleString() %></span>
                    <% } %>
                  </div>

                  <% if (product.averageRating > 0) { %>
                    <div class="rating">
                      <span class="text-warning">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <i class="bi <%= i <= Math.round(product.averageRating) ? 'bi-star-fill' : 'bi-star' %>"></i>
                        <% } %>
                      </span>
                      <small class="text-muted">(<%= product.totalReviews %>)</small>
                    </div>
                  <% } %>
                </div>

                <% if (product.totalSales > 0) { %>
                  <p class="card-text">
                    <small class="text-muted">
                      <i class="bi bi-bag-check me-1"></i> <%= product.totalSales %> sold
                    </small>
                  </p>
                <% } %>
              </div>

              <div class="card-footer bg-transparent border-0 pb-3">
                <% if (product.totalStock > 0) { %>
                  <a href="/shop/product/<%= product._id %>" class="btn btn-gradient-green w-100">
                    <i class="bi bi-eye me-1"></i> View Product
                  </a>
                <% } else { %>
                  <button class="btn btn-secondary w-100" disabled>
                    <i class="bi bi-x-circle me-1"></i> Out of Stock
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5" data-aos="fade-up">
          <div class="glass-card-dark p-5 rounded-4">
            <i class="bi bi-bag-x display-1 text-muted mb-3"></i>
            <p class="text-muted">No featured merchandise at the moment. Check back soon!</p>
            <a href="/shop" class="btn btn-outline-primary mt-3">Browse All Products</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>





