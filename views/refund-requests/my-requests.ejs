<div class="rapira-profile-page">
  <div class="container">
    <div class="rh-subpage-container" style="max-width: 920px;">
      
      <!-- Page Navigation Header -->
      <div class="rh-page-header-nav">
        <div class="rh-page-header-left">
          <a href="/users/profile" class="rh-back-circle-btn" title="Back to Profile">
            <i class="bi bi-arrow-left"></i>
          </a>
          <h1 class="rh-page-title">My Refund Requests</h1>
        </div>
        <a href="/tickets" class="rh-btn-secondary">
          <i class="bi bi-ticket-perforated me-1"></i> View My Tickets
        </a>
      </div>

      <% if (refundRequests && refundRequests.length > 0) { %>
        <div class="d-flex flex-column gap-3">
          <% refundRequests.forEach(request => { %>
            <div class="rh-list-item-card mb-0">
              <div class="rh-list-item-left">
                <div class="rh-list-item-icon-box">
                  <i class="bi bi-arrow-counterclockwise"></i>
                </div>
                <div>
                  <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <h3 class="rh-list-item-title mb-0 font-monospace">Refund #<%= request._id.toString().slice(-6).toUpperCase() %></h3>
                    <span class="badge bg-light text-dark border">₹<%= request.amount %></span>
                  </div>

                  <div class="rh-list-item-sub">
                    <span class="fw-semibold text-dark"><%= request.concert ? request.concert.title : 'Concert' %></span>
                    <% if (request.ticket && request.ticket.ticketNumber) { %>
                      <span class="mx-2">&bull;</span>
                      <span>Ticket: <%= request.ticket.ticketNumber %></span>
                    <% } %>
                  </div>

                  <div class="small text-muted mt-1">
                    Requested on: <%= toISTDateString(request.createdAt) %>
                    <% if (request.status === 'approved' && request.refundedAt) { %>
                      <span class="text-success ms-2">(Processed: <%= toISTDateString(request.refundedAt) %>)</span>
                    <% } %>
                    <% if (request.status === 'rejected' && request.adminNotes) { %>
                      <span class="text-danger ms-2">(Reason: <%= request.adminNotes %>)</span>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="rh-list-item-right flex-wrap">
                <% if (request.status === 'pending') { %>
                  <span class="rh-badge-pending">
                    <i class="bi bi-clock-fill"></i> Processing
                  </span>
                <% } else if (request.status === 'approved') { %>
                  <span class="rh-badge-completed">
                    <i class="bi bi-check-circle-fill"></i> Approved
                  </span>
                <% } else if (request.status === 'rejected') { %>
                  <span class="rh-badge-rejected">
                    <i class="bi bi-x-circle-fill"></i> Rejected
                  </span>
                <% } %>

                <a href="/refund-requests/view/<%= request._id %>" class="rh-btn-outline-view">
                  <i class="bi bi-eye"></i> Details
                </a>

                <% if (request.status === 'approved' && request.ticket) { %>
                  <a href="/tickets/<%= request.ticket._id %>/download" class="rh-btn-secondary py-1 px-3 small" title="Download PDF Receipt">
                    <i class="bi bi-download"></i>
                  </a>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <!-- Empty State -->
        <div class="rh-form-card text-center py-5">
          <div class="rh-sub-sketch-icon mb-3" aria-hidden="true">
            <i class="bi bi-inbox text-danger display-4"></i>
          </div>
          <h2 class="fs-4 fw-bold text-dark mb-2">No Refund Requests</h2>
          <p class="text-muted mb-4">You haven't submitted any ticket refund requests.</p>
          <a href="/tickets" class="rh-btn-primary">View My Tickets</a>
        </div>
      <% } %>

    </div>
  </div>
</div>
