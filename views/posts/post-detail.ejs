<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= artist.stageName %> - Post</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    * {
      box-sizing: border-box;
    }
    
    body {
      background: linear-gradient(135deg, #1a1a2e 0%, #0f0f1e 100%);
      color: #fff;
      min-height: 100vh;
      overflow-x: hidden;
    }
    
    .container, .container-fluid {
      max-width: 100%;
      overflow-x: hidden;
    }
    
    img {
      max-width: 100%;
      height: auto;
    }
    
    .post-container {
      background: #1a1a2e;
      border-radius: 16px;
      border: 1px solid #333;
      overflow: hidden;
      max-width: 100%;
    }
    
    .post-media {
      width: 100%;
      max-width: 100%;
      max-height: 70vh;
      height: auto;
      object-fit: contain;
      background: #000;
      display: block;
    }
    
    /* Ensure images are fully responsive */
    .post-media[alt="post"] {
      max-width: 100% !important;
      width: 100% !important;
      height: auto !important;
    }
    
    @media (max-width: 768px) {
      .post-media {
        max-height: 50vh;
      }
    }
    
    @media (max-width: 480px) {
      .post-media {
        max-height: 40vh;
      }
    }
    
    .post-info {
      padding: 30px;
    }
    
    @media (max-width: 768px) {
      .post-info {
        padding: 20px;
      }
    }
    
    @media (max-width: 480px) {
      .post-info {
        padding: 15px;
      }
    }
    
    .post-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 25px;
      padding-bottom: 20px;
      border-bottom: 1px solid #333;
    }
    
    @media (max-width: 480px) {
      .post-header {
        margin-bottom: 15px;
        padding-bottom: 15px;
      }
    }
    
    .artist-avatar {
      width: 50px;
      height: 50px;
      min-width: 50px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #00d4ff;
    }
    
    @media (max-width: 480px) {
      .artist-avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
      }
    }
    
    .artist-info h6 {
      margin: 0;
      font-weight: 600;
      font-size: 1rem;
    }
    
    @media (max-width: 480px) {
      .artist-info h6 {
        font-size: 0.9rem;
      }
    }
    
    .artist-info p {
      margin: 0;
      font-size: 0.9rem;
      color: #999;
    }
    
    @media (max-width: 480px) {
      .artist-info p {
        font-size: 0.8rem;
      }
    }
    
    .post-caption {
      font-size: 1.1rem;
      margin-bottom: 15px;
      line-height: 1.6;
      word-wrap: break-word;
    }
    
    @media (max-width: 768px) {
      .post-caption {
        font-size: 1rem;
      }
    }
    
    @media (max-width: 480px) {
      .post-caption {
        font-size: 0.95rem;
        margin-bottom: 10px;
      }
    }
    
    .post-hashtags {
      margin-bottom: 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    
    @media (max-width: 480px) {
      .post-hashtags {
        margin-bottom: 15px;
      }
    }
    
    .post-hashtags span {
      color: #00d4ff;
      font-size: 0.95rem;
      word-break: break-word;
    }
    
    @media (max-width: 480px) {
      .post-hashtags span {
        font-size: 0.85rem;
      }
    }
    
    .post-stats {
      display: flex;
      gap: 30px;
      margin-bottom: 25px;
      padding: 15px 0;
      border-top: 1px solid #333;
      border-bottom: 1px solid #333;
      justify-content: space-around;
    }
    
    @media (max-width: 768px) {
      .post-stats {
        gap: 15px;
        margin-bottom: 20px;
      }
    }
    
    @media (max-width: 480px) {
      .post-stats {
        gap: 10px;
        margin-bottom: 15px;
        padding: 12px 0;
      }
    }
    
    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
      text-align: center;
    }
    
    .stat-item i {
      font-size: 1.3rem;
      margin-bottom: 5px;
      color: #00d4ff;
    }
    
    @media (max-width: 480px) {
      .stat-item i {
        font-size: 1.1rem;
        margin-bottom: 3px;
      }
    }
    
    .stat-item strong {
      font-size: 1.2rem;
    }
    
    @media (max-width: 480px) {
      .stat-item strong {
        font-size: 1rem;
      }
    }
    
    .stat-item small {
      font-size: 0.75rem;
      color: #999;
    }
    
    @media (max-width: 480px) {
      .stat-item small {
        font-size: 0.7rem;
      }
    }
    
    .action-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    
    .btn-action {
      flex: 1;
      min-width: 120px;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #00d4ff;
      background: transparent;
      color: #00d4ff;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      font-size: 0.95rem;
    }
    
    @media (max-width: 768px) {
      .btn-action {
        padding: 10px;
        font-size: 0.9rem;
        min-width: 100px;
      }
    }
    
    @media (max-width: 480px) {
      .btn-action {
        padding: 8px;
        font-size: 0.85rem;
        min-width: 90px;
        flex: 1 1 calc(50% - 5px);
      }
    }
    
    .btn-action:hover {
      background: #00d4ff;
      color: #000;
    }
    
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: transparent;
      border: 1px solid #444;
      color: #fff;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s;
      margin-bottom: 30px;
      text-decoration: none;
      font-size: 0.95rem;
    }
    
    @media (max-width: 480px) {
      .back-btn {
        padding: 6px 12px;
        font-size: 0.85rem;
        margin-bottom: 20px;
      }
    }
    
    .back-btn:hover {
      border-color: #00d4ff;
      color: #00d4ff;
    }
    
    .login-message {
      margin-top: 20px;
      padding: 15px;
      background: #333;
      border-radius: 8px;
      text-align: center;
    }
    
    @media (max-width: 480px) {
      .login-message {
        margin-top: 15px;
        padding: 12px;
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>
  <div class="container-fluid py-4">
    <div class="container">
      <!-- Back Button -->
      <a href="javascript:history.back()" class="back-btn">
        <i class="bi bi-chevron-left"></i> Back to Profile
      </a>

      <!-- Post Container -->
      <div class="row g-4 g-md-3 g-lg-4">
        <!-- Media Column -->
        <div class="col-12 col-lg-7" style="max-width: 100%; overflow: hidden;">
          <div class="post-container" style="max-width: 100%;">
            <% if (post.media && post.media.mediaType === 'image') { %>
              <img src="<%= post.media.url %>" alt="post" class="post-media" style="max-width: 100%; width: 100%; height: auto; display: block;">
            <% } else if (post.media && post.media.mediaType === 'video') { %>
              <video controls class="post-media" style="width: 100%; max-width: 100%; height: auto; display: block;">
                <source src="<%= post.media.url %>">
              </video>
            <% } %>
          </div>
        </div>

        <!-- Info Column -->
        <div class="col-12 col-lg-5">
          <div class="post-container post-info">
            <!-- Artist Header -->
            <div class="post-header">
              <% if (artist.profileImage) { %>
                <img src="<%= artist.profileImage %>" alt="artist" class="artist-avatar">
              <% } else { %>
                <div class="artist-avatar" style="background: #444; display: flex; align-items: center; justify-content: center;">
                  <i class="bi bi-person-fill" style="font-size: 24px;"></i>
                </div>
              <% } %>
              <div class="artist-info">
                <h6><%= artist.stageName %></h6>
                <p><%= artist.genre || 'Artist' %></p>
              </div>
            </div>

            <!-- Caption -->
            <% if (post.caption) { %>
              <p class="post-caption"><%= post.caption %></p>
            <% } %>

            <!-- Hashtags -->
            <% if (post.hashtags && post.hashtags.length > 0) { %>
              <div class="post-hashtags">
                <% post.hashtags.forEach(tag => { %>
                  <span>#<%= tag %></span>
                <% }); %>
              </div>
            <% } %>

            <!-- Stats -->
            <div class="post-stats">
              <div class="stat-item">
                <i class="bi bi-heart-fill"></i>
                <strong id="likesCount"><%= post.likesCount || 0 %></strong>
                <small>Likes</small>
              </div>
              <div class="stat-item">
                <i class="bi bi-share"></i>
                <strong id="sharesCount"><%= post.shares || 0 %></strong>
                <small>Shares</small>
              </div>
              <div class="stat-item">
                <i class="bi bi-calendar-event"></i>
                <strong><%= new Date(post.createdAt).toLocaleDateString() %></strong>
                <small>Posted</small>
              </div>
            </div>

            <!-- Action Buttons - Icon Only -->
            <div class="action-buttons" style="display: flex; gap: 20px; align-items: center; justify-content: center; padding: 20px 0;">
              <!-- Like Button -->
              <button id="likeBtn" style="background: rgba(255, 255, 255, 0.05); border: 2px solid rgba(255, 255, 255, 0.2); cursor: pointer; padding: 15px; transition: all 0.3s ease; border-radius: 50%; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;" onmouseover="this.style.background='rgba(255, 23, 68, 0.1)'; this.style.borderColor='#ff1744';" onmouseout="this.style.background='rgba(255, 255, 255, 0.05)'; this.style.borderColor='rgba(255, 255, 255, 0.2)';">
                <i class="bi bi-heart" style="font-size: 1.8rem; color: #fff; pointer-events: none;"></i>
              </button>
              
              <!-- Share Button -->
              <button id="shareBtn" style="background: rgba(0, 212, 255, 0.1); border: 2px solid rgba(0, 212, 255, 0.3); cursor: pointer; padding: 15px; transition: all 0.3s ease; border-radius: 50%; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;" onmouseover="this.style.background='rgba(0, 212, 255, 0.2)'; this.style.borderColor='#00d4ff';" onmouseout="this.style.background='rgba(0, 212, 255, 0.1)'; this.style.borderColor='rgba(0, 212, 255, 0.3)';">
                <i class="bi bi-share" style="font-size: 1.8rem; color: #00d4ff; pointer-events: none;"></i>
              </button>
            </div>

            <!-- Login Message (if not logged in) -->
            <% if (!user) { %>
              <div class="login-message">
                <p class="mb-0 text-muted">Please log in to like and share posts</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // CRITICAL: Prevent global stories.js from interfering
    window.IS_POST_DETAIL_PAGE = true;
    
    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', function() {
      console.log('[POST DETAIL] DOM loaded, initializing...');
      
      const postId = '<%= post._id %>';
      const userId = '<%= (typeof user !== "undefined" && user && user._id) ? user._id : "" %>';
      let isLiked = false;
      let isProcessing = false;
      
      // Check initial like status
      (() => {
        const likes = <%- JSON.stringify(post.likes || []) %>;
        isLiked = userId && Array.isArray(likes) && likes.some(l => {
          const likeId = typeof l === 'string' ? l : (l._id || l);
          return likeId.toString() === userId.toString();
        });
        console.log('[POST DETAIL] Initial like status:', isLiked);
        updateLikeButton();
      })();
      
      function updateLikeButton() {
        const likeBtn = document.getElementById('likeBtn');
        const likeIcon = likeBtn?.querySelector('i');
        if (!likeBtn || !likeIcon) return;
        
        if (isLiked) {
          likeIcon.className = 'bi bi-heart-fill';
          likeIcon.style.color = '#ff1744';
          likeBtn.style.background = 'rgba(255, 23, 68, 0.15)';
          likeBtn.style.borderColor = '#ff1744';
        } else {
          likeIcon.className = 'bi bi-heart';
          likeIcon.style.color = '#fff';
          likeBtn.style.background = 'rgba(255, 255, 255, 0.05)';
          likeBtn.style.borderColor = 'rgba(255, 255, 255, 0.2)';
        }
      }
      
      // Define like function
      async function postToggleLike() {
        console.log('[POST DETAIL] postToggleLike called for postId:', postId);
        
        if (!userId) {
          showToast('Please log in to like posts', 'info');
          return;
        }
        
        if (isProcessing) return;
        isProcessing = true;
        
        const likeBtn = document.getElementById('likeBtn');
        likeBtn.disabled = true;

        try {
          const endpoint = `/posts/${postId}/like`;
          console.log('[POST DETAIL] Calling endpoint:', endpoint);
          
          const res = await fetch(endpoint, { 
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          
          console.log('[POST DETAIL] Response status:', res.status);
          
          if (!res.ok) throw new Error('Network error');
          
          const data = await res.json();
          console.log('[POST DETAIL] Response data:', data);
          
          if (data.success) {
            document.getElementById('likesCount').textContent = data.likesCount;
            isLiked = data.liked;
            updateLikeButton();
            
            // Animate
            likeBtn.style.animation = 'heartBeat 0.5s ease';
            setTimeout(() => likeBtn.style.animation = '', 500);
            
            showToast(data.liked ? '❤️ Liked!' : 'Unliked', 'success');
          } else {
            showToast(data.message || 'Failed to like', 'error');
          }
        } catch (err) {
          console.error('[POST DETAIL] Like error:', err);
          showToast('Failed to like post', 'error');
        } finally {
          isProcessing = false;
          likeBtn.disabled = false;
        }
      }

      // Define share function
      async function postSharePost() {
        console.log('[POST DETAIL] postSharePost called');
        
        try {
          const res = await fetch(`/posts/${postId}/share`, { 
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          
          if (res.ok) {
            const data = await res.json();
            if (data.success) {
              document.getElementById('sharesCount').textContent = data.shares;
            }
          }
        } catch (err) {
          console.error('[POST DETAIL] Share API error:', err);
        }
        
        const url = window.location.href;
        const title = 'Check out this post on RAPIRA';
        const text = '<%= (post.caption || "Check out this post!").substring(0, 100).replace(/'/g, "\\'").replace(/\n/g, " ") %>';
        
        if (navigator.share) {
          try {
            await navigator.share({ title, text, url });
            showToast('📤 Shared!', 'success');
          } catch (err) {
            if (err.name !== 'AbortError') {
              console.log('[POST DETAIL] Native share failed, using clipboard');
              copyToClipboard(url);
            }
          }
        } else {
          copyToClipboard(url);
        }
      }
      
      function copyToClipboard(url) {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(() => {
            showToast('🔗 Link copied!', 'success');
          }).catch(() => {
            showToast('Failed to copy link', 'error');
          });
        } else {
          showToast('Share not supported', 'info');
        }
      }
      
      function showToast(message, type) {
        const colors = {
          success: '#10b981',
          error: '#ef4444',
          info: '#3b82f6'
        };
        
        const toast = document.createElement('div');
        toast.style.cssText = `
          position: fixed;
          top: 20px;
          right: 20px;
          z-index: 9999;
          background: ${colors[type] || colors.info};
          color: white;
          padding: 16px 24px;
          border-radius: 12px;
          box-shadow: 0 4px 20px rgba(0,0,0,0.3);
          font-weight: 600;
          animation: slideIn 0.3s ease-out;
        `;
        toast.textContent = message;
        document.body.appendChild(toast);
        
        setTimeout(() => {
          toast.style.animation = 'slideOut 0.3s ease-out';
          setTimeout(() => toast.remove(), 300);
        }, 2500);
      }
      
      // Add animations
      const style = document.createElement('style');
      style.textContent = `
        @keyframes heartBeat {
          0%, 100% { transform: scale(1); }
          25% { transform: scale(1.3); }
          50% { transform: scale(1.1); }
          75% { transform: scale(1.25); }
        }
        @keyframes slideIn {
          from { transform: translateX(400px); opacity: 0; }
          to { transform: translateX(0); opacity: 1; }
        }
        @keyframes slideOut {
          from { transform: translateX(0); opacity: 1; }
          to { transform: translateX(400px); opacity: 0; }
        }
        button:hover {
          transform: scale(1.15) !important;
        }
        button:active {
          transform: scale(0.95) !important;
        }
      `;
      document.head.appendChild(style);
      
      // Attach event listeners to buttons
      const likeBtn = document.getElementById('likeBtn');
      const shareBtn = document.getElementById('shareBtn');
      
      console.log('[POST DETAIL] Like button found:', !!likeBtn);
      console.log('[POST DETAIL] Share button found:', !!shareBtn);
      
      if (likeBtn) {
        likeBtn.addEventListener('click', postToggleLike);
        console.log('[POST DETAIL] Like button listener attached');
      } else {
        console.error('[POST DETAIL] Like button not found!');
      }
      
      if (shareBtn) {
        shareBtn.addEventListener('click', postSharePost);
        console.log('[POST DETAIL] Share button listener attached');
      } else {
        console.error('[POST DETAIL] Share button not found!');
      }
    });
  </script>
</body>
</html>
