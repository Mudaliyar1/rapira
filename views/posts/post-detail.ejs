<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= artist.stageName %> - Post</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #1a1a2e 0%, #0f0f1e 100%);
      color: #fff;
      min-height: 100vh;
    }
    
    .post-container {
      background: #1a1a2e;
      border-radius: 16px;
      border: 1px solid #333;
      overflow: hidden;
    }
    
    .post-media {
      width: 100%;
      max-height: 70vh;
      object-fit: contain;
      background: #000;
    }
    
    @media (max-width: 768px) {
      .post-media {
        max-height: 50vh;
      }
    }
    
    @media (max-width: 480px) {
      .post-media {
        max-height: 40vh;
      }
    }
    
    .post-info {
      padding: 30px;
    }
    
    @media (max-width: 768px) {
      .post-info {
        padding: 20px;
      }
    }
    
    @media (max-width: 480px) {
      .post-info {
        padding: 15px;
      }
    }
    
    .post-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 25px;
      padding-bottom: 20px;
      border-bottom: 1px solid #333;
    }
    
    @media (max-width: 480px) {
      .post-header {
        margin-bottom: 15px;
        padding-bottom: 15px;
      }
    }
    
    .artist-avatar {
      width: 50px;
      height: 50px;
      min-width: 50px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #00d4ff;
    }
    
    @media (max-width: 480px) {
      .artist-avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
      }
    }
    
    .artist-info h6 {
      margin: 0;
      font-weight: 600;
      font-size: 1rem;
    }
    
    @media (max-width: 480px) {
      .artist-info h6 {
        font-size: 0.9rem;
      }
    }
    
    .artist-info p {
      margin: 0;
      font-size: 0.9rem;
      color: #999;
    }
    
    @media (max-width: 480px) {
      .artist-info p {
        font-size: 0.8rem;
      }
    }
    
    .post-caption {
      font-size: 1.1rem;
      margin-bottom: 15px;
      line-height: 1.6;
      word-wrap: break-word;
    }
    
    @media (max-width: 768px) {
      .post-caption {
        font-size: 1rem;
      }
    }
    
    @media (max-width: 480px) {
      .post-caption {
        font-size: 0.95rem;
        margin-bottom: 10px;
      }
    }
    
    .post-hashtags {
      margin-bottom: 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    
    @media (max-width: 480px) {
      .post-hashtags {
        margin-bottom: 15px;
      }
    }
    
    .post-hashtags span {
      color: #00d4ff;
      font-size: 0.95rem;
      word-break: break-word;
    }
    
    @media (max-width: 480px) {
      .post-hashtags span {
        font-size: 0.85rem;
      }
    }
    
    .post-stats {
      display: flex;
      gap: 30px;
      margin-bottom: 25px;
      padding: 15px 0;
      border-top: 1px solid #333;
      border-bottom: 1px solid #333;
      justify-content: space-around;
    }
    
    @media (max-width: 768px) {
      .post-stats {
        gap: 15px;
        margin-bottom: 20px;
      }
    }
    
    @media (max-width: 480px) {
      .post-stats {
        gap: 10px;
        margin-bottom: 15px;
        padding: 12px 0;
      }
    }
    
    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
      text-align: center;
    }
    
    .stat-item i {
      font-size: 1.3rem;
      margin-bottom: 5px;
      color: #00d4ff;
    }
    
    @media (max-width: 480px) {
      .stat-item i {
        font-size: 1.1rem;
        margin-bottom: 3px;
      }
    }
    
    .stat-item strong {
      font-size: 1.2rem;
    }
    
    @media (max-width: 480px) {
      .stat-item strong {
        font-size: 1rem;
      }
    }
    
    .stat-item small {
      font-size: 0.75rem;
      color: #999;
    }
    
    @media (max-width: 480px) {
      .stat-item small {
        font-size: 0.7rem;
      }
    }
    
    .action-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    
    .btn-action {
      flex: 1;
      min-width: 120px;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #00d4ff;
      background: transparent;
      color: #00d4ff;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      font-size: 0.95rem;
    }
    
    @media (max-width: 768px) {
      .btn-action {
        padding: 10px;
        font-size: 0.9rem;
        min-width: 100px;
      }
    }
    
    @media (max-width: 480px) {
      .btn-action {
        padding: 8px;
        font-size: 0.85rem;
        min-width: 90px;
        flex: 1 1 calc(50% - 5px);
      }
    }
    
    .btn-action:hover {
      background: #00d4ff;
      color: #000;
    }
    
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: transparent;
      border: 1px solid #444;
      color: #fff;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s;
      margin-bottom: 30px;
      text-decoration: none;
      font-size: 0.95rem;
    }
    
    @media (max-width: 480px) {
      .back-btn {
        padding: 6px 12px;
        font-size: 0.85rem;
        margin-bottom: 20px;
      }
    }
    
    .back-btn:hover {
      border-color: #00d4ff;
      color: #00d4ff;
    }
    
    .login-message {
      margin-top: 20px;
      padding: 15px;
      background: #333;
      border-radius: 8px;
      text-align: center;
    }
    
    @media (max-width: 480px) {
      .login-message {
        margin-top: 15px;
        padding: 12px;
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>
  <div class="container-fluid py-4">
    <div class="container">
      <!-- Back Button -->
      <a href="javascript:history.back()" class="back-btn">
        <i class="bi bi-chevron-left"></i> Back to Profile
      </a>

      <!-- Post Container -->
      <div class="row g-4 g-md-3 g-lg-4">
        <!-- Media Column -->
        <div class="col-12 col-lg-7">
          <div class="post-container">
            <% if (post.media && post.media.mediaType === 'image') { %>
              <img src="<%= post.media.url %>" alt="post" class="post-media">
            <% } else if (post.media && post.media.mediaType === 'video') { %>
              <video controls class="post-media" style="width: 100%;">
                <source src="<%= post.media.url %>">
              </video>
            <% } %>
          </div>
        </div>

        <!-- Info Column -->
        <div class="col-12 col-lg-5">
          <div class="post-container post-info">
            <!-- Artist Header -->
            <div class="post-header">
              <% if (artist.profileImage) { %>
                <img src="<%= artist.profileImage %>" alt="artist" class="artist-avatar">
              <% } else { %>
                <div class="artist-avatar" style="background: #444; display: flex; align-items: center; justify-content: center;">
                  <i class="bi bi-person-fill" style="font-size: 24px;"></i>
                </div>
              <% } %>
              <div class="artist-info">
                <h6><%= artist.stageName %></h6>
                <p><%= artist.genre || 'Artist' %></p>
              </div>
            </div>

            <!-- Caption -->
            <% if (post.caption) { %>
              <p class="post-caption"><%= post.caption %></p>
            <% } %>

            <!-- Hashtags -->
            <% if (post.hashtags && post.hashtags.length > 0) { %>
              <div class="post-hashtags">
                <% post.hashtags.forEach(tag => { %>
                  <span>#<%= tag %></span>
                <% }); %>
              </div>
            <% } %>

            <!-- Stats -->
            <div class="post-stats">
              <div class="stat-item">
                <i class="bi bi-heart-fill"></i>
                <strong id="likesCount"><%= post.likesCount || 0 %></strong>
                <small>Likes</small>
              </div>
              <div class="stat-item">
                <i class="bi bi-share"></i>
                <strong id="sharesCount"><%= post.shares || 0 %></strong>
                <small>Shares</small>
              </div>
              <div class="stat-item">
                <i class="bi bi-calendar-event"></i>
                <strong><%= new Date(post.createdAt).toLocaleDateString() %></strong>
                <small>Posted</small>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
              <button class="btn-action" id="likeBtn" onclick="toggleLike('<%= post._id %>')">
                <i class="bi bi-heart"></i> Like
              </button>
              <button class="btn-action" onclick="sharePost()">
                <i class="bi bi-share"></i> Share
              </button>
            </div>

            <!-- Login Message (if not logged in) -->
            <% if (!user) { %>
              <div class="login-message">
                <p class="mb-0 text-muted">Please log in to like and share posts</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const postId = '<%= post._id %>';
    const userId = '<%= (typeof user !== "undefined" && user && user._id) ? user._id : "" %>';
    const likes = <%- JSON.stringify(post.likes || []) %>;
    
    // Check if current user has liked
    function updateLikeButton() {
      const likeBtn = document.getElementById('likeBtn');
      const isLiked = userId && likes.some(l => l._id === userId || l === userId);
      if (isLiked) {
        likeBtn.innerHTML = '<i class="bi bi-heart-fill" style="color: #ff1744;"></i> Unlike';
        likeBtn.style.borderColor = '#ff1744';
        likeBtn.style.color = '#ff1744';
      }
    }
    
    async function toggleLike(id) {
      if (!userId) {
        alert('Please log in to like posts');
        return;
      }

      try {
        const res = await fetch(`/posts/${id}/like`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          document.getElementById('likesCount').textContent = data.likesCount;
          likes.length = 0;
          (data.likes || []).forEach(l => likes.push(l));
          updateLikeButton();
        }
      } catch (err) {
        console.error('Like error:', err);
        alert('Failed to like post');
      }
    }

    function sharePost() {
      const url = window.location.href;
      if (navigator.share) {
        navigator.share({
          title: 'Check out this post',
          url: url
        });
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          alert('Link copied to clipboard!');
        });
      }
    }

    // Initialize
    updateLikeButton();
  </script>
</body>
</html>
