<% if (locals.artist) { %>
<%- include('../partials/artist-header') %>
<% } else { %>
<%- contentFor('body') %>
<% } %>
<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center mb-5">
        <h1 class="fw-bold mb-3">Learning Center</h1>
        <p class="lead">Enhance your skills and knowledge with our curated learning modules</p>

        <% if (artist) { %>
          <div class="d-inline-block mt-3">
            <div class="badge bg-primary p-2 fs-6">
              <i class="bi bi-person-badge me-1"></i> <%= artistLevel %> Artist
            </div>
          </div>

          <% if (artistLevel === 'Beginner' && artist.completedLearning) { %>
            <div class="alert mt-4" style="color: #000; background-color: white; border: 1px solid #ddd;">
              <h5 class="alert-heading" style="color: #000;"><i class="bi bi-check-circle-fill me-2" style="color: #28a745;"></i> Learning Completed!</h5>
              <p class="mb-0" style="color: #000;">You have completed all required learning modules. You can now request to upgrade to Intermediate Artist level.</p>

              <% if (pendingUpgradeRequest && pendingUpgradeRequest.currentLevel === 'Beginner') { %>
                <div class="alert alert-warning mt-3" style="color: #000;">
                  <h6 class="alert-heading" style="color: #000;"><i class="bi bi-hourglass-split me-2"></i> Upgrade Request Pending</h6>
                  <p class="mb-0" style="color: #000;">You have already submitted a request to upgrade to Intermediate Artist level on <%= toISTDateString(pendingUpgradeRequest.createdAt) %>. Your request is currently under review.</p>
                  <a href="/artist-upgrade/pending" class="btn btn-warning btn-sm mt-2" style="color: #000;">
                    <i class="bi bi-eye me-1"></i> View Request Details
                  </a>
                </div>
              <% } else { %>
                <a href="/artist-upgrade/request" class="btn btn-success mt-3">
                  <i class="bi bi-arrow-up-circle me-2"></i> Request Upgrade to Intermediate
                </a>
              <% } %>
            </div>
          <% } else if (artistLevel === 'Beginner' && !artist.completedLearning) { %>
            <div class="alert alert-info mt-4" style="color: #000;">
              <h5 class="alert-heading" style="color: #000;"><i class="bi bi-info-circle-fill me-2"></i> Complete Your Learning</h5>
              <p class="mb-0" style="color: #000;">As a Beginner Artist, you need to complete all required learning modules before you can create concerts or upgrade to Intermediate level.</p>
            </div>
          <% } else if (artistLevel === 'Intermediate' && artist.completedLearning) { %>
            <div class="alert mt-4" style="color: #000; background-color: white; border: 1px solid #ddd;">
              <h5 class="alert-heading" style="color: #000;"><i class="bi bi-mortarboard-fill me-2" style="color: #28a745;"></i> Learning Completed!</h5>
              <p class="mb-0" style="color: #000;">You have completed all required learning modules for Intermediate level. You can now request to upgrade to Established Artist level.</p>

              <% if (pendingUpgradeRequest && pendingUpgradeRequest.currentLevel === 'Intermediate') { %>
                <div class="alert alert-warning mt-3" style="color: #000;">
                  <h6 class="alert-heading" style="color: #000;"><i class="bi bi-hourglass-split me-2"></i> Upgrade Request Pending</h6>
                  <p class="mb-0" style="color: #000;">You have already submitted a request to upgrade to Established Artist level on <%= toISTDateString(pendingUpgradeRequest.createdAt) %>. Your request is currently under review.</p>
                  <a href="/artist-upgrade/pending" class="btn btn-warning btn-sm mt-2" style="color: #000;">
                    <i class="bi bi-eye me-1"></i> View Request Details
                  </a>
                </div>
              <% } else { %>
                <a href="/artist-upgrade/request" class="btn btn-success mt-3">
                  <i class="bi bi-arrow-up-circle me-2"></i> Request Upgrade to Established
                </a>
              <% } %>
            </div>
          <% } else if (artistLevel === 'Intermediate' && !artist.completedLearning) { %>
            <div class="alert alert-info mt-4" style="color: #000;">
              <h5 class="alert-heading" style="color: #000;"><i class="bi bi-mortarboard-fill me-2"></i> Intermediate Artist</h5>
              <p class="mb-0" style="color: #000;">As an Intermediate Artist, you can create concerts and continue learning to improve your skills. Complete all required modules to upgrade to Established level.</p>
            </div>
          <% } else if (artistLevel === 'Established') { %>
            <div class="alert alert-primary mt-4" style="color: #fff !important;">
              <h5 class="alert-heading" style="color: #fff !important;"><i class="bi bi-trophy-fill me-2"></i> Established Artist</h5>
              <p class="mb-0" style="color: #fff !important;">As an Established Artist, you have access to all platform features. Continue learning to enhance your skills further.</p>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>

    <div class="row g-4">
      <% if (modules && modules.length > 0) { %>
        <% modules.forEach(module => { %>
          <div class="col-md-6 col-lg-4">
            <div class="glass-card-dark h-100">
              <div class="position-relative">
                <img src="<%= module.thumbnailImage %>" class="card-img-top" alt="<%= module.title %>">
                <div class="position-absolute top-0 end-0 m-2">
                  <% if (completedModules[module._id]) { %>
                    <span class="badge bg-success p-2">
                      <i class="bi bi-check-circle-fill me-1"></i> Completed
                    </span>
                  <% } else if (module.isRequired) { %>
                    <span class="badge bg-warning p-2">
                      <i class="bi bi-star-fill me-1"></i> Required
                    </span>
                  <% } %>
                </div>
                <div class="position-absolute bottom-0 start-0 m-2">
                  <span class="badge bg-primary p-2">
                    <i class="bi bi-person-badge me-1"></i> <%= module.forArtistLevel %>
                  </span>
                </div>
              </div>
              <div class="card-body">
                <h5 class="card-title text-white"><%= module.title %></h5>
                <p class="card-text text-white-75"><%= module.description %></p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <div class="d-flex gap-2 flex-wrap">
                    <% 
                      const itemsToShow = (module.contentItems && module.contentItems.length > 0) ? module.contentItems : 
                                         [{type: module.contentType || 'text'}];
                      itemsToShow.forEach(item => {
                    %>
                      <span class="badge" style="background-color: <%= item.type === 'video' ? '#3b82f6' : item.type === 'pdf' ? '#ef4444' : item.type === 'image' ? '#8b5cf6' : item.type === 'link' ? '#06b6d4' : '#10b981' %>">
                        <% if (item.type === 'video') { %>
                          <i class="bi bi-camera-video me-1"></i> Video
                        <% } else if (item.type === 'text') { %>
                          <i class="bi bi-file-text me-1"></i> Text
                        <% } else if (item.type === 'pdf') { %>
                          <i class="bi bi-file-pdf me-1"></i> PDF
                        <% } else if (item.type === 'link') { %>
                          <i class="bi bi-link me-1"></i> Link
                        <% } else if (item.type === 'image') { %>
                          <i class="bi bi-image me-1"></i> Image
                        <% } %>
                      </span>
                    <% }); %>
                  </div>
                  <a href="/learning/module/<%= module._id %>" class="btn btn-outline-light">
                    <% if (completedModules[module._id]) { %>
                      <i class="bi bi-arrow-repeat me-1"></i> Review
                    <% } else { %>
                      <i class="bi bi-play-fill me-1"></i> Start
                    <% } %>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <i class="bi bi-journal-x display-1 text-muted mb-3"></i>
          <h3 class="text-white">No Learning Modules Available</h3>
          <p class="text-white-75">Check back later for new learning content.</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<% if (locals.artist) { %>
<%- include('../partials/artist-footer') %>
<% } %>
