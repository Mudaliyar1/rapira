<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirm Your Application - Rapira</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Poppins', sans-serif;
    }
    .checkout-card {
      background: white;
      border-radius: 15px;
      box-shadow: 0 10px 50px rgba(0,0,0,0.2);
      max-width: 500px;
      width: 100%;
    }
    .checkout-header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 30px;
      border-radius: 15px 15px 0 0;
      text-align: center;
    }
    .checkout-body {
      padding: 30px;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
    }
    .detail-row:last-child {
      border-bottom: none;
    }
    .detail-label {
      color: #666;
      font-size: 0.95rem;
    }
    .detail-value {
      font-weight: 600;
      color: #333;
    }
    .amount-section {
      background: #f8f9fa;
      padding: 15px;
      border-radius: 10px;
      margin: 20px 0;
      text-align: center;
    }
    .amount-text {
      color: #666;
      font-size: 0.9rem;
      margin-bottom: 5px;
    }
    .amount-value {
      font-size: 2.5rem;
      font-weight: bold;
      color: #667eea;
    }
    .pay-btn {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none;
      color: white;
      font-weight: 600;
      padding: 15px;
      border-radius: 10px;
      width: 100%;
      margin-top: 20px;
      transition: transform 0.2s;
    }
    .pay-btn:hover {
      transform: translateY(-2px);
      color: white;
    }
    .pay-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    .cancel-link {
      text-align: center;
      margin-top: 15px;
    }
    .cancel-link a {
      color: #667eea;
      text-decoration: none;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <div class="checkout-card">
    <div class="checkout-header">
      <h2 class="mb-2"><i class="bi bi-check-circle me-2"></i>Application Details</h2>
      <p class="mb-0 text-white-50">Review and confirm your artist application</p>
    </div>

    <div class="checkout-body">
      <div class="detail-row">
        <span class="detail-label"><i class="bi bi-star me-2"></i>Artist Level</span>
        <span class="detail-value"><%= data.artistLevel %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label"><i class="bi bi-person me-2"></i>Age</span>
        <span class="detail-value"><%= data.age %> years</span>
      </div>

      <div class="detail-row">
        <span class="detail-label"><i class="bi bi-geo-alt me-2"></i>Location</span>
        <span class="detail-value"><%= data.city %>, <%= data.state %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label"><i class="bi bi-telephone me-2"></i>Phone</span>
        <span class="detail-value"><%= data.phoneNumber %></span>
      </div>

      <div class="amount-section">
        <div class="amount-text">Registration Fee</div>
        <div class="amount-value">₹<%= data.registrationFee %></div>
      </div>

      <button type="button" id="payBtn" class="pay-btn btn-primary" onclick="openRazorpay()">
        <i class="bi bi-credit-card me-2"></i>
        <span id="payText">Pay ₹<%= data.registrationFee %> & Submit</span>
      </button>

      <div class="cancel-link">
        <a href="/artist-applications/select-level">
          <i class="bi bi-arrow-left me-1"></i>Go Back
        </a>
      </div>
    </div>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    const orderData = <%- JSON.stringify(order) %>;
    const razorpayKey = '<%= keyId %>';
    const userData = <%- JSON.stringify(currentUser) %>;

    function openRazorpay() {
      const payBtn = document.getElementById('payBtn');
      const payText = document.getElementById('payText');
      
      payBtn.disabled = true;
      payText.textContent = 'Processing...';

      const options = {
        key: razorpayKey,
        amount: orderData.amount,
        currency: orderData.currency || 'INR',
        order_id: orderData.id,
        name: 'Rapira Music Platform',
        description: 'Artist Application Registration Fee',
        prefill: {
          name: userData.name || '',
          email: userData.email || ''
        },
        handler: async function(response) {
          payText.textContent = 'Verifying Payment...';
          
          try {
            const verifyRes = await fetch('/artist-applications/verify-payment', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              credentials: 'include',
              body: JSON.stringify({
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_signature: response.razorpay_signature
              })
            });

            const contentType = verifyRes.headers.get('content-type') || '';
            const verifyData = contentType.includes('application/json')
              ? await verifyRes.json()
              : { success: false, message: 'Unexpected response while verifying payment.' };

            if (verifyData.success) {
              alert('Payment successful! Your application has been submitted.');
              window.location.href = verifyData.redirectUrl || '/artist-applications/status';
            } else {
              alert('Payment verification failed: ' + (verifyData.message || 'Unknown error'));
              payBtn.disabled = false;
              payText.textContent = 'Pay ₹' + (orderData.amount / 100) + ' & Submit';
            }
          } catch (error) {
            console.error('Verify payment error:', error);
            alert('Error verifying payment: ' + error.message);
            payBtn.disabled = false;
            payText.textContent = 'Pay ₹' + (orderData.amount / 100) + ' & Submit';
          }
        },
        theme: {
          color: '#667eea'
        },
        modal: {
          ondismiss: function() {
            payBtn.disabled = false;
            payText.textContent = 'Pay Now & Submit Application';
          }
        }
      };

      try {
        const rzp = new Razorpay(options);
        rzp.open();
      } catch (error) {
        alert('Error opening payment gateway: ' + error.message);
        payBtn.disabled = false;
        payText.textContent = 'Pay Now & Submit Application';
      }
    }

    // Auto-open on page load (optional - comment out if you prefer manual click)
    window.addEventListener('load', function() {
      // Uncomment below to auto-open Razorpay on page load
      // setTimeout(() => openRazorpay(), 500);
    });
  </script>
</body>
</html>
