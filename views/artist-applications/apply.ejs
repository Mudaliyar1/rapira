<%- contentFor('body') %>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="position-fixed top-0 start-0 w-100 h-100 d-none" style="background-color: rgba(43, 24, 16, 0.75); z-index: 9999; backdrop-filter: blur(4px);">
  <div class="d-flex justify-content-center align-items-center h-100">
    <div class="text-center text-white p-4 rounded-4" style="background-color: #FFFFFF; color: #2B1810 !important; max-width: 380px; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
      <div class="spinner-border text-danger mb-3" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
      <h5 class="fw-bold text-dark mb-1">Submitting application...</h5>
      <p class="text-muted small mb-0">Please wait while your verification details are processed.</p>
    </div>
  </div>
</div>

<div class="rapira-profile-page">
  <div class="container">
    <div class="rh-subpage-container" style="max-width: 760px;">
      
      <!-- Page Navigation Header -->
      <div class="rh-page-header-nav">
        <div class="rh-page-header-left">
          <a href="/artist-applications/select-level" class="rh-back-circle-btn" title="Back to Tier Selection">
            <i class="bi bi-arrow-left"></i>
          </a>
          <div>
            <h1 class="rh-page-title"><%= level %> Artist Application</h1>
            <p class="text-muted small mb-0">Complete your artist application form below</p>
          </div>
        </div>
        <span class="badge" style="background-color: var(--rh-crimson, #9F190E); font-size: 0.85rem;"><%= level %> Tier</span>
      </div>

      <!-- Main Form Card -->
      <div class="rh-form-card">
        <form action="/artist-applications/apply" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="artistLevel" value="<%= level %>">

          <div class="row g-3 mb-4">
            <!-- Stage Name -->
            <div class="col-md-6">
              <label for="stageName" class="rh-form-label">Stage Name <span class="text-danger">*</span></label>
              <input type="text" class="rh-form-control" id="stageName" name="stageName" required maxlength="60"
                     placeholder="Your performing artist name"
                     value="<%= typeof savedFormData !== 'undefined' && savedFormData.stageName ? savedFormData.stageName : '' %>">
              <div class="rh-form-helper">The name your fans and listeners know you by.</div>
            </div>

            <!-- Genre -->
            <div class="col-md-6">
              <label for="genre" class="rh-form-label">Genre <span class="text-danger">*</span></label>
              <input type="text" class="rh-form-control" id="genre" name="genre" required maxlength="60"
                     placeholder="Hip Hop, Trap, Drill, Desi Hip Hop..."
                     value="<%= typeof savedFormData !== 'undefined' && savedFormData.genre ? savedFormData.genre : '' %>">
              <div class="rh-form-helper">Your primary music sub-genre.</div>
            </div>

            <!-- Instagram ID -->
            <div class="col-md-6">
              <label for="instagramId" class="rh-form-label">Instagram Handle <span class="text-danger">*</span></label>
              <div class="rh-input-group">
                <span class="rh-input-group-prefix"><i class="bi bi-instagram"></i></span>
                <input type="text" class="rh-form-control" id="instagramId" name="instagramId" required maxlength="100"
                       placeholder="@yourhandle"
                       value="<%= typeof savedFormData !== 'undefined' && savedFormData.instagramId ? savedFormData.instagramId : '' %>">
              </div>
            </div>

            <!-- PAN Card Number -->
            <div class="col-md-6">
              <label for="panCard" class="rh-form-label">PAN Card Number <span class="text-danger">*</span></label>
              <input type="text" class="rh-form-control font-monospace" id="panCard" name="panCard" required
                     style="text-transform: uppercase;"
                     autocapitalize="characters" autocorrect="off" spellcheck="false"
                     pattern="[A-Za-z]{5}[0-9]{4}[A-Za-z]" maxlength="10" title="Valid 10-character PAN (example: ABCDE1234F)"
                     placeholder="ABCDE1234F"
                     value="<%= typeof savedFormData !== 'undefined' && savedFormData.panCard ? savedFormData.panCard : '' %>">
              <div class="rh-form-helper">10-character alphanumeric PAN format.</div>
            </div>

            <!-- State -->
            <div class="col-md-6">
              <label for="state" class="rh-form-label">State <span class="text-danger">*</span></label>
              <select class="rh-form-select" id="state" name="state" required>
                <option value="" <%= (typeof savedFormData === 'undefined' || !savedFormData.state) ? 'selected disabled' : 'disabled' %>>Select your state</option>
                <option value="Andhra Pradesh" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Andhra Pradesh') ? 'selected' : '' %>>Andhra Pradesh</option>
                <option value="Arunachal Pradesh" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Arunachal Pradesh') ? 'selected' : '' %>>Arunachal Pradesh</option>
                <option value="Assam" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Assam') ? 'selected' : '' %>>Assam</option>
                <option value="Bihar" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Bihar') ? 'selected' : '' %>>Bihar</option>
                <option value="Chhattisgarh" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Chhattisgarh') ? 'selected' : '' %>>Chhattisgarh</option>
                <option value="Goa" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Goa') ? 'selected' : '' %>>Goa</option>
                <option value="Gujarat" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Gujarat') ? 'selected' : '' %>>Gujarat</option>
                <option value="Haryana" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Haryana') ? 'selected' : '' %>>Haryana</option>
                <option value="Himachal Pradesh" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Himachal Pradesh') ? 'selected' : '' %>>Himachal Pradesh</option>
                <option value="Jharkhand" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Jharkhand') ? 'selected' : '' %>>Jharkhand</option>
                <option value="Karnataka" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Karnataka') ? 'selected' : '' %>>Karnataka</option>
                <option value="Kerala" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Kerala') ? 'selected' : '' %>>Kerala</option>
                <option value="Madhya Pradesh" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Madhya Pradesh') ? 'selected' : '' %>>Madhya Pradesh</option>
                <option value="Maharashtra" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Maharashtra') ? 'selected' : '' %>>Maharashtra</option>
                <option value="Manipur" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Manipur') ? 'selected' : '' %>>Manipur</option>
                <option value="Meghalaya" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Meghalaya') ? 'selected' : '' %>>Meghalaya</option>
                <option value="Mizoram" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Mizoram') ? 'selected' : '' %>>Mizoram</option>
                <option value="Nagaland" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Nagaland') ? 'selected' : '' %>>Nagaland</option>
                <option value="Odisha" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Odisha') ? 'selected' : '' %>>Odisha</option>
                <option value="Punjab" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Punjab') ? 'selected' : '' %>>Punjab</option>
                <option value="Rajasthan" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Rajasthan') ? 'selected' : '' %>>Rajasthan</option>
                <option value="Sikkim" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Sikkim') ? 'selected' : '' %>>Sikkim</option>
                <option value="Tamil Nadu" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Tamil Nadu') ? 'selected' : '' %>>Tamil Nadu</option>
                <option value="Telangana" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Telangana') ? 'selected' : '' %>>Telangana</option>
                <option value="Tripura" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Tripura') ? 'selected' : '' %>>Tripura</option>
                <option value="Uttar Pradesh" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Uttar Pradesh') ? 'selected' : '' %>>Uttar Pradesh</option>
                <option value="Uttarakhand" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Uttarakhand') ? 'selected' : '' %>>Uttarakhand</option>
                <option value="West Bengal" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'West Bengal') ? 'selected' : '' %>>West Bengal</option>
                <option value="Andaman and Nicobar Islands" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Andaman and Nicobar Islands') ? 'selected' : '' %>>Andaman and Nicobar Islands</option>
                <option value="Chandigarh" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Chandigarh') ? 'selected' : '' %>>Chandigarh</option>
                <option value="Dadra and Nagar Haveli and Daman and Diu" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Dadra and Nagar Haveli and Daman and Diu') ? 'selected' : '' %>>Dadra and Nagar Haveli and Daman and Diu</option>
                <option value="Delhi" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Delhi') ? 'selected' : '' %>>Delhi</option>
                <option value="Jammu and Kashmir" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Jammu and Kashmir') ? 'selected' : '' %>>Jammu and Kashmir</option>
                <option value="Ladakh" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Ladakh') ? 'selected' : '' %>>Ladakh</option>
                <option value="Lakshadweep" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Lakshadweep') ? 'selected' : '' %>>Lakshadweep</option>
                <option value="Puducherry" <%= (typeof savedFormData !== 'undefined' && savedFormData.state === 'Puducherry') ? 'selected' : '' %>>Puducherry</option>
              </select>
            </div>

            <!-- City -->
            <div class="col-md-6">
              <label for="city" class="rh-form-label">City <span class="text-danger">*</span></label>
              <input type="text" class="rh-form-control" id="city" name="city" required
                     placeholder="Your current city"
                     value="<%= typeof savedFormData !== 'undefined' && savedFormData.city ? savedFormData.city : '' %>">
            </div>

            <!-- Age -->
            <div class="col-md-6">
              <label for="age" class="rh-form-label">Age <span class="text-danger">*</span></label>
              <input type="number" class="rh-form-control" id="age" name="age" min="18" max="120" required
                     placeholder="Must be at least 18"
                     value="<%= typeof savedFormData !== 'undefined' && savedFormData.age ? savedFormData.age : '' %>">
              <div class="rh-form-helper">You must be at least 18 years old to apply.</div>
            </div>

            <!-- Phone Number -->
            <div class="col-md-6">
              <label for="phoneNumber" class="rh-form-label">Phone Number <span class="text-danger">*</span></label>
              <input type="tel" class="rh-form-control" id="phoneNumber" name="phoneNumber" required
                     pattern="[0-9]{10}" maxlength="10" title="Valid 10-digit phone number"
                     placeholder="10-digit mobile number"
                     value="<%= typeof savedFormData !== 'undefined' && savedFormData.phoneNumber ? savedFormData.phoneNumber : '' %>">
            </div>

            <!-- Proof Photo Upload -->
            <div class="col-12">
              <label for="proofPhoto" class="rh-form-label">ID Proof Photo <span class="text-danger">*</span></label>
              <input type="file" class="rh-form-control" id="proofPhoto" name="proofPhoto" accept="image/jpeg,image/png,image/jpg" required>
              <div class="rh-form-helper">Upload a photo of your Government ID proof. JPG, JPEG, PNG (Max 5MB).</div>
              <div class="invalid-feedback" id="fileError"></div>
            </div>
          </div>

          <!-- Policy notice -->
          <div class="rh-profile-complete-banner mb-4">
            <div class="rh-profile-complete-left">
              <div class="rh-profile-complete-icon"><i class="bi bi-shield-check fs-5"></i></div>
              <div class="rh-profile-complete-text small">
                By submitting this application, you agree to our <a href="/terms-of-service" class="fw-bold text-danger">Terms of Service</a>, <a href="/privacy-policy" class="fw-bold text-danger">Privacy Policy</a>, and <a href="/document-id-policy" class="fw-bold text-danger">Document Protection Policy</a>.
              </div>
            </div>
          </div>

          <!-- Submit Actions -->
          <div class="d-flex justify-content-end gap-3 pt-3 border-top">
            <a href="/artist-applications/select-level" class="rh-btn-secondary" id="backBtn">Cancel</a>
            <% const artistFee = (websiteSettings && websiteSettings.registrationFees && websiteSettings.registrationFees.artistRegistrationFee > 0) ? websiteSettings.registrationFees.artistRegistrationFee : 0; %>
            <button type="submit" id="submitBtn" class="rh-btn-primary">
              <span class="spinner-border spinner-border-sm me-2 d-none" id="submitSpinner" role="status" aria-hidden="true"></span>
              <% if (artistFee > 0) { %>
                <i class="bi bi-credit-card me-2"></i><span id="submitText">Pay ₹<%= artistFee %> & Submit</span>
              <% } else { %>
                <i class="bi bi-check-circle me-2"></i><span id="submitText">Submit Application</span>
              <% } %>
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const phoneInput = document.getElementById('phoneNumber');
    if (phoneInput) {
      phoneInput.addEventListener('input', function() {
        this.value = this.value.replace(/\D/g, '');
        if (this.value.length > 10) {
          this.value = this.value.slice(0, 10);
        }
      });
    }

    const fileInput = document.getElementById('proofPhoto');
    const fileError = document.getElementById('fileError');
    const maxFileSize = 5 * 1024 * 1024;

    if (fileInput) {
      fileInput.addEventListener('change', function() {
        const file = this.files[0];
        fileInput.classList.remove('is-invalid');
        if (fileError) fileError.textContent = '';

        if (file) {
          if (file.size > maxFileSize) {
            fileInput.classList.add('is-invalid');
            if (fileError) fileError.textContent = 'File size exceeds 5MB limit. Please choose a smaller file.';
            return;
          }
          const validTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!validTypes.includes(file.type)) {
            fileInput.classList.add('is-invalid');
            if (fileError) fileError.textContent = 'Invalid file type. Please upload a JPG or PNG file.';
            return;
          }
        }
      });
    }

    const form = document.querySelector('form');
    const submitBtn = document.getElementById('submitBtn');
    const submitSpinner = document.getElementById('submitSpinner');
    const submitText = document.getElementById('submitText');
    const backBtn = document.getElementById('backBtn');
    const loadingOverlay = document.getElementById('loadingOverlay');

    if (form) {
      form.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
          e.preventDefault();
        }
      });

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        if (fileInput && fileInput.files.length > 0) {
          const file = fileInput.files[0];
          if (file.size > maxFileSize) {
            alert('Your Proof Photo file size exceeds the 5MB limit. Please select a smaller image before submitting.');
            fileInput.focus();
            return;
          }
        }

        if (form.checkValidity()) {
          if (submitBtn) submitBtn.disabled = true;
          if (backBtn) backBtn.classList.add('disabled');
          if (submitSpinner) submitSpinner.classList.remove('d-none');
          if (submitText) submitText.textContent = 'Processing...';
          if (loadingOverlay) loadingOverlay.classList.remove('d-none');

          setTimeout(() => {
            form.submit();
          }, 100);
        } else {
          form.reportValidity();
        }
      });
    }
  });
</script>
