<%- contentFor('body') %>

<div class="rapira-profile-page">
  <div class="container">
    <div class="rh-subpage-container" style="max-width: 1040px;">
      
      <!-- Page Navigation Header -->
      <div class="rh-page-header-nav text-center d-block mb-4">
        <a href="/users/profile" class="rh-back-circle-btn float-start" title="Back to Profile">
          <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="rh-page-title mb-2">Become an Artist</h1>
        <p class="text-muted mb-0">Select your artist tier to begin your verified RAPIRA journey</p>
      </div>

      <div class="row g-4 justify-content-center">
        <!-- Beginner Artist Card -->
        <div class="col-md-4">
          <div class="rh-profile-card h-100 d-flex flex-column mb-0 position-relative" style="cursor: pointer;" onclick="window.location.href='/artist-applications/apply/Beginner'">
            <div class="rh-profile-card-header py-3 bg-light">
              <div class="d-flex align-items-center justify-content-between w-100">
                <span class="badge bg-light text-dark border">Level 1</span>
                <i class="bi bi-music-note fs-4 text-danger"></i>
              </div>
            </div>
            
            <div class="rh-profile-card-body flex-grow-1 p-4 d-flex flex-column">
              <h3 class="fs-4 fw-bold text-dark mb-2">Beginner</h3>
              <p class="text-muted small mb-4">Perfect for artists starting their musical journey and building an early fanbase.</p>
              
              <ul class="list-unstyled d-flex flex-column gap-2 small text-dark mb-4 flex-grow-1">
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Access to learning resources</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Official artist profile page</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Message music producers</span>
                </li>
                <li class="d-flex align-items-center gap-2 text-muted">
                  <i class="bi bi-dash-circle text-muted fs-6"></i>
                  <span>Cannot host ticketed concerts</span>
                </li>
              </ul>

              <a href="/artist-applications/apply/Beginner" class="rh-btn-primary w-100 text-center py-2" onclick="event.stopPropagation()">
                Apply as Beginner &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Intermediate Artist Card -->
        <div class="col-md-4">
          <div class="rh-profile-card h-100 d-flex flex-column mb-0 position-relative border-danger" style="cursor: pointer; border-width: 2px !important;" onclick="window.location.href='/artist-applications/apply/Intermediate'">
            <div class="rh-profile-card-header py-3" style="background-color: #FAF2EC;">
              <div class="d-flex align-items-center justify-content-between w-100">
                <span class="badge" style="background-color: var(--rh-crimson, #9F190E); color: #fff;">Popular</span>
                <i class="bi bi-fire fs-4 text-danger"></i>
              </div>
            </div>
            
            <div class="rh-profile-card-body flex-grow-1 p-4 d-flex flex-column">
              <h3 class="fs-4 fw-bold text-dark mb-2">Intermediate</h3>
              <p class="text-muted small mb-4">For active rap artists with recorded tracks and a growing live performance audience.</p>
              
              <ul class="list-unstyled d-flex flex-column gap-2 small text-dark mb-4 flex-grow-1">
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Access to learning resources</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Official artist profile page</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Message all community roles</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Host and sell concert tickets</span>
                </li>
              </ul>

              <a href="/artist-applications/apply/Intermediate" class="rh-btn-primary w-100 text-center py-2" onclick="event.stopPropagation()">
                Apply as Intermediate &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Established Artist Card -->
        <div class="col-md-4">
          <div class="rh-profile-card h-100 d-flex flex-column mb-0 position-relative" style="cursor: pointer;" onclick="window.location.href='/artist-applications/apply/Established'">
            <div class="rh-profile-card-header py-3 bg-light">
              <div class="d-flex align-items-center justify-content-between w-100">
                <span class="badge bg-light text-dark border">Level 3</span>
                <i class="bi bi-award-fill fs-4 text-danger"></i>
              </div>
            </div>
            
            <div class="rh-profile-card-body flex-grow-1 p-4 d-flex flex-column">
              <h3 class="fs-4 fw-bold text-dark mb-2">Established</h3>
              <p class="text-muted small mb-4">For verified professional artists with released projects and nationwide concert tours.</p>
              
              <ul class="list-unstyled d-flex flex-column gap-2 small text-dark mb-4 flex-grow-1">
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>All Intermediate features</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Priority concert promotion</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Verified artist badge eligibility</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                  <i class="bi bi-check-circle-fill text-success fs-6"></i>
                  <span>Dedicated booking manager</span>
                </li>
              </ul>

              <a href="/artist-applications/apply/Established" class="rh-btn-primary w-100 text-center py-2" onclick="event.stopPropagation()">
                Apply as Established &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Info Banner -->
      <div class="rh-profile-complete-banner mt-5 mb-0">
        <div class="rh-profile-complete-left">
          <div class="rh-profile-complete-icon">
            <i class="bi bi-info-circle-fill fs-5"></i>
          </div>
          <div class="rh-profile-complete-text">
            <strong>Application Review Process:</strong> All artist applications are individually verified by our team within 24–48 hours. You will receive real-time email notifications regarding approval.
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
