<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rapira - Artist Registration Payment</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    body {
      background-color: #121212;
      color: #fff;
      font-family: 'Poppins', sans-serif;
    }
    .card {
      background-color: #1e1e1e;
      border: 1px solid #333;
    }
    .btn-primary {
      background-color: #6366f1;
      border-color: #6366f1;
    }
    .pulse-animation {
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(99, 102, 241, 0); }
      100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0); }
    }
  </style>
</head>
<body>
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-6 text-center">
        <div class="card border-secondary">
          <div class="card-body py-5">
            <div class="spinner-border text-primary mb-4" role="status" style="width: 3rem; height: 3rem;">
              <span class="visually-hidden">Loading...</span>
            </div>

            <h2 class="mb-3">Artist Registration Payment</h2>
            <p class="text-muted mb-4">Please wait while we redirect you to the payment gateway...</p>

            <div class="card mb-4 text-start" style="background: #252525;">
              <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Application Level</span>
                  <span class="fw-bold"><%= application.artistLevel %></span>
                </div>
                <hr class="border-secondary">
                <div class="d-flex justify-content-between">
                  <span class="fw-bold fs-5">Registration Fee</span>
                  <span class="fw-bold fs-5" style="color: #6366f1;">₹<%= application.registrationFee %></span>
                </div>
              </div>
            </div>

            <div class="alert alert-warning mb-4 text-start">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <strong>If the payment window doesn't open automatically:</strong>
              <ul class="mb-0 mt-2">
                <li>Check if your browser is blocking pop-ups</li>
                <li>Click the button below to open payment</li>
              </ul>
            </div>

            <div class="progress mb-4" style="height: 10px;">
              <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%"></div>
            </div>

            <div class="d-grid gap-2">
              <button id="manual-open" class="btn btn-lg btn-primary pulse-animation">
                <i class="bi bi-credit-card me-2"></i>Click here to open payment
              </button>
              <a href="/artist-applications/cancel-payment/<%= application._id %>" class="btn btn-outline-secondary mt-2">
                <i class="bi bi-x-circle me-2"></i>Cancel Payment
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    var paymentKey = 'rzp_opened_<%= application._id %>';

    // If Razorpay was already opened once (page refresh), cancel immediately
    if (sessionStorage.getItem(paymentKey)) {
      console.log('Page was refreshed — cancelling payment');
      sessionStorage.removeItem(paymentKey);
      window.location.href = '/artist-applications/cancel-payment/<%= application._id %>';
    }

    function openRazorpay() {
      // Mark that Razorpay has been opened
      sessionStorage.setItem(paymentKey, 'true');

      var options = {
        key: '<%= keyId %>',
        amount: '<%= order.amount %>',
        currency: '<%= order.currency || "INR" %>',
        name: 'Rapira',
        description: 'Artist Registration Fee',
        order_id: '<%= order.id %>',
        handler: function(response) {
          // Payment success — clear the flag
          sessionStorage.removeItem(paymentKey);

          // Show processing animation
          document.body.innerHTML += `
            <div id="processing-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(18,18,18,0.95);z-index:9999;display:flex;flex-direction:column;justify-content:center;align-items:center;">
              <div class="spinner-border text-success" role="status" style="width:4rem;height:4rem;border-width:0.3rem;"></div>
              <h2 class="mt-4 text-white">Payment Successful!</h2>
              <p class="text-success fs-5 bg-dark p-2 rounded shadow"><i class="bi bi-shield-check me-2"></i>Verifying your application...</p>
            </div>
          `;

          var form = document.createElement('form');
          form.method = 'POST';
          form.action = '/artist-applications/verify-payment/<%= application._id %>';

          var fields = {
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_order_id: response.razorpay_order_id,
            razorpay_signature: response.razorpay_signature
          };

          for (var key in fields) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = fields[key];
            form.appendChild(input);
          }

          document.body.appendChild(form);

          // Small delay before submitting so user can see the success animation
          setTimeout(() => {
            form.submit();
          }, 1500);
        },
        prefill: {
          name: '<%= currentUser.name %>',
          email: '<%= currentUser.email %>'
        },
        theme: {
          color: '#6366f1'
        },
        modal: {
          ondismiss: function() {
            sessionStorage.removeItem(paymentKey);
            window.location.href = '/artist-applications/cancel-payment/<%= application._id %>';
          }
        }
      };

      try {
        window.rzp = new Razorpay(options);
        window.rzp.open();
      } catch (error) {
        console.error('Error opening Razorpay:', error);
        sessionStorage.removeItem(paymentKey);
        alert('Error opening payment: ' + error.message);
      }
    }

    document.getElementById('manual-open').addEventListener('click', function() {
      openRazorpay();
    });

    // Auto-open only on first load
    if (!sessionStorage.getItem(paymentKey)) {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(openRazorpay, 1000);
      });
    }
  </script>
</body>
</html>
