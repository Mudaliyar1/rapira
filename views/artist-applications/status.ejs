<%- contentFor('body') %>

<div class="rapira-profile-page">
  <div class="container">
    <div class="rh-subpage-container" style="max-width: 920px;">
      
      <!-- Page Navigation Header -->
      <div class="rh-page-header-nav">
        <div class="rh-page-header-left">
          <a href="/users/profile" class="rh-back-circle-btn" title="Back to Profile">
            <i class="bi bi-arrow-left"></i>
          </a>
          <h1 class="rh-page-title">Artist Applications</h1>
        </div>
        <a href="/artist-applications/select-level" class="rh-btn-primary">
          <i class="bi bi-plus-lg me-1"></i> New Application
        </a>
      </div>

      <!-- Main Status Card -->
      <div class="rh-profile-card">
        <div class="rh-profile-card-header">
          <div class="rh-profile-card-title-wrap">
            <i class="bi bi-hourglass-split text-danger fs-5"></i>
            <h2 class="rh-profile-card-title">Application Status</h2>
          </div>
        </div>

        <div class="rh-profile-card-body p-0">
          <% if (applications && applications.length > 0) { %>
            <div class="rh-profile-table-wrap">
              <table class="rh-profile-table">
                <thead>
                  <tr>
                    <th>Artist Tier</th>
                    <th>Submitted On</th>
                    <th>Status</th>
                    <th>Review Comments</th>
                  </tr>
                </thead>
                <tbody>
                  <% applications.forEach(application => { %>
                    <tr>
                      <td class="fw-bold text-dark"><%= application.artistLevel %></td>
                      <td><%= toISTLocaleString(application.createdAt) %></td>
                      <td>
                        <% if (application.status === 'pending') { %>
                          <span class="rh-badge-pending">
                            <i class="bi bi-clock-fill"></i> Pending Review
                          </span>
                        <% } else if (application.status === 'approved') { %>
                          <span class="rh-badge-completed">
                            <i class="bi bi-check-circle-fill"></i> Approved
                          </span>
                        <% } else if (application.status === 'rejected') { %>
                          <span class="rh-badge-rejected">
                            <i class="bi bi-x-circle-fill"></i> Rejected
                          </span>
                        <% } %>
                      </td>
                      <td>
                        <span class="small text-muted"><%= application.adminComments || 'No review notes provided yet.' %></span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <div class="p-4 border-top">
              <% if (applications.some(app => app.status === 'pending')) { %>
                <div class="rh-profile-complete-banner mb-0">
                  <div class="rh-profile-complete-left">
                    <div class="rh-profile-complete-icon"><i class="bi bi-clock-history fs-5"></i></div>
                    <div class="rh-profile-complete-text">
                      <strong>Application Under Review:</strong> Your submission is being carefully assessed by the RAPIRA A&R team. Decisions are typically emailed within 24–48 hours.
                    </div>
                  </div>
                </div>
              <% } else if (applications.some(app => app.status === 'approved')) { %>
                <div class="rh-profile-complete-banner mb-0" style="background-color: #EBF8F0; border-color: #A3E0BA;">
                  <div class="rh-profile-complete-left">
                    <div class="rh-profile-complete-icon text-success"><i class="bi bi-check-circle-fill fs-5"></i></div>
                    <div class="rh-profile-complete-text">
                      <strong class="text-success">Congratulations!</strong> Your artist application has been approved. You now have full access to your artist dashboard and concert creation tools.
                    </div>
                  </div>
                  <div class="rh-profile-complete-actions">
                    <a href="/artists/dashboard" class="rh-btn-primary-sm">Go to Artist Dashboard &rarr;</a>
                  </div>
                </div>
              <% } else if (applications.every(app => app.status === 'rejected')) { %>
                <div class="rh-profile-complete-banner mb-0" style="background-color: #FEECEC; border-color: #F7B5B5;">
                  <div class="rh-profile-complete-left">
                    <div class="rh-profile-complete-icon text-danger"><i class="bi bi-exclamation-triangle-fill fs-5"></i></div>
                    <div class="rh-profile-complete-text">
                      <strong class="text-danger">Application Not Approved:</strong> Please review the administrator feedback notes above and submit an updated application.
                    </div>
                  </div>
                  <div class="rh-profile-complete-actions">
                    <a href="/artist-applications/select-level" class="rh-btn-primary-sm">Apply Again</a>
                  </div>
                </div>
              <% } %>
            </div>

          <% } else { %>
            <!-- Empty State -->
            <div class="rh-sub-empty-box">
              <div class="rh-sub-sketch-icon mb-3" aria-hidden="true">
                <i class="bi bi-file-earmark-x text-danger display-4"></i>
              </div>
              <h3 class="fs-4 fw-bold text-dark mb-2">No Applications Found</h3>
              <p class="text-muted mb-4">You haven't submitted any artist verification applications yet.</p>
              <a href="/artist-applications/select-level" class="rh-btn-primary">Apply Now</a>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>
