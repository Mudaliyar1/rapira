<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#121212">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : (typeof siteSettings !== 'undefined' && siteSettings ? siteSettings.siteDescription : 'Rapira - The ultimate platform for Indian rap artists and fans to connect, discover, and experience the best of hip-hop culture.') %>">
  <title><%= typeof title !== 'undefined' ? title : (typeof siteSettings !== 'undefined' && siteSettings ? siteSettings.siteName : 'Rapira - Indian Rap Music Platform') %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- AOS Animation Library -->
  <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
  <!-- Animate.css for Slider Animations -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <!-- Additional CSS for enhanced styling -->
  <style>
    .bg-gradient {
      background: linear-gradient(135deg, var(--bs-primary-bg-subtle, #e7f1ff) 0%, var(--bs-secondary-bg-subtle, #f8f9fa) 100%) !important;
    }
    
    .rounded-4 {
      border-radius: 1rem !important;
    }
    
    .overflow-hidden {
      overflow: hidden;
    }
    
    .text-primary-subtle {
      color: var(--bs-primary-text-emphasis) !important;
    }
    
    .text-secondary-subtle {
      color: var(--bs-secondary-text-emphasis) !important;
    }
  </style>
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile-images.css">
  <link rel="stylesheet" href="/css/chatbot.css">
  <link rel="stylesheet" href="/css/theme-animations.css">
  <!-- Loading Spinner CSS -->
  <link rel="stylesheet" href="/css/loading-spinner.css">

  <!-- Dynamic Theme Colors -->
  <% if (typeof themeSettings !== 'undefined' && themeSettings) { %>
  <style>
    :root {
      --primary: <%= themeSettings.primaryColor %> !important;
      --primary-dark: <%= themeSettings.primaryColor %>dd !important;
      --primary-light: <%= themeSettings.primaryColor %>aa !important;
      --secondary: <%= themeSettings.secondaryColor %> !important;
      --secondary-dark: <%= themeSettings.secondaryColor %>dd !important;
      --secondary-light: <%= themeSettings.secondaryColor %>aa !important;
      --accent: <%= themeSettings.accentColor %> !important;
      --accent-dark: <%= themeSettings.accentColor %>dd !important;
      --accent-light: <%= themeSettings.accentColor %>aa !important;
    }

    /* Update gradient colors */
    .gradient-text-purple {
      background: linear-gradient(135deg, <%= themeSettings.primaryColor %>, <%= themeSettings.secondaryColor %>) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      background-clip: text !important;
    }

    .btn-gradient-purple {
      background: linear-gradient(135deg, <%= themeSettings.primaryColor %>, <%= themeSettings.secondaryColor %>) !important;
      border: none !important;
    }

    .bg-gradient-purple {
      background: linear-gradient(135deg, <%= themeSettings.primaryColor %>, <%= themeSettings.secondaryColor %>) !important;
    }

    .btn-primary {
      background-color: <%= themeSettings.primaryColor %> !important;
      border-color: <%= themeSettings.primaryColor %> !important;
    }

    .btn-primary:hover {
      background-color: <%= themeSettings.primaryColor %>dd !important;
      border-color: <%= themeSettings.primaryColor %>dd !important;
    }

    .text-primary {
      color: <%= themeSettings.primaryColor %> !important;
    }

    .bg-primary {
      background-color: <%= themeSettings.primaryColor %> !important;
    }
  </style>
  <% } %>

  <!-- Favicon -->
  <link rel="icon" href="<%= typeof siteSettings !== 'undefined' && siteSettings && siteSettings.favicon ? siteSettings.favicon : '/images/favicon.ico' %>" type="image/x-icon">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">



  <!-- Extra Scripts -->
  <% if (typeof extraScripts !== 'undefined') { %>
    <%- extraScripts %>
  <% } %>
</head>
<body data-user-id="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser._id : '' %>">
  <!-- Header -->
  <%- include('../partials/navbar') %>

  <!-- Flash Messages -->
  <%- include('../partials/messages') %>

  <!-- Main Content -->
  <main class="container-fluid py-4">
    <%- body %>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Media Player Modal -->
  <%- include('../partials/media-player-modal') %>
  
  <!-- Post Viewer Modal -->
  <%- include('../partials/post-modal') %>



  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- AOS Animation Library -->
  <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
  <script>
    AOS.init({
      duration: 800,
      easing: 'ease',
      once: true
    });
  </script>
  <!-- PDF.js for PDF viewing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  <script>
    // Initialize PDF.js worker
    if (typeof pdfjsLib !== 'undefined') {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    }
  </script>

  <!-- Custom JS -->
  <script src="/js/main.js"></script>
  <script src="/js/loading-spinner.js"></script>
  <script src="/js/media-player.js"></script>
  <script src="/js/profile-image-handler.js"></script>
  <script src="/js/chatbot.js"></script></script>
  <script src="/scripts/stories.js"></script>
  <script src="/scripts/post-viewer.js"></script>
  <script src="/js/button-sound.js"></script>
  <script src="/js/voice-control.js"></script>
  <script src="/js/theme-manager.js"></script>
  <script>
    // Pass website settings to frontend
    window.websiteSettings = {
      siteSettings: {
        enableButtonSounds: <%= typeof siteSettings !== 'undefined' && siteSettings && typeof siteSettings.enableButtonSounds !== 'undefined' ? siteSettings.enableButtonSounds !== false : true %>,
        activeTheme: "<%= typeof siteSettings !== 'undefined' && siteSettings && typeof siteSettings.activeTheme !== 'undefined' ? siteSettings.activeTheme : '' %>"
      }
    };
    
    // Apply theme from server settings
    document.addEventListener('DOMContentLoaded', function() {
      if (window.themeManager && window.websiteSettings.siteSettings.activeTheme) {
        window.themeManager.changeTheme(window.websiteSettings.siteSettings.activeTheme);
      }
    });
  </script>
   
  <!-- Session check script -->
  <script>
    // Check if user is logged in but navbar doesn't reflect it
    document.addEventListener('DOMContentLoaded', function() {
      // If we have a success message about being logged in but the navbar still shows login/register
      const successMessages = document.querySelectorAll('.alert-success');
      let hasLoginSuccess = false;

      successMessages.forEach(message => {
        if (message.textContent.includes('logged in')) {
          hasLoginSuccess = true;
        }
      });

      // Check if login button is visible (meaning we're not showing the user profile)
      const loginButton = document.querySelector('a[href="/auth/login"]');

      if (hasLoginSuccess && loginButton) {
        console.log('Session state mismatch detected. Refreshing page...');
        // Wait a moment and refresh to get the correct navbar state
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      }
      
      // Handle post view hash on page load
      handlePostViewHash();
    });
    
    // Handle hash changes for post viewing
    function handlePostViewHash() {
      const hash = window.location.hash;
      if (hash.startsWith('#view-post-')) {
        const postId = hash.substring(11); // Remove '#view-post-' prefix
        // Try to open the post using available functions
        if (typeof viewPost === 'function') {
          viewPost(postId);
        } else if (typeof window.openPost === 'function') {
          window.openPost(postId);
        }
        // Clear the hash without triggering navigation
        history.replaceState(null, null, ' ');
      }
    }
    
    // Listen for hash changes
    window.addEventListener('hashchange', handlePostViewHash);
  </script>

  <!-- Network Status Monitor -->
  <script src="/js/network-status.js"></script>
  
  <!-- Account Monitor (Real-time Deletion Detection) -->
  <script src="/js/account-monitor.js"></script>
</body>
</html>