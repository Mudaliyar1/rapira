<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> - <%= typeof siteSettings !== 'undefined' && siteSettings ? siteSettings.siteName.split(' - ')[0] : 'Rapira' %> Admin</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile-images.css">
  <!-- Admin Alerts CSS -->
  <link rel="stylesheet" href="/css/admin-alerts.css">
  <!-- Loading Spinner CSS -->
  <link rel="stylesheet" href="/css/loading-spinner.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (typeof extraStyles !== 'undefined') { %>
    <%- extraStyles %>
  <% } %>
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../partials/admin-sidebar', { path: typeof currentPath !== 'undefined' ? currentPath : '/' }) %>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Maintenance Mode Banner -->
      <% if (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.maintenanceMode) { %>
      <div class="alert alert-warning alert-dismissible fade show mb-3 rounded" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Maintenance Mode Active</strong> - Only administrators can access the site.
        <a href="/admin/website-settings" class="alert-link">Disable maintenance mode</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
      <% } %>

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
          <button class="btn btn-primary me-2 p-1" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>
          <h2 class="fw-bold mb-0 fs-4"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h2>
        </div>
        <% if (typeof headerButtons !== 'undefined') { %>
          <div>
            <%- headerButtons %>
          </div>
        <% } %>
      </div>

      <%- body %>
    </div>
  </div>

  <!-- Sidebar Overlay for Mobile -->
  <div class="sidebar-overlay" style="display: none;"></div>

  <!-- Mobile Admin Toggle -->
  <button class="btn admin-toggle d-none" id="adminToggle">
    <i class="bi bi-list"></i>
  </button>



  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
  <script src="/js/loading-spinner.js"></script>
  <script src="/js/profile-image-handler.js"></script>

  <!-- Notification Badge Update Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Update notification badge count
      function updateNotificationBadge() {
        fetch('/admin/notifications/unread-count')
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              const badge = document.getElementById('notificationBadge');
              if (badge) {
                badge.textContent = data.count;

                if (data.count === 0) {
                  badge.style.display = 'none';
                } else {
                  badge.style.display = 'inline-block';
                }
              }
            }
          })
          .catch(error => {
            console.error('Error updating notification badge:', error);
          });
      }

      // Update badge on page load
      updateNotificationBadge();

      // Update badge every 60 seconds
      setInterval(updateNotificationBadge, 60000);
    });
  </script>

  <!-- Network Status Monitor -->
  <script src="/js/network-status.js"></script>

  <% if (typeof extraScripts !== 'undefined') { %>
    <%- extraScripts %>
  <% } %>
</body>
</html>
