<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Venue Dashboard' %> - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile-images.css">
  <!-- Venue Dashboard CSS -->
  <link rel="stylesheet" href="/css/venue-dashboard.css">
  <!-- Loading Spinner CSS -->
  <link rel="stylesheet" href="/css/loading-spinner.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (typeof extraStyles !== 'undefined') { %>
    <%- extraStyles %>
  <% } %>
</head>
<body>
  <div class="admin-layout venue-content">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white p-0" id="venueSidebar">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0" style="color: var(--secondary) !important;">
          <i class="bi bi-building me-1"></i>Venue Dashboard
        </h5>
        <button class="btn btn-sm btn-outline-light" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <img src="<%= (typeof currentUser !== 'undefined' && currentUser.profileImage) ? currentUser.profileImage : '/images/default-profile.svg' %>"
                 alt="<%= typeof currentUser !== 'undefined' ? currentUser.name : 'User' %>"
                 class="rounded-circle"
                 width="48" height="48"
                 style="object-fit: cover;"
                 onerror="this.onerror=null; this.src='/images/default-profile.svg';">
          </div>
          <div>
            <h6 class="mb-0"><%= typeof currentUser !== 'undefined' ? currentUser.name : 'Venue Owner' %></h6>
            <small class="text-muted">Venue Manager</small>
          </div>
        </div>
        <ul class="nav flex-column">
          <!-- Main Navigation -->
          <li class="nav-item mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Main</span>
            </div>
          </li>
          <% if (typeof venue !== 'undefined' && venue) { %>
            <li class="nav-item mb-2">
              <a href="/venue-dashboard/<%= venue._id %>/dashboard" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath.includes('/dashboard') ? 'active bg-primary' : '' %>">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
              </a>
            </li>
          <% } else { %>
            <li class="nav-item mb-2">
              <a href="/venue-dashboard" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/venue-dashboard' ? 'active bg-primary' : '' %>">
                <i class="bi bi-speedometer2 me-2"></i> All Dashboards
              </a>
            </li>
          <% } %>

          <!-- Venues Management -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Venues</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/venues" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/venues' ? 'active bg-primary' : '' %>">
              <i class="bi bi-building me-2"></i> My Venues
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/venue-requests" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/venue-requests' ? 'active bg-primary' : '' %>">
              <i class="bi bi-file-earmark-text me-2"></i> Venue Requests
            </a>
          </li>

          <!-- Account Management -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Account</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/profile" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/profile' ? 'active bg-primary' : '' %>">
              <i class="bi bi-person me-2"></i> Profile
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/edit-profile" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/edit-profile' ? 'active bg-primary' : '' %>">
              <i class="bi bi-gear me-2"></i> Edit Profile
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/change-password" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/change-password' ? 'active bg-primary' : '' %>">
              <i class="bi bi-lock me-2"></i> Change Password
            </a>
          </li>

          <!-- Logout -->
          <li class="nav-item mt-3 mb-2 border-top border-secondary pt-3">
            <a href="/logout" class="nav-link text-danger p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Toggle Button for Sidebar (Mobile & Desktop) -->
      <div class="d-flex align-items-center mb-3 p-3" style="background: transparent;">
        <button class="btn btn-primary me-3" id="sidebarToggle" style="padding: 0.5rem 0.75rem;">
          <i class="bi bi-list fs-5"></i>
        </button>
        <h4 class="mb-0 text-dark">
          <i class="bi bi-building me-2"></i>
          <%= typeof title !== 'undefined' ? title : 'Venue Dashboard' %>
        </h4>
      </div>
      
      <!-- Flash Messages -->
      <% if (typeof locals.messages !== 'undefined') { %>
        <% if (messages.error && messages.error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Error!</strong>
            <% messages.error.forEach(msg => { %>
              <div><%= msg %></div>
            <% }); %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (messages.success && messages.success.length > 0) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <strong>Success!</strong>
            <% messages.success.forEach(msg => { %>
              <div><%= msg %></div>
            <% }); %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (messages.info && messages.info.length > 0) { %>
          <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            <% messages.info.forEach(msg => { %>
              <div><%= msg %></div>
            <% }); %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
      <% } %>

      <!-- Page Content -->
      <div class="venue-dashboard-content">
        <%- body %>
      </div>
    </div>
  </div>

  <!-- Sidebar Overlay for Mobile -->
  <div class="sidebar-overlay" id="sidebarOverlay" style="display: none;"></div>

  <!-- Loading Spinner -->
  <div id="loadingSpinner" class="loading-spinner" style="display: none;">
    <div class="spinner-content">
      <div class="spinner"></div>
      <p id="spinnerText">Loading...</p>
    </div>
  </div>

  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Loading Spinner JS -->
  <script src="/js/loading-spinner.js"></script>
  <script>
    // Sidebar Toggle - Responsive behavior
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('venueSidebar');
    const closeSidebarBtn = document.getElementById('closeSidebar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');

    if (sidebarToggle) {
      sidebarToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        if (window.innerWidth > 991.98) {
          // On desktop: collapse/expand sidebar
          sidebar?.classList.toggle('collapsed');
        } else {
          // On mobile: slide in/out sidebar with overlay
          sidebar?.classList.toggle('show');
          if (sidebar?.classList.contains('show')) {
            sidebarOverlay.style.display = 'block';
          } else {
            sidebarOverlay.style.display = 'none';
          }
        }
      });
    }

    if (closeSidebarBtn) {
      closeSidebarBtn.addEventListener('click', function() {
        if (window.innerWidth > 991.98) {
          // On desktop: collapse sidebar
          sidebar?.classList.toggle('collapsed');
        } else {
          // On mobile: hide sidebar
          sidebar?.classList.remove('show');
          sidebarOverlay.style.display = 'none';
        }
      });
    }

    // Close sidebar when clicking overlay
    if (sidebarOverlay) {
      sidebarOverlay.addEventListener('click', function() {
        sidebar?.classList.remove('show');
        sidebarOverlay.style.display = 'none';
      });
    }

    // Close sidebar when clicking outside (mobile only)
    document.addEventListener('click', function(event) {
      if (!sidebar || !sidebarToggle) return;
      
      if (window.innerWidth <= 991.98) {
        if (!sidebar.contains(event.target) && !sidebarToggle.contains(event.target)) {
          sidebar.classList.remove('show');
          sidebarOverlay.style.display = 'none';
        }
      }
    });

    // Handle window resize
    window.addEventListener('resize', function() {
      if (window.innerWidth > 991.98) {
        sidebar?.classList.remove('show');
        sidebarOverlay.style.display = 'none';
      } else {
        sidebar?.classList.remove('collapsed');
      }
    });

    // Initialize tooltips
    document.addEventListener('DOMContentLoaded', function() {
      const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });

      // Initialize spinner
      if (typeof LoadingSpinner !== 'undefined') {
        new LoadingSpinner().init();
      }
    });
  </script>

  <!-- Network Status Monitor -->
  <script src="/js/network-status.js"></script>

  <% if (typeof extraScripts !== 'undefined') { %>
    <%- extraScripts %>
  <% } %>
</body>
</html>
