<%- contentFor('body') %>

<div class="container-fluid py-4">
  <!-- Header Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h2 class="text-dark mb-1">
            <i class="bi bi-geo-alt-fill me-2"></i>Venue Bookings Management
          </h2>
          <p class="text-muted mb-0">Track and manage venue bookings across all locations</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <form method="GET" class="row g-3">
            <div class="col-md-4">
              <label for="venue" class="form-label">Venue</label>
              <select name="venue" id="venue" class="form-select">
                <option value="">All Venues</option>
                <% venues.forEach(venue => { %>
                  <option value="<%= venue._id %>" <%= selectedVenue === venue._id.toString() ? 'selected' : '' %>>
                    <%= venue.name %> - <%= venue.city %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-3">
              <label for="date" class="form-label">Date</label>
              <input type="date" name="date" id="date" class="form-control" value="<%= selectedDate || '' %>">
            </div>
            <div class="col-md-3">
              <label for="status" class="form-label">Status</label>
              <select name="status" id="status" class="form-select">
                <option value="">All Status</option>
                <option value="pending" <%= selectedStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="approved" <%= selectedStatus === 'approved' ? 'selected' : '' %>>Approved</option>
                <option value="completed" <%= selectedStatus === 'completed' ? 'selected' : '' %>>Completed</option>
                <option value="cancelled" <%= selectedStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label">&nbsp;</label>
              <div class="d-grid">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-search me-1"></i>Filter
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Venue Bookings Cards -->
  <div class="row">
    <% if (Object.keys(venueBookings).length === 0) { %>
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted mb-3"></i>
            <h4 class="text-muted">No bookings found</h4>
            <p class="text-muted">No venue bookings match your current filters.</p>
          </div>
        </div>
      </div>
    <% } else { %>
      <% Object.values(venueBookings).forEach(venueData => { %>
        <div class="col-lg-6 mb-4">
          <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="mb-1">
                    <i class="bi bi-geo-alt me-2"></i><%= venueData.venue.name %>
                  </h5>
                  <small class="opacity-75">
                    <%= venueData.venue.city %>, <%= venueData.venue.state %>
                  </small>
                </div>
                <div class="text-end">
                  <div class="badge bg-light text-primary fs-6">
                    <%= venueData.totalBookings %> Total
                  </div>
                </div>
              </div>
            </div>
            
            <div class="card-body">
              <!-- Statistics -->
              <div class="row mb-3">
                <div class="col-4 text-center">
                  <div class="text-warning">
                    <i class="bi bi-clock-history fs-4"></i>
                    <div class="fw-bold mt-1"><%= venueData.upcomingBookings %></div>
                    <small class="text-muted">Upcoming</small>
                  </div>
                </div>
                <div class="col-4 text-center">
                  <div class="text-success">
                    <i class="bi bi-check-circle fs-4"></i>
                    <div class="fw-bold mt-1"><%= venueData.completedBookings %></div>
                    <small class="text-muted">Completed</small>
                  </div>
                </div>
                <div class="col-4 text-center">
                  <div class="text-info">
                    <i class="bi bi-people fs-4"></i>
                    <div class="fw-bold mt-1"><%= venueData.venue.capacity || 'N/A' %></div>
                    <small class="text-muted">Capacity</small>
                  </div>
                </div>
              </div>

              <!-- Recent Bookings -->
              <h6 class="text-dark mb-3">
                <i class="bi bi-calendar-event me-2"></i>Recent Bookings
              </h6>
              
              <% if (venueData.bookings.length === 0) { %>
                <div class="text-center text-muted py-3">
                  <i class="bi bi-calendar-x fs-1 mb-2"></i>
                  <p class="mb-0">No bookings for selected filters</p>
                </div>
              <% } else { %>
                <div class="booking-list" style="max-height: 300px; overflow-y: auto;">
                  <% venueData.bookings.slice(0, 5).forEach(booking => { %>
                    <div class="border rounded p-3 mb-2">
                      <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                          <h6 class="mb-1 text-dark"><%= booking.title %></h6>
                          <p class="text-muted mb-1">
                            <i class="bi bi-person me-1"></i><%= booking.artist.stageName %>
                          </p>
                          <div class="d-flex align-items-center text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>
                            <%= new Date(booking.date).toLocaleDateString('en-IN') %>
                            <span class="mx-2">•</span>
                            <i class="bi bi-clock me-1"></i>
                            <%= booking.time %>
                          </div>
                        </div>
                        <div class="text-end">
                          <% 
                            let statusClass = 'secondary';
                            if (booking.status === 'approved') statusClass = 'success';
                            else if (booking.status === 'pending') statusClass = 'warning';
                            else if (booking.status === 'rejected') statusClass = 'danger';
                            else if (booking.status === 'completed') statusClass = 'info';
                          %>
                          <span class="badge bg-<%= statusClass %>">
                            <%= booking.status.toUpperCase() %>
                          </span>
                          <% if (booking.isPaid) { %>
                            <div class="mt-1">
                              <small class="text-success">
                                <i class="bi bi-currency-rupee"></i>₹<%= booking.price || 0 %>
                              </small>
                            </div>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                  
                  <% if (venueData.bookings.length > 5) { %>
                    <div class="text-center mt-3">
                      <button class="btn btn-outline-primary btn-sm" 
                              onclick="loadMoreBookings('<%= venueData.venue._id %>')">
                        <i class="bi bi-three-dots me-1"></i>
                        View All <%= venueData.bookings.length %> Bookings
                      </button>
                    </div>
                  <% } %>
                </div>
              <% } %>
            </div>
            
            <div class="card-footer bg-light">
              <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                  <i class="bi bi-geo me-1"></i><%= venueData.venue.address.substring(0, 50) %>...
                </small>
                <button class="btn btn-primary btn-sm" 
                        onclick="checkVenueAvailability('<%= venueData.venue._id %>')">
                  <i class="bi bi-calendar-check me-1"></i>Check Availability
                </button>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<!-- Venue Availability Modal -->
<div class="modal fade" id="availabilityModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-calendar-check me-2"></i>Check Venue Availability
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="availabilityForm">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="checkDate" class="form-label">Date</label>
              <input type="date" class="form-control" id="checkDate" required>
            </div>
            <div class="col-md-6">
              <label for="checkTime" class="form-label">Time</label>
              <input type="time" class="form-control" id="checkTime" required>
            </div>
            <div class="col-md-6">
              <label for="duration" class="form-label">Duration (hours)</label>
              <select class="form-select" id="duration">
                <option value="1">1 Hour</option>
                <option value="2" selected>2 Hours</option>
                <option value="3">3 Hours</option>
                <option value="4">4 Hours</option>
                <option value="6">6 Hours</option>
                <option value="8">8 Hours</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">&nbsp;</label>
              <div class="d-grid">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-search me-1"></i>Check Availability
                </button>
              </div>
            </div>
          </div>
        </form>
        
        <div id="availabilityResults" class="mt-4" style="display: none;">
          <!-- Results will be loaded here -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let currentVenueId = null;

function checkVenueAvailability(venueId) {
  currentVenueId = venueId;
  document.getElementById('checkDate').value = new Date().toISOString().split('T')[0];
  document.getElementById('availabilityResults').style.display = 'none';
  new bootstrap.Modal(document.getElementById('availabilityModal')).show();
}

function loadMoreBookings(venueId) {
  // Redirect to detailed venue booking page
  window.location.href = `/admin/venue-bookings/venue/${venueId}`;
}

document.getElementById('availabilityForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const date = document.getElementById('checkDate').value;
  const time = document.getElementById('checkTime').value;
  const duration = document.getElementById('duration').value;
  
  try {
    const response = await fetch(`/admin/venue-bookings/check-availability?venueId=${currentVenueId}&date=${date}&time=${time}&duration=${duration}`);
    const result = await response.json();
    
    const resultsDiv = document.getElementById('availabilityResults');
    resultsDiv.style.display = 'block';
    
    if (result.success) {
      if (result.available) {
        resultsDiv.innerHTML = `
          <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            <strong>Available!</strong> The venue is free during the requested time slot.
          </div>
        `;
      } else {
        let conflictsHtml = result.conflicts.map(conflict => `
          <div class="border-start border-3 border-danger ps-3 mb-2">
            <h6 class="mb-1">${conflict.title}</h6>
            <p class="text-muted mb-1">Artist: ${conflict.artist}</p>
            <small class="text-danger">Time: ${conflict.time} (${conflict.duration}h) - ${conflict.status}</small>
          </div>
        `).join('');
        
        resultsDiv.innerHTML = `
          <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Conflicting Bookings Found!</strong>
          </div>
          <div class="mt-3">
            <h6>Conflicting Events:</h6>
            ${conflictsHtml}
          </div>
        `;
      }
      
      if (result.existingBookings.length > 0) {
        let bookingsHtml = result.existingBookings.map(booking => `
          <div class="border rounded p-2 mb-2">
            <div class="d-flex justify-content-between">
              <div>
                <strong>${booking.title}</strong><br>
                <small class="text-muted">${booking.artist} • ${booking.time} (${booking.duration}h)</small>
              </div>
              <span class="badge bg-${booking.status === 'approved' ? 'success' : 'warning'}">${booking.status}</span>
            </div>
          </div>
        `).join('');
        
        resultsDiv.innerHTML += `
          <div class="mt-3">
            <h6>All Bookings for this Date:</h6>
            ${bookingsHtml}
          </div>
        `;
      }
    } else {
      resultsDiv.innerHTML = `
        <div class="alert alert-danger">
          <i class="bi bi-x-circle me-2"></i>
          Error: ${result.message}
        </div>
      `;
    }
  } catch (error) {
    console.error('Error checking availability:', error);
    document.getElementById('availabilityResults').innerHTML = `
      <div class="alert alert-danger">
        <i class="bi bi-x-circle me-2"></i>
        Error checking availability. Please try again.
      </div>
    `;
  }
});
</script>

  </div>
</div>
