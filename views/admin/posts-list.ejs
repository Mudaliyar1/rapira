<!-- Admin Posts List (Server Rendered) -->
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="fw-bold mb-1">📸 Manage Artist Posts</h2>
      <p class="text-muted mb-0">Review, approve, reject, restrict, or delete artist posts</p>
    </div>
    <span class="badge bg-info fs-6">Total: <%= posts.length %></span>
  </div>

  <div class="card">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">All Posts</h5>
      <span class="badge bg-secondary"><%= posts.length %></span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle" style="min-width: 980px; table-layout: fixed;">
          <thead class="table-light">
            <tr>
              <th style="width:100px;">Media</th>
              <th style="width:160px;">Artist</th>
              <th>Caption</th>
              <th style="width:150px;">Status</th>
              <th style="width:70px;">Likes</th>
              <th style="width:70px;">Shares</th>
              <th style="width:120px;">Date</th>
              <th style="width:240px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!posts.length) { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">No posts found</td>
              </tr>
            <% } else { %>
              <% posts.forEach(post => { const media = post.media || {}; const mediaType = media.mediaType || media.type || 'image'; const mediaUrl = media.url || ''; const artist = post.artist || {}; const artistName = (artist.user && artist.user.name) || artist.stageName || 'Unknown'; const statusBadge = post.isApproved ? 'success' : 'warning text-dark'; const statusText = post.isApproved ? 'Approved' : 'Pending'; %>
                <tr>
                  <td style="width: 100px;">
                    <div class="media-wrap">
                      <% if (mediaType === 'image') { %>
                        <img src="<%= mediaUrl %>" class="post-media-thumb" alt="post">
                      <% } else { %>
                        <video class="post-media-thumb" muted><source src="<%= mediaUrl %>"></video>
                      <% } %>
                    </div>
                  </td>
                  <td><small><%= artistName %></small></td>
                  <td style="max-width: 320px;"><small><%= (post.caption || '(no caption)').slice(0, 140) %></small></td>
                  <td>
                    <div class="d-flex gap-2 flex-wrap">
                      <span class="badge bg-<%= statusBadge %> status-badge"><%= statusText %></span>
                      <% if (!post.isActive) { %>
                        <span class="badge bg-danger status-badge">Inactive</span>
                      <% } %>
                      <% if (post.rejectionReason) { %>
                        <span class="badge bg-danger status-badge">Rejected</span>
                      <% } %>
                    </div>
                  </td>
                  <td><%= post.likesCount || 0 %></td>
                  <td><%= post.shares || 0 %></td>
                  <td><small><%= new Date(post.createdAt).toLocaleDateString() %></small></td>
                  <td>
                    <div class="d-flex flex-wrap gap-2">
                      <a class="btn btn-sm btn-outline-info" href="/admin/posts/<%= post._id %>" title="View">
                        <i class="bi bi-eye"></i>
                      </a>
                      <button class="btn btn-sm btn-outline-success" onclick="approvePost('<%= post._id %>')" title="Approve"><i class="bi bi-check-circle"></i></button>
                      <button class="btn btn-sm btn-outline-warning" onclick="rejectPost('<%= post._id %>')" title="Reject"><i class="bi bi-x-circle"></i></button>
                      <button class="btn btn-sm btn-outline-secondary" onclick="deactivatePost('<%= post._id %>')" title="Restrict"><i class="bi bi-lock"></i></button>
                      <button class="btn btn-sm btn-outline-danger" onclick="deletePost('<%= post._id %>')" title="Delete"><i class="bi bi-trash"></i></button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  .post-media-thumb {
    width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 6px;
    max-width: 100%; max-height: 100%;
  }
  .media-wrap {
    width: 80px; height: 80px; overflow: hidden; border-radius: 8px; background: #0f0f0f; border: 1px solid rgba(255,255,255,0.08);
    flex-shrink: 0;
  }
  .media-wrap img, .media-wrap video { width: 100% !important; height: 100% !important; object-fit: cover; display: block; }
  tbody td:first-child { width: 100px; }
  tbody td { vertical-align: middle; }
  tbody td:first-child .post-media-thumb { max-width: 100%; max-height: 100%; }
  .status-badge { font-size: 0.8rem; }
</style>

<script>
function showAlert(message, type = 'info') {
  const alertId = `alert-${Date.now()}`;
  const html = `
    <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show position-fixed" style="top: 20px; right: 20px; z-index: 2000;">
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>`;
  document.body.insertAdjacentHTML('beforeend', html);
  setTimeout(() => { const el = document.getElementById(alertId); if (el) el.remove(); }, 4500);
}

async function approvePost(id) {
  if (!confirm('Approve this post?')) return;
  await handleAction(`/admin/posts/${id}/approve`, 'PUT', { isApproved: true }, 'Post approved');
}

async function rejectPost(id) {
  const reason = prompt('Enter rejection reason:');
  if (reason === null) return;
  await handleAction(`/admin/posts/${id}/approve`, 'PUT', { isApproved: false, rejectionReason: reason }, 'Post rejected');
}

async function deactivatePost(id) {
  const reason = prompt('Reason for restricting:', 'Policy violation');
  if (reason === null) return;
  await handleAction(`/admin/posts/${id}/deactivate`, 'PUT', { reason }, 'Post restricted');
}

async function deletePost(id) {
  if (!confirm('Delete this post? This cannot be undone.')) return;
  await handleAction(`/admin/posts/${id}`, 'DELETE', null, 'Post deleted');
}

async function handleAction(url, method, body, successMsg) {
  try {
    const res = await fetch(url, {
      method,
      headers: body ? { 'Content-Type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined
    });
    const data = await res.json();
    if (res.ok && data.success) {
      showAlert(successMsg, 'success');
      setTimeout(() => window.location.reload(), 500);
    } else {
      showAlert(data.message || 'Action failed', 'danger');
    }
  } catch (err) {
    console.error(err);
    showAlert('Unexpected error', 'danger');
  }
}
</script>
