<%- contentFor('body') %>
<style>
.glass-card-dark {
  background: rgba(33, 37, 41, 0.95) !important;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff;
}

.glass-card-dark .card-header {
  background: rgba(0, 0, 0, 0.3);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.glass-card-dark .card-footer {
  background: rgba(0, 0, 0, 0.3);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.table-dark {
  --bs-table-bg: rgba(33, 37, 41, 0.6);
  color: #fff;
}

.badge.bg-light {
  background-color: rgba(108, 117, 125, 0.8) !important;
  color: #fff !important;
}

.card.bg-dark {
  background-color: rgba(52, 58, 64, 0.8) !important;
  color: #fff;
}

.modal-content {
  background-color: #212529;
  color: #fff;
}

.modal-header {
  border-bottom-color: rgba(255, 255, 255, 0.1);
}

.modal-footer {
  border-top-color: rgba(255, 255, 255, 0.1);
}

.btn-close {
  filter: invert(1);
}
</style>

<!-- Concert Details -->
<div class="row">
  <div class="col-lg-8">
    <!-- Concert Information -->
    <div class="glass-card-dark mb-4">
      <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Concert Information</h5>
        <span class="badge <%= 
          concert.status === 'approved' ? 'bg-success' : 
          concert.status === 'pending' ? 'bg-warning' : 
          'bg-danger' %>">
          <%= concert.status.charAt(0).toUpperCase() + concert.status.slice(1) %>
        </span>
      </div>
      <div class="card-body p-4">
        <div class="row">
          <div class="col-md-6">
            <h2 class="fw-bold mb-3"><%= concert.title %></h2>
            
            <div class="mb-3">
              <h6 class="fw-bold">Artist:</h6>
              <p class="mb-0">
                <% if (concert.artist && concert.artist.user) { %>
                  <%= concert.artist.user.name %>
                <% } else { %>
                  Unknown
                <% } %>
              </p>
            </div>
            
            <div class="mb-3">
              <h6 class="fw-bold">Date & Time:</h6>
              <p class="mb-0">
                <%= toISTDateString(concert.date) %> • <%= concert.time %>
              </p>
            </div>
            
            <div class="mb-3">
              <h6 class="fw-bold">Venue:</h6>
              <div class="card bg-dark border-secondary p-3">
                <% if (concert.venue && typeof concert.venue === 'object' && concert.venue.name) { %>
                  <h6 class="text-primary mb-2"><%= concert.venue.name %></h6>
                  
                  <div class="row">
                    <div class="col-md-6">
                      <strong>Address:</strong><br>
                      <%= concert.venue.address %><br>
                      <%= concert.venue.city %>, <%= concert.venue.state %> - <%= concert.venue.pincode %><br><br>
                      
                      <strong>Capacity:</strong> <%= concert.venue.capacity %> people<br>
                      <strong>Venue Type:</strong> <%= concert.venue.venueType %><br>
                      <strong>Facilities:</strong> <%= concert.venue.facilities ? concert.venue.facilities.join(', ') : 'N/A' %><br><br>
                      
                      <strong>Contact Person:</strong><br>
                      Name: <%= concert.venue.contactPerson ? concert.venue.contactPerson.name : 'N/A' %><br>
                      Phone: <%= concert.venue.contactPerson ? concert.venue.contactPerson.phone : 'N/A' %><br>
                      Email: <%= concert.venue.contactPerson ? concert.venue.contactPerson.email : 'N/A' %>
                    </div>
                    
                    <div class="col-md-6">
                      <strong>Booking Details:</strong><br>
                      Hours Booked: <%= 
                        (concert.venueBooking && concert.venueBooking.bookingHours) || 
                        concert.bookingHours || 
                        'N/A' 
                      %> hours<br><br>
                      
                      <strong>Pricing Structure:</strong><br>
                      <% if (concert.venue.pricing) { %>
                        <% 
                        // Calculate commission percentage from booked hours
                        let commissionPercentage = 'N/A';
                        let commissionAmount = 'N/A';
                        if (concert.venue.pricing.hourlyRates && concert.venueBooking && concert.venueBooking.bookingHours) {
                          const bookedHours = concert.venueBooking.bookingHours;
                          const hourlyRate = concert.venue.pricing.hourlyRates.find(rate => rate.hours === bookedHours);
                          if (hourlyRate && hourlyRate.commissionPercentage !== undefined) {
                            commissionPercentage = hourlyRate.commissionPercentage;
                            commissionAmount = hourlyRate.commissionAmount || 'N/A';
                          }
                        }
                        %>
                        Commission for <%= concert.venueBooking.bookingHours || 1 %> hours: <%= commissionPercentage %>%<br>
                        Commission Amount: ₹<%= commissionAmount %><br>
                        Minimum Price: ₹<%= 
                          concert.venue.pricing.ticketPricing ? 
                            concert.venue.pricing.ticketPricing.minimumPrice : 
                            'N/A' 
                        %><br>
                        Suggested Price: ₹<%= 
                          concert.venue.pricing.ticketPricing ? 
                            concert.venue.pricing.ticketPricing.suggestedPrice : 
                            'N/A' 
                        %><br><br>
                        
                        <strong>Hourly Rates:</strong><br>
                        <% if (concert.venue.pricing.hourlyRates && concert.venue.pricing.hourlyRates.length > 0) { %>
                          <% concert.venue.pricing.hourlyRates.forEach((rateObj, index) => { %>
                            <% if (typeof rateObj === 'object' && rateObj.rate !== undefined) { %>
                              <%= rateObj.hours || (index + 1) %> Hour<%= (rateObj.hours > 1 || index > 0) ? 's' : '' %>: ₹<%= rateObj.rate %><br>
                            <% } else { %>
                              <%= index + 1 %> Hour<%= index > 0 ? 's' : '' %>: ₹<%= rateObj %><br>
                            <% } %>
                          <% }); %>
                        <% } else { %>
                          Standard hourly rates not available<br>
                        <% } %>
                        
                        <% if (concert.venue.pricing.minimumHours) { %>
                          Minimum Hours: <%= concert.venue.pricing.minimumHours %><br>
                        <% } %>
                        
                        <% if (concert.venue.pricing.currency) { %>
                          Currency: <%= concert.venue.pricing.currency %><br>
                        <% } %>
                        
                        <% if (concert.venue.pricing.additionalCharges && concert.venue.pricing.additionalCharges.length > 0) { %>
                          <strong>Additional Charges:</strong><br>
                          <% concert.venue.pricing.additionalCharges.forEach(charge => { %>
                            - <%= charge %><br>
                          <% }); %>
                        <% } %>
                      <% } else { %>
                        Pricing details not available<br>
                      <% } %>
                      
                      <% if (concert.venueBooking) { %>
                        <br><strong>Booking Status:</strong><br>
                        Booking Paid: <%= concert.venueBooking.isPaid ? 'Yes' : 'No' %><br>
                        <% if (concert.venueBooking.bookingHours) { %>
                          Confirmed Hours: <%= concert.venueBooking.bookingHours %><br>
                        <% } %>
                        <% if (concert.venueBooking.totalCost) { %>
                          Total Cost: ₹<%= concert.venueBooking.totalCost %><br>
                        <% } %>
                        <% if (concert.venueBooking.commission) { %>
                          Commission: ₹<%= concert.venueBooking.commission %><br>
                        <% } %>
                      <% } %>
                    </div>
                  </div>
                  
                  <% if (concert.venue.description) { %>
                    <div class="mt-2">
                      <strong>Description:</strong><br>
                      <%= concert.venue.description %>
                    </div>
                  <% } %>
                  
                <% } else if (concert.venue && typeof concert.venue === 'string') { %>
                  <%= concert.venue %>
                <% } else { %>
                  N/A
                <% } %>
              </div>
            </div>
            
            <div class="mb-3">
              <h6 class="fw-bold">City:</h6>
              <p class="mb-0"><%= concert.city %></p>
            </div>
          </div>
          
          <div class="col-md-6">
            <div class="mb-3">
              <h6 class="fw-bold">Type:</h6>
              <p class="mb-0">
                <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                  <%= concert.isPaid ? 'Paid' : 'Free' %>
                </span>
                <% if (concert.isPaid) { %>
                  <span class="ms-2">₹<%= concert.price %></span>
                <% } %>
              </p>
            </div>
            
            <div class="mb-3">
              <h6 class="fw-bold">Tickets:</h6>
              <p class="mb-0">
                <%= concert.ticketsSold %> sold / <%= concert.maxTickets > 0 ? concert.maxTickets : 'Unlimited' %> total
              </p>
            </div>
            
            <div class="mb-3">
              <h6 class="fw-bold">Created:</h6>
              <p class="mb-0"><%= toISTDateString(concert.createdAt) %></p>
            </div>
            
            <div class="mb-3">
              <h6 class="fw-bold">Last Updated:</h6>
              <p class="mb-0"><%= toISTDateString(concert.updatedAt) %></p>
            </div>
            
            <div class="mb-3">
              <h6 class="fw-bold">Artist's Payment ID:</h6>
              <% if (concert.paymentId || (concert.venueBooking && concert.venueBooking.paymentId)) { %>
                <p class="mb-1">
                  <code class="text-success"><%= concert.paymentId || concert.venueBooking.paymentId %></code>
                  <button class="btn btn-sm btn-outline-secondary ms-2" onclick="navigator.clipboard.writeText('<%= concert.paymentId || concert.venueBooking.paymentId %>').then(() => alert('Payment ID copied!'))" title="Copy Payment ID">
                    <i class="bi bi-clipboard"></i>
                  </button>
                </p>
              <% } else { %>
                <p class="mb-0"><span class="text-muted">N/A</span></p>
              <% } %>
            </div>
            
            <div class="mb-3">
              <h6 class="fw-bold">Artist's Order ID:</h6>
              <% if (concert.orderId || (concert.venueBooking && concert.venueBooking.orderId)) { %>
                <p class="mb-1">
                  <code class="text-info"><%= concert.orderId || concert.venueBooking.orderId %></code>
                  <button class="btn btn-sm btn-outline-secondary ms-2" onclick="navigator.clipboard.writeText('<%= concert.orderId || concert.venueBooking.orderId %>').then(() => alert('Order ID copied!'))" title="Copy Order ID">
                    <i class="bi bi-clipboard"></i>
                  </button>
                </p>
              <% } else { %>
                <p class="mb-0"><span class="text-muted">N/A</span></p>
              <% } %>
            </div>
          </div>
        </div>
        
        <div class="mt-3">
          <h6 class="fw-bold">Description:</h6>
          <p class="mb-0"><%= concert.description %></p>
        </div>
      </div>
      <div class="card-footer p-4">
        <div class="d-flex flex-wrap gap-2">
          <% if (concert.status === 'pending') { %>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">
              <i class="bi bi-check-circle me-1"></i> Approve
            </button>
            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
              <i class="bi bi-x-circle me-1"></i> Reject
            </button>
          <% } %>
          
          <a href="/concerts/<%= concert._id %>" target="_blank" class="btn btn-primary">
            <i class="bi bi-eye me-1"></i> View Public Page
          </a>
          
          <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash me-1"></i> Delete Concert
          </button>
        </div>
      </div>
    </div>
    
    <!-- Venue Booking Summary -->
    <% if (concert.venue && typeof concert.venue === 'object') { %>
    <div class="glass-card-dark mb-4">
      <div class="card-header py-3">
        <h5 class="card-title mb-0">Venue Booking Summary</h5>
      </div>
      <div class="card-body p-4">
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <h6 class="fw-bold text-success">Financial Details:</h6>
              <div class="table-responsive">
                <table class="table table-dark table-sm">
                  <tbody>
                    <tr>
                      <td><strong>Hours Booked:</strong></td>
                      <td><%= 
                        (concert.venueBooking && concert.venueBooking.bookingHours) || 
                        concert.bookingHours || 
                        'N/A' 
                      %> hours</td>
                    </tr>
                    <% if (concert.venue.pricing && concert.venue.pricing.hourlyRates) { %>
                    <tr>
                      <td><strong>Hourly Rate:</strong></td>
                      <td>
                        <% 
                        let currentRate = 'N/A';
                        const actualBookingHours = (concert.venueBooking && concert.venueBooking.bookingHours) || concert.bookingHours;
                        if (actualBookingHours && concert.venue.pricing.hourlyRates.length > 0) {
                          const bookingHours = parseInt(actualBookingHours);
                          const rateObj = concert.venue.pricing.hourlyRates.find(r => r.hours === bookingHours) || concert.venue.pricing.hourlyRates[0];
                          if (typeof rateObj === 'object' && rateObj.rate !== undefined) {
                            currentRate = '₹' + rateObj.rate;
                          } else {
                            currentRate = '₹' + rateObj;
                          }
                        }
                        %>
                        <%= currentRate %>
                      </td>
                    </tr>
                    <% } %>
                    <% if (concert.venue.pricing && concert.venue.pricing.ticketPricing && concert.venue.pricing.ticketPricing.minimumPrice) { %>
                    <tr>
                      <td><strong>Minimum Ticket Price:</strong></td>
                      <td class="text-info"><strong>₹<%= concert.venue.pricing.ticketPricing.minimumPrice %></strong></td>
                    </tr>
                    <% } %>
                    <% if (concert.venue.pricing && concert.venue.pricing.ticketPricing && concert.venue.pricing.ticketPricing.suggestedPrice) { %>
                    <tr>
                      <td><strong>Suggested Ticket Price:</strong></td>
                      <td class="text-success"><strong>₹<%= concert.venue.pricing.ticketPricing.suggestedPrice %></strong></td>
                    </tr>
                    <% } %>
                    <% 
                    // Calculate commission percentage from booked hours for table display
                    let tableCommissionPercentage = 'N/A';
                    if (concert.venue.pricing.hourlyRates && concert.venueBooking && concert.venueBooking.bookingHours) {
                      const bookedHours = concert.venueBooking.bookingHours;
                      const hourlyRate = concert.venue.pricing.hourlyRates.find(rate => rate.hours === bookedHours);
                      if (hourlyRate && hourlyRate.commissionPercentage !== undefined) {
                        tableCommissionPercentage = hourlyRate.commissionPercentage;
                      }
                    }
                    %>
                    <% if (tableCommissionPercentage !== 'N/A') { %>
                    <tr>
                      <td><strong>Admin Commission:</strong></td>
                      <td><%= tableCommissionPercentage %>% (for <%= concert.venueBooking.bookingHours || 1 %> hours)</td>
                    </tr>
                    <% } %>
                    <% if (concert.venueBooking && concert.venueBooking.totalCost) { %>
                    <tr>
                      <td><strong>Total Venue Cost:</strong></td>
                      <td class="text-success"><strong>₹<%= concert.venueBooking.totalCost %></strong></td>
                    </tr>
                    <% } %>
                    <% if (concert.venueBooking && concert.venueBooking.commission) { %>
                    <tr>
                      <td><strong>Commission Amount:</strong></td>
                      <td class="text-warning"><strong>₹<%= concert.venueBooking.commission %></strong></td>
                    </tr>
                    <% } %>
                    <% if (venueFinancials) { %>
                    <tr>
                      <td><strong>Total Expected Payment:</strong></td>
                      <td class="text-info"><strong>₹<%= venueFinancials.totalExpectedPayment.toFixed(2) %></strong></td>
                    </tr>
                    <% } %>
                    <% if (venueFinancials) { %>
                    <tr>
                      <td><strong>Paid by Artist (Admin Cut):</strong></td>
                      <td>₹<%= venueFinancials.commissionPaid.toFixed(2) %></td>
                    </tr>
                    <tr>
                      <td><strong>Paid by Artist (Direct):</strong></td>
                      <td>₹<%= venueFinancials.artistPaidDirect.toFixed(2) %></td>
                    </tr>
                    <tr>
                      <td><strong>Total Paid by Artist:</strong></td>
                      <td class="text-success"><strong>₹<%= venueFinancials.totalArtistPaid.toFixed(2) %></strong></td>
                    </tr>
                    <tr>
                      <td><strong>Remaining Balance:</strong></td>
                      <td class="text-warning"><strong>₹<%= venueFinancials.remainingBalance.toFixed(2) %></strong></td>
                    </tr>
                    <tr>
                      <td><strong>Payment Status:</strong></td>
                      <td>
                        <span class="badge <%= venueFinancials.paymentBadge %>">
                          <%= venueFinancials.paymentStatus %>
                        </span>
                      </td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          
          <div class="col-md-6">
            <div class="mb-3">
              <h6 class="fw-bold text-info">Venue Specifications:</h6>
              <div class="table-responsive">
                <table class="table table-dark table-sm">
                  <tbody>
                    <tr>
                      <td><strong>Capacity:</strong></td>
                      <td><%= concert.venue.capacity || 'N/A' %> people</td>
                    </tr>
                    <tr>
                      <td><strong>Venue Type:</strong></td>
                      <td><%= concert.venue.venueType || 'N/A' %></td>
                    </tr>
                    <tr>
                      <td><strong>Status:</strong></td>
                      <td>
                        <span class="badge <%= concert.venue.isActive ? 'bg-success' : 'bg-secondary' %>">
                          <%= concert.venue.isActive ? 'Active' : 'Inactive' %>
                        </span>
                        <% if (concert.venue.isVerified) { %>
                          <span class="badge bg-primary">Verified</span>
                        <% } %>
                      </td>
                    </tr>
                    <% if (concert.venue.pricing && concert.venue.pricing.minimumHours) { %>
                    <tr>
                      <td><strong>Minimum Hours:</strong></td>
                      <td><%= concert.venue.pricing.minimumHours %> hours</td>
                    </tr>
                    <% } %>
                    <% if (concert.venueBooking && concert.venueBooking.isPaid !== undefined) { %>
                    <tr>
                      <td><strong>Payment Status:</strong></td>
                      <td>
                        <span class="badge <%= concert.venueBooking.isPaid ? 'bg-success' : 'bg-warning' %>">
                          <%= concert.venueBooking.isPaid ? 'Paid' : 'Pending' %>
                        </span>
                      </td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        
        <% if (concert.venue.facilities && concert.venue.facilities.length > 0) { %>
        <div class="mt-3">
          <h6 class="fw-bold">Available Facilities:</h6>
          <div class="d-flex flex-wrap gap-1">
            <% concert.venue.facilities.forEach(facility => { %>
              <span class="badge bg-secondary text-light"><%= facility %></span>
            <% }); %>
          </div>
        </div>
        <% } %>
        
        <% if (concert.venue.pricing && concert.venue.pricing.additionalCharges && concert.venue.pricing.additionalCharges.length > 0) { %>
        <div class="mt-3">
          <h6 class="fw-bold">Additional Charges:</h6>
          <ul class="list-unstyled mb-0">
            <% concert.venue.pricing.additionalCharges.forEach(charge => { %>
              <li><i class="bi bi-arrow-right text-primary me-1"></i><%= charge %></li>
            <% }); %>
          </ul>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>
    
    <!-- Concert Image -->
    <% if (concert.image) { %>
      <div class="glass-card-dark mb-4">
        <div class="card-header py-3">
          <h5 class="card-title mb-0">Concert Image</h5>
        </div>
        <div class="card-body p-0">
          <img src="<%= concert.image %>" alt="<%= concert.title %>" class="img-fluid w-100">
        </div>
      </div>
    <% } %>
  </div>
  
  <div class="col-lg-4">
    <!-- Artist Information -->
    <div class="glass-card-dark mb-4">
      <div class="card-header py-3">
        <h5 class="card-title mb-0">Artist Information</h5>
      </div>
      <div class="card-body p-4">
        <% if (concert.artist && concert.artist.user) { %>
          <div class="text-center mb-4">
            <% if (concert.artist.user.profileImage) { %>
              <img src="<%= concert.artist.user.profileImage %>" alt="<%= concert.artist.user.name %>" class="rounded-circle img-thumbnail mb-3" width="100" height="100">
            <% } else { %>
              <div class="bg-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                <i class="bi bi-person-circle text-secondary" style="font-size: 3rem;"></i>
              </div>
            <% } %>
            
            <h5 class="fw-bold mb-1"><%= concert.artist.user.name %></h5>
            <p class="text-muted mb-0"><%= concert.artist.user.email %></p>
          </div>
          
          <div class="mb-3">
            <h6 class="fw-bold">Stage Name:</h6>
            <p class="mb-0"><%= concert.artist.stageName || concert.artist.user.name %></p>
          </div>
          
          <div class="mb-3">
            <h6 class="fw-bold">Genre:</h6>
            <p class="mb-0"><%= concert.artist.genre %></p>
          </div>
          
          <div class="mb-3">
            <h6 class="fw-bold">Verification Status:</h6>
            <p class="mb-0">
              <span class="badge <%= concert.artist.verified ? 'bg-success' : 'bg-warning' %>">
                <%= concert.artist.verified ? 'Verified' : 'Unverified' %>
              </span>
            </p>
          </div>
          
          <div class="mb-3">
            <h6 class="fw-bold">Featured Artist:</h6>
            <p class="mb-0">
              <span class="badge <%= concert.artist.featuredArtist ? 'bg-primary' : 'bg-secondary' %>">
                <%= concert.artist.featuredArtist ? 'Featured' : 'Not Featured' %>
              </span>
            </p>
          </div>
          
          <div class="d-grid">
            <a href="/artists/<%= concert.artist._id %>" target="_blank" class="btn btn-outline-primary">
              <i class="bi bi-eye me-1"></i> View Artist Profile
            </a>
          </div>
        <% } else { %>
          <div class="text-center py-4">
            <i class="bi bi-person-x display-4 text-muted mb-3"></i>
            <h6 class="text-muted">Artist information not available</h6>
          </div>
        <% } %>
      </div>
    </div>
    
    <!-- Ticket Information -->
    <div class="glass-card-dark">
      <div class="card-header py-3">
        <h5 class="card-title mb-0">Ticket Information</h5>
      </div>
      <div class="card-body p-4">
        <div class="mb-3">
          <h6 class="fw-bold">Tickets Sold:</h6>
          <p class="mb-0"><%= concert.ticketsSold %></p>
        </div>
        
        <div class="mb-3">
          <h6 class="fw-bold">Maximum Tickets:</h6>
          <p class="mb-0"><%= concert.maxTickets > 0 ? concert.maxTickets : 'Unlimited' %></p>
        </div>
        
        <div class="mb-3">
          <h6 class="fw-bold">Tickets Remaining:</h6>
          <p class="mb-0">
            <%= concert.maxTickets > 0 ? (concert.maxTickets - concert.ticketsSold) : 'Unlimited' %>
          </p>
        </div>
        
        <div class="mb-3">
          <h6 class="fw-bold">Revenue:</h6>
          <p class="mb-0">
            <% if (concert.isPaid) { %>
              ₹<%= (concert.price * concert.ticketsSold).toLocaleString() %>
            <% } else { %>
              Free Concert (No Revenue)
            <% } %>
          </p>
        </div>
        
        <div class="d-grid">
          <a href="/admin/tickets?concert=<%= concert._id %>" class="btn btn-outline-primary">
            <i class="bi bi-ticket-perforated me-1"></i> View Ticket Purchases
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modals -->
<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="approveModalLabel">Confirm Approval</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to approve the concert <strong><%= concert.title %></strong>?</p>
        <p class="mb-0">This will make the concert visible to all users and allow ticket bookings.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form action="/admin/concerts/<%= concert._id %>/approve" method="POST">
          <button type="submit" class="btn btn-success">Approve Concert</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="rejectModalLabel">Reject Concert</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form action="/admin/concerts/<%= concert._id %>/reject" method="POST" id="rejectForm">
          <div class="mb-3">
            <label for="reason" class="form-label">Reason for Rejection</label>
            <textarea class="form-control" id="reason" name="reason" rows="3" required></textarea>
            <div class="form-text">This will be sent to the artist.</div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" form="rejectForm" class="btn btn-danger">Reject Concert</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete the concert <strong><%= concert.title %></strong>?</p>
        <p class="text-danger mb-0">This action cannot be undone. All associated tickets will also be deleted.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form action="/admin/concerts/<%= concert._id %>/delete" method="POST">
          <button type="submit" class="btn btn-danger">Delete Concert</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- contentFor('title') %>Concert Details
