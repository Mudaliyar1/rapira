<div class="container-fluid py-3">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="text-white mb-0">
      <i class="bi bi-unlock-fill"></i> Artist Unblock Requests
    </h4>
    <form method="POST" action="/admin/unblock-requests/delete-history" onsubmit="return confirm('Delete all approved/rejected history? Pending requests will remain.');">
      <button type="submit" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-trash"></i> Delete History
      </button>
    </form>
  </div>

  <!-- Statistics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="glass-card-dark border border-secondary p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-white-50 mb-1 small">Total Requests</p>
            <h5 class="text-white mb-0"><%= stats.total %></h5>
          </div>
          <i class="bi bi-file-text fs-2 text-white-50"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card-dark border border-warning p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-white-50 mb-1 small">Pending</p>
            <h5 class="text-warning mb-0"><%= stats.pending %></h5>
          </div>
          <i class="bi bi-hourglass-split fs-2 text-warning"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card-dark border border-success p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-white-50 mb-1 small">Approved</p>
            <h5 class="text-success mb-0"><%= stats.approved %></h5>
          </div>
          <i class="bi bi-check-circle fs-2 text-success"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card-dark border border-danger p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p class="text-white-50 mb-1 small">Rejected</p>
            <h5 class="text-danger mb-0"><%= stats.rejected %></h5>
          </div>
          <i class="bi bi-x-circle fs-2 text-danger"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter -->
  <div class="glass-card-dark border border-secondary mb-4 p-3">
    <form method="GET" action="/admin/unblock-requests" class="row g-3 align-items-end">
      <div class="col-md-2">
        <label class="form-label text-white small">Status</label>
        <select name="status" class="form-select">
          <option value="all" <%= filterStatus === 'all' ? 'selected' : '' %>>All Status</option>
          <option value="pending" <%= filterStatus === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="approved" <%= filterStatus === 'approved' ? 'selected' : '' %>>Approved</option>
          <option value="rejected" <%= filterStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label text-white small">Email</label>
        <input type="text" name="email" class="form-control" placeholder="artist@email.com" value="<%= filterEmail %>">
      </div>

      <div class="col-md-3">
        <label class="form-label text-white small">Name</label>
        <input type="text" name="name" class="form-control" placeholder="Artist or User name" value="<%= filterName %>">
      </div>

      <div class="col-md-2">
        <label class="form-label text-white small">Location</label>
        <input type="text" name="location" class="form-control" placeholder="City or State" value="<%= filterLocation %>">
      </div>

      <div class="col-md-2">
        <label class="form-label text-white small">Sort</label>
        <select name="sort" class="form-select">
          <option value="newest" <%= sortOrder === 'newest' ? 'selected' : '' %>>Newest First</option>
          <option value="oldest" <%= sortOrder === 'oldest' ? 'selected' : '' %>>Oldest First</option>
        </select>
      </div>

      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-filter"></i> Filter
        </button>
      </div>

      <div class="col-md-2">
        <a href="/admin/unblock-requests" class="btn btn-outline-secondary w-100">
          <i class="bi bi-x-circle"></i> Clear
        </a>
      </div>
    </form>
  </div>

  <!-- Requests List -->
  <div class="glass-card-dark border border-secondary">
    <div class="card-header border-secondary">
      <h6 class="text-white mb-0">Unblock Requests</h6>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
          <thead>
            <tr>
              <th>Artist</th>
              <th>Email</th>
              <th>Message</th>
              <th>Status</th>
              <th>Requested</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (requests && requests.length > 0) { %>
              <% requests.forEach(request => { %>
                <tr>
                  <td class="text-white">
                    <div class="d-flex align-items-center">
                      <% if (request.artist && request.artist.user && request.artist.user.profileImage) { %>
                        <img src="<%= request.artist.user.profileImage %>" alt="<%= request.artist.stageName %>" class="rounded-circle me-2" style="width: 35px; height: 35px; object-fit: cover;">
                      <% } else { %>
                        <div class="bg-secondary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                          <i class="bi bi-person-fill text-white"></i>
                        </div>
                      <% } %>
                      <div>
                        <%= request.artist ? request.artist.stageName : 'Unknown' %>
                      </div>
                    </div>
                  </td>
                  <td class="text-white-50">
                    <%= request.artist && request.artist.user ? request.artist.user.email : 'N/A' %>
                  </td>
                    <td class="text-white-50">
                      <a href="/admin/unblock-requests/<%= request._id %>" class="btn btn-sm btn-outline-info">
                        <i class="bi bi-eye"></i> View
                      </a>
                    </td>
                  <td>
                    <% if (request.status === 'pending') { %>
                      <span class="badge bg-warning">
                        <i class="bi bi-hourglass-split"></i> Pending
                      </span>
                    <% } else if (request.status === 'approved') { %>
                      <span class="badge bg-success">
                        <i class="bi bi-check-circle-fill"></i> Approved
                      </span>
                    <% } else if (request.status === 'rejected') { %>
                      <span class="badge bg-danger">
                        <i class="bi bi-x-circle-fill"></i> Rejected
                      </span>
                    <% } %>
                  </td>
                  <td class="text-white-50">
                    <small><%= new Date(request.createdAt).toLocaleDateString('en-IN') %></small>
                  </td>
                  <td>
                    <% if (request.status === 'pending') { %>
                      <button type="button" class="btn btn-sm btn-success me-1" onclick="showApproveModal('<%= request._id %>', '<%= request.artist ? request.artist.stageName : '' %>')">
                        <i class="bi bi-check-circle"></i> Approve
                      </button>
                      <button type="button" class="btn btn-sm btn-danger me-1" onclick="showRejectModal('<%= request._id %>', '<%= request.artist ? request.artist.stageName : '' %>')">
                        <i class="bi bi-x-circle"></i> Reject
                      </button>
                      <form method="POST" action="/admin/unblock-requests/<%= request._id %>/delete" class="d-inline" onsubmit="return confirm('Delete this request? This cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                          <i class="bi bi-trash"></i> Delete
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-white-50 small me-2">
                        <%= request.reviewedBy ? 'By ' + request.reviewedBy.name : '' %>
                      </span>
                      <form method="POST" action="/admin/unblock-requests/<%= request._id %>/delete" class="d-inline" onsubmit="return confirm('Delete this request history? This cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                          <i class="bi bi-trash"></i> Delete
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-4 text-white-50">
                  <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                  <p class="mt-2 mb-0">No unblock requests found</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- View Message Modal -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Artist Message</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-white" id="modalMessage"></p>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <form id="approveForm" method="POST">
        <div class="modal-header border-secondary">
          <h5 class="modal-title text-white">Approve Unblock Request</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="text-white">Are you sure you want to approve the unblock request for <strong id="approveArtistName"></strong>?</p>
          <div class="alert alert-info">
            <i class="bi bi-info-circle-fill"></i>
            This will unblock the artist and allow them to access their dashboard again.
          </div>
          <div class="mb-3">
            <label for="approveResponse" class="form-label text-white">Response (Optional)</label>
            <textarea class="form-control" id="approveResponse" name="adminResponse" rows="2" placeholder="Message to the artist..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Approve
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <form id="rejectForm" method="POST">
        <div class="modal-header border-secondary">
          <h5 class="modal-title text-white">Reject Unblock Request</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="text-white">Are you sure you want to reject the unblock request for <strong id="rejectArtistName"></strong>?</p>
          <div class="mb-3">
            <label for="rejectResponse" class="form-label text-white">Reason (Required)</label>
            <textarea class="form-control" id="rejectResponse" name="adminResponse" rows="3" required placeholder="Explain why the request is rejected..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-x-circle"></i> Reject
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function showMessage(message) {
  document.getElementById('modalMessage').textContent = message;
  const modal = new bootstrap.Modal(document.getElementById('messageModal'));
  modal.show();
}

function showApproveModal(requestId, artistName) {
  document.getElementById('approveArtistName').textContent = artistName;
  document.getElementById('approveForm').action = '/admin/unblock-requests/' + requestId + '/approve';
  const modal = new bootstrap.Modal(document.getElementById('approveModal'));
  modal.show();
}

function showRejectModal(requestId, artistName) {
  document.getElementById('rejectArtistName').textContent = artistName;
  document.getElementById('rejectForm').action = '/admin/unblock-requests/' + requestId + '/reject';
  const modal = new bootstrap.Modal(document.getElementById('rejectModal'));
  modal.show();
}
</script>
