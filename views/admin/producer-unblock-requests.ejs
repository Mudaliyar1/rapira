<%- contentFor('body') %>

<div class="container-fluid">
  <!-- Header -->
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/producers" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-2"></i> Back to Producers
    </a>
    <div>
      <h2 class="fw-bold mb-1">Producer Unblock Requests</h2>
      <p class="text-muted mb-0">Manage producer unblock requests</p>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-0 small">Total Requests</p>
            <h3 class="fw-bold mb-0"><%= stats.total %></h3>
          </div>
          <i class="bi bi-shield-check text-primary fs-3"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-0 small">Pending</p>
            <h3 class="fw-bold text-warning mb-0"><%= stats.pending %></h3>
          </div>
          <i class="bi bi-hourglass-split text-warning fs-3"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-0 small">Approved</p>
            <h3 class="fw-bold text-success mb-0"><%= stats.approved %></h3>
          </div>
          <i class="bi bi-check-circle text-success fs-3"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-0 small">Rejected</p>
            <h3 class="fw-bold text-danger mb-0"><%= stats.rejected %></h3>
          </div>
          <i class="bi bi-x-circle text-danger fs-3"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <form method="GET" class="row g-3 flex-grow-1">
          <div class="col-md-4">
          <input type="text" name="search" placeholder="Search producer name or email..." class="form-control" value="<%= filters.search || '' %>">
          </div>
          <div class="col-md-3">
          <select name="status" class="form-select">
            <option value="">All Status</option>
            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
            <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>
          </div>
          <div class="col-md-3">
          <select name="sortBy" class="form-select">
            <option value="">Sort By</option>
            <option value="recent" <%= filters.sortBy === 'recent' ? 'selected' : '' %>>Recent First</option>
            <option value="oldest" <%= filters.sortBy === 'oldest' ? 'selected' : '' %>>Oldest First</option>
            <option value="name" <%= filters.sortBy === 'name' ? 'selected' : '' %>>Producer Name</option>
          </select>
          </div>
          <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-search me-1"></i> Filter
          </button>
          </div>
        </form>
        <form method="POST" action="/admin/producers/unblock-requests/delete-all" onsubmit="return confirm('Delete all producer unblock request history? This action cannot be undone.');">
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>Delete All
          </button>
        </form>
        </div>
    </div>
  </div>

  <!-- Requests Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <% if (requests.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Producer</th>
                <th>Status</th>
                <th>Requested Date</th>
                <th>Message</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% requests.forEach(request => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <img src="<%= request.producer.profileImage || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(request.producer.name.charAt(0)) %>"
                           alt="<%= request.producer.name %>"
                           class="rounded-circle"
                           width="32" height="32"
                           style="object-fit: cover;">
                      <div>
                        <p class="mb-0 fw-500"><%= request.producer.name %></p>
                        <small class="text-muted"><%= request.producer.email %></small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge <%= request.status === 'approved' ? 'bg-success' : request.status === 'pending' ? 'bg-warning' : 'bg-danger' %>">
                      <%= request.status.charAt(0).toUpperCase() + request.status.slice(1) %>
                    </span>
                  </td>
                  <td>
                    <%= new Date(request.createdAt).toLocaleDateString('en-IN') %>
                    <br>
                    <small class="text-muted"><%= new Date(request.createdAt).toLocaleTimeString('en-IN') %></small>
                  </td>
                  <td>
                    <small><%= request.message.substring(0, 50) %>...</small>
                  </td>
                  <td>
                    <div class="d-flex flex-wrap gap-2">
                      <a href="/admin/producers/unblock-requests/<%= request._id %>" class="btn btn-sm btn-primary">
                        <i class="bi bi-eye me-1"></i> View
                      </a>
                      <form method="POST" action="/admin/producers/unblock-requests/<%= request._id %>/delete" onsubmit="return confirm('Delete this producer unblock request record?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-info mb-0">
          <i class="bi bi-info-circle me-2"></i>
          No unblock requests found.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <nav aria-label="Page navigation" class="mt-4">
      <ul class="pagination justify-content-center">
        <% if (currentPage > 1) { %>
          <li class="page-item">
            <a class="page-link" href="?page=1<%= filters.status ? '&status=' + filters.status : '' %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.sortBy ? '&sortBy=' + filters.sortBy : '' %>">First</a>
          </li>
          <li class="page-item">
            <a class="page-link" href="?page=<%= currentPage - 1 %><%= filters.status ? '&status=' + filters.status : '' %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.sortBy ? '&sortBy=' + filters.sortBy : '' %>">Previous</a>
          </li>
        <% } %>

        <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
          <li class="page-item <%= i === currentPage ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %><%= filters.status ? '&status=' + filters.status : '' %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.sortBy ? '&sortBy=' + filters.sortBy : '' %>"><%= i %></a>
          </li>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <li class="page-item">
            <a class="page-link" href="?page=<%= currentPage + 1 %><%= filters.status ? '&status=' + filters.status : '' %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.sortBy ? '&sortBy=' + filters.sortBy : '' %>">Next</a>
          </li>
          <li class="page-item">
            <a class="page-link" href="?page=<%= totalPages %><%= filters.status ? '&status=' + filters.status : '' %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.sortBy ? '&sortBy=' + filters.sortBy : '' %>">Last</a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</div>
