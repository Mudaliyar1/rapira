<%- contentFor('body') %>
<!-- Tickets Table -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 text-white">All Tickets</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th class="text-white">#</th>
            <th class="text-white">Ticket #</th>
            <th class="text-white">User</th>
            <th class="text-white">Concert</th>
            <th class="text-white">Quantity</th>
            <th class="text-white">Amount</th>
            <th class="text-white">Status</th>
            <th class="text-white">Date</th>
            <th class="text-white">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (tickets && tickets.length > 0) { %>
            <% tickets.forEach(ticket => { %>
              <tr>
                <td class="text-white"><%= tickets.indexOf(ticket) + 1 %></td>
                <td>
                  <span class="ticket-number text-white"><%= ticket.ticketNumber %></span>
                </td>
                <td>
                  <div class="fw-medium text-white"><%= ticket.user.name %></div>
                  <div class="small text-primary"><%= ticket.user.email %></div>
                </td>
                <td>
                  <% if (ticket.concert) { %>
                    <div class="fw-medium text-white"><%= ticket.concert.title %></div>
                    <div class="small text-primary"><%= new Date(ticket.concert.date).toLocaleDateString() %></div>
                  <% } else { %>
                    <span class="text-muted">N/A</span>
                  <% } %>
                </td>
                <td class="text-white"><%= ticket.quantity %></td>
                <td class="text-white">₹<%= ticket.totalAmount %></td>
                <td>
                  <span class="badge <%=
                    ticket.paymentStatus === 'completed' ? 'bg-success' :
                    ticket.paymentStatus === 'pending' ? 'bg-warning' :
                    'bg-danger' %>">
                    <%= ticket.paymentStatus.charAt(0).toUpperCase() + ticket.paymentStatus.slice(1) %>
                  </span>
                </td>
                <td class="text-white"><%= new Date(ticket.purchaseDate).toLocaleDateString() %></td>
                <td>
                  <div class="d-flex gap-2">
                    <a href="/admin/tickets/<%= ticket._id %>" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-eye"></i>
                    </a>
                    <form action="/admin/tickets/<%= ticket._id %>/delete" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this ticket? This action cannot be undone.')">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-4 text-white">No tickets found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
