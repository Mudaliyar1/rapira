<%- contentFor('extraStyles') %>
<!-- DataTables CSS -->
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">
<style>
  /* DataTables Dark Theme Overrides */
  .dataTables_wrapper {
    color: #fff !important;
  }
  .dataTables_filter input,
  .dataTables_length select {
    background-color: #2b2b2b !important;
    color: #fff !important;
    border: 1px solid #444 !important;
  }
  .dataTables_info,
  .dataTables_paginate {
    color: #fff !important;
  }
  .page-link {
    background-color: #2b2b2b !important;
    border-color: #444 !important;
    color: #fff !important;
  }
  .page-link:hover {
    background-color: #444 !important;
    border-color: #666 !important;
    color: #fff !important;
  }
  .page-item.active .page-link {
    background-color: #0d6efd !important;
    border-color: #0d6efd !important;
  }
</style>

<%- contentFor('body') %>

<!-- Session Stats Cards -->
<div class="row g-4 mb-4">
  <div class="col-md-6 col-lg-3">
    <div class="stat-card glass-card-dark p-3">
      <div class="d-flex align-items-center">
        <div class="stat-icon bg-primary-subtle text-primary me-3">
          <i class="bi bi-people"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 text-white"><%= totalSessions %></h3>
          <p class="text-white-50 mb-0">Active Sessions</p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-3">
    <div class="stat-card glass-card-dark p-3">
      <div class="d-flex align-items-center">
        <div class="stat-icon bg-success-subtle text-success me-3">
          <i class="bi bi-shield-check"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 text-white">1024</h3>
          <p class="text-white-50 mb-0">Session ID</p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-3">
    <div class="stat-card glass-card-dark p-3">
      <div class="d-flex align-items-center">
        <div class="stat-icon bg-warning-subtle text-warning me-3">
          <i class="bi bi-clock"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 text-white">30m</h3>
          <p class="text-white-50 mb-0">Avg Duration</p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-3">
    <div class="stat-card glass-card-dark p-3">
      <div class="d-flex align-items-center">
        <div class="stat-icon bg-danger-subtle text-danger me-3">
          <i class="bi bi-exclamation-triangle"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 text-white">0</h3>
          <p class="text-white-50 mb-0">Expired</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Session Management Actions -->
<div class="row g-4 mb-4">
  <div class="col-lg-6">
    <div class="glass-card-dark border border-secondary">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">
          <i class="bi bi-gear me-2"></i>Session Management Actions
        </h5>
      </div>
      <div class="card-body">
        <div class="alert alert-warning" role="alert">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Warning:</strong> Clearing sessions will log out all users and require them to log in again.
          Your admin session will be preserved.
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="glass-card-dark border border-danger">
              <div class="card-header border-bottom border-danger">
                <h6 class="card-title mb-0 text-white">Clear All Sessions</h6>
              </div>
              <div class="card-body">
                <p class="text-white mb-3">This will clear all user sessions except your current admin session.</p>
                <form action="/admin/sessions/clear-all" method="POST">
                  <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Are you sure you want to clear ALL user sessions? This will log out all users.')">
                    <i class="bi bi-trash me-1"></i> Clear All Sessions
                  </button>
                </form>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="glass-card-dark border border-warning">
              <div class="card-header border-bottom border-warning">
                <h6 class="card-title mb-0 text-white">Clear Expired Sessions</h6>
              </div>
              <div class="card-body">
                <p class="text-white mb-3">This will only clear sessions that have already expired.</p>
                <form action="/admin/sessions/clear-expired" method="POST">
                  <button type="submit" class="btn btn-warning w-100">
                    <i class="bi bi-broom me-1"></i> Clear Expired Sessions
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <div class="glass-card-dark border border-info">
          <div class="card-header border-bottom border-info">
            <h6 class="card-title mb-0 text-white">Clear Sessions by User Role</h6>
          </div>
          <div class="card-body">
            <p class="text-white mb-3">Clear all sessions for users with a specific role.</p>
            <form action="/admin/sessions/clear-by-role" method="POST">
              <div class="mb-3">
                <select class="form-select bg-dark text-white border-secondary" name="role" required>
                  <option value="">Select a role...</option>
                  <option value="user">Regular Users</option>
                  <option value="artist">Artists</option>
                  <option value="admin">Admins (except you)</option>
                </select>
              </div>
              <button type="submit" class="btn btn-info w-100" onclick="return confirm('Are you sure you want to clear sessions for this role?')">
                <i class="bi bi-person-x me-1"></i> Clear Sessions by Role
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="glass-card-dark border border-secondary">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">
          <i class="bi bi-cookie me-2"></i>Cookie Management
        </h5>
      </div>
      <div class="card-body">
        <div class="alert alert-info" role="alert">
          <i class="bi bi-info-circle me-2"></i>
          <strong>Note:</strong> These actions affect how cookies work for all users.
        </div>

        <div class="glass-card-dark border border-primary mb-4">
          <div class="card-header border-bottom border-primary">
            <h6 class="card-title mb-0 text-white">Force Cookie Refresh</h6>
          </div>
          <div class="card-body">
            <p class="text-white mb-3">This will change the cookie settings to force all users to get new cookies on their next visit.</p>
            <button id="refreshCookieBtn" class="btn btn-primary w-100">
              <i class="bi bi-arrow-clockwise me-1"></i> Force Cookie Refresh
            </button>
            <div id="cookieRefreshResult" class="mt-3 d-none alert alert-success"></div>
          </div>
        </div>

        <div class="glass-card-dark border border-secondary">
          <div class="card-header border-bottom border-secondary">
            <h6 class="card-title mb-0 text-white">Current Cookie Settings</h6>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-dark table-striped">
                <tbody>
                  <tr>
                    <th class="text-white">Environment</th>
                    <td class="text-white"><%= process.env.NODE_ENV || 'development' %></td>
                  </tr>
                  <tr>
                    <th class="text-white">Cookie Secure</th>
                    <td class="text-white">
                      <% if (process.env.NODE_ENV === 'production') { %>
                        <%= process.env.PROD_SESSION_COOKIE_SECURE || 'false' %>
                      <% } else { %>
                        <%= process.env.DEV_SESSION_COOKIE_SECURE || 'false' %>
                      <% } %>
                    </td>
                  </tr>
                  <tr>
                    <th class="text-white">Cookie SameSite</th>
                    <td class="text-white">
                      <% if (process.env.NODE_ENV === 'production') { %>
                        <%= process.env.PROD_SESSION_COOKIE_SAMESITE || 'lax' %>
                      <% } else { %>
                        <%= process.env.DEV_SESSION_COOKIE_SAMESITE || 'lax' %>
                      <% } %>
                    </td>
                  </tr>
                  <tr>
                    <th class="text-white">Cookie Domain</th>
                    <td class="text-white">
                      <% if (process.env.NODE_ENV === 'production') { %>
                        <%= process.env.PROD_SESSION_COOKIE_DOMAIN || 'not set' %>
                      <% } else { %>
                        <%= process.env.DEV_SESSION_COOKIE_DOMAIN || 'not set' %>
                      <% } %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Sessions Table -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">
      <i class="bi bi-table me-2"></i>Recent Sessions
    </h5>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-dark table-striped table-hover" id="sessionsTable" width="100%" cellspacing="0">
        <thead class="table-dark">
          <tr>
            <th class="text-white">Session ID</th>
            <th class="text-white">User</th>
            <th class="text-white">Role</th>
            <th class="text-white">Created</th>
            <th class="text-white">Expires</th>
          </tr>
        </thead>
        <tbody>
          <% if (sessions && sessions.length > 0) { %>
            <% sessions.forEach(session => { %>
              <tr>
                <td class="text-white">
                  <code class="text-info bg-dark px-2 py-1 rounded"><%= session.id.substring(0, 10) %>...</code>
                  <% if (session.error) { %>
                    <span class="badge bg-warning text-dark ms-2" title="<%= session.error %>">Error</span>
                  <% } %>
                </td>
                <td class="text-white">
                  <% if (session.user && session.user.name) { %>
                    <%= session.user.name %>
                    <% if (session.user.email) { %>
                      <small class="text-white-50 d-block">(<%= session.user.email %>)</small>
                    <% } %>
                  <% } else if (session.error) { %>
                    <span class="text-danger">Error parsing session</span>
                  <% } else { %>
                    <span class="text-white-50">Anonymous</span>
                  <% } %>
                </td>
                <td class="text-white">
                  <% if (session.user && session.user.role) { %>
                    <span class="badge bg-<%= session.user.role === 'admin' ? 'danger' : (session.user.role === 'artist' ? 'primary' : 'secondary') %>">
                      <%= session.user.role %>
                    </span>
                  <% } else { %>
                    <span class="text-white-50">N/A</span>
                  <% } %>
                </td>
                <td class="text-white"><%= session.created %></td>
                <td class="text-white"><%= session.expires %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center text-white-50">No sessions found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- DataTables JS -->
<script type="text/javascript" src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize DataTable with dark theme styling
    try {
      $('#sessionsTable').DataTable({
        order: [[3, 'desc']], // Sort by created date by default (newest first)
        language: {
          emptyTable: "No sessions found",
          zeroRecords: "No matching sessions found"
        },
        pageLength: 25,
        responsive: true,
        dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
             '<"row"<"col-sm-12"tr>>' +
             '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
        drawCallback: function() {
          // Ensure dark theme styling is maintained after redraw
          $('.dataTables_wrapper').addClass('text-white');
          $('.dataTables_filter input').addClass('bg-dark text-white border-secondary');
          $('.dataTables_length select').addClass('bg-dark text-white border-secondary');
        }
      });
    } catch (error) {
      console.error('Error initializing DataTable:', error);
    }

    // Handle cookie refresh button
    const refreshCookieBtn = document.getElementById('refreshCookieBtn');
    const cookieRefreshResult = document.getElementById('cookieRefreshResult');

    if (refreshCookieBtn) {
      refreshCookieBtn.addEventListener('click', function() {
        // Generate a random cookie secret
        const newSecret = Math.random().toString(36).substring(2, 15) +
                         Math.random().toString(36).substring(2, 15);

        // Show success message with instructions
        cookieRefreshResult.innerHTML = `
          <p><strong>Cookie refresh initiated!</strong></p>
          <p>To complete this action, you need to update your .env file with a new SESSION_SECRET:</p>
          <pre class="bg-dark text-info p-2 rounded">SESSION_SECRET=${newSecret}</pre>
          <p>After updating, restart your server to apply the changes.</p>
        `;
        cookieRefreshResult.classList.remove('d-none');
      });
    }
  });
</script>
