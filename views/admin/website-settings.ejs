<%- contentFor('body') %>

<!-- Flash Messages -->
<% if (success && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Website Settings Tabs -->
<div class="glass-card-dark">
  <div class="card-header border-bottom border-secondary">
    <ul class="nav nav-tabs card-header-tabs" id="settingsTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active text-white" id="header-tab" data-bs-toggle="tab" data-bs-target="#header" type="button" role="tab">
          <i class="bi bi-layout-text-window-reverse me-2"></i>Header & Branding
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="menu-tab" data-bs-toggle="tab" data-bs-target="#menu" type="button" role="tab">
          <i class="bi bi-list me-2"></i>Navigation Menu
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="site-tab" data-bs-toggle="tab" data-bs-target="#site" type="button" role="tab">
          <i class="bi bi-gear me-2"></i>Site Settings
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="theme-tab" data-bs-toggle="tab" data-bs-target="#theme" type="button" role="tab">
          <i class="bi bi-palette me-2"></i>Theme Colors
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="venue-tab" data-bs-toggle="tab" data-bs-target="#venue" type="button" role="tab">
          <i class="bi bi-building me-2"></i>Venue Settings
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin" type="button" role="tab">
          <i class="bi bi-gear me-2"></i>Admin Settings
        </button>
      </li>
    </ul>
  </div>

  <div class="card-body">
    <div class="tab-content" id="settingsTabContent">
      
      <!-- Header & Branding Tab -->
      <div class="tab-pane fade show active" id="header" role="tabpanel">
        <form action="/admin/website-settings/header" method="POST" enctype="multipart/form-data">
          <div class="row">
            <div class="col-md-6">
              <h5 class="text-white mb-3">Header Configuration</h5>
              
              <!-- Brand Type -->
              <div class="mb-3">
                <label class="form-label text-white">Brand Display Type</label>
                <select class="form-select bg-dark text-white border-secondary" name="brandType" id="brandType">
                  <option value="text" <%= settings.headerSettings.brandType === 'text' ? 'selected' : '' %>>Text Only</option>
                  <option value="logo" <%= settings.headerSettings.brandType === 'logo' ? 'selected' : '' %>>Logo Only</option>
                  <option value="both" <%= settings.headerSettings.brandType === 'both' ? 'selected' : '' %>>Logo + Text</option>
                </select>
              </div>

              <!-- Brand Text -->
              <div class="mb-3" id="brandTextGroup">
                <label class="form-label text-white">Brand Text</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" name="brandText" 
                       value="<%= settings.headerSettings.brandText %>" placeholder="Enter brand name">
              </div>

              <!-- Logo Upload -->
              <div class="mb-3" id="logoGroup">
                <label class="form-label text-white">Logo Image</label>
                <input type="file" class="form-control bg-dark text-white border-secondary" name="logo" accept="image/*">
                <small class="text-muted">Supported formats: JPG, PNG, GIF, SVG (Max: 5MB)</small>
              </div>

              <!-- Logo Height -->
              <div class="mb-3" id="logoHeightGroup">
                <label class="form-label text-white">Logo Height (px)</label>
                <input type="number" class="form-control bg-dark text-white border-secondary" name="logoHeight" 
                       value="<%= settings.headerSettings.logoHeight %>" min="20" max="100">
              </div>

              <!-- Show Brand Text (for 'both' type) -->
              <div class="mb-3" id="showBrandTextGroup">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="showBrandText" id="showBrandText" 
                         <%= settings.headerSettings.showBrandText ? 'checked' : '' %>>
                  <label class="form-check-label text-white" for="showBrandText">
                    Show brand text alongside logo
                  </label>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <h5 class="text-white mb-3">Current Header Preview</h5>
              <div class="border border-secondary rounded p-3 bg-dark">
                <div class="d-flex align-items-center">
                  <% if (settings.headerSettings.logoUrl && (settings.headerSettings.brandType === 'logo' || settings.headerSettings.brandType === 'both')) { %>
                    <img src="<%= settings.headerSettings.logoUrl %>" alt="Current Logo" 
                         class="me-2" id="currentLogo">
                  <% } %>
                  <% if (settings.headerSettings.showBrandText && (settings.headerSettings.brandType === 'text' || settings.headerSettings.brandType === 'both')) { %>
                    <span class="fs-4 fw-bold gradient-text-purple"><%= settings.headerSettings.brandText %></span>
                  <% } %>
                </div>
              </div>

              <% if (settings.headerSettings.logoUrl) { %>
                <div class="mt-3">
                  <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeLogo()">
                    <i class="bi bi-trash me-1"></i>Remove Current Logo
                  </button>
                </div>
              <% } %>
            </div>
          </div>

          <div class="mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i>Save Header Settings
            </button>
          </div>
        </form>
      </div>

      <!-- Navigation Menu Tab -->
      <div class="tab-pane fade" id="menu" role="tabpanel">
        <div class="mb-4">
          <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Dynamic Navigation Management:</strong> This system automatically detects all available pages and routes in your application.
            When you add new pages or routes, they will automatically appear here for you to manage.
          </div>

        </div>

        <form action="/admin/website-settings/menu" method="POST">
          <div class="row">
            <!-- Discover Menu -->
            <div class="col-md-3">
              <h5 class="text-white mb-3">
                <i class="bi bi-compass me-2"></i>Discover Menu
              </h5>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="discoverMenuEnabled" id="discoverMenuEnabled"
                         <%= settings.menuSettings.discoverMenu.enabled ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold" for="discoverMenuEnabled">
                    Enable Discover Menu
                  </label>
                </div>
              </div>

              <div class="ms-3">
                <% if (menuConfiguration && menuConfiguration.discoverMenu && menuConfiguration.discoverMenu.routes) { %>
                  <% Object.keys(menuConfiguration.discoverMenu.routes).forEach(key => { %>
                    <% const route = menuConfiguration.discoverMenu.routes[key]; %>
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="<%= key %>" id="discover_<%= key %>"
                             <%= settings.menuSettings.discoverMenu.items && settings.menuSettings.discoverMenu.items[key] ? 'checked' : '' %>>
                      <label class="form-check-label text-white" for="discover_<%= key %>">
                        <i class="<%= route.icon %> me-1"></i><%= route.name %>
                        <% if (route.isDynamic) { %>
                          <small class="badge bg-secondary ms-1">Dynamic</small>
                        <% } %>
                        <% if (settings.menuSettings.discoverMenu.items && settings.menuSettings.discoverMenu.items[key]) { %>
                          <small class="badge bg-success ms-1">Enabled</small>
                        <% } else { %>
                          <small class="badge bg-danger ms-1">Disabled</small>
                        <% } %>
                      </label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Services Menu -->
            <div class="col-md-3">
              <h5 class="text-white mb-3">
                <i class="bi bi-gear me-2"></i>Services Menu
              </h5>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="servicesMenuEnabled"
                         <%= settings.menuSettings.servicesMenu.enabled ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold">
                    Enable Services Menu
                  </label>
                </div>
              </div>

              <div class="ms-3">
                <% if (menuConfiguration && menuConfiguration.servicesMenu && menuConfiguration.servicesMenu.routes) { %>
                  <% Object.keys(menuConfiguration.servicesMenu.routes).forEach(key => { %>
                    <% const route = menuConfiguration.servicesMenu.routes[key]; %>
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="<%= key %>" id="services_<%= key %>"
                             <%= settings.menuSettings.servicesMenu.items && settings.menuSettings.servicesMenu.items[key] ? 'checked' : '' %>>
                      <label class="form-check-label text-white" for="services_<%= key %>">
                        <i class="<%= route.icon %> me-1"></i><%= route.name %>
                        <% if (route.isDynamic) { %>
                          <small class="badge bg-secondary ms-1">Dynamic</small>
                        <% } %>
                        <% if (settings.menuSettings.servicesMenu.items && settings.menuSettings.servicesMenu.items[key]) { %>
                          <small class="badge bg-success ms-1">Enabled</small>
                        <% } else { %>
                          <small class="badge bg-danger ms-1">Disabled</small>
                        <% } %>
                      </label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Shop Menu -->
            <div class="col-md-3">
              <h5 class="text-white mb-3">
                <i class="bi bi-bag me-2"></i>Shop Menu
              </h5>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="shopMenuEnabled"
                         <%= settings.menuSettings.shopMenu.enabled ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold">
                    Enable Shop Menu
                  </label>
                </div>
              </div>

              <div class="ms-3">
                <% if (menuConfiguration && menuConfiguration.shopMenu && menuConfiguration.shopMenu.routes) { %>
                  <% Object.keys(menuConfiguration.shopMenu.routes).forEach(key => { %>
                    <% const route = menuConfiguration.shopMenu.routes[key]; %>
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="<%= key %>" id="shop_<%= key %>"
                             <%= settings.menuSettings.shopMenu.items && settings.menuSettings.shopMenu.items[key] ? 'checked' : '' %>>
                      <label class="form-check-label text-white" for="shop_<%= key %>">
                        <i class="<%= route.icon %> me-1"></i><%= route.name %>
                        <% if (route.isDynamic) { %>
                          <small class="badge bg-secondary ms-1">Dynamic</small>
                        <% } %>
                        <% if (settings.menuSettings.shopMenu.items && settings.menuSettings.shopMenu.items[key]) { %>
                          <small class="badge bg-success ms-1">Enabled</small>
                        <% } else { %>
                          <small class="badge bg-danger ms-1">Disabled</small>
                        <% } %>
                      </label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Help & Support Menu -->
            <div class="col-md-3">
              <h5 class="text-white mb-3">
                <i class="bi bi-question-circle me-2"></i>Help & Support Menu
              </h5>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="helpSupportMenuEnabled"
                         <%= settings.menuSettings.helpSupportMenu.enabled ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold">
                    Enable Help & Support Menu
                  </label>
                </div>
              </div>

              <div class="ms-3">
                <% if (menuConfiguration && menuConfiguration.helpSupportMenu && menuConfiguration.helpSupportMenu.routes) { %>
                  <% Object.keys(menuConfiguration.helpSupportMenu.routes).forEach(key => { %>
                    <% const route = menuConfiguration.helpSupportMenu.routes[key]; %>
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="<%= key %>" id="help_<%= key %>"
                             <%= settings.menuSettings.helpSupportMenu.items && settings.menuSettings.helpSupportMenu.items[key] ? 'checked' : '' %>>
                      <label class="form-check-label text-white" for="help_<%= key %>">
                        <i class="<%= route.icon %> me-1"></i><%= route.name %>
                        <% if (route.isDynamic) { %>
                          <small class="badge bg-secondary ms-1">Dynamic</small>
                        <% } %>
                        <% if (settings.menuSettings.helpSupportMenu.items && settings.menuSettings.helpSupportMenu.items[key]) { %>
                          <small class="badge bg-success ms-1">Enabled</small>
                        <% } else { %>
                          <small class="badge bg-danger ms-1">Disabled</small>
                        <% } %>
                      </label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Form Actions -->
          <div class="row mt-4">
            <div class="col-12">
              <div class="d-flex justify-content-start" style="position: relative; z-index: 1;">
                <button type="submit" class="btn btn-primary" style="position: relative; z-index: 2;">
                  <i class="bi bi-save me-1"></i>Save Menu Settings
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- Site Settings Tab -->
      <div class="tab-pane fade" id="site" role="tabpanel">
        <form action="/admin/website-settings/site" method="POST">
          <div class="row">
            <div class="col-md-8">
              <h5 class="text-white mb-3">General Site Settings</h5>
              
              <div class="mb-3">
                <label class="form-label text-white">Site Name</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" name="siteName" 
                       value="<%= settings.siteSettings.siteName %>">
              </div>

              <div class="mb-3">
                <label class="form-label text-white">Site Description</label>
                <textarea class="form-control bg-dark text-white border-secondary" name="siteDescription" rows="3"><%= settings.siteSettings.siteDescription %></textarea>
              </div>

              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="maintenanceMode" 
                         <%= settings.siteSettings.maintenanceMode ? 'checked' : '' %>>
                  <label class="form-check-label text-white">
                    Enable Maintenance Mode
                  </label>
                  <small class="d-block text-muted">When enabled, only admins can access the site</small>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i>Save Site Settings
            </button>
          </div>
        </form>
      </div>

      <!-- Theme Colors Tab -->
      <div class="tab-pane fade" id="theme" role="tabpanel">
        <form action="/admin/website-settings/theme" method="POST">
          <div class="row">
            <div class="col-md-6">
              <h5 class="text-white mb-3">Color Scheme</h5>
              
              <div class="mb-3">
                <label class="form-label text-white">Primary Color</label>
                <div class="input-group">
                  <input type="color" class="form-control form-control-color bg-dark border-secondary" name="primaryColor" 
                         value="<%= settings.themeSettings.primaryColor %>">
                  <input type="text" class="form-control bg-dark text-white border-secondary" 
                         value="<%= settings.themeSettings.primaryColor %>" readonly>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label text-white">Secondary Color</label>
                <div class="input-group">
                  <input type="color" class="form-control form-control-color bg-dark border-secondary" name="secondaryColor" 
                         value="<%= settings.themeSettings.secondaryColor %>">
                  <input type="text" class="form-control bg-dark text-white border-secondary" 
                         value="<%= settings.themeSettings.secondaryColor %>" readonly>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label text-white">Accent Color</label>
                <div class="input-group">
                  <input type="color" class="form-control form-control-color bg-dark border-secondary" name="accentColor" 
                         value="<%= settings.themeSettings.accentColor %>">
                  <input type="text" class="form-control bg-dark text-white border-secondary" 
                         value="<%= settings.themeSettings.accentColor %>" readonly>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <h5 class="text-white mb-3">Color Preview</h5>
              <div class="border border-secondary rounded p-3 bg-dark">
                <div class="mb-2">
                  <span class="badge bg-secondary">Primary Color</span>
                  <span class="color-preview-block" id="primaryColorPreview">█</span>
                </div>
                <div class="mb-2">
                  <span class="badge bg-secondary">Secondary Color</span>
                  <span class="color-preview-block" id="secondaryColorPreview">█</span>
                </div>
                <div class="mb-2">
                  <span class="badge bg-secondary">Accent Color</span>
                  <span class="color-preview-block" id="accentColorPreview">█</span>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i>Save Theme Settings
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="resetThemeColors()">
              <i class="bi bi-arrow-clockwise me-1"></i>Reset Preview
            </button>
          </div>
        </form>

        <!-- Server-side Reset Form -->
        <form action="/admin/website-settings/theme/reset" method="POST" class="mt-3">
          <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to reset theme colors to default and save? This action cannot be undone.')">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset & Save to Default Colors
          </button>
        </form>
      </div>

      <!-- Venue Settings Tab -->
      <div class="tab-pane fade" id="venue" role="tabpanel">
        <form action="/admin/website-settings/venue" method="POST">
          <div class="row">
            <div class="col-md-8">
              <h5 class="text-white mb-3">Venue Management Settings</h5>

              <div class="mb-4">
                <label for="defaultCommissionPercentage" class="form-label text-white fw-bold">Default Commission Percentage</label>
                <div class="input-group">
                  <input type="number" class="form-control" id="defaultCommissionPercentage" 
                         name="defaultCommissionPercentage" 
                         value="<%= settings.venueSettings ? settings.venueSettings.defaultCommissionPercentage : 10 %>"
                         min="0" max="100" step="0.1" required>
                  <span class="input-group-text">%</span>
                </div>
                <small class="text-muted">
                  This commission percentage will be automatically applied to all new venue registrations.
                </small>
              </div>

              <div class="mb-4">
                <label for="minimumVenueRate" class="form-label text-white fw-bold">Minimum Venue Rate (₹)</label>
                <input type="number" class="form-control" id="minimumVenueRate" 
                       name="minimumVenueRate" 
                       value="<%= settings.venueSettings ? settings.venueSettings.minimumVenueRate : 500 %>"
                       min="0" step="100">
                <small class="text-muted">
                  Minimum hourly rate that venues can set for their bookings.
                </small>
              </div>

              <div class="mb-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="requireAdminApproval" id="requireAdminApproval"
                         <%= (settings.venueSettings && settings.venueSettings.requireAdminApproval !== false) ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold" for="requireAdminApproval">
                    Require Admin Approval for Venue Registration
                  </label>
                  <small class="d-block text-muted mt-1">
                    When enabled, all venue registration requests must be approved by an administrator before they become active.
                  </small>
                </div>
              </div>

              <div class="mb-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="allowUserCommissionEdit" id="allowUserCommissionEdit"
                         <%= (settings.venueSettings && settings.venueSettings.allowUserCommissionEdit) ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold" for="allowUserCommissionEdit">
                    Allow Users to Set Commission Rates
                  </label>
                  <small class="d-block text-muted mt-1">
                    When disabled, users can only set hourly rates. Commission rates are controlled by the admin.
                  </small>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <div class="glass-card-dark h-100">
                <div class="card-body">
                  <h6 class="text-white mb-3">
                    <i class="bi bi-info-circle me-2"></i>Venue Settings Info
                  </h6>
                  <ul class="text-muted small mb-0">
                    <li class="mb-2">Commission percentage affects venue owner earnings</li>
                    <li class="mb-2">Minimum rate prevents unrealistic pricing</li>
                    <li class="mb-2">Admin approval ensures quality control</li>
                    <li class="mb-2">User commission editing provides flexibility</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-success me-2">
            <i class="bi bi-check me-1"></i> Save Venue Settings
          </button>
        </form>
      </div>

      <!-- Admin Settings Tab -->
      <div class="tab-pane fade" id="admin" role="tabpanel">
        <form action="/admin/website-settings/admin" method="POST">
          <div class="row">
            <div class="col-md-8">
              <h5 class="text-white mb-3">Development & Testing Settings</h5>

              <div class="mb-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="showDummyData" id="showDummyData"
                         <%= (settings.adminSettings && settings.adminSettings.showDummyData) ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold" for="showDummyData">
                    Enable Dummy Data Display
                  </label>
                  <small class="d-block text-muted mt-1">
                    When enabled, dummy data will be displayed alongside real data in all admin management sections.
                    This is useful for testing and demonstration purposes.
                  </small>
                </div>
              </div>

              <div class="mb-3" id="dummyDataCountGroup">
                <label class="form-label text-white">Number of Dummy Records</label>
                <input type="number" class="form-control bg-dark text-white border-secondary"
                       name="dummyDataCount" min="5" max="50"
                       value="<%= (settings.adminSettings && settings.adminSettings.dummyDataCount) ? settings.adminSettings.dummyDataCount : 10 %>">
                <small class="text-muted">Controls how many dummy records to generate for each section (5-50)</small>
              </div>

              <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Note:</strong> Dummy data is clearly marked and does not interfere with real data operations.
                It will be displayed with a "dummy" indicator and can be toggled on/off without affecting your actual data.
              </div>
            </div>

            <div class="col-md-4">
              <h5 class="text-white mb-3">Dummy Data Sections</h5>
              <div class="border border-secondary rounded p-3 bg-dark">
                <small class="text-white-50 mb-2 d-block">Dummy data will be shown in:</small>
                <ul class="list-unstyled text-white small">
                  <li><i class="bi bi-check-circle text-success me-1"></i> User Management</li>
                  <li><i class="bi bi-check-circle text-success me-1"></i> Artist Management</li>
                  <li><i class="bi bi-check-circle text-success me-1"></i> Concert Management</li>
                  <li><i class="bi bi-check-circle text-success me-1"></i> Ticket Management</li>
                  <li><i class="bi bi-check-circle text-success me-1"></i> Content Management</li>
                  <li><i class="bi bi-check-circle text-success me-1"></i> Page Management</li>
                  <li><i class="bi bi-check-circle text-success me-1"></i> Booking Management</li>
                  <li><i class="bi bi-check-circle text-success me-1"></i> Subscription Management</li>
                  <li><i class="bi bi-check-circle text-success me-1"></i> Contact Messages</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i>Save Admin Settings
            </button>
            <button type="button" class="btn btn-outline-info ms-2" onclick="previewDummyData()">
              <i class="bi bi-eye me-1"></i>Preview Dummy Data
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<script>
// Handle brand type changes
document.getElementById('brandType').addEventListener('change', function() {
  const brandType = this.value;
  const brandTextGroup = document.getElementById('brandTextGroup');
  const logoGroup = document.getElementById('logoGroup');
  const logoHeightGroup = document.getElementById('logoHeightGroup');
  const showBrandTextGroup = document.getElementById('showBrandTextGroup');

  // Show/hide elements based on brand type
  if (brandType === 'text') {
    brandTextGroup.style.display = 'block';
    logoGroup.style.display = 'none';
    logoHeightGroup.style.display = 'none';
    showBrandTextGroup.style.display = 'none';
  } else if (brandType === 'logo') {
    brandTextGroup.style.display = 'none';
    logoGroup.style.display = 'block';
    logoHeightGroup.style.display = 'block';
    showBrandTextGroup.style.display = 'none';
  } else if (brandType === 'both') {
    brandTextGroup.style.display = 'block';
    logoGroup.style.display = 'block';
    logoHeightGroup.style.display = 'block';
    showBrandTextGroup.style.display = 'block';
  }
});

// Initialize on page load
document.getElementById('brandType').dispatchEvent(new Event('change'));

// Remove logo function
function removeLogo() {
  if (confirm('Are you sure you want to remove the current logo?')) {
    fetch('/admin/website-settings/logo', {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Failed to remove logo: ' + data.message);
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('An error occurred while removing the logo');
    });
  }
}

// Color picker sync
document.querySelectorAll('input[type="color"]').forEach(colorInput => {
  colorInput.addEventListener('change', function() {
    const textInput = this.parentElement.querySelector('input[type="text"]');
    if (textInput) {
      textInput.value = this.value;
    }
  });
});

// Reset theme colors to default
function resetThemeColors() {
  if (confirm('Are you sure you want to reset all theme colors to default values?')) {
    // Default theme colors
    const defaultColors = {
      primaryColor: '#6f42c1',
      secondaryColor: '#e91e63',
      accentColor: '#ff9800'
    };

    // Update color inputs
    document.querySelector('input[name="primaryColor"]').value = defaultColors.primaryColor;
    document.querySelector('input[name="secondaryColor"]').value = defaultColors.secondaryColor;
    document.querySelector('input[name="accentColor"]').value = defaultColors.accentColor;

    // Update text inputs
    document.querySelector('input[name="primaryColor"]').parentElement.querySelector('input[type="text"]').value = defaultColors.primaryColor;
    document.querySelector('input[name="secondaryColor"]').parentElement.querySelector('input[type="text"]').value = defaultColors.secondaryColor;
    document.querySelector('input[name="accentColor"]').parentElement.querySelector('input[type="text"]').value = defaultColors.accentColor;

    // Update preview badges
    const previewContainer = document.querySelector('.col-md-6:has(.badge)');
    if (previewContainer) {
      const badges = previewContainer.querySelectorAll('.badge');
      if (badges[0]) badges[0].style.backgroundColor = defaultColors.primaryColor;
      if (badges[1]) badges[1].style.backgroundColor = defaultColors.secondaryColor;
      if (badges[2]) badges[2].style.backgroundColor = defaultColors.accentColor;
    }
  }
}

// Admin settings functionality
document.getElementById('showDummyData').addEventListener('change', function() {
  const dummyDataCountGroup = document.getElementById('dummyDataCountGroup');
  if (this.checked) {
    dummyDataCountGroup.style.display = 'block';
  } else {
    dummyDataCountGroup.style.display = 'none';
  }
});

// Initialize admin settings on page load
document.addEventListener('DOMContentLoaded', function() {
  const showDummyDataCheckbox = document.getElementById('showDummyData');
  if (showDummyDataCheckbox) {
    showDummyDataCheckbox.dispatchEvent(new Event('change'));
  }
});

// Preview dummy data function
function previewDummyData() {
  const count = document.querySelector('input[name="dummyDataCount"]').value;

  // Show loading state
  const btn = event.target;
  const originalText = btn.innerHTML;
  btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Generating Preview...';
  btn.disabled = true;

  fetch('/admin/website-settings/preview-dummy-data', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ count: parseInt(count) })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Create modal to show preview
      showDummyDataPreview(data.preview);
    } else {
      alert('Failed to generate preview: ' + data.message);
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('An error occurred while generating preview');
  })
  .finally(() => {
    btn.innerHTML = originalText;
    btn.disabled = false;
  });
}

// Show dummy data preview in modal
function showDummyDataPreview(preview) {
  const modalHtml = `
    <div class="modal fade" id="dummyDataPreviewModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title text-white">Dummy Data Preview</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-white">Sample Users (${preview.users.length})</h6>
                <div class="bg-dark p-2 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                  ${preview.users.slice(0, 3).map(user => `
                    <small class="text-white d-block">${user.name} - ${user.email}</small>
                  `).join('')}
                  ${preview.users.length > 3 ? `<small class="text-muted">...and ${preview.users.length - 3} more</small>` : ''}
                </div>
              </div>
              <div class="col-md-6">
                <h6 class="text-white">Sample Artists (${preview.artists.length})</h6>
                <div class="bg-dark p-2 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                  ${preview.artists.slice(0, 3).map(artist => `
                    <small class="text-white d-block">${artist.stageName} - ${artist.city}</small>
                  `).join('')}
                  ${preview.artists.length > 3 ? `<small class="text-muted">...and ${preview.artists.length - 3} more</small>` : ''}
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-white">Sample Concerts (${preview.concerts.length})</h6>
                <div class="bg-dark p-2 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                  ${preview.concerts.slice(0, 3).map(concert => `
                    <small class="text-white d-block">${concert.title} - ${concert.city}</small>
                  `).join('')}
                  ${preview.concerts.length > 3 ? `<small class="text-muted">...and ${preview.concerts.length - 3} more</small>` : ''}
                </div>
              </div>
              <div class="col-md-6">
                <h6 class="text-white">Sample Content (${preview.content.length})</h6>
                <div class="bg-dark p-2 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                  ${preview.content.slice(0, 3).map(content => `
                    <small class="text-white d-block">${content.title} - ${content.type}</small>
                  `).join('')}
                  ${preview.content.length > 3 ? `<small class="text-muted">...and ${preview.content.length - 3} more</small>` : ''}
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  `;

  // Remove existing modal if any
  const existingModal = document.getElementById('dummyDataPreviewModal');
  if (existingModal) {
    existingModal.remove();
  }

  // Add modal to body
  document.body.insertAdjacentHTML('beforeend', modalHtml);

  // Show modal
  const modal = new bootstrap.Modal(document.getElementById('dummyDataPreviewModal'));
  modal.show();
}
</script>

<!-- Fix for floating button issue -->
