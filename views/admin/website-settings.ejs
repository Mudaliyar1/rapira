// Show dummy data preview in modal
function showDummyDataPreview(preview) {
  const modalHtml = `
    <div class="modal fade" id="dummyDataPreviewModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title text-white">Dummy Data Preview</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-white">Sample Users (${preview.users.length})</h6>
                <div class="bg-dark p-2 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                  ${preview.users.slice(0, 3).map(user => `
                    <small class="text-white d-block">${user.name} - ${user.email}</small>
                  `).join('')}
                  ${preview.users.length > 3 ? `<small class="text-muted">...and ${preview.users.length - 3} more</small>` : ''}
                </div>
              </div>
              <div class="col-md-6">
                <h6 class="text-white">Sample Artists (${preview.artists.length})</h6>
                <div class="bg-dark p-2 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                  ${preview.artists.slice(0, 3).map(artist => `
                    <small class="text-white d-block">${artist.stageName} - ${artist.city}</small>
                  `).join('')}
                  ${preview.artists.length > 3 ? `<small class="text-muted">...and ${preview.artists.length - 3} more</small>` : ''}
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-white">Sample Concerts (${preview.concerts.length})</h6>
                <div class="bg-dark p-2 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                  ${preview.concerts.slice(0, 3).map(concert => `
                    <small class="text-white d-block">${concert.title} - ${concert.city}</small>
                  `).join('')}
                  ${preview.concerts.length > 3 ? `<small class="text-muted">...and ${preview.concerts.length - 3} more</small>` : ''}
                </div>
              </div>
              <div class="col-md-6">
                <h6 class="text-white">Sample Content (${preview.content.length})</h6>
                <div class="bg-dark p-2 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                  ${preview.content.slice(0, 3).map(content => `
                    <small class="text-white d-block">${content.title} - ${content.type}</small>
                  `).join('')}
                  ${preview.content.length > 3 ? `<small class="text-muted">...and ${preview.content.length - 3} more</small>` : ''}
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  `;

  // Remove existing modal if any
  const existingModal = document.getElementById('dummyDataPreviewModal');
  if (existingModal) {
    existingModal.remove();
  }

  // Add modal to body
  document.body.insertAdjacentHTML('beforeend', modalHtml);

  // Show modal
  const modal = new bootstrap.Modal(document.getElementById('dummyDataPreviewModal'));
  modal.show();
}
</script>

