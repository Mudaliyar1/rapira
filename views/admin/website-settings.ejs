<%- contentFor('body') %>

<!-- Flash Messages -->
<% if (success && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Website Settings Tabs -->
<div class="glass-card-dark">
  <div class="card-header border-bottom border-secondary">
    <ul class="nav nav-tabs card-header-tabs" id="settingsTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active text-white" id="header-tab" data-bs-toggle="tab" data-bs-target="#header" type="button" role="tab">
          <i class="bi bi-layout-text-window-reverse me-2"></i>Header & Branding
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="menu-tab" data-bs-toggle="tab" data-bs-target="#menu" type="button" role="tab">
          <i class="bi bi-list me-2"></i>Navigation Menu
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="site-tab" data-bs-toggle="tab" data-bs-target="#site" type="button" role="tab">
          <i class="bi bi-gear me-2"></i>Site Settings
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="carousel-tab" data-bs-toggle="tab" data-bs-target="#carousel" type="button" role="tab">
          <i class="bi bi-images me-2"></i>Hero Carousel
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="theme-tab" data-bs-toggle="tab" data-bs-target="#theme" type="button" role="tab">
          <i class="bi bi-palette me-2"></i>Theme Colors
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="theme-seasonal-tab" data-bs-toggle="tab" data-bs-target="#theme-seasonal" type="button" role="tab">
          <i class="bi bi-snow me-2"></i>Seasonal Themes
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="venue-tab" data-bs-toggle="tab" data-bs-target="#venue" type="button" role="tab">
          <i class="bi bi-building me-2"></i>Venue Settings
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin" type="button" role="tab">
          <i class="bi bi-gear me-2"></i>Admin Settings
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="ticket-commission-tab" data-bs-toggle="tab" data-bs-target="#ticket-commission" type="button" role="tab">
          <i class="bi bi-currency-rupee me-2"></i>Ticket Commission
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="producer-beat-commission-tab" data-bs-toggle="tab" data-bs-target="#producer-beat-commission" type="button" role="tab">
          <i class="bi bi-music-note-beamed me-2"></i>Beat Commission
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="registration-fees-tab" data-bs-toggle="tab" data-bs-target="#registration-fees" type="button" role="tab">
          <i class="bi bi-credit-card-2-front me-2"></i>Application Fees
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="email-links-tab" data-bs-toggle="tab" data-bs-target="#email-links" type="button" role="tab">
          <i class="bi bi-envelope-at me-2"></i>Email Links
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link text-white" id="view-increaser-tab" data-bs-toggle="tab" data-bs-target="#view-increaser" type="button" role="tab">
          <i class="bi bi-graph-up-arrow me-2"></i>View Increaser
        </button>
      </li>
    </ul>
  </div>

  <div class="card-body">
    <div class="tab-content" id="settingsTabContent">
      
      <!-- Header & Branding Tab -->
      <div class="tab-pane fade show active" id="header" role="tabpanel">
        <form action="/admin/website-settings/header" method="POST" enctype="multipart/form-data">
          <div class="row">
            <div class="col-md-6">
              <h5 class="text-white mb-3">Header Configuration</h5>
              
              <!-- Brand Type -->
              <div class="mb-3">
                <label class="form-label text-white">Brand Display Type</label>
                <select class="form-select bg-dark text-white border-secondary" name="brandType" id="brandType">
                  <option value="text" <%= settings.headerSettings.brandType === 'text' ? 'selected' : '' %>>Text Only</option>
                  <option value="logo" <%= settings.headerSettings.brandType === 'logo' ? 'selected' : '' %>>Logo Only</option>
                  <option value="both" <%= settings.headerSettings.brandType === 'both' ? 'selected' : '' %>>Logo + Text</option>
                </select>
              </div>

              <!-- Brand Text -->
              <div class="mb-3" id="brandTextGroup">
                <label class="form-label text-white">Brand Text</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" name="brandText" 
                       value="<%= settings.headerSettings.brandText %>" placeholder="Enter brand name">
              </div>

              <!-- Logo Upload -->
              <div class="mb-3" id="logoGroup">
                <label class="form-label text-white">Logo Image</label>
                <input type="file" class="form-control bg-dark text-white border-secondary" name="logo" accept="image/*">
                <small class="text-muted">Supported formats: JPG, PNG, GIF, SVG (Max: 5MB)</small>
              </div>

              <!-- Logo Height -->
              <div class="mb-3" id="logoHeightGroup">
                <label class="form-label text-white">Logo Height (px)</label>
                <input type="number" class="form-control bg-dark text-white border-secondary" name="logoHeight" 
                       value="<%= settings.headerSettings.logoHeight %>" min="20" max="100">
              </div>

              <!-- Show Brand Text (for 'both' type) -->
              <div class="mb-3" id="showBrandTextGroup">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="showBrandText" id="showBrandText" 
                         <%= settings.headerSettings.showBrandText ? 'checked' : '' %>>
                  <label class="form-check-label text-white" for="showBrandText">
                    Show brand text alongside logo
                  </label>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <h5 class="text-white mb-3">Current Header Preview</h5>
              <div class="border border-secondary rounded p-3 bg-dark">
                <div class="d-flex align-items-center">
                  <% if (settings.headerSettings.logoUrl && (settings.headerSettings.brandType === 'logo' || settings.headerSettings.brandType === 'both')) { %>
                    <img src="<%= settings.headerSettings.logoUrl %>" alt="Current Logo" 
                         class="me-2" id="currentLogo">
                  <% } %>
                  <% if (settings.headerSettings.showBrandText && (settings.headerSettings.brandType === 'text' || settings.headerSettings.brandType === 'both')) { %>
                    <span class="fs-4 fw-bold gradient-text-purple"><%= settings.headerSettings.brandText %></span>
                  <% } %>
                </div>
              </div>

              <% if (settings.headerSettings.logoUrl) { %>
                <div class="mt-3">
                  <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeLogo()">
                    <i class="bi bi-trash me-1"></i>Remove Current Logo
                  </button>
                </div>
              <% } %>
            </div>
          </div>

          <div class="mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i>Save Header Settings
            </button>
          </div>
        </form>
      </div>

      <!-- Navigation Menu Tab -->
      <div class="tab-pane fade" id="menu" role="tabpanel">
        <div class="mb-4">
          <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Dynamic Navigation Management:</strong> This system automatically detects all available pages and routes in your application.
            When you add new pages or routes, they will automatically appear here for you to manage.
          </div>

        </div>

        <form action="/admin/website-settings/menu" method="POST">
          <div class="row">
            <!-- Discover Menu -->
            <div class="col-md-3">
              <h5 class="text-white mb-3">
                <i class="bi bi-compass me-2"></i>Discover Menu
              </h5>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="discoverMenuEnabled" id="discoverMenuEnabled"
                         <%= settings.menuSettings.discoverMenu.enabled ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold" for="discoverMenuEnabled">
                    Enable Discover Menu
                  </label>
                </div>
              </div>

              <div class="ms-3">
                <% if (menuConfiguration && menuConfiguration.discoverMenu && menuConfiguration.discoverMenu.routes) { %>
                  <% Object.keys(menuConfiguration.discoverMenu.routes).forEach(key => { %>
                    <% const route = menuConfiguration.discoverMenu.routes[key]; %>
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="<%= key %>" id="discover_<%= key %>"
                             <%= settings.menuSettings.discoverMenu.items && settings.menuSettings.discoverMenu.items[key] ? 'checked' : '' %>>
                      <label class="form-check-label text-white" for="discover_<%= key %>">
                        <i class="<%= route.icon %> me-1"></i><%= route.name %>
                        <% if (route.isDynamic) { %>
                          <small class="badge bg-secondary ms-1">Dynamic</small>
                        <% } %>
                        <% if (settings.menuSettings.discoverMenu.items && settings.menuSettings.discoverMenu.items[key]) { %>
                          <small class="badge bg-success ms-1">Enabled</small>
                        <% } else { %>
                          <small class="badge bg-danger ms-1">Disabled</small>
                        <% } %>
                      </label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Services Menu -->
            <div class="col-md-3">
              <h5 class="text-white mb-3">
                <i class="bi bi-gear me-2"></i>Services Menu
              </h5>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="servicesMenuEnabled"
                         <%= settings.menuSettings.servicesMenu.enabled ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold">
                    Enable Services Menu
                  </label>
                </div>
              </div>

              <div class="ms-3">
                <% if (menuConfiguration && menuConfiguration.servicesMenu && menuConfiguration.servicesMenu.routes) { %>
                  <% Object.keys(menuConfiguration.servicesMenu.routes).forEach(key => { %>
                    <% const route = menuConfiguration.servicesMenu.routes[key]; %>
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="<%= key %>" id="services_<%= key %>"
                             <%= settings.menuSettings.servicesMenu.items && settings.menuSettings.servicesMenu.items[key] ? 'checked' : '' %>>
                      <label class="form-check-label text-white" for="services_<%= key %>">
                        <i class="<%= route.icon %> me-1"></i><%= route.name %>
                        <% if (route.isDynamic) { %>
                          <small class="badge bg-secondary ms-1">Dynamic</small>
                        <% } %>
                        <% if (settings.menuSettings.servicesMenu.items && settings.menuSettings.servicesMenu.items[key]) { %>
                          <small class="badge bg-success ms-1">Enabled</small>
                        <% } else { %>
                          <small class="badge bg-danger ms-1">Disabled</small>
                        <% } %>
                      </label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Shop Menu -->
            <div class="col-md-3">
              <h5 class="text-white mb-3">
                <i class="bi bi-bag me-2"></i>Shop Menu
              </h5>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="shopMenuEnabled"
                         <%= settings.menuSettings.shopMenu.enabled ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold">
                    Enable Shop Menu
                  </label>
                </div>
              </div>

              <div class="ms-3">
                <% if (menuConfiguration && menuConfiguration.shopMenu && menuConfiguration.shopMenu.routes) { %>
                  <% Object.keys(menuConfiguration.shopMenu.routes).forEach(key => { %>
                    <% const route = menuConfiguration.shopMenu.routes[key]; %>
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="<%= key %>" id="shop_<%= key %>"
                             <%= settings.menuSettings.shopMenu.items && settings.menuSettings.shopMenu.items[key] ? 'checked' : '' %>>
                      <label class="form-check-label text-white" for="shop_<%= key %>">
                        <i class="<%= route.icon %> me-1"></i><%= route.name %>
                        <% if (route.isDynamic) { %>
                          <small class="badge bg-secondary ms-1">Dynamic</small>
                        <% } %>
                        <% if (settings.menuSettings.shopMenu.items && settings.menuSettings.shopMenu.items[key]) { %>
                          <small class="badge bg-success ms-1">Enabled</small>
                        <% } else { %>
                          <small class="badge bg-danger ms-1">Disabled</small>
                        <% } %>
                      </label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Help & Support Menu -->
            <div class="col-md-3">
              <h5 class="text-white mb-3">
                <i class="bi bi-question-circle me-2"></i>Help & Support Menu
              </h5>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="helpSupportMenuEnabled"
                         <%= settings.menuSettings.helpSupportMenu.enabled ? 'checked' : '' %>>
                  <label class="form-check-label text-white fw-bold">
                    Enable Help & Support Menu
                  </label>
                </div>
              </div>

              <div class="ms-3">
                <% if (menuConfiguration && menuConfiguration.helpSupportMenu && menuConfiguration.helpSupportMenu.routes) { %>
                  <% Object.keys(menuConfiguration.helpSupportMenu.routes).forEach(key => { %>
                    <% const route = menuConfiguration.helpSupportMenu.routes[key]; %>
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" name="<%= key %>" id="help_<%= key %>"
                             <%= settings.menuSettings.helpSupportMenu.items && settings.menuSettings.helpSupportMenu.items[key] ? 'checked' : '' %>>
                      <label class="form-check-label text-white" for="help_<%= key %>">
                        <i class="<%= route.icon %> me-1"></i><%= route.name %>
                        <% if (route.isDynamic) { %>
                          <small class="badge bg-secondary ms-1">Dynamic</small>
                        <% } %>
                        <% if (settings.menuSettings.helpSupportMenu.items && settings.menuSettings.helpSupportMenu.items[key]) { %>
                          <small class="badge bg-success ms-1">Enabled</small>
                        <% } else { %>
                          <small class="badge bg-danger ms-1">Disabled</small>
                        <% } %>
                      </label>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Form Actions -->
          <div class="row mt-4">
            <div class="col-12">
              <div class="d-flex justify-content-start" style="position: relative; z-index: 1;">
                <button type="submit" class="btn btn-primary" style="position: relative; z-index: 2;">
                  <i class="bi bi-save me-1"></i>Save Menu Settings
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- Site Settings Tab -->
      <div class="tab-pane fade" id="site" role="tabpanel">
        <form action="/admin/website-settings/site" method="POST">
          <div class="row">
            <div class="col-md-8">
              <h5 class="text-white mb-3">General Site Settings</h5>
              
              <div class="mb-3">
                <label class="form-label text-white">Site Name</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" name="siteName" 
                       value="<%= settings.siteSettings.siteName %>">
              </div>

              <div class="mb-3">
                <label class="form-label text-white">Site Description</label>
                <textarea class="form-control bg-dark text-white border-secondary" name="siteDescription" rows="3"><%= settings.siteSettings.siteDescription %></textarea>
              </div>

              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="maintenanceMode" 
                         <%= settings.siteSettings.maintenanceMode ? 'checked' : '' %> id="maintenanceMode">
                  <label class="form-check-label text-white">
                    Enable Maintenance Mode
                  </label>
                  <small class="d-block text-muted">When enabled, only admins and superAdmins can access the site</small>
                </div>
              </div>
              
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="enableButtonSounds" 
                         <%= settings.siteSettings.enableButtonSounds ? 'checked' : '' %> id="enableButtonSounds">
                  <label class="form-check-label text-white">
                    Enable Button Sound Effects
                  </label>
                  <small class="d-block text-muted">When enabled, users will hear subtle sounds when clicking buttons across the website</small>
                </div>
              </div>
              
              <div id="maintenanceSettings" class="border-start border-secondary ps-3 mt-3" style="display: <%= settings.siteSettings.maintenanceMode ? 'block' : 'none' %>;
                  background: rgba(255, 255, 255, 0.05); border-radius: 8px; padding: 15px;">
                <h6 class="text-white mb-3">Maintenance Details</h6>
                
                <div class="mb-3">
                  <label class="form-label text-white">Maintenance Reason</label>
                  <input type="text" class="form-control bg-dark text-white border-secondary" 
                         name="maintenanceReason" 
                         value="<%= settings.siteSettings.maintenanceReason %>"
                         placeholder="Enter reason for maintenance">
                </div>
                
                <div class="row">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="form-label text-white">Maintenance Duration (minutes)</label>
                      <input type="number" class="form-control bg-dark text-white border-secondary" 
                             name="maintenanceDuration" 
                             value="<%= settings.siteSettings.maintenanceDuration %>"
                             min="1" max="1440" step="1" id="maintenanceDuration">
                      <small class="text-muted">1-1440 minutes (1 day)</small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="form-label text-white">Duration Summary</label>
                      <div class="form-control-plaintext text-white" id="durationSummary">
                        <%= formatDuration(settings.siteSettings.maintenanceDuration) %>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3 mt-4">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="maintenanceAutoStart" 
                               <%= settings.siteSettings.maintenanceAutoStart ? 'checked' : '' %> id="maintenanceAutoStart">
                        <label class="form-check-label text-white" for="maintenanceAutoStart">
                          Auto-start when enabled
                        </label>
                        <small class="d-block text-muted">Start timer automatically when maintenance is enabled</small>
                      </div>
                    </div>
                  </div>
                </div>
                
                <% if (settings.siteSettings.maintenanceMode && settings.siteSettings.maintenanceStartTime) { %>
                <div class="alert alert-info">
                  <i class="bi bi-info-circle me-2"></i>
                  <strong>Maintenance Active:</strong><br>
                  Started: <%= toISTLocaleString(settings.siteSettings.maintenanceStartTime) %><br>
                  Duration: <%= settings.siteSettings.maintenanceDuration %> minutes<br>
                  <span id="maintenanceEndTime"><strong>Ends: </strong><%= toISTLocaleString(new Date(new Date(settings.siteSettings.maintenanceStartTime).getTime() + (settings.siteSettings.maintenanceDuration * 60000))) %></span>
                </div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save me-1"></i>Save Site Settings
            </button>
          </div>
        </form>
      </div>

      <!-- Theme Colors Tab -->
      <div class="tab-pane fade" id="carousel" role="tabpanel">
        <form id="carouselForm" action="/admin/website-settings/carousel" method="POST" enctype="multipart/form-data">
          <div class="row">
            <div class="col-md-8">
              <h5 class="text-white mb-3">Home Hero Carousel</h5>

              <div class="mb-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" name="autoplay" id="autoplay"
                         <%= settings.heroCarouselSettings && settings.heroCarouselSettings.autoplay ? 'checked' : '' %>>
                  <label class="form-check-label text-white" for="autoplay">Enable Autoplay</label>
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label text-white">Slide Interval (milliseconds)</label>
                <input type="number" class="form-control bg-dark text-white border-secondary" name="intervalMs"
                       value="<%= settings.heroCarouselSettings && settings.heroCarouselSettings.intervalMs ? settings.heroCarouselSettings.intervalMs : 5000 %>"
                       min="2000" max="20000" step="500">
              </div>

              <h6 class="text-white mb-3">Existing Slides</h6>
              <div id="slidesContainer">
              <% if (settings.heroCarouselSettings && settings.heroCarouselSettings.slides && settings.heroCarouselSettings.slides.length > 0) { %>
                <% settings.heroCarouselSettings.slides.forEach((slide, index) => { %>
                  <div class="border border-secondary rounded p-3 mb-3 bg-dark bg-opacity-50">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <img src="<%= slide.imageUrl %>" alt="Slide <%= index + 1 %>" class="img-fluid rounded" style="height: 120px; width: 100%; object-fit: contain; background: #111;">
                        <input type="hidden" name="existingImageUrl" value="<%= slide.imageUrl %>">
                        <input type="hidden" name="existingImageMediaId" value="<%= slide.imageMedia ? slide.imageMedia : '' %>">
                        <label class="form-label text-white small mt-2">Replace Image</label>
                        <input type="file" class="form-control bg-dark text-white border-secondary form-control-sm" name="existingSlideImage_<%= index %>" accept="image/*">
                      </div>
                      <div class="col-md-8">
                        <div class="row g-2">
                          <div class="col-md-6">
                            <label class="form-label text-white small">Title</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" name="existingTitle" value="<%= slide.title || '' %>">
                          </div>
                          <div class="col-md-6">
                            <label class="form-label text-white small">Badge</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" name="existingBadge" value="<%= slide.badge || '' %>">
                          </div>
                          <div class="col-12">
                            <label class="form-label text-white small">Description</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" name="existingDescription" value="<%= slide.description || '' %>">
                          </div>
                          <div class="col-md-6">
                            <label class="form-label text-white small">Date Text</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" name="existingDateText" value="<%= slide.dateText || '' %>">
                          </div>
                          <div class="col-md-6">
                            <label class="form-label text-white small">Button Text</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" name="existingButtonText" value="<%= slide.buttonText || '' %>">
                          </div>
                          <div class="col-12">
                            <label class="form-label text-white small">Click Link</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" name="existingLinkUrl" value="<%= slide.linkUrl || '/' %>" placeholder="/concerts or https://example.com">
                          </div>
                          <div class="col-12 d-flex align-items-center gap-3 mt-2">
                            <div class="form-check">
                              <input class="form-check-input" type="checkbox" name="existingIsActive" id="existingIsActive_<%= index %>" value="<%= index %>" <%= slide.isActive !== false ? 'checked' : '' %>>
                              <label class="form-check-label text-white" for="existingIsActive_<%= index %>">Active</label>
                            </div>
                            <div class="form-check">
                              <input class="form-check-input" type="checkbox" name="removeSlideIndices" id="removeSlide_<%= index %>" value="<%= index %>">
                              <label class="form-check-label text-danger" for="removeSlide_<%= index %>">Remove</label>
                            </div>
