<script>
// Handle maintenance mode toggle
const maintenanceModeElement = document.getElementById('maintenanceMode');
if (maintenanceModeElement) {
  maintenanceModeElement.addEventListener('change', function() {
    const maintenanceSettings = document.getElementById('maintenanceSettings');
    if (!maintenanceSettings) return;
    if (this.checked) {
      maintenanceSettings.style.display = 'block';
    } else {
      maintenanceSettings.style.display = 'none';
    }
  });
}

// Update duration summary when maintenance duration changes
const maintenanceDurationElement = document.getElementById('maintenanceDuration');
if (maintenanceDurationElement) {
  maintenanceDurationElement.addEventListener('input', function() {
    const duration = parseInt(this.value) || 0;
    const durationSummary = document.getElementById('durationSummary');
    if (durationSummary) {
      durationSummary.textContent = formatDuration(duration);
    }
  });
}

// Helper function to format duration in human-readable format
function formatDuration(minutes) {
  if (minutes < 60) {
    return `${minutes} minute${minutes !== 1 ? 's' : ''}`;
  } else if (minutes < 1440) {  // Less than a day
    const hours = Math.floor(minutes / 60);
    const remainingMinutes = minutes % 60;
    let result = `${hours} hour${hours !== 1 ? 's' : ''}`;
    if (remainingMinutes > 0) {
      result += ` ${remainingMinutes} minute${remainingMinutes !== 1 ? 's' : ''}`;
    }
    return result;
  } else {
    const days = Math.floor(minutes / 1440);
    const remainingHours = Math.floor((minutes % 1440) / 60);
    let result = `${days} day${days !== 1 ? 's' : ''}`;
    if (remainingHours > 0) {
      result += ` ${remainingHours} hour${remainingHours !== 1 ? 's' : ''}`;
    }
    return result;
  }
}

function removeViewIncreaserRow(button) {
  const rowsContainer = document.getElementById('viewIncreaserRows');
  if (!rowsContainer || !button) return;

  const row = button.closest('.view-increaser-row');
  if (!row) return;

  if (rowsContainer.querySelectorAll('.view-increaser-row').length <= 1) {
    const linkInput = row.querySelector('input[name="postLink"]');
    const viewsInput = row.querySelector('input[name="viewsLabel"]');
    if (linkInput) linkInput.value = '';
    if (viewsInput) viewsInput.value = '';
    return;
  }

  row.remove();
}

function addViewIncreaserRow() {
  const rowsContainer = document.getElementById('viewIncreaserRows');
  if (!rowsContainer) return;

  const wrapper = document.createElement('div');
  wrapper.className = 'border border-secondary rounded p-3 bg-dark bg-opacity-50 view-increaser-row';
  wrapper.innerHTML = `
    <div class="row g-3 align-items-end">
      <div class="col-md-8">
        <label class="form-label text-white">Artist Post Link</label>
        <input type="text" class="form-control bg-dark text-white border-secondary" name="postLink" value="" placeholder="https://yourdomain.com/posts/POST_ID or just POST_ID">
      </div>
      <div class="col-md-3">
        <label class="form-label text-white">View Display</label>
        <input type="text" class="form-control bg-dark text-white border-secondary" name="viewsLabel" value="" placeholder="12K" pattern="^\\d+(\\.\\d+)?[kKmMbBtT]?$">
      </div>
      <div class="col-md-1 d-grid">
        <button type="button" class="btn btn-outline-danger remove-view-row" title="Remove row" onclick="removeViewIncreaserRow(this); return false;">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    </div>
  `;
  rowsContainer.appendChild(wrapper);
}

// Handle brand type changes
const brandTypeElement = document.getElementById('brandType');
if (brandTypeElement) {
  brandTypeElement.addEventListener('change', function() {
    const brandType = this.value;
    const brandTextGroup = document.getElementById('brandTextGroup');
    const logoGroup = document.getElementById('logoGroup');
    const logoHeightGroup = document.getElementById('logoHeightGroup');
    const showBrandTextGroup = document.getElementById('showBrandTextGroup');

    if (!brandTextGroup || !logoGroup || !logoHeightGroup || !showBrandTextGroup) {
      return;
    }

    // Show/hide elements based on brand type
    if (brandType === 'text') {
      brandTextGroup.style.display = 'block';
      logoGroup.style.display = 'none';
      logoHeightGroup.style.display = 'none';
      showBrandTextGroup.style.display = 'none';
    } else if (brandType === 'logo') {
      brandTextGroup.style.display = 'none';
      logoGroup.style.display = 'block';
      logoHeightGroup.style.display = 'block';
      showBrandTextGroup.style.display = 'none';
    } else if (brandType === 'both') {
      brandTextGroup.style.display = 'block';
      logoGroup.style.display = 'block';
      logoHeightGroup.style.display = 'block';
      showBrandTextGroup.style.display = 'block';
    }
  });

  // Initialize on page load
  brandTypeElement.dispatchEvent(new Event('change'));
}

// Remove logo function
function removeLogo() {
  if (confirm('Are you sure you want to remove the current logo?')) {
    fetch('/admin/website-settings/logo', {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Failed to remove logo: ' + data.message);
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('An error occurred while removing the logo');
    });
  }
}

// Color picker sync
document.querySelectorAll('input[type="color"]').forEach(colorInput => {
  colorInput.addEventListener('change', function() {
    const textInput = this.parentElement.querySelector('input[type="text"]');
    if (textInput) {
      textInput.value = this.value;
    }
  });
});

// Reset theme colors to default
function resetThemeColors() {
  if (confirm('Are you sure you want to reset all theme colors to default values?')) {
    // Default theme colors
    const defaultColors = {
      primaryColor: '#6f42c1',
      secondaryColor: '#e91e63',
      accentColor: '#ff9800'
    };

    // Update color inputs
    document.querySelector('input[name="primaryColor"]').value = defaultColors.primaryColor;
    document.querySelector('input[name="secondaryColor"]').value = defaultColors.secondaryColor;
    document.querySelector('input[name="accentColor"]').value = defaultColors.accentColor;

    // Update text inputs
    document.querySelector('input[name="primaryColor"]').parentElement.querySelector('input[type="text"]').value = defaultColors.primaryColor;
    document.querySelector('input[name="secondaryColor"]').parentElement.querySelector('input[type="text"]').value = defaultColors.secondaryColor;
    document.querySelector('input[name="accentColor"]').parentElement.querySelector('input[type="text"]').value = defaultColors.accentColor;

    // Update preview badges
    const previewContainer = document.querySelector('.col-md-6:has(.badge)');
    if (previewContainer) {
      const badges = previewContainer.querySelectorAll('.badge');
      if (badges[0]) badges[0].style.backgroundColor = defaultColors.primaryColor;
      if (badges[1]) badges[1].style.backgroundColor = defaultColors.secondaryColor;
      if (badges[2]) badges[2].style.backgroundColor = defaultColors.accentColor;
    }
  }
}

// Admin settings functionality
const showDummyDataElement = document.getElementById('showDummyData');
if (showDummyDataElement) {
  showDummyDataElement.addEventListener('change', function() {
    const dummyDataCountGroup = document.getElementById('dummyDataCountGroup');
    if (!dummyDataCountGroup) return;
    if (this.checked) {
      dummyDataCountGroup.style.display = 'block';
    } else {
      dummyDataCountGroup.style.display = 'none';
    }
  });
}

// Initialize admin settings on page load
document.addEventListener('DOMContentLoaded', function() {
  if (window.location.hash) {
    const trigger = document.querySelector(`[data-bs-target="${window.location.hash}"]`);
    if (trigger) {
      bootstrap.Tab.getOrCreateInstance(trigger).show();
    }
  }

  const showDummyDataCheckbox = document.getElementById('showDummyData');
  if (showDummyDataCheckbox) {
    showDummyDataCheckbox.dispatchEvent(new Event('change'));
  }

  // View increaser add/remove is handled by direct onclick handlers.
});

// Preview dummy data function
function previewDummyData() {
  const count = document.querySelector('input[name="dummyDataCount"]').value;

  // Show loading state
  const btn = event.target;
  const originalText = btn.innerHTML;
  btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Generating Preview...';
  btn.disabled = true;

  fetch('/admin/website-settings/preview-dummy-data', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ count: parseInt(count) })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Create modal to show preview
      showDummyDataPreview(data.preview);
    } else {
      alert('Failed to generate preview: ' + data.message);
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('An error occurred while generating preview');
  })
  .finally(() => {
    btn.innerHTML = originalText;
    btn.disabled = false;
  });
}

