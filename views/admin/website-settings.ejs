.admin-layout form .btn {
  position: relative !important;
  z-index: 1 !important;
  float: none !important;
  display: inline-block !important;
  margin: 0 !important;
}

/* Fix for form action containers */
.admin-layout form .row,
.admin-layout form .d-flex {
  position: relative !important;
  z-index: 1 !important;
  clear: both !important;
}

/* Ensure proper spacing and layout */
.admin-layout .tab-pane form {
  position: relative !important;
  z-index: 1 !important;
}

/* Fix for any floating elements */
.admin-layout .tab-pane {
  overflow: visible !important;
  position: relative !important;
}

/* Ensure buttons don't overlap content */
.admin-layout .mt-4 {
  margin-top: 1.5rem !important;
  clear: both !important;
}

/* Color preview styling */
.color-preview-block {
  font-size: 20px;
  margin-left: 10px;
}
</style>

<script>
// Set dynamic styles that can't be done in CSS due to EJS variables
document.addEventListener('DOMContentLoaded', function() {
  // Set logo height
  const logoElement = document.getElementById('currentLogo');
  if (logoElement) {
    logoElement.style.height = '<%= settings.headerSettings.logoHeight %>px';
    logoElement.style.width = 'auto';
  }
  
  // Set color previews
  const primaryPreview = document.getElementById('primaryColorPreview');
  const secondaryPreview = document.getElementById('secondaryColorPreview');
  const accentPreview = document.getElementById('accentColorPreview');
  
  if (primaryPreview) {
    primaryPreview.style.color = '<%= settings.themeSettings.primaryColor %>';
  }
  if (secondaryPreview) {
    secondaryPreview.style.color = '<%= settings.themeSettings.secondaryColor %>';
  }
  if (accentPreview) {
    accentPreview.style.color = '<%= settings.themeSettings.accentColor %>';
  }
});
</script>
