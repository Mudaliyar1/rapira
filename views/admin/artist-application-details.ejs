<%- contentFor('body') %>

<!-- Artist Application Details -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 text-white">Artist Application Details</h5>
    <div>
      <a href="/artist-applications/admin/<%= application._id %>/confirm-delete" class="btn btn-sm btn-outline-danger me-2">
        <i class="bi bi-trash"></i> Delete
      </a>
      <a href="/artist-applications/admin" class="btn btn-sm btn-outline-light">
        <i class="bi bi-arrow-left"></i> Back to List
      </a>
    </div>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <h6 class="text-white mb-3">User Information</h6>
        <div class="d-flex align-items-center mb-4">
          <% if (application.user) { %>
            <img src="<%= application.user.profileImage || '/images/default-profile.png' %>" alt="<%= application.user.name %>" class="rounded-circle me-3" style="width: 60px; height: 60px; object-fit: cover;">
            <div>
              <h5 class="mb-0 text-white"><%= application.user.name %></h5>
              <p class="mb-0 text-muted"><%= application.user.email %></p>
            </div>
          <% } else { %>
            <img src="/images/default-profile.png" alt="User not found" class="rounded-circle me-3" style="width: 60px; height: 60px; object-fit: cover;">
            <div>
              <h5 class="mb-0 text-white">User not found</h5>
              <p class="mb-0 text-muted">User may have been deleted</p>
            </div>
          <% } %>
        </div>

        <div class="mb-4">
          <h6 class="text-white mb-3">Application Details</h6>
          <table class="table table-sm">
            <tbody>
              <tr>
                <th class="text-white" style="width: 40%">Artist Level</th>
                <td class="text-white"><%= application.artistLevel %></td>
              </tr>
              <tr>
                <th class="text-white">Stage Name</th>
                <td class="text-white"><%= application.stageName || 'Not provided' %></td>
              </tr>
              <tr>
                <th class="text-white">Genre</th>
                <td class="text-white"><%= application.genre || 'Not provided' %></td>
              </tr>
              <tr>
                <th class="text-white">Instagram ID</th>
                <td class="text-white"><%= application.instagramId || 'Not provided' %></td>
              </tr>
              <tr>
                <th class="text-white">PAN Card</th>
                <td class="text-white"><%= application.panCard || 'Not provided' %></td>
              </tr>
              <tr>
                <th class="text-white">Aadhaar (Legacy)</th>
                <td class="text-white"><%= application.aadharCard || 'Not provided' %></td>
              </tr>
              <tr>
                <th class="text-white">City</th>
                <td class="text-white"><%= application.city %></td>
              </tr>
              <tr>
                <th class="text-white">State</th>
                <td class="text-white"><%= application.state %></td>
              </tr>
              <tr>
                <th class="text-white">Age</th>
                <td class="text-white"><%= application.age %></td>
              </tr>
              <tr>
                <th class="text-white">Phone Number</th>
                <td class="text-white"><%= application.phoneNumber || 'Not provided' %></td>
              </tr>
              <tr>
                <th class="text-white">Submitted On</th>
                <td class="text-white"><%= toISTLocaleString(application.createdAt) %></td>
              </tr>
              <tr>
                <th class="text-white">Status</th>
                <td>
                  <% if (application.status === 'pending') { %>
                    <span class="badge bg-warning">Pending</span>
                  <% } else if (application.status === 'approved') { %>
                    <span class="badge bg-success">Approved</span>
                  <% } else if (application.status === 'rejected') { %>
                    <span class="badge bg-danger">Rejected</span>
                  <% } %>
                </td>
              </tr>
              <% if (application.registrationFee > 0) { %>
                <tr>
                  <th class="text-white">Registration Fee</th>
                  <td class="text-white">₹<%= application.registrationFee %></td>
                </tr>
              <% } %>
              <% if (application.razorpayPaymentId) { %>
                <tr>
                  <th class="text-white">Payment ID</th>
                  <td class="text-white fw-bold font-monospace small"><%= application.razorpayPaymentId %></td>
                </tr>
              <% } %>
              <% if (application.adminComments) { %>
                <tr>
                  <th class="text-white">Admin Comments</th>
                  <td class="text-white"><%= application.adminComments %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="col-md-6">
        <h6 class="text-white mb-3">Proof Photo</h6>
        <div class="mb-4">
          <% if (application.proofPhoto) { %>
            <% if (application.proofPhoto.toLowerCase().endsWith('.pdf')) { %>
              <div class="ratio ratio-4x3 border border-secondary rounded overflow-hidden">
                <iframe src="<%= application.proofPhoto %>#toolbar=0" title="Proof PDF" class="w-100 h-100" style="border:0;"></iframe>
              </div>
              <div class="mt-2 small text-muted">PDF preview</div>
            <% } else { %>
              <img src="<%= application.proofPhoto %>" alt="Proof Photo" class="img-fluid rounded border border-secondary" style="max-height: 400px; object-fit: contain;">
            <% } %>
          <% } else { %>
            <div class="alert alert-warning mb-4">No proof photo found</div>
          <% } %>
        </div>

        <% if (application.status === 'pending') { %>
          <div class="mb-4">
            <h6 class="text-white mb-3">Take Action</h6>
            <div class="row g-3">
              <div class="col-md-6">
                <button type="button" class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#approveModal">
                  <i class="bi bi-check-circle me-2"></i> Approve
                </button>
              </div>
              <div class="col-md-6">
                <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#rejectModal">
                  <i class="bi bi-x-circle me-2"></i> Reject
                </button>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-white">
      <form action="/artist-applications/admin/<%= application._id %>/approve" method="POST">
        <div class="modal-header border-secondary">
          <h5 class="modal-title" id="approveModalLabel">Approve Artist Application</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to approve this application for <strong><%= application.user ? application.user.name : 'this user' %></strong> as a <strong><%= application.artistLevel %> Artist</strong>?</p>

          <div class="mb-3">
            <label for="comments" class="form-label">Comments (Optional)</label>
            <textarea class="form-control" id="comments" name="comments" rows="3" placeholder="Add any comments or notes..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Approve Application</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-white">
      <form action="/artist-applications/admin/<%= application._id %>/reject" method="POST">
        <div class="modal-header border-secondary">
          <h5 class="modal-title" id="rejectModalLabel">Reject Artist Application</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to reject this application for <strong><%= application.user ? application.user.name : 'this user' %></strong>?</p>

          <div class="mb-3">
            <label for="comments" class="form-label">Reason for Rejection</label>
            <textarea class="form-control" id="comments" name="comments" rows="3" placeholder="Provide a reason for rejection..." required></textarea>
            <div class="form-text">This will be shared with the applicant.</div>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Reject Application</button>
        </div>
      </form>
    </div>
  </div>
</div>


