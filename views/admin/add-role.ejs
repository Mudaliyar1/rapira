<%- contentFor('body') %>

<!-- Add Role Form -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 text-white">Add New Role</h5>
    <a href="/roles" class="btn btn-sm btn-outline-light">
      <i class="bi bi-arrow-left"></i> Back to Roles
    </a>
  </div>
  <div class="card-body">
    <form action="/roles/add" method="POST">
      <div class="mb-3">
        <label for="name" class="form-label text-white">Role Name</label>
        <input type="text" class="form-control" id="name" name="name" required>
        <div class="form-text">Enter a unique name for this role (e.g., Producer, Guitarist, Drummer)</div>
      </div>
      
      <div class="mb-3">
        <label for="description" class="form-label text-white">Description</label>
        <textarea class="form-control" id="description" name="description" rows="3"></textarea>
        <div class="form-text">Provide a brief description of this role</div>
      </div>
      
      <div class="mb-4">
        <label for="icon" class="form-label text-white">Icon</label>
        <select class="form-select" id="icon" name="icon">
          <option value="bi-person" selected>Person (Default)</option>
          <option value="bi-music-note">Music Note</option>
          <option value="bi-music-note-beamed">Music Note Beamed</option>
          <option value="bi-mic">Microphone</option>
          <option value="bi-headphones">Headphones</option>
          <option value="bi-speaker">Speaker</option>
          <option value="bi-vinyl">Vinyl</option>
          <option value="bi-file-music">Music File</option>
          <option value="bi-soundwave">Soundwave</option>
          <option value="bi-broadcast">Broadcast</option>
          <option value="bi-megaphone">Megaphone</option>
          <option value="bi-camera-video">Video</option>
          <option value="bi-camera">Camera</option>
          <option value="bi-pencil">Pencil</option>
          <option value="bi-brush">Brush</option>
          <option value="bi-palette">Palette</option>
          <option value="bi-stars">Stars</option>
          <option value="bi-star">Star</option>
          <option value="bi-lightning">Lightning</option>
          <option value="bi-award">Award</option>
          <option value="bi-trophy">Trophy</option>
        </select>
        <div class="form-text">Select an icon to represent this role</div>
      </div>
      
      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Add Role</button>
      </div>
    </form>
  </div>
</div>

<!-- Icon Preview -->
<div class="glass-card-dark border border-secondary mt-4">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">Icon Preview</h5>
  </div>
  <div class="card-body">
    <div class="text-center">
      <i id="iconPreview" class="bi bi-person display-1 text-white mb-3"></i>
      <p class="text-white" id="iconName">bi-person</p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const iconSelect = document.getElementById('icon');
    const iconPreview = document.getElementById('iconPreview');
    const iconName = document.getElementById('iconName');
    
    iconSelect.addEventListener('change', function() {
      const selectedIcon = this.value;
      
      // Remove all existing icon classes
      iconPreview.className = '';
      
      // Add the bi class and the selected icon class
      iconPreview.classList.add('bi', selectedIcon, 'display-1', 'text-white', 'mb-3');
      
      // Update the icon name text
      iconName.textContent = selectedIcon;
    });
  });
</script>
