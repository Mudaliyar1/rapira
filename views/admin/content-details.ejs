<%- contentFor('body') %>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="fw-bold">Content Details</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/admin/content">Content</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= content.title %></li>
      </ol>
    </nav>
  </div>
  <div>
    <a href="/admin/content/<%= content._id %>/edit" class="btn btn-primary me-2">
      <i class="bi bi-pencil me-1"></i> Edit Content
    </a>
  </div>
</div>

<!-- Content Details -->
<div class="row">
  <!-- Content Preview -->
  <div class="col-lg-8">
    <div class="glass-card-dark mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Content Preview</h5>
        <div>
          <a href="/content/<%= content._id %>" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-box-arrow-up-right me-1"></i> View Content
          </a>
        </div>
      </div>
      <div class="card-body">
        <div class="content-preview mb-4">
          <% if (content.type === 'video') { %>
            <div class="ratio ratio-16x9 mb-3">
              <video src="<%= content.fullFileUrl || content.fileUrl %>" controls poster="<%= content.fullThumbnailUrl || content.thumbnailUrl %>" onerror="handleMediaError(this, 'video')"></video>
            </div>
          <% } else if (content.type === 'song') { %>
            <div class="d-flex align-items-center mb-3">
              <img src="<%= content.fullThumbnailUrl || content.thumbnailUrl %>" alt="<%= content.title %>" class="img-fluid rounded me-3" style="width: 120px; height: 120px; object-fit: cover;">
              <audio src="<%= content.fullFileUrl || content.fileUrl %>" controls class="w-100" onerror="handleMediaError(this, 'audio')"></audio>
            </div>
          <% } else if (content.type === 'lyrics') { %>
            <div class="p-4 bg-light rounded">
              <% if (content.lyrics) { %>
                <pre class="mb-0" style="white-space: pre-wrap;"><%= content.lyrics %></pre>
              <% } else { %>
                <div class="text-center">
                  <p>View the PDF file:</p>
                  <a href="<%= content.fullFileUrl || content.fileUrl %>" class="btn btn-primary" target="_blank">
                    <i class="bi bi-file-pdf me-1"></i> Open PDF
                  </a>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <img src="<%= content.fullThumbnailUrl || content.thumbnailUrl %>" alt="<%= content.title %>" class="img-fluid rounded mb-3" style="max-height: 300px;">
              <div>
                <a href="<%= content.fullFileUrl || content.fileUrl %>" class="btn btn-primary" target="_blank">
                  <i class="bi bi-download me-1"></i> Download File
                </a>
              </div>
            </div>
          <% } %>
        </div>

        <h4 class="fw-bold mb-3"><%= content.title %></h4>
        <p class="text-muted mb-4"><%= content.description %></p>

        <div class="row g-3">
          <div class="col-md-6">
            <div class="d-flex align-items-center">
              <div class="me-3">
                <span class="badge bg-<%= content.type === 'song' ? 'primary' : content.type === 'video' ? 'danger' : 'info' %> p-2">
                  <i class="bi bi-<%= content.type === 'song' ? 'music-note' : content.type === 'video' ? 'camera-video' : 'file-text' %> me-1"></i>
                  <%= content.type.charAt(0).toUpperCase() + content.type.slice(1) %>
                </span>
              </div>
              <div>
                <small class="text-muted d-block">Content Type</small>
                <span><%= content.type.charAt(0).toUpperCase() + content.type.slice(1) %></span>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-center">
              <div class="me-3">
                <span class="badge bg-<%= content.featured ? 'success' : 'secondary' %> p-2">
                  <i class="bi bi-<%= content.featured ? 'star-fill' : 'star' %> me-1"></i>
                  <%= content.featured ? 'Featured' : 'Not Featured' %>
                </span>
              </div>
              <div>
                <small class="text-muted d-block">Status</small>
                <span><%= content.featured ? 'Featured' : 'Not Featured' %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Information -->
  <div class="col-lg-4">
    <div class="glass-card-dark mb-4">
      <div class="card-header">
        <h5 class="card-title mb-0">Content Information</h5>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-bottom">
            <span class="text-muted">Artist</span>
            <a href="/admin/artists/<%= content.artist._id %>" class="fw-medium">
              <%= content.artist && content.artist.user ? content.artist.user.name : 'Unknown' %>
            </a>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-bottom">
            <span class="text-muted">Uploaded</span>
            <span class="fw-medium"><%= toISTDateString(content.createdAt) %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-bottom">
            <span class="text-muted">Views</span>
            <span class="fw-medium"><%= content.views || 0 %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
            <span class="text-muted">Last Updated</span>
            <span class="fw-medium"><%= toISTDateString(content.updatedAt) %></span>
          </li>
        </ul>
      </div>
      <div class="card-footer">
        <div class="d-grid gap-2">
          <form action="/admin/content/<%= content._id %>/feature" method="POST">
            <button type="submit" class="btn btn-<%= content.featured ? 'secondary' : 'primary' %> w-100">
              <i class="bi bi-<%= content.featured ? 'star' : 'star-fill' %> me-1"></i>
              <%= content.featured ? 'Remove from Featured' : 'Add to Featured' %>
            </button>
          </form>
          <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteContentModal">
            <i class="bi bi-trash me-1"></i> Delete Content
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteContentModal" tabindex="-1" aria-labelledby="deleteContentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteContentModalLabel">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete "<strong><%= content.title %></strong>"?</p>
        <p class="text-danger mb-0">This action cannot be undone.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form action="/admin/content/<%= content._id %>/delete" method="POST">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- contentFor('title') %>Content: <%= content.title %>

<%- contentFor('scripts') %>
<script>
  // Handle media loading errors
  function handleMediaError(element, mediaType) {
    console.error(`Error loading ${mediaType}:`, element.error);

    // Create error container
    const errorContainer = document.createElement('div');
    errorContainer.className = 'alert alert-danger mt-3';
    errorContainer.innerHTML = `
      <p><strong>Error loading ${mediaType} file.</strong> This may be due to:</p>
      <ul>
        <li>File not found on the server</li>
        <li>CORS restrictions</li>
        <li>Unsupported file format</li>
      </ul>
      <p>Try downloading the file instead:</p>
      <a href="${element.src}" class="btn btn-primary" download>Download ${mediaType.charAt(0).toUpperCase() + mediaType.slice(1)}</a>
    `;

    // Replace the media element with the error message
    const parent = element.parentNode;
    parent.appendChild(errorContainer);
    element.style.display = 'none';
  }
</script>
