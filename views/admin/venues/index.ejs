<%- contentFor('body') %>

<!-- Venue Management Dashboard -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="fw-bold">Venue Management</h1>
  <div class="d-flex gap-2">
    <form method="POST" action="/admin/venues/delete-all" style="display: inline;">
      <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete ALL venues? This action cannot be undone and will permanently remove all venue data.')">
        <i class="bi bi-trash me-1"></i> Delete All Venues
      </button>
    </form>
    <a href="/admin/venues/export" class="btn btn-outline-success">
      <i class="bi bi-download me-1"></i> Export CSV
    </a>
    <a href="/admin/venues/add" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i> Add New Venue
    </a>
  </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card bg-primary text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-white-50 mb-0">Total Venues</h6>
            <h3 class="mb-0"><%= stats.total %></h3>
          </div>
          <i class="bi bi-building fs-2 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-success text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-white-50 mb-0">Active Venues</h6>
            <h3 class="mb-0"><%= stats.active %></h3>
          </div>
          <i class="bi bi-check-circle fs-2 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-info text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-white-50 mb-0">Verified Venues</h6>
            <h3 class="mb-0"><%= stats.verified %></h3>
          </div>
          <i class="bi bi-patch-check fs-2 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-warning text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-white-50 mb-0">Filtered Results</h6>
            <h3 class="mb-0"><%= stats.filtered %></h3>
          </div>
          <i class="bi bi-funnel fs-2 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Search and Filter Section -->
<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/admin/venues" id="venueSearchForm">
      <div class="row g-3">
        <div class="col-md-3">
          <input type="text" class="form-control" name="search" 
                 placeholder="Search venues..." value="<%= searchParams.search %>">
        </div>
        <div class="col-md-2">
          <select class="form-select" name="city">
            <option value="all">All Cities</option>
            <% filterOptions.cities.forEach(city => { %>
              <option value="<%= city %>" <%= searchParams.city === city ? 'selected' : '' %>><%= city %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <select class="form-select" name="state">
            <option value="all">All States</option>
            <% filterOptions.states.forEach(state => { %>
              <option value="<%= state %>" <%= searchParams.state === state ? 'selected' : '' %>><%= state %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <select class="form-select" name="type">
            <option value="all">All Types</option>
            <% filterOptions.types.forEach(type => { %>
              <option value="<%= type %>" <%= searchParams.type === type ? 'selected' : '' %>><%= type %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-1">
          <select class="form-select" name="active">
            <option value="all">All</option>
            <option value="true" <%= searchParams.active === 'true' ? 'selected' : '' %>>Active</option>
            <option value="false" <%= searchParams.active === 'false' ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i>
          </button>
          <a href="/admin/venues" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i>
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Venues Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Venue Details</th>
            <th>Location</th>
            <th>Type & Capacity</th>
            <th>Contact</th>
            <th>Status</th>
            <th width="150">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (venues && venues.length > 0) { %>
            <% venues.forEach(venue => { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-3">
                      <% if (venue.images && venue.images.length > 0) { %>
                        <img src="<%= venue.images[0] %>" alt="<%= venue.name %>" 
                             class="rounded" width="60" height="40" style="object-fit: cover;">
                      <% } else { %>
                        <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                             style="width: 60px; height: 40px;">
                          <i class="bi bi-building text-muted"></i>
                        </div>
                      <% } %>
                    </div>
                    <div>
                      <h6 class="mb-0"><%= venue.name %></h6>
                      <small class="text-muted">
                        Created by <%= venue.createdBy ? venue.createdBy.name : 'Unknown' %>
                      </small>
                    </div>
                  </div>
                </td>
                <td>
                  <div>
                    <div><%= venue.city %>, <%= venue.state %></div>
                    <small class="text-muted"><%= venue.pincode %></small>
                  </div>
                </td>
                <td>
                  <div>
                    <span class="badge bg-secondary"><%= venue.venueType %></span>
                    <% if (venue.capacity) { %>
                      <br><small class="text-muted">Capacity: <%= venue.capacity %></small>
                    <% } %>
                  </div>
                </td>
                <td>
                  <% if (venue.contactPerson && venue.contactPerson.name) { %>
                    <div><%= venue.contactPerson.name %></div>
                    <% if (venue.contactPerson.phone) { %>
                      <small class="text-muted"><%= venue.contactPerson.phone %></small>
                    <% } %>
                  <% } else { %>
                    <small class="text-muted">No contact info</small>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex flex-column gap-1">
                    <span class="badge <%= venue.isActive ? 'bg-success' : 'bg-danger' %>">
                      <%= venue.isActive ? 'Active' : 'Inactive' %>
                    </span>
                    <% if (venue.isVerified) { %>
                      <span class="badge bg-primary">Verified</span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="btn-group btn-group-sm" role="group">
                    <a href="/admin/venues/<%= venue._id %>/details" class="btn btn-outline-info" title="View Details">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/admin/venues/<%= venue._id %>/edit" class="btn btn-outline-primary" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <div class="btn-group btn-group-sm" role="group">
                      <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" 
                              data-bs-toggle="dropdown" title="More Actions">
                        <i class="bi bi-three-dots-vertical"></i>
                      </button>
                      <ul class="dropdown-menu">
                        <li>
                          <form method="POST" action="/admin/venues/<%= venue._id %>/toggle-active" class="d-inline">
                            <button type="submit" class="dropdown-item">
                              <i class="bi bi-<%= venue.isActive ? 'x-circle' : 'check-circle' %> me-1"></i>
                              <%= venue.isActive ? 'Deactivate' : 'Activate' %>
                            </button>
                          </form>
                        </li>
                        <li>
                          <form method="POST" action="/admin/venues/<%= venue._id %>/toggle-verified" class="d-inline">
                            <button type="submit" class="dropdown-item">
                              <i class="bi bi-<%= venue.isVerified ? 'patch-exclamation' : 'patch-check' %> me-1"></i>
                              <%= venue.isVerified ? 'Unverify' : 'Verify' %>
                            </button>
                          </form>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <form method="POST" action="/admin/venues/<%= venue._id %>/delete" class="d-inline">
                            <button type="submit" class="dropdown-item text-danger" 
                                    onclick="return confirm('Are you sure you want to delete this venue?')">
                              <i class="bi bi-trash me-1"></i> Delete
                            </button>
                          </form>
                        </li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-building display-1 mb-3"></i>
                <h5>No venues found</h5>
                <p>No venues match your current search criteria.</p>
                <a href="/admin/venues/add" class="btn btn-primary">Add First Venue</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Pagination -->
<% if (pagination.total > 1) { %>
  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      <% if (pagination.hasPrev) { %>
        <li class="page-item">
          <a class="page-link" href="?<%= new URLSearchParams({...searchParams, page: pagination.prev}).toString() %>">
            <i class="bi bi-chevron-left"></i>
          </a>
        </li>
      <% } %>

      <% for (let i = Math.max(1, pagination.current - 2); i <= Math.min(pagination.total, pagination.current + 2); i++) { %>
        <li class="page-item <%= i === pagination.current ? 'active' : '' %>">
          <a class="page-link" href="?<%= new URLSearchParams({...searchParams, page: i}).toString() %>">
            <%= i %>
          </a>
        </li>
      <% } %>

      <% if (pagination.hasNext) { %>
        <li class="page-item">
          <a class="page-link" href="?<%= new URLSearchParams({...searchParams, page: pagination.next}).toString() %>">
            <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>
