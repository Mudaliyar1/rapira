<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Concert Details - Rapira Admin</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../partials/admin-sidebar', { path: '/admin/concerts' }) %>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Concert Details</h1>
        <div>
          <a href="<%= concert.status === 'pending' ? '/admin/concerts/pending' : '/admin/concerts' %>" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i> Back
          </a>
          <button class="btn btn-primary d-md-none" id="adminToggle">
            <i class="bi bi-list"></i>
          </button>
        </div>
      </div>

      <!-- Concert Details -->
      <div class="row">
        <div class="col-lg-8">
          <!-- Concert Card -->
          <div class="glass-card-dark mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
              <h3 class="card-title fw-bold mb-0"><%= concert.title %></h3>
              <span class="badge <%=
                concert.status === 'pending' ? 'bg-warning' :
                concert.status === 'approved' ? 'bg-success' :
                concert.status === 'rejected' ? 'bg-danger' :
                concert.status === 'cancelled' ? 'bg-secondary' :
                'bg-info' %> fs-6">
                <%= concert.status.charAt(0).toUpperCase() + concert.status.slice(1) %>
              </span>
            </div>
            <div class="card-body p-4">
              <!-- Concert Image -->
              <div class="text-center mb-4">
                <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="img-fluid rounded" style="max-height: 300px;">
              </div>

              <!-- Concert Details -->
              <div class="row mb-4">
                <div class="col-md-6 mb-3">
                  <p class="fw-medium mb-1">Artist:</p>
                  <p><%= concert.artist.user.name %></p>
                </div>
                <div class="col-md-6 mb-3">
                  <p class="fw-medium mb-1">Date & Time:</p>
                  <p><%= new Date(concert.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %> • <%= concert.time %></p>
                </div>
                <div class="col-md-6 mb-3">
                  <p class="fw-medium mb-1">Venue:</p>
                  <p><%= concert.venue %></p>
                </div>
                <div class="col-md-6 mb-3">
                  <p class="fw-medium mb-1">City:</p>
                  <p><%= concert.city %></p>
                </div>
                <div class="col-md-6 mb-3">
                  <p class="fw-medium mb-1">Ticket Price:</p>
                  <p><%= concert.isPaid ? `₹${concert.price}` : 'Free' %></p>
                </div>
                <div class="col-md-6 mb-3">
                  <p class="fw-medium mb-1">Max Tickets:</p>
                  <p><%= concert.maxTickets > 0 ? concert.maxTickets : 'Unlimited' %></p>
                </div>
                <div class="col-md-6 mb-3">
                  <p class="fw-medium mb-1">Tickets Sold:</p>
                  <p><%= concert.ticketsSold %> <%= concert.maxTickets > 0 ? `/ ${concert.maxTickets}` : '' %></p>
                </div>
                <div class="col-md-6 mb-3">
                  <p class="fw-medium mb-1">Created On:</p>
                  <p><%= new Date(concert.createdAt).toLocaleDateString() %></p>
                </div>
              </div>

              <hr class="my-4">

              <!-- Concert Description -->
              <div>
                <h4 class="fw-bold mb-3">Description</h4>
                <p><%= concert.description %></p>
              </div>
            </div>
            <div class="card-footer p-4">
              <div class="d-flex flex-wrap gap-2">
                <a href="/concerts/<%= concert._id %>" class="btn btn-outline-primary" target="_blank">
                  <i class="bi bi-eye me-1"></i> View Public Page
                </a>

                <% if (concert.status === 'pending') { %>
                  <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">
                    <i class="bi bi-check-lg me-1"></i> Approve
                  </button>
                  <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i class="bi bi-x-lg me-1"></i> Reject
                  </button>
                <% } else if (concert.status === 'approved') { %>
                  <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#cancelModal">
                    <i class="bi bi-x-circle me-1"></i> Cancel Concert
                  </button>
                <% } %>

                <!-- Delete button for all concerts -->
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                  <i class="bi bi-trash me-1"></i> Delete Concert
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <!-- Artist Info -->
          <div class="glass-card-dark mb-4">
            <div class="card-header py-3">
              <h4 class="card-title fw-bold mb-0">Artist Information</h4>
            </div>
            <div class="card-body p-4">
              <div class="d-flex align-items-center mb-3">
                <% if (concert.artist.user.profileImage) { %>
                  <img src="<%= concert.artist.user.profileImage %>" alt="<%= concert.artist.user.name %>" class="rounded-circle me-3" width="60" height="60">
                <% } else { %>
                  <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-person fs-3"></i>
                  </div>
                <% } %>
                <div>
                  <h5 class="fw-bold mb-1"><%= concert.artist.user.name %></h5>
                  <p class="text-muted mb-0"><%= concert.artist.user.email %></p>
                </div>
              </div>

              <div class="mb-3">
                <p class="fw-medium mb-1">Stage Name:</p>
                <p><%= concert.artist.stageName || concert.artist.user.name %></p>
              </div>

              <div class="mb-3">
                <p class="fw-medium mb-1">Genre:</p>
                <p><%= concert.artist.genre || 'Not specified' %></p>
              </div>

              <div class="mb-3">
                <p class="fw-medium mb-1">Verification Status:</p>
                <p>
                  <span class="badge <%= concert.artist.verified ? 'bg-success' : 'bg-warning' %>">
                    <%= concert.artist.verified ? 'Verified' : 'Unverified' %>
                  </span>
                </p>
              </div>

              <div>
                <p class="fw-medium mb-1">Featured Artist:</p>
                <p>
                  <span class="badge <%= concert.artist.featuredArtist ? 'bg-primary' : 'bg-secondary' %>">
                    <%= concert.artist.featuredArtist ? 'Featured' : 'Not Featured' %>
                  </span>
                </p>
              </div>

              <div class="mt-4">
                <a href="/artists/<%= concert.artist._id %>" class="btn btn-outline-primary w-100" target="_blank">
                  <i class="bi bi-person me-1"></i> View Artist Profile
                </a>
              </div>
            </div>
          </div>

          <!-- Ticket Stats -->
          <div class="glass-card-dark">
            <div class="card-header py-3">
              <h4 class="card-title fw-bold mb-0">Ticket Statistics</h4>
            </div>
            <div class="card-body p-4">
              <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>Tickets Sold</span>
                  <span class="fw-bold"><%= concert.ticketsSold %></span>
                </div>
                <div class="progress" style="height: 10px;">
                  <div class="progress-bar bg-primary" role="progressbar"
                    style="width: <%= concert.maxTickets > 0 ? (concert.ticketsSold / concert.maxTickets * 100) : 100 %>%;"
                    aria-valuenow="<%= concert.ticketsSold %>"
                    aria-valuemin="0"
                    aria-valuemax="<%= concert.maxTickets > 0 ? concert.maxTickets : concert.ticketsSold %>">
                  </div>
                </div>
              </div>

              <div class="row text-center">
                <div class="col-6">
                  <div class="p-3 border rounded mb-2">
                    <h3 class="fw-bold text-primary mb-0"><%= concert.ticketsSold %></h3>
                  </div>
                  <p class="small text-muted">Tickets Sold</p>
                </div>
                <div class="col-6">
                  <div class="p-3 border rounded mb-2">
                    <h3 class="fw-bold text-success mb-0">₹<%= concert.isPaid ? (concert.price * concert.ticketsSold) : 0 %></h3>
                  </div>
                  <p class="small text-muted">Revenue</p>
                </div>
              </div>

              <div class="mt-4">
                <a href="/admin/tickets" class="btn btn-outline-primary w-100">
                  <i class="bi bi-ticket-perforated me-1"></i> View All Tickets
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Approve Modal -->
  <% if (concert.status === 'pending') { %>
    <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Confirm Approval</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p>Are you sure you want to approve the concert "<%= concert.title %>"?</p>
            <p class="mb-0">This will make the concert visible to all users and allow ticket bookings.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <form action="/admin/concerts/<%= concert._id %>/approve" method="POST">
              <button type="submit" class="btn btn-success">Approve Concert</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Reject Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Confirm Rejection</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form action="/admin/concerts/<%= concert._id %>/reject" method="POST">
            <div class="modal-body">
              <p>Are you sure you want to reject the concert "<%= concert.title %>"?</p>
              <div class="mb-3">
                <label for="reason" class="form-label">Rejection Reason (Optional)</label>
                <textarea class="form-control" id="reason" name="reason" rows="3" placeholder="Provide a reason for rejection"></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-danger">Reject Concert</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } else if (concert.status === 'approved') { %>
    <!-- Cancel Modal -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Confirm Cancellation</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form action="/admin/concerts/<%= concert._id %>/cancel" method="POST">
            <div class="modal-body">
              <p>Are you sure you want to cancel the concert "<%= concert.title %>"?</p>
              <p class="text-danger">This will prevent any further ticket bookings and notify all ticket holders.</p>
              <div class="mb-3">
                <label for="cancelReason" class="form-label">Cancellation Reason</label>
                <textarea class="form-control" id="cancelReason" name="reason" rows="3" placeholder="Provide a reason for cancellation" required></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-warning">Cancel Concert</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Delete Modal (for all concerts) -->
  <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Confirm Deletion</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-danger fw-bold">Warning: This action cannot be undone!</p>
          <p>Are you sure you want to permanently delete the concert "<%= concert.title %>"?</p>
          <p>This will remove all records of this concert, including:</p>
          <ul>
            <li>All ticket records</li>
            <li>All booking information</li>
            <li>All concert details</li>
          </ul>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <form action="/admin/concerts/<%= concert._id %>/delete" method="POST">
            <button type="submit" class="btn btn-danger">Delete Permanently</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Admin Toggle -->
  <button class="btn admin-toggle d-md-none" id="adminToggle">
    <i class="bi bi-list"></i>
  </button>



  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
</body>
</html>
