<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-danger text-white">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h3 class="mb-1">Reject Unblock Request</h3>
              <p class="mb-0 small">Review and reject producer unblock request</p>
            </div>
            <i class="bi bi-x-circle" style="font-size: 2rem;"></i>
          </div>
        </div>
        <div class="card-body">
          <!-- Producer Info -->
          <div class="alert alert-info mb-4">
            <h6 class="fw-bold mb-2">Producer Information:</h6>
            <div class="row g-2">
              <div class="col-md-6">
                <strong class="text-dark">Name:</strong> <%= request.producer.name %>
              </div>
              <div class="col-md-6">
                <strong class="text-dark">Email:</strong> <%= request.producer.email %>
              </div>
            </div>
          </div>

          <!-- Request Message -->
          <div class="mb-4">
            <label class="form-label fw-bold">Producer's Unblock Request Message:</label>
            <div class="alert alert-light border">
              <p class="mb-0"><%= request.message %></p>
            </div>
          </div>

          <!-- Reject Form -->
          <form method="POST" action="/admin/producers/unblock-requests/<%= request._id %>/reject">
            <div class="mb-4">
              <label class="form-label fw-bold">Rejection Reason *:</label>
              <textarea name="adminResponse" class="form-control" rows="4" placeholder="Please explain why you are rejecting this unblock request..." required></textarea>
              <small class="text-muted">This message will be shown to the producer when they check their request status.</small>
            </div>

            <div class="alert alert-warning mb-4">
              <h6 class="fw-bold mb-2">
                <i class="bi bi-exclamation-triangle me-2"></i> Important Notice
              </h6>
              <ul class="mb-0 small">
                <li>The producer will remain blocked</li>
                <li>They will be able to submit a new unblock request after the rejection</li>
                <li>The rejection reason will be visible to the producer</li>
              </ul>
            </div>

            <div class="mb-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="confirmReject" required>
                <label class="form-check-label" for="confirmReject">
                  I confirm that I want to <strong>REJECT</strong> this unblock request. The producer will remain blocked.
                </label>
              </div>
            </div>

            <div class="d-flex gap-2">
              <a href="/admin/producers/unblock-requests/<%= request._id %>" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i> Cancel
              </a>
              <button type="submit" class="btn btn-danger">
                <i class="bi bi-x-circle me-2"></i> Confirm Rejection
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
