<!-- Delete Product Confirmation -->
<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="text-white mb-1">Delete Product</h2>
          <p class="text-muted">Confirm product deletion</p>
        </div>
        <a href="/admin/merchandise/products" class="btn btn-outline-light">
          <i class="bi bi-arrow-left me-2"></i>Back to Products
        </a>
      </div>

      <!-- Confirmation Card -->
      <div class="glass-card-dark p-4 rounded-4">
        <div class="text-center mb-4">
          <div class="text-danger mb-3">
            <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
          </div>
          <h4 class="text-white mb-2">Are you sure you want to delete this product?</h4>
          <p class="text-muted">This action cannot be undone.</p>
        </div>

        <!-- Product Information -->
        <div class="row mb-4">
          <div class="col-md-4">
            <% if (product.images && product.images.length > 0) { %>
              <img src="<%= product.images[0] %>" class="img-fluid rounded-3" 
                   alt="<%= product.name %>" style="height: 200px; object-fit: cover; width: 100%;">
            <% } else { %>
              <div class="bg-secondary rounded-3 d-flex align-items-center justify-content-center" 
                   style="height: 200px;">
                <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
              </div>
            <% } %>
          </div>
          <div class="col-md-8">
            <h5 class="text-white mb-3"><%= product.name %></h5>
            
            <div class="row g-3">
              <div class="col-sm-6">
                <small class="text-muted">Category</small>
                <div class="text-white"><%= product.category %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted">Price</small>
                <div class="text-white">₹<%= product.price %></div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted">Total Stock</small>
                <div class="text-white"><%= product.totalStock || 0 %> items</div>
              </div>
              <div class="col-sm-6">
                <small class="text-muted">Status</small>
                <div>
                  <span class="badge bg-<%= product.isActive ? 'success' : 'secondary' %>">
                    <%= product.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </div>
              </div>
              <div class="col-12">
                <small class="text-muted">Description</small>
                <div class="text-white">
                  <%= product.description.length > 150 ? 
                      product.description.substring(0, 150) + '...' : 
                      product.description %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Warning Messages -->
        <div class="alert alert-warning d-flex align-items-center mb-4">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <div>
            <strong>Warning:</strong> Deleting this product will:
            <ul class="mb-0 mt-2">
              <li>Remove the product from your store permanently</li>
              <li>Delete all product images and data</li>
              <li>Remove it from any featured product lists</li>
              <li>Make it unavailable for future orders</li>
            </ul>
          </div>
        </div>

        <% if (hasOrders) { %>
          <% if (hasPendingOrders) { %>
            <div class="alert alert-warning d-flex align-items-center mb-4">
              <i class="bi bi-exclamation-triangle me-2"></i>
              <div>
                <strong>Cannot Delete:</strong> This product has <%= pendingOrders %> pending order(s) that are not yet delivered.
                The product will be deactivated instead to preserve order history.
                <br><small class="text-muted mt-1">
                  Products can only be deleted when all orders are delivered, cancelled, or returned.
                </small>
              </div>
            </div>
          <% } else { %>
            <div class="alert alert-success d-flex align-items-center mb-4">
              <i class="bi bi-check-circle me-2"></i>
              <div>
                <strong>Ready to Delete:</strong> This product has <%= totalOrders %> order(s), but all are completed (delivered, cancelled, or returned).
                The product can now be safely deleted.
              </div>
            </div>
          <% } %>
        <% } %>

        <!-- Action Buttons -->
        <div class="d-flex gap-3 justify-content-center">
          <a href="/admin/merchandise/products" class="btn btn-outline-light btn-lg">
            <i class="bi bi-x-circle me-2"></i>Cancel
          </a>
          <button type="button" class="btn btn-danger btn-lg" <% if (hasPendingOrders) { %>title="Cannot delete - has pending orders"<% } %> onclick="
            alert('🗑️ Delete button clicked! Starting deletion process...');
            console.log('Delete button clicked for product ID: <%= product._id %>');

            var deleteBtn = this;
            var originalText = deleteBtn.innerHTML;

            deleteBtn.disabled = true;
            deleteBtn.innerHTML = '<i class=\'bi bi-hourglass-split me-2\'></i>Processing...';

            fetch('/admin/merchandise/products/<%= product._id %>', {
              method: 'DELETE',
              headers: {
                'Content-Type': 'application/json'
              }
            })
            .then(function(response) {
              console.log('Response status:', response.status);
              return response.json();
            })
            .then(function(result) {
              console.log('Delete result:', result);

              if (result.success) {
                alert('✅ SUCCESS: ' + (result.message || 'Product deleted successfully'));
                window.location.href = '/admin/merchandise/products';
              } else {
                alert('❌ ERROR: ' + (result.message || 'Error deleting product'));
                deleteBtn.disabled = false;
                deleteBtn.innerHTML = originalText;
              }
            })
            .catch(function(error) {
              console.error('Delete product error:', error);
              alert('❌ NETWORK ERROR: ' + error.message);
              deleteBtn.disabled = false;
              deleteBtn.innerHTML = originalText;
            });
          ">
            <i class="bi bi-trash me-2"></i>
            <%= hasPendingOrders ? 'Deactivate Product' : 'Delete Product' %>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Simple page initialization
document.addEventListener('DOMContentLoaded', function() {
  console.log('✅ Delete confirmation page loaded successfully');
  console.log('Product ID: <%= product._id %>');
  console.log('Has orders: <%= hasOrders %>');
});
</script>

<style>
.glass-card-dark {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.alert {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: white;
}

.alert-warning {
  background: rgba(255, 193, 7, 0.1);
  border-color: rgba(255, 193, 7, 0.3);
  color: #ffc107;
}

.alert-info {
  background: rgba(13, 202, 240, 0.1);
  border-color: rgba(13, 202, 240, 0.3);
  color: #0dcaf0;
}
</style>


