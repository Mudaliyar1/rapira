<!-- Reviews Management Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="text-white mb-0">
    <i class="bi bi-star me-2"></i>Review Management
  </h2>
  <div class="d-flex gap-2">
    <button class="btn btn-outline-light" onclick="exportReviews()">
      <i class="bi bi-download me-2"></i>Export Reviews
    </button>
    <button class="btn btn-outline-info" onclick="refreshReviews()">
      <i class="bi bi-arrow-clockwise me-2"></i>Refresh
    </button>
  </div>
</div>

<!-- Filters and Search -->
<div class="glass-card-dark p-4 rounded-4 mb-4">
  <form method="GET" action="/reviews/admin" id="filterForm">
    <div class="row g-3 align-items-end">
      <!-- Search -->
      <div class="col-md-4">
        <label class="form-label text-white">Search Reviews</label>
        <div class="input-group">
          <input type="text" class="form-control" name="search" 
                 placeholder="Review title, comment..." value="<%= filters.search || '' %>">
          <button class="btn btn-outline-light" type="submit">
            <i class="bi bi-search"></i>
          </button>
        </div>
      </div>
      
      <!-- Status Filter -->
      <div class="col-md-2">
        <label class="form-label text-white">Status</label>
        <select class="form-select" name="status" onchange="document.getElementById('filterForm').submit()">
          <option value="all" <%= (!filters.status || filters.status === 'all') ? 'selected' : '' %>>All Status</option>
          <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
          <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
        </select>
      </div>
      
      <!-- Rating Filter -->
      <div class="col-md-2">
        <label class="form-label text-white">Rating</label>
        <select class="form-select" name="rating" onchange="document.getElementById('filterForm').submit()">
          <option value="all" <%= (!filters.rating || filters.rating === 'all') ? 'selected' : '' %>>All Ratings</option>
          <option value="5" <%= filters.rating === '5' ? 'selected' : '' %>>5 Stars</option>
          <option value="4" <%= filters.rating === '4' ? 'selected' : '' %>>4 Stars</option>
          <option value="3" <%= filters.rating === '3' ? 'selected' : '' %>>3 Stars</option>
          <option value="2" <%= filters.rating === '2' ? 'selected' : '' %>>2 Stars</option>
          <option value="1" <%= filters.rating === '1' ? 'selected' : '' %>>1 Star</option>
        </select>
      </div>
      
      <!-- Date Range -->
      <div class="col-md-2">
        <label class="form-label text-white">From Date</label>
        <input type="date" class="form-control" name="fromDate" value="<%= filters.fromDate || '' %>">
      </div>
      
      <!-- Clear Filters -->
      <div class="col-md-2">
        <a href="/reviews/admin" class="btn btn-outline-secondary w-100">
          <i class="bi bi-x-circle me-1"></i>Clear
        </a>
      </div>
    </div>
  </form>
</div>

<!-- Reviews Table -->
<div class="glass-card-dark rounded-4 overflow-hidden">
  <% if (reviews.length === 0) { %>
    <div class="p-5 text-center">
      <i class="bi bi-star display-1 text-muted mb-3"></i>
      <h4 class="text-white mb-3">No Reviews Found</h4>
      <p class="text-muted mb-4">
        <% if (filters.search || filters.status !== 'all' || filters.rating !== 'all') { %>
          No reviews match your current filters. Try adjusting your search criteria.
        <% } else { %>
          No reviews have been submitted yet.
        <% } %>
      </p>
    </div>
  <% } else { %>
    <!-- Results Info -->
    <div class="p-3 border-bottom border-secondary">
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-white">
          Showing <%= reviews.length %> of <%= totalReviews || reviews.length %> reviews
        </span>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-success btn-sm" onclick="bulkApprove()">
            <i class="bi bi-check-circle me-1"></i>Bulk Approve
          </button>
          <button class="btn btn-outline-danger btn-sm" onclick="bulkReject()">
            <i class="bi bi-x-circle me-1"></i>Bulk Reject
          </button>
        </div>
      </div>
    </div>
    
    <!-- Reviews List -->
    <div class="p-3">
      <% reviews.forEach(review => { %>
        <div class="review-item border border-secondary rounded-3 p-3 mb-3">
          <div class="row">
            <!-- Review Content -->
            <div class="col-lg-8">
              <div class="d-flex align-items-start mb-3">
                <input type="checkbox" class="form-check-input me-3 mt-1 review-checkbox" value="<%= review._id %>">
                <div class="flex-grow-1">
                  <!-- Product Info -->
                  <div class="d-flex align-items-center mb-2">
                    <img src="<%= review.product.images[0] %>" class="rounded me-3" 
                         width="40" height="40" alt="<%= review.product.name %>" style="object-fit: cover;">
                    <div>
                      <h6 class="text-white mb-0"><%= review.product.name %></h6>
                      <small class="text-muted">Size: <%= review.size %> | Order: #<%= review.order.orderNumber %></small>
                    </div>
                  </div>
                  
                  <!-- Rating -->
                  <div class="mb-2">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="bi bi-star<%= i <= review.rating ? '-fill text-warning' : ' text-muted' %>"></i>
                    <% } %>
                    <span class="text-white ms-2"><%= review.rating %>/5</span>
                  </div>
                  
                  <!-- Review Content -->
                  <h6 class="text-white mb-2"><%= review.title %></h6>
                  <p class="text-light mb-2"><%= review.comment %></p>
                  
                  <!-- Review Meta -->
                  <div class="d-flex align-items-center gap-3 text-muted small">
                    <span>
                      <i class="bi bi-person me-1"></i>
                      <%= review.user.name %> (<%= review.user.email %>)
                    </span>
                    <span>
                      <i class="bi bi-calendar me-1"></i>
                      <%= new Date(review.createdAt).toLocaleDateString('en-IN') %>
                    </span>
                    <% if (review.isVerifiedPurchase) { %>
                      <span class="badge bg-success">Verified Purchase</span>
                    <% } %>
                  </div>
                  
                  <!-- Admin Response -->
                  <% if (review.adminResponse && review.adminResponse.message) { %>
                    <div class="mt-3 p-2 bg-info bg-opacity-10 rounded">
                      <small class="text-info fw-bold">Admin Response:</small>
                      <p class="text-light mb-0 small"><%= review.adminResponse.message %></p>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
            
            <!-- Review Status & Actions -->
            <div class="col-lg-4">
              <div class="text-end">
                <!-- Status -->
                <div class="mb-3">
                  <% if (review.isApproved) { %>
                    <span class="badge bg-success">Approved</span>
                  <% } else { %>
                    <span class="badge bg-warning">Pending Approval</span>
                  <% } %>
                </div>
                
                <!-- Helpful Stats -->
                <% if (review.helpfulVotes > 0) { %>
                  <div class="mb-3">
                    <small class="text-muted">
                      <i class="bi bi-hand-thumbs-up me-1"></i>
                      <%= review.helpfulVotes %> found helpful
                    </small>
                  </div>
                <% } %>
                
                <!-- Actions -->
                <div class="d-flex gap-1 justify-content-end flex-wrap">
                  <% if (!review.isApproved) { %>
                    <button class="btn btn-outline-success btn-sm" 
                            onclick="moderateReview('<%= review._id %>', 'approve')"
                            title="Approve Review">
                      <i class="bi bi-check-circle"></i>
                    </button>
                    <button class="btn btn-outline-danger btn-sm" 
                            onclick="moderateReview('<%= review._id %>', 'reject')"
                            title="Reject Review">
                      <i class="bi bi-x-circle"></i>
                    </button>
                  <% } else { %>
                    <button class="btn btn-outline-warning btn-sm" 
                            onclick="moderateReview('<%= review._id %>', 'reject')"
                            title="Unapprove Review">
                      <i class="bi bi-x-circle"></i>
                    </button>
                  <% } %>
                  
                  <button class="btn btn-outline-info btn-sm" 
                          onclick="respondToReview('<%= review._id %>')"
                          title="Add Response">
                    <i class="bi bi-reply"></i>
                  </button>
                  
                  <button class="btn btn-outline-secondary btn-sm" 
                          onclick="deleteReview('<%= review._id %>')"
                          title="Delete Review">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
                
                <!-- Moderation Notes -->
                <% if (review.moderationNotes) { %>
                  <div class="mt-2">
                    <small class="text-muted">
                      <strong>Notes:</strong> <%= review.moderationNotes %>
                    </small>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    
    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="p-3 border-top border-secondary">
        <nav aria-label="Reviews pagination">
          <ul class="pagination justify-content-center mb-0">
            <% if (currentPage > 1) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage - 1 %>&<%= new URLSearchParams(filters).toString() %>">
                  <i class="bi bi-chevron-left"></i>
                </a>
              </li>
            <% } %>
            
            <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
              <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>&<%= new URLSearchParams(filters).toString() %>"><%= i %></a>
              </li>
            <% } %>
            
            <% if (currentPage < totalPages) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage + 1 %>&<%= new URLSearchParams(filters).toString() %>">
                  <i class="bi bi-chevron-right"></i>
                </a>
              </li>
            <% } %>
          </ul>
        </nav>
      </div>
    <% } %>
  <% } %>
</div>

<!-- Admin Response Modal -->
<div class="modal fade" id="responseModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Add Admin Response</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="responseForm">
          <div class="mb-3">
            <label class="form-label text-white">Response Message</label>
            <textarea class="form-control" id="responseMessage" rows="4" required 
                      placeholder="Enter your response to this review..."></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="submitResponse()">Add Response</button>
      </div>
    </div>
  </div>
</div>

<script>
let currentReviewId = null;

async function moderateReview(reviewId, action) {
  const notes = prompt(`${action === 'approve' ? 'Approve' : 'Reject'} this review. Add notes (optional):`);
  
  if (notes === null) return; // User cancelled
  
  try {
    const response = await fetch(`/reviews/admin/${reviewId}/moderate`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ action, notes })
    });
    
    const result = await response.json();
    
    if (result.success) {
      alert(result.message);
      window.location.reload();
    } else {
      alert(result.message || 'Error moderating review');
    }
  } catch (error) {
    console.error('Moderate review error:', error);
    alert('Error moderating review');
  }
}

function respondToReview(reviewId) {
  currentReviewId = reviewId;
  document.getElementById('responseMessage').value = '';
  const modal = new bootstrap.Modal(document.getElementById('responseModal'));
  modal.show();
}

async function submitResponse() {
  if (!currentReviewId) return;
  
  const message = document.getElementById('responseMessage').value.trim();
  
  if (!message) {
    alert('Please enter a response message');
    return;
  }
  
  try {
    const response = await fetch(`/reviews/admin/${currentReviewId}/respond`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ message })
    });
    
    const result = await response.json();
    
    if (result.success) {
      alert(result.message);
      window.location.reload();
    } else {
      alert(result.message || 'Error adding response');
    }
  } catch (error) {
    console.error('Add response error:', error);
    alert('Error adding response');
  }
  
  // Close modal
  const modal = bootstrap.Modal.getInstance(document.getElementById('responseModal'));
  modal.hide();
}

async function deleteReview(reviewId) {
  if (!confirm('Are you sure you want to delete this review? This action cannot be undone.')) {
    return;
  }
  
  try {
    const response = await fetch(`/reviews/admin/${reviewId}`, {
      method: 'DELETE'
    });
    
    const result = await response.json();
    
    if (result.success) {
      alert(result.message);
      window.location.reload();
    } else {
      alert(result.message || 'Error deleting review');
    }
  } catch (error) {
    console.error('Delete review error:', error);
    alert('Error deleting review');
  }
}

function bulkApprove() {
  const selectedReviews = document.querySelectorAll('.review-checkbox:checked');
  
  if (selectedReviews.length === 0) {
    alert('Please select at least one review');
    return;
  }
  
  if (confirm(`Approve ${selectedReviews.length} selected reviews?`)) {
    // Implement bulk approve functionality
    alert('Bulk approve functionality will be implemented');
  }
}

function bulkReject() {
  const selectedReviews = document.querySelectorAll('.review-checkbox:checked');
  
  if (selectedReviews.length === 0) {
    alert('Please select at least one review');
    return;
  }
  
  if (confirm(`Reject ${selectedReviews.length} selected reviews?`)) {
    // Implement bulk reject functionality
    alert('Bulk reject functionality will be implemented');
  }
}

function exportReviews() {
  const params = new URLSearchParams(window.location.search);
  params.set('export', 'csv');
  window.location.href = '/reviews/admin?' + params.toString();
}

function refreshReviews() {
  window.location.reload();
}
</script>

<style>
.review-item {
  transition: all 0.3s ease;
}

.review-item:hover {
  background-color: rgba(255, 255, 255, 0.05);
}

.review-checkbox {
  transform: scale(1.2);
}
</style>
