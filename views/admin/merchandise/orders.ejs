<!-- Orders Management Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="text-white mb-0">
    <i class="bi bi-bag-check me-2"></i>Order Management
  </h2>
  <div class="d-flex gap-2">
    <button class="btn btn-outline-light" onclick="exportOrders()">
      <i class="bi bi-download me-2"></i>Export Orders
    </button>
    <button class="btn btn-outline-info" onclick="refreshOrders()">
      <i class="bi bi-arrow-clockwise me-2"></i>Refresh
    </button>
  </div>
</div>

<!-- Order Statistics -->
<div class="row g-3 mb-4">
  <% 
    let totalOrders = 0;
    let totalRevenue = 0;
    let pendingOrders = 0;
    let completedOrders = 0;
    
    if (stats && stats.length > 0) {
      stats.forEach(stat => {
        totalOrders += stat.count;
        totalRevenue += stat.totalAmount;
        if (stat._id === 'pending' || stat._id === 'confirmed') pendingOrders += stat.count;
        if (stat._id === 'delivered') completedOrders += stat.count;
      });
    }
  %>
  
  <div class="col-md-3">
    <div class="glass-card-dark p-3 rounded-4 text-center">
      <i class="bi bi-bag display-6 text-primary mb-2"></i>
      <h4 class="text-white mb-1"><%= totalOrders %></h4>
      <small class="text-muted">Total Orders</small>
    </div>
  </div>
  <div class="col-md-3">
    <div class="glass-card-dark p-3 rounded-4 text-center">
      <i class="bi bi-currency-rupee display-6 text-success mb-2"></i>
      <h4 class="text-white mb-1">₹<%= totalRevenue.toLocaleString() %></h4>
      <small class="text-muted">Total Revenue</small>
    </div>
  </div>
  <div class="col-md-3">
    <div class="glass-card-dark p-3 rounded-4 text-center">
      <i class="bi bi-clock display-6 text-warning mb-2"></i>
      <h4 class="text-white mb-1"><%= pendingOrders %></h4>
      <small class="text-muted">Pending Orders</small>
    </div>
  </div>
  <div class="col-md-3">
    <div class="glass-card-dark p-3 rounded-4 text-center">
      <i class="bi bi-check-circle display-6 text-info mb-2"></i>
      <h4 class="text-white mb-1"><%= completedOrders %></h4>
      <small class="text-muted">Completed Orders</small>
    </div>
  </div>
</div>

<!-- Filters and Search -->
<div class="glass-card-dark p-4 rounded-4 mb-4">
  <form method="GET" action="/admin/merchandise/orders" id="filterForm">
    <div class="row g-3 align-items-end">
      <!-- Search -->
      <div class="col-md-3">
        <label class="form-label text-white">Search Orders</label>
        <div class="input-group">
          <input type="text" class="form-control" name="search" 
                 placeholder="Order number, customer name..." value="<%= filters.search || '' %>">
          <button class="btn btn-outline-light" type="submit">
            <i class="bi bi-search"></i>
          </button>
        </div>
      </div>
      
      <!-- Order Status Filter -->
      <div class="col-md-2">
        <label class="form-label text-white">Order Status</label>
        <select class="form-select" name="status" onchange="document.getElementById('filterForm').submit()">
          <option value="all" <%= (!filters.status || filters.status === 'all') ? 'selected' : '' %>>All Status</option>
          <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="confirmed" <%= filters.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
          <option value="processing" <%= filters.status === 'processing' ? 'selected' : '' %>>Processing</option>
          <option value="shipped" <%= filters.status === 'shipped' ? 'selected' : '' %>>Shipped</option>
          <option value="delivered" <%= filters.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
          <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>
      
      <!-- Payment Status Filter -->
      <div class="col-md-2">
        <label class="form-label text-white">Payment Status</label>
        <select class="form-select" name="payment" onchange="document.getElementById('filterForm').submit()">
          <option value="all" <%= (!filters.payment || filters.payment === 'all') ? 'selected' : '' %>>All Payments</option>
          <option value="completed" <%= filters.payment === 'completed' ? 'selected' : '' %>>Completed</option>
          <option value="pending" <%= filters.payment === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="failed" <%= filters.payment === 'failed' ? 'selected' : '' %>>Failed</option>
          <option value="refunded" <%= filters.payment === 'refunded' ? 'selected' : '' %>>Refunded</option>
        </select>
      </div>
      
      <!-- Date Range -->
      <div class="col-md-2">
        <label class="form-label text-white">From Date</label>
        <input type="date" class="form-control" name="fromDate" value="<%= filters.fromDate || '' %>">
      </div>
      
      <div class="col-md-2">
        <label class="form-label text-white">To Date</label>
        <input type="date" class="form-control" name="toDate" value="<%= filters.toDate || '' %>">
      </div>
      
      <!-- Clear Filters -->
      <div class="col-md-1">
        <a href="/admin/merchandise/orders" class="btn btn-outline-secondary w-100">
          <i class="bi bi-x-circle"></i>
        </a>
      </div>
    </div>
  </form>
</div>

<!-- Orders Table -->
<div class="glass-card-dark rounded-4 overflow-hidden">
  <% if (orders.length === 0) { %>
    <div class="p-5 text-center">
      <i class="bi bi-bag-x display-1 text-muted mb-3"></i>
      <h4 class="text-white mb-3">No Orders Found</h4>
      <p class="text-muted mb-4">
        <% if (filters.search || filters.status !== 'all' || filters.payment !== 'all') { %>
          No orders match your current filters. Try adjusting your search criteria.
        <% } else { %>
          No orders have been placed yet.
        <% } %>
      </p>
    </div>
  <% } else { %>
    <!-- Results Info -->
    <div class="p-3 border-bottom border-secondary">
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-white">
          Showing <%= orders.length %> of <%= totalOrders || orders.length %> orders
        </span>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-warning btn-sm" onclick="bulkUpdateStatus()">
            <i class="bi bi-gear me-1"></i>Bulk Update
          </button>
        </div>
      </div>
    </div>
    
    <!-- Table -->
    <div class="table-responsive">
      <table class="table table-dark table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th width="50">
              <input type="checkbox" class="form-check-input" id="selectAll" onchange="toggleSelectAll()">
            </th>
            <th width="120">Order #</th>
            <th>Customer</th>
            <th width="100">Items</th>
            <th width="120">Amount</th>
            <th width="120">Order Status</th>
            <th width="120">Payment</th>
            <th width="120">Date</th>
            <th width="150">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(order => { %>
            <tr>
              <td>
                <input type="checkbox" class="form-check-input order-checkbox" value="<%= order._id %>">
              </td>
              <td>
                <div class="text-white fw-bold">#<%= order.orderNumber %></div>
                <% if (order.trackingNumber) { %>
                  <small class="text-muted">Track: <%= order.trackingNumber %></small>
                <% } %>
              </td>
              <td>
                <div>
                  <h6 class="text-white mb-1"><%= order.user ? order.user.name : 'Unknown Customer' %></h6>
                  <small class="text-muted"><%= order.user ? order.user.email : 'N/A' %></small>
                  <br>
                  <small class="text-muted"><%= order.shippingAddress ? order.shippingAddress.city + ', ' + order.shippingAddress.state : 'N/A' %></small>
                </div>
              </td>
              <td>
                <div class="text-center">
                  <span class="badge bg-info"><%= order.items.length %> items</span>
                  <% if (order.items.length > 0) { %>
                    <br><small class="text-muted"><%= order.items[0].productName %><%= order.items.length > 1 ? ' +' + (order.items.length - 1) + ' more' : '' %></small>
                  <% } %>
                </div>
              </td>
              <td>
                <div class="text-white fw-bold">₹<%= order.totalAmount %></div>
                <% if (order.discountAmount > 0) { %>
                  <small class="text-success">-₹<%= order.discountAmount %></small>
                <% } %>
              </td>
              <td>
                <% 
                  let statusClass = 'bg-secondary';
                  switch(order.orderStatus) {
                    case 'confirmed':
                      statusClass = 'bg-info';
                      break;
                    case 'processing':
                      statusClass = 'bg-warning';
                      break;
                    case 'shipped':
                      statusClass = 'bg-primary';
                      break;
                    case 'delivered':
                      statusClass = 'bg-success';
                      break;
                    case 'cancelled':
                      statusClass = 'bg-danger';
                      break;
                  }
                %>
                <span class="badge <%= statusClass %>">
                  <%= order.orderStatus.charAt(0).toUpperCase() + order.orderStatus.slice(1) %>
                </span>
              </td>
              <td>
                <% 
                  let paymentClass = 'bg-secondary';
                  switch(order.paymentStatus) {
                    case 'completed':
                      paymentClass = 'bg-success';
                      break;
                    case 'failed':
                      paymentClass = 'bg-danger';
                      break;
                    case 'refunded':
                      paymentClass = 'bg-warning';
                      break;
                  }
                %>
                <span class="badge <%= paymentClass %>">
                  <%= order.paymentStatus.charAt(0).toUpperCase() + order.paymentStatus.slice(1) %>
                </span>
              </td>
              <td>
                <small class="text-white">
                  <%= new Date(order.createdAt).toLocaleDateString('en-IN', { 
                    year: 'numeric', 
                    month: 'short', 
                    day: 'numeric'
                  }) %>
                </small>
                <br>
                <small class="text-muted">
                  <%= new Date(order.createdAt).toLocaleTimeString('en-IN', { 
                    hour: '2-digit', 
                    minute: '2-digit'
                  }) %>
                </small>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <a href="/admin/merchandise/orders/<%= order._id %>" 
                     class="btn btn-outline-info btn-sm" title="View Details">
                    <i class="bi bi-eye"></i>
                  </a>
                  <a href="/admin/merchandise/orders/<%= order._id %>"
                     class="btn btn-outline-warning btn-sm"
                     title="Edit Order Details">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <button class="btn btn-outline-secondary btn-sm" 
                          onclick="printOrder('<%= order._id %>')" 
                          title="Print Order">
                    <i class="bi bi-printer"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    
    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="p-3 border-top border-secondary">
        <nav aria-label="Orders pagination">
          <ul class="pagination justify-content-center mb-0">
            <% if (currentPage > 1) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage - 1 %>&<%= new URLSearchParams(filters).toString() %>">
                  <i class="bi bi-chevron-left"></i>
                </a>
              </li>
            <% } %>
            
            <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
              <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>&<%= new URLSearchParams(filters).toString() %>"><%= i %></a>
              </li>
            <% } %>
            
            <% if (currentPage < totalPages) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage + 1 %>&<%= new URLSearchParams(filters).toString() %>">
                  <i class="bi bi-chevron-right"></i>
                </a>
              </li>
            <% } %>
          </ul>
        </nav>
      </div>
    <% } %>
  <% } %>
</div>

<!-- Update Order Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Update Order Status</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="updateStatusForm">
          <div class="mb-3">
            <label class="form-label text-white">Order Status</label>
            <select class="form-select" id="orderStatus" required>
              <option value="pending">Pending</option>
              <option value="confirmed">Confirmed</option>
              <option value="processing">Processing</option>
              <option value="shipped">Shipped</option>
              <option value="delivered">Delivered</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Tracking Number (Optional)</label>
            <input type="text" class="form-control" id="trackingNumber" 
                   placeholder="Enter tracking number">
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Notes (Optional)</label>
            <textarea class="form-control" id="statusNotes" rows="3" 
                      placeholder="Add any notes about this status update"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="confirmStatusUpdate()">Update Status</button>
      </div>
    </div>
  </div>
</div>

<script>
let currentOrderId = null;

function toggleSelectAll() {
  const selectAll = document.getElementById('selectAll');
  const checkboxes = document.querySelectorAll('.order-checkbox');
  
  checkboxes.forEach(checkbox => {
    checkbox.checked = selectAll.checked;
  });
}

function updateOrderStatus(orderId) {
  currentOrderId = orderId;
  const modal = new bootstrap.Modal(document.getElementById('updateStatusModal'));
  modal.show();
}

async function confirmStatusUpdate() {
  if (!currentOrderId) return;
  
  const status = document.getElementById('orderStatus').value;
  const trackingNumber = document.getElementById('trackingNumber').value;
  const notes = document.getElementById('statusNotes').value;
  
  try {
    const response = await fetch(`/admin/merchandise/orders/${currentOrderId}/status`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        status,
        trackingNumber,
        notes
      })
    });
    
    const result = await response.json();
    
    if (result.success) {
      alert('Order status updated successfully');
      window.location.reload();
    } else {
      alert(result.message || 'Error updating order status');
    }
  } catch (error) {
    console.error('Update status error:', error);
    alert('Error updating order status');
  }
  
  // Close modal
  const modal = bootstrap.Modal.getInstance(document.getElementById('updateStatusModal'));
  modal.hide();
}

function bulkUpdateStatus() {
  const selectedOrders = document.querySelectorAll('.order-checkbox:checked');
  
  if (selectedOrders.length === 0) {
    alert('Please select at least one order');
    return;
  }
  
  // Show bulk update modal (implement as needed)
  alert('Bulk update functionality will be implemented');
}

function printOrder(orderId) {
  window.open(`/admin/merchandise/orders/${orderId}/print`, '_blank');
}

function exportOrders() {
  const params = new URLSearchParams(window.location.search);
  params.set('export', 'csv');
  window.location.href = '/admin/merchandise/orders?' + params.toString();
}

function refreshOrders() {
  window.location.reload();
}

// Auto-refresh every 30 seconds for pending orders
setInterval(() => {
  const url = new URL(window.location);
  if (url.searchParams.get('status') === 'pending' || !url.searchParams.get('status')) {
    // Only refresh if we're viewing pending orders or all orders
    const currentTime = new Date().getTime();
    const lastRefresh = localStorage.getItem('lastOrderRefresh');
    
    if (!lastRefresh || currentTime - parseInt(lastRefresh) > 30000) {
      localStorage.setItem('lastOrderRefresh', currentTime.toString());
      // Silently refresh data without full page reload
      fetch(window.location.href)
        .then(response => response.text())
        .then(html => {
          // Update only the orders table content
          const parser = new DOMParser();
          const newDoc = parser.parseFromString(html, 'text/html');
          const newTable = newDoc.querySelector('.table-responsive');
          const currentTable = document.querySelector('.table-responsive');
          if (newTable && currentTable) {
            currentTable.innerHTML = newTable.innerHTML;
          }
        })
        .catch(error => console.log('Auto-refresh failed:', error));
    }
  }
}, 30000);
</script>
