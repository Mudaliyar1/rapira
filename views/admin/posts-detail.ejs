<!-- Admin Post Detail -->
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h3 class="fw-bold mb-1">Post Details</h3>
      <p class="text-muted mb-0">Review and moderate this post</p>
    </div>
    <a class="btn btn-outline-secondary" href="/admin/posts">Back to Posts</a>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card">
        <div class="card-body">
          <% if (media.mediaType === 'image') { %>
            <img src="<%= media.url %>" class="img-fluid rounded" alt="post media">
          <% } else { %>
            <video controls class="w-100 rounded" style="max-height: 520px;"><source src="<%= media.url %>"></video>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="fw-bold mb-3"><i class="bi bi-person"></i> Artist</h5>
          <p class="mb-1"><strong>Name:</strong> <%= (post.artist && post.artist.user && post.artist.user.name) || (post.artist && post.artist.stageName) || 'Unknown' %></p>
          <p class="mb-1"><strong>Post ID:</strong> <%= post._id %></p>
          <p class="mb-1"><strong>Created:</strong> <%= new Date(post.createdAt).toLocaleString() %></p>
          <p class="mb-0"><strong>Status:</strong>
            <% if (post.isApproved) { %>
              <span class="badge bg-success">Approved</span>
            <% } else if (post.rejectionReason) { %>
              <span class="badge bg-danger">Rejected</span>
            <% } else { %>
              <span class="badge bg-warning text-dark">Pending</span>
            <% } %>
            <% if (!post.isActive) { %>
              <span class="badge bg-secondary ms-2">Inactive</span>
            <% } %>
          </p>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <h5 class="fw-bold mb-3"><i class="bi bi-chat-square-text"></i> Caption</h5>
          <p class="mb-2"><%= post.caption || '(no caption)' %></p>
          <% if (post.hashtags && post.hashtags.length) { %>
            <p class="text-muted small mb-0">Hashtags: <%= post.hashtags.map(t => '#' + t).join(' ') %></p>
          <% } %>
        </div>
      </div>

      <% if (post.rejectionReason) { %>
        <div class="card mb-3 border-danger">
          <div class="card-body">
            <h6 class="text-danger fw-bold mb-2"><i class="bi bi-x-octagon"></i> Rejection Reason</h6>
            <p class="mb-0 text-danger"><%= post.rejectionReason %></p>
          </div>
        </div>
      <% } %>

      <div class="card mb-3">
        <div class="card-body">
          <div class="d-flex flex-wrap gap-3 align-items-center">
            <div><i class="bi bi-heart-fill text-danger"></i> <strong><%= post.likesCount || 0 %></strong> likes</div>
            <div><i class="bi bi-share"></i> <strong><%= post.shares || 0 %></strong> shares</div>
            <div><i class="bi bi-eye"></i> <strong><%= post.views || 0 %></strong> views</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-body d-flex flex-wrap gap-2">
          <button class="btn btn-success" onclick="approvePost('<%= post._id %>')"><i class="bi bi-check-circle"></i> Approve</button>
          <button class="btn btn-warning" onclick="rejectPost('<%= post._id %>')"><i class="bi bi-x-circle"></i> Reject</button>
          <button class="btn btn-secondary" onclick="deactivatePost('<%= post._id %>')"><i class="bi bi-lock"></i> Restrict</button>
          <button class="btn btn-danger" onclick="deletePost('<%= post._id %>')"><i class="bi bi-trash"></i> Delete</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function showAlert(message, type = 'info') {
  const alertId = `alert-${Date.now()}`;
  const html = `
    <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show position-fixed" style="top: 20px; right: 20px; z-index: 2000;">
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>`;
  document.body.insertAdjacentHTML('beforeend', html);
  setTimeout(() => { const el = document.getElementById(alertId); if (el) el.remove(); }, 4500);
}

async function approvePost(id) {
  if (!confirm('Approve this post?')) return;
  await handleAction(`/admin/posts/${id}/approve`, 'PUT', { isApproved: true }, 'Post approved');
}

async function rejectPost(id) {
  const reason = prompt('Enter rejection reason:');
  if (reason === null) return;
  await handleAction(`/admin/posts/${id}/approve`, 'PUT', { isApproved: false, rejectionReason: reason }, 'Post rejected');
}

async function deactivatePost(id) {
  const reason = prompt('Reason for restricting:', 'Policy violation');
  if (reason === null) return;
  await handleAction(`/admin/posts/${id}/deactivate`, 'PUT', { reason }, 'Post restricted');
}

async function deletePost(id) {
  if (!confirm('Delete this post? This cannot be undone.')) return;
  await handleAction(`/admin/posts/${id}`, 'DELETE', null, 'Post deleted');
}

async function handleAction(url, method, body, successMsg) {
  try {
    const res = await fetch(url, {
      method,
      headers: body ? { 'Content-Type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined
    });
    const data = await res.json();
    if (res.ok && data.success) {
      showAlert(successMsg, 'success');
      setTimeout(() => window.location.href = '/admin/posts', 600);
    } else {
      showAlert(data.message || 'Action failed', 'danger');
    }
  } catch (err) {
    console.error(err);
    showAlert('Unexpected error', 'danger');
  }
}
</script>
