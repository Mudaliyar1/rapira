<%- contentFor('title') %>Find My Artist Management

<%- contentFor('body') %>

<div class="container-fluid px-4">
  <ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
    <li class="breadcrumb-item active">Find My Artist Management</li>
  </ol>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-xl-3 col-md-6">
      <div class="card bg-primary text-white mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-0"><%= stats.featuredArtistsCount %></h5>
              <div>Featured Artists</div>
            </div>
            <div>
              <i class="fas fa-user-music fa-2x"></i>
            </div>
          </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between">
          <a class="small text-white stretched-link" href="/admin/find-my-artist/featured-artists">View Details</a>
          <div class="small text-white"><i class="fas fa-angle-right"></i></div>
        </div>
      </div>
    </div>
    <div class="col-xl-3 col-md-6">
      <div class="card bg-success text-white mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-0"><%= stats.roleSlotsCount %></h5>
              <div>Role Slots</div>
            </div>
            <div>
              <i class="fas fa-briefcase fa-2x"></i>
            </div>
          </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between">
          <a class="small text-white stretched-link" href="/admin/find-my-artist/role-slots">View Details</a>
          <div class="small text-white"><i class="fas fa-angle-right"></i></div>
        </div>
      </div>
    </div>
    <div class="col-xl-3 col-md-6">
      <div class="card bg-warning text-white mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-0"><%= stats.pendingRequestsCount %></h5>
              <div>Pending Requests</div>
            </div>
            <div>
              <i class="fas fa-clock fa-2x"></i>
            </div>
          </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between">
          <a class="small text-white stretched-link" href="/admin/find-my-artist/booking-requests?status=pending">View Details</a>
          <div class="small text-white"><i class="fas fa-angle-right"></i></div>
        </div>
      </div>
    </div>
    <div class="col-xl-3 col-md-6">
      <div class="card bg-info text-white mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-0"><%= stats.totalRequestsCount %></h5>
              <div>Total Requests</div>
            </div>
            <div>
              <i class="fas fa-list fa-2x"></i>
            </div>
          </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between">
          <a class="small text-white stretched-link" href="/admin/find-my-artist/booking-requests">View Details</a>
          <div class="small text-white"><i class="fas fa-angle-right"></i></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <i class="fas fa-link me-1"></i>
          Quick Links
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-4 mb-3">
              <a href="/admin/find-my-artist/featured-artists" class="btn btn-primary w-100">
                <i class="fas fa-user-music me-1"></i> Manage Featured Artists
              </a>
            </div>
            <div class="col-md-4 mb-3">
              <a href="/admin/find-my-artist/role-slots" class="btn btn-success w-100">
                <i class="fas fa-briefcase me-1"></i> Manage Role Slots
              </a>
            </div>
            <div class="col-md-4 mb-3">
              <a href="/admin/find-my-artist/booking-requests" class="btn btn-info w-100">
                <i class="fas fa-calendar-check me-1"></i> View Booking Requests
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Booking Requests -->
  <div class="card mb-4">
    <div class="card-header">
      <i class="fas fa-calendar-check me-1"></i>
      Recent Booking Requests
    </div>
    <div class="card-body">
      <% if (recentRequests.length === 0) { %>
        <div class="alert alert-info">
          No booking requests found.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Booking</th>
                <th>Event Date</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% recentRequests.forEach(request => { %>
                <tr>
                  <td><%= request.name %></td>
                  <td>
                    <% if (request.bookingType === 'artist') { %>
                      <span class="badge bg-primary">Artist</span>
                    <% } else { %>
                      <span class="badge bg-success">Role</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (request.bookingType === 'artist' && request.artist) { %>
                      <%= request.artist.stageName || (request.artist.user ? request.artist.user.name : 'Unknown') %>
                    <% } else if (request.bookingType === 'role' && request.roleSlot) { %>
                      <%= request.roleSlot.name %>
                    <% } else { %>
                      Unknown
                    <% } %>
                  </td>
                  <td><%= toISTDateString(request.eventDate) %></td>
                  <td>
                    <% if (request.status === 'pending') { %>
                      <span class="badge bg-warning text-dark">Pending</span>
                    <% } else if (request.status === 'approved') { %>
                      <span class="badge bg-success">Approved</span>
                    <% } else if (request.status === 'rejected') { %>
                      <span class="badge bg-danger">Rejected</span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/admin/find-my-artist/booking-requests/<%= request._id %>" class="btn btn-sm btn-primary">
                      <i class="fas fa-eye"></i> View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="text-end mt-3">
          <a href="/admin/find-my-artist/booking-requests" class="btn btn-outline-primary">
            View All Requests <i class="fas fa-arrow-right ms-1"></i>
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Public Page Preview -->
  <div class="card mb-4">
    <div class="card-header">
      <i class="fas fa-globe me-1"></i>
      Public Page
    </div>
    <div class="card-body">
      <p>View the public "Find My Artist" page to see how it appears to visitors:</p>
      <a href="/find-my-artist" target="_blank" class="btn btn-primary">
        <i class="fas fa-external-link-alt me-1"></i> Open Find My Artist Page
      </a>
    </div>
  </div>
</div>
