<%- contentFor('title') %>Manage Role Slots

<%- contentFor('body') %>

<div class="container-fluid px-4">
  <ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="/admin/find-my-artist">Find My Artist Management</a></li>
    <li class="breadcrumb-item active">Role Slots</li>
  </ol>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <div>
        <i class="fas fa-briefcase me-1"></i>
        Manage Role Slots
      </div>
      <a href="/admin/find-my-artist/role-slots/new" class="btn btn-primary btn-sm">
        <i class="fas fa-plus"></i> Add New Role Slot
      </a>
    </div>
    <div class="card-body">
      <% if (roleSlots.length === 0) { %>
        <div class="alert alert-info" style="color: #000000 !important; background-color: #cff4fc !important; border: 1px solid #b6effb !important; font-weight: 500 !important;">
          <span style="color: #000000 !important;">No role slots found. Click the "Add New Role Slot" button to create your first role slot.</span>
        </div>
      <% } else { %>
        <p class="mb-3">Drag and drop to reorder role slots. Changes will be saved automatically.</p>
        <div class="table-responsive">
          <table class="table table-bordered table-hover" id="roleSlotsTable" width="100%" cellspacing="0">
            <thead>
              <tr>
                <th width="50px">#</th>
                <th>Name</th>
                <th>Description</th>
                <th>Location</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="roleSlotsTableBody">
              <% roleSlots.forEach((role, index) => { %>
                <tr data-id="<%= role._id %>" class="sortable-row">
                  <td class="text-center">
                    <i class="fas fa-grip-vertical handle" style="cursor: move;"></i>
                  </td>
                  <td><%= role.name %></td>
                  <td><%= role.description.length > 50 ? role.description.substring(0, 50) + '...' : role.description %></td>
                  <td><%= role.city %>, <%= role.state %></td>
                  <td>
                    <% if (role.isActive) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-danger">Inactive</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/admin/find-my-artist/role-slots/<%= role._id %>/edit" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i> Edit
                      </a>
                      <form action="/admin/find-my-artist/role-slots/<%= role._id %>/delete" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this role slot?')">
                          <i class="fas fa-trash-alt"></i> Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Help Card -->
  <div class="card mb-4">
    <div class="card-header">
      <i class="fas fa-info-circle me-1"></i>
      Help
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <h5>About Role Slots</h5>
          <p>Role slots are positions that can be booked by event companies and venue owners through the "Find My Artist" page.</p>
          <p>These roles will be displayed on the public page where visitors can submit booking requests.</p>
        </div>
        <div class="col-md-6">
          <h5>Guidelines</h5>
          <ul>
            <li>Provide clear and descriptive role names</li>
            <li>Include detailed information about the role in the description</li>
            <li>Specify the location accurately</li>
            <li>Set inactive roles that are temporarily unavailable</li>
            <li>Drag and drop to change the display order</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<%- contentFor('extraScripts') %>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.14.0/Sortable.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize sortable table
    const roleSlotsTableBody = document.getElementById('roleSlotsTableBody');

    if (roleSlotsTableBody) {
      const sortable = new Sortable(roleSlotsTableBody, {
        handle: '.handle',
        animation: 150,
        onEnd: function() {
          // Get the new order
          const rows = roleSlotsTableBody.querySelectorAll('tr.sortable-row');
          const orders = [];

          rows.forEach((row, index) => {
            orders.push({
              id: row.getAttribute('data-id'),
              order: index + 1
            });
          });

          // Send the new order to the server
          fetch('/admin/find-my-artist/role-slots/update-order', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ orders })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              console.log('Order updated successfully');
            } else {
              console.error('Failed to update order:', data.message);
            }
          })
          .catch(error => {
            console.error('Error updating order:', error);
          });
        }
      });
    }
  });
</script>
