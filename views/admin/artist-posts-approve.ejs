<!-- Approve Post -->
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Approve Post</h3>
    <a class="btn btn-outline-secondary" href="/admin/posts">Back</a>
  </div>

  <div class="card mb-3">
    <div class="card-body d-flex gap-3 align-items-center">
      <div style="width:120px;height:120px;overflow:hidden;border-radius:8px;background:#0f0f0f;border:1px solid rgba(255,255,255,0.08);">
        <% if (media.mediaType==='image') { %>
          <img src="<%= media.url %>" style="width:120px;height:120px;object-fit:cover;display:block;">
        <% } else { %>
          <video muted style="width:120px;height:120px;object-fit:cover;display:block;"><source src="<%= media.url %>"></video>
        <% } %>
      </div>
      <div>
        <div class="mb-1"><strong>Artist:</strong> <%= artistName %></div>
        <div class="mb-1"><strong>Caption:</strong> <%= post.caption || '(no caption)' %></div>
        <div class="text-muted"><small>Created: <%= toISTLocaleString(post.createdAt) %></small></div>
      </div>
    </div>
  </div>

  <form method="post" action="/admin/artist-posts/<%= post._id %>/approve-do">
    <input type="hidden" name="isApproved" value="true">
    <div class="alert alert-info">Are you sure you want to approve this post?</div>
    <button class="btn btn-success"><i class="bi bi-check-circle"></i> Approve</button>
  </form>
</div>