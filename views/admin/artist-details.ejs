<%- contentFor('body') %>

<div class="row mb-4">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <div>
      <h2 class="h3 text-white mb-0">Artist Details: <%= artist.stageName %></h2>
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/admin/artists">Manage Artists</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page"><%= artist.stageName %></li>
      </ol>
    </div>
    <a href="/admin/artists" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Back to Artists
    </a>
  </div>
</div>

<div class="row">
  <div class="col-md-4">
    <!-- Artist Info Card -->
    <div class="glass-card-dark border border-secondary mb-4">
      <div class="card-body text-center">
        <% if (artist.user && artist.user.profileImage) { %>
          <img src="<%= artist.user.profileImage %>" alt="Profile" class="rounded-circle mb-3" width="120" height="120" style="object-fit: cover; border: 3px solid rgba(255, 255, 255, 0.1);">
        <% } else { %>
          <div class="bg-dark rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 120px; height: 120px; border: 3px solid rgba(255, 255, 255, 0.1);">
            <i class="bi bi-person text-secondary display-4"></i>
          </div>
        <% } %>
        <h4 class="text-white mb-1"><%= artist.stageName %></h4>
        <p class="text-primary mb-3"><%= artist.genre %></p>
        
        <div class="d-flex justify-content-center gap-2 mb-4">
          <span class="badge <%= artist.verified ? 'bg-success' : 'bg-warning' %>">
            <%= artist.verified ? 'Verified' : 'Unverified' %>
          </span>
          <span class="badge <%= artist.featuredArtist ? 'bg-primary' : 'bg-secondary' %>">
            <%= artist.featuredArtist ? 'Featured' : 'Not Featured' %>
          </span>
          <% if (artist.isBlocked) { %>
            <span class="badge bg-danger">Blocked</span>
          <% } %>
        </div>

        <ul class="list-group list-group-flush text-start bg-transparent">
          <li class="list-group-item bg-transparent text-white border-secondary px-0">
            <strong>Real Name:</strong> <span class="float-end"><%= artist.user ? artist.user.name : 'N/A' %></span>
          </li>
          <li class="list-group-item bg-transparent text-white border-secondary px-0">
            <strong>Email:</strong> <span class="float-end"><%= artist.user ? artist.user.email : 'N/A' %></span>
          </li>
          <li class="list-group-item bg-transparent text-white border-secondary px-0">
            <strong>Phone:</strong> <span class="float-end"><%= artist.phoneNumber || (artist.user && artist.user.phone) || 'N/A' %></span>
          </li>
          <li class="list-group-item bg-transparent text-white border-secondary px-0">
            <strong>Location:</strong> <span class="float-end"><%= artist.city %>, <%= artist.state %></span>
          </li>
          <li class="list-group-item bg-transparent text-white border-secondary px-0">
            <strong>Level:</strong> <span class="float-end"><%= artist.artistLevel %></span>
          </li>
          <li class="list-group-item bg-transparent text-white border-secondary px-0">
            <strong>Join Date:</strong> <span class="float-end"><%= new Date(artist.createdAt).toLocaleDateString() %></span>
          </li>
        </ul>
      </div>
    </div>

    <!-- ID Proof Card -->
    <div class="glass-card-dark border border-secondary mb-4">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">ID Proof</h5>
      </div>
      <div class="card-body">
        <% if (application && application.proofPhoto) { %>
           <img src="<%= application.proofPhoto %>" alt="ID Proof" class="img-fluid rounded border border-secondary mb-2 bg-white" style="max-height: 250px; object-fit: contain;" />
           <p class="text-center"><a href="<%= application.proofPhoto %>" target="_blank" class="btn btn-sm btn-outline-info">View Full ID Proof</a></p>
        <% } else if (artist.proofPhoto) { %>
           <img src="<%= artist.proofPhoto %>" alt="Proof Photo" class="img-fluid rounded border border-secondary mb-2 bg-white" style="max-height: 250px; object-fit: contain;" />
           <p class="text-center"><a href="<%= artist.proofPhoto %>" target="_blank" class="btn btn-sm btn-outline-info">View Proof Photo</a></p>
        <% } else if (artist.aadharCard) { %>
           <div class="alert alert-info text-center">
             Aadhar Document No: <%= artist.aadharCard %>
           </div>
        <% } else { %>
           <p class="text-muted text-center mb-0">No ID proof image provided during application or registration.</p>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-md-8">
    <!-- Stats Row -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6">
        <div class="glass-card-dark border border-secondary h-100">
          <div class="card-body">
            <h6 class="text-white-50 mb-2">Total Concerts Created</h6>
            <h2 class="text-primary mb-0"><%= concerts.length %></h2>
          </div>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="glass-card-dark border border-secondary h-100">
          <div class="card-body">
            <h6 class="text-white-50 mb-2">Total Estimated Ticket Revenue</h6>
            <h2 class="text-success mb-0">₹<%= totalRevenue.toLocaleString() %></h2>
          </div>
        </div>
      </div>
    </div>

    <!-- Concerts History -->
    <div class="glass-card-dark border border-secondary mb-4">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">Concerts History</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 text-white">
            <thead>
              <tr>
                <th class="ps-3 border-secondary">Title</th>
                <th class="border-secondary">Date</th>
                <th class="border-secondary">City</th>
                <th class="border-secondary">Status</th>
                <th class="pe-3 border-secondary text-end">Price</th>
              </tr>
            </thead>
            <tbody>
              <% if (concerts && concerts.length > 0) { %>
                <% concerts.forEach(concert => { %>
                  <tr>
                    <td class="ps-3 border-secondary"><%= concert.title %></td>
                    <td class="border-secondary"><%= new Date(concert.date).toLocaleDateString() %></td>
                    <td class="border-secondary"><%= concert.city %></td>
                    <td class="border-secondary">
                      <% if (concert.status === 'upcoming' || concert.status === 'approved') { %>
                        <span class="badge bg-success">Approved / Upcoming</span>
                      <% } else if (concert.status === 'pending') { %>
                        <span class="badge bg-warning">Pending</span>
                      <% } else if (concert.status === 'rejected' || concert.status === 'cancelled') { %>
                        <span class="badge bg-danger"><%= concert.status %></span>
                      <% } else { %>
                        <span class="badge bg-secondary"><%= concert.status %></span>
                      <% } %>
                    </td>
                    <td class="pe-3 border-secondary text-end">
                      ₹<%= concert.price %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted border-secondary">No concerts found for this artist.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- History / Blocks -->
    <div class="glass-card-dark border border-secondary">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">Account History & Moderation</h5>
      </div>
      <div class="card-body">
        <% if (artist.blockHistory && artist.blockHistory.length > 0) { %>
          <div class="timeline text-white">
            <% artist.blockHistory.forEach(block => { %>
              <div class="mb-3 border-bottom border-secondary pb-2">
                <strong><i class="bi bi-shield-slash text-danger"></i> Blocked</strong> on <%= new Date(block.blockedAt).toLocaleDateString() %>
                <p class="text-muted small mb-1">Reason: <%= block.blockReason %></p>
                <% if (block.unblockedAt) { %>
                  <strong><i class="bi bi-shield-check text-success"></i> Unblocked</strong> on <%= new Date(block.unblockedAt).toLocaleDateString() %>
                <% } else { %>
                  <span class="badge bg-danger">Currently Blocked</span>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted mb-0">No block history or infractions recorded.</p>
        <% } %>
      </div>
    </div>

  </div>
</div>

<%- contentFor('title') %>View Artist Details
