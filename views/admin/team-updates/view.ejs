<%- contentFor('body') %>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <a href="/admin/team-updates" class="btn btn-outline-secondary mb-2">
      <i class="bi bi-arrow-left me-1"></i> Back to Updates
    </a>
    <div class="d-flex align-items-center gap-3">
      <% if (update.isPinned) { %>
        <i class="bi bi-pin-fill text-warning fs-4"></i>
      <% } %>
      <h1 class="fw-bold mb-0 text-white"><%= update.title %></h1>
    </div>
  </div>
  <div class="d-flex gap-2 align-items-center">
    <!-- Action Buttons -->
    <div class="dropdown me-3">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-three-dots"></i> Actions
      </button>
      <ul class="dropdown-menu bg-dark border-secondary">
        <li>
          <a class="dropdown-item text-white" href="/admin/team-updates/<%= update._id %>/edit">
            <i class="bi bi-pencil me-2"></i> Edit Update
          </a>
        </li>
        <li>
          <button class="dropdown-item text-white" onclick="togglePin('<%= update._id %>', <%= update.isPinned %>)">
            <i class="bi bi-pin me-2"></i> <%= update.isPinned ? 'Unpin' : 'Pin' %> Update
          </button>
        </li>
        <li><hr class="dropdown-divider border-secondary"></li>
        <li>
          <a class="dropdown-item text-danger" href="/admin/team-updates/<%= update._id %>/delete">
            <i class="bi bi-trash me-2"></i> Delete Update
          </a>
        </li>
      </ul>
    </div>

    <!-- Priority Badge -->
    <%
      let priorityClass = 'bg-secondary';
      if (update.priority === 'urgent') priorityClass = 'bg-danger';
      else if (update.priority === 'high') priorityClass = 'bg-warning';
      else if (update.priority === 'normal') priorityClass = 'bg-primary';
    %>
    <span class="badge <%= priorityClass %> fs-6"><%= update.priority.toUpperCase() %></span>

    <!-- Type Badge -->
    <span class="badge bg-info fs-6"><%= update.type.replace('_', ' ').toUpperCase() %></span>
  </div>
</div>

<!-- Main Content -->
<div class="row">
  <!-- Left Column - Content -->
  <div class="col-lg-8">
    <!-- Update Content -->
    <div class="glass-card-dark border border-secondary mb-4">
      <div class="card-header border-bottom border-secondary">
        <div class="d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <img src="<%= update.createdBy.profileImage || '/images/default-profile.svg' %>" 
                 alt="<%= update.createdBy.name %>" 
                 class="rounded-circle me-3" 
                 width="40" height="40"
                 style="object-fit: cover;">
            <div>
              <h6 class="mb-0 text-white"><%= update.createdBy.name %></h6>
              <small class="text-white-50">
                <%= new Date(update.createdAt).toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                }) %>
              </small>
            </div>
          </div>
          <div class="d-flex align-items-center gap-3 text-white-50">
            <span><i class="bi bi-eye me-1"></i><%= update.views.length %></span>
            <span><i class="bi bi-heart me-1"></i><%= update.reactions.length %></span>
          </div>
        </div>
      </div>
      <div class="card-body">
        <!-- Content -->
        <div class="mb-4">
          <div class="text-white" style="white-space: pre-wrap; line-height: 1.6;">
            <%= update.content %>
          </div>
        </div>

        <!-- Tags -->
        <% if (update.tags && update.tags.length > 0) { %>
          <div class="mb-4">
            <% update.tags.forEach(tag => { %>
              <span class="badge bg-dark border border-secondary me-2">#<%= tag %></span>
            <% }) %>
          </div>
        <% } %>

        <!-- Attachments -->
        <% if (update.attachments && update.attachments.length > 0) { %>
          <div class="mb-4">
            <h6 class="text-white mb-3">Attachments</h6>
            <div class="row g-3">
              <% update.attachments.forEach(attachment => { %>
                <div class="col-md-6">
                  <div class="attachment-card glass-card-dark border border-secondary p-3">
                    <div class="d-flex align-items-center">
                      <i class="bi bi-file-earmark text-primary me-3 fs-4"></i>
                      <div class="flex-grow-1">
                        <h6 class="mb-1 text-white"><%= attachment.originalName %></h6>
                        <small class="text-white-50">
                          <%= (attachment.size / 1024 / 1024).toFixed(2) %> MB
                        </small>
                      </div>
                      <a href="<%= attachment.path %>" class="btn btn-outline-primary btn-sm" download>
                        <i class="bi bi-download"></i>
                      </a>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Reactions -->
        <div class="d-flex align-items-center gap-3 mb-4">
          <span class="text-white-50">React:</span>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-outline-primary btn-sm reaction-btn" data-reaction="like">
              <i class="bi bi-hand-thumbs-up me-1"></i> Like
            </button>
            <button type="button" class="btn btn-outline-success btn-sm reaction-btn" data-reaction="helpful">
              <i class="bi bi-lightbulb me-1"></i> Helpful
            </button>
            <button type="button" class="btn btn-outline-warning btn-sm reaction-btn" data-reaction="important">
              <i class="bi bi-exclamation-circle me-1"></i> Important
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Meeting Details -->
    <% if (update.type === 'meeting_minutes' && (update.meetingDate || update.meetingAttendees.length > 0)) { %>
      <div class="glass-card-dark border border-secondary mb-4">
        <div class="card-header border-bottom border-secondary">
          <h6 class="card-title mb-0 text-white">Meeting Details</h6>
        </div>
        <div class="card-body">
          <% if (update.meetingDate) { %>
            <div class="mb-3">
              <strong class="text-white">Date:</strong>
              <span class="text-white-50 ms-2">
                <%= new Date(update.meetingDate).toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                }) %>
              </span>
            </div>
          <% } %>
          
          <% if (update.meetingAttendees.length > 0) { %>
            <div>
              <strong class="text-white">Attendees:</strong>
              <div class="mt-2">
                <% update.meetingAttendees.forEach(attendee => { %>
                  <div class="d-flex align-items-center mb-2">
                    <img src="<%= attendee.profileImage || '/images/default-profile.svg' %>" 
                         alt="<%= attendee.name %>" 
                         class="rounded-circle me-2" 
                         width="24" height="24"
                         style="object-fit: cover;">
                    <span class="text-white-50"><%= attendee.name %></span>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Action Items -->
    <% if (update.actionItems && update.actionItems.length > 0) { %>
      <div class="glass-card-dark border border-secondary mb-4">
        <div class="card-header border-bottom border-secondary">
          <h6 class="card-title mb-0 text-white">Action Items</h6>
        </div>
        <div class="card-body">
          <% update.actionItems.forEach((item, index) => { %>
            <div class="action-item d-flex align-items-center justify-content-between p-3 mb-3 glass-card-dark border border-secondary rounded">
              <div class="flex-grow-1">
                <div class="d-flex align-items-center mb-2">
                  <span class="badge bg-secondary me-2">#<%= index + 1 %></span>
                  <span class="text-white"><%= item.task %></span>
                </div>
                <div class="d-flex align-items-center gap-3 text-white-50 small">
                  <% if (item.assignedTo) { %>
                    <span>
                      <i class="bi bi-person me-1"></i>
                      <%= item.assignedTo.name %>
                    </span>
                  <% } %>
                  <% if (item.dueDate) { %>
                    <span>
                      <i class="bi bi-calendar me-1"></i>
                      <%= new Date(item.dueDate).toLocaleDateString() %>
                    </span>
                  <% } %>
                </div>
              </div>
              <div class="d-flex align-items-center gap-2">
                <% 
                  let statusClass = 'bg-secondary';
                  if (item.status === 'completed') statusClass = 'bg-success';
                  else if (item.status === 'in_progress') statusClass = 'bg-warning';
                %>
                <span class="badge <%= statusClass %>"><%= item.status.replace('_', ' ') %></span>
                <div class="dropdown">
                  <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-three-dots"></i>
                  </button>
                  <ul class="dropdown-menu bg-dark border-secondary">
                    <li><a class="dropdown-item text-white update-status" href="#" data-action-id="<%= item._id %>" data-status="pending">Mark Pending</a></li>
                    <li><a class="dropdown-item text-white update-status" href="#" data-action-id="<%= item._id %>" data-status="in_progress">Mark In Progress</a></li>
                    <li><a class="dropdown-item text-white update-status" href="#" data-action-id="<%= item._id %>" data-status="completed">Mark Completed</a></li>
                  </ul>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Comments Section -->
    <% if (update.allowComments) { %>
      <div class="glass-card-dark border border-secondary">
        <div class="card-header border-bottom border-secondary">
          <h6 class="card-title mb-0 text-white">Discussion</h6>
        </div>
        <div class="card-body">
          <!-- Add Comment Form -->
          <form action="/admin/team-updates/<%= update._id %>/comments" method="POST" class="mb-4">
            <div class="d-flex gap-3">
              <img src="<%= currentUser.profileImage || '/images/default-profile.svg' %>" 
                   alt="<%= currentUser.name %>" 
                   class="rounded-circle" 
                   width="40" height="40"
                   style="object-fit: cover;">
              <div class="flex-grow-1">
                <textarea class="form-control bg-dark text-white border-secondary" 
                          name="content" rows="3" 
                          placeholder="Add a comment..." required></textarea>
                <div class="d-flex justify-content-end mt-2">
                  <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-send me-1"></i> Post Comment
                  </button>
                </div>
              </div>
            </div>
          </form>

          <!-- Comments List -->
          <div class="comments-list">
            <% if (comments.length === 0) { %>
              <div class="text-center py-4">
                <i class="bi bi-chat-dots display-4 text-muted"></i>
                <p class="text-white-50 mt-2">No comments yet. Be the first to comment!</p>
              </div>
            <% } else { %>
              <% comments.forEach(comment => { %>
                <div class="comment mb-3 p-3 glass-card-dark border border-secondary rounded">
                  <div class="d-flex gap-3">
                    <img src="<%= comment.author.profileImage || '/images/default-profile.svg' %>" 
                         alt="<%= comment.author.name %>" 
                         class="rounded-circle" 
                         width="36" height="36"
                         style="object-fit: cover;">
                    <div class="flex-grow-1">
                      <div class="d-flex align-items-center gap-2 mb-2">
                        <h6 class="mb-0 text-white"><%= comment.author.name %></h6>
                        <small class="text-white-50">
                          <%= new Date(comment.createdAt).toLocaleDateString() %>
                        </small>
                        <% if (comment.isEdited) { %>
                          <small class="text-warning">(edited)</small>
                        <% } %>
                      </div>
                      <p class="text-white-50 mb-2"><%= comment.content %></p>
                      <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-link btn-sm text-white-50 p-0 comment-reaction" data-comment-id="<%= comment._id %>" data-reaction="like">
                          <i class="bi bi-hand-thumbs-up me-1"></i> Like
                        </button>
                        <button class="btn btn-link btn-sm text-white-50 p-0">
                          <i class="bi bi-reply me-1"></i> Reply
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Right Column - Sidebar -->
  <div class="col-lg-4">
    <!-- Update Info -->
    <div class="glass-card-dark border border-secondary mb-4">
      <div class="card-header border-bottom border-secondary">
        <h6 class="card-title mb-0 text-white">Update Information</h6>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <strong class="text-white">Category:</strong>
          <span class="text-white-50 ms-2"><%= update.category.replace('_', ' ') %></span>
        </div>
        <div class="mb-3">
          <strong class="text-white">Target Audience:</strong>
          <span class="text-white-50 ms-2"><%= update.targetAudience.replace('_', ' ') %></span>
        </div>
        <% if (update.expiresAt) { %>
          <div class="mb-3">
            <strong class="text-white">Expires:</strong>
            <span class="text-white-50 ms-2">
              <%= new Date(update.expiresAt).toLocaleDateString() %>
            </span>
          </div>
        <% } %>
        <% if (update.updatedBy && update.updatedAt !== update.createdAt) { %>
          <div class="mb-3">
            <strong class="text-white">Last Updated:</strong>
            <span class="text-white-50 ms-2">
              <%= new Date(update.updatedAt).toLocaleDateString() %>
            </span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Read Status -->
    <% if (update.views.length > 0) { %>
      <div class="glass-card-dark border border-secondary">
        <div class="card-header border-bottom border-secondary">
          <h6 class="card-title mb-0 text-white">Read By (<%= update.views.length %>)</h6>
        </div>
        <div class="card-body">
          <% update.views.slice(0, 10).forEach(view => { %>
            <div class="d-flex align-items-center mb-2">
              <img src="<%= view.user.profileImage || '/images/default-profile.svg' %>" 
                   alt="<%= view.user.name %>" 
                   class="rounded-circle me-2" 
                   width="24" height="24"
                   style="object-fit: cover;">
              <div class="flex-grow-1">
                <span class="text-white-50 small"><%= view.user.name %></span>
                <br>
                <span class="text-muted" style="font-size: 0.7rem;">
                  <%= new Date(view.viewedAt).toLocaleDateString() %>
                </span>
              </div>
            </div>
          <% }) %>
          <% if (update.views.length > 10) { %>
            <small class="text-white-50">and <%= update.views.length - 10 %> more...</small>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Handle reactions
  document.querySelectorAll('.reaction-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const reaction = this.dataset.reaction;
      
      fetch(`/admin/team-updates/<%= update._id %>/react`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ reactionType: reaction })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Update UI or show success message
          this.classList.add('active');
          setTimeout(() => this.classList.remove('active'), 1000);
        }
      })
      .catch(error => console.error('Error:', error));
    });
  });

  // Handle action item status updates
  document.querySelectorAll('.update-status').forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const actionId = this.dataset.actionId;
      const status = this.dataset.status;

      fetch(`/admin/team-updates/<%= update._id %>/action-items/${actionId}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ status: status })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload(); // Refresh to show updated status
        }
      })
      .catch(error => console.error('Error:', error));
    });
  });
});

// Toggle pin status
function togglePin(updateId, currentPinStatus) {
  fetch(`/admin/team-updates/${updateId}/toggle-pin`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload(); // Refresh to show updated pin status
    } else {
      alert('Failed to toggle pin status');
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Failed to toggle pin status');
  });
}
</script>

<style>
.attachment-card:hover {
  transform: translateY(-2px);
  transition: transform 0.2s ease;
}

.action-item {
  transition: all 0.2s ease;
}

.action-item:hover {
  transform: translateX(5px);
}

.comment {
  transition: all 0.2s ease;
}

.comment:hover {
  transform: translateY(-1px);
}

.reaction-btn.active {
  background-color: var(--bs-primary) !important;
  border-color: var(--bs-primary) !important;
  color: white !important;
}
</style>
