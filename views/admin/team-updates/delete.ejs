<%- contentFor('body') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="glass-card-dark border border-danger">
      <div class="card-header border-bottom border-danger bg-danger bg-opacity-10">
        <div class="d-flex align-items-center">
          <i class="bi bi-exclamation-triangle-fill text-danger me-3 fs-4"></i>
          <h5 class="card-title mb-0 text-white">Delete Team Update</h5>
        </div>
      </div>
      <div class="card-body">
        <div class="alert alert-danger border-danger bg-danger bg-opacity-10" role="alert">
          <h6 class="alert-heading text-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Warning: This action cannot be undone!
          </h6>
          <p class="mb-0 text-white">
            You are about to permanently delete this team update. This will also delete:
          </p>
          <ul class="mt-2 mb-0 text-white">
            <li>All comments and discussions</li>
            <li>All attached files</li>
            <li>All view and reaction data</li>
            <li>All action items and their progress</li>
          </ul>
        </div>

        <!-- Update Preview -->
        <div class="glass-card-dark border border-secondary mb-4">
          <div class="card-header border-bottom border-secondary">
            <h6 class="card-title mb-0 text-white">Update to be deleted:</h6>
          </div>
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div class="d-flex align-items-center">
                <% if (update.isPinned) { %>
                  <i class="bi bi-pin-fill text-warning me-2"></i>
                <% } %>
                <h5 class="mb-0 text-white"><%= update.title %></h5>
              </div>
              <div class="d-flex gap-2">
                <!-- Priority Badge -->
                <% 
                  let priorityClass = 'bg-secondary';
                  if (update.priority === 'urgent') priorityClass = 'bg-danger';
                  else if (update.priority === 'high') priorityClass = 'bg-warning';
                  else if (update.priority === 'normal') priorityClass = 'bg-primary';
                %>
                <span class="badge <%= priorityClass %>"><%= update.priority.toUpperCase() %></span>
                
                <!-- Type Badge -->
                <span class="badge bg-info"><%= update.type.replace('_', ' ').toUpperCase() %></span>
              </div>
            </div>

            <!-- Content Preview -->
            <p class="text-white-50 mb-3">
              <%= update.content.length > 300 ? update.content.substring(0, 300) + '...' : update.content %>
            </p>

            <!-- Meta Information -->
            <div class="row g-3 text-white-50 small">
              <div class="col-md-6">
                <div class="d-flex align-items-center mb-2">
                  <img src="<%= update.createdBy.profileImage || '/images/default-profile.svg' %>" 
                       alt="<%= update.createdBy.name %>" 
                       class="rounded-circle me-2" 
                       width="24" height="24"
                       style="object-fit: cover;">
                  <span>Created by <%= update.createdBy.name %></span>
                </div>
                <div class="mb-2">
                  <i class="bi bi-calendar me-2"></i>
                  <%= toISTDateString(update.createdAt) %>
                </div>
                <div>
                  <i class="bi bi-folder me-2"></i>
                  <%= update.category.replace('_', ' ') %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-2">
                  <i class="bi bi-eye me-2"></i>
                  <%= update.views.length %> views
                </div>
                <div class="mb-2">
                  <i class="bi bi-heart me-2"></i>
                  <%= update.reactions.length %> reactions
                </div>
                <% if (update.attachments && update.attachments.length > 0) { %>
                  <div class="mb-2">
                    <i class="bi bi-paperclip me-2"></i>
                    <%= update.attachments.length %> attachments
                  </div>
                <% } %>
                <% if (update.actionItems && update.actionItems.length > 0) { %>
                  <div>
                    <i class="bi bi-list-check me-2"></i>
                    <%= update.actionItems.length %> action items
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Tags -->
            <% if (update.tags && update.tags.length > 0) { %>
              <div class="mt-3">
                <% update.tags.forEach(tag => { %>
                  <span class="badge bg-dark border border-secondary me-1">#<%= tag %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Confirmation Form -->
        <form action="/admin/team-updates/<%= update._id %>?_method=DELETE" method="POST" id="deleteForm">
          <div class="mb-4">
            <p class="text-white-50">
              <i class="bi bi-info-circle me-2"></i>
              This action will permanently delete this update and all associated data.
            </p>
          </div>

          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex gap-2">
              <a href="/admin/team-updates/<%= update._id %>" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cancel
              </a>
              <a href="/admin/team-updates" class="btn btn-outline-info">
                <i class="bi bi-list me-1"></i> Back to Updates
              </a>
            </div>
            <button type="submit" class="btn btn-danger" id="deleteBtn">
              <i class="bi bi-trash me-1"></i> Delete Permanently
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const deleteForm = document.getElementById('deleteForm');

  // Simple confirmation on form submit
  deleteForm.addEventListener('submit', function(e) {
    const confirmed = confirm(
      'Are you sure you want to delete this team update?\n\n' +
      'This action cannot be undone and will permanently remove:\n' +
      '• The update and all its content\n' +
      '• All comments and discussions\n' +
      '• All attached files\n' +
      '• All view and reaction data\n' +
      '• All action items and progress\n\n' +
      'Click OK to proceed with deletion.'
    );

    if (!confirmed) {
      e.preventDefault();
      return false;
    }
  });
});
</script>

<style>
.alert-danger {
  border-left: 4px solid var(--bs-danger);
}

.glass-card-dark.border-danger {
  box-shadow: 0 0 20px rgba(220, 53, 69, 0.3);
}

.card-header.bg-danger.bg-opacity-10 {
  background-color: rgba(220, 53, 69, 0.1) !important;
}

#confirmText:focus {
  border-color: var(--bs-danger);
  box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
}

.btn-danger:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-outline-danger:not(:disabled):hover {
  background-color: var(--bs-danger);
  border-color: var(--bs-danger);
  color: white;
}
</style>
