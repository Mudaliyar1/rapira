<%- contentFor('body') %>

<!-- Team Members Management -->
<div class="container-fluid px-0">
  <div class="row">
    <div class="col-12">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-0 text-white">Manage Team Members</h1>
          <p class="text-muted mb-0">Add and manage team members for the About Us page</p>
        </div>
        <a href="/admin/about/add" class="btn btn-gradient-purple">
          <i class="bi bi-plus-circle me-2"></i>Add Team Member
        </a>
      </div>

      <!-- Team Members Grid -->
      <div class="glass-card-dark">
        <div class="card-body">
          <% if (teamMembers && teamMembers.length > 0) { %>
            <div class="row g-4">
              <% teamMembers.forEach(member => { %>
                <div class="col-lg-4 col-md-6">
                  <div class="glass-card-dark h-100 <%= !member.isActive ? 'opacity-50' : '' %>">
                    <div class="card-body p-4">
                      <!-- Member Image -->
                      <div class="text-center mb-3">
                        <img src="<%= member.image %>" 
                             alt="<%= member.name %>" 
                             class="rounded-circle mb-3"
                             style="width: 100px; height: 100px; object-fit: cover;">
                        <h5 class="fw-bold text-white mb-1"><%= member.name %></h5>
                        <p class="text-primary mb-2"><%= member.position %></p>
                        <% if (!member.isActive) { %>
                          <span class="badge bg-warning">Inactive</span>
                        <% } %>
                      </div>

                      <!-- Bio -->
                      <p class="text-muted small mb-3" style="max-height: 60px; overflow: hidden;">
                        <%= member.bio.length > 100 ? member.bio.substring(0, 100) + '...' : member.bio %>
                      </p>

                      <!-- Social Links -->
                      <div class="d-flex justify-content-center gap-2 mb-3">
                        <% if (member.socialLinks.linkedin) { %>
                          <a href="<%= member.socialLinks.linkedin %>" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-linkedin"></i>
                          </a>
                        <% } %>
                        <% if (member.socialLinks.twitter) { %>
                          <a href="<%= member.socialLinks.twitter %>" target="_blank" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-twitter"></i>
                          </a>
                        <% } %>
                        <% if (member.socialLinks.instagram) { %>
                          <a href="<%= member.socialLinks.instagram %>" target="_blank" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-instagram"></i>
                          </a>
                        <% } %>
                        <% if (member.socialLinks.email) { %>
                          <a href="mailto:<%= member.socialLinks.email %>" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-envelope"></i>
                          </a>
                        <% } %>
                      </div>

                      <!-- Order -->
                      <div class="text-center mb-3">
                        <small class="text-muted">Display Order: <%= member.order %></small>
                      </div>

                      <!-- Actions -->
                      <div class="d-flex gap-2">
                        <a href="/admin/about/edit/<%= member._id %>" class="btn btn-sm btn-outline-warning flex-fill">
                          <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <form method="POST" action="/admin/about/toggle/<%= member._id %>" class="flex-fill">
                          <button type="submit" class="btn btn-sm <%= member.isActive ? 'btn-outline-secondary' : 'btn-outline-success' %> w-100">
                            <i class="bi bi-<%= member.isActive ? 'eye-slash' : 'eye' %> me-1"></i>
                            <%= member.isActive ? 'Hide' : 'Show' %>
                          </button>
                        </form>
                        <form method="POST" action="/admin/about/delete/<%= member._id %>" 
                              onsubmit="return confirm('Are you sure you want to delete this team member?')" 
                              class="flex-fill">
                          <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                            <i class="bi bi-trash me-1"></i>Delete
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <!-- Empty State -->
            <div class="text-center py-5">
              <i class="bi bi-people display-1 text-muted mb-3"></i>
              <h4 class="text-white mb-3">No Team Members Added</h4>
              <p class="text-muted mb-4">Start building your team by adding the first team member.</p>
              <a href="/admin/about/add" class="btn btn-gradient-purple">
                <i class="bi bi-plus-circle me-2"></i>Add First Team Member
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Instructions -->
      <div class="glass-card-dark mt-4">
        <div class="card-body">
          <h5 class="text-white mb-3">
            <i class="bi bi-info-circle me-2"></i>Instructions
          </h5>
          <ul class="text-muted mb-0">
            <li>Team members will appear on the About Us page in the order specified</li>
            <li>Only active team members will be visible to website visitors</li>
            <li>Images should be square (1:1 ratio) for best display</li>
            <li>Social links are optional but help visitors connect with team members</li>
            <li>Use the display order to control how team members appear on the page</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
