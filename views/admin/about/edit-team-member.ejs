<%- contentFor('body') %>

<!-- Edit Team Member -->
<div class="container-fluid px-0">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-0 text-white">Edit Team Member</h1>
          <p class="text-muted mb-0">Update team member information</p>
        </div>
        <a href="/admin/about" class="btn btn-outline-light">
          <i class="bi bi-arrow-left me-2"></i>Back to Team Members
        </a>
      </div>

      <!-- Edit Form -->
      <div class="glass-card-dark">
        <div class="card-body p-4">
          <form method="POST" action="/admin/about/edit/<%= teamMember._id %>" enctype="multipart/form-data">
            <div class="row g-4">
              <!-- Basic Information -->
              <div class="col-12">
                <h5 class="text-white mb-3">
                  <i class="bi bi-person me-2"></i>Basic Information
                </h5>
              </div>

              <div class="col-md-6">
                <label for="name" class="form-label text-white">Full Name *</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" 
                       id="name" name="name" value="<%= teamMember.name %>" required>
              </div>

              <div class="col-md-6">
                <label for="position" class="form-label text-white">Position/Role *</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" 
                       id="position" name="position" value="<%= teamMember.position %>" required>
              </div>

              <div class="col-12">
                <label for="bio" class="form-label text-white">Bio/Description *</label>
                <textarea class="form-control bg-dark text-white border-secondary" 
                          id="bio" name="bio" rows="4" required><%= teamMember.bio %></textarea>
              </div>

              <!-- Current Image -->
              <div class="col-12">
                <h5 class="text-white mb-3 mt-4">
                  <i class="bi bi-image me-2"></i>Profile Image
                </h5>
              </div>

              <div class="col-12">
                <div class="row align-items-center">
                  <div class="col-md-3">
                    <div class="text-center">
                      <img src="<%= teamMember.image %>" 
                           alt="<%= teamMember.name %>" 
                           class="rounded-circle mb-2"
                           style="width: 100px; height: 100px; object-fit: cover;">
                      <p class="small text-muted mb-0">Current Image</p>
                    </div>
                  </div>
                  <div class="col-md-9">
                    <label for="image" class="form-label text-white">Upload New Image (Optional)</label>
                    <input type="file" class="form-control bg-dark text-white border-secondary" 
                           id="image" name="image" accept="image/*">
                    <div class="form-text text-muted">
                      Leave empty to keep current image. Upload a square image (1:1 ratio) for best results. Max size: 5MB
                    </div>
                  </div>
                </div>
              </div>

              <!-- Social Links -->
              <div class="col-12">
                <h5 class="text-white mb-3 mt-4">
                  <i class="bi bi-share me-2"></i>Social Links (Optional)
                </h5>
              </div>

              <div class="col-md-6">
                <label for="linkedin" class="form-label text-white">
                  <i class="bi bi-linkedin me-1"></i>LinkedIn URL
                </label>
                <input type="url" class="form-control bg-dark text-white border-secondary" 
                       id="linkedin" name="linkedin" value="<%= teamMember.socialLinks.linkedin || '' %>">
              </div>

              <div class="col-md-6">
                <label for="twitter" class="form-label text-white">
                  <i class="bi bi-twitter me-1"></i>Twitter URL
                </label>
                <input type="url" class="form-control bg-dark text-white border-secondary" 
                       id="twitter" name="twitter" value="<%= teamMember.socialLinks.twitter || '' %>">
              </div>

              <div class="col-md-6">
                <label for="instagram" class="form-label text-white">
                  <i class="bi bi-instagram me-1"></i>Instagram URL
                </label>
                <input type="url" class="form-control bg-dark text-white border-secondary" 
                       id="instagram" name="instagram" value="<%= teamMember.socialLinks.instagram || '' %>">
              </div>

              <div class="col-md-6">
                <label for="email" class="form-label text-white">
                  <i class="bi bi-envelope me-1"></i>Email Address
                </label>
                <input type="email" class="form-control bg-dark text-white border-secondary" 
                       id="email" name="email" value="<%= teamMember.socialLinks.email || '' %>">
              </div>

              <!-- Display Settings -->
              <div class="col-12">
                <h5 class="text-white mb-3 mt-4">
                  <i class="bi bi-gear me-2"></i>Display Settings
                </h5>
              </div>

              <div class="col-md-6">
                <label for="order" class="form-label text-white">Display Order</label>
                <input type="number" class="form-control bg-dark text-white border-secondary" 
                       id="order" name="order" value="<%= teamMember.order %>" min="0">
                <div class="form-text text-muted">
                  Lower numbers appear first. Use 0 for default ordering.
                </div>
              </div>

              <!-- Submit Buttons -->
              <div class="col-12">
                <hr class="border-secondary my-4">
                <div class="d-flex gap-3">
                  <button type="submit" class="btn btn-gradient-purple">
                    <i class="bi bi-check-circle me-2"></i>Update Team Member
                  </button>
                  <a href="/admin/about" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-2"></i>Cancel
                  </a>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
