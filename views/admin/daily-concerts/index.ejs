<!-- Admin Daily Concerts List -->
<div class="container-fluid">
  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-6 col-lg-3">
      <div class="card bg-primary text-white mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-0"><%= pagination.total %></h5>
              <div>Total Concerts</div>
            </div>
            <div>
              <i class="bi bi-calendar-event fa-2x"></i>
            </div>
          </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between">
          <a class="small text-white stretched-link" href="/admin/daily-concerts">View All</a>
          <div class="small text-white"><i class="bi bi-arrow-right"></i></div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card bg-success text-white mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-0"><%= dailyConcerts.filter(c => c.isVisible).length %></h5>
              <div>Visible Concerts</div>
            </div>
            <div>
              <i class="bi bi-eye fa-2x"></i>
            </div>
          </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between">
          <a class="small text-white stretched-link" href="/admin/daily-concerts?visible=true">View Visible</a>
          <div class="small text-white"><i class="bi bi-arrow-right"></i></div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card bg-warning text-white mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-0"><%= dailyConcerts.filter(c => !c.isVisible).length %></h5>
              <div>Hidden Concerts</div>
            </div>
            <div>
              <i class="bi bi-eye-slash fa-2x"></i>
            </div>
          </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between">
          <a class="small text-white stretched-link" href="/admin/daily-concerts?visible=false">View Hidden</a>
          <div class="small text-white"><i class="bi bi-arrow-right"></i></div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-3">
      <div class="card bg-info text-white mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-0">View</h5>
              <div>Public Page</div>
            </div>
            <div>
              <i class="bi bi-globe fa-2x"></i>
            </div>
          </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between">
          <a class="small text-white stretched-link" href="/daily-concerts" target="_blank">Open Page</a>
          <div class="small text-white"><i class="bi bi-box-arrow-up-right"></i></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card mb-4">
    <div class="card-header">
      <i class="bi bi-funnel me-1"></i>
      Filter Concerts
    </div>
    <div class="card-body">
      <form action="/admin/daily-concerts" method="GET" class="row g-3">
        <!-- Visibility Filter -->
        <div class="col-md-3">
          <label for="visible" class="form-label">Visibility</label>
          <select class="form-select" id="visible" name="visible">
            <option value="">All</option>
            <option value="true" <%= filters.visible === 'true' ? 'selected' : '' %>>Visible</option>
            <option value="false" <%= filters.visible === 'false' ? 'selected' : '' %>>Hidden</option>
          </select>
        </div>

        <!-- Date Filter -->
        <div class="col-md-3">
          <label for="date" class="form-label">Date</label>
          <input type="date" class="form-control" id="date" name="date" value="<%= filters.date || '' %>">
        </div>

        <!-- City Filter -->
        <div class="col-md-3">
          <label for="city" class="form-label">City</label>
          <select class="form-select" id="city" name="city">
            <option value="">All Cities</option>
            <% filterOptions.cities.forEach(city => { %>
              <option value="<%= city %>" <%= filters.city === city ? 'selected' : '' %>><%= city %></option>
            <% }); %>
          </select>
        </div>

        <!-- State Filter -->
        <div class="col-md-3">
          <label for="state" class="form-label">State</label>
          <select class="form-select" id="state" name="state">
            <option value="">All States</option>
            <% filterOptions.states.forEach(state => { %>
              <option value="<%= state %>" <%= filters.state === state ? 'selected' : '' %>><%= state %></option>
            <% }); %>
          </select>
        </div>

        <!-- Filter Button -->
        <div class="col-12">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-filter me-1"></i> Apply Filters
          </button>
          <a href="/admin/daily-concerts" class="btn btn-outline-secondary ms-2">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Concerts Table -->
  <div class="card mb-4">
    <div class="card-header">
      <i class="bi bi-calendar-event me-1"></i>
      Daily Concerts
    </div>
    <div class="card-body">
      <% if (dailyConcerts.length === 0) { %>
        <div class="alert alert-info" style="color: #000000 !important; background-color: #cff4fc !important; border: 1px solid #b6effb !important; font-weight: 500 !important;">
          <span style="color: #000000 !important;">No concerts found matching your criteria.</span>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>Title</th>
                <th>Artist/Role</th>
                <th>Date & Time</th>
                <th>Location</th>
                <th>Organizer</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% dailyConcerts.forEach(concert => { %>
                <tr>
                  <td><%= concert.title %></td>
                  <td>
                    <% if (concert.bookingType === 'artist' && concert.artist) { %>
                      <%= concert.artist.stageName || concert.artist.user.name %>
                    <% } else if (concert.bookingType === 'role' && concert.roleSlot) { %>
                      <%= concert.roleSlot.name %> (Role)
                    <% } else { %>
                      Multiple Artists
                    <% } %>
                  </td>
                  <td>
                    <%= new Date(concert.eventDate).toLocaleDateString() %> at <%= concert.eventTime %>
                  </td>
                  <td><%= concert.eventCity %>, <%= concert.eventState %></td>
                  <td><%= concert.organizerName %></td>
                  <td>
                    <% if (concert.isVisible) { %>
                      <span class="badge bg-success">Visible</span>
                    <% } else { %>
                      <span class="badge bg-warning text-dark">Hidden</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="btn-group">
                      <a href="/admin/daily-concerts/<%= concert._id %>" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i>
                      </a>
                      <form action="/admin/daily-concerts/<%= concert._id %>/toggle-visibility" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm <%= concert.isVisible ? 'btn-warning' : 'btn-success' %>">
                          <i class="bi <%= concert.isVisible ? 'bi-eye-slash' : 'bi-eye' %>"></i>
                        </button>
                      </form>
                      <form action="/admin/daily-concerts/<%= concert._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this concert?');">
                        <button type="submit" class="btn btn-sm btn-danger">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (pagination.pageCount > 1) { %>
          <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
              <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/admin/daily-concerts?page=<%= pagination.page - 1 %><%= filters.visible ? `&visible=${filters.visible}` : '' %><%= filters.date ? `&date=${filters.date}` : '' %><%= filters.city ? `&city=${filters.city}` : '' %><%= filters.state ? `&state=${filters.state}` : '' %>">Previous</a>
              </li>

              <% for (let i = 1; i <= pagination.pageCount; i++) { %>
                <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                  <a class="page-link" href="/admin/daily-concerts?page=<%= i %><%= filters.visible ? `&visible=${filters.visible}` : '' %><%= filters.date ? `&date=${filters.date}` : '' %><%= filters.city ? `&city=${filters.city}` : '' %><%= filters.state ? `&state=${filters.state}` : '' %>"><%= i %></a>
                </li>
              <% } %>

              <li class="page-item <%= pagination.page === pagination.pageCount ? 'disabled' : '' %>">
                <a class="page-link" href="/admin/daily-concerts?page=<%= pagination.page + 1 %><%= filters.visible ? `&visible=${filters.visible}` : '' %><%= filters.date ? `&date=${filters.date}` : '' %><%= filters.city ? `&city=${filters.city}` : '' %><%= filters.state ? `&state=${filters.state}` : '' %>">Next</a>
              </li>
            </ul>
          </nav>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<script>
  // Apply filters as soon as they change
  document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.querySelector('form');
    const filterInputs = filterForm.querySelectorAll('select, input[type="date"]');

    filterInputs.forEach(input => {
      input.addEventListener('change', function() {
        filterForm.submit();
      });
    });
  });
</script>
