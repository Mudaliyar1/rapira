<%- contentFor('body') %>
<!-- Pending Concerts Table -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">Pending Approval</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th class="text-white">Title</th>
            <th class="text-white">Artist</th>
            <th class="text-white">Date</th>
            <th class="text-white">Location</th>
            <th class="text-white">Type</th>
            <th class="text-white">Submitted</th>
            <th class="text-white">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (pendingConcerts && pendingConcerts.length > 0) { %>
            <% pendingConcerts.forEach(concert => { %>
              <tr>
                <td>
                  <div class="fw-medium text-white"><%= concert.title %></div>
                  <div class="small <%= concert.isPaid ? 'text-primary' : 'text-success' %>"><%= concert.isPaid ? `₹${concert.price}` : 'Free' %></div>
                </td>
                <td>
                  <% if (concert.artist && concert.artist.user) { %>
                    <div class="fw-medium text-white"><%= concert.artist.user.name %></div>
                    <div class="small text-primary"><%= concert.artist.user.email %></div>
                  <% } else { %>
                    <span class="text-muted">Unknown</span>
                  <% } %>
                </td>
                <td>
                  <div class="text-white"><%= new Date(concert.date).toLocaleDateString() %></div>
                  <div class="small text-primary"><%= concert.time %></div>
                </td>
                <td>
                  <div class="text-white"><%= concert.venue %></div>
                  <div class="small text-primary"><%= concert.city %></div>
                </td>
                <td>
                  <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                    <%= concert.isPaid ? 'Paid' : 'Free' %>
                  </span>
                </td>
                <td>
                  <span class="text-white"><%= new Date(concert.createdAt).toLocaleDateString() %></span>
                </td>
                <td>
                  <div class="btn-group">
                    <a href="/admin/concerts/<%= concert._id %>/details" class="btn btn-sm btn-outline-primary me-1">
                      <i class="bi bi-eye"></i> Details
                    </a>
                    <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#approveModal<%= concert._id %>">
                      <i class="bi bi-check-circle"></i> Approve
                    </button>
                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal<%= concert._id %>">
                      <i class="bi bi-x-circle"></i> Reject
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-white">No pending concerts found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Approve Modals -->
<% if (pendingConcerts && pendingConcerts.length > 0) { %>
  <% pendingConcerts.forEach(concert => { %>
    <div class="modal fade" id="approveModal<%= concert._id %>" tabindex="-1" aria-labelledby="approveModalLabel<%= concert._id %>" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title text-white" id="approveModalLabel<%= concert._id %>">Confirm Approval</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-white">Are you sure you want to approve the concert <strong><%= concert.title %></strong>?</p>
            <p class="text-white mb-0">This will make the concert visible to all users and allow ticket bookings.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <form action="/admin/concerts/<%= concert._id %>/approve" method="POST">
              <button type="submit" class="btn btn-success">Approve Concert</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="rejectModal<%= concert._id %>" tabindex="-1" aria-labelledby="rejectModalLabel<%= concert._id %>" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title text-white" id="rejectModalLabel<%= concert._id %>">Reject Concert</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <form action="/admin/concerts/<%= concert._id %>/reject" method="POST" id="rejectForm<%= concert._id %>">
              <div class="mb-3">
                <label for="reason<%= concert._id %>" class="form-label text-white">Reason for Rejection</label>
                <textarea class="form-control" id="reason<%= concert._id %>" name="reason" rows="3" required></textarea>
                <div class="form-text text-white-50">This will be sent to the artist.</div>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" form="rejectForm<%= concert._id %>" class="btn btn-danger">Reject Concert</button>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
<% } %>

<%- contentFor('title') %>Pending Concerts
