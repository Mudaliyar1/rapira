<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Website Updates</h1>
    <div>
      <a href="/admin/website-updates/new" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>New Update
      </a>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
          <li class="breadcrumb-item active" aria-current="page">Website Updates</li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <% if (updates.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-megaphone text-muted" style="font-size: 3rem;"></i>
          <h5 class="mt-3">No website updates yet</h5>
          <p class="text-muted">Create your first website update to inform users about changes</p>
          <a href="/admin/website-updates/new" class="btn btn-primary">Create Update</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Author</th>
                <th>Date</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% updates.forEach(update => { %>
                <tr>
                  <td>
                    <strong><%= update.title %></strong>
                    <% if (update.tags && update.tags.length > 0) { %>
                      <div class="mt-1">
                        <% update.tags.forEach(tag => { %>
                          <span class="badge bg-secondary me-1"><%= tag %></span>
                        <% }) %>
                      </div>
                    <% } %>
                  </td>
                  <td><%= update.description.substring(0, 100) %><% if (update.description.length > 100) { %>...<% } %></td>
                  <td><%= update.author ? update.author.name : 'Unknown' %></td>
                  <td><%= update.timestamp.toLocaleDateString() %></td>
                  <td>
                    <% if (update.priority === 'critical') { %>
                      <span class="badge bg-danger"><%= update.priority.charAt(0).toUpperCase() + update.priority.slice(1) %></span>
                    <% } else if (update.priority === 'high') { %>
                      <span class="badge bg-warning text-dark"><%= update.priority.charAt(0).toUpperCase() + update.priority.slice(1) %></span>
                    <% } else if (update.priority === 'medium') { %>
                      <span class="badge bg-info"><%= update.priority.charAt(0).toUpperCase() + update.priority.slice(1) %></span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= update.priority.charAt(0).toUpperCase() + update.priority.slice(1) %></span>
                    <% } %>
                  </td>
                  <td>
                    <% if (update.isActive) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Inactive</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="btn-group" role="group">
                      <a href="/admin/website-updates/<%= update._id %>/edit" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <form action="/admin/website-updates/<%= update._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this update?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>