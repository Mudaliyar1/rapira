        <td>
          <button class="btn btn-sm btn-danger invalidate-link-btn" data-token="${link.token}">
            <i class="bi bi-trash"></i>
          </button>
        </td>
      </tr>
    `;
  });
  
  html += `
        </tbody>
      </table>
    </div>
    <p class="text-white-50 small">
      <i class="bi bi-info-circle me-1"></i> ${links.length} active link(s)
    </p>
  `;
  
  activeLinksContainer.innerHTML = html;
  
  // Add event listeners to invalidate buttons
  document.querySelectorAll('.invalidate-link-btn').forEach(button => {
    button.addEventListener('click', function() {
      const token = this.getAttribute('data-token');
      invalidateLink(token);
    });
  });
}

// Invalidate a specific link
function invalidateLink(token) {
  console.log('Invalidating link:', token);
  
  if (confirm('Are you sure you want to invalidate this validation link?')) {
    fetch(`/admin/ticket-validation/invalidate/${token}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert('Validation link has been invalidated.');
        loadActiveLinks();
      } else {
        alert('Failed to invalidate link: ' + data.message);
      }
    })
    .catch(error => {
      console.error('Invalidate link error:', error);
      alert('Failed to invalidate link. Please try again.');
    });
  }
}
</script>