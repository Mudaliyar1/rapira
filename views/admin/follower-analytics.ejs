<%- contentFor('title') %>Follower Analytics

<%- contentFor('body') %>
<div class="dashboard-container">
  <!-- Page Title -->
  <div class="d-flex align-items-center mb-4">
    <i class="bi bi-people fs-3 text-primary me-2"></i>
    <h3 class="fw-bold mb-0">Follower Analytics</h3>
  </div>

  <!-- Stats Cards -->
  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="stat-card glass-card-dark p-3">
        <div class="d-flex align-items-center">
          <div class="stat-icon bg-primary-subtle text-primary me-3">
            <i class="bi bi-people-fill"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0 text-white"><%= totalFollows %></h3>
            <p class="text-white-50 mb-0">Total Follows</p>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card glass-card-dark p-3">
        <div class="d-flex align-items-center">
          <div class="stat-icon bg-success-subtle text-success me-3">
            <i class="bi bi-person-heart"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0 text-white"><%= userFollowers %></h3>
            <p class="text-white-50 mb-0">Fan Followers</p>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card glass-card-dark p-3">
        <div class="d-flex align-items-center">
          <div class="stat-icon bg-warning-subtle text-warning me-3">
            <i class="bi bi-music-note-beamed"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0 text-white"><%= artistFollowers %></h3>
            <p class="text-white-50 mb-0">Artist Followers</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Top Artists by Followers -->
    <div class="col-lg-8 mb-4">
      <div class="glass-card-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-white">
            <i class="bi bi-trophy text-warning me-2"></i>
            Top Artists by Followers
          </h5>
          <a href="/admin/follower-analytics" class="btn btn-outline-light btn-sm">View All</a>
        </div>
        <div class="card-body">
          <% if (topArtists && topArtists.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-dark table-hover">
                <thead>
                  <tr>
                    <th>Rank</th>
                    <th>Artist</th>
                    <th>Genre</th>
                    <th>Location</th>
                    <th class="text-center">Total</th>
                    <th class="text-center">Fans</th>
                    <th class="text-center">Artists</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% topArtists.forEach((artist, index) => { %>
                    <tr>
                      <td>
                        <% if (index === 0) { %>
                          <i class="bi bi-trophy-fill text-warning"></i>
                        <% } else if (index === 1) { %>
                          <i class="bi bi-trophy-fill text-secondary"></i>
                        <% } else if (index === 2) { %>
                          <i class="bi bi-trophy-fill text-warning"></i>
                        <% } else { %>
                          <%= index + 1 %>
                        <% } %>
                      </td>
                      <td>
                        <div class="d-flex align-items-center">
                          <div class="avatar-sm me-2">
                            <i class="bi bi-person-circle fs-4"></i>
                          </div>
                          <div>
                            <h6 class="mb-0 text-white"><%= artist.stageName %></h6>
                            <small class="text-muted"><%= artist.genre %></small>
                          </div>
                        </div>
                      </td>
                      <td><%= artist.genre || 'N/A' %></td>
                      <td>
                        <% if (artist.city) { %>
                          <%= artist.city %><%= artist.state ? ', ' + artist.state : '' %>
                        <% } else { %>
                          N/A
                        <% } %>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-primary"><%= artist.totalFollowers %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-success"><%= artist.userFollowers %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-warning"><%= artist.artistFollowers %></span>
                      </td>
                      <td>
                        <a href="/admin/follower-analytics/artist/<%= artist._id %>" class="btn btn-sm btn-outline-light">
                          <i class="bi bi-eye"></i>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <i class="bi bi-inbox display-1 text-muted mb-3"></i>
              <h5 class="text-muted">No artists with followers yet</h5>
              <p class="text-muted">Follower data will appear here when users start following artists.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Recent Follows -->
    <div class="col-lg-4 mb-4">
      <div class="glass-card-dark">
        <div class="card-header">
          <h5 class="mb-0 text-white">
            <i class="bi bi-clock text-info me-2"></i>
            Recent Follows
          </h5>
        </div>
        <div class="card-body">
          <% if (recentFollows && recentFollows.length > 0) { %>
            <div class="list-group list-group-flush">
              <% recentFollows.forEach(follow => { %>
                <div class="list-group-item bg-transparent border-secondary">
                  <div class="d-flex align-items-center">
                    <div class="avatar-sm me-2">
                      <i class="bi bi-person-circle fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                      <h6 class="mb-0 text-white"><%= follow.followerId.name %></h6>
                      <small class="text-muted">
                        <% if (follow.followerId.role === 'user') { %>
                          <i class="bi bi-person text-success"></i> Fan
                        <% } else if (follow.followerId.role === 'artist') { %>
                          <i class="bi bi-music-note-beamed text-warning"></i> Artist
                        <% } %>
                        • <%= new Date(follow.createdAt).toLocaleDateString() %>
                      </small>
                    </div>
                    <div class="text-end">
                      <small class="text-muted d-block">Following</small>
                      <small class="text-white-50"><%= follow.followingId.name %></small>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="text-center py-4">
              <i class="bi bi-inbox display-1 text-muted mb-3"></i>
              <h5 class="text-muted">No recent follows</h5>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- All Artists with Followers -->
  <div class="row">
    <div class="col-12">
      <div class="glass-card-dark">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-white">
            <i class="bi bi-music-note-list text-primary me-2"></i>
            All Artists with Followers
          </h5>
          <div class="d-flex gap-2">
            <input type="text" class="form-control form-control-sm" placeholder="Search artists..." id="artistSearch">
            <select class="form-select form-select-sm" id="sortSelect">
              <option value="followers">Sort by Followers</option>
              <option value="name">Sort by Name</option>
              <option value="genre">Sort by Genre</option>
            </select>
          </div>
        </div>
        <div class="card-body">
          <% if (artistsWithFollowers && artistsWithFollowers.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-dark table-hover" id="artistsTable">
                <thead>
                  <tr>
                    <th>Artist</th>
                    <th>Genre</th>
                    <th>Location</th>
                    <th class="text-center">Total Followers</th>
                    <th class="text-center">Fans</th>
                    <th class="text-center">Artists</th>
                    <th>Latest Follow</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% artistsWithFollowers.forEach(artist => { %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center">
                          <div class="avatar-sm me-2">
                            <i class="bi bi-person-circle fs-4"></i>
                          </div>
                          <div>
                            <h6 class="mb-0 text-white"><%= artist.stageName %></h6>
                            <small class="text-muted"><%= artist.genre %></small>
                          </div>
                        </div>
                      </td>
                      <td><%= artist.genre || 'N/A' %></td>
                      <td>
                        <% if (artist.city) { %>
                          <%= artist.city %><%= artist.state ? ', ' + artist.state : '' %>
                        <% } else { %>
                          N/A
                        <% } %>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-primary fs-6"><%= artist.totalFollowers %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-success"><%= artist.userFollowers %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-warning"><%= artist.artistFollowers %></span>
                      </td>
                      <td>
                        <% if (artist.latestFollower) { %>
                          <%= new Date(artist.latestFollower).toLocaleDateString() %>
                        <% } else { %>
                          No followers
                        <% } %>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <a href="/admin/follower-analytics/artist/<%= artist._id %>" class="btn btn-outline-light">
                            <i class="bi bi-eye"></i>
                          </a>
                          <a href="/artists/<%= artist._id %>" class="btn btn-outline-primary" target="_blank">
                            <i class="bi bi-box-arrow-up-right"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <i class="bi bi-inbox display-1 text-muted mb-3"></i>
              <h5 class="text-muted">No artists with followers yet</h5>
              <p class="text-muted">Follower data will appear here when users start following artists.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .avatar-sm {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .stat-card {
    border-radius: 12px;
    transition: transform 0.2s ease;
  }
  
  .stat-card:hover {
    transform: translateY(-2px);
  }
  
  .stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }
  
  .glass-card-dark {
    background: rgba(30, 30, 30, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    overflow: hidden;
  }
  
  .card-header {
    background: rgba(20, 20, 20, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem 1.5rem;
  }
  
  .table-dark {
    --bs-table-bg: transparent;
    --bs-table-border-color: rgba(255, 255, 255, 0.1);
  }
  
  .list-group-item {
    border-color: rgba(255, 255, 255, 0.1) !important;
  }
  
  .badge {
    font-weight: 600;
  }
</style>

<script>
  // Search functionality
  document.getElementById('artistSearch').addEventListener('input', function() {
    const searchTerm = this.value.toLowerCase();
    const rows = document.querySelectorAll('#artistsTable tbody tr');
    
    rows.forEach(row => {
      const artistName = row.querySelector('h6').textContent.toLowerCase();
      const genre = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
      const location = row.querySelector('td:nth-child(3)').textContent.toLowerCase();
      
      if (artistName.includes(searchTerm) || genre.includes(searchTerm) || location.includes(searchTerm)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });
  
  // Sort functionality
  document.getElementById('sortSelect').addEventListener('change', function() {
    const sortBy = this.value;
    const table = document.getElementById('artistsTable');
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    
    rows.sort((a, b) => {
      let aValue, bValue;
      
      switch(sortBy) {
        case 'followers':
          aValue = parseInt(a.querySelector('.badge.bg-primary').textContent);
          bValue = parseInt(b.querySelector('.badge.bg-primary').textContent);
          return bValue - aValue; // Descending
        case 'name':
          aValue = a.querySelector('h6').textContent.toLowerCase();
          bValue = b.querySelector('h6').textContent.toLowerCase();
          return aValue.localeCompare(bValue); // Ascending
        case 'genre':
          aValue = a.querySelector('td:nth-child(2)').textContent.toLowerCase();
          bValue = b.querySelector('td:nth-child(2)').textContent.toLowerCase();
          return aValue.localeCompare(bValue); // Ascending
        default:
          return 0;
      }
    });
    
    // Re-append sorted rows
    rows.forEach(row => tbody.appendChild(row));
  });
</script>