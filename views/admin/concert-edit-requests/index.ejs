<%- contentFor('body') %>

<div class="container-fluid">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Concert Edit Requests</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
      <div class="btn-group me-2">
        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
          Filter: <%= currentStatus === 'all' ? 'All Requests' : currentStatus.charAt(0).toUpperCase() + currentStatus.slice(1) %>
        </button>
        <ul class="dropdown-menu">
          <li><a class="dropdown-item" href="?status=all&sort=<%= currentSort %>">All Requests</a></li>
          <li><a class="dropdown-item" href="?status=pending&sort=<%= currentSort %>">Pending</a></li>
          <li><a class="dropdown-item" href="?status=approved&sort=<%= currentSort %>">Approved</a></li>
          <li><a class="dropdown-item" href="?status=rejected&sort=<%= currentSort %>">Rejected</a></li>
        </ul>
      </div>
      <div class="btn-group">
        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
          Sort: <%= currentSort === 'newest' ? 'Newest First' : 'Oldest First' %>
        </button>
        <ul class="dropdown-menu">
          <li><a class="dropdown-item" href="?status=<%= currentStatus %>&sort=newest">Newest First</a></li>
          <li><a class="dropdown-item" href="?status=<%= currentStatus %>&sort=oldest">Oldest First</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-warning">
        <div class="card-body text-center">
          <h3 class="card-title text-warning"><%= statusCounts.pending %></h3>
          <p class="card-text">Pending Requests</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-success">
        <div class="card-body text-center">
          <h3 class="card-title text-success"><%= statusCounts.approved %></h3>
          <p class="card-text">Approved</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-danger">
        <div class="card-body text-center">
          <h3 class="card-title text-danger"><%= statusCounts.rejected %></h3>
          <p class="card-text">Rejected</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-info">
        <div class="card-body text-center">
          <h3 class="card-title text-info"><%= statusCounts.total %></h3>
          <p class="card-text">Total Requests</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Requests Table -->
  <div class="card">
    <div class="card-body">
      <% if (editRequests.length === 0) { %>
        <div class="text-center py-4">
          <i class="bi bi-inbox display-1 text-muted"></i>
          <h4 class="text-muted mt-3">No edit requests found</h4>
          <p class="text-muted">There are currently no concert edit requests.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-dark">
              <tr>
                <th>Request ID</th>
                <th>Concert</th>
                <th>Artist</th>
                <th>Requested At</th>
                <th>Status</th>
                <th>Changes</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% editRequests.forEach(request => { %>
                <tr>
                  <td>
                    <small class="text-muted">#<%= request._id.toString().slice(-6) %></small>
                  </td>
                  <td>
                    <strong><%= request.concert ? request.concert.title : 'Concert Deleted' %></strong>
                    <% if (request.concert) { %>
                      <br><small class="text-muted">
                        <%= toISTDateString(request.concert.date) %> • 
                        <%= request.concert.venue ? request.concert.venue.name : 'No venue' %>
                      </small>
                    <% } %>
                  </td>
                  <td>
                    <% if (request.artist && request.artist.user) { %>
                      <%= request.artist.stageName || request.artist.user.name %>
                      <br><small class="text-muted"><%= request.artist.user.email %></small>
                    <% } else { %>
                      <span class="text-muted">Artist Deleted</span>
                    <% } %>
                  </td>
                  <td>
                    <%= toISTDateString(request.requestedAt) %>
                    <br><small class="text-muted"><%= toISTTimeString(request.requestedAt) %></small>
                  </td>
                  <td>
                    <% if (request.status === 'pending') { %>
                      <span class="badge bg-warning">Pending</span>
                    <% } else if (request.status === 'approved') { %>
                      <span class="badge bg-success">Approved</span>
                    <% } else if (request.status === 'rejected') { %>
                      <span class="badge bg-danger">Rejected</span>
                    <% } %>
                    
                    <% if (request.adminResponse && request.adminResponse.respondedAt) { %>
                      <br><small class="text-muted">
                        <%= toISTDateString(request.adminResponse.respondedAt) %>
                      </small>
                    <% } %>
                  </td>
                  <td>
                    <% 
                      const changes = request.requestedChanges;
                      const changeCount = Object.keys(changes).length;
                    %>
                    <small>
                      <%= changeCount %> field<%= changeCount !== 1 ? 's' : '' %>
                      <% if (changes.title) { %><br>• Title<% } %>
                      <% if (changes.date || changes.time) { %><br>• Date/Time<% } %>
                      <% if (changes.venue) { %><br>• Venue<% } %>
                      <% if (changes.price !== undefined) { %><br>• Price<% } %>
                      <% if (changes.maxTickets !== undefined) { %><br>• Max Tickets<% } %>
                      <% if (changes.posterImage) { %><br>• Poster<% } %>
                    </small>
                  </td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/concert-edit-requests/<%= request._id %>" class="btn btn-outline-primary" title="View Details">
                        <i class="bi bi-eye"></i>
                      </a>
                      
                      <% if (request.status === 'pending') { %>
                        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#approveModal<%= request._id %>" title="Approve">
                          <i class="bi bi-check"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal<%= request._id %>" title="Reject">
                          <i class="bi bi-x"></i>
                        </button>
                      <% } else { %>
                        <form action="/admin/concert-edit-requests/<%= request._id %>/delete" method="POST" style="display: inline;">
                          <button type="submit" class="btn btn-outline-secondary" title="Delete" onclick="return confirm('Are you sure you want to delete this processed edit request? This action cannot be undone.')">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>

                <!-- Approve Modal -->
                <% if (request.status === 'pending') { %>
                  <div class="modal fade" id="approveModal<%= request._id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title">Approve Edit Request</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form action="/admin/concert-edit-requests/<%= request._id %>/approve" method="POST">
                          <div class="modal-body">
                            <p>Are you sure you want to approve this edit request?</p>
                            <p><strong>Concert:</strong> <%= request.concert ? request.concert.title : 'N/A' %></p>
                            <div class="mb-3">
                              <label for="adminMessage<%= request._id %>" class="form-label">Message to Artist (Optional)</label>
                              <textarea class="form-control" id="adminMessage<%= request._id %>" name="adminMessage" rows="3" placeholder="Add a message for the artist..."></textarea>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Approve Request</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                  <!-- Reject Modal -->
                  <div class="modal fade" id="rejectModal<%= request._id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title">Reject Edit Request</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form action="/admin/concert-edit-requests/<%= request._id %>/reject" method="POST">
                          <div class="modal-body">
                            <p>Are you sure you want to reject this edit request?</p>
                            <p><strong>Concert:</strong> <%= request.concert ? request.concert.title : 'N/A' %></p>
                            <div class="mb-3">
                              <label for="adminMessageReject<%= request._id %>" class="form-label">Reason for Rejection <span class="text-danger">*</span></label>
                              <textarea class="form-control" id="adminMessageReject<%= request._id %>" name="adminMessage" rows="3" placeholder="Please explain why you're rejecting this request..." required></textarea>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Reject Request</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% } %>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
