<%- contentFor('body') %>

<!-- Edit User Form -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">Edit User Details</h5>
  </div>
  <div class="card-body p-4">
    <div class="d-flex align-items-center mb-4">
      <% if (user.profileImage) { %>
        <img src="<%= user.profileImage %>" alt="<%= user.name %>" class="rounded-circle me-3" width="64" height="64">
      <% } else { %>
        <div class="bg-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 64px; height: 64px;">
          <i class="bi bi-person fs-3 text-light"></i>
        </div>
      <% } %>
      <div>
        <h5 class="mb-0 text-white"><%= user.name %></h5>
        <p class="text-white-50 mb-0"><%= user.email %></p>
      </div>
    </div>

    <form action="/admin/users/<%= user._id %>/update" method="POST">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="name" class="form-label text-white">Username</label>
            <input type="text" class="form-control bg-dark border-secondary text-white" id="name" name="name" value="<%= user.name %>" readonly>
            <div class="form-text text-white-50">Username cannot be changed</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="email" class="form-label text-white">Email Address</label>
            <input type="email" class="form-control bg-dark border-secondary text-white" id="email" name="email" value="<%= user.email %>" readonly>
            <div class="form-text text-white-50">Email cannot be changed</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="password" class="form-label text-white">Password</label>
            <input type="password" class="form-control bg-dark border-secondary text-white" id="password" name="password" value="********" readonly>
            <div class="form-text text-white-50">Password cannot be changed from this page</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="role" class="form-label text-white">Role</label>
            <select class="form-select bg-dark border-secondary text-white" id="role" name="role" required>
              <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option>
              <option value="artist" <%= user.role === 'artist' ? 'selected' : '' %>>Artist</option>
              <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
            </select>
          </div>
        </div>
        <div class="col-12">
          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="makeProducer" name="makeProducer" <%= hasProducerRole ? 'checked' : '' %>>
            <label class="form-check-label text-white" for="makeProducer">
              Give direct Producer role access (without application)
            </label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="makeDistributor" name="makeDistributor" <%= typeof hasDistributorRole !== 'undefined' && hasDistributorRole ? 'checked' : '' %>>
            <label class="form-check-label text-white" for="makeDistributor">
              Give direct Distributor role access (without registration)
            </label>
          </div>
        </div>
        <div class="col-12">
          <div class="d-flex justify-content-end gap-2">
            <a href="/admin/users" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Update User</button>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<%- contentFor('headerButtons') %>
<a href="/admin/users" class="btn btn-outline-secondary">
  <i class="bi bi-arrow-left me-1"></i> Back to Users
</a>

<%- contentFor('title') %>Edit User
