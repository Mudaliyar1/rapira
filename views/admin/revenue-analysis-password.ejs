<%- include('../partials/messages') %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h2 class="fw-bold mb-1">Set Export Password</h2>
          <p class="text-muted mb-0">Enter a password to protect your exported HTML report</p>
        </div>
        <div>
          <a href="/admin/revenue-analysis" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Revenue Analysis
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Password Entry Form -->
  <div class="row justify-content-center">
    <div class="col-xl-6 col-lg-8 col-md-10">
      <div class="card">
        <div class="card-body p-5">
          <form method="POST" action="/admin/revenue-analysis/export-with-password">
            <!-- Hidden fields to preserve filters -->
            <input type="hidden" name="startDate" value="<%= filters.startDate %>">
            <input type="hidden" name="endDate" value="<%= filters.endDate %>">
            <input type="hidden" name="revenueSource" value="<%= filters.revenueSource %>">
            <input type="hidden" name="userFilter" value="<%= filters.userFilter %>">
            <input type="hidden" name="amountMin" value="<%= filters.amountMin %>">
            <input type="hidden" name="amountMax" value="<%= filters.amountMax %>">
            <input type="hidden" name="paymentStatus" value="<%= filters.paymentStatus %>">
            <input type="hidden" name="concertFilter" value="<%= filters.concertFilter %>">
            <input type="hidden" name="concertStatus" value="<%= filters.concertStatus %>">
            <input type="hidden" name="cityFilter" value="<%= filters.cityFilter %>">
            <input type="hidden" name="stateFilter" value="<%= filters.stateFilter %>">
            
            <div class="mb-4">
              <label for="password" class="form-label">Password</label>
              <input type="password" class="form-control form-control-lg" id="password" name="password" placeholder="Enter password to protect the exported file" required>
              <div class="form-text">The password will be required to open the exported HTML file</div>
            </div>
            
            <div class="d-grid">
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-download me-2"></i> Export with Password
              </button>
            </div>
          </form>
          
          <hr class="my-4">
          
          <!-- Applied Filters Summary -->
          <div class="mt-4">
            <h6 class="mb-3"><i class="bi bi-funnel me-2"></i>Applied Filters</h6>
            <div class="row">
              <% if (filters.userFilter) { %>
              <div class="col-md-6 mb-2">
                <span class="badge bg-info">User: <%= filters.userFilter %></span>
              </div>
              <% } %>
              <% if (filters.concertFilter) { %>
              <div class="col-md-6 mb-2">
                <span class="badge bg-info">Concert: <%= filters.concertFilter %></span>
              </div>
              <% } %>
              <% if (filters.concertStatus !== 'all') { %>
              <div class="col-md-6 mb-2">
                <span class="badge bg-info">Status: <%= filters.concertStatus %></span>
              </div>
              <% } %>
              <% if (filters.cityFilter) { %>
              <div class="col-md-6 mb-2">
                <span class="badge bg-info">City: <%= filters.cityFilter %></span>
              </div>
              <% } %>
              <% if (filters.stateFilter) { %>
              <div class="col-md-6 mb-2">
                <span class="badge bg-info">State: <%= filters.stateFilter %></span>
              </div>
              <% } %>
              <% if (filters.startDate || filters.endDate) { %>
              <div class="col-md-6 mb-2">
                <span class="badge bg-info">Date: <%= filters.startDate || 'Any' %> to <%= filters.endDate || 'Any' %></span>
              </div>
              <% } %>
              <% if (!filters.userFilter && !filters.concertFilter && filters.concertStatus === 'all' && !filters.cityFilter && !filters.stateFilter && !filters.startDate && !filters.endDate) { %>
              <div class="text-muted">No filters applied</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>