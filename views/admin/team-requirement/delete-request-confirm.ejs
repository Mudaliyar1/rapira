<%- contentFor('title') %>Confirm Delete Booking Request

<%- contentFor('body') %>

<div class="container-fluid px-4">
  <ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="/admin/team-requirement/requests">Team Booking Requests</a></li>
    <li class="breadcrumb-item active">Confirm Delete</li>
  </ol>

  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white">
          <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion</h5>
        </div>
        <div class="card-body">
            <h4 class="mb-4 text-center">Are you sure you want to delete this booking request?</h4>

            <div class="card mb-4">
              <div class="card-body">
                <h5 class="card-title text-white" style="font-weight: bold !important;">Request Details</h5>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold" style="color: #000000 !important;">Name:</span>
                    <span style="color: #000000 !important;"><%= request.name %></span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold" style="color: #000000 !important;">Email:</span>
                    <span style="color: #000000 !important;"><%= request.email %></span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold" style="color: #000000 !important;">Role:</span>
                    <span style="color: #000000 !important;"><%= request.role ? request.role.name : 'Unknown' %></span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold" style="color: #000000 !important;">Status:</span>
                    <span style="color: #000000 !important;">
                      <% if (request.status === 'pending') { %>
                        <span class="badge bg-warning text-dark">Pending</span>
                      <% } else if (request.status === 'approved') { %>
                        <span class="badge bg-success">Approved</span>
                      <% } else if (request.status === 'rejected') { %>
                        <span class="badge bg-danger">Rejected</span>
                      <% } %>
                    </span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between">
                    <span class="fw-bold" style="color: #000000 !important;">Date:</span>
                    <span style="color: #000000 !important;"><%= new Date(request.createdAt).toLocaleDateString() %></span>
                  </li>
                </ul>
              </div>
            </div>

            <p class="alert alert-warning">
              <i class="fas fa-exclamation-circle me-2"></i>
              This action will permanently delete this booking request and cannot be undone.
              <% if (request.isBulkRequest) { %>
                <br><br>
                <strong>Note:</strong> This is a bulk booking request. Deleting it will also delete all related booking requests.
              <% } %>
            </p>

            <form action="/admin/team-requirement/requests/<%= request._id %>/delete" method="POST" class="mt-4">
              <div class="d-grid gap-3">
                <button type="submit" class="btn btn-danger btn-lg">
                  <i class="fas fa-trash-alt me-2"></i>Delete Booking Request
                </button>
                <a href="/admin/team-requirement/requests" class="btn btn-outline-secondary btn-lg">
                  <i class="fas fa-times me-2"></i>Cancel
                </a>
              </div>
            </form>
        </div>
      </div>
    </div>
  </div>
</div>
