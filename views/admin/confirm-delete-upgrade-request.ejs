<%- contentFor('body') %>

<!-- Confirm Delete Artist Upgrade Request -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 text-white">Confirm Delete Artist Upgrade Request</h5>
    <a href="/admin/artist-upgrade-requests" class="btn btn-sm btn-outline-light">
      <i class="bi bi-arrow-left"></i> Back to List
    </a>
  </div>
  <div class="card-body p-4">
    <div class="text-center mb-4">
      <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
      <h3 class="text-white mt-3">Are you sure?</h3>
      <p class="text-white-50">You are about to delete the following artist upgrade request:</p>
    </div>

    <div class="glass-card-dark border border-secondary p-4 mb-4">
      <div class="row">
        <div class="col-md-6">
          <h6 class="text-white-50 mb-2">Artist</h6>
          <p class="text-white mb-3">
            <% if (request.user) { %>
              <%= request.user.name %> (<%= request.user.email %>)
            <% } else { %>
              Unknown User (User may have been deleted)
            <% } %>
          </p>
          
          <h6 class="text-white-50 mb-2">Current Level</h6>
          <p class="text-white mb-3"><%= request.currentLevel %></p>
          
          <h6 class="text-white-50 mb-2">Requested Level</h6>
          <p class="text-white mb-3"><%= request.requestedLevel %></p>
        </div>
        <div class="col-md-6">
          <h6 class="text-white-50 mb-2">Status</h6>
          <p class="text-white mb-3">
            <% if (request.status === 'pending') { %>
              <span class="badge bg-warning">Pending</span>
            <% } else if (request.status === 'approved') { %>
              <span class="badge bg-success">Approved</span>
            <% } else if (request.status === 'rejected') { %>
              <span class="badge bg-danger">Rejected</span>
            <% } %>
          </p>
          
          <h6 class="text-white-50 mb-2">Submitted On</h6>
          <p class="text-white mb-3"><%= toISTLocaleString(request.createdAt) %></p>
          
          <% if (request.adminNotes) { %>
            <h6 class="text-white-50 mb-2">Admin Notes</h6>
            <p class="text-white mb-3"><%= request.adminNotes %></p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="alert alert-danger">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <strong>Warning:</strong> This action cannot be undone. The upgrade request will be permanently deleted from the system.
    </div>

    <div class="d-flex justify-content-between mt-4">
      <a href="/admin/artist-upgrade-requests/<%= request._id %>" class="btn btn-outline-light">
        <i class="bi bi-x-lg me-2"></i> Cancel
      </a>
      <form action="/admin/artist-upgrade-requests/<%= request._id %>/delete" method="POST">
        <button type="submit" class="btn btn-danger">
          <i class="bi bi-trash me-2"></i> Delete Upgrade Request
        </button>
      </form>
    </div>
  </div>
</div>
