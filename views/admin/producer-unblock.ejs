<%- contentFor('body') %>

<div class="container-fluid">
  <!-- Header -->
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/producers/<%= producer._id %>" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-2"></i> Back to Producer
    </a>
    <div>
      <h2 class="fw-bold mb-1 text-success">Unblock Producer</h2>
      <p class="text-muted mb-0">This action will restore the producer's platform access</p>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-7">
      <!-- Success Alert -->
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>Unblock Action</strong>
        <p class="mb-0">You are about to unblock <strong><%= producer.name %></strong> and restore their platform access.</p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>

      <!-- Producer Info Card -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light border-bottom">
          <h5 class="fw-bold mb-0">Producer Information</h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12">
              <div class="d-flex align-items-center gap-3">
                <img src="<%= producer.profileImage || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(producer.name.charAt(0)) %>"
                     alt="<%= producer.name %>"
                     class="rounded-circle"
                     width="70" height="70"
                     style="object-fit: cover;">
                <div>
                  <h5 class="fw-bold mb-1"><%= producer.name %></h5>
                  <p class="mb-1"><i class="bi bi-envelope me-2"></i><%= producer.email %></p>
                  <p class="mb-0"><i class="bi bi-telephone me-2"></i><%= producer.phone || 'Not provided' %></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label text-muted fw-bold mb-2">Account Status</label>
              <p class="form-control-plaintext fw-500">
                <span class="badge bg-danger">BLOCKED</span>
              </p>
            </div>
            <div class="col-md-6">
              <label class="form-label text-muted fw-bold mb-2">Username</label>
              <p class="form-control-plaintext fw-500"><%= producer.username || 'Not provided' %></p>
            </div>
            <% if (producer.blockReason) { %>
              <div class="col-12">
                <label class="form-label text-muted fw-bold mb-2">Block Reason</label>
                <div class="alert alert-warning mb-0">
                  <p class="mb-0"><%= producer.blockReason %></p>
                </div>
              </div>
            <% } %>
            <% if (producer.blockedAt) { %>
              <div class="col-md-6">
                <label class="form-label text-muted fw-bold mb-2">Blocked Date</label>
                <p class="form-control-plaintext fw-500">
                  <%= new Date(producer.blockedAt).toLocaleDateString('en-IN') %>
                </p>
              </div>
            <% } %>
            <div class="col-md-6">
              <label class="form-label text-muted fw-bold mb-2">Account Created</label>
              <p class="form-control-plaintext fw-500">
                <%= new Date(producer.createdAt).toLocaleDateString('en-IN') %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Unblock Requests Section -->
      <% if (unblockRequests.length > 0) { %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-light border-bottom">
            <h5 class="fw-bold mb-0">Unblock Requests</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-sm mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Message</th>
                  </tr>
                </thead>
                <tbody>
                  <% unblockRequests.forEach(req => { %>
                    <tr>
                      <td>
                        <small><%= new Date(req.createdAt).toLocaleDateString('en-IN') %></small>
                      </td>
                      <td>
                        <small>
                          <span class="badge <%= req.status === 'approved' ? 'bg-success' : req.status === 'pending' ? 'bg-warning' : 'bg-danger' %>">
                            <%= req.status.charAt(0).toUpperCase() + req.status.slice(1) %>
                          </span>
                        </small>
                      </td>
                      <td>
                        <small><%= req.message.substring(0, 40) %>...</small>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Unblock Form -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light border-bottom">
          <h5 class="fw-bold mb-0">Unblock Details</h5>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/producers/<%= producer._id %>/unblock">
            <div class="mb-4">
              <label class="form-label fw-bold">Unblock Reason (Optional)</label>
              <textarea name="unblockReason" class="form-control" rows="4" placeholder="Provide any notes or reason for unblocking this producer..."></textarea>
              <small class="text-muted">This will be stored for record-keeping purposes.</small>
            </div>

            <div class="mb-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="confirmUnblock" required>
                <label class="form-check-label" for="confirmUnblock">
                  I confirm that I want to unblock <strong><%= producer.name %></strong> and restore their platform access
                </label>
              </div>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-unlock-fill me-2"></i> Unblock Producer
              </button>
              <a href="/admin/producers/<%= producer._id %>" class="btn btn-outline-secondary">
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Info Box -->
      <div class="alert alert-info mt-4">
        <h6 class="fw-bold mb-2">What happens when a producer is unblocked?</h6>
        <ul class="mb-0 small">
          <li>The producer can log in and access the platform again</li>
          <li>Their profile will be visible to other users</li>
          <li>They can continue their activities on the platform</li>
          <li>The action is recorded in the system logs</li>
          <li>They will be notified of the unblock</li>
        </ul>
      </div>
    </div>
  </div>
</div>
