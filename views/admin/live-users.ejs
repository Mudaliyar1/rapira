<div class="container-fluid py-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-white mb-0"><i class="bi bi-people"></i> Live Users by Page</h4>
    <div class="text-white-50 small">Auto-refreshing <span id="refreshInterval">15</span>s</div>
  </div>

  <!-- Summary -->
  <div class="row g-3" id="pageCards">
    <% if (pages.length === 0) { %>
      <div class="col-12">
        <div class="text-center py-5 text-white-50">
          <i class="bi bi-inbox" style="font-size: 2rem;"></i>
          <p class="mt-2 mb-0">No online users detected in the last 5 minutes.</p>
        </div>
      </div>
    <% } else { %>
      <% pages.forEach(p => { %>
        <div class="col-sm-6 col-md-4 col-lg-3">
          <div class="glass-card-dark border border-secondary p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
              <div class="text-white fw-semibold"><%= p.page %></div>
              <span class="badge bg-info"><%= p.count %></span>
            </div>
            <a class="btn btn-sm btn-outline-light mt-2 w-100" href="/admin/live-users?page=<%= encodeURIComponent(p.page) %>">View Users</a>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <% if (typeof initialPage !== 'undefined' && initialPage) { %>
  <div class="glass-card-dark border border-secondary mt-4" id="initialPageSection">
    <div class="card-header border-secondary d-flex justify-content-between align-items-center">
      <h6 class="text-white mb-0">Users on: <span id="initialPageName"><%= initialPage %></span></h6>
      <span class="badge bg-info" id="initialPageCount"><%= initialPageUsers.length %></span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
          <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Updated</th><th></th></tr>
          </thead>
          <tbody id="initialPageTbody">
            <% if (initialPageUsers.length === 0) { %>
              <tr><td colspan="5" class="text-center text-white-50">No users on this page.</td></tr>
            <% } else { %>
              <% initialPageUsers.forEach(u => { %>
                <tr>
                  <td class="text-white"><a class="link-light text-decoration-none" href="/admin/users/<%= u._id %>/details"><%= u.name %></a></td>
                  <td class="text-white-50"><%= u.email %></td>
                  <td><span class="badge <%= u.role==='admin'?'bg-danger':(u.role==='artist'?'bg-primary':'bg-secondary') %>"><%= u.role %></span></td>
                  <td class="text-white-50"><small><%= new Date(u.lastPageUpdate).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'}) %></small></td>
                  <td><a class="btn btn-sm btn-outline-info" href="/admin/users/<%= u._id %>/details">View</a></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Users Table -->
  <div class="glass-card-dark border border-secondary mt-4">
    <div class="card-header border-secondary">
      <div class="d-flex justify-content-between align-items-center">
        <h6 class="text-white mb-0">Users</h6>
        <small class="text-white-50">Last updated: <span id="lastUpdated">just now</span></small>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0" id="usersTable">
          <thead>
            <tr>
              <th style="width: 28%">Name</th>
              <th style="width: 28%">Email</th>
              <th style="width: 14%">Role</th>
              <th style="width: 20%">Page</th>
              <th style="width: 10%">Updated</th>
            </tr>
          </thead>
          <tbody id="usersTbody">
            <% users.forEach(u => { %>
              <tr data-page="<%= u.currentPage || 'Unknown' %>" data-id="<%= u._id %>">
                <td class="text-white"><a class="link-light text-decoration-none" href="/admin/users/<%= u._id %>/details"><%= u.name %></a></td>
                <td class="text-white-50"><%= u.email %></td>
                <td>
                  <span class="badge <%= u.role === 'admin' ? 'bg-danger' : (u.role === 'artist' ? 'bg-primary' : 'bg-secondary') %>"><%= u.role %></span>
                </td>
                <td class="text-white-50"><%= u.currentPage || 'Unknown' %></td>
                <td class="text-white-50"><small><%= new Date(u.lastPageUpdate).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'}) %></small></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Page Users Modal -->
  <div class="modal fade" id="pageUsersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content bg-dark border-secondary">
        <div class="modal-header border-secondary">
          <h5 class="modal-title">Users on <span id="modalPageName"></span></h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="pageUsersContainer"></div>
        </div>
        <div class="modal-footer border-secondary">
          <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  'use strict';
  const usersTbody = document.getElementById('usersTbody');
  const lastUpdated = document.getElementById('lastUpdated');
  const refreshIntervalSpan = document.getElementById('refreshInterval');

  let dataCache = { pages: [], totalOnline: 0 };
  let intervalSec = 15;
  let pollTimer;
  let countdownTimer;
  let remaining = intervalSec;

  function openPageUsers(page){
    const modalTitle = document.getElementById('modalPageName');
    const container = document.getElementById('pageUsersContainer');
    modalTitle.textContent = page;
    const pageObj = (dataCache.pages || []).find(p => p.page === page);
    if (!pageObj || !pageObj.users || pageObj.users.length === 0){
      container.innerHTML = '<p class="text-white-50 mb-0">No users on this page.</p>';
    } else {
      container.innerHTML = `
        <div class="table-responsive">
          <table class="table table-dark table-hover mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Updated</th><th></th></tr></thead>
            <tbody>
              ${pageObj.users.map(u => `
                <tr>
                  <td class="text-white"><a class="link-light text-decoration-none" href="/admin/users/${u._id}/details">${u.name}</a></td>
                  <td class="text-white-50">${u.email}</td>
                  <td><span class="badge ${u.role==='admin'?'bg-danger':(u.role==='artist'?'bg-primary':'bg-secondary')}">${u.role}</span></td>
                  <td class="text-white-50"><small>${new Date(u.lastPageUpdate).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'})}</small></td>
                  <td><a class="btn btn-sm btn-outline-info" href="/admin/users/${u._id}/details">View</a></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>`;
    }
    const modal = new bootstrap.Modal(document.getElementById('pageUsersModal'));
    modal.show();
  }
  window.openPageUsers = openPageUsers;

  function updateSummary(pages){
    const container = document.getElementById('pageCards');
    if (!container) return;
    if (!pages || pages.length === 0){
      container.innerHTML = `<div class="col-12"><div class="text-center py-5 text-white-50"><i class=\"bi bi-inbox\" style=\"font-size:2rem;\"></i><p class=\"mt-2 mb-0\">No online users detected in the last 5 minutes.</p></div></div>`;
      return;
    }
    container.innerHTML = pages.map(p => `
      <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="glass-card-dark border border-secondary p-3 h-100">
          <div class="d-flex justify-content-between align-items-center">
            <div class="text-white fw-semibold">${p.page}</div>
            <span class="badge bg-info">${p.count}</span>
          </div>
          <a class="btn btn-sm btn-outline-light mt-2 w-100" href="/admin/live-users?page=${encodeURIComponent(p.page)}">View Users</a>
        </div>
      </div>
    `).join('');
  }

  function renderUsers(users){
    usersTbody.innerHTML = users.map(u => `
      <tr data-page="${u.currentPage || 'Unknown'}" data-id="${u._id}">
        <td class="text-white"><a class="link-light text-decoration-none" href="/admin/users/${u._id}/details">${u.name}</a></td>
        <td class="text-white-50">${u.email}</td>
        <td><span class="badge ${u.role==='admin'?'bg-danger':(u.role==='artist'?'bg-primary':'bg-secondary')}">${u.role}</span></td>
        <td class="text-white-50">${u.currentPage || 'Unknown'}</td>
        <td class="text-white-50"><small>${new Date(u.lastPageUpdate).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'})}</small></td>
      </tr>
    `).join('');
  }

  async function fetchData(){
    try{
      const res = await fetch('/admin/live-users/data');
      const json = await res.json();
      if(!json.success) return;
      dataCache = json;
      updateSummary(json.pages);
      // Flatten all users for table
      const allUsers = json.pages.flatMap(p => p.users);
      renderUsers(allUsers);
      lastUpdated.textContent = new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
      remaining = intervalSec;
      refreshIntervalSpan.textContent = remaining;

      // If we have a server-selected page, update that section too
      if (typeof window !== 'undefined') {
        const initialPageNameEl = document.getElementById('initialPageName');
        const initialPageTbody = document.getElementById('initialPageTbody');
        const initialPageCount = document.getElementById('initialPageCount');
        if (initialPageNameEl && initialPageTbody) {
          const page = initialPageNameEl.textContent;
          const pageObj = (json.pages || []).find(p => p.page === page);
          const users = pageObj ? pageObj.users : [];
          initialPageCount.textContent = users.length;
          if (!users || users.length === 0) {
            initialPageTbody.innerHTML = '<tr><td colspan="5" class="text-center text-white-50">No users on this page.</td></tr>';
          } else {
            initialPageTbody.innerHTML = users.map(u => `
              <tr>
                <td class="text-white"><a class="link-light text-decoration-none" href="/admin/users/${u._id}/details">${u.name}</a></td>
                <td class="text-white-50">${u.email}</td>
                <td><span class="badge ${u.role==='admin'?'bg-danger':(u.role==='artist'?'bg-primary':'bg-secondary')}">${u.role}</span></td>
                <td class="text-white-50"><small>${new Date(u.lastPageUpdate).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'})}</small></td>
                <td><a class="btn btn-sm btn-outline-info" href="/admin/users/${u._id}/details">View</a></td>
              </tr>
            `).join('');
          }
        }
      }
    }catch(err){
      console.error('Fetch live users failed:', err);
    }
  }

  function startTimers(){
    clearInterval(pollTimer);
    clearInterval(countdownTimer);
    remaining = intervalSec;
    refreshIntervalSpan.textContent = remaining;
    pollTimer = setInterval(fetchData, intervalSec*1000);
    countdownTimer = setInterval(() => {
      remaining -= 1;
      if (remaining <= 0){
        fetchData();
        remaining = intervalSec;
      }
      refreshIntervalSpan.textContent = remaining;
    }, 1000);
  }

  // Events
  // (Filters removed)

  // Start
  fetchData();
  startTimers();
})();
</script>
