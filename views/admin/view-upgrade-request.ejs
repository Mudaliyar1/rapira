<%- contentFor('body') %>

<!-- View Artist Upgrade Request -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 text-white">Artist Upgrade Request Details</h5>
    <div>
      <a href="/admin/artist-upgrade-requests/<%= request._id %>/confirm-delete" class="btn btn-sm btn-outline-danger me-2">
        <i class="bi bi-trash"></i> Delete
      </a>
      <a href="/admin/artist-upgrade-requests" class="btn btn-sm btn-outline-light">
        <i class="bi bi-arrow-left"></i> Back to Requests
      </a>
    </div>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6 mb-4">
        <h6 class="text-white-50 mb-3">Artist Information</h6>
        <div class="d-flex align-items-center mb-3">
          <% if (request.user) { %>
            <img src="<%= request.user.profileImage || '/images/default-profile.png' %>" alt="<%= request.user.name %>" class="rounded-circle me-3" style="width: 64px; height: 64px; object-fit: cover;">
            <div>
              <h5 class="mb-0 text-white"><%= request.user.name %></h5>
              <p class="mb-0 text-muted"><%= request.user.email %></p>
            </div>
          <% } else { %>
            <img src="/images/default-profile.png" alt="User not found" class="rounded-circle me-3" style="width: 64px; height: 64px; object-fit: cover;">
            <div>
              <h5 class="mb-0 text-white">User not found</h5>
              <p class="mb-0 text-muted">User may have been deleted</p>
            </div>
          <% } %>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-6">
            <div class="glass-card-dark p-3 h-100">
              <h6 class="text-white-50 mb-2">Current Level</h6>
              <span class="badge bg-secondary fs-6 px-3 py-2"><%= request.currentLevel %></span>
            </div>
          </div>
          <div class="col-6">
            <div class="glass-card-dark p-3 h-100">
              <h6 class="text-white-50 mb-2">Requested Level</h6>
              <span class="badge bg-primary fs-6 px-3 py-2"><%= request.requestedLevel %></span>
            </div>
          </div>
        </div>

        <div class="glass-card-dark p-3 mb-4">
          <h6 class="text-white-50 mb-2">Request Status</h6>
          <% if (request.status === 'pending') { %>
            <span class="badge bg-warning fs-6 px-3 py-2">Pending</span>
          <% } else if (request.status === 'approved') { %>
            <span class="badge bg-success fs-6 px-3 py-2">Approved</span>
          <% } else if (request.status === 'rejected') { %>
            <span class="badge bg-danger fs-6 px-3 py-2">Rejected</span>
          <% } %>

          <% if (request.status !== 'pending') { %>
            <div class="mt-3">
              <small class="text-white-50">Reviewed by: <%= request.reviewedBy ? request.reviewedBy.name : 'Unknown' %></small><br>
              <small class="text-white-50">Reviewed on: <%= request.reviewedAt ? toISTLocaleString(request.reviewedAt) : 'Unknown' %></small>
            </div>
          <% } %>
        </div>

        <div class="glass-card-dark p-3">
          <h6 class="text-white-50 mb-2">Request Date</h6>
          <p class="text-white mb-0"><%= toISTLocaleString(request.createdAt) %></p>
        </div>
      </div>

      <div class="col-md-6">
        <h6 class="text-white-50 mb-3">Request Details</h6>

        <div class="glass-card-dark p-3 mb-4">
          <h6 class="text-white-50 mb-2">Artist's Reason</h6>
          <p class="text-white mb-0"><%= request.reason %></p>
        </div>

        <% if (request.adminNotes) { %>
          <div class="glass-card-dark p-3 mb-4">
            <h6 class="text-white-50 mb-2">Admin Notes</h6>
            <p class="text-white mb-0"><%= request.adminNotes %></p>
          </div>
        <% } %>

        <div class="glass-card-dark p-3 mb-4">
          <h6 class="text-white-50 mb-2">Completed Learning Modules</h6>
          <% if (completedModules && completedModules.length > 0) { %>
            <div class="list-group">
              <% completedModules.forEach(module => { %>
                <div class="list-group-item bg-dark text-white border-secondary">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="mb-1"><%= module.title %></h6>
                      <small class="text-muted">Completed on <%= module.progress ? toISTDateString(module.progress.completedAt) : 'Unknown' %></small>
                    </div>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle-fill"></i>
                    </span>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-white-50 mb-0">No completed modules found.</p>
          <% } %>
        </div>

        <% if (request.status === 'pending') { %>
          <div class="d-flex gap-2 mt-4">
            <button type="button" class="btn btn-success flex-grow-1" data-bs-toggle="modal" data-bs-target="#approveModal">
              <i class="bi bi-check-lg me-2"></i> Approve Request
            </button>
            <button type="button" class="btn btn-danger flex-grow-1" data-bs-toggle="modal" data-bs-target="#rejectModal">
              <i class="bi bi-x-lg me-2"></i> Reject Request
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-white">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="approveModalLabel">Approve Artist Upgrade</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/artist-upgrade-requests/<%= request._id %>/approve" method="POST">
        <div class="modal-body">
          <p>Are you sure you want to approve <strong><%= request.user ? request.user.name : 'this user' %></strong>'s request to upgrade from <strong><%= request.currentLevel %></strong> to <strong><%= request.requestedLevel %></strong>?</p>
          <div class="mb-3">
            <label for="adminNotes" class="form-label">Admin Notes (Optional)</label>
            <textarea class="form-control" id="adminNotes" name="adminNotes" rows="3" placeholder="Add any notes about this approval..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Approve Upgrade</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-white">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="rejectModalLabel">Reject Artist Upgrade</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/artist-upgrade-requests/<%= request._id %>/reject" method="POST">
        <div class="modal-body">
          <p>Are you sure you want to reject <strong><%= request.user ? request.user.name : 'this user' %></strong>'s request to upgrade from <strong><%= request.currentLevel %></strong> to <strong><%= request.requestedLevel %></strong>?</p>
          <div class="mb-3">
            <label for="adminNotesReject" class="form-label">Rejection Reason (Required)</label>
            <textarea class="form-control" id="adminNotesReject" name="adminNotes" rows="3" required placeholder="Explain why this request is being rejected..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Reject Upgrade</button>
        </div>
      </form>
    </div>
  </div>
</div>
