<%- contentFor('body') %>
<% const perms = (currentUser && currentUser.adminPermissions) ? currentUser.adminPermissions : []; %>
<% const isSuperAdminVal = (typeof isSuperAdmin !== 'undefined' && isSuperAdmin); %>

      <!-- Stats Cards -->
      <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
          <div class="stat-card glass-card-dark border border-secondary">
            <div class="d-flex align-items-center p-3">
              <div class="stat-icon bg-primary-subtle text-primary me-3">
                <i class="bi bi-people"></i>
              </div>
              <div>
                <h3 class="fw-bold mb-0 text-white"><%= counts.users %></h3>
                <p class="text-white-50 mb-0">Total Users</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="stat-card glass-card-dark border border-secondary">
            <div class="d-flex align-items-center p-3">
              <div class="stat-icon bg-success-subtle text-success me-3">
                <i class="bi bi-music-note-beamed"></i>
              </div>
              <div>
                <h3 class="fw-bold mb-0 text-white"><%= counts.artists %></h3>
                <p class="text-white-50 mb-0">Artists</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="stat-card glass-card-dark border border-secondary">
            <div class="d-flex align-items-center p-3">
              <div class="stat-icon bg-warning-subtle text-warning me-3">
                <i class="bi bi-calendar-event"></i>
              </div>
              <div>
                <h3 class="fw-bold mb-0 text-white"><%= counts.concerts %></h3>
                <p class="text-white-50 mb-0">Concerts</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="stat-card glass-card-dark border border-secondary">
            <div class="d-flex align-items-center p-3">
              <div class="stat-icon bg-danger-subtle text-danger me-3">
                <i class="bi bi-ticket-perforated"></i>
              </div>
              <div>
                <h3 class="fw-bold mb-0 text-white"><%= counts.tickets %></h3>
                <p class="text-white-50 mb-0">Tickets Sold</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Pending Approvals Alert -->
      <% if (counts.pendingConcerts > 0) { %>
        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <div>
            You have <strong><%= counts.pendingConcerts %></strong> pending concert approvals.
            <% if (isSuperAdminVal || perms.includes('manage_concerts_list')) { %>
            <a href="/admin/concerts/pending" class="alert-link ms-2">Review now</a>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Charts Row -->
      <div class="row g-4 mb-5">
        <div class="col-lg-8">
          <div class="glass-card-dark h-100 border border-secondary">
            <div class="card-header border-bottom border-secondary">
              <h5 class="card-title mb-0 text-white">Revenue Overview</h5>
            </div>
            <div class="card-body">
              <canvas id="revenueChart"></canvas>
            </div>
            <div class="card-footer border-top border-secondary">
              <div class="d-flex justify-content-between">
                <div>
                  <h6 class="mb-0 text-white">Total Revenue</h6>
                  <h4 class="fw-bold text-primary">₹<%= totalRevenue.toLocaleString() %></h4>
                </div>
                <div>
                  <% if (isSuperAdminVal || perms.includes('manage_tickets')) { %>
                  <a href="/admin/tickets" class="btn btn-sm btn-outline-primary">View Details</a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="glass-card-dark h-100 border border-secondary">
            <div class="card-header border-bottom border-secondary">
              <h5 class="card-title mb-0 text-white">Concert Types</h5>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center">
              <canvas id="concertTypesChart"></canvas>
            </div>
            <div class="card-footer border-top border-secondary">
              <div class="row text-center">
                <div class="col-6">
                  <h6 class="mb-0 text-white">Paid</h6>
                  <h4 class="fw-bold text-primary"><%= concertStats.paid %></h4>
                </div>
                <div class="col-6">
                  <h6 class="mb-0 text-white">Free</h6>
                  <h4 class="fw-bold text-warning"><%= concertStats.free %></h4>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Popular Cities & Recent Tickets -->
      <div class="row g-4 mb-5">
        <div class="col-lg-6">
          <div class="glass-card-dark h-100 border border-secondary">
            <div class="card-header border-bottom border-secondary">
              <h5 class="card-title mb-0 text-white">Popular Cities</h5>
            </div>
            <div class="card-body">
              <canvas id="citiesChart"></canvas>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="glass-card-dark h-100 border border-secondary">
            <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
              <h5 class="card-title mb-0 text-white">Recent Ticket Purchases</h5>
              <% if (isSuperAdminVal || perms.includes('manage_tickets')) { %>
              <a href="/admin/tickets" class="btn btn-sm btn-outline-primary">View All</a>
              <% } %>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover table-bordered-dark mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>User</th>
                      <th>Concert</th>
                      <th>Amount</th>
                      <th>Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (recentTickets && recentTickets.length > 0) { %>
                      <% recentTickets.forEach(ticket => { %>
                        <tr>
                          <td class="text-white"><%= ticket.user.name %></td>
                          <td class="text-white"><%= ticket.concert.title %></td>
                          <td class="text-white">₹<%= ticket.totalAmount %></td>
                          <td class="text-white"><%= toISTDateString(ticket.purchaseDate) %></td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="4" class="text-center py-3 text-white-50">No recent tickets</td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Upcoming Concerts -->
      <div class="glass-card-dark mb-4 border border-secondary">
        <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0 text-white">Upcoming Concerts</h5>
          <% if (isSuperAdminVal || perms.includes('manage_concerts_list')) { %>
          <a href="/admin/concerts" class="btn btn-sm btn-outline-primary">View All</a>
          <% } %>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover table-bordered-dark mb-0">
              <thead class="table-light">
                <tr>
                  <th>Title</th>
                  <th>Artist</th>
                  <th>Date</th>
                  <th>Venue</th>
                  <th>City</th>
                  <th>Type</th>
                  <th>Tickets Sold</th>
                </tr>
              </thead>
              <tbody>
                <% if (upcomingConcerts && upcomingConcerts.length > 0) { %>
                  <% upcomingConcerts.forEach(concert => { %>
                    <tr>
                      <td class="text-white"><%= concert.title %></td>
                      <td class="text-white"><%= concert.artist && concert.artist.user ? concert.artist.user.name : 'Unknown Artist' %></td>
                      <td class="text-white"><%= toISTDateString(concert.date) %></td>
                      <td class="text-white"><%= concert.venue %></td>
                      <td class="text-white"><%= concert.city %></td>
                      <td>
                        <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                          <%= concert.isPaid ? 'Paid' : 'Free' %>
                        </span>
                      </td>
                      <td class="text-white">
                        <%= concert.ticketsSold %> / <%= concert.maxTickets > 0 ? concert.maxTickets : '∞' %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-3 text-white-50">No upcoming concerts</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Admin Toggle is now handled in the header -->

  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>

  <!-- Dashboard Data -->
  <script>
    // Initialize dashboard data object
    window.dashboardData = {};
  </script>

  <!-- Inject data without EJS syntax in the script tag -->
  <script>
    // This script tag is processed by EJS but doesn't contain EJS syntax inside JavaScript
    var cityLabelsJson = '<%- JSON.stringify(popularCities.map(city => city._id)) %>';
    var cityDataJson = '<%- JSON.stringify(popularCities.map(city => city.count)) %>';
    var concertTypeDataJson = '<%- JSON.stringify([concertStats.paid, concertStats.free]) %>';
    var pendingCountValue = '<%= counts.pendingConcerts %>';

    // Parse the JSON strings
    window.dashboardData.cityLabels = JSON.parse(cityLabelsJson);
    window.dashboardData.cityData = JSON.parse(cityDataJson);
    window.dashboardData.concertTypeData = JSON.parse(concertTypeDataJson);
    window.dashboardData.pendingCount = pendingCountValue;
  </script>

  <!-- Chart Initialization -->
  <script src="/js/dashboard-charts.js"></script>
</body>
</html>
