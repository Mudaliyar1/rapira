  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">Enhanced Contact Message Statistics</h5>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-primary mb-1"><%= (typeof stats !== 'undefined' && stats) ? stats.total : 0 %></h4>
          <small class="text-white-50">Total Messages</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-danger mb-1"><%= (typeof stats !== 'undefined' && stats) ? stats.new : 0 %></h4>
          <small class="text-white-50">New</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-info mb-1"><%= (typeof stats !== 'undefined' && stats) ? stats.read : 0 %></h4>
          <small class="text-white-50">Read</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-success mb-1"><%= (typeof stats !== 'undefined' && stats) ? stats.replied : 0 %></h4>
          <small class="text-white-50">Replied</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-secondary mb-1"><%= (typeof stats !== 'undefined' && stats) ? stats.archived : 0 %></h4>
          <small class="text-white-50">Archived</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-warning mb-1"><%= (typeof stats !== 'undefined' && stats) ? stats.filtered : 0 %></h4>
          <small class="text-white-50">Filtered Results</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Status Cards -->
