<!-- Flash Messages -->
<% if (typeof success !== 'undefined' && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Enhanced Search and Filter Section -->
<div class="glass-card-dark border border-secondary mb-4">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">Search & Filter Contact Messages</h5>
  </div>
  <div class="card-body">
    <form method="GET" action="/admin/contact-messages" id="messageSearchForm">
      <div class="row g-3">
        <div class="col-md-4">
          <label for="search" class="form-label text-white">Search Messages</label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-white">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control bg-dark border-secondary text-white"
                   id="search" name="search" placeholder="Search by name, email, subject, or message..."
                   value="<%= (typeof searchParams !== 'undefined' && searchParams) ? searchParams.search : '' %>">
          </div>
        </div>
        <div class="col-md-2">
          <label for="status" class="form-label text-white">Status</label>
          <select class="form-select bg-dark border-secondary text-white" id="status" name="status">
            <option value="all" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.status === 'all') ? 'selected' : '' %>>All Status</option>
            <option value="new" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.status === 'new') ? 'selected' : '' %>>New</option>
            <option value="read" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.status === 'read') ? 'selected' : '' %>>Read</option>
            <option value="replied" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.status === 'replied') ? 'selected' : '' %>>Replied</option>
            <option value="archived" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.status === 'archived') ? 'selected' : '' %>>Archived</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="dateRange" class="form-label text-white">Date Range</label>
          <select class="form-select bg-dark border-secondary text-white" id="dateRange" name="dateRange">
            <option value="all" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.dateRange === 'all') ? 'selected' : '' %>>All Dates</option>
            <option value="today" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.dateRange === 'today') ? 'selected' : '' %>>Today</option>
            <option value="this-week" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.dateRange === 'this-week') ? 'selected' : '' %>>This Week</option>
            <option value="this-month" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.dateRange === 'this-month') ? 'selected' : '' %>>This Month</option>
            <option value="this-year" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.dateRange === 'this-year') ? 'selected' : '' %>>This Year</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="sortBy" class="form-label text-white">Sort By</label>
          <select class="form-select bg-dark border-secondary text-white" id="sortBy" name="sortBy">
            <option value="createdAt" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.sortBy === 'createdAt') ? 'selected' : '' %>>Date</option>
            <option value="name" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.sortBy === 'name') ? 'selected' : '' %>>Name</option>
            <option value="subject" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.sortBy === 'subject') ? 'selected' : '' %>>Subject</option>
            <option value="status" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.sortBy === 'status') ? 'selected' : '' %>>Status</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="sortOrder" class="form-label text-white">Order</label>
          <select class="form-select bg-dark border-secondary text-white" id="sortOrder" name="sortOrder">
            <option value="desc" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.sortOrder === 'desc') ? 'selected' : '' %>>Newest</option>
            <option value="asc" <%= (typeof searchParams !== 'undefined' && searchParams && searchParams.sortOrder === 'asc') ? 'selected' : '' %>>Oldest</option>
          </select>
        </div>
      </div>
      <div class="row mt-3">
        <div class="col-12">
          <div class="d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-search me-1"></i> Search Messages
            </button>
            <a href="/admin/contact-messages" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-counterclockwise me-1"></i> Reset All
            </a>
            <button type="button" class="btn btn-outline-info" id="toggleStats">
              <i class="bi bi-bar-chart me-1"></i> Show Enhanced Stats
            </button>
            <button class="btn btn-outline-primary" id="exportMessages">
              <i class="bi bi-download me-1"></i> Export
            </button>
            <button class="btn btn-outline-warning" id="bulkDeleteBtn" onclick="toggleBulkDelete()">
              <i class="bi bi-trash me-1"></i> Bulk Delete
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Enhanced Statistics Section -->
