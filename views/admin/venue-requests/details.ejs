<%- contentFor('body') %>

<!-- Admin Venue Request Details -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="fw-bold">Venue Request Details</h1>
  <div class="d-flex gap-2">
    <a href="/admin/venue-requests" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Back to Requests
    </a>
    <% if (venueRequest.status === 'pending') { %>
      <a href="/admin/venue-requests/<%= venueRequest._id %>/approve" class="btn btn-success">
        <i class="bi bi-check-circle me-1"></i> Approve
      </a>
      <a href="/admin/venue-requests/<%= venueRequest._id %>/reject" class="btn btn-danger">
        <i class="bi bi-x-circle me-1"></i> Reject
      </a>
    <% } %>
    <% if (venueRequest.status === 'approved' && venueRequest.createdVenue) { %>
      <a href="/admin/venues/<%= venueRequest.createdVenue._id %>/details" 
         class="btn btn-info" target="_blank">
        <i class="bi bi-building me-1"></i> View Created Venue
      </a>
    <% } %>
  </div>
</div>

<div class="row">
  <!-- Main Content -->
  <div class="col-lg-8">
    <!-- Status Card -->
    <div class="card mb-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h3 class="mb-1"><%= venueRequest.name %></h3>
            <p class="text-muted mb-2"><%= venueRequest.fullAddress %></p>
            <p class="mb-0">
              <strong>Submitted by:</strong> <%= venueRequest.user.name %> 
              (<%= venueRequest.user.email %>)
            </p>
          </div>
          <div class="text-end">
            <% if (venueRequest.status === 'pending') { %>
              <span class="badge bg-warning fs-6">
                <i class="bi bi-clock me-1"></i>Pending Review
              </span>
            <% } else if (venueRequest.status === 'approved') { %>
              <span class="badge bg-success fs-6">
                <i class="bi bi-check-circle me-1"></i>Approved
              </span>
            <% } else if (venueRequest.status === 'rejected') { %>
              <span class="badge bg-danger fs-6">
                <i class="bi bi-x-circle me-1"></i>Rejected
              </span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Basic Information -->
    <div class="card mb-4">
      <div class="card-header bg-light">
        <h5 class="mb-0">
          <i class="bi bi-info-circle me-2"></i>Basic Information
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <strong>Venue Type:</strong>
            <p><%= venueRequest.venueType %></p>
          </div>
          <div class="col-md-6">
            <strong>Price Range:</strong>
            <p><%= venueRequest.priceRange %></p>
          </div>
          <% if (venueRequest.capacity) { %>
            <div class="col-md-6">
              <strong>Capacity:</strong>
              <p><%= venueRequest.capacity %> people</p>
            </div>
          <% } %>
          <% if (venueRequest.description) { %>
            <div class="col-md-12">
              <strong>Description:</strong>
              <p><%= venueRequest.description %></p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Facilities -->
    <% if (venueRequest.facilities && venueRequest.facilities.length > 0) { %>
      <div class="card mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-gear me-2"></i>Facilities
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <% venueRequest.facilities.forEach(facility => { %>
              <div class="col-md-4 mb-2">
                <i class="bi bi-check-circle text-success me-2"></i><%= facility %>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Pricing Information -->
    <% if (venueRequest.pricing && venueRequest.pricing.hourlyRates && venueRequest.pricing.hourlyRates.length > 0) { %>
      <div class="card mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-currency-rupee me-2"></i>Pricing Information
          </h5>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-4">
              <strong>Minimum Hours:</strong>
              <p><%= venueRequest.pricing.minimumHours || 1 %> hours</p>
            </div>
            <% if (venueRequest.pricing.ticketPricing) { %>
              <div class="col-md-4">
                <strong>Min Ticket Price:</strong>
                <p>₹<%= venueRequest.pricing.ticketPricing.minimumPrice || 0 %></p>
              </div>
              <div class="col-md-4">
                <strong>Suggested Ticket Price:</strong>
                <p>₹<%= venueRequest.pricing.ticketPricing.suggestedPrice || 100 %></p>
              </div>
            <% } %>
          </div>
          
          <h6>Hourly Rates</h6>
          <div class="table-responsive">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Duration</th>
                  <th>Rate</th>
                  <th>Commission %</th>
                  <th>Commission Amount</th>
                </tr>
              </thead>
              <tbody>
                <% venueRequest.pricing.hourlyRates.forEach(rate => { %>
                  <tr>
                    <td><%= rate.hours %> hour<%= rate.hours > 1 ? 's' : '' %></td>
                    <td>₹<%= rate.rate.toLocaleString() %></td>
                    <td><%= rate.commissionPercentage %>%</td>
                    <td>₹<%= rate.commissionAmount.toLocaleString() %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Contact Information -->
    <% if (venueRequest.contactPerson && (venueRequest.contactPerson.name || venueRequest.contactPerson.phone || venueRequest.contactPerson.email)) { %>
      <div class="card mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-person me-2"></i>Contact Information
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <% if (venueRequest.contactPerson.name) { %>
              <div class="col-md-4">
                <strong>Contact Person:</strong>
                <p><%= venueRequest.contactPerson.name %></p>
              </div>
            <% } %>
            <% if (venueRequest.contactPerson.phone) { %>
              <div class="col-md-4">
                <strong>Phone:</strong>
                <p><%= venueRequest.contactPerson.phone %></p>
              </div>
            <% } %>
            <% if (venueRequest.contactPerson.email) { %>
              <div class="col-md-4">
                <strong>Email:</strong>
                <p><%= venueRequest.contactPerson.email %></p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Images -->
    <% if (venueRequest.images && venueRequest.images.length > 0) { %>
      <div class="card mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-images me-2"></i>Venue Images
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <% venueRequest.images.forEach((image, index) => { %>
              <div class="col-md-4 mb-3">
                <img src="<%= image %>" alt="Venue Image <%= index + 1 %>" 
                     class="img-fluid rounded" style="height: 200px; object-fit: cover; width: 100%;">
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Sidebar -->
  <div class="col-lg-4">
    <!-- Request Timeline -->
    <div class="card mb-4">
      <div class="card-header bg-light">
        <h5 class="mb-0">
          <i class="bi bi-clock-history me-2"></i>Request Timeline
        </h5>
      </div>
      <div class="card-body">
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-marker bg-primary"></div>
            <div class="timeline-content">
              <h6 class="mb-1">Request Submitted</h6>
              <small class="text-muted">
                <%= venueRequest.createdAt.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                }) %>
              </small>
              <br><small class="text-muted">By: <%= venueRequest.user.name %></small>
            </div>
          </div>
          
          <% if (venueRequest.reviewedAt) { %>
            <div class="timeline-item">
              <div class="timeline-marker <%= venueRequest.status === 'approved' ? 'bg-success' : 'bg-danger' %>"></div>
              <div class="timeline-content">
                <h6 class="mb-1">Request <%= venueRequest.status.charAt(0).toUpperCase() + venueRequest.status.slice(1) %></h6>
                <small class="text-muted">
                  <%= venueRequest.reviewedAt.toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'long', 
                      day: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit'
                  }) %>
                </small>
                <% if (venueRequest.reviewedBy) { %>
                  <br><small class="text-muted">By: <%= venueRequest.reviewedBy.name %></small>
                <% } %>
              </div>
            </div>
          <% } %>
          
          <% if (venueRequest.status === 'approved' && venueRequest.createdVenue) { %>
            <div class="timeline-item">
              <div class="timeline-marker bg-info"></div>
              <div class="timeline-content">
                <h6 class="mb-1">Venue Created</h6>
                <small class="text-muted">
                  Venue is now available on the platform
                  <% if (venueRequest.createdVenue.isActive) { %>
                    (Active)
                  <% } else { %>
                    (Inactive)
                  <% } %>
                </small>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Admin Response -->
    <% if (venueRequest.status !== 'pending') { %>
      <div class="card mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-chat-dots me-2"></i>Admin Response
          </h5>
        </div>
        <div class="card-body">
          <% if (venueRequest.status === 'approved') { %>
            <div class="alert alert-success">
              <i class="bi bi-check-circle me-2"></i>
              <strong>Approved</strong> - Venue has been created
            </div>
            <% if (venueRequest.adminNotes) { %>
              <strong>Admin Notes:</strong>
              <p><%= venueRequest.adminNotes %></p>
            <% } %>
          <% } else if (venueRequest.status === 'rejected') { %>
            <div class="alert alert-danger">
              <i class="bi bi-x-circle me-2"></i>
              <strong>Rejected</strong>
            </div>
            <% if (venueRequest.rejectionReason) { %>
              <strong>Rejection Reason:</strong>
              <p><%= venueRequest.rejectionReason %></p>
            <% } %>
            <% if (venueRequest.adminNotes) { %>
              <strong>Admin Notes:</strong>
              <p><%= venueRequest.adminNotes %></p>
            <% } %>
          <% } else if (venueRequest.status === 'cancelled') { %>
            <div class="alert alert-secondary">
              <i class="bi bi-slash-circle me-2"></i>
              <strong>Cancelled by User</strong>
            </div>
            <% if (venueRequest.cancelReason) { %>
              <strong>Cancel Reason:</strong>
              <p><%= venueRequest.cancelReason %></p>
            <% } %>
            <% if (venueRequest.cancelledAt) { %>
              <p class="text-muted mb-0">Cancelled on <%= new Date(venueRequest.cancelledAt).toLocaleString() %></p>
            <% } %>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- User Information -->
    <div class="card mb-4">
      <div class="card-header bg-light">
        <h5 class="mb-0">
          <i class="bi bi-person me-2"></i>Submitted By
        </h5>
      </div>
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" 
               style="width: 50px; height: 50px;">
            <i class="bi bi-person-fill text-white"></i>
          </div>
          <div>
            <h6 class="mb-1"><%= venueRequest.user.name %></h6>
            <small class="text-muted"><%= venueRequest.user.email %></small>
          </div>
        </div>
        <% if (venueRequest.user.phone) { %>
          <p class="mb-2">
            <i class="bi bi-phone me-2"></i><%= venueRequest.user.phone %>
          </p>
        <% } %>
      </div>
    </div>

    <!-- Additional Links -->
    <% if (venueRequest.googleMapsLink || venueRequest.website) { %>
      <div class="card mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-link me-2"></i>Links
          </h5>
        </div>
        <div class="card-body">
          <% if (venueRequest.googleMapsLink) { %>
            <a href="<%= venueRequest.googleMapsLink %>" target="_blank" class="btn btn-outline-primary btn-sm mb-2 w-100">
              <i class="bi bi-geo-alt me-1"></i> View on Google Maps
            </a>
          <% } %>
          <% if (venueRequest.website) { %>
            <a href="<%= venueRequest.website %>" target="_blank" class="btn btn-outline-info btn-sm w-100">
              <i class="bi bi-globe me-1"></i> Visit Website
            </a>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Quick Actions -->
    <div class="card">
      <div class="card-header bg-light">
        <h5 class="mb-0">
          <i class="bi bi-gear me-2"></i>Quick Actions
        </h5>
      </div>
      <div class="card-body">
        <% if (venueRequest.status === 'pending') { %>
          <a href="/admin/venue-requests/<%= venueRequest._id %>/approve" class="btn btn-success w-100 mb-2">
            <i class="bi bi-check-circle me-1"></i> Approve Request
          </a>
          <a href="/admin/venue-requests/<%= venueRequest._id %>/reject" class="btn btn-danger w-100 mb-2">
            <i class="bi bi-x-circle me-1"></i> Reject Request
          </a>
        <% } %>
        <% if (venueRequest.status === 'approved' && venueRequest.createdVenue) { %>
          <a href="/admin/venues/<%= venueRequest.createdVenue._id %>/edit" 
             class="btn btn-info w-100 mb-2" target="_blank">
            <i class="bi bi-pencil me-1"></i> Edit Created Venue
          </a>
        <% } %>
        <form method="POST" action="/admin/venue-requests/<%= venueRequest._id %>/delete" style="display: inline;" class="w-100">
          <button type="submit" class="btn btn-outline-danger w-100" 
                  onclick="return confirm('Are you sure you want to delete this venue request?')">
            <i class="bi bi-trash me-1"></i> Delete Request
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
.timeline {
  position: relative;
  padding-left: 30px;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 15px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #dee2e6;
}

.timeline-item {
  position: relative;
  margin-bottom: 30px;
}

.timeline-marker {
  position: absolute;
  left: -23px;
  top: 5px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 3px solid white;
  box-shadow: 0 0 0 3px #dee2e6;
}

.timeline-content {
  background: #f8f9fa;
  padding: 15px;
  border-radius: 8px;
  border-left: 3px solid #007bff;
}
</style>
