<%- contentFor('body') %>

<!-- Reject Venue Request -->
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Reject Venue Request</h1>
    <div class="d-flex gap-2">
      <a href="/admin/venue-requests/<%= venueRequest._id %>" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Details
      </a>
      <a href="/admin/venue-requests" class="btn btn-outline-info">
        <i class="bi bi-list me-1"></i> All Requests
      </a>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <!-- Venue Summary Card -->
      <div class="card mb-4">
        <div class="card-header bg-danger text-white">
          <h5 class="mb-0">
            <i class="bi bi-x-circle me-2"></i>Venue to be Rejected
          </h5>
        </div>
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <% if (venueRequest.images && venueRequest.images.length > 0) { %>
              <img src="<%= venueRequest.images[0] %>" alt="<%= venueRequest.name %>" 
                   class="rounded me-3" style="width: 80px; height: 80px; object-fit: cover;">
            <% } else { %>
              <div class="bg-light rounded d-flex align-items-center justify-content-center me-3" 
                   style="width: 80px; height: 80px;">
                <i class="bi bi-building text-muted fs-2"></i>
              </div>
            <% } %>
            <div>
              <h4 class="mb-1"><%= venueRequest.name %></h4>
              <p class="text-muted mb-1"><%= venueRequest.fullAddress %></p>
              <small class="text-muted">
                Submitted by: <strong><%= venueRequest.user.name %></strong> 
                (<%= venueRequest.user.email %>)
              </small>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-3">
              <strong>Type:</strong> <%= venueRequest.venueType %>
            </div>
            <div class="col-md-3">
              <strong>Price Range:</strong> <%= venueRequest.priceRange %>
            </div>
            <% if (venueRequest.capacity) { %>
              <div class="col-md-3">
                <strong>Capacity:</strong> <%= venueRequest.capacity %>
              </div>
            <% } %>
            <div class="col-md-3">
              <strong>Submitted:</strong> 
              <%= venueRequest.createdAt.toLocaleDateString('en-US', { 
                  month: 'short', 
                  day: 'numeric' 
              }) %>
            </div>
          </div>
        </div>
      </div>

      <!-- Rejection Form -->
      <div class="card">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-x-square me-2"></i>Rejection Details
          </h5>
        </div>
        <div class="card-body">
          <form action="/admin/venue-requests/<%= venueRequest._id %>/reject" method="POST">
            <!-- Rejection Reason (Required) -->
            <div class="mb-4">
              <label for="rejectionReason" class="form-label">
                Rejection Reason <span class="text-danger">*</span>
              </label>
              <textarea class="form-control" id="rejectionReason" name="rejectionReason" rows="4" 
                        required placeholder="Please provide a clear reason for rejecting this venue request..."></textarea>
              <small class="text-muted">
                This reason will be shown to the user. Please be specific and constructive.
              </small>
            </div>

            <!-- Common Rejection Reasons -->
            <div class="mb-4">
              <label class="form-label">Common Rejection Reasons (Click to use)</label>
              <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" 
                        onclick="setRejectionReason('Incomplete information provided. Please include all required details.')">
                  Incomplete Information
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" 
                        onclick="setRejectionReason('Venue does not meet our quality standards.')">
                  Quality Standards
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" 
                        onclick="setRejectionReason('Pricing structure is not acceptable.')">
                  Pricing Issues
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" 
                        onclick="setRejectionReason('Location is not suitable for our platform.')">
                  Location Issues
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" 
                        onclick="setRejectionReason('Documentation or verification issues.')">
                  Documentation
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" 
                        onclick="setRejectionReason('Venue already exists in our system.')">
                  Duplicate Venue
                </button>
              </div>
            </div>

            <!-- Admin Notes (Optional) -->
            <div class="mb-4">
              <label for="adminNotes" class="form-label">Additional Admin Notes (Optional)</label>
              <textarea class="form-control" id="adminNotes" name="adminNotes" rows="3" 
                        placeholder="Add any internal notes or additional comments..."></textarea>
              <small class="text-muted">
                These notes are for internal use and will also be visible to the user.
              </small>
            </div>

            <!-- What happens next -->
            <div class="alert alert-warning">
              <h6><i class="bi bi-exclamation-triangle me-2"></i>What happens when you reject:</h6>
              <ul class="mb-0">
                <li>The venue request will be marked as rejected</li>
                <li>No venue will be created in the system</li>
                <li>The user will be notified of the rejection with your reason</li>
                <li>The user can submit a new request if they address the issues</li>
                <li>The rejected request will remain in the system for record keeping</li>
              </ul>
            </div>

            <!-- Submit Buttons -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <a href="/admin/venue-requests/<%= venueRequest._id %>" class="btn btn-outline-secondary me-md-2">
                Cancel
              </a>
              <button type="submit" class="btn btn-danger btn-lg">
                <i class="bi bi-x-circle me-1"></i> Reject Request
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function setRejectionReason(reason) {
  document.getElementById('rejectionReason').value = reason;
}
</script>
