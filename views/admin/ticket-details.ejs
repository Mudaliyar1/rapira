<!-- Main Content -->
<div class="container-fluid py-4">
  <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Ticket Details</h1>
        <div>
          <a href="/admin/tickets" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Tickets
          </a>
          <form action="/admin/tickets/<%= ticket._id %>/delete" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger me-2" onclick="return confirm('Are you sure you want to delete this ticket? This action cannot be undone.')">
              <i class="bi bi-trash me-1"></i> Delete Ticket
            </button>
          </form>
          <button class="btn btn-primary d-md-none" id="adminToggle">
            <i class="bi bi-list"></i>
          </button>
        </div>
      </div>

      <!-- Ticket Details -->
      <div class="row">
        <div class="col-lg-8">
          <!-- Ticket Card -->
          <div class="glass-card-dark mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
              <h3 class="card-title fw-bold mb-0">Ticket #<%= ticket._id.toString().slice(-6).toUpperCase() %></h3>
              <span class="badge <%= ticket.paymentStatus === 'completed' ? 'bg-success' : 'bg-warning' %> fs-6">
                <%= ticket.paymentStatus === 'completed' ? 'Paid' : 'Pending' %>
              </span>
            </div>
            <div class="card-body p-4">
              <!-- Concert Details -->
              <div class="mb-4">
                <h4 class="fw-bold mb-3">Concert Details</h4>
                <% if (concert) { %>
                  <div class="d-flex mb-3">
                    <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="rounded me-3" style="width: 100px; height: 100px; object-fit: cover;">
                    <div>
                      <h5 class="fw-bold mb-1"><%= concert.title %></h5>
                      <p class="text-muted mb-1">
                        <i class="bi bi-person me-1"></i> <%= concert.artist.user.name %>
                      </p>
                      <p class="text-muted mb-1">
                        <i class="bi bi-calendar3 me-1"></i> <%= toISTDateString(concert.date) %> • <%= concert.time %>
                      </p>
                      <p class="text-muted mb-0">
                        <i class="bi bi-geo-alt me-1"></i> <%= concert.venue %>, <%= concert.city %>
                      </p>
                    </div>
                  </div>
                <% } else { %>
                  <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Concert Deleted</strong> - This ticket is for a concert that has been deleted from the system.
                  </div>
                  <div class="text-muted mb-2">
                    <p>The concert associated with this ticket is no longer available in the database. However, the ticket details are still preserved.</p>
                  </div>
                <% } %>
              </div>

              <hr class="my-4">

              <!-- Ticket Details -->
              <div class="mb-4">
                <h4 class="fw-bold mb-3">Ticket Details</h4>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <p class="fw-medium mb-1">Ticket Quantity:</p>
                    <p><%= ticket.quantity %> ticket<%= ticket.quantity > 1 ? 's' : '' %></p>
                  </div>
                  <div class="col-md-6 mb-3">
                    <p class="fw-medium mb-1">Purchase Date:</p>
                    <p><%= toISTLocaleString(ticket.createdAt) %></p>
                  </div>
                  <% if (ticket.totalAmount > 0) { %>
                    <div class="col-md-6 mb-3">
                      <p class="fw-medium mb-1">Amount Paid:</p>
                      <p>₹<%= ticket.totalAmount %></p>
                    </div>
                    <div class="col-md-6 mb-3">
                      <p class="fw-medium mb-1">Payment ID:</p>
                      <p><%= ticket.paymentId || 'N/A' %></p>
                    </div>
                    <% if (ticket.commissionApplied && ticket.commissionPercentage) { %>
                    <div class="col-md-6 mb-3">
                      <p class="fw-medium mb-1">Ticket Price:</p>
                      <p>₹<%= (ticket.totalAmount / (1 + (ticket.commissionPercentage / 100))).toFixed(2) %></p>
                    </div>
                    <div class="col-md-6 mb-3">
                      <p class="fw-medium mb-1">Platform Charges:</p>
                      <p>₹<%= ticket.commissionAmount %> (<%= ticket.commissionPercentage %>%)</p>
                    </div>
                    <% } %>
                  <% } else { %>
                    <div class="col-md-6 mb-3">
                      <p class="fw-medium mb-1">Ticket Type:</p>
                      <p>Free</p>
                    </div>
                  <% } %>
                  <!-- Add attended status with validation count -->
                  <div class="col-md-6 mb-3">
                    <p class="fw-medium mb-1">Attendance Status:</p>
                    <p>
                      <% 
                        const validatedTicketsCount = ticket.validatedTicketsCount || 0;
                        const totalTickets = ticket.quantity || 1;
                        const remainingTickets = Math.max(0, totalTickets - validatedTicketsCount);
                      %>
                      <% if (validatedTicketsCount > 0) { %>
                        <span class="badge bg-success">VALIDATED <%= validatedTicketsCount %>/<%= totalTickets %></span>
                        <small class="d-block text-muted">Validated <%= validatedTicketsCount %> of <%= totalTickets %> tickets</small>
                        <% if (ticket.attendedAt) { %>
                          <small class="d-block text-muted">Last validation: <%= toISTLocaleString(ticket.attendedAt) %></small>
                        <% } %>
                        <% if (remainingTickets > 0) { %>
                          <small class="d-block text-muted"><%= remainingTickets %> ticket<%= remainingTickets > 1 ? 's' : '' %> remaining</small>
                        <% } %>
                      <% } else { %>
                        <span class="badge bg-warning">NOT ATTENDED</span>
                        <small class="d-block text-muted">Not yet validated at venue</small>
                        <small class="d-block text-muted">Total tickets in purchase: <%= totalTickets %></small>
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>

              <hr class="my-4">

              <!-- Attendee Details -->
              <div>
                <h4 class="fw-bold mb-3">Attendee Details</h4>
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Age</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% ticket.attendees.forEach((attendee, index) => { %>
                        <tr>
                          <td><%= index + 1 %></td>
                          <td><%= attendee.name %></td>
                          <td><%= attendee.age %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <!-- User Info -->
          <div class="glass-card-dark mb-4">
            <div class="card-header py-3">
              <h4 class="card-title fw-bold mb-0">User Information</h4>
            </div>
            <div class="card-body p-4">
              <div class="d-flex align-items-center mb-3">
                <% if (ticket.user.profileImage) { %>
                  <img src="<%= ticket.user.profileImage %>" alt="<%= ticket.user.name %>" class="rounded-circle me-3" width="60" height="60">
                <% } else { %>
                  <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-person fs-3"></i>
                  </div>
                <% } %>
                <div>
                  <h5 class="fw-bold mb-1"><%= ticket.user.name %></h5>
                  <p class="text-muted mb-0"><%= ticket.user.email %></p>
                </div>
              </div>

              <div class="mb-3">
                <p class="fw-medium mb-1">User ID:</p>
                <p><code><%= ticket.user._id %></code></p>
              </div>

              <div class="mb-3">
                <p class="fw-medium mb-1">Role:</p>
                <p><span class="badge bg-<%= ticket.user.role ? (ticket.user.role === 'admin' ? 'danger' : (ticket.user.role === 'artist' ? 'primary' : 'secondary')) : 'secondary' %>">
                  <%= ticket.user.role ? (ticket.user.role.charAt(0).toUpperCase() + ticket.user.role.slice(1)) : 'User' %>
                </span></p>
              </div>

              <div>
                <p class="fw-medium mb-1">Joined:</p>
                <p><%= toISTDateString(ticket.user.createdAt) %></p>
              </div>

              <div class="mt-4">
                <a href="/admin/users/<%= ticket.user._id %>" class="btn btn-outline-primary w-100">
                  <i class="bi bi-person me-1"></i> View User Profile
                </a>
              </div>
            </div>
          </div>

          <!-- QR Code -->
          <div class="glass-card-dark text-center">
            <div class="card-header py-3">
              <h4 class="card-title fw-bold mb-0">Ticket QR Code</h4>
            </div>
            <div class="card-body p-4">
              <p class="text-muted mb-3">Scan to verify ticket at the venue</p>
              <div class="d-flex justify-content-center mb-3">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=<%= ticket._id %>" alt="Ticket QR Code" class="img-fluid" style="max-width: 200px;">
              </div>
              <p class="mb-0 fw-medium">Ticket ID: <%= ticket._id %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
