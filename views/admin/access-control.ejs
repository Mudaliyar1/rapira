<!-- Admin Access Control Page -->
<div class="container-fluid">
  <!-- Super Admin Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary">
          <h5 class="mb-0 text-white">
            <i class="bi bi-shield-lock me-2"></i>Super Admin Management
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h6 class="mb-3">Current Super Admins</h6>
              <% if (superAdmins && superAdmins.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-striped table-hover">
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% superAdmins.forEach(admin => { %>
                        <tr>
                          <td><%= admin.name %></td>
                          <td><%= admin.email %></td>
                          <td>
                            <% if (admin._id.toString() !== currentUser.id) { %>
                              <form action="/admin/access-control/demote" method="POST" class="d-inline">
                                <input type="hidden" name="adminId" value="<%= admin._id %>">
                                <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Are you sure you want to demote <%= admin.name %> to Admin?')">
                                  <i class="bi bi-arrow-down-circle me-1"></i>Demote to Admin
                                </button>
                              </form>
                            <% } else { %>
                              <span class="badge bg-secondary">Current User</span>
                            <% } %>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="alert alert-info">
                  <i class="bi bi-info-circle me-2"></i><span class="text-dark fw-bold">No Super Admins found (except you).</span>
                </div>
              <% } %>
            </div>

            <div class="col-md-6">
              <h6 class="mb-3">Promote Admin to Super Admin</h6>
              <% if (adminUsers && adminUsers.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-striped table-hover">
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% adminUsers.forEach(admin => { %>
                        <tr>
                          <td><%= admin.name %></td>
                          <td><%= admin.email %></td>
                          <td>
                            <form action="/admin/access-control/promote" method="POST" class="d-inline">
                              <input type="hidden" name="adminId" value="<%= admin._id %>">
                              <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Are you sure you want to promote <%= admin.name %> to Super Admin?')">
                                <i class="bi bi-arrow-up-circle me-1"></i>Promote
                              </button>
                            </form>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="alert alert-info">
                  <i class="bi bi-info-circle me-2"></i><span class="text-dark fw-bold">No Admin users found to promote.</span>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Admin Page Permissions Section -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary">
          <h5 class="mb-0 text-white">
            <i class="bi bi-lock me-2"></i>Admin Page Access Control
          </h5>
        </div>
        <div class="card-body">
          <% if (adminUsers && adminUsers.length > 0) { %>
            <ul class="nav nav-tabs" id="adminTabs" role="tablist">
              <% adminUsers.forEach((admin, index) => { %>
                <li class="nav-item" role="presentation">
                  <button class="nav-link <%= index === 0 ? 'active' : '' %>"
                          id="admin-<%= admin._id %>-tab"
                          data-bs-toggle="tab"
                          data-bs-target="#admin-<%= admin._id %>"
                          type="button"
                          role="tab"
                          aria-controls="admin-<%= admin._id %>"
                          aria-selected="<%= index === 0 ? 'true' : 'false' %>">
                    <%= admin.name %>
                  </button>
                </li>
              <% }); %>
            </ul>

            <div class="tab-content p-3 border border-top-0 rounded-bottom" id="adminTabsContent">
              <% adminUsers.forEach((admin, index) => { %>
                <div class="tab-pane fade <%= index === 0 ? 'show active' : '' %>"
                     id="admin-<%= admin._id %>"
                     role="tabpanel"
                     aria-labelledby="admin-<%= admin._id %>-tab">

                  <form action="/admin/access-control/update-permissions" method="POST">
                    <input type="hidden" name="adminId" value="<%= admin._id %>">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <h5><%= admin.name %>'s Page Permissions</h5>
                      <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save Permissions
                      </button>
                    </div>

                    <div class="row">
                      <% Object.keys(pagesByCategory).forEach(category => { %>
                        <div class="col-md-6 mb-4">
                          <div class="card h-100">
                            <div class="card-header">
                              <h6 class="mb-0"><%= categories[category] %></h6>
                            </div>
                            <div class="card-body">
                              <div class="list-group">
                                <% pagesByCategory[category].forEach(page => { %>
                                  <div class="list-group-item">
                                    <div class="form-check">
                                      <%
                                        const adminPermission = permissionsMap[admin._id.toString()];
                                        const hasPermission = page.alwaysAccessible ||
                                          (adminPermission && adminPermission.pagePermissions.get(page.slug));
                                      %>
                                      <input class="form-check-input"
                                             type="checkbox"
                                             name="permissions"
                                             value="<%= page.slug %>"
                                             id="<%= admin._id %>-<%= page.slug %>"
                                             <%= hasPermission ? 'checked' : '' %>
                                             <%= page.alwaysAccessible ? 'checked disabled' : '' %>
                                             <%= page.superAdminOnly ? 'disabled' : '' %>>
                                      <label class="form-check-label d-flex justify-content-between align-items-center" for="<%= admin._id %>-<%= page.slug %>">
                                        <span>
                                          <i class="<%= page.icon %> me-2"></i>
                                          <%= page.name %>
                                        </span>
                                        <% if (page.alwaysAccessible) { %>
                                          <span class="badge bg-success">Always Accessible</span>
                                        <% } else if (page.superAdminOnly) { %>
                                          <span class="badge bg-danger">Super Admin Only</span>
                                        <% } %>
                                      </label>
                                    </div>
                                    <small class="text-muted d-block mt-1"><%= page.description %></small>
                                  </div>
                                <% }); %>
                              </div>
                            </div>
                          </div>
                        </div>
                      <% }); %>
                    </div>

                    <div class="text-end mt-3">
                      <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save Permissions
                      </button>
                    </div>
                  </form>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i><span class="text-dark fw-bold">No Admin users found to manage permissions.</span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Help Section -->
<div class="row mt-4">
  <div class="col-12">
    <div class="card bg-white">
      <div class="card-body">
        <h5 class="text-dark"><i class="bi bi-info-circle me-2"></i>About Admin Access Control</h5>
        <p class="text-dark">This page allows Super Admins to:</p>
        <ul class="text-dark">
          <li>Promote regular Admins to Super Admin role</li>
          <li>Demote Super Admins back to regular Admin role</li>
          <li>Control which pages each Admin can access in the Admin Dashboard</li>
        </ul>
        <p class="text-dark"><strong>Notes:</strong></p>
        <ul class="text-dark">
          <li>Pages marked as "Always Accessible" are available to all Admins</li>
          <li>Pages marked as "Super Admin Only" can only be accessed by Super Admins</li>
          <li>You cannot demote yourself from Super Admin role</li>
        </ul>
      </div>
    </div>
  </div>
</div>
