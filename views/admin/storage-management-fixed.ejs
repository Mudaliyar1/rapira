<%- contentFor('body') %>

<!-- MongoDB Atlas Storage Usage -->
<div class="row mb-4">
  <div class="col-12">
    <div class="glass-card-dark border border-secondary">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">
          <i class="bi bi-cloud me-2"></i> MongoDB Atlas Storage Usage
        </h5>
      </div>
      <div class="card-body">
        <div class="row align-items-center">
          <div class="col-md-8">
            <h6 class="text-white mb-2">Storage Used: <%= stats.dbStats.formattedTotalSize %> of <%= stats.dbStats.formattedAtlasLimit %></h6>
            <div class="progress" style="height: 25px; background-color: rgba(0,0,0,0.2);">
              <%
                let progressClass = "bg-success";
                if (stats.dbStats.usagePercentage > 70) progressClass = "bg-warning";
                if (stats.dbStats.usagePercentage > 90) progressClass = "bg-danger";
              %>
              <div class="progress-bar <%= progressClass %>" role="progressbar"
                   style="width: <%= stats.dbStats.usagePercentage %>%;"
                   aria-valuenow="<%= stats.dbStats.usagePercentage %>"
                   aria-valuemin="0"
                   aria-valuemax="100">
                <%= stats.dbStats.usagePercentage %>%
              </div>
            </div>
            <div class="d-flex justify-content-between mt-1">
              <small class="text-white-50">0 MB</small>
              <small class="text-white-50"><%= stats.dbStats.formattedAtlasLimit %></small>
            </div>
          </div>
          <div class="col-md-4 text-center">
            <div class="p-3 bg-dark bg-opacity-25 rounded mt-3 mt-md-0">
              <h6 class="text-white-50 mb-1">Remaining Storage</h6>
              <h3 class="text-white mb-0"><%= stats.dbStats.formattedRemainingStorage %></h3>
              <small class="text-white-50">Free space available</small>
            </div>
          </div>
        </div>
        <div class="alert alert-info bg-dark text-info border-info mt-3 mb-0">
          <i class="bi bi-info-circle me-2"></i>
          <strong>About Your MongoDB Atlas Plan:</strong>
          Your database is using <%= stats.dbStats.usagePercentage %>% of your 512MB free tier storage limit.
          <% if (stats.dbStats.usagePercentage > 80) { %>
            <span class="text-warning">You're approaching your storage limit. Consider deleting unnecessary data or upgrading your plan.</span>
          <% } else { %>
            You have <%= stats.dbStats.formattedRemainingStorage %> of free space remaining.
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Overview Cards -->
<div class="row g-4 mb-4">
  <div class="col-md-6 col-lg-3">
    <div class="stat-card glass-card-dark border border-secondary">
      <div class="d-flex align-items-center p-3">
        <div class="stat-icon bg-primary-subtle text-primary me-3">
          <i class="bi bi-database"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 text-white"><%= stats.totals.formattedSize %></h3>
          <p class="text-white-50 mb-0">Total Data Size</p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-3">
    <div class="stat-card glass-card-dark border border-secondary">
      <div class="d-flex align-items-center p-3">
        <div class="stat-icon bg-success-subtle text-success me-3">
          <i class="bi bi-hdd-stack"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 text-white"><%= stats.totals.formattedStorageSize %></h3>
          <p class="text-white-50 mb-0">Total Storage Size</p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-3">
    <div class="stat-card glass-card-dark border border-secondary">
      <div class="d-flex align-items-center p-3">
        <div class="stat-icon bg-info-subtle text-info me-3">
          <i class="bi bi-list-columns"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 text-white"><%= stats.totals.formattedIndexSize %></h3>
          <p class="text-white-50 mb-0">Total Index Size</p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-3">
    <div class="stat-card glass-card-dark border border-secondary">
      <div class="d-flex align-items-center p-3">
        <div class="stat-icon bg-warning-subtle text-warning me-3">
          <i class="bi bi-file-earmark"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 text-white"><%= stats.totals.documents.toLocaleString() %></h3>
          <p class="text-white-50 mb-0">Total Documents</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Metrics Explanation -->
<div class="row mb-4">
  <div class="col-12">
    <div class="glass-card-dark border border-secondary">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">
          <i class="bi bi-info-circle me-2"></i> Understanding Storage Metrics
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <h6 class="text-white"><i class="bi bi-database text-primary me-2"></i> Total Data Size</h6>
              <p class="text-white-50">
                <strong>What it is:</strong> The size of your actual data (like text, numbers, etc.)
                <br>
                <strong>In simple terms:</strong> How much space your information takes up without any extras
              </p>
            </div>
            <div class="mb-3">
              <h6 class="text-white"><i class="bi bi-hdd-stack text-success me-2"></i> Total Storage Size</h6>
              <p class="text-white-50">
                <strong>What it is:</strong> The total space used on disk including extra space reserved for future data
                <br>
                <strong>In simple terms:</strong> Like a bookshelf that's bigger than your books to leave room for new ones
              </p>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <h6 class="text-white"><i class="bi bi-list-columns text-info me-2"></i> Total Index Size</h6>
              <p class="text-white-50">
                <strong>What it is:</strong> Space used by indexes that help find data quickly
                <br>
                <strong>In simple terms:</strong> Like the index at the back of a book that helps you find information faster
              </p>
            </div>
            <div class="mb-3">
              <h6 class="text-white"><i class="bi bi-file-earmark text-warning me-2"></i> Total Documents</h6>
              <p class="text-white-50">
                <strong>What it is:</strong> The total number of records in your database
                <br>
                <strong>In simple terms:</strong> How many individual entries you have across all collections
              </p>
            </div>
          </div>
        </div>
        <div class="alert alert-info bg-dark text-info border-info mb-0">
          <i class="bi bi-lightbulb me-2"></i>
          <strong>Helpful Tip:</strong> If Storage Size is much bigger than Data Size, your database might have extra unused space that could be cleaned up.
          Think of it like having a half-empty filing cabinet that could be replaced with a smaller one.
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Storage Distribution Chart -->
<div class="row mb-4">
  <div class="col-lg-6">
    <div class="glass-card-dark h-100 border border-secondary">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">Storage Distribution by Module</h5>
      </div>
      <div class="card-body">
        <canvas id="storageDistributionChart" height="250"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="glass-card-dark h-100 border border-secondary">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">Document Count by Module</h5>
      </div>
      <div class="card-body">
        <canvas id="documentCountChart" height="250"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Module Details -->
<% Object.keys(stats.groups).forEach(function(groupName) {
  const group = stats.groups[groupName];
  if (group.collections.length > 0) {
%>
<div class="row mb-4">
  <div class="col-12">
    <div class="glass-card-dark border border-secondary">
      <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 text-white"><%= groupName %></h5>
        <div>
          <span class="badge bg-primary me-2"><%= group.formattedTotalSize %></span>
          <span class="badge bg-secondary"><%= group.totalDocuments.toLocaleString() %> docs</span>
        </div>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover table-bordered-dark mb-0">
            <thead class="table-light">
              <tr>
                <th>Collection</th>
                <th class="text-center">Documents</th>
                <th class="text-center">Data Size</th>
                <th class="text-center">Storage Size</th>
                <th class="text-center">Index Size</th>
                <th class="text-center">Avg Doc Size</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% group.collections.forEach(function(collection) { %>
              <tr>
                <td class="text-white"><%= collection.name %></td>
                <td class="text-white text-center"><%= collection.count.toLocaleString() %></td>
                <td class="text-white text-center"><%= collection.formattedSize %></td>
                <td class="text-white text-center"><%= collection.formattedStorageSize %></td>
                <td class="text-white text-center"><%= collection.formattedIndexSize %></td>
                <td class="text-white text-center"><%= collection.avgObjSize ? Math.round(collection.avgObjSize).toLocaleString() + ' B' : 'N/A' %></td>
                <td class="text-center">
                  <div class="btn-group btn-group-sm">
                    <a href="/admin/storage-management/view/<%= collection.name %>" class="btn btn-info">
                      <i class="bi bi-eye"></i> View
                    </a>
                    <a href="/admin/storage-management/confirm-delete/<%= collection.name %>" class="btn btn-danger">
                      <i class="bi bi-trash"></i> Delete
                    </a>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<% } }); %>

<!-- Refresh Button -->
<div class="row mb-4">
  <div class="col-12 text-center">
    <button id="refreshStats" class="btn btn-primary">
      <i class="bi bi-arrow-clockwise me-1"></i> Refresh Statistics
    </button>
  </div>
</div>

<%- contentFor('extraScripts') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Storage Distribution Chart
    const storageCtx = document.getElementById('storageDistributionChart').getContext('2d');
    const storageChart = new Chart(storageCtx, {
      type: 'pie',
      data: {
        labels: [
          <% Object.keys(stats.groups).forEach(function(groupName) { %>
            '<%= groupName %>',
          <% }); %>
        ],
        datasets: [{
          data: [
            <% Object.keys(stats.groups).forEach(function(groupName) { %>
              <%= stats.groups[groupName].totalSize %>,
            <% }); %>
          ],
          backgroundColor: [
            'rgba(54, 162, 235, 0.7)',
            'rgba(75, 192, 192, 0.7)',
            'rgba(255, 206, 86, 0.7)',
            'rgba(255, 99, 132, 0.7)',
            'rgba(153, 102, 255, 0.7)',
            'rgba(255, 159, 64, 0.7)'
          ],
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'right',
            labels: {
              color: 'white'
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.raw || 0;
                const formattedValue = formatBytes(value);
                const percentage = ((value / <%= stats.totals.size %>) * 100).toFixed(1);
                return `${label}: ${formattedValue} (${percentage}%)`;
              }
            }
          }
        }
      }
    });

    // Document Count Chart
    const docCtx = document.getElementById('documentCountChart').getContext('2d');
    const docChart = new Chart(docCtx, {
      type: 'bar',
      data: {
        labels: [
          <% Object.keys(stats.groups).forEach(function(groupName) { %>
            '<%= groupName %>',
          <% }); %>
        ],
        datasets: [{
          label: 'Document Count',
          data: [
            <% Object.keys(stats.groups).forEach(function(groupName) { %>
              <%= stats.groups[groupName].totalDocuments %>,
            <% }); %>
          ],
          backgroundColor: 'rgba(75, 192, 192, 0.7)',
          borderColor: 'rgba(75, 192, 192, 1)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              color: 'white'
            },
            grid: {
              color: 'rgba(255, 255, 255, 0.1)'
            }
          },
          x: {
            ticks: {
              color: 'white'
            },
            grid: {
              color: 'rgba(255, 255, 255, 0.1)'
            }
          }
        },
        plugins: {
          legend: {
            labels: {
              color: 'white'
            }
          }
        }
      }
    });

    // Format bytes function
    function formatBytes(bytes, decimals = 2) {
      if (bytes === 0) return '0 Bytes';

      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));

      return parseFloat((bytes / Math.pow(k, i)).toFixed(decimals)) + ' ' + sizes[i];
    }

    // Refresh button
    document.getElementById('refreshStats').addEventListener('click', function() {
      window.location.reload();
    });
  });
</script>
