<%- contentFor('body') %>

<div class="container-fluid">
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
          <div class="notification-header-icon me-3">
            <i class="bi bi-bell-fill text-primary"></i>
          </div>
          <div>
            <h2 class="mb-0 text-white fw-bold">Notification Management</h2>
            <p class="text-white-50 mb-0">Monitor and manage system notifications</p>
          </div>
        </div>
        <div class="d-flex gap-2">
          <button id="markAllReadBtn" class="btn btn-outline-light btn-sm" data-bs-toggle="tooltip" title="Mark all visible notifications as read">
            <i class="bi bi-check-all me-1"></i> Mark All Read
          </button>
          <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteAllModal">
            <i class="bi bi-trash me-1"></i> Delete All
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Enhanced Filters Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="glass-card-dark">
        <div class="card-header border-0">
          <h6 class="card-title mb-0 text-white d-flex align-items-center">
            <i class="bi bi-funnel me-2"></i>
            Filters & Search
          </h6>
        </div>
        <div class="card-body">
          <form method="GET" action="/admin/notifications" class="row g-3">
            <div class="col-md-3">
              <label class="form-label text-white-50 small">Module</label>
              <select name="module" class="form-select form-select-sm bg-dark text-white border-secondary">
                <option value="">All Modules</option>
                <% modules.forEach(module => { %>
                  <option value="<%= module %>" <%= filter.module === module ? 'selected' : '' %>>
                    <%= module %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label text-white-50 small">Status</label>
              <select name="status" class="form-select form-select-sm bg-dark text-white border-secondary">
                <option value="">All Statuses</option>
                <option value="Pending" <%= filter.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                <option value="Completed" <%= filter.status === 'Completed' ? 'selected' : '' %>>Completed</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label text-white-50 small">Read Status</label>
              <select name="read" class="form-select form-select-sm bg-dark text-white border-secondary">
                <option value="">All</option>
                <option value="unread" <%= filter.read === 'unread' ? 'selected' : '' %>>Unread Only</option>
                <option value="read" <%= filter.read === 'read' ? 'selected' : '' %>>Read Only</option>
              </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
              <button type="submit" class="btn btn-primary btn-sm flex-fill">
                <i class="bi bi-search me-1"></i> Apply
              </button>
              <a href="/admin/notifications" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-clockwise"></i>
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Enhanced Stats Cards -->
  <div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
      <div class="stat-card-enhanced glass-card-dark border-start border-warning border-4">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="stat-icon-enhanced bg-warning bg-opacity-20 text-warning me-3">
              <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="flex-grow-1">
              <h3 class="fw-bold mb-0 text-white counter" data-target="<%= counts.pending %>">0</h3>
              <p class="text-white-50 mb-0 small">Pending Actions</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6">
      <div class="stat-card-enhanced glass-card-dark border-start border-info border-4">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="stat-icon-enhanced bg-info bg-opacity-20 text-info me-3">
              <i class="bi bi-envelope-open"></i>
            </div>
            <div class="flex-grow-1">
              <h3 class="fw-bold mb-0 text-white counter" data-target="<%= counts.unread %>">0</h3>
              <p class="text-white-50 mb-0 small">Unread Notifications</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6">
      <div class="stat-card-enhanced glass-card-dark border-start border-success border-4">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="stat-icon-enhanced bg-success bg-opacity-20 text-success me-3">
              <i class="bi bi-check-circle"></i>
            </div>
            <div class="flex-grow-1">
              <h3 class="fw-bold mb-0 text-white counter" data-target="<%= pagination.totalCount - counts.unread %>">0</h3>
              <p class="text-white-50 mb-0 small">Read Notifications</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6">
      <div class="stat-card-enhanced glass-card-dark border-start border-primary border-4">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="stat-icon-enhanced bg-primary bg-opacity-20 text-primary me-3">
              <i class="bi bi-collection"></i>
            </div>
            <div class="flex-grow-1">
              <h3 class="fw-bold mb-0 text-white counter" data-target="<%= pagination.totalCount %>">0</h3>
              <p class="text-white-50 mb-0 small">Total Notifications</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Enhanced Notifications List -->
  <div class="row">
    <div class="col-12">
      <div class="glass-card-dark">
        <div class="card-header border-0">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="card-title mb-0 text-white d-flex align-items-center">
              <i class="bi bi-list-ul me-2"></i>
              Notifications
              <span class="badge bg-primary ms-2"><%= pagination.totalCount %></span>
            </h6>
            <div class="d-flex align-items-center gap-2">
              <small class="text-white-50">
                Showing <%= Math.min((pagination.page - 1) * pagination.limit + 1, pagination.totalCount) %>-<%= Math.min(pagination.page * pagination.limit, pagination.totalCount) %> of <%= pagination.totalCount %>
              </small>
            </div>
          </div>
        </div>
        <div class="card-body p-0">
          <% if (notifications.length === 0) { %>
            <!-- Enhanced Empty State -->
            <div class="empty-state text-center py-5">
              <div class="empty-state-icon mb-3">
                <i class="bi bi-bell-slash"></i>
              </div>
              <h5 class="text-white mb-2">No notifications found</h5>
              <p class="text-white-50 mb-3">
                <% if (filter.module || filter.status || filter.read) { %>
                  Try adjusting your filters to see more results.
                <% } else { %>
                  All caught up! No notifications to display.
                <% } %>
              </p>
              <% if (filter.module || filter.status || filter.read) { %>
                <a href="/admin/notifications" class="btn btn-outline-primary btn-sm">
                  <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
                </a>
              <% } %>
            </div>
          <% } else { %>
            <div class="notification-list">
              <% notifications.forEach((notification, index) => { %>
                <div class="notification-item <%= notification.isRead ? 'read' : 'unread' %>" 
                     data-id="<%= notification._id %>"
                     data-aos="fade-up" 
                     data-aos-delay="<%= index * 50 %>">
                  <div class="notification-content">
                    <div class="d-flex align-items-start">
                      <div class="notification-icon-wrapper me-3">
                        <div class="notification-icon module-<%= notification.module.toLowerCase().replace(/\s+/g, '-') %>">
                          <% if (notification.module === 'Artist Application') { %>
                            <i class="bi bi-person-badge"></i>
                          <% } else if (notification.module === 'Artist Upgrade') { %>
                            <i class="bi bi-arrow-up-circle"></i>
                          <% } else if (notification.module === 'Team Booking') { %>
                            <i class="bi bi-calendar-check"></i>
                          <% } else if (notification.module === 'Role Slot') { %>
                            <i class="bi bi-briefcase"></i>
                          <% } else if (notification.module === 'Artist Booking') { %>
                            <i class="bi bi-music-note-beamed"></i>
                          <% } else if (notification.module === 'Concert') { %>
                            <i class="bi bi-calendar-event"></i>
                          <% } else if (notification.module === 'Daily Concert') { %>
                            <i class="bi bi-calendar-day"></i>
                          <% } else if (notification.module === 'Learning Module') { %>
                            <i class="bi bi-book"></i>
                          <% } else { %>
                            <i class="bi bi-bell"></i>
                          <% } %>
                        </div>
                        <% if (!notification.isRead) { %>
                          <div class="unread-indicator"></div>
                        <% } %>
                      </div>
                      <div class="notification-details flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                          <div>
                            <h6 class="notification-title mb-1">
                              <%= notification.module %>
                              <% if (!notification.isRead) { %>
                                <span class="badge bg-primary badge-sm ms-1">New</span>
                              <% } %>
                            </h6>
                            <p class="notification-description mb-2"><%= notification.description %></p>
                          </div>
                          <div class="notification-actions">
                            <span class="badge notification-status-badge <%= notification.status === 'Pending' ? 'bg-warning' : 'bg-success' %> me-2">
                              <%= notification.status %>
                            </span>
                          </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                          <div class="notification-meta">
                            <small class="text-white-50 d-flex align-items-center">
                              <i class="bi bi-clock me-1"></i>
                              <span class="time-ago" data-time="<%= notification.createdAt %>">
                                <%= toISTLocaleString(notification.createdAt) %>
                              </span>
                            </small>
                          </div>
                          <div class="notification-buttons">
                            <a href="<%= notification.link %>" class="btn btn-primary btn-sm me-1" data-bs-toggle="tooltip" title="Review notification">
                              <i class="bi bi-eye me-1"></i> Review
                            </a>
                            <button class="btn btn-outline-danger btn-sm delete-notification" 
                                    data-id="<%= notification._id %>"
                                    data-bs-toggle="tooltip" 
                                    title="Delete notification">
                              <i class="bi bi-trash"></i>
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Enhanced Pagination -->
        <% if (pagination.totalPages > 1) { %>
          <div class="card-footer border-0 bg-transparent">
            <nav aria-label="Notification pagination">
              <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                  <a class="page-link bg-dark border-secondary text-white" 
                     href="?page=<%= pagination.page - 1 %>&module=<%= filter.module %>&status=<%= filter.status %>&read=<%= filter.read %>">
                    <i class="bi bi-chevron-left"></i>
                  </a>
                </li>

                <% 
                let startPage = Math.max(1, pagination.page - 2);
                let endPage = Math.min(pagination.totalPages, pagination.page + 2);
                %>

                <% if (startPage > 1) { %>
                  <li class="page-item">
                    <a class="page-link bg-dark border-secondary text-white" href="?page=1&module=<%= filter.module %>&status=<%= filter.status %>&read=<%= filter.read %>">1</a>
                  </li>
                  <% if (startPage > 2) { %>
                    <li class="page-item disabled">
                      <span class="page-link bg-dark border-secondary text-white-50">...</span>
                    </li>
                  <% } %>
                <% } %>

                <% for(let i = startPage; i <= endPage; i++) { %>
                  <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                    <a class="page-link <%= pagination.page === i ? 'bg-primary border-primary' : 'bg-dark border-secondary text-white' %>" 
                       href="?page=<%= i %>&module=<%= filter.module %>&status=<%= filter.status %>&read=<%= filter.read %>"><%= i %></a>
                  </li>
                <% } %>

                <% if (endPage < pagination.totalPages) { %>
                  <% if (endPage < pagination.totalPages - 1) { %>
                    <li class="page-item disabled">
                      <span class="page-link bg-dark border-secondary text-white-50">...</span>
                    </li>
                  <% } %>
                  <li class="page-item">
                    <a class="page-link bg-dark border-secondary text-white" href="?page=<%= pagination.totalPages %>&module=<%= filter.module %>&status=<%= filter.status %>&read=<%= filter.read %>"><%= pagination.totalPages %></a>
                  </li>
                <% } %>

                <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
                  <a class="page-link bg-dark border-secondary text-white" 
                     href="?page=<%= pagination.page + 1 %>&module=<%= filter.module %>&status=<%= filter.status %>&read=<%= filter.read %>">
                    <i class="bi bi-chevron-right"></i>
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Delete All Modal -->
<div class="modal fade" id="deleteAllModal" tabindex="-1" aria-labelledby="deleteAllModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white" id="deleteAllModalLabel">
          <i class="bi bi-exclamation-triangle text-warning me-2"></i>
          Confirm Delete All
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-white">
        <p>Are you sure you want to delete all notifications with the current filters?</p>
        <p class="text-warning small mb-0">
          <i class="bi bi-info-circle me-1"></i>
          This action cannot be undone.
        </p>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form class="d-inline" action="/admin/notifications/delete-all" method="POST">
          <input type="hidden" name="status" value="<%= filter.status %>">
          <input type="hidden" name="module" value="<%= filter.module %>">
          <input type="hidden" name="read" value="<%= filter.read %>">
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i> Delete All
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- contentFor('extraStyles') %>
<style>
  /* Enhanced notification header */
  .notification-header-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(13, 110, 253, 0.2), rgba(13, 110, 253, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    border: 2px solid rgba(13, 110, 253, 0.3);
  }

  /* Enhanced stat cards */
  .stat-card-enhanced {
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .stat-card-enhanced:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  .stat-icon-enhanced {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }

  /* Counter animation */
  .counter {
    transition: all 0.3s ease;
  }

  /* Enhanced notification list */
  .notification-list {
    max-height: 70vh;
    overflow-y: auto;
  }

  .notification-item {
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: transparent;
    transition: all 0.3s ease;
    position: relative;
    cursor: pointer;
  }

  .notification-item:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateX(5px);
  }

  .notification-item.unread {
    background: rgba(13, 110, 253, 0.1);
    border-left: 4px solid #0d6efd;
  }

  .notification-item.unread:hover {
    background: rgba(13, 110, 253, 0.15);
  }

  .notification-content {
    padding: 1.25rem;
  }

  /* Enhanced notification icons */
  .notification-icon-wrapper {
    position: relative;
  }

  .notification-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }

  .notification-icon i {
    color: #fff;
  }

  /* Module-specific icon colors */
  .module-artist-application .notification-icon {
    background: rgba(13, 110, 253, 0.2);
    border-color: rgba(13, 110, 253, 0.4);
  }

  .module-artist-upgrade .notification-icon {
    background: rgba(25, 135, 84, 0.2);
    border-color: rgba(25, 135, 84, 0.4);
  }

  .module-team-booking .notification-icon {
    background: rgba(13, 202, 240, 0.2);
    border-color: rgba(13, 202, 240, 0.4);
  }

  .module-role-slot .notification-icon {
    background: rgba(255, 193, 7, 0.2);
    border-color: rgba(255, 193, 7, 0.4);
  }

  .module-artist-booking .notification-icon {
    background: rgba(220, 53, 69, 0.2);
    border-color: rgba(220, 53, 69, 0.4);
  }

  .module-concert .notification-icon {
    background: rgba(13, 110, 253, 0.2);
    border-color: rgba(13, 110, 253, 0.4);
  }

  .module-daily-concert .notification-icon {
    background: rgba(25, 135, 84, 0.2);
    border-color: rgba(25, 135, 84, 0.4);
  }

  .module-learning-module .notification-icon {
    background: rgba(13, 202, 240, 0.2);
    border-color: rgba(13, 202, 240, 0.4);
  }

  /* Unread indicator */
  .unread-indicator {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 12px;
    height: 12px;
    background: #dc3545;
    border-radius: 50%;
    border: 2px solid #1a1d29;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
    100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
  }

  /* Notification content */
  .notification-title {
    color: #fff;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .notification-description {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .notification-meta {
    color: rgba(255, 255, 255, 0.6);
  }

  .notification-status-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }

  .notification-buttons .btn {
    transition: all 0.3s ease;
  }

  .notification-buttons .btn:hover {
    transform: translateY(-1px);
  }

  /* Enhanced empty state */
  .empty-state {
    padding: 4rem 2rem;
  }

  .empty-state-icon {
    font-size: 4rem;
    color: rgba(255, 255, 255, 0.3);
  }

  /* Enhanced pagination */
  .pagination .page-link {
    transition: all 0.3s ease;
  }

  .pagination .page-link:hover {
    transform: translateY(-1px);
  }

  /* Responsive improvements */
  @media (max-width: 768px) {
    .notification-content {
      padding: 1rem;
    }
    
    .notification-icon {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }
    
    .notification-buttons {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .notification-buttons .btn {
      width: 100%;
      font-size: 0.875rem;
    }
  }

  /* Loading states */
  .loading {
    opacity: 0.6;
    pointer-events: none;
  }

  /* Toast notifications */
  .toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1055;
  }

  /* Scrollbar styling */
  .notification-list::-webkit-scrollbar {
    width: 6px;
  }

  .notification-list::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  .notification-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
  }

  .notification-list::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.5);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize tooltips
  const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });

  // Counter animation
  function animateCounters() {
    const counters = document.querySelectorAll('.counter');
    counters.forEach(counter => {
      const target = parseInt(counter.getAttribute('data-target'));
      const duration = 1000;
      const step = target / (duration / 16);
      let current = 0;
      
      const timer = setInterval(() => {
        current += step;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        counter.textContent = Math.floor(current);
      }, 16);
    });
  }

  // Run counter animation
  setTimeout(animateCounters, 300);

  // Time ago functionality
  function updateTimeAgo() {
    const timeElements = document.querySelectorAll('.time-ago');
    timeElements.forEach(element => {
      const time = new Date(element.getAttribute('data-time'));
      const now = new Date();
      const diff = now - time;
      
      const minutes = Math.floor(diff / 60000);
      const hours = Math.floor(diff / 3600000);
      const days = Math.floor(diff / 86400000);
      
      let timeAgo;
      if (minutes < 1) {
        timeAgo = 'Just now';
      } else if (minutes < 60) {
        timeAgo = `${minutes}m ago`;
      } else if (hours < 24) {
        timeAgo = `${hours}h ago`;
      } else {
        timeAgo = `${days}d ago`;
      }
      
      element.textContent = timeAgo;
    });
  }

  // Update time ago every minute
  updateTimeAgo();
  setInterval(updateTimeAgo, 60000);

  // Enhanced notification interactions
  const notificationItems = document.querySelectorAll('.notification-item');
  notificationItems.forEach(item => {
    item.addEventListener('click', function(e) {
      // Don't mark as read if clicking on buttons
      if (e.target.closest('.notification-buttons')) {
        return;
      }

      const notificationId = this.dataset.id;
      if (!this.classList.contains('read')) {
        markAsRead(notificationId);
      }
    });
  });

  // Delete notification functionality
  const deleteButtons = document.querySelectorAll('.delete-notification');
  deleteButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.stopPropagation();
      const notificationId = this.dataset.id;
      
      if (confirm('Are you sure you want to delete this notification?')) {
        deleteNotification(notificationId);
      }
    });
  });

  // Mark all as read
  const markAllReadBtn = document.getElementById('markAllReadBtn');
  if (markAllReadBtn) {
    markAllReadBtn.addEventListener('click', function() {
      markAllAsRead();
    });
  }

  // Functions
  function markAsRead(id) {
    const item = document.querySelector(`.notification-item[data-id="${id}"]`);
    if (item) {
      item.classList.add('loading');
    }

    fetch(`/admin/notifications/mark-read/${id}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        item.classList.remove('unread');
        item.classList.add('read');
        item.querySelector('.unread-indicator').remove();
        updateUnreadCount();
      }
    })
    .catch(error => {
      console.error('Error marking notification as read:', error);
    })
    .finally(() => {
      item.classList.remove('loading');
    });
  }

  function markAllAsRead() {
    fetch('/admin/notifications/mark-all-read', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        const unreadItems = document.querySelectorAll('.notification-item.unread');
        unreadItems.forEach(item => {
          item.classList.remove('unread');
          item.classList.add('read');
          item.querySelector('.unread-indicator').remove();
        });
        updateUnreadCount();
      }
    })
    .catch(error => {
      console.error('Error marking all notifications as read:', error);
    });
  }

  function updateUnreadCount() {
    fetch('/admin/notifications/unread-count')
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          const badge = document.getElementById('notificationBadge');
          if (badge) {
            badge.textContent = data.count;

            if (data.count === 0) {
              badge.style.display = 'none';
            } else {
              badge.style.display = 'inline-block';
            }
          }
        }
      })
      .catch(error => {
        console.error('Error updating unread count:', error);
      });
  }
});
</script>



