<%- contentFor('body') %>

<!-- Confirm Delete Role -->
<div class="glass-card-dark border border-secondary">
  <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 text-white">Confirm Delete Role</h5>
    <a href="/roles" class="btn btn-sm btn-outline-light">
      <i class="bi bi-arrow-left"></i> Back to Roles
    </a>
  </div>
  <div class="card-body">
    <div class="alert alert-danger">
      <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i> Warning</h5>
      <p>Are you sure you want to delete the role <strong><%= role.name %></strong>?</p>
      <p class="mb-0">This action cannot be undone.</p>
    </div>

    <div class="mb-4">
      <div class="glass-card-dark p-3 border border-danger rounded">
        <h6 class="text-white mb-3">Role Information</h6>
        <p class="mb-2">
          <span class="fw-medium text-white">Name:</span>
          <span class="text-white-75"><%= role.name %></span>
        </p>
        <p class="mb-2">
          <span class="fw-medium text-white">Description:</span>
          <span class="text-white-75"><%= role.description || 'No description' %></span>
        </p>
        <p class="mb-0">
          <span class="fw-medium text-white">Icon:</span>
          <span class="text-white-75"><i class="bi <%= role.icon %>"></i> <%= role.icon %></span>
        </p>
      </div>
    </div>

    <% if (isAssigned) { %>
      <div class="alert alert-warning">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>Note:</strong> This role is currently assigned to users. If you delete this role, it will be automatically removed from all users.
      </div>
    <% } %>

    <form action="/roles/delete/<%= role._id %>" method="POST">
      <div class="d-flex justify-content-end">
        <% if (isAssigned) { %>
          <a href="/roles/user-roles" class="btn btn-warning me-2">
            <i class="bi bi-people-fill me-1"></i> Manage User Roles
          </a>
        <% } %>
        <a href="/roles" class="btn btn-outline-light me-2">Cancel</a>
        <button type="submit" class="btn btn-danger">
          <i class="bi bi-trash me-1"></i> Delete Role
        </button>
      </div>
    </form>
  </div>
</div>
