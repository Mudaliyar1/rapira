<!-- New Admin Posts List (compact, SSR, no spinner) -->
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="fw-bold mb-1">📸 Manage Artist Posts</h2>
      <p class="text-muted mb-0">Review, hide, or delete artist posts</p>
    </div>
    <span class="badge bg-info fs-6">Total Posts: <%= posts.length %></span>
  </div>

  <!-- Search and Filter Section -->
  <div class="card mb-4 border border-secondary" style="background: transparent !important;">
    <div class="card-body" style="background: transparent !important;">
      <form method="GET" action="/admin/posts" id="postSearchForm">
        <div class="row g-2 align-items-end">
          <div class="col-md-3 col-lg-3">
            <label for="search" class="form-label small mb-1 fw-bold">Search</label>
            <div class="input-group input-group-sm">
              <span class="input-group-text" style="background: transparent !important; color: white;"><i class="bi bi-search"></i></span>
              <input type="text" class="form-control" style="background: transparent !important; color: white;" id="search" name="search" placeholder="Artist name..." value="<%= searchParams.search %>">
            </div>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <label for="state" class="form-label small mb-1 fw-bold">State</label>
            <select class="form-select form-select-sm" style="background: transparent !important; color: white;" id="state" name="state">
              <option value="" style="color: black;" <%= !searchParams.state ? 'selected' : '' %>>All States</option>
              <% if (typeof states !== 'undefined' && states.length > 0) { %>
                <% states.forEach(s => { %>
                  <option value="<%= s %>" style="color: black;" <%= searchParams.state === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <label for="city" class="form-label small mb-1 fw-bold">City</label>
            <select class="form-select form-select-sm" style="background: transparent !important; color: white;" id="city" name="city">
              <option value="" style="color: black;" <%= !searchParams.city ? 'selected' : '' %>>All Cities</option>
              <% if (typeof cities !== 'undefined' && cities.length > 0) { %>
                <% cities.forEach(c => { %>
                  <option value="<%= c %>" style="color: black;" <%= searchParams.city === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <label for="genre" class="form-label small mb-1 fw-bold">Genre</label>
            <select class="form-select form-select-sm" style="background: transparent !important; color: white;" id="genre" name="genre">
              <option value="all" style="color: black;" <%= searchParams.genre === 'all' ? 'selected' : '' %>>All Genres</option>
              <% if (typeof genres !== 'undefined' && genres.length > 0) { %>
                <% genres.forEach(g => { %>
                  <option value="<%= g %>" style="color: black;" <%= searchParams.genre === g ? 'selected' : '' %>><%= g %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <label for="status" class="form-label small mb-1 fw-bold">Status</label>
            <select class="form-select form-select-sm" style="background: transparent !important; color: white;" id="status" name="status">
              <option value="all" style="color: black;" <%= searchParams.status === 'all' ? 'selected' : '' %>>All</option>
              <option value="active" style="color: black;" <%= searchParams.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="hidden" style="color: black;" <%= searchParams.status === 'hidden' ? 'selected' : '' %>>Hidden</option>
            </select>
          </div>
          <div class="col-md-12 col-lg-1 mt-3 mt-lg-0 text-end">
            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter"></i> Filter</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">All Posts</h5>
      <span class="badge bg-secondary"><%= posts.length %></span>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle" style="min-width: 1300px; table-layout: fixed;">
          <thead class="table-light">
            <tr>
              <th style="width:100px;">Media</th>
              <th style="width:160px;">Artist</th>
              <th class="caption-col" style="width:320px;">Caption</th>
              <th style="width:150px;">Status</th>
              <th style="width:70px;">Likes</th>
              <th style="width:70px;">Shares</th>
              <th style="width:70px;">Views</th>
              <th style="width:120px;">Date</th>
              <th style="width:240px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!posts.length) { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">No posts found</td>
              </tr>
            <% } else { %>
              <% posts.forEach(post => { const media = post.media || {}; const mediaType = media.mediaType || media.type || 'image'; const mediaUrl = media.url || ''; const artist = post.artist || {}; const artistName = (artist.user && artist.user.name) || artist.stageName || 'Unknown'; const statusBadge = post.isActive ? 'success' : 'secondary'; const statusText = post.isActive ? 'Active' : 'Hidden'; const captionText = (post.caption || '(no caption)').replace(/\s+/g, ' ').trim(); const captionPreview = captionText.length > 120 ? (captionText.slice(0, 120) + '...') : captionText; %>
                <tr>
                  <td style="width:100px;">
                    <div style="width:80px;height:80px;overflow:hidden;border-radius:8px;background:#0f0f0f;border:1px solid rgba(255,255,255,0.08);">
                      <% if (mediaType === 'image') { %>
                        <img src="<%= mediaUrl %>" alt="post" style="width:80px;height:80px;object-fit:cover;display:block;border-radius:6px;">
                      <% } else { %>
                        <video muted style="width:80px;height:80px;object-fit:cover;display:block;border-radius:6px;"><source src="<%= mediaUrl %>"></video>
                      <% } %>
                    </div>
                  </td>
                  <td><small><%= artistName %></small></td>
                  <td class="caption-col" style="width:320px;"><small class="post-caption" title="<%= captionText %>"><%= captionPreview %></small></td>
                  <td>
                    <div class="d-flex gap-2 flex-wrap">
                      <span class="badge bg-<%= statusBadge %>" style="font-size:.8rem;"><%= statusText %></span>
                    </div>
                  </td>
                  <td><%= post.likesCount || 0 %></td>
                  <td><%= post.shares || 0 %></td>
                  <td><%= post.views || 0 %></td>
                  <td><small><%= toISTDateString(post.createdAt) %></small></td>
                  <td>
                    <div class="d-flex flex-wrap gap-2">
                      <a class="btn btn-sm btn-outline-info" href="/admin/artist-posts/<%= post._id %>" title="View">
                        <i class="bi bi-eye"></i>
                      </a>
                      <% if (!post.isActive) { %>
                        <a class="btn btn-sm btn-outline-success" href="/admin/artist-posts/<%= post._id %>/unrestrict" title="Unhide"><i class="bi bi-eye"></i> Unhide</a>
                      <% } else { %>
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/artist-posts/<%= post._id %>/restrict" title="Hide"><i class="bi bi-eye-slash"></i> Hide</a>
                      <% } %>
                      <a class="btn btn-sm btn-outline-danger" href="/admin/artist-posts/<%= post._id %>/delete" title="Delete"><i class="bi bi-trash"></i></a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  .caption-col {
    width: 320px;
    max-width: 320px;
  }

  .post-caption {
    display: block;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .caption-col {
      width: 180px;
      max-width: 180px;
    }

    .post-caption {
      font-size: 0.75rem;
    }
  }
</style>

<script></script>
