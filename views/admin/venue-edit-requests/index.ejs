<%- contentFor('body') %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-md-8">
      <h1 class="fw-bold">
        <i class="bi bi-building-gear me-2"></i>Venue Edit Requests
      </h1>
      <p class="text-muted mb-0">Review and manage venue modification requests from users</p>
    </div>
    <div class="col-md-4 text-md-end">
      <div class="btn-group" role="group">
        <a href="/admin/venues" class="btn btn-outline-secondary">
          <i class="bi bi-building me-1"></i> Manage Venues
        </a>
        <a href="/admin/venue-requests" class="btn btn-outline-info">
          <i class="bi bi-building-plus me-1"></i> New Requests
        </a>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h4 class="mb-0"><%= stats.total %></h4>
              <p class="mb-0">Total Requests</p>
            </div>
            <div class="align-self-center">
              <i class="bi bi-list-check display-6"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h4 class="mb-0"><%= stats.pending %></h4>
              <p class="mb-0">Pending Review</p>
            </div>
            <div class="align-self-center">
              <i class="bi bi-hourglass-split display-6"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h4 class="mb-0"><%= stats.approved %></h4>
              <p class="mb-0">Approved</p>
            </div>
            <div class="align-self-center">
              <i class="bi bi-check-circle display-6"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-danger text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h4 class="mb-0"><%= stats.rejected %></h4>
              <p class="mb-0">Rejected</p>
            </div>
            <div class="align-self-center">
              <i class="bi bi-x-circle display-6"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Options -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <form method="GET" action="/admin/venue-edit-requests" class="row g-3">
            <div class="col-md-3">
              <label class="form-label">Status</label>
              <select name="status" class="form-select">
                <option value="">All Status</option>
                <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Approved</option>
                <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Rejected</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Date Range</label>
              <select name="dateRange" class="form-select">
                <option value="">All Time</option>
                <option value="today" <%= dateRange === 'today' ? 'selected' : '' %>>Today</option>
                <option value="week" <%= dateRange === 'week' ? 'selected' : '' %>>This Week</option>
                <option value="month" <%= dateRange === 'month' ? 'selected' : '' %>>This Month</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Search</label>
              <input type="text" name="search" class="form-control" placeholder="Search venue name or user..." value="<%= search || '' %>">
            </div>
            <div class="col-md-2">
              <label class="form-label">&nbsp;</label>
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-1"></i> Filter
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Requests Table -->
  <div class="row">
    <div class="col-12">
      <% if (editRequests.length === 0) { %>
        <div class="card">
          <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-1 text-muted mb-3"></i>
            <h4 class="text-muted mt-3">No venue edit requests found</h4>
            <p class="text-muted">There are no venue edit requests matching your current filters.</p>
            <% if (status || search || dateRange) { %>
              <a href="/admin/venue-edit-requests" class="btn btn-outline-primary">
                <i class="bi bi-arrow-clockwise me-1"></i> Clear Filters
              </a>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">
              <i class="bi bi-list me-2"></i>Edit Requests
              <span class="badge bg-secondary ms-2"><%= editRequests.length %></span>
            </h5>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Request ID</th>
                    <th>Venue</th>
                    <th>User</th>
                    <th>Changes</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% editRequests.forEach(request => { %>
                    <tr>
                      <td>
                        <code>#<%= request._id.toString().slice(-6) %></code>
                      </td>
                      <td>
                        <% if (request.venue) { %>
                          <strong><%= request.venue.name %></strong><br>
                          <small class="text-muted">
                            <i class="bi bi-geo-alt me-1"></i><%= request.venue.city %>, <%= request.venue.state %>
                          </small>
                        <% } else { %>
                          <span class="text-muted">Venue deleted</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (request.user) { %>
                          <strong><%= request.user.name %></strong><br>
                          <small class="text-muted"><%= request.user.email %></small>
                        <% } else { %>
                          <span class="text-muted">User deleted</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (request.changedFields && request.changedFields.length > 0) { %>
                          <% request.changedFields.slice(0, 3).forEach(field => { %>
                            <span class="badge bg-info me-1"><%= field %></span>
                          <% }); %>
                          <% if (request.changedFields.length > 3) { %>
                            <span class="badge bg-secondary">+<%= request.changedFields.length - 3 %> more</span>
                          <% } %>
                        <% } else { %>
                          <span class="text-muted">No changes</span>
                        <% } %>
                      </td>
                      <td>
                        <strong><%= new Date(request.createdAt).toLocaleDateString() %></strong><br>
                        <small class="text-muted"><%= new Date(request.createdAt).toLocaleTimeString() %></small>
                      </td>
                      <td>
                        <% 
                          let statusClass = '';
                          let statusIcon = '';
                          switch(request.status) {
                            case 'pending':
                              statusClass = 'warning';
                              statusIcon = 'hourglass-split';
                              break;
                            case 'approved':
                              statusClass = 'success';
                              statusIcon = 'check-circle';
                              break;
                            case 'rejected':
                              statusClass = 'danger';
                              statusIcon = 'x-circle';
                              break;
                            default:
                              statusClass = 'secondary';
                              statusIcon = 'question-circle';
                          }
                        %>
                        <span class="badge bg-<%= statusClass %>">
                          <i class="bi bi-<%= statusIcon %> me-1"></i>
                          <%= request.status.charAt(0).toUpperCase() + request.status.slice(1) %>
                        </span>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm" role="group">
                          <a href="/admin/venue-edit-requests/<%= request._id %>" class="btn btn-outline-info" title="View Details">
                            <i class="bi bi-eye"></i>
                          </a>
                          <% if (request.status === 'pending') { %>
                            <a href="/admin/venue-edit-requests/<%= request._id %>/approve" class="btn btn-outline-success" title="Approve">
                              <i class="bi bi-check"></i>
                            </a>
                            <a href="/admin/venue-edit-requests/<%= request._id %>/reject" class="btn btn-outline-danger" title="Reject">
                              <i class="bi bi-x"></i>
                            </a>
                          <% } %>
                          <form method="POST" action="/admin/venue-edit-requests/<%= request._id %>/delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this venue edit request? This action cannot be undone.');">
                            <button type="submit" class="btn btn-outline-danger" title="Delete Request">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="row mt-4">
      <div class="col-12">
        <nav aria-label="Page navigation">
          <ul class="pagination justify-content-center">
            <% if (currentPage > 1) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage - 1 %><%= status ? '&status=' + status : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= dateRange ? '&dateRange=' + dateRange : '' %>">
                  <i class="bi bi-chevron-left"></i>
                </a>
              </li>
            <% } %>
            
            <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
              <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %><%= status ? '&status=' + status : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= dateRange ? '&dateRange=' + dateRange : '' %>">
                  <%= i %>
                </a>
              </li>
            <% } %>
            
            <% if (currentPage < totalPages) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= currentPage + 1 %><%= status ? '&status=' + status : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= dateRange ? '&dateRange=' + dateRange : '' %>">
                  <i class="bi bi-chevron-right"></i>
                </a>
              </li>
            <% } %>
          </ul>
        </nav>
      </div>
    </div>
  <% } %>
</div>

<style>
.card {
  border: none;
  box-shadow: 0 0 15px rgba(0,0,0,0.1);
}

.table th {
  border-top: none;
  font-weight: 600;
  color: #495057;
}

.badge {
  font-size: 0.75em;
}

.btn-group-sm .btn {
  padding: 0.25rem 0.5rem;
}

.display-6 {
  opacity: 0.8;
}
</style>
