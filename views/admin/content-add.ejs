<%- contentFor('body') %>

<!-- Add Content -->
<div class="mb-4 d-flex justify-content-between align-items-center">
  <div>
    <h1 class="fw-bold">Add New Content</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/admin/content">Content</a></li>
        <li class="breadcrumb-item active" aria-current="page">Add New</li>
      </ol>
    </nav>
  </div>
  <a href="/admin/content" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back to Content
  </a>
</div>

<!-- Add Content Form -->
<div class="glass-card-dark">
  <div class="card-header">
    <h5 class="card-title mb-0">Content Information</h5>
  </div>
  <div class="card-body">
    <form action="/admin/content/add" method="POST" enctype="multipart/form-data" id="contentForm">
      <div class="row g-4">
        <!-- Content Details -->
        <div class="col-md-8">
          <div class="mb-3">
            <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="title" name="title" required>
          </div>
          
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" name="description" rows="3"></textarea>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="type" class="form-label">Content Type <span class="text-danger">*</span></label>
                <select class="form-select" id="type" name="type" required>
                  <option value="" selected disabled>Select content type</option>
                  <option value="song">Song</option>
                  <option value="video">Video</option>
                  <option value="lyrics">Lyrics</option>
                </select>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="mb-3">
                <label for="artist" class="form-label">Artist <span class="text-danger">*</span></label>
                <select class="form-select" id="artist" name="artist" required>
                  <option value="" selected disabled>Select artist</option>
                  <% artists.forEach(artist => { %>
                    <option value="<%= artist._id %>"><%= artist.user ? artist.user.name : 'Unknown Artist' %></option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="releaseDate" class="form-label">Release Date</label>
                <input type="date" class="form-control" id="releaseDate" name="releaseDate">
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="mb-3">
                <label for="tags" class="form-label">Tags (comma separated)</label>
                <input type="text" class="form-control" id="tags" name="tags" placeholder="rap, hip-hop, indie">
              </div>
            </div>
          </div>
          
          <div class="mb-3">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="featured" name="featured">
              <label class="form-check-label" for="featured">
                Feature this content on the homepage
              </label>
            </div>
          </div>
          
          <!-- Lyrics field (only shown for lyrics content type) -->
          <div class="mb-3" id="lyricsField" style="display: none;">
            <label for="lyrics" class="form-label">Lyrics</label>
            <textarea class="form-control" id="lyrics" name="lyrics" rows="6"></textarea>
          </div>
        </div>
        
        <!-- File Uploads -->
        <div class="col-md-4">
          <div class="mb-4">
            <label for="thumbnailFile" class="form-label">Thumbnail Image</label>
            <input type="file" class="form-control" id="thumbnailFile" name="thumbnailFile" accept="image/*">
            <div class="form-text">Recommended size: 800x800px</div>
            <div class="mt-2">
              <img id="thumbnailPreview" src="/images/default-content.jpg" alt="Thumbnail Preview" class="img-fluid rounded" style="max-height: 200px; width: auto;">
            </div>
          </div>
          
          <div class="mb-3">
            <label for="contentFile" class="form-label">Content File <span class="text-danger">*</span></label>
            <input type="file" class="form-control" id="contentFile" name="contentFile" required>
            <div class="form-text" id="contentFileHelp">
              Upload the appropriate file for your content type
            </div>
          </div>
          
          <div class="alert alert-info mt-4">
            <h6 class="alert-heading"><i class="bi bi-info-circle me-1"></i> File Type Requirements</h6>
            <ul class="mb-0 small">
              <li><strong>Song:</strong> MP3, WAV, AAC</li>
              <li><strong>Video:</strong> MP4, MOV, WebM</li>
              <li><strong>Lyrics:</strong> PDF, DOC, DOCX, TXT</li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="d-flex justify-content-end mt-4">
        <a href="/admin/content" class="btn btn-outline-secondary me-2">Cancel</a>
        <button type="submit" class="btn btn-primary">Add Content</button>
      </div>
    </form>
  </div>
</div>

<%- contentFor('title') %>Add New Content

<%- contentFor('extraScripts') %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Get form elements
    const contentTypeSelect = document.getElementById('type');
    const contentFileInput = document.getElementById('contentFile');
    const contentFileHelp = document.getElementById('contentFileHelp');
    const lyricsField = document.getElementById('lyricsField');
    const thumbnailInput = document.getElementById('thumbnailFile');
    const thumbnailPreview = document.getElementById('thumbnailPreview');
    
    // Update content file help text based on selected content type
    contentTypeSelect.addEventListener('change', function() {
      const selectedType = this.value;
      
      // Show/hide lyrics field
      if (selectedType === 'lyrics') {
        lyricsField.style.display = 'block';
      } else {
        lyricsField.style.display = 'none';
      }
      
      // Update help text
      switch (selectedType) {
        case 'song':
          contentFileHelp.textContent = 'Please upload an audio file (MP3, WAV, AAC)';
          contentFileInput.accept = 'audio/*';
          break;
        case 'video':
          contentFileHelp.textContent = 'Please upload a video file (MP4, MOV, WebM)';
          contentFileInput.accept = 'video/*';
          break;
        case 'lyrics':
          contentFileHelp.textContent = 'Please upload a document file (PDF, DOC, DOCX, TXT)';
          contentFileInput.accept = '.pdf,.doc,.docx,.txt';
          break;
        default:
          contentFileHelp.textContent = 'Upload the appropriate file for your content type';
          contentFileInput.accept = '';
      }
    });
    
    // Thumbnail preview
    thumbnailInput.addEventListener('change', function() {
      if (this.files && this.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          thumbnailPreview.src = e.target.result;
        };
        reader.readAsDataURL(this.files[0]);
      }
    });
  });
</script>
