<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="glass-card-dark border border-info p-4">
        <div class="d-flex align-items-center mb-4">
          <i class="bi bi-unlock-fill text-info" style="font-size: 2rem;"></i>
          <h3 class="text-info ms-3 mb-0">Confirm Unblock Artist</h3>
        </div>

        <!-- Artist Info -->
        <div class="glass-card-dark border border-secondary p-3 mb-4">
          <div class="row align-items-center">
            <div class="col-auto">
              <% if (artist.user && artist.user.profileImage) { %>
                <img src="<%= artist.user.profileImage %>" alt="<%= artist.stageName %>" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover; border: 2px solid #0dcaf0;">
              <% } else { %>
                <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                  <i class="bi bi-person-fill text-white" style="font-size: 2rem;"></i>
                </div>
              <% } %>
            </div>
            <div class="col">
              <h5 class="text-white mb-1"><%= artist.stageName %></h5>
              <p class="text-white-50 mb-1"><%= artist.user ? artist.user.email : 'N/A' %></p>
              <p class="text-white-50 mb-0"><i class="bi bi-music-note-beamed"></i> <%= artist.genre %></p>
            </div>
          </div>
        </div>

        <!-- Block Info -->
        <div class="glass-card-dark border border-danger p-3 mb-4">
          <h6 class="text-white fw-bold mb-2">
            <i class="bi bi-lock-fill text-danger"></i> Block Information
          </h6>
          <div class="row">
            <div class="col-md-6">
              <p class="text-white-50 mb-1"><strong>Blocked On:</strong></p>
              <p class="text-white"><%= new Date(artist.blockedAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
            </div>
            <div class="col-md-6">
              <p class="text-white-50 mb-1"><strong>Blocked By:</strong></p>
              <p class="text-white"><%= artist.blockedBy ? artist.blockedBy.name : 'System' %></p>
            </div>
          </div>
          <p class="text-white-50 mb-1"><strong>Block Reason:</strong></p>
          <p class="text-white"><%= artist.blockReason %></p>
        </div>

        <!-- Info Alert -->
        <div class="alert alert-info border-info mb-4">
          <h6 class="text-info fw-bold mb-2">
            <i class="bi bi-info-circle-fill"></i> What Will Happen
          </h6>
          <ul class="mb-0">
            <li>The artist will regain access to their dashboard</li>
            <li>The artist's profile will be visible to other users again</li>
            <li>The artist can publish content and manage their concerts</li>
            <li>Any pending unblock requests will be marked as approved</li>
          </ul>
        </div>

        <!-- Unblock Form -->
        <form method="POST" action="/admin/artists/<%= artist._id %>/unblock">
          <!-- Confirmation Checkbox -->
          <div class="mb-4">
            <div class="form-check">
              <input 
                class="form-check-input" 
                type="checkbox" 
                id="confirmUnblock" 
                required
              >
              <label class="form-check-label text-white" for="confirmUnblock">
                I confirm that I want to unblock <strong><%= artist.stageName %></strong>
              </label>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="d-flex gap-2">
            <a href="/admin/artists" class="btn btn-outline-secondary">
              <i class="bi bi-x-circle"></i> Cancel
            </a>
            <button type="submit" class="btn btn-info">
              <i class="bi bi-unlock-fill"></i> Yes, Unblock This Artist
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .alert ul li {
    margin-bottom: 0.5rem;
  }
  
  .alert ul li:last-child {
    margin-bottom: 0;
  }
</style>
