<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pending Concerts - Rapira Admin</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../partials/admin-sidebar', { path: '/admin/concerts/pending' }) %>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Pending Concerts</h1>
        <button class="btn btn-primary d-md-none" id="adminToggle">
          <i class="bi bi-list"></i>
        </button>
      </div>

      <!-- Pending Concerts -->
      <% if (pendingConcerts && pendingConcerts.length > 0) { %>
        <div class="row g-4">
          <% pendingConcerts.forEach(concert => { %>
            <div class="col-lg-6">
              <div class="card h-100">
                <div class="row g-0">
                  <div class="col-md-4">
                    <img src="<%= concert.posterImage %>" class="img-fluid rounded-start h-100" alt="<%= concert.title %>" style="object-fit: cover;">
                  </div>
                  <div class="col-md-8">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0"><%= concert.title %></h5>
                        <span class="badge <%= concert.isPaid ? 'bg-primary' : 'bg-success' %>">
                          <%= concert.isPaid ? `₹${concert.price}` : 'Free' %>
                        </span>
                      </div>

                      <p class="card-text mb-1">
                        <small class="text-muted">By <%= concert.artist.user.name %> (<%= concert.artist.user.email %>)</small>
                      </p>

                      <p class="card-text text-muted mb-1">
                        <i class="bi bi-geo-alt"></i> <%= concert.venue && concert.venue.name ? concert.venue.name : concert.venue %>, <%= concert.city %>
                      </p>

                      <p class="card-text text-muted mb-2">
                        <i class="bi bi-calendar3"></i> <%= toISTDateString(concert.date) %> • <%= concert.time %>
                      </p>

                      <p class="card-text mb-3"><%= concert.description.length > 100 ? concert.description.substring(0, 100) + '...' : concert.description %></p>

                      <div class="d-flex gap-2 flex-wrap">
                        <a href="/admin/concerts/<%= concert._id %>/details" class="btn btn-outline-primary">
                          <i class="bi bi-info-circle me-1"></i> View Details
                        </a>
                        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal<%= concert._id %>">
                          <i class="bi bi-check-lg me-1"></i> Approve
                        </button>
                        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal<%= concert._id %>">
                          <i class="bi bi-x-lg me-1"></i> Reject
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Approve Modal -->
              <div class="modal fade" id="approveModal<%= concert._id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Confirm Approval</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <p>Are you sure you want to approve the concert "<%= concert.title %>"?</p>
                      <p class="mb-0">This will make the concert visible to all users and allow ticket bookings.</p>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <form action="/admin/concerts/<%= concert._id %>/approve" method="POST">
                        <button type="submit" class="btn btn-success">Approve Concert</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Reject Modal -->
              <div class="modal fade" id="rejectModal<%= concert._id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Confirm Rejection</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/admin/concerts/<%= concert._id %>/reject" method="POST">
                      <div class="modal-body">
                        <p>Are you sure you want to reject the concert "<%= concert.title %>"?</p>
                        <div class="mb-3">
                          <label for="reason" class="form-label">Rejection Reason (Optional)</label>
                          <textarea class="form-control" id="reason" name="reason" rows="3" placeholder="Provide a reason for rejection"></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Reject Concert</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="glass-card-dark">
          <div class="card-body py-5 text-center">
            <i class="bi bi-calendar-check display-1 text-muted"></i>
            <h3 class="mt-4">No Pending Concerts</h3>
            <p class="text-muted">There are no concerts waiting for approval at the moment.</p>
            <a href="/admin" class="btn btn-primary mt-3">Back to Dashboard</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Mobile Admin Toggle -->
  <button class="btn admin-toggle d-md-none" id="adminToggle">
    <i class="bi bi-list"></i>
  </button>



  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
</body>
</html>
