<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
          <div>
            <h4 class="mb-1 fw-bold">Active Distributors</h4>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item active">Distributors</li>
              </ol>
            </nav>
          </div>
          <div class="d-flex gap-2">
            <span class="badge bg-purple p-2 text-white"><%= distributors.length %> Active Distributors</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Distributor</th>
              <th>Contact</th>
              <th>Member Since</th>
              <th>Packages</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (distributors.length > 0) { %>
              <% distributors.forEach(dist => { %>
                <tr>
                  <td class="ps-4">
                    <div class="d-flex align-items-center">
                      <img src="<%= (dist.profileImage && dist.profileImage !== '/images/default-profile.svg') ? dist.profileImage : ('https://ui-avatars.com/api/?name=' + encodeURIComponent(dist.name.charAt(0).toUpperCase()) + '&background=6f42c1&color=fff&bold=true&size=200') %>"
                           class="rounded-circle me-3" width="40" height="40">
                      <div>
                        <div class="fw-bold"><%= dist.name %></div>
                        <div class="text-muted small"><%= dist.email %></div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="small">
                      <div><i class="bi bi-geo-alt me-1"></i><%= dist.city || 'India' %></div>
                    </div>
                  </td>
                  <td><%= toISTDateString(dist.createdAt) %></td>
                  <td><span class="badge bg-light text-dark">Active Dashboard</span></td>
                  <td class="text-end pe-4">
                    <button class="btn btn-sm btn-outline-danger" onclick="confirmRevoke('<%= dist._id %>', '<%= dist.name %>')">
                      <i class="bi bi-trash me-1"></i> Revoke Role
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center py-5">
                  <div class="text-muted"><i class="bi bi-broadcast fs-1 mb-2 d-block"></i> No active distributors found.</div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function confirmRevoke(id, name) {
    if (confirm(`Are you sure you want to revoke the distributor role from ${name}? They will lose access to their dashboard.`)) {
        // Here you would send a POST request to revoke the role
        alert('Revoking role...');
    }
  }
</script>
