<!-- New Admin Post Detail (dedicated page) -->
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h3 class="fw-bold mb-1">Post Details</h3>
      <p class="text-muted mb-0">Review and moderate this post</p>
    </div>
    <a class="btn btn-outline-secondary" href="/admin/posts">Back to Posts</a>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card">
        <div class="card-body">
          <% if (media.mediaType === 'image') { %>
            <img src="<%= media.url %>" class="img-fluid rounded" alt="post media">
          <% } else { %>
            <video controls class="w-100 rounded" style="max-height: 520px;"><source src="<%= media.url %>"></video>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="fw-bold mb-3"><i class="bi bi-person"></i> Artist</h5>
          <p class="mb-1"><strong>Name:</strong> <%= (post.artist && post.artist.user && post.artist.user.name) || (post.artist && post.artist.stageName) || 'Unknown' %></p>
          <p class="mb-1"><strong>Post ID:</strong> <%= post._id %></p>
          <p class="mb-1"><strong>Created:</strong> <%= toISTLocaleString(post.createdAt) %></p>
          <p class="mb-0"><strong>Status:</strong>
            <% if (post.isActive) { %>
              <span class="badge bg-success">Active</span>
            <% } else { %>
              <span class="badge bg-secondary">Hidden</span>
            <% } %>
          </p>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <h5 class="fw-bold mb-3"><i class="bi bi-chat-square-text"></i> Caption</h5>
          <p class="mb-2"><%= post.caption || '(no caption)' %></p>
          <% if (post.hashtags && post.hashtags.length) { %>
            <p class="text-muted small mb-0">Hashtags: <%= post.hashtags.map(t => '#' + t).join(' ') %></p>
          <% } %>
        </div>
      </div>

      <% if (!post.isActive && post.rejectionReason) { %>
        <div class="card mb-3 border-danger">
          <div class="card-body">
            <h6 class="text-danger fw-bold mb-2"><i class="bi bi-eye-slash"></i> Hidden Reason</h6>
            <p class="mb-0 text-danger"><%= post.rejectionReason %></p>
          </div>
        </div>
      <% } %>

      <div class="card mb-3">
        <div class="card-body">
          <div class="d-flex flex-wrap gap-3 align-items-center">
            <div><i class="bi bi-heart-fill text-danger"></i> <strong><%= post.likesCount || 0 %></strong> likes</div>
            <div><i class="bi bi-share"></i> <strong><%= post.shares || 0 %></strong> shares</div>
            <div><i class="bi bi-eye"></i> <strong><%= post.views || 0 %></strong> views</div>
            <div style="cursor:pointer;" onclick="viewPostComments('<%= post._id %>')"><i class="bi bi-chat-dots text-success"></i> <strong><%= (post.comments || []).length %></strong> comments</div>
            <div style="cursor:pointer;" onclick="viewPostReports('<%= post._id %>')"><i class="bi bi-flag text-warning"></i> <strong><%= (post.reports || []).length %></strong> reports</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-body d-flex flex-wrap gap-2">
          <% if (!post.isActive) { %>
            <a class="btn btn-success" href="/admin/artist-posts/<%= post._id %>/unrestrict"><i class="bi bi-eye"></i> Unhide Post</a>
          <% } else { %>
            <a class="btn btn-secondary" href="/admin/artist-posts/<%= post._id %>/restrict"><i class="bi bi-eye-slash"></i> Hide Post</a>
          <% } %>
          <a class="btn btn-danger" href="/admin/artist-posts/<%= post._id %>/delete"><i class="bi bi-trash"></i> Delete Post</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Post Reports Modal -->
<div class="modal fade" id="postReportsModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title"><i class="bi bi-flag"></i> Post Reports</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="reportsList" class="list-group">
          <!-- Reports populated here -->
        </div>
        <div id="noReportsMessage" class="text-center text-muted py-3" style="display: none;">
          <i class="bi bi-flag display-4 mb-3 d-block"></i>
          <p>No reports for this post</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Post Comments Modal -->
<div class="modal fade" id="postCommentsModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content text-white" style="background:#0f0f1e; border: 1px solid #333;">
      <div class="modal-header border-secondary">
        <h5 class="modal-title"><i class="bi bi-chat-dots"></i> Manage Comments</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3 d-flex gap-2">
          <input type="text" id="newCommentInputAdmin" class="form-control bg-dark text-white border-secondary" placeholder="Write a comment...">
          <button class="btn btn-success" id="addCommentBtnAdmin"><i class="bi bi-send"></i></button>
        </div>
        <div id="commentsList" class="d-flex flex-column gap-3 mt-3">
          <!-- Comments populated here -->
        </div>
        <div id="noCommentsMessage" class="text-center text-muted py-3" style="display: none;">
          <i class="bi bi-chat-dots display-4 mb-3 d-block"></i>
          <p>No comments yet</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Escape HTML to prevent XSS
const escapeHtml = (unsafe) => {
  return (unsafe || '').toString()
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
};

// Reports logic
async function viewPostReports(postId) {
  try {
    const res = await fetch(`/posts/${postId}/reports`);
    const data = await res.json();
    
    if (!res.ok || !data.success) throw new Error(data.message || 'Failed to load reports');
    
    const reportsList = document.getElementById('reportsList');
    const noReportsMessage = document.getElementById('noReportsMessage');
    
    if (!data.reports || data.reports.length === 0) {
      reportsList.innerHTML = '';
      noReportsMessage.style.display = 'block';
    } else {
      noReportsMessage.style.display = 'none';
      reportsList.innerHTML = data.reports.map(report => `
        <div class="list-group-item">
          <div class="d-flex align-items-center mb-2">
            <img src="${(report.user && report.user.profileImage) ? report.user.profileImage : '/images/default-profile.svg'}" 
                 style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; margin-right: 10px;">
            <strong>${report.user ? escapeHtml(report.user.name) : 'Anonymous'}</strong>
            <small class="ms-auto text-muted">${new Date(report.createdAt).toLocaleString('en-IN')}</small>
          </div>
          <div class="p-2 bg-light rounded text-danger border border-danger border-opacity-25">
            <strong>Reason:</strong> ${escapeHtml(report.reason)}
          </div>
        </div>
      `).join('');
    }
    
    const modal = new bootstrap.Modal(document.getElementById('postReportsModal'));
    modal.show();
  } catch (err) {
    console.error('View reports error:', err);
    alert('Failed to load reports: ' + err.message);
  }
}

let currentAdminCommentPostId = null;

// Comments logic
async function viewPostComments(postId) {
  currentAdminCommentPostId = postId;
  await refreshCommentsList(postId);
  const modal = new bootstrap.Modal(document.getElementById('postCommentsModal'));
  modal.show();
}

document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('addCommentBtnAdmin');
    if (btn) {
        btn.addEventListener('click', async () => {
            if (!currentAdminCommentPostId) return;
            const input = document.getElementById('newCommentInputAdmin');
            const text = input.value.trim();
            if (!text) return;
            
            btn.disabled = true;
            try {
                const res = await fetch(`/posts/${currentAdminCommentPostId}/comments`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text })
                });
                const data = await res.json();
                if (data.success) {
                    input.value = '';
                    await refreshCommentsList(currentAdminCommentPostId);
                } else {
                    alert(data.message || 'Failed to post comment');
                }
            } catch (err) {
                alert('Error posting comment');
            } finally {
                btn.disabled = false;
            }
        });
    }
});

async function refreshCommentsList(postId) {
  try {
    const res = await fetch(`/posts/${postId}/comments`);
    const data = await res.json();
    
    if (!res.ok || !data.success) throw new Error(data.message || 'Failed to load comments');
    
    const commentsList = document.getElementById('commentsList');
    const noCommentsMessage = document.getElementById('noCommentsMessage');
    
    if (!data.comments || data.comments.length === 0) {
      commentsList.innerHTML = '';
      noCommentsMessage.style.display = 'block';
    } else {
      noCommentsMessage.style.display = 'none';
      commentsList.innerHTML = data.comments.map(c => {
        let repliesHtml = '';
        if (c.replies && c.replies.length > 0) {
          repliesHtml = c.replies.map(r => `
            <div class="p-2 mt-2 ms-5 border-start border-secondary">
              <div class="d-flex w-100 justify-content-between align-items-start mb-1">
                <div class="d-flex align-items-center">
                  <img src="${(r.user && r.user.profileImage) ? r.user.profileImage : '/images/default-profile.svg'}" 
                       style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover; margin-right: 10px;">
                  <strong class="text-white">${r.user ? escapeHtml(r.user.name) : 'Anonymous'}</strong>
                </div>
                <small class="text-muted">${new Date(r.createdAt).toLocaleString('en-IN')}</small>
              </div>
              <p class="mb-2 text-white" style="word-break: break-all; font-size: 0.9rem;">${escapeHtml(r.text)}</p>
              <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-danger p-1" style="font-size: 0.8rem;" onclick="deleteReply('${postId}', '${c._id}', '${r._id}')">
                  <i class="bi bi-trash"></i> Delete
                </button>
              </div>
            </div>
          `).join('');
        }

        return `
        <div class="p-3 border-bottom border-secondary ${c.isPinned ? 'bg-success bg-opacity-10 border border-success rounded' : ''}">
          <div class="d-flex w-100 justify-content-between align-items-start mb-1">
            <div class="d-flex align-items-center">
              <img src="${(c.user && c.user.profileImage) ? c.user.profileImage : '/images/default-profile.svg'}" 
                   style="width: 30px; height: 30px; border-radius: 50%; object-fit: cover; margin-right: 10px;">
              <strong class="text-white">${c.user ? escapeHtml(c.user.name) : 'Anonymous'}</strong>
              ${c.isPinned ? '<span class="badge bg-success ms-2"><i class="bi bi-pin-angle-fill"></i> Pinned</span>' : ''}
              ${c.isHidden ? '<span class="badge bg-secondary ms-2"><i class="bi bi-eye-slash"></i> Hidden</span>' : ''}
            </div>
            <small class="text-muted">${new Date(c.createdAt).toLocaleString('en-IN')}</small>
          </div>
          <p class="mb-2 ms-5 text-white" style="word-break: break-all;">${escapeHtml(c.text)}</p>
          <div class="ms-5 d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary" onclick="toggleCommentPin('${postId}', '${c._id}')">
              <i class="bi bi-pin-angle"></i> ${c.isPinned ? 'Unpin' : 'Pin'}
            </button>
            <button class="btn btn-sm btn-outline-secondary" onclick="toggleCommentHide('${postId}', '${c._id}')">
              <i class="bi bi-eye-slash"></i> ${c.isHidden ? 'Unhide' : 'Hide'}
            </button>
            <button class="btn btn-sm btn-outline-danger" onclick="deleteComment('${postId}', '${c._id}')">
              <i class="bi bi-trash"></i> Delete
            </button>
          </div>
          ${repliesHtml}
        </div>
      `}).join('');
    }
  } catch (err) {
    console.error('Refresh comments error:', err);
    alert('Failed to load comments');
  }
}

async function toggleCommentPin(postId, commentId) {
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}/pin`, { method: 'PUT' });
    const data = await res.json();
    if (data.success) await refreshCommentsList(postId);
    else alert(data.message || 'Failed to pin comment');
  } catch (err) {
    alert('Error pinning comment');
  }
}

async function toggleCommentHide(postId, commentId) {
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}/hide`, { method: 'PUT' });
    const data = await res.json();
    if (data.success) await refreshCommentsList(postId);
    else alert(data.message || 'Failed to hide comment');
  } catch (err) {
    alert('Error hiding comment');
  }
}

async function deleteComment(postId, commentId) {
  if (!confirm('Are you sure you want to delete this comment?')) return;
  
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) await refreshCommentsList(postId);
    else alert(data.message || 'Failed to delete comment');
  } catch (err) {
    alert('Error deleting comment');
  }
}

async function deleteReply(postId, commentId, replyId) {
  if (!confirm('Are you sure you want to delete this reply?')) return;
  
  try {
    const res = await fetch(`/posts/${postId}/comments/${commentId}/replies/${replyId}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) await refreshCommentsList(postId);
    else alert(data.message || 'Failed to delete reply');
  } catch (err) {
    alert('Error deleting reply');
  }
}
</script>
