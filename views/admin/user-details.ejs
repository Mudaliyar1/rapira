<%- contentFor('body') %>

<!-- User Details Page -->
<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h2 class="text-white mb-0">User Details</h2>
      <a href="/admin/users" class="btn btn-outline-light">
        <i class="bi bi-arrow-left me-1"></i> Back to Users
      </a>
    </div>
  </div>

  <!-- User Profile Header -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center">
        <div class="col-lg-3 text-center">
          <% if (user.profileImage) { %>
            <img src="<%= user.profileImage %>" alt="<%= user.name %>" class="rounded-circle mb-3" width="120" height="120" style="object-fit: cover;">
          <% } else { %>
            <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 120px; height: 120px;">
              <i class="bi bi-person text-white" style="font-size: 3rem;"></i>
            </div>
          <% } %>
        </div>
        <div class="col-lg-9">
          <div class="row g-3">
            <div class="col-md-6">
              <h4 class="text-white mb-2"><%= user.name %></h4>
              <p class="text-white-50 mb-0"><%= user.email %></p>
            </div>
            <div class="col-md-6 text-lg-end">
              <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                <span class="badge <%= user.role === 'admin' ? 'bg-danger' : user.role === 'artist' ? 'bg-primary' : 'bg-secondary' %>" style="font-size: 0.9rem;">
                  <%= user.role.toUpperCase() %>
                </span>
                <% if (assignedRoles && assignedRoles.length) { %>
                  <% const baseRoleLower = (user.role || '').toLowerCase(); %>
                  <% assignedRoles.forEach(r => { %>
                    <% if (r && r.name && r.name.toLowerCase() !== baseRoleLower) { %>
                      <span class="badge bg-info text-dark d-inline-flex align-items-center gap-1" style="font-size: 0.9rem;">
                        <% if (r.icon) { %><i class="bi <%= r.icon %>"></i><% } %>
                        <%= r.name %>
                      </span>
                    <% } %>
                  <% }); %>
                <% } %>
                <span class="badge <%= user.isVerified ? 'bg-success' : 'bg-warning' %>" style="font-size: 0.9rem;">
                  <%= user.isVerified ? 'VERIFIED' : 'UNVERIFIED' %>
                </span>
                <span class="badge <%= user.isOnline ? 'bg-success' : 'bg-secondary' %>" style="font-size: 0.9rem;">
                  <i class="bi <%= user.isOnline ? 'bi-circle-fill' : 'bi-circle' %> me-1"></i>
                  <%= user.isOnline ? 'ONLINE' : 'OFFLINE' %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Overview -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="glass-card-dark border border-secondary text-center p-3">
        <h5 class="text-info mb-1"><%= stats.ticketsPurchased %></h5>
        <small class="text-white-50">Tickets Purchased</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card-dark border border-secondary text-center p-3">
        <h5 class="text-success mb-1"><%= stats.activeSubscriptions %></h5>
        <small class="text-white-50">Active Subscriptions</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card-dark border border-secondary text-center p-3">
        <h5 class="text-warning mb-1">Rs. <%= stats.totalSpent.toFixed(2) %></h5>
        <small class="text-white-50">Total Spent</small>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card-dark border border-secondary text-center p-3">
        <h5 class="text-danger mb-1"><%= stats.refundedTickets %></h5>
        <small class="text-white-50">Refunded Tickets</small>
      </div>
    </div>
  </div>

  <!-- Account Information -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-header border-bottom border-secondary">
      <h5 class="card-title mb-0 text-white">Account Information</h5>
    </div>
    <div class="card-body">
      <div class="row g-4">
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Email</small>
            <div class="text-white fw-semibold"><%= user.email %></div>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Wallet Balance</small>
            <div class="text-white fw-semibold">Rs. <%= (user.walletBalance || 0).toFixed(2) %></div>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Registration Date</small>
            <div class="text-white fw-semibold"><%= toISTLocaleString(user.createdAt) %></div>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Pending Email</small>
            <div class="text-white fw-semibold"><%= user.pendingEmail || 'None' %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Login Activity -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-header border-bottom border-secondary">
      <h5 class="card-title mb-0 text-white">Login Activity & Current Status</h5>
    </div>
    <div class="card-body">
      <div class="row g-4">
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Current Status</small>
            <div>
              <% if (stats.isOnline) { %>
                <span class="badge bg-success" style="font-size: 1rem; padding: 0.5rem 1rem;">
                  <i class="bi bi-circle-fill me-2"></i> Currently Online
                </span>
                <% if (user.currentPage) { %>
                  <div class="mt-2">
                    <small class="text-white-50 d-block mb-1">Currently Viewing</small>
                    <div class="text-white fw-semibold">
                      <i class="bi bi-window me-2"></i> <%= user.currentPage %>
                      <% if (user.lastPageUpdate) { %>
                        <small class="text-white-50 d-block mt-1">Updated: <%= toISTLocaleString(user.lastPageUpdate) %></small>
                      <% } %>
                    </div>
                  </div>
                <% } %>
              <% } else { %>
                <span class="badge bg-secondary" style="font-size: 1rem; padding: 0.5rem 1rem;">
                  <i class="bi bi-circle me-2"></i> Currently Offline
                </span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Last Activity</small>
            <div class="text-white fw-semibold">
              <% if (user.lastPageUpdate) { %>
                <%= toISTLocaleString(user.lastPageUpdate) %>
              <% } else { %>
                <span class="text-white-50">No activity recorded</span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Last Login</small>
            <div class="text-white fw-semibold">
              <% if (stats.lastLogin) { %>
                <%= toISTLocaleString(stats.lastLogin) %>
              <% } else { %>
                <span class="text-white-50">No login history</span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Current Login Time</small>
            <div class="text-white fw-semibold">
              <% if (stats.currentLoginTime) { %>
                <%= toISTLocaleString(stats.currentLoginTime) %>
              <% } else { %>
                <span class="text-white-50">Not currently logged in</span>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Password Security Information -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-header border-bottom border-secondary">
      <h5 class="card-title mb-0 text-white">
        <i class="bi bi-shield-lock me-2"></i>Password Security & Authentication
      </h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info border-info bg-opacity-10 mb-4">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Security Note:</strong> Passwords are encrypted using bcrypt hashing and cannot be viewed. Only password change history and authentication statistics are shown below.
      </div>
      
      <div class="row g-4">
        <div class="col-md-4">
          <div class="text-center p-3 bg-dark rounded border border-secondary">
            <i class="bi bi-key text-primary mb-2" style="font-size: 2rem;"></i>
            <h6 class="text-white mb-1">Last Password Change</h6>
            <p class="text-white-50 mb-0">
              <% if (stats.lastPasswordChange) { %>
                <%= toISTLocaleString(stats.lastPasswordChange) %>
              <% } else { %>
                Never changed
              <% } %>
            </p>
            <% if (stats.lastPasswordChange) { %>
              <small class="text-white-50">
                <%= Math.floor((new Date() - stats.lastPasswordChange) / (1000 * 60 * 60 * 24)) %> days ago
              </small>
            <% } %>
          </div>
        </div>
        
        <div class="col-md-4">
          <div class="text-center p-3 bg-dark rounded border border-secondary">
            <i class="bi bi-arrow-repeat text-success mb-2" style="font-size: 2rem;"></i>
            <h6 class="text-white mb-1">Total Password Changes</h6>
            <h4 class="text-white mb-0"><%= stats.totalPasswordChanges %></h4>
            <small class="text-white-50">Since account creation</small>
          </div>
        </div>
        
        <div class="col-md-4">
          <div class="text-center p-3 bg-dark rounded border border-secondary">
            <i class="bi bi-calendar-check text-info mb-2" style="font-size: 2rem;"></i>
            <h6 class="text-white mb-1">Account Age</h6>
            <h4 class="text-white mb-0"><%= stats.accountAge %></h4>
            <small class="text-white-50">days old</small>
          </div>
        </div>
      </div>

      <div class="row g-4 mt-2">
        <div class="col-md-6">
          <div class="text-center p-3 bg-dark rounded border border-success">
            <i class="bi bi-check-circle text-success mb-2" style="font-size: 2rem;"></i>
            <h6 class="text-white mb-1">Successful Logins</h6>
            <h4 class="text-success mb-0"><%= stats.successfulLogins %></h4>
            <small class="text-white-50">Total successful login attempts</small>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="text-center p-3 bg-dark rounded border border-danger">
            <i class="bi bi-x-circle text-danger mb-2" style="font-size: 2rem;"></i>
            <h6 class="text-white mb-1">Failed Login Attempts</h6>
            <h4 class="text-danger mb-0"><%= stats.failedLogins %></h4>
            <small class="text-white-50">
              <% if (stats.failedLogins > 5) { %>
                ⚠️ High number of failed attempts detected
              <% } else if (stats.failedLogins > 0) { %>
                Monitor for suspicious activity
              <% } else { %>
                No failed attempts recorded
              <% } %>
            </small>
          </div>
        </div>
      </div>

      <div class="mt-4 p-3 bg-dark rounded border border-warning">
        <h6 class="text-warning mb-3"><i class="bi bi-tools me-2"></i>Admin Actions</h6>
        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#resetPasswordModal">
            <i class="bi bi-key me-1"></i> Force Password Reset
          </button>
          <button class="btn btn-outline-info btn-sm" onclick="alert('Feature coming soon: Lock account temporarily')">
            <i class="bi bi-lock me-1"></i> Lock Account
          </button>
          <button class="btn btn-outline-danger btn-sm" onclick="alert('Feature coming soon: Clear all sessions')">
            <i class="bi bi-door-closed me-1"></i> Force Logout All Sessions
          </button>
        </div>
      </div>

      <div class="mt-3">
        <h6 class="text-white mb-2"><i class="bi bi-shield-check me-2"></i>Password Storage Information</h6>
        <div class="p-3 bg-dark rounded border border-secondary">
          <div class="alert alert-warning border-warning bg-opacity-10 mb-3">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Important:</strong> The password is encrypted using bcrypt hashing. The original plain text password <strong>cannot be recovered</strong> from the hash below. This is a one-way encryption for security. Only the user knows their actual password.
          </div>
          
          <div class="row mb-3">
            <div class="col-md-3">
              <small class="text-white-50 d-block mb-1">Encryption Method</small>
              <span class="badge bg-success">bcrypt (one-way hash)</span>
            </div>
            <div class="col-md-3">
              <small class="text-white-50 d-block mb-1">Hash Rounds</small>
              <span class="badge bg-info">10 rounds (2^10 iterations)</span>
            </div>
            <div class="col-md-3">
              <small class="text-white-50 d-block mb-1">Hash Length</small>
              <span class="badge bg-secondary"><%= user.password ? user.password.length : 0 %> characters</span>
            </div>
            <div class="col-md-3">
              <small class="text-white-50 d-block mb-1">Security Level</small>
              <span class="badge bg-success">Military Grade</span>
            </div>
          </div>
          
          <div>
            <small class="text-white-50 d-block mb-2">Complete Encrypted Password Hash (Read-Only):</small>
            <div class="p-3 bg-black rounded border border-info" style="overflow-wrap: break-word;">
              <code class="text-info font-monospace" style="font-size: 0.85rem; user-select: all;">
                <%= user.password || 'No password set' %>
              </code>
            </div>
            <small class="text-white-50 mt-2 d-block">
              <i class="bi bi-lock-fill me-1"></i>
              This hash is irreversible. To change the user's password, use the "Force Password Reset" button above and set a new password.
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Personal Information -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-header border-bottom border-secondary">
      <h5 class="card-title mb-0 text-white">Personal Information</h5>
    </div>
    <div class="card-body">
      <div class="row g-4">
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">City</small>
            <div class="text-white fw-semibold"><%= user.city || 'Not set' %></div>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Age</small>
            <div class="text-white fw-semibold"><%= user.age || 'Not provided' %></div>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1">Heard About Us</small>
            <div class="text-white fw-semibold"><%= user.heardFrom || 'Not provided' %></div>
          </div>
        </div>
        <div class="col-12">
          <div>
            <small class="text-white-50 d-block mb-1">Bio</small>
            <div class="text-white fw-semibold"><%= user.bio || 'Not provided' %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Social Links -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-header border-bottom border-secondary">
      <h5 class="card-title mb-0 text-white">Social Links</h5>
    </div>
    <div class="card-body">
      <div class="row g-4">
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1"><i class="bi bi-instagram me-1"></i> Instagram</small>
            <% if (user.socialLinks && user.socialLinks.instagram) { %>
              <a href="<%= user.socialLinks.instagram %>" target="_blank" class="btn btn-sm btn-outline-light">
                <%= user.socialLinks.instagram %>
              </a>
            <% } else { %>
              <div class="text-white-50">Not set</div>
            <% } %>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1"><i class="bi bi-twitter-x me-1"></i> Twitter</small>
            <% if (user.socialLinks && user.socialLinks.twitter) { %>
              <a href="<%= user.socialLinks.twitter %>" target="_blank" class="btn btn-sm btn-outline-light">
                <%= user.socialLinks.twitter %>
              </a>
            <% } else { %>
              <div class="text-white-50">Not set</div>
            <% } %>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1"><i class="bi bi-youtube me-1"></i> YouTube</small>
            <% if (user.socialLinks && user.socialLinks.youtube) { %>
              <a href="<%= user.socialLinks.youtube %>" target="_blank" class="btn btn-sm btn-outline-light">
                <%= user.socialLinks.youtube %>
              </a>
            <% } else { %>
              <div class="text-white-50">Not set</div>
            <% } %>
          </div>
        </div>
        <div class="col-md-6">
          <div>
            <small class="text-white-50 d-block mb-1"><i class="bi bi-spotify me-1"></i> Spotify</small>
            <% if (user.socialLinks && user.socialLinks.spotify) { %>
              <a href="<%= user.socialLinks.spotify %>" target="_blank" class="btn btn-sm btn-outline-light">
                <%= user.socialLinks.spotify %>
              </a>
            <% } else { %>
              <div class="text-white-50">Not set</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Artist Block History (Only for Artists) -->
  <% if (user.role === 'artist' && artist) { %>
    <div class="glass-card-dark border border-secondary mb-4">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">
          <i class="bi bi-shield-exclamation me-2"></i>Artist Block History
          <% if (artist.blockHistory && artist.blockHistory.length > 0) { %>
            <span class="badge bg-danger ms-2"><%= artist.blockHistory.length %></span>
          <% } else { %>
            <span class="badge bg-success ms-2">0</span>
          <% } %>
        </h5>
      </div>
      <div class="card-body">
        <% if (artist.blockHistory && artist.blockHistory.length > 0) { %>
          <div class="alert alert-warning mb-3">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Total Times Blocked:</strong> <%= artist.blockHistory.length %> time<%= artist.blockHistory.length !== 1 ? 's' : '' %>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="border-bottom border-secondary">
                <tr>
                  <th class="text-white">#</th>
                  <th class="text-white">Blocked Date & Time</th>
                  <th class="text-white">Blocked By</th>
                  <th class="text-white">Reason</th>
                  <th class="text-white">Unblocked Date & Time</th>
                  <th class="text-white">Unblocked By</th>
                  <th class="text-white">Status</th>
                </tr>
              </thead>
              <tbody>
                <% artist.blockHistory.slice().reverse().forEach((block, index) => { %>
                  <tr>
                    <td class="text-white"><%= artist.blockHistory.length - index %></td>
                    <td class="text-white">
                      <%= toISTLocaleString(block.blockedAt) %>
                    </td>
                    <td class="text-white">
                      <% if (block.blockedBy) { %>
                        <%= block.blockedBy.name || 'Admin' %>
                      <% } else { %>
                        <span class="text-white-50">N/A</span>
                      <% } %>
                    </td>
                    <td class="text-white">
                      <span class="text-warning"><%= block.blockReason || 'No reason provided' %></span>
                    </td>
                    <td class="text-white">
                      <% if (block.unblockedAt) { %>
                        <%= toISTLocaleString(block.unblockedAt) %>
                      <% } else { %>
                        <span class="badge bg-danger">Currently Blocked</span>
                      <% } %>
                    </td>
                    <td class="text-white">
                      <% if (block.unblockedBy) { %>
                        <%= block.unblockedBy.name || 'Admin' %>
                      <% } else { %>
                        <span class="text-white-50">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (block.unblockedAt) { %>
                        <span class="badge bg-success">Resolved</span>
                      <% } else { %>
                        <span class="badge bg-danger">Active Block</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="alert alert-success mb-0">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>No Block History</strong><br>
            <span class="text-muted">This artist has never been blocked by the website.</span>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Tickets Purchased -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-header border-bottom border-secondary">
      <h5 class="card-title mb-0 text-white">
        Tickets Purchased <span class="badge bg-info ms-2"><%= tickets.length %></span>
      </h5>
    </div>
    <div class="card-body p-0">
      <% if (tickets && tickets.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="border-bottom border-secondary">
              <tr>
                <th class="text-white">Concert</th>
                <th class="text-white">Ticket Number</th>
                <th class="text-white">Quantity</th>
                <th class="text-white">Date Purchased</th>
                <th class="text-white">Payment Status</th>
                <th class="text-white">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% tickets.forEach(ticket => { %>
                <tr>
                  <td class="text-white">
                    <% if (ticket.concert) { %>
                      <%= ticket.concert.title %>
                    <% } else { %>
                      <span class="text-white-50">Deleted Concert</span>
                    <% } %>
                  </td>
                  <td class="text-white"><%= ticket.ticketNumber %></td>
                  <td class="text-white"><%= ticket.quantity %></td>
                  <td class="text-white"><%= toISTDateString(ticket.createdAt) %></td>
                  <td>
                    <span class="badge <%= ticket.paymentStatus === 'completed' ? 'bg-success' : ticket.paymentStatus === 'refunded' ? 'bg-danger' : 'bg-warning' %>">
                      <%= ticket.paymentStatus.toUpperCase() %>
                    </span>
                  </td>
                  <td class="text-white">
                    <% if (ticket.totalAmount > 0) { %>
                      Rs. <%= ticket.totalAmount.toFixed(2) %>
                    <% } else if (ticket.paymentId === 'ADMIN_FREE_TICKET') { %>
                      <span class="badge bg-info">FREE (Admin)</span>
                    <% } else { %>
                      <span class="badge bg-success">FREE</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-4 text-center text-white-50">
          <i class="bi bi-ticket-perforated me-2"></i> No tickets purchased
        </div>
      <% } %>
    </div>
  </div>

  <!-- Subscriptions -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-header border-bottom border-secondary">
      <h5 class="card-title mb-0 text-white">
        Subscriptions <span class="badge bg-info ms-2"><%= subscriptions.length %></span>
      </h5>
    </div>
    <div class="card-body p-0">
      <% if (subscriptions && subscriptions.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="border-bottom border-secondary">
              <tr>
                <th class="text-white">Plan Name</th>
                <th class="text-white">Status</th>
                <th class="text-white">Start Date</th>
                <th class="text-white">End Date</th>
                <th class="text-white">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% subscriptions.forEach(sub => { %>
                <tr>
                  <td class="text-white"><%= sub.planName || 'Basic Plan' %></td>
                  <td>
                    <span class="badge <%= sub.status === 'active' ? 'bg-success' : sub.status === 'cancelled' ? 'bg-danger' : 'bg-secondary' %>">
                      <%= sub.status.toUpperCase() %>
                    </span>
                  </td>
                  <td class="text-white"><%= toISTDateString(sub.startDate) %></td>
                  <td class="text-white"><%= toISTDateString(sub.endDate) %></td>
                  <td class="text-white">Rs. <%= (sub.amount || 0).toFixed(2) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-4 text-center text-white-50">
          <i class="bi bi-gift me-2"></i> No subscriptions
        </div>
      <% } %>
    </div>
  </div>

  <!-- Cart Items -->
  <% if (cart && cart.items && cart.items.length > 0) { %>
    <div class="glass-card-dark border border-secondary mb-4">
      <div class="card-header border-bottom border-secondary">
        <h5 class="card-title mb-0 text-white">
          Cart Items (Pending) <span class="badge bg-warning ms-2"><%= cart.items.length %></span>
        </h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="border-bottom border-secondary">
              <tr>
                <th class="text-white">Product</th>
                <th class="text-white">Quantity</th>
                <th class="text-white">Price</th>
              </tr>
            </thead>
            <tbody>
              <% cart.items.forEach(item => { %>
                <tr>
                  <td class="text-white">
                    <% if (item.product) { %>
                      <%= item.product.name || 'Unknown Product' %>
                    <% } else { %>
                      <span class="text-white-50">Deleted Product</span>
                    <% } %>
                  </td>
                  <td class="text-white"><%= item.quantity %></td>
                  <td class="text-white">Rs. <%= (item.price || 0).toFixed(2) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Activity History Section -->
  <div class="glass-card-dark border border-secondary mb-4">
    <div class="card-header border-bottom border-secondary">
      <h5 class="card-title mb-0 text-white">
        <i class="bi bi-clock-history me-2"></i>Activity History & Change Logs
      </h5>
    </div>
    <div class="card-body">
      <!-- Filters -->
      <form method="GET" action="/admin/users/<%= user._id %>/details" class="row g-3 align-items-end mb-3">
        <div class="col-md-3">
          <label class="form-label text-white-50 small">Activity Type</label>
          <select name="type" class="form-select bg-dark text-white border-secondary">
            <option value="all" <%= (!activityFilters || activityFilters.filterType === 'all') ? 'selected' : '' %>>All</option>
            <% (activityTypes || []).forEach(t => { %>
              <option value="<%= t %>" <%= activityFilters && activityFilters.filterType === t ? 'selected' : '' %>><%= t.replace(/_/g,' ').toUpperCase() %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label text-white-50 small">Performed By</label>
          <select name="performedBy" class="form-select bg-dark text-white border-secondary">
            <option value="all" <%= (!activityFilters || activityFilters.filterPerformedBy === 'all') ? 'selected' : '' %>>All</option>
            <option value="self" <%= activityFilters && activityFilters.filterPerformedBy === 'self' ? 'selected' : '' %>>Self</option>
            <option value="admin" <%= activityFilters && activityFilters.filterPerformedBy === 'admin' ? 'selected' : '' %>>Admin</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label text-white-50 small">From</label>
          <input type="date" name="startDate" class="form-control bg-dark text-white border-secondary" value="<%= activityFilters && activityFilters.filterStartDate ? activityFilters.filterStartDate : '' %>">
        </div>
        <div class="col-md-2">
          <label class="form-label text-white-50 small">To</label>
          <input type="date" name="endDate" class="form-control bg-dark text-white border-secondary" value="<%= activityFilters && activityFilters.filterEndDate ? activityFilters.filterEndDate : '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label text-white-50 small">Description contains</label>
          <input type="text" name="desc" placeholder="Search description" class="form-control bg-dark text-white border-secondary" value="<%= activityFilters && activityFilters.filterDesc ? activityFilters.filterDesc : '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label text-white-50 small">Old Value contains</label>
          <input type="text" name="oldValue" placeholder="Search old value" class="form-control bg-dark text-white border-secondary" value="<%= activityFilters && activityFilters.filterOldValue ? activityFilters.filterOldValue : '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label text-white-50 small">New Value contains</label>
          <input type="text" name="newValue" placeholder="Search new value" class="form-control bg-dark text-white border-secondary" value="<%= activityFilters && activityFilters.filterNewValue ? activityFilters.filterNewValue : '' %>">
        </div>
        <div class="col-md-2">
          <label class="form-label text-white-50 small">Records to show</label>
          <input type="number" name="limit" min="1" class="form-control bg-dark text-white border-secondary" value="<%= activityFilters && activityFilters.filterLimit ? activityFilters.filterLimit : (activityLimit || 3) %>">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
        </div>
        <div class="col-md-2">
          <a href="/admin/users/<%= user._id %>/details" class="btn btn-outline-secondary w-100"><i class="bi bi-x-circle me-1"></i>Clear</a>
        </div>
      </form>

      <% if (activityHistoryDisplay && activityHistoryDisplay.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-dark table-hover">
            <thead>
              <tr>
                <th class="text-white-50" style="width: 180px;">Date & Time</th>
                <th class="text-white-50" style="width: 150px;">Activity Type</th>
                <th class="text-white-50">Description</th>
                <th class="text-white-50" style="width: 200px;">Old Value</th>
                <th class="text-white-50" style="width: 200px;">New Value</th>
                <th class="text-white-50" style="width: 120px;">Performed By</th>
              </tr>
            </thead>
            <tbody>
              <% activityHistoryDisplay.forEach(activity => { %>
                <tr>
                  <td class="text-white-50">
                    <small><%= new Date(activity.createdAt).toLocaleString('en-IN', { 
                      timeZone: 'Asia/Kolkata',
                      day: '2-digit',
                      month: '2-digit', 
                      year: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit',
                      second: '2-digit',
                      hour12: true
                    }) %></small>
                  </td>
                  <td>
                    <span class="badge <%= 
                      activity.activityType === 'password_change' ? 'bg-warning' :
                      activity.activityType === 'email_change' ? 'bg-danger' :
                      activity.activityType === 'name_change' ? 'bg-info' :
                      activity.activityType === 'login' ? 'bg-success' :
                      activity.activityType === 'logout' ? 'bg-secondary' :
                      activity.activityType === 'failed_login' ? 'bg-danger' :
                      activity.activityType === 'profile_update' ? 'bg-primary' :
                      activity.activityType === 'role_change' ? 'bg-warning' :
                      'bg-secondary'
                    %>">
                      <%= activity.activityType.replace(/_/g, ' ').toUpperCase() %>
                    </span>
                  </td>
                  <td class="text-white">
                    <%= activity.description %>
                  </td>
                  <td class="text-white-50">
                    <% if (activity.oldValue) { %>
                      <small class="text-break"><%= activity.oldValue %></small>
                    <% } else { %>
                      <small class="text-white-50">-</small>
                    <% } %>
                  </td>
                  <td class="text-white">
                    <% if (activity.newValue) { %>
                      <small class="text-break"><%= activity.newValue %></small>
                    <% } else { %>
                      <small class="text-white-50">-</small>
                    <% } %>
                  </td>
                  <td class="text-white-50">
                    <% if (activity.performedBy) { %>
                      <small><%= activity.performedBy.name %></small>
                    <% } else { %>
                      <small class="text-info">Self</small>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <small class="text-white-50">Showing <%= activityHistoryDisplay.length %> of <%= activityTotal %> (filtered)</small>
          <% if (hasMore) { %>
            <form method="GET" action="/admin/users/<%= user._id %>/details" class="d-inline">
              <input type="hidden" name="type" value="<%= activityFilters && activityFilters.filterType ? activityFilters.filterType : 'all' %>">
              <input type="hidden" name="performedBy" value="<%= activityFilters && activityFilters.filterPerformedBy ? activityFilters.filterPerformedBy : 'all' %>">
              <input type="hidden" name="desc" value="<%= activityFilters && activityFilters.filterDesc ? activityFilters.filterDesc : '' %>">
              <input type="hidden" name="oldValue" value="<%= activityFilters && activityFilters.filterOldValue ? activityFilters.filterOldValue : '' %>">
              <input type="hidden" name="newValue" value="<%= activityFilters && activityFilters.filterNewValue ? activityFilters.filterNewValue : '' %>">
              <input type="hidden" name="startDate" value="<%= activityFilters && activityFilters.filterStartDate ? activityFilters.filterStartDate : '' %>">
              <input type="hidden" name="endDate" value="<%= activityFilters && activityFilters.filterEndDate ? activityFilters.filterEndDate : '' %>">
              <input type="hidden" name="limit" value="<%= nextLimit %>">
              <button type="submit" class="btn btn-outline-light btn-sm">
                <i class="bi bi-three-dots"></i> View More
              </button>
            </form>
          <% } %>
        </div>
      <% } else { %>
        <div class="text-center py-4">
          <i class="bi bi-inbox text-white-50" style="font-size: 3rem;"></i>
          <p class="text-white-50 mb-0 mt-3">No activity history available yet</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="glass-card-dark border border-secondary">
    <div class="card-body">
      <div class="d-flex gap-2 flex-wrap">
        <a href="/admin/users/<%= user._id %>/edit" class="btn btn-outline-primary">
          <i class="bi bi-pencil me-1"></i> Edit User
        </a>
        <a href="/admin/users" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
        <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteUserModal">
          <i class="bi bi-trash me-1"></i> Delete User
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-white">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="deleteUserLabel">Confirm Delete User</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete <strong><%= user.name %></strong> and all associated data?</p>
        <p class="text-danger mb-0">This action cannot be undone. All tickets, subscriptions, and personal data will be permanently deleted.</p>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form action="/admin/users/<%= user._id %>/delete" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-danger">Delete User</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Force Password Reset Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-white">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="resetPasswordLabel">
          <i class="bi bi-key me-2"></i>Force Password Reset for <%= user.name %>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/users/<%= user._id %>/reset-password" method="POST">
        <div class="modal-body">
          <div class="alert alert-warning border-warning bg-opacity-10 mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Admin Action:</strong> You are about to set a new password for this user. They will be notified via email.
          </div>
          
          <div class="mb-3">
            <label for="newPassword" class="form-label text-white">New Password</label>
            <input type="password" class="form-control bg-dark text-white border-secondary" id="newPassword" name="newPassword" required minlength="6">
            <small class="text-white-50">Minimum 6 characters</small>
          </div>
          
          <div class="mb-3">
            <label for="confirmPassword" class="form-label text-white">Confirm Password</label>
            <input type="password" class="form-control bg-dark text-white border-secondary" id="confirmPassword" name="confirmPassword" required minlength="6">
          </div>
          
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="notifyUser" name="notifyUser" checked>
            <label class="form-check-label text-white" for="notifyUser">
              Send email notification to user
            </label>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-key me-1"></i> Reset Password
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
