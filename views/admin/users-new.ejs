<%- contentFor('body') %>

<!-- Search and Filter Section -->
<div class="glass-card-dark border border-secondary mb-4">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">Search & Filter Users</h5>
  </div>
  <div class="card-body">
    <form method="GET" action="/admin/users" id="userSearchForm">
      <div class="row g-3">
        <div class="col-md-4">
          <label for="search" class="form-label text-white">Search Users</label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-white">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control bg-dark border-secondary text-white"
                   id="search" name="search" placeholder="Search by name or email..."
                   value="<%= searchParams.search %>">
          </div>
        </div>
        <div class="col-md-2">
          <label for="role" class="form-label text-white">Role</label>
          <select class="form-select bg-dark border-secondary text-white" id="role" name="role">
            <option value="all" <%= searchParams.role === 'all' ? 'selected' : '' %>>All Roles</option>
            <option value="user" <%= searchParams.role === 'user' ? 'selected' : '' %>>User</option>
            <option value="artist" <%= searchParams.role === 'artist' ? 'selected' : '' %>>Artist</option>
            <option value="admin" <%= searchParams.role === 'admin' ? 'selected' : '' %>>Admin</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="status" class="form-label text-white">Status</label>
          <select class="form-select bg-dark border-secondary text-white" id="status" name="status">
            <option value="all" <%= searchParams.status === 'all' ? 'selected' : '' %>>All Status</option>
            <option value="verified" <%= searchParams.status === 'verified' ? 'selected' : '' %>>Verified</option>
            <option value="unverified" <%= searchParams.status === 'unverified' ? 'selected' : '' %>>Unverified</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="sortBy" class="form-label text-white">Sort By</label>
          <select class="form-select bg-dark border-secondary text-white" id="sortBy" name="sortBy">
            <option value="createdAt" <%= searchParams.sortBy === 'createdAt' ? 'selected' : '' %>>Join Date</option>
            <option value="name" <%= searchParams.sortBy === 'name' ? 'selected' : '' %>>Name</option>
            <option value="email" <%= searchParams.sortBy === 'email' ? 'selected' : '' %>>Email</option>
            <option value="role" <%= searchParams.sortBy === 'role' ? 'selected' : '' %>>Role</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="sortOrder" class="form-label text-white">Order</label>
          <select class="form-select bg-dark border-secondary text-white" id="sortOrder" name="sortOrder">
            <option value="desc" <%= searchParams.sortOrder === 'desc' ? 'selected' : '' %>>Descending</option>
            <option value="asc" <%= searchParams.sortOrder === 'asc' ? 'selected' : '' %>>Ascending</option>
          </select>
        </div>
      </div>
      <div class="row mt-3">
        <div class="col-12">
          <button type="submit" class="btn btn-primary me-2">
            <i class="bi bi-search me-1"></i> Search
          </button>
          <a href="/admin/users" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
          </a>
          <button type="button" class="btn btn-outline-info" id="toggleStats">
            <i class="bi bi-bar-chart me-1"></i> Show Stats
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Statistics Section -->
<div class="glass-card-dark border border-secondary mb-4" id="statsSection" style="display: none;">
  <div class="card-header border-bottom border-secondary">
    <h5 class="card-title mb-0 text-white">User Statistics</h5>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-primary mb-1"><%= stats.total %></h4>
          <small class="text-white-50">Total Users</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-success mb-1"><%= stats.verified %></h4>
          <small class="text-white-50">Verified</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-info mb-1"><%= stats.artist %></h4>
          <small class="text-white-50">Artists</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-danger mb-1"><%= stats.admin %></h4>
          <small class="text-white-50">Admins</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-warning mb-1"><%= stats.filtered %></h4>
          <small class="text-white-50">Filtered Results</small>
        </div>
      </div>
      <div class="col-md-2">
        <div class="text-center">
          <h4 class="text-secondary mb-1"><%= Math.round((stats.verified / stats.total) * 100) %>%</h4>
          <small class="text-white-50">Verification Rate</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Users Table -->
<div class="glass-card-dark border border-secondary mb-4">
  <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0 text-white">
      All Users
      <% if (searchParams.search || searchParams.role !== 'all' || searchParams.status !== 'all') { %>
        <span class="badge bg-info ms-2"><%= stats.filtered %> results</span>
      <% } %>
    </h5>
    <div class="d-flex gap-2">
      <button class="btn btn-sm btn-outline-light" id="exportUsers">
        <i class="bi bi-download me-1"></i> Export
      </button>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
        <thead>
          <tr>
            <th class="text-white">Name</th>
            <th class="text-white">Email</th>
            <th class="text-white">Role</th>
            <th class="text-white">Joined</th>
            <th class="text-white">Status</th>
            <th class="text-white">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users && users.length > 0) { %>
            <% users.forEach(user => { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <% if (user.profileImage) { %>
                      <img src="<%= user.profileImage %>" alt="<%= user.name %>" class="rounded-circle me-2" width="40" height="40">
                    <% } else { %>
                      <div class="bg-dark rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                        <i class="bi bi-person text-light"></i>
                      </div>
                    <% } %>
                    <div>
                      <h6 class="mb-0 text-white"><%= user.name %></h6>
                    </div>
                  </div>
                </td>
                <td class="text-white"><%= user.email %></td>
                <td>
                  <span class="badge <%= user.role === 'admin' ? 'bg-danger' : user.role === 'artist' ? 'bg-primary' : 'bg-secondary' %>">
                    <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
                  </span>
                </td>
                <td class="text-white"><%= toISTDateString(user.createdAt) %></td>
                <td>
                  <span class="badge <%= user.isVerified ? 'bg-success' : 'bg-warning' %>">
                    <%= user.isVerified ? 'Verified' : 'Unverified' %>
                  </span>
                </td>
                <td>
                  <div class="btn-group">
                    <a href="/admin/users/<%= user._id %>/details" class="btn btn-sm btn-outline-light">
                      <i class="bi bi-info-circle"></i> Details
                    </a>
                    <a href="/admin/users/<%= user._id %>/edit" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a href="/users/<%= user._id %>" target="_blank" class="btn btn-sm btn-outline-secondary">
                      <i class="bi bi-eye"></i> View
                    </a>
                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= user._id %>">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-4 text-white">No users found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Delete Modals -->
<% if (users && users.length > 0) { %>
  <% users.forEach(user => { %>
    <div class="modal fade" id="deleteModal<%= user._id %>" tabindex="-1" aria-labelledby="deleteModalLabel<%= user._id %>" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title text-white" id="deleteModalLabel<%= user._id %>">Confirm Delete</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-white">Are you sure you want to delete the user <strong><%= user.name %></strong>?</p>
            <p class="text-danger mb-0">This action cannot be undone. All associated data will be permanently deleted.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <form action="/admin/users/<%= user._id %>/delete" method="POST">
              <button type="submit" class="btn btn-danger">Delete User</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
<% } %>

<%- contentFor('headerButtons') %>
<a href="/admin/users/add" class="btn btn-primary">
  <i class="bi bi-plus-lg me-1"></i> Add User
</a>

<%- contentFor('title') %>Manage Users

<%- contentFor('scripts') %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Toggle statistics section
  const toggleStatsBtn = document.getElementById('toggleStats');
  const statsSection = document.getElementById('statsSection');

  toggleStatsBtn.addEventListener('click', function() {
    if (statsSection.style.display === 'none') {
      statsSection.style.display = 'block';
      toggleStatsBtn.innerHTML = '<i class="bi bi-bar-chart me-1"></i> Hide Stats';
    } else {
      statsSection.style.display = 'none';
      toggleStatsBtn.innerHTML = '<i class="bi bi-bar-chart me-1"></i> Show Stats';
    }
  });

  // Auto-submit form on filter changes (with debounce for search)
  const searchInput = document.getElementById('search');
  const roleSelect = document.getElementById('role');
  const statusSelect = document.getElementById('status');
  const sortBySelect = document.getElementById('sortBy');
  const sortOrderSelect = document.getElementById('sortOrder');
  const form = document.getElementById('userSearchForm');

  let searchTimeout;

  // Debounced search
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      form.submit();
    }, 500); // 500ms delay
  });

  // Immediate submit for dropdowns
  [roleSelect, statusSelect, sortBySelect, sortOrderSelect].forEach(select => {
    select.addEventListener('change', function() {
      form.submit();
    });
  });

  // Export functionality
  const exportBtn = document.getElementById('exportUsers');
  exportBtn.addEventListener('click', function() {
    // Get current search parameters
    const params = new URLSearchParams(window.location.search);
    params.set('export', 'csv');

    // Create download link
    const downloadUrl = '/admin/users/export?' + params.toString();
    window.open(downloadUrl, '_blank');
  });

  // Highlight search terms in results
  const searchTerm = '<%= searchParams.search %>';
  if (searchTerm) {
    highlightSearchTerms(searchTerm);
  }

  function highlightSearchTerms(term) {
    if (!term) return;

    const regex = new RegExp(`(${term})`, 'gi');
    const userRows = document.querySelectorAll('tbody tr');

    userRows.forEach(row => {
      const nameCell = row.querySelector('td:first-child h6');
      const emailCell = row.querySelector('td:nth-child(2)');

      if (nameCell) {
        nameCell.innerHTML = nameCell.textContent.replace(regex, '<mark class="bg-warning text-dark">$1</mark>');
      }
      if (emailCell) {
        emailCell.innerHTML = emailCell.textContent.replace(regex, '<mark class="bg-warning text-dark">$1</mark>');
      }
    });
  }

  // Show/hide empty state message
  const userRows = document.querySelectorAll('tbody tr');
  const hasResults = userRows.length > 0 && !userRows[0].querySelector('td[colspan]');

  if (!hasResults) {
    // Show helpful message for no results
    const emptyRow = document.querySelector('tbody tr td[colspan]');
    if (emptyRow) {
      const searchParams = '<%= JSON.stringify(searchParams) %>';
      const params = JSON.parse(searchParams);

      let message = 'No users found';
      if (params.search || params.role !== 'all' || params.status !== 'all') {
        message += ' matching your search criteria. Try adjusting your filters.';
      } else {
        message += '.';
      }

      emptyRow.innerHTML = `
        <div class="text-center py-4">
          <i class="bi bi-person-x display-4 text-muted mb-3"></i>
          <p class="text-white mb-2">${message}</p>
          <a href="/admin/users" class="btn btn-outline-primary btn-sm">Clear Filters</a>
        </div>
      `;
    }
  }
});
</script>

<style>
/* Custom styles for search and filter */
.form-control:focus, .form-select:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
}

.input-group-text {
  border-color: #495057;
}

.badge {
  font-size: 0.75em;
}

mark {
  padding: 0.1em 0.2em;
  border-radius: 0.2em;
}

/* Smooth transitions */
#statsSection {
  transition: all 0.3s ease;
}

/* Loading state for form submissions */
.form-loading {
  opacity: 0.7;
  pointer-events: none;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .row.g-3 > .col-md-2 {
    margin-bottom: 1rem;
  }
}
</style>
