<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Concerts - Rapira Admin</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../partials/admin-sidebar', { path: '/admin/concerts' }) %>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Manage Concerts</h1>
        <button class="btn btn-primary d-md-none" id="adminToggle">
          <i class="bi bi-list"></i>
        </button>
      </div>

      <!-- Concerts Table -->
      <div class="card">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Title</th>
                  <th>Artist</th>
                  <th>Date</th>
                  <th>Venue</th>
                  <th>Status</th>
                  <th>Tickets</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (concerts && concerts.length > 0) { %>
                  <% concerts.forEach(concert => { %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center">
                          <img src="<%= concert.posterImage %>" alt="<%= concert.title %>" class="rounded me-2" width="40" height="40" style="object-fit: cover;">
                          <div>
                            <div class="fw-medium"><%= concert.title %></div>
                            <div class="small text-muted"><%= concert.city %></div>
                          </div>
                        </div>
                      </td>
                      <td><%= concert.artist && concert.artist.user ? concert.artist.user.name : 'Unknown' %></td>
                      <td>
                        <%= new Date(concert.date).toLocaleDateString() %><br>
                        <small class="text-muted"><%= concert.time %></small>
                      </td>
                      <td><%= concert.venue && concert.venue.name ? concert.venue.name : concert.venue %></td>
                      <td>
                        <% if (concert.status === 'pending') { %>
                          <span class="badge bg-warning">Pending</span>
                        <% } else if (concert.status === 'approved') { %>
                          <span class="badge bg-success">Approved</span>
                        <% } else if (concert.status === 'rejected') { %>
                          <span class="badge bg-danger">Rejected</span>
                        <% } else if (concert.status === 'cancelled') { %>
                          <span class="badge bg-secondary">Cancelled</span>
                        <% } else if (concert.status === 'completed') { %>
                          <span class="badge bg-info">Completed</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (concert.maxTickets > 0) { %>
                          <%= concert.ticketsSold %> / <%= concert.maxTickets %>
                        <% } else { %>
                          <%= concert.ticketsSold %> / ∞
                        <% } %>
                      </td>
                      <td>
                        <div class="btn-group">
                          <a href="/admin/concerts/<%= concert._id %>/details" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-info-circle"></i> Details
                          </a>
                          <a href="/concerts/<%= concert._id %>" target="_blank" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i> View
                          </a>
                          <% if (concert.status === 'pending') { %>
                            <form action="/admin/concerts/<%= concert._id %>/approve" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-check-circle"></i> Approve
                              </button>
                            </form>
                            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal<%= concert._id %>">
                              <i class="bi bi-x-circle"></i> Reject
                            </button>
                          <% } %>
                          <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= concert._id %>">
                            <i class="bi bi-trash"></i> Delete
                          </button>
                        </div>


                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4">No concerts found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reject Modals -->
  <% if (concerts && concerts.length > 0) { %>
    <% concerts.forEach(concert => { %>
      <% if (concert.status === 'pending') { %>
        <div class="modal fade" id="rejectModal<%= concert._id %>" tabindex="-1" aria-labelledby="rejectModalLabel<%= concert._id %>" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="rejectModalLabel<%= concert._id %>">Reject Concert</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form action="/admin/concerts/<%= concert._id %>/reject" method="POST">
                <div class="modal-body">
                  <div class="mb-3">
                    <label for="reason<%= concert._id %>" class="form-label">Reason for rejection</label>
                    <textarea class="form-control" id="reason<%= concert._id %>" name="reason" rows="3" required></textarea>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-danger">Reject Concert</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Delete Modal for each concert -->
      <div class="modal fade" id="deleteModal<%= concert._id %>" tabindex="-1" aria-labelledby="deleteModalLabel<%= concert._id %>" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="deleteModalLabel<%= concert._id %>">Delete Concert</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p class="text-danger fw-bold">Warning: This action cannot be undone!</p>
              <p>Are you sure you want to permanently delete the concert "<%= concert.title %>"?</p>
              <p>This will remove all records of this concert, including:</p>
              <ul>
                <li>All ticket records</li>
                <li>All booking information</li>
                <li>All concert details</li>
              </ul>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <form action="/admin/concerts/<%= concert._id %>/delete" method="POST">
                <button type="submit" class="btn btn-danger">Delete Permanently</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>

  <!-- Mobile Admin Toggle -->
  <button class="btn mobile-toggle d-md-none" id="adminToggle">
    <i class="bi bi-list"></i>
  </button>

  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
</body>
</html>
