<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Basic Email</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Basic Email</li>
      </ol>
    </nav>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="card-title mb-0">Compose Email</h5>
        </div>
        <div class="card-body">
          <form id="basicEmailForm" action="/admin/basic-email" method="POST">
            <div class="mb-3">
              <label for="subject" class="form-label">Subject</label>
              <input type="text" class="form-control" id="subject" name="subject" required placeholder="Enter email subject">
            </div>
            
            <div class="mb-3">
              <label class="form-label">Recipients</label>
              <div id="emailFieldsContainer">
                <!-- Default email field -->
                <div class="email-field-group mb-2 d-flex">
                  <input type="email" class="form-control" name="email" placeholder="Enter recipient email address" required>
                  <button type="button" class="btn btn-outline-danger ms-2 remove-email-btn" style="display: none;" onclick="removeEmailField(this)">
                    <i class="bi bi-x"></i>
                  </button>
                </div>
              </div>
              <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="addEmailField()">
                <i class="bi bi-plus me-1"></i>Add Another Email
              </button>
              <div class="form-text">Enter email addresses for recipients</div>
            </div>
            
            <div class="mb-3">
              <label for="content" class="form-label">Email Content</label>
              <textarea class="form-control" id="content" name="content" rows="15" required placeholder="Enter your email content here..."></textarea>
              <div class="form-text">You can use HTML tags for formatting (e.g., &lt;p&gt;, &lt;h1&gt;, &lt;strong&gt;, etc.)</div>
            </div>
            
            <div class="d-flex justify-content-between">
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-send me-2"></i>Send Email
              </button>
              <button type="button" class="btn btn-outline-secondary btn-lg" id="previewBtn">
                <i class="bi bi-eye me-2"></i>Preview
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
          <h5 class="card-title mb-0">Email Guidelines</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Keep subject lines concise and clear</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Use HTML formatting for better appearance</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Include a clear call-to-action when needed</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Proofread content before sending</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Respect user preferences and privacy</li>
          </ul>
        </div>
      </div>
      
      <div class="card shadow-sm mt-4">
        <div class="card-header bg-secondary text-white">
          <h5 class="card-title mb-0">How to Use</h5>
        </div>
        <div class="card-body">
          <ol class="mb-0">
            <li class="mb-2">Enter the email subject</li>
            <li class="mb-2">Add recipient email addresses (use "Add Another Email" button for multiple recipients)</li>
            <li class="mb-2">Compose your email content</li>
            <li class="mb-2">Click "Send Email" to deliver your message</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Preview Modal -->
  <div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="previewModalLabel">Email Preview</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="border rounded p-3 bg-light">
            <h4 id="previewSubject"></h4>
            <div id="previewContent" class="mt-3"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- contentFor('scripts') %>
<script>
let emailFieldCount = 1;

function addEmailField() {
  const container = document.getElementById('emailFieldsContainer');
  const fieldGroup = document.createElement('div');
  fieldGroup.className = 'email-field-group mb-2 d-flex';
  
  fieldGroup.innerHTML = `
    <input type="email" class="form-control" name="email" placeholder="Enter recipient email address">
    <button type="button" class="btn btn-outline-danger ms-2 remove-email-btn" onclick="removeEmailField(this)">
      <i class="bi bi-x"></i>
    </button>
  `;
  
  container.appendChild(fieldGroup);
  
  // Show remove buttons for all fields except the first one
  updateRemoveButtons();
}

function removeEmailField(button) {
  const fieldGroup = button.closest('.email-field-group');
  const container = document.getElementById('emailFieldsContainer');
  
  // Don't remove if it's the only field
  if (container.children.length <= 1) {
    // Just clear the input instead of removing the field
    const input = fieldGroup.querySelector('input');
    input.value = '';
    return;
  }
  
  fieldGroup.remove();
  updateRemoveButtons();
}

function updateRemoveButtons() {
  const fieldGroups = document.querySelectorAll('.email-field-group');
  
  fieldGroups.forEach((group, index) => {
    const removeBtn = group.querySelector('.remove-email-btn');
    if (removeBtn) {
      // Show remove button for all fields except the first one
      removeBtn.style.display = index === 0 ? 'none' : 'block';
    }
  });
}

document.addEventListener('DOMContentLoaded', function() {
  const previewBtn = document.getElementById('previewBtn');
  const previewModal = new bootstrap.Modal(document.getElementById('previewModal'));
  const previewSubject = document.getElementById('previewSubject');
  const previewContent = document.getElementById('previewContent');
  const subjectInput = document.getElementById('subject');
  const contentInput = document.getElementById('content');
  
  previewBtn.addEventListener('click', function() {
    const subject = subjectInput.value || 'Email Subject Preview';
    const content = contentInput.value || '<p>Email content preview will appear here...</p>';
    
    previewSubject.textContent = subject;
    previewContent.innerHTML = content;
    
    previewModal.show();
  });
  
  // Initialize remove buttons
  updateRemoveButtons();
});
</script>