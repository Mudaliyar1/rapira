<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
      <div class="card bg-dark border-secondary shadow-lg">
        <form action="/admin/super/edit-admin/<%= admin._id %>" method="POST">
          <div class="card-header border-bottom border-secondary p-4 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-white"><i class="bi bi-pencil-square me-2 text-info"></i> Edit Configuration: <%= admin.name %></h4>
            <a href="/admin/super/manage-admins" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
              <i class="bi bi-arrow-left"></i> Back
            </a>
          </div>
          <div class="card-body p-4">
            <div class="row g-4">
              <div class="col-md-6">
                <label class="form-label text-white-50 small">Full Name</label>
                <input type="text" name="name" class="form-control bg-dark text-white border-secondary" value="<%= admin.name %>" required>
              </div>
              <div class="col-md-6">
                <label class="form-label text-white-50 small">Email Address (Login)</label>
                <input type="email" name="email" class="form-control bg-dark text-white border-secondary" value="<%= admin.email %>" required>
              </div>

              <div class="col-12">
                <label class="form-label text-white-50 small">Admin Nickname / Position (e.g. User Manager)</label>
                <input type="text" name="adminTitle" class="form-control bg-dark text-white border-secondary" value="<%= admin.adminTitle %>" placeholder="Enter nickname or position title...">
              </div>
              
              <div class="col-12">
                <div class="p-3 bg-danger bg-opacity-10 border border-danger border-opacity-50 rounded">
                  <label class="form-label text-danger small"><i class="bi bi-key-fill me-1"></i> Override Password</label>
                  <input type="password" name="newPassword" class="form-control bg-dark text-white border-danger border-opacity-50" placeholder="Leave blank to keep current password...">
                  <small class="text-white-50 mt-1 d-block">Only fill this if you want to force change the user's password.</small>
                </div>
              </div>
              
              <div class="col-md-12 mt-4">
                <div class="p-4 border border-info rounded bg-dark position-relative overflow-hidden">
                  <div class="position-absolute align-items-center justify-content-center" style="top: -20px; right: -20px; opacity: 0.1; font-size: 8rem; display: flex;">
                    <i class="bi bi-shield-lock-fill text-info"></i>
                  </div>
                  <div class="position-relative z-index-1">
                    <div class="form-check form-switch fs-4">
                      <% if (currentUser.id === admin._id.toString()) { %>
                        <input class="form-check-input" type="checkbox" name="isSuperAdminValue" value="true" checked onclick="return false;" style="cursor: not-allowed;" id="editIsSA">
                      <% } else if (!currentUser.isSuperAdmin) { %>
                        <input class="form-check-input" type="checkbox" name="isSuperAdminValue" value="<%= admin.isSuperAdmin %>" id="editIsSA" <%= admin.isSuperAdmin ? 'checked' : '' %> onclick="return false;" style="cursor: not-allowed;">
                      <% } else { %>
                        <input class="form-check-input" type="checkbox" name="isSuperAdminValue" value="true" id="editIsSA" <%= admin.isSuperAdmin ? 'checked' : '' %>>
                      <% } %>
                      <label class="form-check-label text-white fw-bold ms-2" for="editIsSA">
                        Super Admin Privileges
                      </label>
                    </div>
                    <p class="text-white-50 mt-2 mb-0" style="margin-left: 55px;">
                      <% if (currentUser.id === admin._id.toString()) { %>
                        <span class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i> You cannot remove your own Super Admin access.</span>
                      <% } else if (!currentUser.isSuperAdmin) { %>
                        <span class="text-danger small"><i class="bi bi-shield-lock me-1"></i> Only Super Admins can manage this privilege.</span>
                      <% } else { %>
                        Grants ultimate unrestricted access to all dashboard features, bypasses assigned features, and allows creating/deleting other admins.
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
              
              <div class="col-md-12 mt-4">
                <h5 class="text-white border-bottom border-secondary pb-3 mb-4">Allowed Standard Features</h5>
                <div class="row g-4" id="standardFeaturesBox">
                  <% Object.keys(PERMISSION_GROUPS).forEach(groupName => { %>
                    <div class="col-12">
                      <h6 class="text-info mb-3 pb-2 border-bottom border-info border-opacity-25"><i class="bi bi-folder2-open me-2"></i><%= groupName %></h6>
                      <div class="row g-2">
                        <% PERMISSION_GROUPS[groupName].forEach(perm => { %>
                          <div class="col-sm-6 col-md-4">
                            <div class="card bg-dark border-secondary border-opacity-50 h-100">
                              <div class="card-body p-3">
                                <div class="form-check">
                                  <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="<%= perm.id %>" id="edit-perm-<%= perm.id %>" <%= admin.adminPermissions && admin.adminPermissions.includes(perm.id) ? 'checked' : '' %>>
                                  <label class="form-check-label text-light stretched-link" for="edit-perm-<%= perm.id %>" style="cursor: pointer;">
                                    <%= perm.name %>
                                  </label>
                                </div>
                              </div>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
              
            </div>
          </div>
          <div class="card-footer border-top border-secondary p-4 d-flex justify-content-end">
            <a href="/admin/super/manage-admins" class="btn btn-outline-secondary rounded-pill px-4 me-3">Cancel</a>
            <button type="submit" class="btn btn-info text-dark rounded-pill px-4 fw-bold">
              <i class="bi bi-save-fill me-2"></i> Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // UI logic: If Super Admin is checked, gray out permissions as they become irrelevant
  const isSAToggle = document.getElementById('editIsSA');
  
  function updatePermissionsUI() {
    const box = document.getElementById('standardFeaturesBox');
    const checkboxes = box.querySelectorAll('.perm-checkbox');
    if (isSAToggle.checked) {
      box.style.opacity = '0.3';
      checkboxes.forEach(cb => {
        cb.disabled = true;
      });
    } else {
      box.style.opacity = '1';
      checkboxes.forEach(cb => cb.disabled = false);
    }
  }

  isSAToggle.addEventListener('change', updatePermissionsUI);
  // Run on page load
  updatePermissionsUI();
</script>
