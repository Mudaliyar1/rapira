<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
      <div class="card bg-dark border-secondary shadow-lg">
        <form action="/admin/super/add-admin" method="POST">
          <div class="card-header border-bottom border-secondary p-4 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-white"><i class="bi bi-person-plus-fill me-2 text-warning"></i> Add New Administrator</h4>
            <a href="/admin/super/manage-admins" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
              <i class="bi bi-arrow-left"></i> Back
            </a>
          </div>
          <div class="card-body p-4">
            <div class="row g-4">
              <div class="col-md-6">
                <label class="form-label text-white-50 small">Full Name</label>
                <input type="text" name="name" class="form-control bg-dark text-white border-secondary" required placeholder="e.g. John Doe">
              </div>
              <div class="col-md-6">
                <label class="form-label text-white-50 small">Email Address (Login)</label>
                <input type="email" name="email" class="form-control bg-dark text-white border-secondary" required placeholder="admin@example.com">
              </div>

              <div class="col-12">
                <label class="form-label text-white-50 small">Admin Nickname / Position (e.g. User Manager)</label>
                <input type="text" name="adminTitle" class="form-control bg-dark text-white border-secondary" placeholder="Enter nickname or position title...">
              </div>
              
              <div class="col-12">
                <label class="form-label text-white-50 small">Account Password</label>
                <input type="password" name="password" class="form-control bg-dark text-white border-secondary" required placeholder="Create secure password" minlength="6">
              </div>
              
              <div class="col-md-12 mt-4">
                <div class="p-4 border border-warning rounded bg-dark position-relative overflow-hidden">
                  <div class="position-absolute align-items-center justify-content-center" style="top: -20px; right: -20px; opacity: 0.1; font-size: 8rem; display: flex;">
                    <i class="bi bi-shield-lock-fill text-warning"></i>
                  </div>
                  <div class="position-relative z-index-1">
                    <div class="form-check form-switch fs-4">
                      <% if (!currentUser.isSuperAdmin) { %>
                        <input class="form-check-input" type="checkbox" name="isSuperAdminValue" value="false" id="newIsSA" onclick="return false;" style="cursor: not-allowed;">
                      <% } else { %>
                        <input class="form-check-input" type="checkbox" name="isSuperAdminValue" value="true" id="newIsSA">
                      <% } %>
                      <label class="form-check-label text-white fw-bold ms-2" for="newIsSA">
                        Super Admin Privileges
                      </label>
                    </div>
                    <p class="text-white-50 mt-2 mb-0" style="margin-left: 55px;">
                      <% if (!currentUser.isSuperAdmin) { %>
                        <span class="text-danger small"><i class="bi bi-shield-lock me-1"></i> Only Super Admins can grant this privilege.</span>
                      <% } else { %>
                        Grants ultimate unrestricted access to all dashboard features, bypasses assigned features, and allows creating/deleting other admins.
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
              
              <div class="col-md-12 mt-4">
                <h5 class="text-white border-bottom border-secondary pb-3 mb-4">Allowed Standard Features</h5>
                <div class="row g-4" id="standardFeaturesBox">
                  <% Object.keys(PERMISSION_GROUPS).forEach(groupName => { %>
                    <div class="col-12">
                      <h6 class="text-warning mb-3 pb-2 border-bottom border-warning border-opacity-25"><i class="bi bi-folder2-open me-2"></i><%= groupName %></h6>
                      <div class="row g-2">
                        <% PERMISSION_GROUPS[groupName].forEach(perm => { %>
                          <div class="col-sm-6 col-md-4">
                            <div class="card bg-dark border-secondary border-opacity-50 h-100">
                              <div class="card-body p-3">
                                <div class="form-check">
                                  <input class="form-check-input perm-checkbox" type="checkbox" name="permissions" value="<%= perm.id %>" id="new-perm-<%= perm.id %>">
                                  <label class="form-check-label text-light stretched-link" for="new-perm-<%= perm.id %>" style="cursor: pointer;">
                                    <%= perm.name %>
                                  </label>
                                </div>
                              </div>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
              
            </div>
          </div>
          <div class="card-footer border-top border-secondary p-4 d-flex justify-content-end">
            <a href="/admin/super/manage-admins" class="btn btn-outline-secondary rounded-pill px-4 me-3">Cancel</a>
            <button type="submit" class="btn btn-warning text-dark rounded-pill px-4 fw-bold">
              <i class="bi bi-shield-check me-2"></i> Create Admin Account
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // UI logic: If Super Admin is checked, gray out permissions as they become irrelevant
  document.getElementById('newIsSA').addEventListener('change', function() {
    const box = document.getElementById('standardFeaturesBox');
    const checkboxes = box.querySelectorAll('.perm-checkbox');
    if (this.checked) {
      box.style.opacity = '0.3';
      checkboxes.forEach(cb => {
        cb.disabled = true;
        cb.checked = false; // Optionally uncheck them if it's super admin
      });
    } else {
      box.style.opacity = '1';
      checkboxes.forEach(cb => cb.disabled = false);
    }
  });
</script>
