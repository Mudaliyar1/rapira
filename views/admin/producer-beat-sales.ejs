<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="h3 mb-0 text-white">Beat Sales Details</h2>
    <p class="text-white-50 mb-0">Purchases for "<%= beat.title %>"</p>
  </div>
  <a href="/admin/producers/beats" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Back to Beats
  </a>
</div>

<!-- Flash Messages -->
<% if (success && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Filter section -->
<div class="card bg-dark border-secondary mb-4">
  <div class="card-body">
    <form action="/admin/producers/beats/<%= beat._id %>/sales" method="GET" class="row g-3">
      <div class="col-md-8">
        <label for="search" class="form-label text-white-50">Filter Artists by Name, Email, or City</label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-white-50">
            <i class="bi bi-search"></i>
          </span>
          <input type="text" class="form-control bg-dark border-secondary text-white" id="search" name="search" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Enter name, email, or city...">
        </div>
      </div>
      <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100 me-2">Search</button>
        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
          <a href="/admin/producers/beats/<%= beat._id %>/sales" class="btn btn-outline-secondary w-100">Clear</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<div class="card bg-dark border-secondary mb-4">
  <div class="card-header border-secondary bg-transparent d-flex justify-content-between align-items-center">
    <h5 class="mb-0 text-white">Beat Info</h5>
  </div>
  <div class="card-body d-flex align-items-center">
    <div class="me-4 pe-4 border-end border-secondary">
      <div class="text-white-50 small mb-1">Producer</div>
      <div class="d-flex align-items-center">
        <% if (beat.producer) { %>
          <img src="<%= beat.producer.profileImage || '/images/default-profile.svg' %>" alt="" class="rounded-circle me-2" width="32" height="32" style="object-fit: cover;">
          <div>
            <div class="text-white"><%= beat.producer.name %></div>
          </div>
        <% } else { %>
          <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 14px;">
            <i class="bi bi-person-slash"></i>
          </div>
          <div>
            <div class="text-muted fst-italic">Unknown Producer</div>
          </div>
        <% } %>
      </div>
    </div>
    
    <div class="me-4 pe-4 border-end border-secondary">
      <div class="text-white-50 small mb-1">Beat Type</div>
      <div class="text-white text-capitalize"><i class="bi bi-<%= beat.mediaType === 'audio' ? 'music-note' : 'camera-video' %> me-1"></i><%= beat.mediaType %></div>
    </div>
    
    <div class="me-4 pe-4 border-end border-secondary">
      <div class="text-white-50 small mb-1">Total Sales</div>
      <div class="text-success fw-bold"><%= purchases.length %></div>
    </div>
    
    <div>
      <div class="text-white-50 small mb-1">Price</div>
      <div class="text-white fw-bold">₹<%= beat.price %></div>
    </div>
  </div>
</div>

<div class="card bg-dark border-secondary">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle">
        <thead>
          <tr>
            <th>Purchasing Artist (Buyer)</th>
            <th>Location</th>
            <th>Transaction ID</th>
            <th>Amount Paid</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (purchases && purchases.length > 0) { %>
            <% purchases.forEach(purchase => { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <% if (purchase.artist) { %>
                      <img src="<%= purchase.artist.profileImage || '/images/default-profile.svg' %>" alt="" class="rounded-circle me-2" width="32" height="32" style="object-fit: cover;">
                      <div>
                        <div class="text-white"><%= purchase.artist.name %></div>
                        <small class="text-white-50"><%= purchase.artist.email %></small>
                      </div>
                    <% } else { %>
                      <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 14px;">
                        <i class="bi bi-person-slash"></i>
                      </div>
                      <div>
                        <div class="text-white">Unknown Artist</div>
                        <small class="text-danger">Profile Deleted</small>
                      </div>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="text-white-50"><%= purchase.artist && purchase.artist.city ? purchase.artist.city : 'N/A' %></div>
                </td>
                <td>
                  <div class="font-monospace text-white-50 small"><%= purchase.transactionId || 'N/A' %></div>
                  <small class="badge bg-secondary">Razorpay</small>
                </td>
                <td>
                  <div class="text-success fw-bold">₹<%= purchase.totalAmountPaid ? purchase.totalAmountPaid.toFixed(2) : '0.00' %></div>
                </td>
                <td>
                  <div class="text-white"><%= new Date(purchase.createdAt).toLocaleDateString() %></div>
                  <small class="text-white-50"><%= new Date(purchase.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-4 text-white-50">
                No purchases found matching your criteria.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
