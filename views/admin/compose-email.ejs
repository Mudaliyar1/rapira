<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Compose Email</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Compose Email</li>
      </ol>
    </nav>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="card-title mb-0">Compose New Email</h5>
        </div>
        <div class="card-body">
          <form id="composeEmailForm" action="/admin/compose-email" method="POST">
            <div class="mb-3">
              <label for="subject" class="form-label">Subject</label>
              <input type="text" class="form-control" id="subject" name="subject" required>
            </div>
            
            <div class="mb-3">
              <label for="recipients" class="form-label">Recipients</label>
              <select class="form-select" id="recipients" name="recipients" required onchange="toggleRecipientFields()">
                <option value="">Select recipient group</option>
                <option value="all">All Users</option>
                <option value="users">Regular Users</option>
                <option value="artists">Artists</option>
                <option value="admins">Administrators</option>
                <option value="custom">Custom Selection</option>
                <option value="single">Single User</option>
              </select>
              <div class="form-text">Select the group of users to send the email to</div>
            </div>
            
            <div id="customRecipientField" class="mb-3" style="display: none;">
              <label for="customRecipients" class="form-label">Custom Recipients (User IDs, comma separated)</label>
              <input type="text" class="form-control" id="customRecipients" name="customRecipients" placeholder="Enter user IDs separated by commas">
              <div class="form-text">Enter user IDs separated by commas (e.g., 60b4d5f3c8b9a1e2f4g5h6, 60b4d5f3c8b9a1e2f4g5h7)</div>
              
              <label for="customEmailRecipients" class="form-label mt-3">Or Enter Email Addresses (comma separated)</label>
              <input type="text" class="form-control" id="customEmailRecipients" name="customEmailRecipients" placeholder="Enter email addresses separated by commas">
              <div class="form-text">Enter email addresses separated by commas (e.g., user1@example.com, user2@example.com)</div>
            </div>
            
            <div id="singleUserField" class="mb-3" style="display: none;">
              <label for="singleUser" class="form-label">Select Single User</label>
              <select class="form-select" id="singleUser" name="singleUser">
                <option value="">Select a user</option>
              </select>
              <div class="form-text">Select a specific user to send the email to</div>
              
              <label for="singleUserEmail" class="form-label mt-3">Or Enter Email Address Directly</label>
              <input type="email" class="form-control" id="singleUserEmail" name="singleUserEmail" placeholder="Enter email address">
              <div class="form-text">Enter a single email address (this will override the user selection above)</div>
            </div>
            
            <div class="mb-3">
              <label for="content" class="form-label">Email Content</label>
              <textarea class="form-control" id="content" name="content" rows="15" required placeholder="Enter your email content here..."></textarea>
              <div class="form-text">You can use HTML tags for formatting (e.g., &lt;p&gt;, &lt;h1&gt;, &lt;strong&gt;, etc.)</div>
            </div>
            
            <div class="d-flex justify-content-between">
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-send me-2"></i>Send Email
              </button>
              <button type="button" class="btn btn-outline-secondary btn-lg" id="previewBtn">
                <i class="bi bi-eye me-2"></i>Preview
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white">
          <h5 class="card-title mb-0">User Statistics</h5>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-6 mb-3">
              <div class="p-3 bg-light rounded">
                <h4 class="mb-0"><%= totalCount %></h4>
                <small class="text-muted">Total Users</small>
              </div>
            </div>
            <div class="col-6 mb-3">
              <div class="p-3 bg-light rounded">
                <h4 class="mb-0"><%= userCount %></h4>
                <small class="text-muted">Regular Users</small>
              </div>
            </div>
            <div class="col-6 mb-3">
              <div class="p-3 bg-light rounded">
                <h4 class="mb-0"><%= artistCount %></h4>
                <small class="text-muted">Artists</small>
              </div>
            </div>
            <div class="col-6 mb-3">
              <div class="p-3 bg-light rounded">
                <h4 class="mb-0"><%= (adminCount + superAdminCount) %></h4>
                <small class="text-muted">Admins</small>
              </div>
            </div>
          </div>
          
          <div class="alert alert-info mt-3">
            <i class="bi bi-info-circle me-2"></i>
            <small>Selected emails will be sent from <strong>Rapira Music Platform</strong> to ensure proper delivery and recognition.</small>
          </div>
        </div>
      </div>
      
      <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
          <h5 class="card-title mb-0">Email Guidelines</h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Keep subject lines concise and clear</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Use HTML formatting for better appearance</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Include a clear call-to-action when needed</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Proofread content before sending</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Respect user preferences and privacy</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Preview Modal -->
  <div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="previewModalLabel">Email Preview</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="border rounded p-3 bg-light">
            <h4 id="previewSubject"></h4>
            <div id="previewContent" class="mt-3"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- contentFor('scripts') %>
<script>
function toggleRecipientFields() {
  const recipientType = document.getElementById('recipients').value;
  const customField = document.getElementById('customRecipientField');
  const singleUserField = document.getElementById('singleUserField');
  
  // Hide both fields initially
  if (customField) customField.style.display = 'none';
  if (singleUserField) singleUserField.style.display = 'none';
  
  // Show the appropriate field based on selection
  if (recipientType === 'custom') {
    if (customField) customField.style.display = 'block';
  } else if (recipientType === 'single') {
    if (singleUserField) {
      singleUserField.style.display = 'block';
      loadUsersForSelection();
      
      // Make sure the email input field is visible
      const singleUserEmailField = document.getElementById('singleUserEmail');
      if (singleUserEmailField) {
        singleUserEmailField.style.display = 'block';
      }
    }
  }
}

async function loadUsersForSelection() {
  const selectElement = document.getElementById('singleUser');
  
  // Only load users if the select element exists and is not disabled
  if (!selectElement) return;
  
  // Show loading state
  selectElement.innerHTML = '<option value="">Loading users...</option>';
  selectElement.disabled = true;
  
  try {
    const response = await fetch('/admin/compose-email/users');
    const data = await response.json();
    
    if (data.success) {
      // Clear the select element
      selectElement.innerHTML = '<option value="">Select a user</option>';
      
      // Add users to the select element
      data.users.forEach(user => {
        const option = document.createElement('option');
        option.value = user._id;
        option.textContent = `${user.name} (${user.email})`;
        selectElement.appendChild(option);
      });
    } else {
      selectElement.innerHTML = '<option value="">Failed to load users</option>';
    }
  } catch (error) {
    console.error('Error loading users:', error);
    selectElement.innerHTML = '<option value="">Error loading users</option>';
  } finally {
    selectElement.disabled = false;
  }
}

// Add event listeners to handle interaction between dropdown and email input
function setupSingleUserInteraction() {
  const singleUserSelect = document.getElementById('singleUser');
  const singleUserEmail = document.getElementById('singleUserEmail');
  
  if (singleUserSelect && singleUserEmail) {
    // When user selects from dropdown, clear email field
    singleUserSelect.addEventListener('change', function() {
      if (this.value) {
        singleUserEmail.value = '';
      }
    });
    
    // When user types in email, clear dropdown selection
    singleUserEmail.addEventListener('input', function() {
      if (this.value.trim() !== '') {
        singleUserSelect.value = '';
      }
    });
  }
}

document.addEventListener('DOMContentLoaded', function() {
  const previewBtn = document.getElementById('previewBtn');
  const previewModal = new bootstrap.Modal(document.getElementById('previewModal'));
  const previewSubject = document.getElementById('previewSubject');
  const previewContent = document.getElementById('previewContent');
  const subjectInput = document.getElementById('subject');
  const contentInput = document.getElementById('content');
  
  previewBtn.addEventListener('click', function() {
    const subject = subjectInput.value || 'Email Subject Preview';
    const content = contentInput.value || '<p>Email content preview will appear here...</p>';
    
    previewSubject.textContent = subject;
    previewContent.innerHTML = content;
    
    previewModal.show();
  });
  
  // Initialize the toggle functionality
  toggleRecipientFields();
  
  // Set up interaction between single user dropdown and email input
  setupSingleUserInteraction();
});
</script>