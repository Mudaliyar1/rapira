<!-- Google Ads Management Page -->
<div class="container-fluid">
  <!-- Header Section -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Google Ads Management</h2>
      <p class="text-muted mb-0">Configure and manage Google AdSense advertisements</p>
    </div>
    <div>
      <button class="btn btn-outline-primary me-2" onclick="refreshStats()">
        <i class="bi bi-arrow-clockwise me-1"></i>Refresh Stats
      </button>
      <a href="/admin/google-ads/test/homePageBanner" class="btn btn-primary" target="_blank">
        <i class="bi bi-eye me-1"></i>Test Ads
      </a>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="card-title">Total Impressions</h6>
              <h3 class="mb-0" id="totalImpressions"><%= settings.statistics.totalImpressions.toLocaleString() %></h3>
            </div>
            <div class="align-self-center">
              <i class="bi bi-eye fs-2"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="card-title">Total Clicks</h6>
              <h3 class="mb-0" id="totalClicks"><%= settings.statistics.totalClicks.toLocaleString() %></h3>
            </div>
            <div class="align-self-center">
              <i class="bi bi-cursor fs-2"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="card-title">Click Rate</h6>
              <h3 class="mb-0" id="clickRate">
                <%= settings.statistics.totalImpressions > 0 ? ((settings.statistics.totalClicks / settings.statistics.totalImpressions) * 100).toFixed(2) : 0 %>%
              </h3>
            </div>
            <div class="align-self-center">
              <i class="bi bi-graph-up fs-2"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h6 class="card-title">Revenue</h6>
              <h3 class="mb-0" id="revenue">₹<%= settings.statistics.revenue.toFixed(2) %></h3>
            </div>
            <div class="align-self-center">
              <i class="bi bi-currency-rupee fs-2"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Settings -->
  <div class="row">
    <div class="col-lg-8">
      <!-- Ad Slots Configuration -->
      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Ad Slots Configuration</h5>
          <div class="alert alert-warning mb-0 py-1 px-2 small">
            <i class="bi bi-info-circle me-1"></i>
            Using placeholder IDs - <a href="https://www.google.com/adsense/" target="_blank" class="alert-link">Get real AdSense slots</a>
          </div>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover table-dark">
              <thead>
                <tr>
                  <th class="text-white">Slot Name</th>
                  <th class="text-white">Slot ID</th>
                  <th class="text-white">Format</th>
                  <th class="text-white">Status</th>
                  <th class="text-white">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% Object.keys(settings.adSlots).forEach(slotName => { %>
                  <% const slot = settings.adSlots[slotName]; %>
                  <tr>
                    <td class="text-white">
                      <strong><%= slotName.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) %></strong>
                    </td>
                    <td class="text-white">
                      <code class="text-warning"><%= slot.slot %></code>
                    </td>
                    <td class="text-white">
                      <span class="badge bg-secondary"><%= slot.format %></span>
                      <% if (slot.responsive) { %>
                        <span class="badge bg-info ms-1">Responsive</span>
                      <% } %>
                    </td>
                    <td class="text-white">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               id="toggle-<%= slotName %>"
                               <%= slot.enabled ? 'checked' : '' %>
                               onchange="toggleAdSlot('<%= slotName %>')">
                        <label class="form-check-label text-white" for="toggle-<%= slotName %>">
                          <span class="badge <%= slot.enabled ? 'bg-success' : 'bg-danger' %>" id="status-<%= slotName %>">
                            <%= slot.enabled ? 'Enabled' : 'Disabled' %>
                          </span>
                        </label>
                      </div>
                    </td>
                    <td class="text-white">
                      <button class="btn btn-sm btn-outline-light" onclick="editAdSlot('<%= slotName %>')">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <a href="/admin/google-ads/test/<%= slotName %>" class="btn btn-sm btn-outline-info" target="_blank">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- Global Settings -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Global Settings</h5>
        </div>
        <div class="card-body">
          <form action="/admin/google-ads/update" method="POST">
            <!-- Enable/Disable Ads -->
            <div class="mb-3">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="adsEnabled" 
                       id="adsEnabled" <%= settings.adsEnabled ? 'checked' : '' %>>
                <label class="form-check-label fw-bold" for="adsEnabled">
                  Enable Google Ads
                </label>
              </div>
              <small class="text-muted">Master switch for all advertisements</small>
            </div>

            <!-- Publisher ID -->
            <div class="mb-3">
              <label for="publisherId" class="form-label">Publisher ID</label>
              <input type="text" class="form-control" name="publisherId" id="publisherId" 
                     value="<%= settings.publisherId %>" required>
              <small class="text-muted">Your Google AdSense Publisher ID</small>
            </div>

            <!-- Max Ads Per Page -->
            <div class="mb-3">
              <label for="maxAdsPerPage" class="form-label">Max Ads Per Page</label>
              <input type="number" class="form-control" name="maxAdsPerPage" id="maxAdsPerPage" 
                     value="<%= settings.placementRules.maxAdsPerPage %>" min="1" max="10">
            </div>

            <!-- Tracking -->
            <div class="mb-3">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="trackingEnabled" 
                       id="trackingEnabled" <%= settings.tracking.enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="trackingEnabled">
                  Enable Performance Tracking
                </label>
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-check-lg me-1"></i>Save Settings
            </button>
          </form>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Quick Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <button class="btn btn-outline-success" onclick="enableAllAds()">
              <i class="bi bi-check-all me-1"></i>Enable All Ads
            </button>
            <button class="btn btn-outline-warning" onclick="disableAllAds()">
              <i class="bi bi-x-circle me-1"></i>Disable All Ads
            </button>
            <form action="/admin/google-ads/stats/reset" method="POST" class="d-inline">
              <button type="submit" class="btn btn-outline-danger w-100" 
                      onclick="return confirm('Are you sure you want to reset all statistics?')">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Statistics
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Ad Slot Modal -->
<div class="modal fade" id="editAdSlotModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Ad Slot</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editAdSlotForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="editSlotId" class="form-label">Slot ID</label>
            <input type="text" class="form-control" name="slot" id="editSlotId" required>
          </div>
          <div class="mb-3">
            <label for="editFormat" class="form-label">Format</label>
            <select class="form-select" name="format" id="editFormat">
              <option value="auto">Auto</option>
              <option value="rectangle">Rectangle</option>
              <option value="fluid">Fluid</option>
              <option value="banner">Banner</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="editStyle" class="form-label">Style</label>
            <input type="text" class="form-control" name="style" id="editStyle" 
                   placeholder="display:block; width: 300px; height: 250px;">
          </div>
          <div class="mb-3">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="responsive" id="editResponsive">
              <label class="form-check-label" for="editResponsive">Responsive</label>
            </div>
          </div>
          <div class="mb-3">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="enabled" id="editEnabled">
              <label class="form-check-label" for="editEnabled">Enabled</label>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Ad Slots Data -->
<script type="application/json" id="adSlotsData"><%- JSON.stringify(settings.adSlots) %></script>

<script>
// Load ad slots data from JSON script tag
window.adSlotsData = JSON.parse(document.getElementById('adSlotsData').textContent);

// Toggle ad slot status
async function toggleAdSlot(slotName) {
  try {
    const response = await fetch(`/admin/google-ads/slot/${slotName}/toggle`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      }
    });
    
    const result = await response.json();
    
    if (result.success) {
      const statusBadge = document.getElementById(`status-${slotName}`);
      statusBadge.textContent = result.enabled ? 'Enabled' : 'Disabled';
      statusBadge.className = `badge ${result.enabled ? 'bg-success' : 'bg-danger'}`;
      
      // Show success message
      showAlert('success', result.message);
    } else {
      showAlert('error', result.error);
    }
  } catch (error) {
    console.error('Toggle ad slot error:', error);
    showAlert('error', 'Failed to toggle ad slot');
  }
}

// Edit ad slot
function editAdSlot(slotName) {
  // Get slot data from the global variable
  const slotData = window.adSlotsData[slotName];
  
  document.getElementById('editAdSlotForm').action = `/admin/google-ads/slot/${slotName}`;
  document.getElementById('editSlotId').value = slotData.slot;
  document.getElementById('editFormat').value = slotData.format;
  document.getElementById('editStyle').value = slotData.style;
  document.getElementById('editResponsive').checked = slotData.responsive;
  document.getElementById('editEnabled').checked = slotData.enabled;
  
  new bootstrap.Modal(document.getElementById('editAdSlotModal')).show();
}

// Refresh statistics
async function refreshStats() {
  try {
    const response = await fetch('/admin/google-ads/stats');
    const stats = await response.json();
    
    document.getElementById('totalImpressions').textContent = stats.totalImpressions.toLocaleString();
    document.getElementById('totalClicks').textContent = stats.totalClicks.toLocaleString();
    document.getElementById('clickRate').textContent = stats.clickThroughRate + '%';
    document.getElementById('revenue').textContent = '₹' + stats.revenue;
    
    showAlert('success', 'Statistics refreshed successfully');
  } catch (error) {
    console.error('Refresh stats error:', error);
    showAlert('error', 'Failed to refresh statistics');
  }
}

// Enable all ads
function enableAllAds() {
  const toggles = document.querySelectorAll('[id^="toggle-"]');
  toggles.forEach(toggle => {
    if (!toggle.checked) {
      toggle.click();
    }
  });
}

// Disable all ads
function disableAllAds() {
  const toggles = document.querySelectorAll('[id^="toggle-"]');
  toggles.forEach(toggle => {
    if (toggle.checked) {
      toggle.click();
    }
  });
}

// Show alert message
function showAlert(type, message) {
  const alertDiv = document.createElement('div');
  alertDiv.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show`;
  alertDiv.innerHTML = `
    ${message}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  `;
  
  document.querySelector('.container-fluid').insertBefore(alertDiv, document.querySelector('.container-fluid').firstChild);
  
  setTimeout(() => {
    alertDiv.remove();
  }, 5000);
}
</script>
