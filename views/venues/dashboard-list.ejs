<%- contentFor('body') %>

<div class="container-fluid py-4">
  <!-- Header Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
              <li class="breadcrumb-item">
                <a href="/users/venues" class="text-decoration-none">My Venues</a>
              </li>
              <li class="breadcrumb-item active" aria-current="page">Venue Dashboards</li>
            </ol>
          </nav>
          <h2 class="text-dark mb-1">
            <i class="bi bi-kanban me-2"></i>My Venue Dashboards
          </h2>
          <p class="text-muted mb-0">Manage bookings and availability for your venues</p>
        </div>
        <div>
          <a href="/users/venues" class="btn btn-outline-primary">
            <i class="bi bi-building me-1"></i>Manage Venues
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions Card -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body text-white">
          <h5 class="card-title mb-3">
            <i class="bi bi-lightning-charge-fill me-2"></i>Quick Actions
          </h5>
          <p class="mb-3 opacity-75">
            <i class="bi bi-info-circle me-1"></i>
            Select a venue below to access bookings, concerts, and revenue analytics
          </p>
          <div class="row g-3">
            <div class="col-lg-4 col-md-4 col-sm-6">
              <a href="/users/venues" class="btn btn-lg w-100 d-flex flex-column align-items-center justify-content-center p-3" style="min-height: 120px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); color: white;">
                <i class="bi bi-building fs-1 mb-2"></i>
                <span class="fw-semibold">Manage Venues</span>
              </a>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6">
              <a href="/users/venue-requests/create" class="btn btn-lg w-100 d-flex flex-column align-items-center justify-content-center p-3" style="min-height: 120px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); color: white;">
                <i class="bi bi-plus-circle fs-1 mb-2"></i>
                <span class="fw-semibold">Request New Venue</span>
              </a>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6">
              <a href="/users/venue-requests" class="btn btn-lg w-100 d-flex flex-column align-items-center justify-content-center p-3" style="min-height: 120px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); color: white;">
                <i class="bi bi-file-earmark-text fs-1 mb-2"></i>
                <span class="fw-semibold">My Requests</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Venues Grid -->
  <div class="row">
    <% if (venues.length === 0) { %>
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-body text-center py-5">
            <i class="bi bi-building display-1 text-muted mb-3"></i>
            <h4 class="text-muted">No Venues Found</h4>
            <p class="text-muted">You haven't registered any venues yet.</p>
            <a href="/users/venue-requests/register" class="btn btn-primary">
              <i class="bi bi-plus-circle me-1"></i>Register Your First Venue
            </a>
          </div>
        </div>
      </div>
    <% } else { %>
      <% venues.forEach(venue => { %>
        <div class="col-lg-6 col-xl-4 mb-4">
          <div class="card shadow-sm h-100 border-0">
            <!-- Venue Image -->
            <% if (venue.images && venue.images.length > 0) { %>
              <img src="<%= venue.images[0] %>" class="card-img-top" alt="<%= venue.name %>" 
                   style="height: 200px; object-fit: cover;">
            <% } else { %>
              <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                   style="height: 200px;">
                <i class="bi bi-building text-muted" style="font-size: 3rem;"></i>
              </div>
            <% } %>

            <!-- Venue Header -->
            <div class="card-header bg-primary text-white">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="mb-1">
                    <i class="bi bi-geo-alt me-2"></i><%= venue.name %>
                  </h5>
                  <small class="opacity-75">
                    <%= venue.city %>, <%= venue.state %>
                  </small>
                </div>
                <div class="text-end">
                  <% if (venue.capacity) { %>
                    <div class="badge bg-light text-primary fs-6">
                      <i class="bi bi-people me-1"></i><%= venue.capacity %>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Venue Stats -->
            <div class="card-body">
              <div class="row mb-3">
                <div class="col-4 text-center">
                  <div class="text-primary">
                    <i class="bi bi-calendar-event fs-4"></i>
                    <div class="fw-bold mt-1"><%= venue.stats.totalBookings %></div>
                    <small class="text-muted">Total</small>
                  </div>
                </div>
                <div class="col-4 text-center">
                  <div class="text-success">
                    <i class="bi bi-globe fs-4"></i>
                    <div class="fw-bold mt-1"><%= venue.stats.totalWebsiteBookings %></div>
                    <small class="text-muted">Website</small>
                  </div>
                </div>
                <div class="col-4 text-center">
                  <div class="text-info">
                    <i class="bi bi-plus-square fs-4"></i>
                    <div class="fw-bold mt-1"><%= venue.stats.totalExternalBookings %></div>
                    <small class="text-muted">External</small>
                  </div>
                </div>
              </div>

              <!-- Upcoming Bookings Alert -->
              <% if (venue.stats.upcomingBookings > 0) { %>
                <div class="alert alert-warning py-2 mb-3">
                  <small>
                    <i class="bi bi-clock-history me-1"></i>
                    <strong><%= venue.stats.upcomingBookings %></strong> upcoming booking(s)
                  </small>
                </div>
              <% } %>

              <!-- Venue Details -->
              <div class="mb-3">
                <small class="text-muted">
                  <i class="bi bi-geo me-1"></i>
                  <%= venue.address.length > 50 ? venue.address.substring(0, 50) + '...' : venue.address %>
                </small>
              </div>

              <!-- Action Buttons -->
              <div class="d-grid gap-2">
                <a href="/venue-dashboard/<%= venue._id %>/dashboard" class="btn btn-primary">
                  <i class="bi bi-kanban me-1"></i>Open Dashboard
                </a>
                <div class="btn-group" role="group">
                  <a href="/venue-dashboard/<%= venue._id %>/add-external-booking" 
                     class="btn btn-outline-success btn-sm">
                    <i class="bi bi-plus-circle me-1"></i>Add External Booking
                  </a>
                  <a href="/users/venues/<%= venue._id %>" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-eye me-1"></i>View Details
                  </a>
                </div>
              </div>
            </div>

            <!-- Venue Status Footer -->
            <div class="card-footer bg-light">
              <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                  <% if (venue.isVerified) { %>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>Verified
                    </span>
                  <% } else { %>
                    <span class="badge bg-warning">
                      <i class="bi bi-clock-history me-1"></i>Pending Verification
                    </span>
                  <% } %>
                </small>
                <small class="text-muted">
                  Type: <%= venue.venueType %>
                </small>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<style>
.card {
  transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
}

.card-img-top {
  transition: transform 0.3s ease;
}

.card:hover .card-img-top {
  transform: scale(1.02);
}

.badge {
  font-size: 0.75rem;
}

.btn-group .btn {
  font-size: 0.875rem;
}
</style>