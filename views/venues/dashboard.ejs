<%- contentFor('body') %>

<div class="container-fluid py-4">
  <!-- Venue Status Banner -->
  <% if (!venue.isActive) { %>
    <div class="row mb-3">
      <div class="col-12">
        <div class="alert alert-danger d-flex align-items-center justify-content-between mb-0 shadow-sm" role="alert">
          <div>
            <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
            <strong>Venue Disabled</strong> — This venue is currently not visible to artists. No new bookings can be made.
          </div>
          <form action="/venue-dashboard/<%= venue._id %>/toggle-status" method="POST" class="d-inline">
            <button type="submit" class="btn btn-success btn-sm">
              <i class="bi bi-check-circle me-1"></i>Enable Venue
            </button>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Header Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="text-dark mb-1">
            <i class="bi bi-kanban me-2"></i><%= venue.name %>
            <% if (venue.isActive) { %>
              <span class="badge bg-success fs-6 ms-2">Active</span>
            <% } else { %>
              <span class="badge bg-danger fs-6 ms-2">Disabled</span>
            <% } %>
          </h2>
          <p class="text-muted mb-0">
            <i class="bi bi-geo-alt me-1"></i><%= venue.address %>, <%= venue.city %>, <%= venue.state %>
          </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/venue-dashboard/<%= venue._id %>/add-external-booking" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i>Add Booking
          </a>
          <% if (venue.isActive) { %>
            <form action="/venue-dashboard/<%= venue._id %>/toggle-status" method="POST" class="d-inline" 
                  onsubmit="return confirm('Are you sure you want to disable this venue? Artists will not be able to book it.');">
              <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-pause-circle me-1"></i>Disable Venue
              </button>
            </form>
          <% } else { %>
            <form action="/venue-dashboard/<%= venue._id %>/toggle-status" method="POST" class="d-inline">
              <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle me-1"></i>Enable Venue
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>  <!-- Statistics Cards -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card shadow-sm bg-primary text-white">
        <div class="card-body text-center">
          <i class="bi bi-calendar-event-fill fs-1 mb-2"></i>
          <h5 class="card-title">Total Bookings</h5>
          <p class="card-text fs-4"><%= stats.totalBookings %></p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card shadow-sm bg-success text-white">
        <div class="card-body text-center">
          <i class="bi bi-globe fs-1 mb-2"></i>
          <h5 class="card-title">Website Bookings</h5>
          <p class="card-text fs-4"><%= stats.totalWebsiteBookings %></p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card shadow-sm bg-info text-white">
        <div class="card-body text-center">
          <i class="bi bi-plus-square-fill fs-1 mb-2"></i>
          <h5 class="card-title">External Bookings</h5>
          <p class="card-text fs-4"><%= stats.totalExternalBookings %></p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card shadow-sm bg-warning text-white">
        <div class="card-body text-center">
          <i class="bi bi-clock-history fs-1 mb-2"></i>
          <h5 class="card-title">Upcoming</h5>
          <p class="card-text fs-4"><%= stats.upcomingBookings %></p>
        </div>
      </div>
    </div>
  </div>


  <!-- Month Navigation -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-md-4">
              <h5 class="mb-0">
                <i class="bi bi-calendar3 me-2"></i>
                <% if (viewAll) { %>
                  All Bookings - All Time
                <% } else { %>
                  Bookings Calendar - <%= toISTDateString(new Date(currentYear, currentMonth - 1)) %>
                <% } %>
              </h5>
            </div>
            <div class="col-md-4 text-center">
              <div class="btn-group" role="group">
                <a href="?viewAll=false&month=<%= currentMonth %>&year=<%= currentYear %>" 
                   class="btn <%= !viewAll ? 'btn-primary' : 'btn-outline-primary' %>">
                  <i class="bi bi-calendar-month me-1"></i>Monthly View
                </a>
                <a href="?viewAll=true" 
                   class="btn <%= viewAll ? 'btn-primary' : 'btn-outline-primary' %>">
                  <i class="bi bi-calendar3-range me-1"></i>All Time
                </a>
              </div>
            </div>
            <div class="col-md-4">
              <% if (!viewAll) { %>
              <div class="d-flex justify-content-md-end">
                <div class="btn-group" role="group">
                  <a href="?month=<%= currentMonth === 1 ? 12 : currentMonth - 1 %>&year=<%= currentMonth === 1 ? currentYear - 1 : currentYear %>" 
                     class="btn btn-outline-primary">
                    <i class="bi bi-chevron-left"></i> Previous
                  </a>
                  <button class="btn btn-outline-primary" disabled>
                    <%= toISTDateString(new Date(currentYear, currentMonth - 1)) %>
                  </button>
                  <a href="?month=<%= currentMonth === 12 ? 1 : currentMonth + 1 %>&year=<%= currentMonth === 12 ? currentYear + 1 : currentYear %>" 
                     class="btn btn-outline-primary">
                    Next <i class="bi bi-chevron-right"></i>
                  </a>
                </div>
              </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Legend -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body py-2">
          <div class="d-flex flex-wrap gap-3 align-items-center">
            <small><strong>Legend:</strong></small>
            <small>
              <span class="badge bg-success">Website Booking (Approved)</span>
            </small>
            <small>
              <span class="badge bg-warning">Website Booking (Pending)</span>
            </small>
            <small>
              <span class="badge bg-info">External Booking</span>
            </small>
            <small>
              <span class="badge bg-secondary">Other Status</span>
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bookings List -->
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">
            <i class="bi bi-list-ul me-2"></i>All Bookings 
            <span class="badge bg-secondary ms-2"><%= bookings.length %> booking(s)</span>
          </h5>
        </div>
        <div class="card-body">
          <% if (bookings.length === 0) { %>
            <div class="text-center py-5">
              <i class="bi bi-calendar-x display-1 text-muted mb-3"></i>
              <h4 class="text-muted">No Bookings Found</h4>
              <p class="text-muted">No bookings found for the selected month.</p>
              <a href="/venue-dashboard/<%= venue._id %>/add-external-booking" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Add Your First External Booking
              </a>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Event Details</th>
                    <th>Artist/Performer</th>
                    <th>Date & Time</th>
                    <th>Duration</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Contact</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% bookings.forEach(booking => { %>
                    <tr class="<%= new Date(booking.date) < new Date() ? 'table-secondary' : '' %>">
                      <td>
                        <div>
                          <h6 class="mb-1"><%= booking.title %></h6>
                          <% if (booking.notes) { %>
                            <small class="text-muted">
                              <%= booking.notes.length > 50 ? booking.notes.substring(0, 50) + '...' : booking.notes %>
                            </small>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex align-items-center">
                          <div>
                            <div class="fw-bold"><%= booking.artistName %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div>
                          <div class="fw-bold"><%= toISTDateString(booking.date) %></div>
                          <small class="text-muted">
                            <i class="bi bi-clock me-1"></i><%= booking.startTime %>
                          </small>
                        </div>
                      </td>
                      <td>
                        <span class="badge bg-info"><%= booking.duration %>h</span>
                      </td>
                      <td>
                        <% if (booking.type === 'website') { %>
                          <span class="badge bg-success">
                            <i class="bi bi-globe me-1"></i>Website
                          </span>
                        <% } else { %>
                          <span class="badge bg-info">
                            <i class="bi bi-plus-square me-1"></i>External
                          </span>
                        <% } %>
                      </td>
                      <td>
                        <% 
                          let statusClass = 'secondary';
                          let statusIcon = 'clock';
                          if (booking.status === 'approved') {
                            statusClass = 'success';
                            statusIcon = 'check-circle';
                          } else if (booking.status === 'pending') {
                            statusClass = 'warning';
                            statusIcon = 'clock-history';
                          } else if (booking.status === 'active') {
                            statusClass = 'info';
                            statusIcon = 'play-circle';
                          } else if (booking.status === 'completed') {
                            statusClass = 'success';
                            statusIcon = 'check-all';
                          }
                        %>
                        <span class="badge bg-<%= statusClass %>">
                          <i class="bi bi-<%= statusIcon %> me-1"></i><%= booking.status.toUpperCase() %>
                        </span>
                      </td>
                      <td>
                        <% if (booking.contactInfo) { %>
                          <small class="text-muted">
                            <%= booking.contactInfo.length > 20 ? booking.contactInfo.substring(0, 20) + '...' : booking.contactInfo %>
                          </small>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm" role="group">
                          <% if (booking.type === 'website') { %>
                            <a href="/users/venues/<%= venue._id %>/bookings/<%= booking.id %>" class="btn btn-outline-primary" title="View Details">
                              <i class="bi bi-eye"></i>
                            </a>
                          <% } else { %>
                            <a href="/venue-dashboard/<%= venue._id %>/external-bookings/<%= booking.id %>" 
                               class="btn btn-outline-warning" 
                               title="Edit">
                              <i class="bi bi-pencil"></i>
                            </a>
                            <button class="btn btn-outline-danger" 
                                    onclick="if(confirm('Delete this booking?')) { fetch('/venue-dashboard/<%= venue._id %>/external-bookings/<%= booking.id %>', {method: 'DELETE', headers: {'Content-Type': 'application/json'}}).then(r => r.json()).then(d => { if(d.success) { alert('Deleted!'); location.reload(); } else { alert('Error: ' + d.message); } }).catch(e => alert('Error: ' + e.message)); }"
                                    title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- External Booking Details Modal -->
<div class="modal fade" id="externalBookingModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-info-circle me-2"></i>External Booking Details
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="modalContent">
        <!-- Content will be loaded here -->
      </div>
    </div>
  </div>
</div>

<!-- Store bookings data in a data attribute -->
<div id="bookingsData" style="display: none;" 
     data-bookings="<%- encodeURIComponent(JSON.stringify(bookings || [])) %>"
     data-venue-id="<%= venue._id %>"></div>

<style>
.table tr.table-secondary {
  opacity: 0.7;
}

.card {
  transition: box-shadow 0.15s ease-in-out;
}

.card:hover {
  box-shadow: 0 4px 8px rgba(0,0,0,0.12);
}

.badge {
  font-size: 0.75rem;
}

.btn-group-sm .btn {
  padding: 0.25rem 0.5rem;
  font-size: 0.75rem;
}
</style>

<%- contentFor('scripts') %>
<script>
// Simple inline function for viewing external bookings
function viewExternalBooking(bookingId) {
  console.log('Opening modal for booking:', bookingId);
  
  // Get bookings data
  const bookingsDataEl = document.getElementById('bookingsData');
  if (!bookingsDataEl) {
    alert('Error: Bookings data not found');
    return;
  }
  
  const bookingsJson = bookingsDataEl.getAttribute('data-bookings');
  let bookings;
  try {
    bookings = JSON.parse(decodeURIComponent(bookingsJson));
  } catch(e) {
    alert('Error parsing bookings data: ' + e.message);
    return;
  }
  
  // Find the booking
  const booking = bookings.find(b => b.id === bookingId);
  if (!booking) {
    alert('Booking not found: ' + bookingId);
    return;
  }
  
  // Build modal content
  let html = '<div class="booking-details">';
  html += '<h5>Booking Details</h5>';
  html += '<p><strong>Date:</strong> ' + (booking.date || 'N/A') + '</p>';
  html += '<p><strong>Time:</strong> ' + (booking.time || 'N/A') + '</p>';
  html += '<p><strong>Artist:</strong> ' + (booking.artistName || 'N/A') + '</p>';
  html += '<p><strong>Contact:</strong> ' + (booking.contact || 'N/A') + '</p>';
  html += '<p><strong>Phone:</strong> ' + (booking.phone || 'N/A') + '</p>';
  html += '<p><strong>Email:</strong> ' + (booking.email || 'N/A') + '</p>';
  
  if (booking.notes) {
    html += '<p><strong>Notes:</strong> ' + booking.notes + '</p>';
  }
  
  if (booking.status) {
    html += '<p><strong>Status:</strong> <span class="badge bg-' + 
            (booking.status === 'confirmed' ? 'success' : booking.status === 'pending' ? 'warning' : 'secondary') + 
            '">' + booking.status + '</span></p>';
  }
  
  html += '</div>';
  
  // Insert into modal
  document.getElementById('modalContent').innerHTML = html;
  
  // Show modal using Bootstrap
  const modalEl = document.getElementById('externalBookingModal');
  const modal = new bootstrap.Modal(modalEl);
  modal.show();
}
</script>