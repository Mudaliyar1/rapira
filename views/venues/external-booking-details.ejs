<%- contentFor('body') %>

<!-- External Booking Details Page -->
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/venue-dashboard">My Venues</a></li>
          <li class="breadcrumb-item"><a href="/venue-dashboard/<%= venue._id %>/dashboard"><%= venue.name %></a></li>
          <li class="breadcrumb-item active">External Booking Details</li>
        </ol>
      </nav>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
          <i class="bi bi-calendar-event me-2"></i>External Booking Details
        </h2>
        <div>
          <a href="/venue-dashboard/<%= venue._id %>/dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
          </a>
          <button class="btn btn-outline-danger ms-2" onclick="deleteBooking()">
            <i class="bi bi-trash me-1"></i>Delete
          </button>
        </div>
      </div>

      <!-- Status Alert -->
      <% if (booking.status === 'pending') { %>
        <div class="alert alert-warning mb-4">
          <i class="bi bi-clock-history me-2"></i>
          <strong>Status: Pending</strong> - This booking is awaiting confirmation
        </div>
      <% } else if (booking.status === 'active') { %>
        <div class="alert alert-info mb-4">
          <i class="bi bi-check-circle me-2"></i>
          <strong>Status: Active</strong> - This booking is confirmed and active
        </div>
      <% } else if (booking.status === 'completed') { %>
        <div class="alert alert-success mb-4">
          <i class="bi bi-check-all me-2"></i>
          <strong>Status: Completed</strong> - This booking has been completed
        </div>
      <% } %>

      <!-- Event Information Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <i class="bi bi-info-circle me-2"></i>Event Information
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Event Title</label>
              <div class="fw-bold"><%= booking.title %></div>
            </div>
            <div class="col-md-3 mb-3">
              <label class="text-muted small">Date</label>
              <div class="fw-bold">
                <i class="bi bi-calendar-event me-1"></i>
                <%= toISTDateString(booking.date) %>
              </div>
            </div>
            <div class="col-md-3 mb-3">
              <label class="text-muted small">Time</label>
              <div class="fw-bold">
                <i class="bi bi-clock me-1"></i><%= booking.startTime %>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Artist/Performer Name</label>
              <div class="fw-bold"><%= booking.artistName %></div>
            </div>
            <div class="col-md-3 mb-3">
              <label class="text-muted small">Duration</label>
              <div class="fw-bold">
                <span class="badge bg-info"><%= booking.durationHours %> hours</span>
              </div>
            </div>
            <div class="col-md-3 mb-3">
              <label class="text-muted small">Status</label>
              <div class="fw-bold">
                <% 
                  let statusClass = 'secondary';
                  let statusIcon = 'clock';
                  if (booking.status === 'active') {
                    statusClass = 'info';
                    statusIcon = 'check-circle';
                  } else if (booking.status === 'completed') {
                    statusClass = 'success';
                    statusIcon = 'check-all';
                  } else if (booking.status === 'pending') {
                    statusClass = 'warning';
                    statusIcon = 'clock-history';
                  }
                %>
                <span class="badge bg-<%= statusClass %>">
                  <i class="bi bi-<%= statusIcon %> me-1"></i><%= booking.status.toUpperCase() %>
                </span>
              </div>
            </div>
          </div>

          <% if (booking.description) { %>
            <hr>
            <div>
              <label class="text-muted small" style="color: #ffffff !important;">Event Description</label>
              <div class="bg-light p-3 rounded">
                <p class="mb-0" style="color: #000000 !important;"><%= booking.description %></p>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Contact Information Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
          <i class="bi bi-person-lines-fill me-2"></i>Contact Information
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Contact Person</label>
              <div class="fw-bold"><%= booking.contactInfo || 'Not provided' %></div>
            </div>
          </div>
          
          <% if (booking.notes) { %>
            <hr>
            <div>
              <label class="text-muted small" style="color: #ffffff !important;">Additional Notes</label>
              <div class="bg-light p-3 rounded">
                <p class="mb-0" style="color: #000000 !important;"><%= booking.notes %></p>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Venue Information Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
          <i class="bi bi-building me-2"></i>Venue Information
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Venue Name</label>
              <div class="fw-bold"><%= venue.name %></div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Venue Type</label>
              <div class="fw-bold"><%= venue.venueType || 'N/A' %></div>
            </div>
            <div class="col-md-12 mb-3">
              <label class="text-muted small">Address</label>
              <div class="fw-bold">
                <i class="bi bi-geo-alt me-1"></i>
                <%= venue.address %>, <%= venue.city %>, <%= venue.state %> <%= venue.pincode || '' %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking Metadata Card -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
          <i class="bi bi-info-square me-2"></i>Booking Information
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Booking Type</label>
              <div>
                <span class="badge bg-info">
                  <i class="bi bi-plus-square me-1"></i>External Booking
                </span>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Booking ID</label>
              <div class="font-monospace small"><%= booking._id %></div>
            </div>
            <div class="col-md-6 mb-3">
              <label class="text-muted small">Created At</label>
              <div><%= toISTLocaleString(booking.createdAt) %></div>
            </div>
            <% if (booking.updatedAt && booking.updatedAt.toString() !== booking.createdAt.toString()) { %>
              <div class="col-md-6 mb-3">
                <label class="text-muted small">Last Updated</label>
                <div><%= toISTLocaleString(booking.updatedAt) %></div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const VENUE_ID = '<%= venue._id %>';
const BOOKING_ID = '<%= booking._id %>';

function deleteBooking() {
  if (confirm('Are you sure you want to delete this external booking? This action cannot be undone.')) {
    fetch(`/venue-dashboard/${VENUE_ID}/external-bookings/${BOOKING_ID}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert('External booking deleted successfully!');
        window.location.href = `/venue-dashboard/${VENUE_ID}/dashboard`;
      } else {
        alert('Error deleting booking: ' + (data.message || 'Unknown error'));
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error deleting booking: ' + error.message);
    });
  }
}
</script>

<style>
.card {
  transition: box-shadow 0.15s ease-in-out;
}

.card:hover {
  box-shadow: 0 4px 8px rgba(0,0,0,0.12);
}

.badge {
  font-size: 0.875rem;
  padding: 0.375rem 0.75rem;
}

.font-monospace {
  font-family: 'Courier New', monospace;
}
</style>
