<%- contentFor('body') %>

<div class="container py-4">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/users/profile">Profile</a></li>
      <li class="breadcrumb-item"><a href="/users/venues">My Venues</a></li>
      <li class="breadcrumb-item"><a href="/venue-dashboard/<%= venue._id %>/dashboard"><%= venue.name %></a></li>
      <li class="breadcrumb-item"><a href="<%= returnTo %>">Revenue Analytics</a></li>
      <li class="breadcrumb-item active">Confirm Payment Update</li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card shadow-lg border-0">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Payment Update</h5>
        </div>
        <div class="card-body p-5">
          <div class="mb-4">
            <h6 class="text-muted"><%= bookingView.title %></h6>
            <p class="small text-muted">
              Artist: <strong><%= bookingView.artistName %></strong> | 
              Date: <%= toISTDateString(bookingView.date) %>
            </p>
          </div>

          <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Payment Details:</strong>
          </div>

          <div class="row mb-4">
            <div class="col-6">
              <div class="card border-0" style="background-color: #9c27b0;">
                <div class="card-body text-center">
                  <small class="d-block mb-2" style="color: #ffffff;">Current Amount Paid</small>
                  <h4 class="mb-0 fw-bold" style="color: #000000;">₹<%= bookingView.artistPaidDirect.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></h4>
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="card bg-primary text-white border-0">
                <div class="card-body text-center">
                  <small class="d-block mb-2">New Amount to Update</small>
                  <h4 class="mb-0 text-dark fw-bold">₹<%= newAmount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></h4>
                </div>
              </div>
            </div>
          </div>

          <div class="card bg-light border-0 mb-4 p-3">
            <div class="card-body p-3">
              <div class="mb-3">
                <small class="text-dark fw-bold">Commission Already Collected:</small> <span class="text-dark fw-semibold">₹<%= bookingView.commissionPaid.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
              </div>
              <div class="mb-3">
                <small class="text-dark fw-bold">Total Venue Cost:</small> <span class="text-dark fw-semibold">₹<%= bookingView.totalCost.toLocaleString('en-IN') %></span>
              </div>
              <div class="border-top pt-3">
                <small class="text-dark fw-bold">Total Amount Being Paid:</small> <span class="text-dark fw-semibold">₹<%= (newAmount + bookingView.commissionPaid).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
              </div>
            </div>
          </div>

          <div class="alert alert-warning mb-4">
            <i class="bi bi-exclamation-circle me-2"></i>
            Are you sure you want to update the payment amount? This action cannot be undone.
          </div>

          <div class="d-flex gap-2">
            <form method="POST" action="/users/venues/bookings/<%= bookingView.id %>/confirm-payment" class="flex-grow-1">
              <input type="hidden" name="amountPaid" value="<%= newAmount %>">
              <input type="hidden" name="returnTo" value="<%= returnTo %>">
              <button type="submit" class="btn btn-success" id="confirmBtn">
                <i class="bi bi-check-circle me-2"></i>Yes, Update Payment
              </button>
            </form>
            <a href="<%= editPageReturnTo %>" class="btn btn-secondary">
              <i class="bi bi-x-circle me-2"></i>No, Cancel
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('[CONFIRM-PAYMENT] Page loaded');
  const confirmBtn = document.getElementById('confirmBtn');
  if (confirmBtn) {
    confirmBtn.addEventListener('click', function() {
      console.log('[CONFIRM-PAYMENT] Confirm button clicked');
    });
  }
});
</script>

<style>
.card {
  border-radius: 8px;
}

.card-header {
  border-radius: 8px 8px 0 0;
}
</style>
