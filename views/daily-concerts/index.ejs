<div class="container py-5">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="text-center mb-4">Daily Concerts</h1>
      <p class="text-center lead">Discover upcoming performances and events from our artists</p>
    </div>
  </div>

  <!-- Filters -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="glass-card-dark p-4">
        <form action="/daily-concerts" method="GET" class="row g-3">
          <!-- Date Filter -->
          <div class="col-md-4">
            <label for="date" class="form-label text-white">Date</label>
            <input type="date" class="form-control bg-dark text-white" id="date" name="date" value="<%= filters.date || '' %>">
          </div>
          
          <!-- City Filter -->
          <div class="col-md-4">
            <label for="city" class="form-label text-white">City</label>
            <select class="form-select bg-dark text-white" id="city" name="city">
              <option value="">All Cities</option>
              <% filterOptions.cities.forEach(city => { %>
                <option value="<%= city %>" <%= filters.city === city ? 'selected' : '' %>><%= city %></option>
              <% }); %>
            </select>
          </div>
          
          <!-- State Filter -->
          <div class="col-md-4">
            <label for="state" class="form-label text-white">State</label>
            <select class="form-select bg-dark text-white" id="state" name="state">
              <option value="">All States</option>
              <% filterOptions.states.forEach(state => { %>
                <option value="<%= state %>" <%= filters.state === state ? 'selected' : '' %>><%= state %></option>
              <% }); %>
            </select>
          </div>
          
          <!-- Filter Button -->
          <div class="col-12 text-center">
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-filter me-2"></i> Filter
            </button>
            <a href="/daily-concerts" class="btn btn-outline-secondary ms-2">
              <i class="bi bi-x-circle me-2"></i> Clear Filters
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Daily Concerts List -->
  <div class="row g-4">
    <% if (dailyConcerts && dailyConcerts.length > 0) { %>
      <% dailyConcerts.forEach(concert => { %>
        <div class="col-md-6 col-lg-4" data-aos="fade-up">
          <div class="glass-card-dark card h-100">
            <div class="card-header bg-dark border-secondary">
              <h5 class="card-title mb-0 text-white"><%= concert.title %></h5>
            </div>
            <div class="card-body">
              <% if (concert.bookingType === 'artist' && concert.artist) { %>
                <div class="d-flex align-items-center mb-3">
                  <img src="<%= concert.artist.user.profileImage || '/images/default-profile.png' %>" 
                       alt="<%= concert.artist.stageName || concert.artist.user.name %>" 
                       class="rounded-circle me-2" 
                       style="width: 40px; height: 40px; object-fit: cover;">
                  <div>
                    <strong><%= concert.artist.stageName || concert.artist.user.name %></strong>
                    <% if (concert.artist.genre) { %>
                      <br><small class="text-muted"><%= concert.artist.genre %></small>
                    <% } %>
                  </div>
                </div>
              <% } else if (concert.bookingType === 'role' && concert.roleSlot) { %>
                <div class="mb-3">
                  <strong><%= concert.roleSlot.name %></strong>
                </div>
              <% } %>

              <p class="card-text text-white mb-2">
                <i class="bi bi-geo-alt me-2"></i> <%= concert.eventCity %>, <%= concert.eventState %>
              </p>
              <p class="card-text text-white mb-2">
                <i class="bi bi-calendar3 me-2"></i> <%= new Date(concert.eventDate).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
              </p>
              <p class="card-text text-white mb-2">
                <i class="bi bi-clock me-2"></i> <%= concert.eventTime %>
              </p>
              <p class="card-text text-white mb-2">
                <i class="bi bi-person me-2"></i> Organized by: <%= concert.organizerName %>
              </p>
              
              <% if (concert.description) { %>
                <div class="mt-3">
                  <h6 class="text-white">Description:</h6>
                  <p class="card-text text-white-50"><%= concert.description %></p>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-12">
        <div class="alert alert-info text-center">
          <i class="bi bi-info-circle me-2"></i> No concerts found matching your criteria. Try adjusting your filters or check back later.
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
  // Apply filters as soon as they change
  document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.querySelector('form');
    const filterInputs = filterForm.querySelectorAll('select, input[type="date"]');
    
    filterInputs.forEach(input => {
      input.addEventListener('change', function() {
        filterForm.submit();
      });
    });
  });
</script>
