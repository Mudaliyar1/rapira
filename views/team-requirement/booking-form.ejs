<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h3 class="mb-0">Book <%= role.name %></h3>
        </div>
        <div class="card-body">
          <div class="mb-4">
            <h5>Role Details</h5>
            <p><strong>Role:</strong> <%= role.name %></p>
            <p><strong>Location:</strong> <%= role.city %>, <%= role.state %></p>
            <p><strong>Description:</strong> <%= role.description %></p>
          </div>

          <hr class="my-4">

          <h5 class="mb-3">Your Information</h5>
          <form action="/team-requirement/book/<%= role._id %>" method="POST">
            <div class="mb-3">
              <label for="name" class="form-label">Your Name *</label>
              <input type="text" class="form-control" id="name" name="name" required>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Email Address *</label>
              <input type="email" class="form-control" id="email" name="email" required>
            </div>

            <div class="mb-3">
              <label for="phone" class="form-label">Phone Number *</label>
              <input type="tel" class="form-control" id="phone" name="phone" required>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="city" class="form-label">City *</label>
                <input type="text" class="form-control" id="city" name="city" required>
              </div>

              <div class="col-md-6 mb-3">
                <label for="state" class="form-label">State *</label>
                <input type="text" class="form-control" id="state" name="state" required>
              </div>
            </div>

            <div class="mb-3">
              <label for="message" class="form-label">Message (Please describe your requirements) *</label>
              <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-primary btn-lg">Submit Booking Request</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>


