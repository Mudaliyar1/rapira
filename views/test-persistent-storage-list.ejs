<%- include('partials/header') %>

<div class="container mt-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h2 class="mb-0">Test Files List</h2>
        </div>
        <div class="card-body">
          <% if (isPersistentStorageAvailable) { %>
            <div class="alert alert-success">
              <i class="fas fa-check-circle"></i> Persistent storage is available and configured correctly.
            </div>
          <% } else { %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle"></i> Persistent storage is not available. Files will be stored in ephemeral storage only.
            </div>
          <% } %>

          <% if (files && files.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead class="table-dark">
                  <tr>
                    <th>Filename</th>
                    <th>Size</th>
                    <th>Created</th>
                    <th>In Persistent Storage</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% files.forEach(file => { %>
                    <tr>
                      <td><%= file.filename %></td>
                      <td><%= file.size %></td>
                      <td><%= file.created %></td>
                      <td>
                        <% if (file.inPersistentStorage === 'Yes') { %>
                          <span class="badge bg-success">Yes</span>
                        <% } else if (file.inPersistentStorage === 'No') { %>
                          <span class="badge bg-danger">No</span>
                        <% } else { %>
                          <span class="badge bg-secondary"><%= file.inPersistentStorage %></span>
                        <% } %>
                      </td>
                      <td>
                        <a href="<%= file.path %>" target="_blank" class="btn btn-sm btn-primary">
                          <i class="fas fa-external-link-alt"></i> View
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <i class="fas fa-info-circle"></i> No test files have been uploaded yet.
            </div>
          <% } %>

          <div class="mt-3">
            <a href="/test-persistent-storage" class="btn btn-primary">
              <i class="fas fa-upload"></i> Upload New Test File
            </a>
          </div>

          <div class="mt-4">
            <div class="card">
              <div class="card-header bg-info text-white">
                How to Verify Persistent Storage
              </div>
              <div class="card-body">
                <ol>
                  <li>Upload files using the test upload page</li>
                  <li>Note which files are stored in persistent storage</li>
                  <li>Restart the server (or wait for a deployment)</li>
                  <li>Return to this page and verify that files in persistent storage are still accessible</li>
                  <li>Files not in persistent storage may become inaccessible after a restart</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
