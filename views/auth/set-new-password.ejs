<%- contentFor('title') %>Set New Password - Rapira

<%- contentFor('head') %>
<style>
  /* Animation for shaking effect when passwords don't match */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
    20%, 40%, 60%, 80% { transform: translateX(5px); }
  }

  .shake {
    animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
  }

  /* Make error messages more prominent */
  .text-danger.fw-bold {
    font-size: 0.9rem;
    margin-top: 0.5rem !important;
  }

  .text-success.fw-bold {
    font-size: 0.9rem;
    margin-top: 0.5rem !important;
  }
</style>

<%- contentFor('body') %>
<!-- Set New Password Form -->
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <h2 class="fw-bold mb-1">Set New Password</h2>
            <p class="text-muted">Create a new password for your account</p>
          </div>

          <div class="alert alert-success mb-4" style="background-color: rgba(25, 135, 84, 0.2); border: 1px solid rgba(25, 135, 84, 0.3);">
            <div class="d-flex">
              <div class="me-3">
                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
              </div>
              <div>
                <h5 class="alert-heading text-dark">OTP Verified Successfully</h5>
                <p class="mb-0 text-dark">Your identity has been verified. Please set a new password for your account.</p>
              </div>
            </div>
          </div>

          <form action="/auth/set-new-password" method="POST" id="resetPasswordForm">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="otp" value="<%= otp %>">

            <div class="mb-4">
              <label for="password" class="form-label">New Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light">
                  <i class="bi bi-lock"></i>
                </span>
                <input type="password" class="form-control" id="password" name="password" placeholder="Enter your new password" required autofocus minlength="8">
              </div>
              <div class="form-text">Password must be at least 8 characters long</div>
              <div class="mt-2">
                <div class="progress" style="height: 5px;">
                  <div id="passwordStrength" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small id="passwordStrengthText" class="form-text mt-1"></small>
              </div>
              <div id="passwordLengthFeedback" class="text-danger mt-1 fw-bold" style="display: none;">
                <i class="bi bi-x-circle-fill"></i> Password must be at least 8 characters long
              </div>
            </div>

            <div class="mb-4">
              <label for="confirmPassword" class="form-label">Confirm New Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light">
                  <i class="bi bi-lock-fill"></i>
                </span>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirm your new password" required>
              </div>
              <div id="passwordMatchFeedback" class="text-danger mt-1 fw-bold" style="display: none;">
                <i class="bi bi-x-circle-fill"></i> Passwords do not match
              </div>
              <div id="passwordMatchSuccess" class="text-success mt-1 fw-bold" style="display: none;">
                <i class="bi bi-check-circle-fill"></i> Passwords match
              </div>
            </div>

            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-primary py-2" id="resetPasswordBtn">Reset Password</button>
            </div>

            <script>
              // Additional check when the Reset Password button is clicked
              document.getElementById('resetPasswordBtn').addEventListener('click', function() {
                const password = document.getElementById('password').value;
                const confirmPassword = document.getElementById('confirmPassword').value;
                const passwordMatchFeedback = document.getElementById('passwordMatchFeedback');

                // If passwords don't match, show the error message
                if (password !== confirmPassword) {
                  passwordMatchFeedback.style.display = 'block';
                  document.getElementById('confirmPassword').classList.add('is-invalid');
                  console.log('Reset button clicked: Passwords do not match');
                }
              });
            </script>

            <script>
              document.addEventListener('DOMContentLoaded', function() {
                const passwordInput = document.getElementById('password');
                const confirmPasswordInput = document.getElementById('confirmPassword');
                const passwordMatchFeedback = document.getElementById('passwordMatchFeedback');
                const passwordLengthFeedback = document.getElementById('passwordLengthFeedback');
                const passwordStrength = document.getElementById('passwordStrength');
                const passwordStrengthText = document.getElementById('passwordStrengthText');
                const resetPasswordBtn = document.getElementById('resetPasswordBtn');
                const resetPasswordForm = document.getElementById('resetPasswordForm');

                // Function to check password strength
                function checkPasswordStrength(password) {
                  // Initialize variables
                  let strength = 0;
                  let tips = [];

                  // Check password length
                  if (password.length < 8) {
                    passwordLengthFeedback.style.display = 'block';
                    passwordInput.classList.add('is-invalid');
                    tips.push("Make it at least 8 characters");
                  } else {
                    passwordLengthFeedback.style.display = 'none';
                    passwordInput.classList.remove('is-invalid');
                    strength += 25;
                  }

                  // Check for mixed case
                  if (password.match(/[a-z]/) && password.match(/[A-Z]/)) {
                    strength += 25;
                  } else {
                    tips.push("Add both uppercase and lowercase letters");
                  }

                  // Check for numbers
                  if (password.match(/\d/)) {
                    strength += 25;
                  } else {
                    tips.push("Include at least one number");
                  }

                  // Check for special characters
                  if (password.match(/[^a-zA-Z\d]/)) {
                    strength += 25;
                  } else {
                    tips.push("Add at least one special character");
                  }

                  // Update the strength bar
                  passwordStrength.style.width = strength + '%';
                  passwordStrength.setAttribute('aria-valuenow', strength);

                  // Update the text and color based on strength
                  if (strength < 25) {
                    passwordStrength.className = 'progress-bar bg-danger';
                    passwordStrengthText.textContent = 'Very Weak';
                    passwordStrengthText.className = 'form-text text-danger mt-1';
                  } else if (strength < 50) {
                    passwordStrength.className = 'progress-bar bg-warning';
                    passwordStrengthText.textContent = 'Weak';
                    passwordStrengthText.className = 'form-text text-warning mt-1';
                  } else if (strength < 75) {
                    passwordStrength.className = 'progress-bar bg-info';
                    passwordStrengthText.textContent = 'Medium';
                    passwordStrengthText.className = 'form-text text-info mt-1';
                  } else if (strength < 100) {
                    passwordStrength.className = 'progress-bar bg-primary';
                    passwordStrengthText.textContent = 'Strong';
                    passwordStrengthText.className = 'form-text text-primary mt-1';
                  } else {
                    passwordStrength.className = 'progress-bar bg-success';
                    passwordStrengthText.textContent = 'Very Strong';
                    passwordStrengthText.className = 'form-text text-success mt-1';
                  }

                  // Add tips if there are any
                  if (tips.length > 0) {
                    passwordStrengthText.textContent += ': ' + tips.join(', ');
                  }

                  return strength >= 50; // Return true if password is at least medium strength
                }

                // Function to check if passwords match
                function checkPasswordsMatch() {
                  const password = passwordInput.value;
                  const confirmPassword = confirmPasswordInput.value;
                  const passwordMatchSuccess = document.getElementById('passwordMatchSuccess');
                  const passwordMatchFeedback = document.getElementById('passwordMatchFeedback');

                  // If both fields have values, check if they match
                  if (password && confirmPassword) {
                    if (password === confirmPassword) {
                      // Passwords match
                      passwordMatchFeedback.style.display = 'none';
                      passwordMatchSuccess.style.display = 'block';
                      confirmPasswordInput.classList.remove('is-invalid');
                      confirmPasswordInput.classList.add('is-valid');
                      console.log('checkPasswordsMatch: Passwords match');
                      return true;
                    } else {
                      // Passwords don't match
                      passwordMatchFeedback.style.display = 'block';
                      passwordMatchSuccess.style.display = 'none';
                      confirmPasswordInput.classList.add('is-invalid');
                      confirmPasswordInput.classList.remove('is-valid');
                      console.log('checkPasswordsMatch: Passwords do not match');
                      return false;
                    }
                  } else if (confirmPassword) {
                    // Confirm password has a value but password is empty
                    passwordMatchFeedback.style.display = 'block';
                    passwordMatchSuccess.style.display = 'none';
                    confirmPasswordInput.classList.add('is-invalid');
                    confirmPasswordInput.classList.remove('is-valid');
                    console.log('checkPasswordsMatch: Password field is empty');
                    return false;
                  } else {
                    // Confirm password is empty, don't show any feedback yet
                    passwordMatchFeedback.style.display = 'none';
                    passwordMatchSuccess.style.display = 'none';
                    confirmPasswordInput.classList.remove('is-invalid');
                    confirmPasswordInput.classList.remove('is-valid');
                    console.log('checkPasswordsMatch: Confirm password field is empty');
                    return false;
                  }
                }

                // Real-time validation as user types in confirm password field
                confirmPasswordInput.addEventListener('input', function() {
                  // Always check for match when confirm password has any value
                  if (confirmPasswordInput.value) {
                    // Directly compare values and show feedback
                    const password = passwordInput.value;
                    const confirmPassword = confirmPasswordInput.value;
                    const passwordMatchSuccess = document.getElementById('passwordMatchSuccess');
                    const passwordMatchFeedback = document.getElementById('passwordMatchFeedback');

                    if (password === confirmPassword) {
                      // Passwords match
                      passwordMatchFeedback.style.display = 'none';
                      passwordMatchSuccess.style.display = 'block';
                      confirmPasswordInput.classList.remove('is-invalid');
                      confirmPasswordInput.classList.add('is-valid');
                    } else {
                      // Passwords don't match - ALWAYS show this message
                      passwordMatchFeedback.style.display = 'block';
                      passwordMatchSuccess.style.display = 'none';
                      confirmPasswordInput.classList.add('is-invalid');
                      confirmPasswordInput.classList.remove('is-valid');
                    }
                  } else {
                    // If confirm password is empty, hide feedback
                    document.getElementById('passwordMatchFeedback').style.display = 'none';
                    document.getElementById('passwordMatchSuccess').style.display = 'none';
                    confirmPasswordInput.classList.remove('is-invalid');
                    confirmPasswordInput.classList.remove('is-valid');
                  }
                });

                // Check password strength and match when typing in the password field
                passwordInput.addEventListener('input', function() {
                  // Always check password strength
                  checkPasswordStrength(this.value);

                  // If confirm password already has a value, check match on password change
                  if (confirmPasswordInput.value) {
                    const password = passwordInput.value;
                    const confirmPassword = confirmPasswordInput.value;
                    const passwordMatchSuccess = document.getElementById('passwordMatchSuccess');
                    const passwordMatchFeedback = document.getElementById('passwordMatchFeedback');

                    if (password === confirmPassword) {
                      // Passwords match
                      passwordMatchFeedback.style.display = 'none';
                      passwordMatchSuccess.style.display = 'block';
                      confirmPasswordInput.classList.remove('is-invalid');
                      confirmPasswordInput.classList.add('is-valid');
                    } else {
                      // Passwords don't match - ALWAYS show this message
                      passwordMatchFeedback.style.display = 'block';
                      passwordMatchSuccess.style.display = 'none';
                      confirmPasswordInput.classList.add('is-invalid');
                      confirmPasswordInput.classList.remove('is-valid');
                    }
                  }
                });

                // Check password strength on input - already handled in the event listener above

                // Prevent form submission if validation fails
                resetPasswordForm.addEventListener('submit', function(event) {
                  // Always prevent default form submission first
                  event.preventDefault();

                  const password = passwordInput.value;
                  const confirmPassword = confirmPasswordInput.value;
                  const passwordMatchSuccess = document.getElementById('passwordMatchSuccess');
                  const passwordMatchFeedback = document.getElementById('passwordMatchFeedback');

                  // Check password length and strength
                  const isStrongEnough = checkPasswordStrength(password);

                  // Check if passwords match - direct comparison
                  const doPasswordsMatch = (password === confirmPassword);

                  // Flag to track if we can submit the form
                  let canSubmit = true;

                  // Check password match first
                  if (!doPasswordsMatch) {
                    canSubmit = false;

                    // Show error message under confirm password field
                    passwordMatchFeedback.style.display = 'block';
                    passwordMatchSuccess.style.display = 'none';
                    confirmPasswordInput.classList.add('is-invalid');
                    confirmPasswordInput.classList.remove('is-valid');

                    // Add a red border to both password fields
                    passwordInput.classList.add('is-invalid');
                    confirmPasswordInput.classList.add('is-invalid');

                    // Shake the confirm password field to draw attention
                    confirmPasswordInput.classList.add('shake');
                    setTimeout(function() {
                      confirmPasswordInput.classList.remove('shake');
                    }, 500);

                    // Focus on the confirm password field
                    confirmPasswordInput.focus();

                    console.log('Form submission prevented: Passwords do not match');
                  }

                  // Check password strength
                  if (!isStrongEnough) {
                    canSubmit = false;

                    passwordLengthFeedback.style.display = 'block';
                    passwordInput.classList.add('is-invalid');
                    passwordInput.classList.remove('is-valid');

                    // If passwords match but password isn't strong enough, focus on password field
                    if (doPasswordsMatch) {
                      passwordInput.focus();
                    }

                    console.log('Form submission prevented: Password not strong enough');
                  }

                  // If all validations pass, manually submit the form
                  if (canSubmit) {
                    console.log('Form validation passed, submitting form');
                    resetPasswordForm.submit();
                  }
                });

                // Initial checks when page loads
                if (passwordInput.value) {
                  checkPasswordStrength(passwordInput.value);
                }

                // Initial check for password match - use direct comparison for reliability
                if (confirmPasswordInput.value) {
                  const password = passwordInput.value;
                  const confirmPassword = confirmPasswordInput.value;
                  const passwordMatchSuccess = document.getElementById('passwordMatchSuccess');
                  const passwordMatchFeedback = document.getElementById('passwordMatchFeedback');

                  if (password === confirmPassword) {
                    // Passwords match
                    passwordMatchFeedback.style.display = 'none';
                    passwordMatchSuccess.style.display = 'block';
                    confirmPasswordInput.classList.remove('is-invalid');
                    confirmPasswordInput.classList.add('is-valid');
                  } else {
                    // Passwords don't match - ALWAYS show this message
                    passwordMatchFeedback.style.display = 'block';
                    passwordMatchSuccess.style.display = 'none';
                    confirmPasswordInput.classList.add('is-invalid');
                    confirmPasswordInput.classList.remove('is-valid');
                  }
                }

                // Log to console for debugging
                console.log('Password validation script loaded');
              });
            </script>

            <div class="text-center">
              <p class="mb-0">Remember your password? <a href="/auth/login" class="text-decoration-none">Login</a></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
