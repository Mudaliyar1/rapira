<%- contentFor('title') %>Reset Password - Rapira

<%- contentFor('body') %>
<!-- Reset Password Form -->
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <h2 class="fw-bold mb-1">Reset Password</h2>
            <p class="text-muted">We've sent a 6-digit OTP to <strong><%= email %></strong></p>
          </div>

          <div class="alert alert-info mb-4" style="background-color: rgba(13, 202, 240, 0.2); border: 1px solid rgba(13, 202, 240, 0.3);">
            <div class="d-flex">
              <div class="me-3">
                <i class="bi bi-info-circle-fill fs-4 text-info"></i>
              </div>
              <div>
                <h5 class="alert-heading text-dark">Check Your Email</h5>
                <p class="mb-0 text-dark">Please check your email inbox for the OTP (One-Time Password). If you don't see it, check your spam folder.</p>
              </div>
            </div>
          </div>

          <form action="/auth/verify-otp" method="POST">
            <input type="hidden" name="email" value="<%= email %>">

            <div class="mb-4">
              <label for="otp" class="form-label">Enter One-Time Password (OTP)</label>
              <div class="input-group">
                <span class="input-group-text bg-light">
                  <i class="bi bi-shield-lock"></i>
                </span>
                <input type="text" class="form-control" id="otp" name="otp" placeholder="Enter the 6-digit OTP" required autofocus>
              </div>
              <div class="form-text">Enter the 6-digit code we sent to your email</div>
            </div>

            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-primary py-2">Verify OTP</button>
            </div>

            <div class="text-center mb-3">
              <p class="mb-0">Didn't receive the OTP? <a href="/auth/forgot-password?email=<%= encodeURIComponent(email) %>&resend=true" class="text-decoration-none">Resend OTP</a></p>
            </div>

            <div class="text-center">
              <p class="mb-0">Remember your password? <a href="/auth/login" class="text-decoration-none">Login</a></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

