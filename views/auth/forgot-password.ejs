<%- contentFor('title') %>Forgot Password - Rapira

<%- contentFor('body') %>
<!-- Forgot Password Form -->
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <h2 class="fw-bold mb-1">Forgot Password</h2>
            <p class="text-muted">Enter your email address to receive a password reset OTP</p>
          </div>

          <% if (typeof prefillEmail === 'string' && prefillEmail) { %>
            <div class="alert alert-info mb-4">
              <div class="d-flex">
                <div class="me-3">
                  <i class="bi bi-info-circle-fill fs-4"></i>
                </div>
                <div>
                  <h5 class="alert-heading">Resend OTP</h5>
                  <p class="mb-0">We'll send a new OTP to your email address.</p>
                </div>
              </div>
            </div>
          <% } %>

          <form action="/auth/forgot-password" method="POST">
            <div class="mb-4">
              <label for="email" class="form-label">Email Address</label>
              <div class="input-group">
                <span class="input-group-text bg-light">
                  <i class="bi bi-envelope"></i>
                </span>
                <input type="email" class="form-control" id="email" name="email"
                       value="<%= typeof prefillEmail === 'string' && prefillEmail ? prefillEmail : '' %>"
                       placeholder="Enter your email" required autofocus>
              </div>
            </div>

            <div class="d-grid mb-4">
              <button type="submit" class="btn btn-primary py-2">Send OTP</button>
            </div>

            <div class="text-center">
              <p class="mb-0">Remember your password? <a href="/auth/login" class="text-decoration-none">Login</a></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
