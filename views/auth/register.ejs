<%- contentFor('title') %>Register - Rapira

<%- contentFor('body') %>
<div class="rapira-auth-page">
  <!-- Subtle Topographic Contour Art -->
  <div class="rapira-auth-bg-art" aria-hidden="true">
    <svg viewBox="0 0 1440 900" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-100 220 C 140 260, 210 460, -40 700" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.38"/>
      <path d="M-150 140 C 210 190, 280 430, -70 770" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.28"/>
      <path d="M-200 60 C 280 120, 350 400, -90 840" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.18"/>
      <path d="M 1540 260 C 1290 320, 1220 540, 1480 790" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.38"/>
      <path d="M 1590 190 C 1220 250, 1160 520, 1530 860" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.28"/>
      <path d="M 1640 110 C 1150 180, 1090 500, 1570 930" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.18"/>
    </svg>
  </div>

  <div class="rapira-auth-layout-container">
    <!-- Left: Authentic Rotating Culture Stamp -->
    <div class="rapira-auth-side-stamp d-none d-lg-block">
      <div class="rh-auth-stamp-wrap" title="RAPIRA Culture Stamp">
        <svg viewBox="0 0 160 160" width="100%" height="100%" class="rh-stamp-svg">
          <defs>
            <path id="rhCirclePathRegister" d="M 80, 80 m -60, 0 a 60,60 0 1,1 120,0 a 60,60 0 1,1 -120,0" />
          </defs>
          <circle cx="80" cy="80" r="74" fill="none" stroke="#9F190E" stroke-width="1.2" stroke-opacity="0.5" stroke-dasharray="3,2" />
          <circle cx="80" cy="80" r="50" fill="none" stroke="#9F190E" stroke-width="1" stroke-opacity="0.4" />
          <text class="rh-stamp-text">
            <textPath href="#rhCirclePathRegister" startOffset="0%">
              INDIAN ARTISTS • LIVE EXP • RAPIRA • CULTURE • 
            </textPath>
          </text>
          <!-- 4-point star in center -->
          <path d="M80 62 L83.5 76.5 L98 80 L83.5 83.5 L80 98 L76.5 83.5 L62 80 L76.5 76.5 Z" fill="#9F190E" />
        </svg>
      </div>
    </div>

    <!-- Center: Authentic Redesigned Registration Card -->
    <div class="rapira-auth-card card-register">
      <div class="rapira-auth-header">
        <h1 class="rapira-auth-title">Create an Account</h1>
        <p class="rapira-auth-subtitle">Join Rapira and connect with the music community</p>
      </div>

      <form action="/auth/register" method="POST">
        <!-- Full Name Field -->
        <div class="rapira-auth-field">
          <label for="name" class="rapira-auth-label">Full Name</label>
          <div class="rapira-auth-input-wrap">
            <span class="rapira-auth-input-icon"><i class="bi bi-person"></i></span>
            <input type="text" class="rapira-auth-input" id="name" name="name" placeholder="Enter your full name" required autocomplete="name">
          </div>
        </div>

        <!-- Email Field -->
        <div class="rapira-auth-field">
          <label for="email" class="rapira-auth-label">Email Address</label>
          <div class="rapira-auth-input-wrap">
            <span class="rapira-auth-input-icon"><i class="bi bi-envelope"></i></span>
            <input type="email" class="rapira-auth-input" id="email" name="email" placeholder="Enter your email" required autocomplete="email">
          </div>
        </div>

        <!-- Password Field -->
        <div class="rapira-auth-field">
          <label for="password" class="rapira-auth-label">Password</label>
          <div class="rapira-auth-input-wrap">
            <span class="rapira-auth-input-icon"><i class="bi bi-lock"></i></span>
            <input type="password" class="rapira-auth-input" id="password" name="password" placeholder="Create a password" required minlength="8" autocomplete="new-password">
            <button class="btn rapira-auth-toggle-btn password-toggle-btn" type="button" data-target="password" aria-label="Show password">
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <div class="rapira-auth-hint">Password must be at least 8 characters long</div>
        </div>

        <!-- Confirm Password Field -->
        <div class="rapira-auth-field">
          <label for="confirmPassword" class="rapira-auth-label">Confirm Password</label>
          <div class="rapira-auth-input-wrap">
            <span class="rapira-auth-input-icon"><i class="bi bi-lock-fill"></i></span>
            <input type="password" class="rapira-auth-input" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password" required autocomplete="new-password">
            <button class="btn rapira-auth-toggle-btn password-toggle-btn" type="button" data-target="confirmPassword" aria-label="Show password">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>

        <!-- Terms & Policies Checkbox -->
        <div class="rapira-auth-terms-group">
          <label class="rapira-auth-terms-label" for="terms">
            <input class="rapira-auth-checkbox" type="checkbox" id="terms" required>
            <span>I agree to the <a href="/terms-of-service" class="rapira-auth-policy-link">Terms of Service</a>, <a href="/privacy-policy" class="rapira-auth-policy-link">Privacy Policy</a>, and <a href="/temp-email-policy" class="rapira-auth-policy-link">Temp Email Policy</a></span>
          </label>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="rapira-auth-btn-primary">Send OTP & Continue</button>

        <!-- Footer Link -->
        <p class="rapira-auth-footer-text">
          Already have an account?<a href="/auth/login" class="rapira-auth-accent-link">Sign in</a>
        </p>
      </form>
    </div>

    <!-- Right: Editorial Script Accent -->
    <div class="rapira-auth-side-script d-none d-lg-block">
      <div class="rh-auth-script-inner">
        <span>Artists</span>
        <span>Fans</span>
        <span>Events</span>
        <span>Community</span>
        <svg class="rh-script-underline" viewBox="0 0 130 18" width="105" height="15" aria-hidden="true">
          <path d="M 4 8 Q 65 18 126 4" fill="none" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </div>
</div>
