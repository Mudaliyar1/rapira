<%- contentFor('title') %>Verify Registration - Rapira

<%- contentFor('body') %>
<div class="rapira-auth-page">
  <!-- Subtle Topographic Contour Art -->
  <div class="rapira-auth-bg-art" aria-hidden="true">
    <svg viewBox="0 0 1440 900" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-100 220 C 140 260, 210 460, -40 700" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.38"/>
      <path d="M-150 140 C 210 190, 280 430, -70 770" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.28"/>
      <path d="M-200 60 C 280 120, 350 400, -90 840" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.18"/>
      <path d="M 1540 260 C 1290 320, 1220 540, 1480 790" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.38"/>
      <path d="M 1590 190 C 1220 250, 1160 520, 1530 860" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.28"/>
      <path d="M 1640 110 C 1150 180, 1090 500, 1570 930" stroke="#EAC8B7" stroke-width="1.2" stroke-opacity="0.18"/>
    </svg>
  </div>

  <div class="rapira-auth-layout-container">
    <!-- Left: Authentic Rotating Culture Stamp -->
    <div class="rapira-auth-side-stamp d-none d-lg-block">
      <div class="rh-auth-stamp-wrap" title="RAPIRA Culture Stamp">
        <svg viewBox="0 0 160 160" width="100%" height="100%" class="rh-stamp-svg">
          <defs>
            <path id="rhCirclePathVerify" d="M 80, 80 m -60, 0 a 60,60 0 1,1 120,0 a 60,60 0 1,1 -120,0" />
          </defs>
          <circle cx="80" cy="80" r="74" fill="none" stroke="#9F190E" stroke-width="1.2" stroke-opacity="0.5" stroke-dasharray="3,2" />
          <circle cx="80" cy="80" r="50" fill="none" stroke="#9F190E" stroke-width="1" stroke-opacity="0.4" />
          <text class="rh-stamp-text">
            <textPath href="#rhCirclePathVerify" startOffset="0%">
              INDIAN ARTISTS • LIVE EXP • RAPIRA • CULTURE • 
            </textPath>
          </text>
          <!-- 4-point star in center -->
          <path d="M80 62 L83.5 76.5 L98 80 L83.5 83.5 L80 98 L76.5 83.5 L62 80 L76.5 76.5 Z" fill="#9F190E" />
        </svg>
      </div>
    </div>

    <!-- Center: Authentic Redesigned OTP Card -->
    <div class="rapira-auth-card card-otp">
      <div class="rapira-auth-header">
        <h1 class="rapira-auth-title">Verify your email</h1>
        <p class="rapira-auth-subtitle">Enter the 6-digit code sent to your email</p>
      </div>

      <!-- Masked Email Pill Badge -->
      <% 
        let displayEmail = 'your email';
        if (typeof email !== 'undefined' && email) {
          const atIndex = email.indexOf('@');
          if (atIndex > 2) {
            displayEmail = email.substring(0, 2) + '********' + email.substring(atIndex);
          } else {
            displayEmail = email;
          }
        }
      %>
      <div class="text-center">
        <div class="rapira-auth-email-badge">
          <i class="bi bi-envelope"></i>
          <span><%= displayEmail %></span>
        </div>
      </div>

      <form id="otpForm" action="/auth/register/verify" method="POST">
        <!-- 6 Visually Separate Digit Boxes -->
        <div class="rapira-auth-otp-boxes" id="otpBoxContainer">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="rapira-auth-otp-digit" data-idx="0" autocomplete="one-time-code" aria-label="Digit 1" autofocus>
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="rapira-auth-otp-digit" data-idx="1" aria-label="Digit 2">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="rapira-auth-otp-digit" data-idx="2" aria-label="Digit 3">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="rapira-auth-otp-digit" data-idx="3" aria-label="Digit 4">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="rapira-auth-otp-digit" data-idx="4" aria-label="Digit 5">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="rapira-auth-otp-digit" data-idx="5" aria-label="Digit 6">
        </div>

        <!-- Hidden input for standard POST form submission -->
        <input type="hidden" id="otp" name="otp" required>

        <!-- Resend Countdown Timer -->
        <div class="rapira-auth-otp-timer" id="otpTimerWrap">
          <i class="bi bi-clock"></i>
          <span>Resend code in <span id="otpCountdown">00:45</span></span>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="rapira-auth-btn-primary" id="verifyOtpBtn">Verify & Create Account</button>

        <!-- Footer Link: Change Email Address -->
        <div class="rapira-auth-footer-text">
          <a href="/auth/register" class="rapira-auth-change-email-link">Change email address</a>
        </div>
      </form>
    </div>

    <!-- Right: Editorial Script Accent -->
    <div class="rapira-auth-side-script d-none d-lg-block">
      <div class="rh-auth-script-inner">
        <span>Artists</span>
        <span>Fans</span>
        <span>Events</span>
        <span>Community</span>
        <svg class="rh-script-underline" viewBox="0 0 130 18" width="105" height="15" aria-hidden="true">
          <path d="M 4 8 Q 65 18 126 4" fill="none" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const digitInputs = Array.from(document.querySelectorAll('.rapira-auth-otp-digit'));
    const hiddenOtp = document.getElementById('otp');
    const otpForm = document.getElementById('otpForm');

    function syncOtpValue() {
      const code = digitInputs.map(input => input.value).join('');
      hiddenOtp.value = code;
      return code;
    }

    digitInputs.forEach((input, index) => {
      // Input event: only keep 1 digit and advance
      input.addEventListener('input', function (e) {
        const val = this.value.replace(/\D/g, '');
        if (val.length > 0) {
          this.value = val[val.length - 1]; // keep last typed digit
          if (index < digitInputs.length - 1) {
            digitInputs[index + 1].focus();
            digitInputs[index + 1].select();
          }
        } else {
          this.value = '';
        }
        syncOtpValue();
      });

      // Keydown: backspace & arrow key handling
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Backspace') {
          if (!this.value && index > 0) {
            digitInputs[index - 1].focus();
            digitInputs[index - 1].value = '';
            syncOtpValue();
            e.preventDefault();
          } else {
            this.value = '';
            syncOtpValue();
          }
        } else if (e.key === 'ArrowLeft' && index > 0) {
          digitInputs[index - 1].focus();
          e.preventDefault();
        } else if (e.key === 'ArrowRight' && index < digitInputs.length - 1) {
          digitInputs[index + 1].focus();
          e.preventDefault();
        }
      });

      // Paste handling
      input.addEventListener('paste', function (e) {
        e.preventDefault();
        const pastedData = (e.clipboardData || window.clipboardData).getData('text');
        const digits = pastedData.replace(/\D/g, '').split('').slice(0, 6);
        if (digits.length > 0) {
          digits.forEach((digit, i) => {
            if (digitInputs[i]) {
              digitInputs[i].value = digit;
            }
          });
          syncOtpValue();
          const targetIndex = Math.min(digits.length, digitInputs.length - 1);
          digitInputs[targetIndex].focus();
        }
      });

      // Select text on focus
      input.addEventListener('focus', function () {
        this.select();
      });
    });

    // Form validation
    if (otpForm) {
      otpForm.addEventListener('submit', function (e) {
        const code = syncOtpValue();
        if (code.length < 6) {
          e.preventDefault();
          // Find first empty digit
          const firstEmpty = digitInputs.find(inp => !inp.value);
          if (firstEmpty) {
            firstEmpty.focus();
          }
        }
      });
    }

    // Resend countdown timer (45 seconds)
    const countdownEl = document.getElementById('otpCountdown');
    const timerWrap = document.getElementById('otpTimerWrap');
    let timeLeft = 45;

    if (countdownEl && timerWrap) {
      const interval = setInterval(function () {
        timeLeft--;
        if (timeLeft <= 0) {
          clearInterval(interval);
          timerWrap.innerHTML = '<i class="bi bi-arrow-repeat"></i> Didn\'t get code? <a href="/auth/register" class="rapira-auth-accent-link ms-1">Resend code</a>';
        } else {
          const seconds = timeLeft < 10 ? '0' + timeLeft : timeLeft;
          countdownEl.textContent = '00:' + seconds;
        }
      }, 1000);
    }
  })();
</script>
