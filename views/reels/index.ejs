<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title || 'Reels - RAPIRA' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Google Fonts: Poppins & Titan One -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Titan+One&display=swap" rel="stylesheet">
  
  <!-- RAPIRA Unified Homepage & Reels Stylesheet -->
  <link rel="stylesheet" href="/css/homepage.css?v=20261107a">

  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #000000;
      color: #FFFFFF;
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    /* Fallback background if modal is dismissed */
    .reels-standalone-backdrop {
      position: fixed;
      inset: 0;
      background: #0A0A0A;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      z-index: 1;
    }
  </style>
</head>
<body class="rh-modal-open">

  <!-- Background container if user closes viewer -->
  <div class="reels-standalone-backdrop">
    <a href="/" class="text-decoration-none mb-3">
      <span class="fs-1 fw-bold text-danger" style="font-family: 'Titan One', sans-serif;">RAPIRA</span>
    </a>
    <h2 class="fs-4 text-white mb-2">Music Reels Feed</h2>
    <p class="text-white-50 small mb-4">Experience live performances, behind-the-scenes and original tracks.</p>
    <div class="d-flex gap-3">
      <button type="button" class="btn btn-danger rounded-pill px-4" onclick="window.openRapiraReelIndex(0)">
        <i class="bi bi-play-circle-fill me-2"></i> Open Reels
      </button>
      <a href="/" class="btn btn-outline-light rounded-pill px-4">Back to Home</a>
    </div>
  </div>

  <!-- Shared RAPIRA Reel Modal Component -->
  <%- include('../partials/reel-modal') %>

  <!-- Data Injection for Client Controller -->
  <script>
    window.rapiraReelsData = <%- JSON.stringify(reels) %>;
    window.rapiraTargetPostId = <%- JSON.stringify(targetPostId) %>;
    window.isReelsStandalonePage = true;
  </script>

  <!-- Bootstrap Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Unified Reels Viewer Controller -->
  <script src="/js/reel-viewer.js?v=20261107a"></script>
</body>
</html>
