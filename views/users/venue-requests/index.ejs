<div class="rapira-profile-page">
  <div class="container">
    <div class="rh-subpage-container" style="max-width: 960px;">
      
      <!-- Page Navigation Header -->
      <div class="rh-page-header-nav">
        <div class="rh-page-header-left">
          <a href="/users/profile" class="rh-back-circle-btn" title="Back to Profile">
            <i class="bi bi-arrow-left"></i>
          </a>
          <h1 class="rh-page-title">My Venue Requests</h1>
        </div>
        <a href="/users/venue-requests/create" class="rh-btn-primary">
          <i class="bi bi-plus-lg me-1"></i> Request New Venue
        </a>
      </div>

      <%
        const totalRequests = venueRequests ? venueRequests.length : 0;
        const pendingRequests = venueRequests ? venueRequests.filter(req => req.status === 'pending').length : 0;
        const approvedRequests = venueRequests ? venueRequests.filter(req => req.status === 'approved').length : 0;
        const rejectedRequests = venueRequests ? venueRequests.filter(req => req.status === 'rejected').length : 0;
      %>

      <!-- Stats Pills Row -->
      <div class="rh-stats-pills-row">
        <div class="rh-stats-pill">
          <i class="bi bi-building text-danger"></i>
          <span>Total: <strong class="rh-stats-pill-num"><%= totalRequests %></strong></span>
        </div>
        <div class="rh-stats-pill">
          <i class="bi bi-clock-fill text-warning"></i>
          <span>Pending: <strong class="rh-stats-pill-num" style="color: #B76E00;"><%= pendingRequests %></strong></span>
        </div>
        <div class="rh-stats-pill">
          <i class="bi bi-check-circle-fill text-success"></i>
          <span>Approved: <strong class="rh-stats-pill-num" style="color: #0F7A4D;"><%= approvedRequests %></strong></span>
        </div>
        <% if (rejectedRequests > 0) { %>
          <div class="rh-stats-pill">
            <i class="bi bi-x-circle-fill text-danger"></i>
            <span>Rejected: <strong class="rh-stats-pill-num" style="color: #B91C1C;"><%= rejectedRequests %></strong></span>
          </div>
        <% } %>
      </div>

      <!-- Venue Requests Content -->
      <div class="rh-profile-card">
        <div class="rh-profile-card-header">
          <div class="rh-profile-card-title-wrap">
            <i class="bi bi-list-ul text-danger fs-5"></i>
            <h2 class="rh-profile-card-title">Registration Requests</h2>
          </div>
        </div>

        <div class="rh-profile-card-body p-3">
          <% if (venueRequests && venueRequests.length > 0) { %>
            <div class="d-flex flex-column gap-3">
              <% venueRequests.forEach(request => { %>
                <div class="rh-list-item-card mb-0">
                  <div class="rh-list-item-left">
                    <% if (request.images && request.images.length > 0) { %>
                      <img src="<%= request.images[0] %>" alt="<%= request.name %>" class="rh-list-item-img">
                    <% } else { %>
                      <div class="rh-list-item-icon-box">
                        <i class="bi bi-building"></i>
                      </div>
                    <% } %>
                    <div>
                      <h3 class="rh-list-item-title mb-1"><%= request.name %></h3>
                      <div class="rh-list-item-sub">
                        <span><i class="bi bi-geo-alt me-1 text-danger"></i><%= request.city %>, <%= request.state %></span>
                        <span class="mx-2">&bull;</span>
                        <span><%= request.venueType || 'Concert Hall' %></span>
                        <% if (request.capacity) { %>
                          <span class="mx-2">&bull;</span>
                          <span>Cap: <%= request.capacity %></span>
                        <% } %>
                      </div>
                      <div class="small text-muted mt-1">
                        Requested on: <%= toISTDateString(request.createdAt) %>
                      </div>
                    </div>
                  </div>

                  <div class="rh-list-item-right flex-wrap">
                    <% if (request.status === 'pending') { %>
                      <span class="rh-badge-pending">
                        <i class="bi bi-clock-fill"></i> Pending
                      </span>
                    <% } else if (request.status === 'approved') { %>
                      <span class="rh-badge-completed">
                        <i class="bi bi-check-circle-fill"></i> Approved
                      </span>
                    <% } else if (request.status === 'rejected') { %>
                      <span class="rh-badge-rejected">
                        <i class="bi bi-x-circle-fill"></i> Rejected
                      </span>
                    <% } %>

                    <a href="/users/venue-requests/<%= request._id %>" class="rh-btn-outline-view">
                      <i class="bi bi-eye"></i> Details
                    </a>

                    <% if (request.status === 'approved' && request.createdVenue) { %>
                      <a href="/users/venues/<%= request.createdVenue._id %>" class="rh-btn-primary py-1 px-3 small" style="font-size: 0.8rem;">
                        View Venue
                      </a>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <!-- Empty State -->
            <div class="rh-sub-empty-box">
              <div class="rh-sub-sketch-icon" aria-hidden="true">
                <i class="bi bi-building text-danger display-4"></i>
              </div>
              <h3 class="fs-4 fw-bold text-dark mb-2">No Venue Requests Yet</h3>
              <p class="text-muted mb-4">You haven't submitted any venue registration requests.</p>
              <a href="/users/venue-requests/create" class="rh-btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Submit Your First Venue Request
              </a>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>
