<%- contentFor('body') %>

<!-- Create Venue Request Form -->
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Request New Venue Registration</h1>
    <a href="/users/venue-requests" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Back to My Requests
    </a>
  </div>

  <div class="row">
    <div class="col-lg-8 mx-auto">
      <!-- Info Alert -->
      <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Note:</strong> Your venue registration request will be reviewed by our admin team. 
        Once approved, your venue will be added to our platform and available for artists to book.
      </div>

      <div class="card">
        <div class="card-body">
          <form action="/users/venue-requests/create" method="POST" enctype="multipart/form-data">
            <!-- Basic Information -->
            <h5 class="card-title mb-3">Basic Information</h5>
            
            <div class="row g-3 mb-4">
              <div class="col-md-12">
                <label for="name" class="form-label">Venue Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="name" name="name" required 
                       placeholder="Enter venue name">
              </div>
              
              <div class="col-md-12">
                <label for="address" class="form-label">Address <span class="text-danger">*</span></label>
                <textarea class="form-control" id="address" name="address" rows="2" required 
                          placeholder="Enter complete address"></textarea>
              </div>
              
              <div class="col-md-4">
                <label for="city" class="form-label">City <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="city" name="city" required 
                       placeholder="Enter city">
              </div>
              
              <div class="col-md-4">
                <label for="state" class="form-label">State <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="state" name="state" required 
                       placeholder="Enter state">
              </div>
              
              <div class="col-md-4">
                <label for="pincode" class="form-label">Pincode</label>
                <input type="text" class="form-control" id="pincode" name="pincode" 
                       placeholder="Enter pincode">
              </div>
            </div>

            <!-- Venue Details -->
            <h5 class="card-title mb-3">Venue Details</h5>
            
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="venueType" class="form-label">Venue Type</label>
                <select class="form-select" id="venueType" name="venueType">
                  <option value="Indoor Hall">Indoor Hall</option>
                  <option value="Outdoor Venue">Outdoor Venue</option>
                  <option value="Auditorium">Auditorium</option>
                  <option value="Stadium">Stadium</option>
                  <option value="Club">Club</option>
                  <option value="Restaurant">Restaurant</option>
                  <option value="Hotel">Hotel</option>
                  <option value="Community Center">Community Center</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              
              <div class="col-md-6">
                <label for="capacity" class="form-label">Capacity (Optional)</label>
                <input type="number" class="form-control" id="capacity" name="capacity" 
                       placeholder="Maximum capacity" min="1">
              </div>
              
              <div class="col-md-6">
                <label for="priceRange" class="form-label">Price Range</label>
                <select class="form-select" id="priceRange" name="priceRange">
                  <option value="Budget">Budget</option>
                  <option value="Mid-Range" selected>Mid-Range</option>
                  <option value="Premium">Premium</option>
                  <option value="Luxury">Luxury</option>
                </select>
              </div>

              <!-- Pricing Details -->
              <div class="col-md-12">
                <h6 class="mb-3">Hourly Pricing Structure</h6>
                <div class="card border-info mb-3">
                  <div class="card-body">
                    <div class="row g-2 mb-3">
                      <div class="col-md-2"><strong>Hours</strong></div>
                      <div class="col-md-4"><strong>Rate (₹)</strong></div>
                      <div class="col-md-2"><strong>Hours</strong></div>
                      <div class="col-md-4"><strong>Rate (₹)</strong></div>
                    </div>
                    
                    <div class="pricing-grid">
                      <% for(let i = 1; i <= 12; i++) { %>
                        <div class="row g-2 mb-2">
                          <div class="col-md-2">
                            <label class="form-label small">Hour <%= i %></label>
                          </div>
                          <div class="col-md-4">
                            <input type="number" class="form-control form-control-sm" 
                                   name="hourlyRate_<%= i %>" placeholder="0" min="0" step="100">
                          </div>
                          <% if(i + 12 <= 24) { %>
                            <div class="col-md-2">
                              <label class="form-label small">Hour <%= i + 12 %></label>
                            </div>
                            <div class="col-md-4">
                              <input type="number" class="form-control form-control-sm" 
                                     name="hourlyRate_<%= i + 12 %>" placeholder="0" min="0" step="100">
                            </div>
                          <% } %>
                        </div>
                      <% } %>
                    </div>
                    <small class="text-info">
                      <i class="bi bi-info-circle"></i> 
                      Only hours with rates will be available for booking. Leave empty to disable that hour option.
                      Commission will be set by administration.
                    </small>
                  </div>
                </div>
              </div>

              <div class="col-md-12">
                <label for="minimumHours" class="form-label">Minimum Booking Hours</label>
                <input type="number" class="form-control" id="minimumHours" name="minimumHours" 
                       min="1" max="24" value="1" placeholder="e.g., 4">
                <small class="text-muted">Minimum hours required for booking this venue</small>
              </div>

              <!-- Ticket Pricing -->
              <div class="col-md-6">
                <label for="minimumTicketPrice" class="form-label">Minimum Ticket Price (₹)</label>
                <input type="number" class="form-control" id="minimumTicketPrice" name="minimumTicketPrice" 
                       step="1" placeholder="e.g., 100 (any amount)">
                <small class="text-muted">Set any minimum ticket price</small>
              </div>

              <div class="col-md-6">
                <label for="suggestedTicketPrice" class="form-label">Suggested Ticket Price (₹)</label>
                <input type="number" class="form-control" id="suggestedTicketPrice" name="suggestedTicketPrice" 
                       step="1" placeholder="e.g., 500 (any amount)">
                <small class="text-muted">Recommended ticket price for artists</small>
              </div>
              
              <div class="col-md-12">
                <label for="description" class="form-label">Description</label>
                <textarea class="form-control" id="description" name="description" rows="3" 
                          placeholder="Describe the venue, its features, and any important details"></textarea>
              </div>
            </div>

            <!-- Facilities -->
            <h5 class="card-title mb-3">Facilities</h5>
            
            <div class="row g-2 mb-4">
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Parking" id="parking" name="facilities">
                  <label class="form-check-label" for="parking">Parking</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Sound System" id="soundSystem" name="facilities">
                  <label class="form-check-label" for="soundSystem">Sound System</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Lighting" id="lighting" name="facilities">
                  <label class="form-check-label" for="lighting">Lighting</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Stage" id="stage" name="facilities">
                  <label class="form-check-label" for="stage">Stage</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Green Rooms" id="greenRooms" name="facilities">
                  <label class="form-check-label" for="greenRooms">Green Rooms</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Restrooms" id="restrooms" name="facilities">
                  <label class="form-check-label" for="restrooms">Restrooms</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Food Court" id="foodCourt" name="facilities">
                  <label class="form-check-label" for="foodCourt">Food Court</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="AC" id="ac" name="facilities">
                  <label class="form-check-label" for="ac">AC</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Wheelchair Accessible" id="wheelchair" name="facilities">
                  <label class="form-check-label" for="wheelchair">Wheelchair Accessible</label>
                </div>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="Wi-Fi" id="wifi" name="facilities">
                  <label class="form-check-label" for="wifi">Wi-Fi</label>
                </div>
              </div>
            </div>

            <!-- Contact Information -->
            <h5 class="card-title mb-3">Contact Information</h5>
            
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label for="contactName" class="form-label">Contact Person Name</label>
                <input type="text" class="form-control" id="contactName" name="contactName" 
                       placeholder="Contact person name">
              </div>
              
              <div class="col-md-4">
                <label for="contactPhone" class="form-label">Contact Phone</label>
                <input type="tel" class="form-control" id="contactPhone" name="contactPhone" 
                       placeholder="Contact phone number">
              </div>
              
              <div class="col-md-4">
                <label for="contactEmail" class="form-label">Contact Email</label>
                <input type="email" class="form-control" id="contactEmail" name="contactEmail" 
                       placeholder="Contact email address">
              </div>
            </div>

            <!-- Additional Information -->
            <h5 class="card-title mb-3">Additional Information</h5>
            
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="googleMapsLink" class="form-label">Google Maps Link</label>
                <input type="url" class="form-control" id="googleMapsLink" name="googleMapsLink" 
                       placeholder="https://maps.google.com/...">
                <small class="text-muted">Share your venue's Google Maps location</small>
              </div>
              
              <div class="col-md-6">
                <label for="website" class="form-label">Website</label>
                <input type="url" class="form-control" id="website" name="website" 
                       placeholder="https://www.example.com">
                <small class="text-muted">Your venue's official website</small>
              </div>
            </div>

            <!-- Images -->
            <h5 class="card-title mb-3">Venue Images</h5>
            <div class="row g-3 mb-4">
              <div class="col-md-12">
                <label for="images" class="form-label">Upload Images (Max 5)</label>
                <input type="file" class="form-control" id="images" name="images" multiple accept="image/*">
                <small class="text-muted">Upload clear photos of your venue (JPG, PNG, GIF). Maximum 5 images, 5MB each.</small>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <a href="/users/venue-requests" class="btn btn-outline-secondary me-md-2">Cancel</a>
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-send me-1"></i> Submit Venue Request
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
