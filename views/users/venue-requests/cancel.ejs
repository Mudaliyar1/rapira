<%- contentFor('body') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Cancel Venue Request</h5>
          <a href="/users/venue-requests/<%= venueRequest._id %>" class="btn btn-sm btn-light">Back</a>
        </div>
        <div class="card-body">
          <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>
              Cancelling will move this request to "Cancelled" and it will no longer be reviewed. You can submit a new request later if needed.
            </div>
          </div>

          <h6 class="fw-bold">Request Summary</h6>
          <p class="mb-1"><strong>Name:</strong> <%= venueRequest.name %></p>
          <p class="mb-3 text-muted"><%= venueRequest.fullAddress %></p>

          <form action="/users/venue-requests/<%= venueRequest._id %>/cancel" method="POST" class="mt-3">
            <div class="mb-3">
              <label for="cancelReason" class="form-label">Reason for cancelling (optional)</label>
              <textarea id="cancelReason" name="cancelReason" class="form-control" rows="3" placeholder="Example: Plans changed, incorrect details, submitted duplicate request..."></textarea>
              <div class="form-text">This reason will be visible to admins.</div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
              <a href="/users/venue-requests/<%= venueRequest._id %>" class="btn btn-outline-secondary">Keep Request</a>
              <button type="submit" class="btn btn-danger">Confirm Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
