<div class="rapira-profile-page">
  <div class="container">
    <div class="rh-subpage-container" style="max-width: 1040px;">
      
      <!-- Page Navigation Header -->
      <div class="rh-page-header-nav">
        <div class="rh-page-header-left">
          <a href="/users/profile" class="rh-back-circle-btn" title="Back to Profile">
            <i class="bi bi-arrow-left"></i>
          </a>
          <h1 class="rh-page-title">My Venues</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/venue-dashboard" class="rh-btn-secondary">
            <i class="bi bi-kanban me-1"></i> Venue Dashboard
          </a>
          <a href="/users/venue-requests/create" class="rh-btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Request New Venue
          </a>
        </div>
      </div>

      <%
        const totalVenues = venues ? venues.length : 0;
        const activeVenues = venues ? venues.filter(venue => venue.isActive).length : 0;
        const inactiveVenues = venues ? venues.filter(venue => !venue.isActive).length : 0;
        const totalBookings = venues ? venues.reduce((sum, venue) => sum + (venue.stats ? venue.stats.totalBookings : 0), 0) : 0;
      %>

      <!-- Stats Pills Row -->
      <div class="rh-stats-pills-row">
        <div class="rh-stats-pill">
          <i class="bi bi-building text-danger"></i>
          <span>Total: <strong class="rh-stats-pill-num"><%= totalVenues %></strong></span>
        </div>
        <div class="rh-stats-pill">
          <i class="bi bi-check-circle-fill text-success"></i>
          <span>Active: <strong class="rh-stats-pill-num" style="color: #0F7A4D;"><%= activeVenues %></strong></span>
        </div>
        <% if (inactiveVenues > 0) { %>
          <div class="rh-stats-pill">
            <i class="bi bi-pause-circle-fill text-warning"></i>
            <span>Inactive: <strong class="rh-stats-pill-num" style="color: #B76E00;"><%= inactiveVenues %></strong></span>
          </div>
        <% } %>
        <div class="rh-stats-pill">
          <i class="bi bi-calendar-event text-danger"></i>
          <span>Bookings: <strong class="rh-stats-pill-num"><%= totalBookings %></strong></span>
        </div>
      </div>

      <!-- Venues Grid -->
      <% if (venues && venues.length > 0) { %>
        <div class="row g-4">
          <% venues.forEach(venue => { %>
            <div class="col-md-6 col-lg-4">
              <div class="rh-profile-card h-100 d-flex flex-column mb-0">
                
                <!-- Venue Image Banner -->
                <div class="position-relative overflow-hidden" style="height: 180px; background-color: #FAF2EC;">
                  <% if (venue.images && venue.images.length > 0) { %>
                    <img src="<%= venue.images[0] %>" alt="<%= venue.name %>" class="w-100 h-100" style="object-fit: cover;">
                  <% } else { %>
                    <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                      <i class="bi bi-building display-4"></i>
                    </div>
                  <% } %>

                  <div class="position-absolute top-0 end-0 m-2">
                    <% if (venue.isActive) { %>
                      <span class="rh-badge-completed">Active</span>
                    <% } else { %>
                      <span class="rh-badge-pending">Inactive</span>
                    <% } %>
                  </div>
                </div>

                <!-- Venue Body -->
                <div class="rh-profile-card-body flex-grow-1 p-3">
                  <h3 class="fs-5 fw-bold text-dark mb-1"><%= venue.name %></h3>
                  <div class="text-muted small mb-2">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i><%= venue.city %>, <%= venue.state %>
                  </div>

                  <div class="d-flex gap-2 mb-3">
                    <span class="badge bg-light text-dark border"><%= venue.venueType || 'Concert Hall' %></span>
                    <% if (venue.priceRange) { %>
                      <span class="badge bg-light text-dark border"><%= venue.priceRange %></span>
                    <% } %>
                  </div>

                  <!-- Booking Stats -->
                  <div class="row g-2 text-center p-2 rounded-3 bg-light border mb-3">
                    <div class="col-4">
                      <div class="small fw-bold text-dark"><%= venue.stats ? venue.stats.totalBookings : 0 %></div>
                      <div style="font-size: 0.72rem;" class="text-muted">Total</div>
                    </div>
                    <div class="col-4 border-start border-end">
                      <div class="small fw-bold text-success"><%= venue.stats ? venue.stats.activeBookings : 0 %></div>
                      <div style="font-size: 0.72rem;" class="text-muted">Upcoming</div>
                    </div>
                    <div class="col-4">
                      <div class="small fw-bold text-warning"><%= venue.stats ? venue.stats.pendingBookings : 0 %></div>
                      <div style="font-size: 0.72rem;" class="text-muted">Pending</div>
                    </div>
                  </div>

                  <!-- Actions -->
                  <div class="d-flex flex-column gap-2 mt-auto">
                    <a href="/venue-dashboard/<%= venue._id %>/dashboard" class="rh-btn-primary py-2 text-center" style="font-size: 0.85rem;">
                      <i class="bi bi-speedometer2 me-1"></i> Venue Dashboard
                    </a>
                    <div class="d-flex gap-2">
                      <a href="/users/venues/<%= venue._id %>" class="rh-btn-secondary flex-grow-1 py-1 text-center" style="font-size: 0.82rem;">
                        <i class="bi bi-eye me-1"></i> Details
                      </a>
                      <a href="/users/venues/<%= venue._id %>/bookings" class="rh-btn-secondary flex-grow-1 py-1 text-center" style="font-size: 0.82rem;">
                        <i class="bi bi-calendar me-1"></i> Bookings
                      </a>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <!-- Empty State -->
        <div class="rh-form-card text-center py-5">
          <div class="rh-sub-sketch-icon mb-3" aria-hidden="true">
            <i class="bi bi-building text-danger display-4"></i>
          </div>
          <h2 class="fs-4 fw-bold text-dark mb-2">No Venues Registered Yet</h2>
          <p class="text-muted mb-4">You haven't registered any venues yet. Submit a venue registration request to start hosting concerts.</p>
          <a href="/users/venue-requests/create" class="rh-btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Register Your First Venue
          </a>
        </div>
      <% } %>

    </div>
  </div>
</div>
