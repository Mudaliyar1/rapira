<%- contentFor('body') %>

<!-- My Registered Venues Page -->
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">My Registered Venues</h1>
    <div class="d-flex gap-2">
      <a href="/venue-dashboard" class="btn btn-success">
        <i class="bi bi-kanban me-1"></i> All Dashboards
      </a>
      <a href="/users/profile" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Profile
      </a>
      <a href="/users/venue-requests/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Request New Venue
      </a>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <%
      const totalVenues = venues.length;
      const activeVenues = venues.filter(venue => venue.isActive).length;
      const inactiveVenues = venues.filter(venue => !venue.isActive).length;
      const totalBookings = venues.reduce((sum, venue) => sum + venue.stats.totalBookings, 0);
    %>
    <div class="col-md-3 mb-3">
      <div class="card border-info h-100">
        <div class="card-body text-center">
          <i class="bi bi-building display-4 text-info mb-2"></i>
          <h3 class="fw-bold text-info"><%= totalVenues %></h3>
          <p class="text-muted mb-0">Total Venues</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-success h-100">
        <div class="card-body text-center">
          <i class="bi bi-check-circle display-4 text-success mb-2"></i>
          <h3 class="fw-bold text-success"><%= activeVenues %></h3>
          <p class="text-muted mb-0">Active Venues</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-warning h-100">
        <div class="card-body text-center">
          <i class="bi bi-pause-circle display-4 text-warning mb-2"></i>
          <h3 class="fw-bold text-warning"><%= inactiveVenues %></h3>
          <p class="text-muted mb-0">Inactive Venues</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-primary h-100">
        <div class="card-body text-center">
          <i class="bi bi-calendar-event display-4 text-primary mb-2"></i>
          <h3 class="fw-bold text-primary"><%= totalBookings %></h3>
          <p class="text-muted mb-0">Total Bookings</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Venues List -->
  <div class="card">
    <div class="card-header bg-light">
      <h5 class="mb-0">
        <i class="bi bi-list-ul me-2"></i>Your Registered Venues
      </h5>
    </div>
    <div class="card-body">
      <% if (venues && venues.length > 0) { %>
        <div class="row">
          <% venues.forEach(venue => { %>
            <div class="col-lg-6 col-xl-4 mb-4">
              <div class="card h-100 venue-card">
                <% if (venue.images && venue.images.length > 0) { %>
                  <img src="<%= venue.images[0] %>" alt="<%= venue.name %>" 
                       class="card-img-top" style="height: 200px; object-fit: cover;">
                <% } else { %>
                  <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                       style="height: 200px;">
                    <i class="bi bi-building display-1 text-muted"></i>
                  </div>
                <% } %>
                
                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title mb-0"><%= venue.name %></h5>
                    <span class="badge <%= venue.isActive ? 'bg-success' : 'bg-warning' %>">
                      <%= venue.isActive ? 'Active' : 'Inactive' %>
                    </span>
                  </div>
                  
                  <p class="text-muted small mb-2">
                    <i class="bi bi-geo-alt me-1"></i><%= venue.city %>, <%= venue.state %>
                  </p>
                  
                  <div class="mb-3">
                    <span class="badge bg-secondary me-1"><%= venue.venueType %></span>
                    <span class="badge bg-info"><%= venue.priceRange %></span>
                  </div>
                  
                  <!-- Booking Stats -->
                  <div class="row text-center mb-3">
                    <div class="col-4">
                      <div class="border-end">
                        <h6 class="mb-0 text-primary"><%= venue.stats.totalBookings %></h6>
                        <small class="text-muted">Total</small>
                      </div>
                    </div>
                    <div class="col-4">
                      <div class="border-end">
                        <h6 class="mb-0 text-success"><%= venue.stats.activeBookings %></h6>
                        <small class="text-muted">Upcoming</small>
                      </div>
                    </div>
                    <div class="col-4">
                      <h6 class="mb-0 text-warning"><%= venue.stats.pendingBookings %></h6>
                      <small class="text-muted">Pending</small>
                    </div>
                  </div>
                  
                  <div class="mt-auto">
                    <div class="d-grid gap-2">
                      <a href="/venue-dashboard/<%= venue._id %>/dashboard" class="btn btn-success btn-sm">
                        <i class="bi bi-kanban me-1"></i> Venue Dashboard
                      </a>
                      <a href="/users/venues/<%= venue._id %>" class="btn btn-primary btn-sm">
                        <i class="bi bi-eye me-1"></i> View Details & Bookings
                      </a>
                      <div class="btn-group" role="group">
                        <a href="/users/venues/<%= venue._id %>/bookings" class="btn btn-outline-info btn-sm">
                          <i class="bi bi-calendar me-1"></i> Calendar
                        </a>
                        <% if (venue.googleMapsLink) { %>
                          <a href="<%= venue.googleMapsLink %>" target="_blank" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-geo-alt me-1"></i> Location
                          </a>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="bi bi-building display-1 text-muted mb-3"></i>
          <h4>No Venues Registered Yet</h4>
          <p class="text-muted mb-4">You haven't registered any venues yet. Start by submitting a venue registration request.</p>
          <a href="/users/venue-requests/create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Register Your First Venue
          </a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<style>
.venue-card {
  transition: transform 0.2s;
}

.venue-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}
</style>
