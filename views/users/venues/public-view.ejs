<%- contentFor('body') %>

<!-- Public Venue View -->
<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-md-8">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active"><%= venue.name %> - Venue Preview</li>
        </ol>
      </nav>
      <h1 class="fw-bold"><%= venue.name %></h1>
      <p class="text-muted mb-0">
        <i class="bi bi-geo-alt me-1"></i><%= venue.address %>, <%= venue.city %>, <%= venue.state %> <%= venue.zipCode %>
      </p>
      <% if (isOwner) { %>
        <div class="mt-2">
          <small class="badge bg-info"><i class="bi bi-shield-check me-1"></i>You are viewing this as the venue owner</small>
        </div>
      <% } %>
    </div>
    <div class="col-md-4 text-md-end">
      <div class="d-flex gap-2 justify-content-md-end flex-wrap">
        <% if (isOwner) { %>
          <a href="/users/venue-requests" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to My Requests
          </a>
        <% } else { %>
          <a href="/" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Home
          </a>
        <% } %>
        <span class="badge <%= venue.isActive ? 'bg-success' : 'bg-warning' %> fs-6 px-3 py-2">
          <%= venue.isActive ? 'Active' : 'Inactive' %>
        </span>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Venue Information -->
    <div class="col-lg-8 mb-4">
      <!-- Image Gallery -->
      <% if (venue.images && venue.images.length > 0) { %>
        <div class="card mb-4">
          <div class="card-body p-0">
            <div id="venueCarousel" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <% venue.images.forEach((image, index) => { %>
                  <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                    <img src="<%= image %>" class="d-block w-100" alt="<%= venue.name %>" 
                         style="height: 400px; object-fit: cover;">
                  </div>
                <% }); %>
              </div>
              <% if (venue.images.length > 1) { %>
                <button class="carousel-control-prev" type="button" data-bs-target="#venueCarousel" data-bs-slide="prev">
                  <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#venueCarousel" data-bs-slide="next">
                  <span class="carousel-control-next-icon"></span>
                </button>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Venue Details -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0" style="color: white !important;">
            <i class="bi bi-info-circle me-2"></i>Venue Information
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <strong>Venue Type:</strong><br>
              <span class="badge bg-secondary"><%= venue.venueType %></span>
            </div>
            <div class="col-md-6 mb-3">
              <strong>Price Range:</strong><br>
              <span class="badge bg-info"><%= venue.priceRange %></span>
            </div>
            <div class="col-md-6 mb-3">
              <strong>Capacity:</strong><br>
              <i class="bi bi-people me-1"></i><%= venue.capacity %> people
            </div>
            <div class="col-md-6 mb-3">
              <strong>Contact:</strong><br>
              <i class="bi bi-telephone me-1"></i><%= venue.contactNumber %>
            </div>
            <% if (venue.email) { %>
              <div class="col-md-12 mb-3">
                <strong>Email:</strong><br>
                <i class="bi bi-envelope me-1"></i><a href="mailto:<%= venue.email %>"><%= venue.email %></a>
              </div>
            <% } %>
            <% if (venue.website) { %>
              <div class="col-md-12 mb-3">
                <strong>Website:</strong><br>
                <i class="bi bi-globe me-1"></i><a href="<%= venue.website %>" target="_blank"><%= venue.website %></a>
              </div>
            <% } %>
            <% if (venue.googleMapsLink) { %>
              <div class="col-md-12 mb-3">
                <strong>Location on Map:</strong><br>
                <a href="<%= venue.googleMapsLink %>" target="_blank" class="btn btn-primary btn-sm">
                  <i class="bi bi-geo-alt-fill me-1"></i>View on Google Maps
                  <i class="bi bi-box-arrow-up-right ms-1"></i>
                </a>
                <span class="badge bg-success ms-2">
                  <i class="bi bi-check-circle-fill"></i> Verified Location
                </span>
              </div>
            <% } %>
          </div>
          
          <% if (venue.description) { %>
            <div class="mt-3">
              <strong>Description:</strong>
              <p class="mt-2"><%= venue.description %></p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Facilities & Amenities -->
      <% if (venue.facilities && venue.facilities.length > 0) { %>
        <div class="card mb-4">
          <div class="card-header">
            <h5 class="mb-0" style="color: white !important;">
              <i class="bi bi-list-check me-2"></i>Facilities & Amenities
            </h5>
          </div>
          <div class="card-body">
            <div class="row">
              <% venue.facilities.forEach(facility => { %>
                <div class="col-md-6 mb-2">
                  <i class="bi bi-check-circle text-success me-2"></i><%= facility %>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Pricing Information -->
      <% if (venue.pricing && Object.keys(venue.pricing).length > 0) { %>
        <div class="card mb-4">
          <div class="card-header">
            <h5 class="mb-0" style="color: white !important;">
              <i class="bi bi-currency-dollar me-2"></i>Pricing Information
            </h5>
          </div>
          <div class="card-body">
            <div class="row">
              <% Object.entries(venue.pricing).forEach(([key, value]) => { %>
                <div class="col-md-12 mb-3">
                  <strong><%= key.charAt(0).toUpperCase() + key.slice(1).replace(/([A-Z])/g, ' $1') %>:</strong>
                  <div class="ms-3 mt-1">
                    <% if (key === 'hourlyRates') { %>
                      <div class="text-success">
                        <i class="bi bi-clock me-1"></i>
                        <% if (typeof value === 'object' && value !== null) { %>
                          <% if (Array.isArray(value) && value.length > 0) { %>
                            ₹<%= value[0].rate || 'N/A' %> per hour
                            <% if (value[0].hours) { %>
                              <small class="text-muted">(Minimum: <%= value[0].hours %> hours)</small>
                            <% } %>
                          <% } else if (value.rate) { %>
                            ₹<%= value.rate %> per hour
                            <% if (value.hours) { %>
                              <small class="text-muted">(Minimum: <%= value.hours %> hours)</small>
                            <% } %>
                          <% } else { %>
                            <span class="text-muted">Check with venue</span>
                          <% } %>
                        <% } else { %>
                          ₹<%= value %> per hour
                        <% } %>
                      </div>
                    <% } else if (key === 'minimumHours') { %>
                      <span class="text-info"><%= value %> hours</span>
                    <% } else if (key === 'currency') { %>
                      <span class="text-secondary"><%= value %></span>
                    <% } else if (key === 'adminCommission') { %>
                      <div class="text-warning">
                        <i class="bi bi-percent me-1"></i>
                        <% if (typeof value === 'object' && value !== null) { %>
                          <% if (value.percentage !== undefined) { %>
                            <%= value.percentage %>% commission
                          <% } else { %>
                            <span class="text-muted">Check with venue</span>
                          <% } %>
                        <% } else { %>
                          <%= value %>% commission
                        <% } %>
                      </div>
                    <% } else if (key === 'ticketPricing') { %>
                      <div class="text-primary">
                        <i class="bi bi-ticket me-1"></i>
                        <% if (typeof value === 'object' && value !== null) { %>
                          <% if (value.minimumPrice !== undefined && value.suggestedPrice !== undefined) { %>
                            Min: ₹<%= value.minimumPrice %> | Suggested: ₹<%= value.suggestedPrice %>
                          <% } else { %>
                            <span class="text-muted">Check with venue</span>
                          <% } %>
                        <% } else { %>
                          ₹<%= value %>
                        <% } %>
                      </div>
                    <% } else if (key === 'additionalCharges') { %>
                      <div class="text-danger">
                        <% if (typeof value === 'object' && value !== null) { %>
                          <% if (Object.keys(value).length === 0) { %>
                            <span class="text-muted">No additional charges</span>
                          <% } else { %>
                            <% Object.entries(value).forEach(([chargeKey, chargeValue]) => { %>
                              <div>₹<%= chargeValue %> - <%= chargeKey %></div>
                            <% }); %>
                          <% } %>
                        <% } else { %>
                          <%= value %>
                        <% } %>
                      </div>
                    <% } else { %>
                      <% if (typeof value === 'object' && value !== null) { %>
                        <% if (Array.isArray(value)) { %>
                          <% value.forEach((item, index) => { %>
                            <div class="badge bg-secondary me-1"><%= item %></div>
                          <% }); %>
                        <% } else { %>
                          <div class="alert alert-light small">
                            <% Object.entries(value).forEach(([subKey, subValue]) => { %>
                              <div><strong><%= subKey %>:</strong> <%= subValue %></div>
                            <% }); %>
                          </div>
                        <% } %>
                      <% } else { %>
                        <span class="text-success">
                          <% if (typeof value === 'number' && key !== 'minimumHours') { %>
                            ₹<%= value %>
                          <% } else { %>
                            <%= value %>
                          <% } %>
                        </span>
                      <% } %>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Sidebar Info -->
    <div class="col-lg-4">
      <!-- Quick Info Card -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0" style="color: white !important;">
            <i class="bi bi-lightning me-2"></i>Quick Info
          </h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <strong>Status:</strong><br>
            <% if (venue.isActive) { %>
              <span class="badge bg-success">
                <i class="bi bi-check-circle me-1"></i>Active & Available for Bookings
              </span>
            <% } else { %>
              <span class="badge bg-warning">
                <i class="bi bi-exclamation-circle me-1"></i>Currently Inactive
              </span>
            <% } %>
          </div>
          
          <div class="mb-3">
            <strong>Created By:</strong><br>
            <% if (venue.createdBy && venue.createdBy.name) { %>
              <span class="text-muted"><%= venue.createdBy.name %></span>
            <% } %>
          </div>

          <div class="mb-3">
            <strong>Listed Since:</strong><br>
            <span class="text-muted">
              <i class="bi bi-calendar-event me-1"></i><%= new Date(venue.createdAt).toLocaleDateString() %>
            </span>
          </div>

          <% if (isOwner) { %>
            <div class="alert alert-info small">
              <i class="bi bi-info-circle me-1"></i>
              This is your private venue preview. Only you and admins can see this page.
            </div>
          <% } %>
        </div>
      </div>

      <!-- Contact Card -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="bi bi-telephone me-2"></i>Get in Touch
          </h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <% if (venue.email) { %>
              <a href="mailto:<%= venue.email %>" class="btn btn-primary">
                <i class="bi bi-envelope me-2"></i>Email Venue
              </a>
            <% } %>
            <% if (venue.contactNumber) { %>
              <a href="tel:<%= venue.contactNumber %>" class="btn btn-success">
                <i class="bi bi-telephone me-2"></i>Call Now
              </a>
            <% } %>
            <% if (venue.googleMapsLink) { %>
              <a href="<%= venue.googleMapsLink %>" target="_blank" class="btn btn-outline-info">
                <i class="bi bi-geo-alt me-2"></i>View on Map
              </a>
            <% } %>
            <% if (venue.website) { %>
              <a href="<%= venue.website %>" target="_blank" class="btn btn-outline-secondary">
                <i class="bi bi-globe me-2"></i>Visit Website
              </a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
