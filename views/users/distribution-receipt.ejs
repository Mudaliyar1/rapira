<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receipt - <%= request.contentTitle %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f8f9fa; font-family: 'Inter', sans-serif; padding-top: 50px; }
    .receipt-container { 
      max-width: 800px; 
      margin: 0 auto; 
      background: white; 
      padding: 50px; 
      box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.05);
      border-radius: 10px;
      position: relative;
    }
    .header-logo { color: #6f42c1; font-weight: 800; font-size: 2rem; margin-bottom: 2rem; }
    .receipt-title { font-weight: 700; color: #333; margin-bottom: 2rem; border-bottom: 2px solid #f0f0f0; padding-bottom: 1rem; }
    .label { color: #888; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; letter-spacing: 1px; }
    .value { color: #333; font-weight: 600; margin-bottom: 1.5rem; }
    .total-box { background: #f8f9fa; padding: 2rem; border-radius: 10px; margin-top: 3rem; }
    .total-label { font-size: 1.1rem; color: #666; }
    .total-value { font-size: 2rem; font-weight: 800; color: #6f42c1; }
    .footer-note { border-top: 1px solid #eee; margin-top: 4rem; padding-top: 2rem; color: #999; font-size: 0.85rem; text-align: center; }
    .print-hide { position: absolute; top: 20px; right: 20px; }
    @media print {
      body { background: white; padding-top: 0; }
      .receipt-container { box-shadow: none; width: 100%; border-radius: 0; }
      .print-hide { display: none; }
    }
  </style>
</head>
<body>
  <div class="receipt-container">
    <div class="print-hide">
      <button onclick="downloadPDF()" class="btn btn-primary"><i class="bi bi-file-earmark-pdf"></i> Download PDF</button>
      <a href="<%= typeof backLink !== 'undefined' ? backLink : '/artist-distribution/request-details/' + request._id %>" class="btn btn-secondary">Close</a>
    </div>

    <div class="header-logo">RAPIRA</div>
    
    <div class="receipt-title">Payment Receipt</div>

    <div class="row">
      <div class="col-4">
        <div class="label mb-1">Billed To (Artist)</div>
        <div class="value mb-1"><%= request.artist ? request.artist.name : 'Unknown Artist' %></div>
        <div class="text-muted small mb-3"><%= request.artist ? request.artist.email : 'N/A' %></div>
      </div>
      <div class="col-4">
        <div class="label mb-1">Billed By (Distributor)</div>
        <div class="value mb-1"><%= request.distributor ? request.distributor.name : 'Unknown Distributor' %></div>
        <div class="text-muted small mb-3"><%= request.distributor ? request.distributor.email : 'N/A' %></div>
      </div>
      <div class="col-4 text-end">
        <div class="label mb-1">Date of Payment</div>
        <div class="value mb-3"><%= new Date(request.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }) %></div>
        <div class="label mb-1">Bill No. (Invoice)</div>
        <div class="value mb-3 text-primary"><%= request.receiptNumber || 'N/A' %></div>
        <div class="label mb-1">Transaction ID</div>
        <div class="value text-primary font-monospace mb-0"><%= request.paymentStatus === 'free' ? 'FREE' : (request.razorpayPaymentId || 'N/A') %></div>
      </div>
    </div>

    <div class="mt-5">
      <h6 class="fw-bold mb-3 text-uppercase" style="letter-spacing: 1px; color: #555;">Detailed Invoice</h6>
      <div class="border rounded-3 overflow-hidden">
        <table class="table table-bordered mb-0">
          <thead class="bg-light align-middle">
            <tr>
              <th class="label text-center py-3" style="width: 5%; border-bottom: 2px solid #dee2e6;">#</th>
              <th class="label ps-3 py-3" style="width: 35%; border-bottom: 2px solid #dee2e6;">Item Description</th>
              <th class="label text-center py-3" style="width: 20%; border-bottom: 2px solid #dee2e6;">Package Limits</th>
              <th class="label text-center py-3" style="width: 15%; border-bottom: 2px solid #dee2e6;">Qty (Sent)</th>
              <th class="label text-end py-3" style="width: 10%; border-bottom: 2px solid #dee2e6;">Rate</th>
              <th class="label text-end pe-3 py-3" style="width: 15%; border-bottom: 2px solid #dee2e6;">Amount</th>
            </tr>
          </thead>
          <tbody class="align-middle">
            <tr>
              <td class="text-center py-4 text-muted">1</td>
              <td class="ps-3 py-4">
                 <strong class="text-dark d-block mb-1 fs-6"><%= request.contentTitle %></strong>
                 <span class="text-muted small d-block">Package: <%= request.package ? request.package.name : 'N/A' %></span>
                 <span class="text-muted small d-block">Distributor: <%= request.distributor ? request.distributor.name : 'Unknown' %></span>
              </td>
              <td class="text-center py-4 text-muted small">
                   <% if (request.package && request.package.packageType) { %>
                     Max Audio: <strong><%= request.package.maxAudioFiles || 0 %></strong>
                   <% } else { %>
                     N/A
                   <% } %>
              </td>
              <td class="text-center py-4 fw-bold text-dark">
                <%= request.files && request.files.length > 0 ? request.files.length : 1 %> File(s)
              </td>
              <td class="text-end py-4 text-muted">₹<%= Number(request.price).toFixed(2) %></td>
              <td class="text-end pe-3 py-4 fw-bold text-dark">₹<%= Number(request.price).toFixed(2) %></td>
            </tr>
            <tr>
              <td class="text-center py-3 text-muted">2</td>
              <td class="ps-3 py-3 text-muted">Platform Processing & Fee</td>
              <td class="text-center py-3 text-muted">-</td>
              <td class="text-center py-3 text-muted">-</td>
              <td class="text-end py-3 text-muted">₹<%= Number(request.commissionAmount).toFixed(2) %></td>
              <td class="text-end pe-3 py-3 fw-bold text-dark">₹<%= Number(request.commissionAmount).toFixed(2) %></td>
            </tr>
          </tbody>
          <tfoot class="bg-light">
            <tr>
              <td colspan="5" class="text-end py-3 text-muted fw-bold">Subtotal</td>
              <td class="text-end pe-3 py-3 fw-bold text-dark">₹<%= Number((request.price || 0) + (request.commissionAmount || 0)).toFixed(2) %></td>
            </tr>
            <tr>
              <td colspan="5" class="text-end py-4 fw-bold align-middle" style="font-size: 1.1rem; text-transform: uppercase;">Total Paid</td>
              <td class="text-end pe-3 py-4 fw-bolder align-middle" style="font-size: 1.25rem; color: #6f42c1;">₹<%= Number(request.totalPaid).toFixed(2) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <% if (request.primaryArtist) { %>
    <!-- html2pdf__page-break class forces a new page when saving to PDF -->
    <div class="html2pdf__page-break" style="page-break-before: always; height: 0;"></div>
    <div class="mt-4" style="padding-top: 20px;">
      <h6 class="fw-bold mb-3 text-uppercase" style="letter-spacing: 1px; color: #555;">Release Metadata</h6>
      <div class="border rounded-3 p-4 bg-light">
        <div class="row g-3">
          <div class="col-sm-12">
            <div class="label mb-1">Release Title</div>
            <div class="value mb-0" style="font-weight: 700; color: #111;"><%= request.contentTitle %></div>
          </div>
          <div class="col-sm-6">
            <div class="label mb-1">Primary Artist(s)</div>
            <div class="value mb-0" style="font-weight: 500;"><%= request.primaryArtist %></div>
          </div>
          <div class="col-sm-6">
            <div class="label mb-1">Release Date</div>
            <div class="value mb-0" style="font-weight: 500;"><%= request.releaseDate ? new Date(request.releaseDate).toLocaleDateString('en-GB') : 'N/A' %></div>
          </div>
          <div class="col-sm-4">
            <div class="label mb-1">Genre</div>
            <div class="value mb-0" style="font-weight: 500;"><%= request.genre || 'N/A' %></div>
          </div>
          <div class="col-sm-4">
            <div class="label mb-1">Language</div>
            <div class="value mb-0" style="font-weight: 500;"><%= request.language || 'English' %></div>
          </div>
          <div class="col-sm-4">
            <div class="label mb-1">Explicit</div>
            <div class="value mb-0 <%= request.explicitContent ? 'text-danger' : 'text-success' %>" style="font-weight: 500;"><%= request.explicitContent ? 'Yes' : 'No' %></div>
          </div>
          <div class="col-sm-6">
            <div class="label mb-1">Record Label</div>
            <div class="value mb-0" style="font-weight: 500;"><%= request.recordLabel || 'Independent' %></div>
          </div>
          <div class="col-sm-6">
            <div class="label mb-1">Copyright</div>
            <div class="value mb-0" style="font-weight: 500;">© <%= request.copyrightYear %> <%= request.copyrightOwner || request.primaryArtist %></div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div class="footer-note" style="margin-top: 2rem; border-top: 1px solid #eee; padding-top: 2rem; color: #999; font-size: 0.85rem; text-align: center;">
      <p>This is a computer-generated receipt and does not require a signature.</p>
      <p>Thank you for choosing Rapira for your music distribution needs. Your music is currently in the processing phase with the selected distributor.</p>
      <div class="small mt-1 text-muted">Payment status: <%= request.paymentStatus === 'free' ? 'FREE (No Charge)' : 'PAID via Razorpay Secure Gateway' %></div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <script>
    function downloadPDF() {
      const element = document.querySelector('.receipt-container');
      const buttons = document.querySelector('.print-hide');
      
      // Ensure it prints on exactly 1 page by adjusting padding and shadow temporarily
      buttons.style.display = 'none';
      element.style.padding = '25px 40px'; 
      element.style.boxShadow = 'none';
      element.style.borderRadius = '0';
      
      const opt = {
        margin:       10, // 10mm margin
        filename:     'Rapira-Receipt-<%= request.contentTitle.replace(/\s+/g, "-") %>.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };

      html2pdf().set(opt).from(element).save().then(() => {
        // Restore web layout rendering
        buttons.style.display = 'block';
        element.style.padding = '50px';
        element.style.boxShadow = '0 0.5rem 2rem rgba(0,0,0,0.05)';
        element.style.borderRadius = '10px';
      });
    }
  </script>
</body>
</html>
