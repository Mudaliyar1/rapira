<%- include('../partials/artist-header') %>

<div class="container-fluid py-4">
  <div class="row mb-5 animate__animated animate__fadeIn">
    <div class="col-12 text-center text-md-start">
      <div class="d-flex align-items-center justify-content-center justify-content-md-start mb-2">
        <i class="bi bi-clock-history text-primary fs-1 me-3"></i>
        <div>
          <h1 class="h2 fw-bold mb-0 text-white">Distribution History</h1>
          <p class="text-muted mb-0">Track all your music and video distribution requests.</p>
        </div>
      </div>
      <hr class="border-secondary opacity-25">
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-dark border-secondary shadow-sm glass-card">
        <div class="card-body p-3">
          <form action="/artist-distribution/history" method="GET" class="row g-2 align-items-end">
            <div class="col-md-3">
              <label class="form-label text-white-50 small mb-1">Search Bill No.</label>
              <input type="text" name="billSearch" class="form-control bg-dark border-secondary text-white" placeholder="RAPIRA-XXXX" value="<%= typeof filters !== 'undefined' ? filters.billSearch : '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label text-white-50 small mb-1">Search Distributor</label>
              <input type="text" name="distributorSearch" class="form-control bg-dark border-secondary text-white" placeholder="Distributor Name" value="<%= typeof filters !== 'undefined' ? filters.distributorSearch : '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label text-white-50 small mb-1">Status</label>
              <select name="status" class="form-select bg-dark border-secondary text-white">
                <option value="all" <%= typeof filters !== 'undefined' && filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                <option value="pending" <%= typeof filters !== 'undefined' && filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="in-progress" <%= typeof filters !== 'undefined' && filters.status === 'in-progress' ? 'selected' : '' %>>In Progress</option>
                <option value="completed" <%= typeof filters !== 'undefined' && filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
                <option value="rejected" <%= typeof filters !== 'undefined' && filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
              </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
              <a href="/artist-distribution/history" class="btn btn-outline-secondary">Clear</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card bg-dark border-secondary shadow-lg overflow-hidden glass-card">
        <div class="card-header bg-dark border-secondary text-white d-flex justify-content-between align-items-center p-3">
           <h5 class="mb-0 fw-bold" style="color: #ffffff !important;"><i class="bi bi-table me-2"></i>My Distribution Logs</h5>
           <span class="badge bg-primary px-3 rounded-pill"><%= requests.length %> Total Requests</span>
        </div>
        <div class="card-body p-0" style="background-color: transparent !important;">
          <div class="table-responsive" style="background-color: transparent !important;">
            <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent !important; --bs-table-bg: transparent !important; border-color: rgba(255,255,255,0.05) !important;">
              <thead>
                <tr class="text-muted small border-bottom border-secondary" style="background-color: transparent !important;">
                  <th class="ps-4 py-3" style="color: #bbb !important; background-color: transparent !important;">Bill No. & Content</th>
                  <th class="py-3" style="color: #bbb !important; background-color: transparent !important;">Distributor</th>
                  <th class="py-3" style="color: #bbb !important; background-color: transparent !important;">Package</th>
                  <th class="py-3" style="color: #bbb !important; background-color: transparent !important;">Total Paid</th>
                  <th class="py-3" style="color: #bbb !important; background-color: transparent !important;">Status</th>
                  <th class="py-3 text-end" style="color: #bbb !important; background-color: transparent !important;">Date</th>
                  <th class="pe-4 py-3 text-end" style="color: #bbb !important; background-color: transparent !important;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (requests && requests.length > 0) { %>
                  <% requests.forEach(request => { %>
                    <tr class="border-secondary hover-row" style="background-color: transparent !important; color: #fff !important;">
                      <td class="ps-4" style="background-color: transparent !important;">
                        <span class="badge bg-dark border border-secondary text-white-50 mb-2" style="font-size: 0.65rem;"><i class="bi bi-hash text-primary"></i> <%= request.receiptNumber || 'N/A' %></span>
                        <div class="d-flex align-items-center">
                          <div class="icon-box me-3 <%= request.contentType === 'audio' ? 'text-info' : 'text-danger' %>">
                            <i class="bi <%= request.contentType === 'audio' ? 'bi-music-note-beamed' : 'bi-play-btn' %> fs-5"></i>
                          </div>
                          <div>
                            <div class="fw-bold text-white"><%= request.contentTitle %></div>
                            <div class="text-muted small text-uppercase"><%= request.contentType %></div>
                          </div>
                        </div>
                      </td>
                      <td style="background-color: transparent !important;">
                        <div class="d-flex align-items-center">
                          <img src="<%= (request.distributor.profileImage && request.distributor.profileImage !== '/images/default-profile.svg') ? request.distributor.profileImage : ('https://ui-avatars.com/api/?name=' + encodeURIComponent(request.distributor.name.charAt(0).toUpperCase()) + '&background=4ECDC4&color=fff&bold=true&size=200') %>"
                               class="rounded-circle me-2 border border-secondary" width="30" height="30" style="object-fit: cover;">
                          <span class="small text-white-50"><%= request.distributor.name %></span>
                        </div>
                      </td>
                      <td style="background-color: transparent !important;">
                         <div class="small fw-bold text-white-50"><%= request.package.name %></div>
                      </td>
                      <td style="background-color: transparent !important;">
                        <div class="fw-bold text-primary"><%= request.totalPaid > 0 ? '₹' + request.totalPaid : 'FREE' %></div>
                        <span class="badge <%= request.paymentStatus === 'paid' || request.paymentStatus === 'free' ? 'bg-success' : request.paymentStatus === 'failed' ? 'bg-danger' : 'bg-warning text-dark' %> p-1" style="font-size: 0.65rem;">
                          <%= request.paymentStatus.toUpperCase() %>
                        </span>
                      </td>
                      <td style="background-color: transparent !important;">
                        <div class="d-flex flex-column">
                          <span class="badge rounded-pill <%= 
                            request.status === 'completed' ? 'bg-success' : 
                            request.status === 'pending' ? 'bg-warning text-dark' : 
                            request.status === 'in-progress' ? 'bg-info text-dark' : 'bg-danger' %>" style="width: fit-content;">
                            <%= request.status.toUpperCase() %>
                          </span>
                          <% if (request.adminNotes) { %>
                            <small class="text-muted mt-1" style="font-size: 0.7rem;">Note: <%= request.adminNotes %></small>
                          <% } %>
                        </div>
                      </td>
                      <td class="text-end" style="background-color: transparent !important;">
                        <div class="small text-white-50"><%= new Date(request.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></div>
                      </td>
                      <td class="pe-4 text-end" style="background-color: transparent !important;">
                        <a href="/artist-distribution/request-details/<%= request._id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                          <i class="bi bi-eye me-1"></i> View
                        </a>
                        <form action="/artist-distribution/history/<%= request._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Remove this distribution request from your history?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Delete from history">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-5 text-muted" style="background-color: transparent !important;">
                        <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                        No distribution history found.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .glass-card {
    background: rgba(18, 18, 18, 0.8) !important;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
  }
  .table {
    border-color: rgba(255, 255, 255, 0.05) !important;
    background-color: transparent !important;
    --bs-table-bg: transparent !important;
  }
  .table tr, .table thead, .table tbody {
    background-color: transparent !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
    transition: background-color 0.2s ease-in-out;
  }
  .table th, .table td {
    background-color: transparent !important;
    color: white !important;
  }
  .icon-box {
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hover-row:hover {
    background-color: rgba(255, 255, 255, 0.03) !important;
  }
  .badge { font-weight: 500; font-size: 0.75rem; }
</style>

<%- include('../partials/artist-footer') %>
