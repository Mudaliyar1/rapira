<div class="rapira-profile-page">
  <div class="container">
    <div class="rh-subpage-container" style="max-width: 580px;">
      
      <!-- Page Navigation Header -->
      <div class="rh-page-header-nav">
        <div class="rh-page-header-left">
          <a href="/users/profile" class="rh-back-circle-btn" title="Back to Profile">
            <i class="bi bi-arrow-left"></i>
          </a>
          <h1 class="rh-page-title">Change Password</h1>
        </div>
      </div>

      <!-- Main Form Card -->
      <div class="rh-form-card">
        <form action="/users/change-password" method="POST" id="changePasswordForm">
          
          <!-- Current Password -->
          <div class="mb-4">
            <label for="currentPassword" class="rh-form-label">Current Password <span class="text-danger">*</span></label>
            <div class="rh-input-group">
              <input type="password" class="rh-form-control" id="currentPassword" name="currentPassword" required autocomplete="current-password" placeholder="Enter current password">
              <button type="button" class="rh-input-group-addon" onclick="togglePasswordVisibility('currentPassword', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <!-- New Password -->
          <div class="mb-4">
            <label for="newPassword" class="rh-form-label">New Password <span class="text-danger">*</span></label>
            <div class="rh-input-group">
              <input type="password" class="rh-form-control" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password" placeholder="Enter at least 8 characters">
              <button type="button" class="rh-input-group-addon" onclick="togglePasswordVisibility('newPassword', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                <i class="bi bi-eye"></i>
              </button>
            </div>
            <div class="rh-form-helper">Password must be at least 8 characters long.</div>
          </div>

          <!-- Confirm New Password -->
          <div class="mb-4">
            <label for="confirmPassword" class="rh-form-label">Confirm New Password <span class="text-danger">*</span></label>
            <div class="rh-input-group">
              <input type="password" class="rh-form-control" id="confirmPassword" name="confirmPassword" required minlength="8" autocomplete="new-password" placeholder="Re-enter new password">
              <button type="button" class="rh-input-group-addon" onclick="togglePasswordVisibility('confirmPassword', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
            <a href="/users/profile" class="rh-btn-secondary">Cancel</a>
            <button type="submit" class="rh-btn-primary">
              <i class="bi bi-lock-fill me-1"></i> Update Password
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    const icon = btn.querySelector('i');
    if (icon) {
      icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
    }
  }
</script>
