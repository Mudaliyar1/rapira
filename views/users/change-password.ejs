<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header bg-white py-3">
          <h3 class="card-title fw-bold mb-0">Change Password</h3>
        </div>
        <div class="card-body p-4">
          <form action="/users/change-password" method="POST">
            <div class="mb-3">
              <label for="currentPassword" class="form-label">Current Password</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input type="password" class="form-control" id="currentPassword" name="currentPassword" required>
              </div>
            </div>
            
            <div class="mb-3">
              <label for="newPassword" class="form-label">New Password</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                <input type="password" class="form-control" id="newPassword" name="newPassword" required>
              </div>
              <div class="form-text">Password must be at least 8 characters long</div>
            </div>
            
            <div class="mb-4">
              <label for="confirmPassword" class="form-label">Confirm New Password</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
              </div>
            </div>
            
            <div class="d-flex justify-content-end gap-2">
              <a href="/users/profile" class="btn btn-outline-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">Change Password</button>
            </div>
          </form>
        </div>
      </div>
      
      <div class="text-center mt-4">
        <a href="/users/profile" class="text-decoration-none">
          <i class="bi bi-arrow-left me-1"></i> Back to Profile
        </a>
      </div>
    </div>
  </div>
</div>
