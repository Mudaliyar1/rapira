<%- contentFor('body') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h4 class="card-title mb-0">
            <i class="bi bi-person-plus me-2"></i>
            Account Reactivation
          </h4>
        </div>
        <div class="card-body">
          <% if (error && error !== null && error !== '' && error !== 'null' && error !== 'undefined') { %>
            <div class="alert alert-danger">
              <i class="bi bi-exclamation-triangle me-2"></i>
              <%= error %>
            </div>
          <% } %>
          
          <% if (success && success !== null && success !== '' && success !== 'null' && success !== 'undefined') { %>
            <div class="alert alert-success">
              <i class="bi bi-check-circle me-2"></i>
              <%= success %>
            </div>
          <% } %>
          
          <% if (typeof showOtpForm !== 'undefined' && showOtpForm) { %>
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              Reactivating account for: <strong><%= email %></strong>
            </div>
            
            <form action="/users/account-reactivation/verify-otp" method="POST">
              <input type="hidden" name="email" value="<%= email %>">
              
              <div class="mb-3">
                <label for="otp" class="form-label">Enter OTP</label>
                <input type="text" class="form-control" id="otp" name="otp" required maxlength="6" placeholder="Enter 6-digit OTP">
                <div class="form-text">Enter the 6-digit OTP sent to your email</div>
              </div>
              
              <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                Didn't receive the OTP? Check your spam or junk folder. If you still don't see it, click "Resend OTP" below.
              </div>
              
              <div class="d-grid">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-person-check me-1"></i> Verify OTP
                </button>
              </div>
            </form>
            
            <div class="text-center mt-3">
              <form action="/users/account-reactivation" method="POST" class="d-inline">
                <input type="hidden" name="email" value="<%= email %>">
                <button type="submit" class="btn btn-link text-muted p-0">
                  <i class="bi bi-arrow-repeat me-1"></i> Resend OTP
                </button>
              </form>
            </div>
          <% } else if (typeof showPasswordForm !== 'undefined' && showPasswordForm) { %>
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              Account verified. Please set a new password to complete reactivation.
            </div>
            
            <form action="/users/account-reactivation/set-password" method="POST">
              <input type="hidden" name="email" value="<%= email %>">
              
              <div class="mb-3">
                <label for="password" class="form-label">New Password</label>
                <input type="password" class="form-control" id="password" name="password" required placeholder="Enter your new password" minlength="6">
                <div class="form-text">Password must be at least 6 characters long</div>
              </div>
              
              <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required placeholder="Confirm your new password" minlength="6">
              </div>
              
              <div class="d-grid">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-lock me-1"></i> Set Password & Reactivate
                </button>
              </div>
            </form>
          <% } else { %>
            <div class="text-center">
              <div class="mb-4">
                <i class="bi bi-person-check text-info" style="font-size: 3rem;"></i>
              </div>
              <h5>Account Reactivation</h5>
              <p class="text-muted">Enter your email address to reactivate your deleted account.</p>
            </div>
            
            <form action="/users/account-reactivation" method="POST">
              <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" required 
                  placeholder="Enter your email address" 
                  value="<%= typeof email !== 'undefined' && email ? email : '' %>">
              </div>
              
              <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                After submitting, check your email (including spam/junk folders) for the OTP to complete reactivation.
              </div>
              
              <div class="d-grid">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-person-check me-1"></i> Start Reactivation
                </button>
              </div>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>