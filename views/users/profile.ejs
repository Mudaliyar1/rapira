<div class="container py-5">
  <div class="row">
    <div class="col-lg-4 mb-4 mb-lg-0">
      <div class="card">
        <div class="card-body text-center p-4">
          <% if (user.profileImage) { %>
            <img src="<%= locals.getImageUrl ? getImageUrl(user.profileImage, '/images/default-profile.png') : user.profileImage %>"
                 alt="<%= user.name %>"
                 class="rounded-circle img-thumbnail mb-3"
                 width="150" height="150"
                 onerror="this.onerror=null; this.src='/images/default-profile.png';">
          <% } else { %>
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 150px; height: 150px;">
              <i class="bi bi-person-circle text-secondary" style="font-size: 5rem;"></i>
            </div>
          <% } %>

          <h3 class="fw-bold mb-1"><%= user.name %></h3>
          <p class="text-muted mb-3">
            <span class="badge <%= user.role === 'admin' ? 'bg-danger' : user.role === 'artist' ? 'bg-primary' : 'bg-secondary' %>">
              <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
            </span>
          </p>

          <% if (user.city) { %>
            <p class="mb-3">
              <i class="bi bi-geo-alt text-primary me-1"></i> <%= user.city %>
            </p>
          <% } %>

          <div class="d-flex justify-content-center gap-3 mb-4">
            <% if (user.socialLinks.instagram) { %>
              <a href="<%= user.socialLinks.instagram %>" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle">
                <i class="bi bi-instagram"></i>
              </a>
            <% } %>
            <% if (user.socialLinks.twitter) { %>
              <a href="<%= user.socialLinks.twitter %>" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle">
                <i class="bi bi-twitter-x"></i>
              </a>
            <% } %>
            <% if (user.socialLinks.youtube) { %>
              <a href="<%= user.socialLinks.youtube %>" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle">
                <i class="bi bi-youtube"></i>
              </a>
            <% } %>
            <% if (user.socialLinks.spotify) { %>
              <a href="<%= user.socialLinks.spotify %>" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle">
                <i class="bi bi-spotify"></i>
              </a>
            <% } %>
          </div>

          <div class="d-grid gap-2">
            <a href="/users/edit-profile" class="btn btn-primary">
              <i class="bi bi-pencil-square me-1"></i> Edit Profile
            </a>
            <a href="/users/change-password" class="btn btn-outline-secondary">
              <i class="bi bi-lock me-1"></i> Change Password
            </a>
            <a href="/refund-requests/my-requests" class="btn btn-outline-warning">
              <i class="bi bi-arrow-counterclockwise me-1"></i> My Refund Requests
            </a>
            <% if (canBecomeArtist) { %>
              <a href="/artist-applications/select-level" class="btn btn-outline-primary">
                <i class="bi bi-music-note-beamed me-1"></i> Become an Artist
              </a>
            <% } %>
            <% if (pendingApplication) { %>
              <a href="/artist-applications/status" class="btn btn-outline-info">
                <i class="bi bi-hourglass-split me-1"></i> View Application Status
              </a>
            <% } %>
            <a href="/users/confirm-delete-account" class="btn btn-outline-danger mt-3">
              <i class="bi bi-trash me-1"></i> Delete Account
            </a>
          </div>
        </div>
      </div>

      <% if (user.bio) { %>
        <div class="card mt-4">
          <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3">About</h5>
            <p class="card-text"><%= user.bio %></p>
          </div>
        </div>
      <% } %>

      <% if (user.role === 'artist' && artist) { %>
        <div class="card mt-4">
          <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3">Artist Profile</h5>
            <p class="mb-2"><strong>Stage Name:</strong> <%= artist.stageName || user.name %></p>
            <p class="mb-2"><strong>Genre:</strong> <%= artist.genre %></p>
            <p class="mb-2"><strong>Years Active:</strong> <%= artist.yearsActive %></p>
            <div class="d-grid mt-3">
              <a href="/artists/<%= artist._id %>" class="btn btn-outline-primary">
                <i class="bi bi-eye me-1"></i> View Artist Profile
              </a>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Subscription Status -->
      <div class="card mt-4">
        <div class="card-body p-4">
          <h5 class="card-title fw-bold mb-3">Subscription Status</h5>

          <% if (typeof hasActiveSubscription !== 'undefined' && hasActiveSubscription && activeSubscription) { %>
            <div class="d-flex align-items-center mb-3">
              <div class="badge bg-success me-2">Active</div>
              <div class="fw-bold"><%= activeSubscription.plan.name %> Plan</div>
            </div>

            <%
              const daysRemaining = Math.ceil((new Date(activeSubscription.expiryDate) - new Date()) / (1000 * 60 * 60 * 24));
            %>

            <p class="mb-2">
              <strong>Expires:</strong>
              <%= new Date(activeSubscription.expiryDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %>
              <span class="<%= daysRemaining < 7 ? 'text-warning' : 'text-success' %>">
                (<%= daysRemaining %> days left)
              </span>
            </p>

            <% if (activeSubscription.plan.discountPercentage > 0) { %>
              <p class="mb-2 text-success">
                <i class="bi bi-tag-fill me-1"></i>
                <strong><%= activeSubscription.plan.discountPercentage %>% discount</strong> on all ticket purchases
              </p>
            <% } %>

            <div class="d-grid mt-3">
              <a href="/subscriptions/my-subscriptions" class="btn btn-outline-primary">
                <i class="bi bi-star me-1"></i> Manage Subscription
              </a>
            </div>
          <% } else { %>
            <div class="text-center py-3">
              <div class="mb-3">
                <i class="bi bi-star text-muted" style="font-size: 2rem;"></i>
              </div>
              <p class="mb-3">You don't have an active subscription.</p>
              <a href="/subscriptions" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Browse Subscription Plans
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card mb-4">
        <div class="card-header bg-white py-3">
          <h5 class="card-title fw-bold mb-0 text-dark">My Tickets</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="text-dark">Concert</th>
                  <th class="text-dark">Date</th>
                  <th class="text-dark">Venue</th>
                  <th class="text-dark">Tickets</th>
                  <th class="text-dark">Status</th>
                  <th class="text-dark">Actions</th>
                </tr>
              </thead>
              <tbody id="ticketsTableBody">
                <% if (typeof tickets !== 'undefined' && tickets.length > 0) { %>
                  <!-- Server-side rendered tickets -->
                  <% tickets.forEach(ticket => { %>
                    <tr>
                      <td><%= ticket.concert ? ticket.concert.title : 'Concert Unavailable' %></td>
                      <td><%= ticket.concert ? new Date(ticket.concert.date).toLocaleDateString() : 'N/A' %></td>
                      <td><%= ticket.concert ? ticket.concert.venue : 'N/A' %></td>
                      <td><%= ticket.quantity %></td>
                      <td>
                        <span class="badge <%= ticket.paymentStatus === 'completed' ? 'bg-success' : 'bg-warning' %>">
                          <%= ticket.paymentStatus.charAt(0).toUpperCase() + ticket.paymentStatus.slice(1) %>
                        </span>
                      </td>
                      <td>
                        <a href="/tickets/<%= ticket._id %>" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-ticket-perforated me-1"></i> View
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <!-- No tickets message -->
                  <tr>
                    <td colspan="6" class="text-center py-4">
                      <p class="mb-0 text-dark">You haven't booked any tickets yet.</p>
                      <a href="/concerts" class="btn btn-primary mt-2">Explore Concerts</a>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <% if (user.role === 'artist' && artist) { %>
        <div class="card">
          <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold mb-0 text-dark">My Concerts</h5>
            <a href="/artists/dashboard" class="btn btn-sm btn-primary">
              <i class="bi bi-speedometer2 me-1"></i> Artist Dashboard
            </a>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="text-dark">Title</th>
                    <th class="text-dark">Date</th>
                    <th class="text-dark">Venue</th>
                    <th class="text-dark">Status</th>
                    <th class="text-dark">Actions</th>
                  </tr>
                </thead>
                <tbody id="concertsTableBody">
                  <% if (typeof concerts !== 'undefined' && concerts.length > 0) { %>
                    <!-- Server-side rendered concerts -->
                    <% concerts.forEach(concert => { %>
                      <tr>
                        <td><%= concert.title %></td>
                        <td><%= new Date(concert.date).toLocaleDateString() %></td>
                        <td><%= concert.venue %></td>
                        <td>
                          <span class="badge <%= concert.status === 'approved' ? 'bg-success' : 'bg-warning' %>">
                            <%= concert.status.charAt(0).toUpperCase() + concert.status.slice(1) %>
                          </span>
                        </td>
                        <td>
                          <a href="/concerts/<%= concert._id %>" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i> View
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <!-- No concerts message -->
                    <tr>
                      <td colspan="5" class="text-center py-4">
                        <p class="mb-0 text-dark">You haven't created any concerts yet.</p>
                        <a href="/concerts/create" class="btn btn-primary mt-2">Create Concert</a>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  // Load tickets
  document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM loaded, fetching tickets data...');

    // Get the tickets table body element
    const ticketsTableBody = document.getElementById('ticketsTableBody');
    if (!ticketsTableBody) {
      console.error('Tickets table body element not found!');
      return;
    }

    // Set a timeout to show a message if the AJAX request takes too long
    const ticketsTimeout = setTimeout(function() {
      if (ticketsTableBody.innerHTML.includes('spinner-border')) {
        ticketsTableBody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center py-4">
              <p class="mb-0">Loading tickets is taking longer than expected.</p>
              <p class="mb-0">You can <a href="/tickets">view your tickets here</a> or try refreshing the page.</p>
            </td>
          </tr>
        `;
      }
    }, 5000); // 5 seconds timeout

    // Function to update tickets table with no tickets message
    function showNoTicketsMessage() {
      ticketsTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="text-center py-4">
            <p class="mb-0">You haven't booked any tickets yet.</p>
            <a href="/concerts" class="btn btn-primary mt-2">Explore Concerts</a>
          </td>
        </tr>
      `;
    }

    // Function to update tickets table with error message
    function showTicketsErrorMessage() {
      ticketsTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="text-center py-4">
            <p class="text-danger mb-0">Failed to load tickets. Please try again later.</p>
          </td>
        </tr>
      `;
    }

    // We don't need to fetch tickets via AJAX anymore since we're showing the message server-side
    // This code is kept for reference but won't execute
    console.log('Server-side rendering of tickets is now used instead of AJAX');

    // Load concerts for artists
    const concertsTableBody = document.getElementById('concertsTableBody');
    if (concertsTableBody) {
      console.log('Concerts table body found, fetching concerts data...');

      // Set a timeout to show a message if the AJAX request takes too long
      const concertsTimeout = setTimeout(function() {
        if (concertsTableBody.innerHTML.includes('spinner-border')) {
          concertsTableBody.innerHTML = `
            <tr>
              <td colspan="5" class="text-center py-4">
                <p class="mb-0">Loading concerts is taking longer than expected.</p>
                <p class="mb-0">You can <a href="/artists/dashboard">view your concerts here</a> or try refreshing the page.</p>
              </td>
            </tr>
          `;
        }
      }, 5000); // 5 seconds timeout

      // Function to update concerts table with no concerts message
      function showNoConcertsMessage() {
        concertsTableBody.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-4">
              <p class="mb-0">You haven't created any concerts yet.</p>
              <a href="/concerts/create" class="btn btn-primary mt-2">Create Concert</a>
            </td>
          </tr>
        `;
      }

      // Function to update concerts table with error message
      function showConcertsErrorMessage() {
        concertsTableBody.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-4">
              <p class="text-danger mb-0">Failed to load concerts. Please try again later.</p>
            </td>
          </tr>
        `;
      }

      // We don't need to fetch concerts via AJAX anymore since we're showing the message server-side
      // This code is kept for reference but won't execute
      console.log('Server-side rendering of concerts is now used instead of AJAX');
    } else {
      console.error('Concerts table body element not found!');
    }
  });
</script>


