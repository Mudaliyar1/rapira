<%- contentFor('body') %>

<div class="rapira-content-library-page">
  <!-- 1. Hero Section -->
  <section class="rh-cl-hero-section">
    <div class="container">
      <div class="row align-items-center g-4 g-lg-5">
        <!-- Left: Typography & Editorial Accents -->
        <div class="col-lg-6 col-12 rh-cl-hero-text-col">
          <div class="rh-cl-eyebrow-container">
            <span class="rh-cl-eyebrow">CONTENT LIBRARY</span>
            <svg class="rh-cl-eyebrow-underline" viewBox="0 0 130 9" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2 7C38 3 88 3 128 6.5" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </div>

          <div class="rh-cl-title-wrap">
            <h1 class="rh-cl-hero-title">Content<br>Library</h1>
            <!-- Crown Doodle -->
            <svg class="rh-cl-crown-doodle" viewBox="0 0 44 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 25L9 11L18 19L27 6L36 19L41 11L41 25H4Z" stroke="#9F190E" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="9" cy="8" r="1.5" fill="#9F190E"/>
              <circle cx="27" cy="3.5" r="1.5" fill="#9F190E"/>
              <circle cx="41" cy="8" r="1.5" fill="#9F190E"/>
            </svg>
          </div>

          <p class="rh-cl-hero-subtitle">
            Discover music, videos, and more from our talented artists.
          </p>

          <!-- Flourish double stroke underline -->
          <div class="rh-cl-flourish-wrap">
            <svg class="rh-cl-flourish-stroke" viewBox="0 0 155 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2 6C42 2 105 3 153 8" stroke="#9F190E" stroke-width="2.4" stroke-linecap="round"/>
              <path d="M12 12.5C52 8.5 112 9.5 142 13" stroke="#9F190E" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </div>
        </div>

        <!-- Right: Studio Recording Microphone Photo -->
        <div class="col-lg-6 col-12 rh-cl-hero-media-col">
          <div class="rh-cl-hero-media-card">
            <picture>
              <source srcset="/images/content-library/hero-mic.webp" type="image/webp">
              <img src="/images/content-library/hero-mic.jpg" alt="Music Recording Studio Setup" class="rh-cl-hero-img img-fluid" loading="eager" width="640" height="360">
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Search & Filter Section -->
  <section class="rh-cl-filter-section mb-4">
    <div class="container">
      <div class="rh-cl-filter-container">
        <div class="rh-cl-filter-header d-flex align-items-center justify-content-between">
          <div class="rh-cl-filter-heading d-flex align-items-center">
            <svg class="rh-cl-funnel-icon me-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9F190E" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <span class="rh-cl-filter-title">Search &amp; Filter Content</span>
          </div>
          <!-- Mobile Filter Collapse Button -->
          <button class="rh-cl-filter-toggle-btn d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#clFilterCollapse" aria-expanded="true" aria-controls="clFilterCollapse" aria-label="Toggle Filters">
            <i class="bi bi-chevron-up" id="clFilterToggleIcon"></i>
          </button>
        </div>

        <div class="collapse show" id="clFilterCollapse">
          <form action="/content" method="GET" id="contentFilterForm" class="rh-cl-filter-form mt-2 mt-md-0">
            <% if (typeof currentFilters !== 'undefined' && currentFilters.artist) { %>
              <input type="hidden" name="artist" value="<%= currentFilters.artist %>">
            <% } %>
            <div class="rh-cl-filter-controls">
              <!-- Search Input with Live Filter -->
              <div class="rh-cl-search-box">
                <i class="bi bi-search rh-cl-search-icon" aria-hidden="true"></i>
                <input type="text" 
                       id="contentSearchInput" 
                       name="search" 
                       value="<%= (typeof currentFilters !== 'undefined' && currentFilters.search) ? currentFilters.search : '' %>" 
                       placeholder="Search by title, artist or keyword..." 
                       class="rh-cl-search-field"
                       autocomplete="off"
                       aria-label="Search content library">
                <button type="button" class="rh-cl-clear-btn d-none" id="contentSearchClear" aria-label="Clear search input">
                  <i class="bi bi-x-circle-fill"></i>
                </button>
              </div>

              <!-- Filter Dropdowns Group -->
              <%
                const mediaFilterOptions = [
                  { value: '', label: 'All Types' },
                  { value: 'audio', label: 'Audio' },
                  { value: 'video', label: 'Videos' },
                  { value: 'image', label: 'Images' },
                  { value: 'youtube_video', label: 'YouTube Video' },
                  { value: 'youtube_audio', label: 'YouTube Audio' }
                ];
                const activeMedia = (typeof currentFilters !== 'undefined' && currentFilters.mediaType) ? currentFilters.mediaType : '';
                const activeMediaOpt = mediaFilterOptions.find(o => o.value === activeMedia) || mediaFilterOptions[0];

                const sortFilterOptions = [
                  { value: 'latest', label: 'Latest' },
                  { value: 'oldest', label: 'Oldest' },
                  { value: 'popular', label: 'Most Popular' }
                ];
                const activeSort = (typeof currentFilters !== 'undefined' && currentFilters.sort) ? currentFilters.sort : 'latest';
                const activeSortOpt = sortFilterOptions.find(o => o.value === activeSort) || sortFilterOptions[0];
              %>
              <div class="rh-cl-dropdowns-group">
                <!-- Hidden inputs for server submission -->
                <input type="hidden" id="mediaTypeFilter" name="mediaType" value="<%= activeMedia %>">
                <input type="hidden" id="sortFilter" name="sort" value="<%= activeSort %>">

                <!-- Custom Media Type Dropdown -->
                <div class="rh-cl-custom-dropdown" id="mediaTypeCustomDropdown" data-name="mediaType">
                  <button type="button" 
                          class="rh-cl-custom-dropdown-btn" 
                          id="mediaTypeDropdownBtn" 
                          aria-haspopup="listbox" 
                          aria-expanded="false"
                          aria-controls="mediaTypeMenu"
                          aria-label="Filter by media type: <%= activeMediaOpt.label %>">
                    <span class="rh-cl-dropdown-btn-inner">
                      <i class="bi bi-layers rh-cl-dropdown-icon" aria-hidden="true"></i>
                      <span class="rh-cl-dropdown-current-label" id="mediaTypeLabel"><%= activeMediaOpt.label %></span>
                    </span>
                    <i class="bi bi-chevron-down rh-cl-caret-icon" aria-hidden="true"></i>
                  </button>
                  <ul class="rh-cl-custom-dropdown-menu" id="mediaTypeMenu" role="listbox" aria-labelledby="mediaTypeDropdownBtn">
                    <% mediaFilterOptions.forEach(opt => { %>
                      <li class="rh-cl-dropdown-option <%= activeMedia === opt.value ? 'selected' : '' %>" 
                          role="option" 
                          data-value="<%= opt.value %>" 
                          aria-selected="<%= activeMedia === opt.value ? 'true' : 'false' %>"
                          tabindex="0">
                        <span class="rh-cl-option-text"><%= opt.label %></span>
                        <i class="bi bi-check2 rh-cl-option-check" aria-hidden="true"></i>
                      </li>
                    <% }); %>
                  </ul>
                </div>

                <!-- Custom Sort Filter Dropdown -->
                <div class="rh-cl-custom-dropdown" id="sortCustomDropdown" data-name="sort">
                  <button type="button" 
                          class="rh-cl-custom-dropdown-btn" 
                          id="sortDropdownBtn" 
                          aria-haspopup="listbox" 
                          aria-expanded="false"
                          aria-controls="sortMenu"
                          aria-label="Sort content: <%= activeSortOpt.label %>">
                    <span class="rh-cl-dropdown-btn-inner">
                      <i class="bi bi-calendar3 rh-cl-dropdown-icon" aria-hidden="true"></i>
                      <span class="rh-cl-dropdown-current-label" id="sortLabel"><%= activeSortOpt.label %></span>
                    </span>
                    <i class="bi bi-chevron-down rh-cl-caret-icon" aria-hidden="true"></i>
                  </button>
                  <ul class="rh-cl-custom-dropdown-menu" id="sortMenu" role="listbox" aria-labelledby="sortDropdownBtn">
                    <% sortFilterOptions.forEach(opt => { %>
                      <li class="rh-cl-dropdown-option <%= activeSort === opt.value ? 'selected' : '' %>" 
                          role="option" 
                          data-value="<%= opt.value %>" 
                          aria-selected="<%= activeSort === opt.value ? 'true' : 'false' %>"
                          tabindex="0">
                        <span class="rh-cl-option-text"><%= opt.label %></span>
                        <i class="bi bi-check2 rh-cl-option-check" aria-hidden="true"></i>
                      </li>
                    <% }); %>
                  </ul>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Content Cards Grid -->
  <section class="rh-cl-grid-section py-2">
    <div class="container">
      <% if (posts && posts.length > 0) { %>
        <div class="row g-4" id="contentCardsGrid">
          <% posts.forEach(item => { %>
            <%
              const artistName = (item.artist && item.artist.user && item.artist.user.name) 
                ? item.artist.user.name 
                : ((item.artist && item.artist.stageName) ? item.artist.stageName : 'Unknown Artist');
              const rawTitle = item.title || item.caption || 'Untitled';
              const cleanTitle = rawTitle.replace(/\s+/g, ' ').trim();
              const itemTitle = cleanTitle;
              const displayTitle = cleanTitle.length > 55 ? cleanTitle.substring(0, 52).trim() + '...' : cleanTitle;
              const mediaType = (item.media && item.media.mediaType) ? item.media.mediaType : (item.type === 'song' ? 'audio' : 'image');
              const likesCount = item.likesDisplay || item.likesCount || (item.likes ? item.likes.length : 0);
              const viewsCount = item.viewsDisplay || item.views || 0;
              const hasAudioThumb = item.media && item.media.thumbnailUrl;
              const isAudioWithoutThumb = mediaType === 'audio' && !hasAudioThumb && !item.isYoutube;
            %>
            <div class="col-xl-3 col-lg-4 col-md-6 col-12 rh-cl-grid-item"
                 data-title="<%= itemTitle.toLowerCase() %>"
                 data-artist="<%= artistName.toLowerCase() %>">
              <div class="rh-cl-card">
                <!-- 16:9 Thumbnail Area with Media Badge -->
                <div class="rh-cl-thumb-container">
                  <% if (item.isYoutube && item.youtubeThumbnail) { %>
                    <img src="<%= item.youtubeThumbnail %>" alt="<%= itemTitle %>" class="rh-cl-thumb-media" loading="lazy">
                    <div class="rh-cl-yt-play-wrap">
                      <div class="rh-cl-yt-play-btn">
                        <i class="bi bi-play-fill"></i>
                      </div>
                    </div>
                    <span class="rh-cl-type-badge rh-cl-badge-video">
                      <i class="bi bi-camera-video me-1"></i>Video
                    </span>
                  <% } else if (item.media && item.media.thumbnailUrl && (mediaType === 'audio' || mediaType === 'video')) { %>
                    <img src="<%= item.media.thumbnailUrl %>" alt="<%= itemTitle %>" class="rh-cl-thumb-media" loading="lazy">
                    <% if (mediaType === 'audio') { %>
                      <span class="rh-cl-type-badge rh-cl-badge-audio">
                        <i class="bi bi-music-note-beamed me-1"></i>Audio
                      </span>
                    <% } else { %>
                      <span class="rh-cl-type-badge rh-cl-badge-video">
                        <i class="bi bi-camera-video me-1"></i>Video
                      </span>
                    <% } %>
                  <% } else if (isAudioWithoutThumb) { %>
                    <!-- Audio without image: Violet Soundwave Visual (Card 2 Reference) -->
                    <div class="rh-cl-soundwave-surface">
                      <svg viewBox="0 0 240 80" class="rh-cl-soundwave-graphic" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <line x1="16" y1="40" x2="16" y2="40" stroke="rgba(255,255,255,0.4)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="24" y1="38" x2="24" y2="42" stroke="rgba(255,255,255,0.5)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="32" y1="34" x2="32" y2="46" stroke="rgba(255,255,255,0.6)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="40" y1="28" x2="40" y2="52" stroke="rgba(255,255,255,0.7)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="48" y1="20" x2="48" y2="60" stroke="rgba(255,255,255,0.8)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="56" y1="12" x2="56" y2="68" stroke="rgba(255,255,255,0.9)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="64" y1="22" x2="64" y2="58" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="72" y1="30" x2="72" y2="50" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="80" y1="14" x2="80" y2="66" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="88" y1="6" x2="88" y2="74" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="96" y1="18" x2="96" y2="62" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="104" y1="10" x2="104" y2="70" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="112" y1="24" x2="112" y2="56" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="120" y1="8" x2="120" y2="72" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="128" y1="16" x2="128" y2="64" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="136" y1="26" x2="136" y2="54" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="144" y1="12" x2="144" y2="68" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="152" y1="18" x2="152" y2="62" stroke="rgba(255,255,255,0.9)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="160" y1="28" x2="160" y2="52" stroke="rgba(255,255,255,0.8)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="168" y1="20" x2="168" y2="60" stroke="rgba(255,255,255,0.7)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="176" y1="32" x2="176" y2="48" stroke="rgba(255,255,255,0.6)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="184" y1="36" x2="184" y2="44" stroke="rgba(255,255,255,0.5)" stroke-width="2.5" stroke-linecap="round"/>
                        <line x1="192" y1="39" x2="192" y2="41" stroke="rgba(255,255,255,0.4)" stroke-width="2.5" stroke-linecap="round"/>
                      </svg>
                    </div>
                    <span class="rh-cl-type-badge rh-cl-badge-audio">
                      <i class="bi bi-music-note-beamed me-1"></i>Audio
                    </span>
                  <% } else if (mediaType === 'video') { %>
                    <video class="rh-cl-thumb-media" preload="metadata" muted playsinline>
                      <source src="<%= item.media && item.media.url ? item.media.url : '' %>#t=0.1">
                    </video>
                    <span class="rh-cl-type-badge rh-cl-badge-video">
                      <i class="bi bi-camera-video me-1"></i>Video
                    </span>
                  <% } else { %>
                    <img src="<%= item.media && item.media.url ? item.media.url : '/images/placeholder.jpg' %>" alt="<%= itemTitle %>" class="rh-cl-thumb-media" loading="lazy">
                    <span class="rh-cl-type-badge rh-cl-badge-image">
                      <i class="bi bi-image me-1"></i>Image
                    </span>
                  <% } %>
                </div>

                <!-- Content Info -->
                <div class="rh-cl-card-info">
                  <h3 class="rh-cl-item-title" title="<%= cleanTitle %>">
                    <%= displayTitle %>
                  </h3>
                  <p class="rh-cl-item-artist">
                    By <% if (item.artist && item.artist._id) { %>
                      <a href="/artists/<%= item.artist._id %>" class="rh-cl-artist-anchor"><%= artistName %></a>
                    <% } else { %>
                      <span class="rh-cl-artist-anchor"><%= artistName %></span>
                    <% } %>
                  </p>
                  <div class="rh-cl-item-meta">
                    <span class="rh-cl-meta-tag">
                      <i class="bi bi-calendar3"></i> <%= toISTDateString(item.createdAt) %>
                    </span>
                    <span class="rh-cl-meta-tag">
                      <i class="bi bi-eye"></i> <%= viewsCount %> <%= Number(viewsCount) === 1 ? 'view' : 'views' %>
                    </span>
                    <% if (likesCount || Number(likesCount) > 0) { %>
                      <span class="rh-cl-meta-tag">
                        <i class="bi bi-heart-fill"></i> <%= likesCount %> <%= Number(likesCount) === 1 ? 'like' : 'likes' %>
                      </span>
                    <% } %>
                  </div>
                </div>

                <!-- Action Buttons: Side-by-side equal width -->
                <div class="rh-cl-card-footer">
                  <div class="rh-cl-action-btns">
                    <!-- Primary Action Button (Listen / Watch / View) -->
                    <% if (item.sourceModel === 'Content' || item.isYoutube) { %>
                      <a href="<%= item.sourceModel === 'Content' ? '/content/' + item._id : '/posts/view/' + item._id %>" class="rh-cl-btn rh-cl-btn-primary">
                        <% if (item.isYoutube || mediaType === 'video') { %>
                          <i class="bi bi-play-circle me-1"></i>Watch
                        <% } else if (mediaType === 'audio') { %>
                          <i class="bi bi-headphones me-1"></i>Listen
                        <% } else if (mediaType === 'image') { %>
                          <i class="bi bi-eye me-1"></i>View
                        <% } else { %>
                          Open
                        <% } %>
                      </a>
                    <% } else { %>
                      <button onclick="viewPost('<%= item._id %>', '<%= item.sourceModel %>')" class="rh-cl-btn rh-cl-btn-primary" type="button">
                        <% if (mediaType === 'video') { %>
                          <i class="bi bi-play-circle me-1"></i>Watch
                        <% } else if (mediaType === 'audio') { %>
                          <i class="bi bi-headphones me-1"></i>Listen
                        <% } else if (mediaType === 'image') { %>
                          <i class="bi bi-eye me-1"></i>View
                        <% } else { %>
                          Open
                        <% } %>
                      </button>
                    <% } %>

                    <!-- Download Button -->
                    <% if (!item.isYoutube && item.media && item.media.url) { %>
                      <a href="/content/download?sourceModel=<%= item.sourceModel %>&id=<%= item._id %>" 
                         class="rh-cl-btn rh-cl-btn-outline rh-cl-download-btn" 
                         data-download-id="<%= item._id %>" 
                         data-download-title="<%= itemTitle.replace(/"/g, '&quot;') %>"
                         download>
                        <i class="bi bi-download me-1"></i>Download
                      </a>
                    <% } else if (item.isYoutube) { %>
                      <a href="<%= item.media && item.media.url ? item.media.url : ('https://www.youtube.com/watch?v=' + item.youtubeId) %>" target="_blank" rel="noopener noreferrer" class="rh-cl-btn rh-cl-btn-outline">
                        <i class="bi bi-download me-1"></i>Download
                      </a>
                    <% } else { %>
                      <button class="rh-cl-btn rh-cl-btn-outline" disabled type="button">
                        <i class="bi bi-download me-1"></i>Download
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- No Matching Search Results State -->
        <div id="noSearchMatches" class="text-center py-5 d-none">
          <i class="bi bi-search display-3 mb-3 d-block" style="color: #9F190E;"></i>
          <h4 style="font-family: 'Titan One', sans-serif; color: #9F190E;">No Content Found</h4>
          <p class="text-muted">No content matches your search term on this page. Try searching for a different keyword or clear your search.</p>
        </div>

        <!-- 4. Pagination Section -->
        <% if (pagination.totalPages > 1) { %>
          <%
            const buildPaginationUrl = (page) => {
              const params = new URLSearchParams();
              if (currentFilters.mediaType) params.set('mediaType', currentFilters.mediaType);
              if (currentFilters.artist) params.set('artist', currentFilters.artist);
              if (currentFilters.sort) params.set('sort', currentFilters.sort);
              if (currentFilters.search) params.set('search', currentFilters.search);
              params.set('page', page);
              return '?' + params.toString();
            };
            const startPage = Math.max(1, pagination.page - 2);
            const endPage = Math.min(pagination.totalPages, pagination.page + 2);
          %>
          <nav aria-label="Content pagination" class="rh-cl-pagination-container my-5">
            <ul class="rh-cl-pagination-list">
              <!-- Previous Arrow Button -->
              <li class="rh-cl-page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
                <a class="rh-cl-page-link rh-cl-nav-arrow" href="<%= pagination.hasPrev ? buildPaginationUrl(pagination.page - 1) : '#' %>" aria-label="Previous page">
                  <i class="bi bi-chevron-left"></i>
                </a>
              </li>

              <!-- First page if needed -->
              <% if (startPage > 1) { %>
                <li class="rh-cl-page-item">
                  <a class="rh-cl-page-link" href="<%= buildPaginationUrl(1) %>">1</a>
                </li>
                <% if (startPage > 2) { %>
                  <li class="rh-cl-page-item disabled">
                    <span class="rh-cl-page-ellipsis">…</span>
                  </li>
                <% } %>
              <% } %>

              <!-- Numbered Pages -->
              <% for (let p = startPage; p <= endPage; p++) { %>
                <li class="rh-cl-page-item <%= pagination.page === p ? 'active' : '' %>">
                  <a class="rh-cl-page-link" href="<%= buildPaginationUrl(p) %>"><%= p %></a>
                </li>
              <% } %>

              <!-- Last page if needed -->
              <% if (endPage < pagination.totalPages) { %>
                <% if (endPage < pagination.totalPages - 1) { %>
                  <li class="rh-cl-page-item disabled">
                    <span class="rh-cl-page-ellipsis">…</span>
                  </li>
                <% } %>
                <li class="rh-cl-page-item">
                  <a class="rh-cl-page-link" href="<%= buildPaginationUrl(pagination.totalPages) %>"><%= pagination.totalPages %></a>
                </li>
              <% } %>

              <!-- Next Arrow Button -->
              <li class="rh-cl-page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
                <a class="rh-cl-page-link rh-cl-nav-arrow" href="<%= pagination.hasNext ? buildPaginationUrl(pagination.page + 1) : '#' %>" aria-label="Next page">
                  <i class="bi bi-chevron-right"></i>
                </a>
              </li>
            </ul>
          </nav>
        <% } %>

      <% } else { %>
        <!-- Empty State Container -->
        <div class="text-center py-5">
          <div class="mb-3">
            <i class="bi bi-search display-2" style="color: #9F190E;"></i>
          </div>
          <h3 style="font-family: 'Titan One', sans-serif; color: #9F190E;">No Content Found</h3>
          <p class="text-muted">Try adjusting your filters or check back later for new content from our artists.</p>
          <a href="/content" class="rh-cl-btn rh-cl-btn-primary d-inline-block px-4 py-2 mt-2">Clear All Filters</a>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Floating Download Dock (Desktop bottom-right / Mobile bottom-sheet) -->
  <div id="rh-download-dock" class="rh-download-dock" aria-live="polite"></div>

  <!-- Custom Dropdowns, Live Filtering & Download Experience Script -->
  <script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('contentFilterForm');
  const mediaTypeFilter = document.getElementById('mediaTypeFilter');
  const sortFilter = document.getElementById('sortFilter');
  const searchInput = document.getElementById('contentSearchInput');
  const searchClear = document.getElementById('contentSearchClear');
  const filterCollapse = document.getElementById('clFilterCollapse');
  const filterToggleIcon = document.getElementById('clFilterToggleIcon');
  const cardsGrid = document.getElementById('contentCardsGrid');
  const noMatchesBox = document.getElementById('noSearchMatches');
  const downloadDock = document.getElementById('rh-download-dock');

  // Active download tracking (to prevent duplicate clicks)
  const activeDownloads = new Set();

  /* ==========================================================================
     1. CUSTOM ACCESSIBLE DROPDOWNS
     ========================================================================== */
  const customDropdowns = document.querySelectorAll('.rh-cl-custom-dropdown');

  function closeAllDropdowns() {
    customDropdowns.forEach(dropdown => {
      dropdown.classList.remove('open');
      const btn = dropdown.querySelector('.rh-cl-custom-dropdown-btn');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    });
  }

  function adjustDropdownPosition(dropdown) {
    const menu = dropdown.querySelector('.rh-cl-custom-dropdown-menu');
    if (!menu) return;
    
    // Check if right edge overflows viewport
    menu.classList.remove('align-right');
    const rect = menu.getBoundingClientRect();
    if (rect.right > window.innerWidth - 12) {
      menu.classList.add('align-right');
    }
  }

  customDropdowns.forEach(dropdown => {
    const btn = dropdown.querySelector('.rh-cl-custom-dropdown-btn');
    const menu = dropdown.querySelector('.rh-cl-custom-dropdown-menu');
    const options = dropdown.querySelectorAll('.rh-cl-dropdown-option');
    const fieldName = dropdown.getAttribute('data-name');
    const hiddenInput = fieldName === 'mediaType' ? mediaTypeFilter : sortFilter;
    const labelSpan = dropdown.querySelector('.rh-cl-dropdown-current-label');

    if (!btn || !menu) return;

    // Toggle dropdown open/closed
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const isOpen = dropdown.classList.contains('open');
      closeAllDropdowns();

      if (!isOpen) {
        dropdown.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        adjustDropdownPosition(dropdown);

        // Focus currently selected option or first option
        const selectedOpt = dropdown.querySelector('.rh-cl-dropdown-option.selected') || options[0];
        if (selectedOpt) selectedOpt.focus();
      }
    });

    // Keyboard support on the trigger button
    btn.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (!dropdown.classList.contains('open')) {
          closeAllDropdowns();
          dropdown.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          adjustDropdownPosition(dropdown);
        }
        const selectedOpt = dropdown.querySelector('.rh-cl-dropdown-option.selected') || options[0];
        if (selectedOpt) selectedOpt.focus();
      } else if (e.key === 'Escape') {
        closeAllDropdowns();
      }
    });

    // Option selection
    options.forEach(opt => {
      const selectOption = () => {
        const value = opt.getAttribute('data-value');
        const text = opt.querySelector('.rh-cl-option-text')?.textContent || '';

        // Update hidden input
        if (hiddenInput) {
          hiddenInput.value = value;
        }

        // Update display label
        if (labelSpan) {
          labelSpan.textContent = text;
        }

        // Update selected class
        options.forEach(o => {
          o.classList.remove('selected');
          o.setAttribute('aria-selected', 'false');
        });
        opt.classList.add('selected');
        opt.setAttribute('aria-selected', 'true');

        closeAllDropdowns();
        btn.focus();

        // Submit form
        if (form) form.submit();
      };

      opt.addEventListener('click', function(e) {
        e.stopPropagation();
        selectOption();
      });

      opt.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectOption();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          const next = opt.nextElementSibling;
          if (next && next.classList.contains('rh-cl-dropdown-option')) {
            next.focus();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = opt.previousElementSibling;
          if (prev && prev.classList.contains('rh-cl-dropdown-option')) {
            prev.focus();
          } else {
            btn.focus();
          }
        } else if (e.key === 'Escape') {
          e.preventDefault();
          closeAllDropdowns();
          btn.focus();
        }
      });
    });
  });

  // Close custom dropdowns on outside click or Escape
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.rh-cl-custom-dropdown')) {
      closeAllDropdowns();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeAllDropdowns();
    }
  });

  /* ==========================================================================
     2. DOWNLOAD MANAGER (Progress UI, Floating Dock, No Screen Blocking)
     ========================================================================== */
  function formatBytes(bytes) {
    if (!bytes || bytes <= 0) return '0 B';
    const mb = bytes / (1024 * 1024);
    if (mb >= 1) return mb.toFixed(1) + ' MB';
    const kb = bytes / 1024;
    return kb.toFixed(0) + ' KB';
  }

  function getFilenameFromHeader(header, fallbackTitle) {
    if (!header) return fallbackTitle;
    const match = /filename\*?=(?:UTF-8'')?["']?([^"';]+)["']?/i.exec(header);
    if (match && match[1]) {
      try {
        return decodeURIComponent(match[1].trim());
      } catch(e) {
        return match[1].trim();
      }
    }
    return fallbackTitle;
  }

  function renderDownloadDock(state, data) {
    if (!downloadDock) return;

    if (state === 'hidden') {
      downloadDock.classList.remove('active', 'completed', 'failed');
      downloadDock.innerHTML = '';
      return;
    }

    downloadDock.classList.add('active');
    downloadDock.classList.remove('completed', 'failed');

    const cleanTitle = (data.title || 'Rapira Media').length > 36
      ? (data.title || 'Rapira Media').substring(0, 34) + '...'
      : (data.title || 'Rapira Media');

    if (state === 'starting') {
      downloadDock.innerHTML = `
        <div class="rh-dl-content">
          <div class="rh-dl-header">
            <div class="rh-dl-icon-badge">
              <i class="bi bi-arrow-down-circle-fill rh-dl-spin-pulse"></i>
            </div>
            <div class="rh-dl-meta">
              <span class="rh-dl-title" title="${data.title}">${cleanTitle}</span>
              <span class="rh-dl-status">Preparing download...</span>
            </div>
            <button type="button" class="rh-dl-close-btn" aria-label="Dismiss">&times;</button>
          </div>
          <div class="rh-dl-progress-track">
            <div class="rh-dl-progress-fill rh-dl-indeterminate"></div>
          </div>
        </div>
      `;
    } else if (state === 'downloading') {
      const hasLength = data.lengthComputable && data.total > 0;
      const percent = hasLength ? Math.min(100, Math.max(0, Math.floor((data.loaded / data.total) * 100))) : null;
      const sizeText = hasLength 
        ? `${formatBytes(data.loaded)} / ${formatBytes(data.total)}`
        : `${formatBytes(data.loaded)} downloaded`;

      downloadDock.innerHTML = `
        <div class="rh-dl-content">
          <div class="rh-dl-header">
            <div class="rh-dl-icon-badge">
              <i class="bi bi-cloud-arrow-down-fill rh-dl-icon-accent"></i>
            </div>
            <div class="rh-dl-meta">
              <span class="rh-dl-title" title="${data.title}">${cleanTitle}</span>
              <div class="rh-dl-metrics">
                <span class="rh-dl-status">Downloading...</span>
                <span class="rh-dl-size">${sizeText}</span>
              </div>
            </div>
            ${percent !== null ? `<span class="rh-dl-percentage">${percent}%</span>` : ''}
            <button type="button" class="rh-dl-close-btn" aria-label="Dismiss">&times;</button>
          </div>
          <div class="rh-dl-progress-track">
            <div class="rh-dl-progress-fill ${percent === null ? 'rh-dl-indeterminate' : ''}" style="${percent !== null ? 'width: ' + percent + '%;' : ''}"></div>
          </div>
        </div>
      `;
    } else if (state === 'completed') {
      downloadDock.classList.add('completed');
      downloadDock.innerHTML = `
        <div class="rh-dl-content">
          <div class="rh-dl-header">
            <div class="rh-dl-icon-badge rh-dl-success">
              <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="rh-dl-meta">
              <span class="rh-dl-title" title="${data.title}">${cleanTitle}</span>
              <span class="rh-dl-status rh-dl-status-success">Download complete</span>
            </div>
            <button type="button" class="rh-dl-close-btn" aria-label="Dismiss">&times;</button>
          </div>
          <div class="rh-dl-progress-track">
            <div class="rh-dl-progress-fill" style="width: 100%;"></div>
          </div>
        </div>
      `;
    } else if (state === 'failed') {
      downloadDock.classList.add('failed');
      downloadDock.innerHTML = `
        <div class="rh-dl-content">
          <div class="rh-dl-header">
            <div class="rh-dl-icon-badge rh-dl-error">
              <i class="bi bi-exclamation-circle-fill"></i>
            </div>
            <div class="rh-dl-meta">
              <span class="rh-dl-title" title="${data.title}">${cleanTitle}</span>
              <span class="rh-dl-status rh-dl-status-error">Download failed</span>
            </div>
            <button type="button" class="rh-dl-retry-btn" id="rhDlRetryBtn"><i class="bi bi-arrow-clockwise me-1"></i>Retry</button>
            <button type="button" class="rh-dl-close-btn" aria-label="Dismiss">&times;</button>
          </div>
        </div>
      `;

      const retryBtn = document.getElementById('rhDlRetryBtn');
      if (retryBtn) {
        retryBtn.addEventListener('click', () => {
          startDownload(data.url, data.title, data.id);
        });
      }
    }

    // Attach close button
    const closeBtn = downloadDock.querySelector('.rh-dl-close-btn');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        renderDownloadDock('hidden', {});
      });
    }
  }

  function startDownload(url, title, id) {
    if (activeDownloads.has(id)) {
      // Flash dock to show already downloading
      downloadDock.classList.add('rh-dl-pulse');
      setTimeout(() => downloadDock.classList.remove('rh-dl-pulse'), 400);
      return;
    }

    activeDownloads.add(id);
    renderDownloadDock('starting', { url, title, id });

    const xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.responseType = 'blob';

    xhr.onprogress = function(e) {
      renderDownloadDock('downloading', {
        url,
        title,
        id,
        loaded: e.loaded,
        total: e.total,
        lengthComputable: e.lengthComputable
      });
    };

    xhr.onload = function() {
      if (xhr.status >= 200 && xhr.status < 300) {
        const disposition = xhr.getResponseHeader('Content-Disposition');
        const filename = getFilenameFromHeader(disposition, title + '.mp4');
        const blob = xhr.response;

        // Trigger browser save
        const blobUrl = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        setTimeout(() => window.URL.revokeObjectURL(blobUrl), 20000);

        renderDownloadDock('completed', { url, title, id });
        activeDownloads.delete(id);

        // Auto dismiss after 3.5s
        setTimeout(() => {
          if (!activeDownloads.size && downloadDock.classList.contains('completed')) {
            renderDownloadDock('hidden', {});
          }
        }, 3500);
      } else {
        renderDownloadDock('failed', { url, title, id });
        activeDownloads.delete(id);
      }
    };

    xhr.onerror = function() {
      renderDownloadDock('failed', { url, title, id });
      activeDownloads.delete(id);
    };

    xhr.onabort = function() {
      renderDownloadDock('hidden', {});
      activeDownloads.delete(id);
    };

    xhr.send();
  }

  // Intercept clicks on download buttons
  document.querySelectorAll('.rh-cl-download-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      const url = this.getAttribute('href');
      const title = this.getAttribute('data-download-title') || 'Rapira Media';
      const id = this.getAttribute('data-download-id') || url;

      if (url && url.startsWith('/content/download')) {
        e.preventDefault();
        startDownload(url, title, id);
      }
    });
  });

  // Export trigger for other components if needed
  window.triggerRapiraDownload = startDownload;

  /* ==========================================================================
     3. CLIENT-SIDE LIVE SEARCH FILTER
     ========================================================================== */
  if (searchInput && cardsGrid) {
    const cardItems = cardsGrid.querySelectorAll('.rh-cl-grid-item');

    function performLiveFilter() {
      const query = searchInput.value.trim().toLowerCase();
      let matchCount = 0;

      if (searchClear) {
        if (query.length > 0) {
          searchClear.classList.remove('d-none');
        } else {
          searchClear.classList.add('d-none');
        }
      }

      cardItems.forEach(item => {
        const title = item.getAttribute('data-title') || '';
        const artist = item.getAttribute('data-artist') || '';
        const isMatch = !query || title.includes(query) || artist.includes(query);

        if (isMatch) {
          item.classList.remove('d-none');
          matchCount++;
        } else {
          item.classList.add('d-none');
        }
      });

      if (noMatchesBox) {
        if (matchCount === 0 && cardItems.length > 0) {
          noMatchesBox.classList.remove('d-none');
        } else {
          noMatchesBox.classList.add('d-none');
        }
      }
    }

    searchInput.addEventListener('input', performLiveFilter);

    if (searchClear) {
      searchClear.addEventListener('click', function() {
        searchInput.value = '';
        performLiveFilter();
        searchInput.focus();
      });
    }

    if (searchInput.value.trim().length > 0) {
      performLiveFilter();
    }
  }

  // Mobile filter collapse chevron rotation
  if (filterCollapse && filterToggleIcon) {
    filterCollapse.addEventListener('show.bs.collapse', function () {
      filterToggleIcon.classList.remove('bi-chevron-down');
      filterToggleIcon.classList.add('bi-chevron-up');
    });

    filterCollapse.addEventListener('hide.bs.collapse', function () {
      filterToggleIcon.classList.remove('bi-chevron-up');
      filterToggleIcon.classList.add('bi-chevron-down');
    });
  }
});
</script>
</div>
