<%- contentFor('body') %>

<!-- Hero Section -->
<section class="py-5 bg-gradient-primary text-white">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-4 fw-bold mb-3">Content Library</h1>
        <p class="lead mb-4">Discover music, videos, and more from our talented artists.</p>
      </div>
      <div class="col-lg-6">
        <img src="/images/content-library.svg" alt="Content Library" class="img-fluid d-none d-lg-block">
      </div>
    </div>
  </div>
</section>

<!-- Filter Section -->
<section class="py-4" style="background-color: var(--bg);">
  <div class="container">
    <!-- Search and Filter Form -->
    <div class="card border-0 shadow-lg mb-4 glass-card-dark">
      <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            <i class="bi bi-funnel me-2"></i>Search & Filter Content
          </h5>
          <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
            <i class="bi bi-chevron-down" id="filterToggleIcon"></i>
            <span class="d-none d-md-inline ms-1">Toggle Filters</span>
          </button>
        </div>
      </div>
      <div class="collapse" id="filterCollapse">
        <div class="card-body">
        <form action="/content" method="GET" id="contentFilterForm">
          <div class="row g-3">
            <!-- Media Type Filter -->
            <div class="col-md-3">
              <label for="mediaTypeFilter" class="form-label fw-semibold">Media Type</label>
              <select class="form-select" id="mediaTypeFilter" name="mediaType">
                <option value="">All Types</option>
                <option value="image" <%= currentFilters.mediaType === 'image' ? 'selected' : '' %>>Images</option>
                <option value="video" <%= currentFilters.mediaType === 'video' ? 'selected' : '' %>>Videos</option>
                <option value="audio" <%= currentFilters.mediaType === 'audio' ? 'selected' : '' %>>Audio</option>
              </select>
            </div>

            <!-- Artist Filter -->
            <div class="col-md-4">
              <label for="artistFilter" class="form-label fw-semibold">Artist</label>
              <select class="form-select" id="artistFilter" name="artist">
                <option value="">All Artists</option>
                <% if (artists && artists.length > 0) { %>
                  <% artists.forEach(artist => { %>
                    <option value="<%= artist._id %>" <%= currentFilters.artist === artist._id.toString() ? 'selected' : '' %>>
                      <%= artist.user ? artist.user.name : 'Unknown Artist' %>
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <!-- Sort Filter -->
            <div class="col-md-3">
              <label for="sortFilter" class="form-label fw-semibold">Sort By</label>
              <select class="form-select" id="sortFilter" name="sort">
                <option value="latest" <%= currentFilters.sort === 'latest' ? 'selected' : '' %>>Latest First</option>
                <option value="oldest" <%= currentFilters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                <option value="popular" <%= currentFilters.sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
              </select>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="row mt-4">
            <div class="col-12">
              <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a href="/content" class="btn btn-outline-secondary px-4">
                  <i class="bi bi-x-circle me-1"></i> Clear
                </a>
              </div>
            </div>
          </div>


        </form>
        </div>
      </div>
    </div>


  </div>
</section>

<!-- Content Grid -->
<section class="py-5">
  <div class="container">
    <% if (posts && posts.length > 0) { %>
      <div class="row g-4">
        <% posts.forEach(item => { %>
          <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm content-card">
              <div class="position-relative">
                <% if (item.media && item.media.mediaType === 'audio') { %>
                  <div class="card-img-top content-thumbnail d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="bi bi-music-note-beamed text-white" style="font-size: 4rem;"></i>
                  </div>
                <% } else if (item.media && item.media.mediaType === 'video') { %>
                  <video class="card-img-top content-thumbnail" preload="metadata" muted playsinline>
                    <source src="<%= item.media && item.media.url ? item.media.url : '' %>#t=0.1">
                  </video>
                <% } else { %>
                  <img src="<%= item.media && item.media.url ? item.media.url : '/images/placeholder.jpg' %>" class="card-img-top content-thumbnail" alt="<%= item.title || 'Post' %>">
                <% } %>
                <% if (item.media && item.media.mediaType) { %>
                  <span class="badge <%= item.media.mediaType === 'image' ? 'bg-primary' : item.media.mediaType === 'video' ? 'bg-danger' : 'bg-success' %> content-type-badge">
                    <i class="bi <%= item.media.mediaType === 'image' ? 'bi-image' : item.media.mediaType === 'video' ? 'bi-camera-video' : 'bi-music-note-beamed' %>"></i>
                    <%= item.media.mediaType.charAt(0).toUpperCase() + item.media.mediaType.slice(1) %>
                  </span>
                <% } %>
              </div>
              <div class="card-body">
                <h5 class="card-title" style="color:#fff !important;"><%= item.title %></h5>
                <p class="card-text text-muted small">
                  <% if (item.artist && item.artist.user) { %>
                    By <a href="/artists/<%= item.artist._id %>" class="text-decoration-none">
                      <%= item.artist.user.name %>
                    </a>
                  <% } else { %>
                    By Unknown Artist
                  <% } %>
                </p>
                <% if (item.description) { %>
                  <p class="card-text"><%= item.description.length > 100 ? item.description.substring(0, 100) + '...' : item.description %></p>
                <% } %>
                <p class="card-text">
                  <small class="text-muted">
                    <i class="bi bi-calendar3"></i> <%= toISTDateString(item.createdAt) %>
                    <span class="ms-2"><i class="bi bi-eye"></i> <%= item.views || 0 %> views</span>
                    <% if (item.likes && item.likes.length > 0) { %>
                      <span class="ms-2"><i class="bi bi-heart-fill"></i> <%= item.likes.length %> likes</span>
                    <% } %>
                  </small>
                </p>
              </div>
              <div class="card-footer bg-white border-top-0">
                <button onclick="viewPost('<%= item._id %>')"
                   class="btn btn-outline-primary w-100">
                  <%= (item.media && item.media.mediaType === 'video') ? 'Watch' : (item.media && item.media.mediaType === 'audio') ? 'Listen' : (item.media && item.media.mediaType === 'image') ? 'View' : 'Open' %>
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
        <%
          // Build query string for pagination links
          const buildPaginationUrl = (page) => {
            const params = new URLSearchParams();
            if (currentFilters.mediaType) params.set('mediaType', currentFilters.mediaType);
            if (currentFilters.artist) params.set('artist', currentFilters.artist);
            if (currentFilters.sort) params.set('sort', currentFilters.sort);
            params.set('page', page);
            return '?' + params.toString();
          };
        %>
        <nav aria-label="Content pagination" class="mt-5">
          <ul class="pagination justify-content-center">
            <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
              <a class="page-link" href="<%= buildPaginationUrl(pagination.page - 1) %>" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
              </a>
            </li>

            <%
              // Show pagination with smart truncation
              const startPage = Math.max(1, pagination.page - 2);
              const endPage = Math.min(pagination.totalPages, pagination.page + 2);
            %>

            <% if (startPage > 1) { %>
              <li class="page-item">
                <a class="page-link" href="<%= buildPaginationUrl(1) %>">1</a>
              </li>
              <% if (startPage > 2) { %>
                <li class="page-item disabled">
                  <span class="page-link">...</span>
                </li>
              <% } %>
            <% } %>

            <% for (let i = startPage; i <= endPage; i++) { %>
              <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                <a class="page-link" href="<%= buildPaginationUrl(i) %>">
                  <%= i %>
                </a>
              </li>
            <% } %>

            <% if (endPage < pagination.totalPages) { %>
              <% if (endPage < pagination.totalPages - 1) { %>
                <li class="page-item disabled">
                  <span class="page-link">...</span>
                </li>
              <% } %>
              <li class="page-item">
                <a class="page-link" href="<%= buildPaginationUrl(pagination.totalPages) %>"><%= pagination.totalPages %></a>
              </li>
            <% } %>

            <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
              <a class="page-link" href="<%= buildPaginationUrl(pagination.page + 1) %>" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
              </a>
            </li>
          </ul>
        </nav>
      <% } %>
    <% } else if (posts && posts.length > 0) { %>
      <h3 class="mb-4">Latest Artist Posts</h3>
      <div class="row g-4">
        <% posts.forEach(p => { %>
          <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm content-card">
              <div class="position-relative" style="background:#000;display:flex;align-items:center;justify-content:center;height:200px;overflow:hidden;">
                <% if (p.media && p.media.mediaType === 'image') { %>
                  <img src="<%= p.media.url %>" alt="post" class="content-thumbnail" style="object-fit:contain;background:#000;">
                <% } else if (p.media && p.media.mediaType === 'video') { %>
                  <video class="content-thumbnail" style="object-fit:contain;background:#000;" muted>
                    <source src="<%= p.media.url %>" type="video/mp4">
                  </video>
                <% } %>
                <span class="badge bg-info content-type-badge">
                  <i class="bi <%= (p.media && p.media.mediaType === 'video') ? 'bi-camera-video' : 'bi-image' %>"></i>
                  <%= (p.media && p.media.mediaType) ? p.media.mediaType.charAt(0).toUpperCase() + p.media.mediaType.slice(1) : 'Post' %>
                </span>
              </div>
              <div class="card-body">
                <h5 class="card-title" style="color:#fff !important;"><%= (p.caption && p.caption.length > 0) ? (p.caption.length > 60 ? p.caption.substring(0,60)+'...' : p.caption) : 'Artist Post' %></h5>
                <p class="card-text text-muted small">
                  <% if (p.artist && p.artist.user) { %>
                    By <a href="/artists/<%= p.artist._id %>" class="text-decoration-none"><%= p.artist.user.name %></a>
                  <% } else { %>
                    By Artist
                  <% } %>
                </p>
                <p class="card-text">
                  <small class="text-muted">
                    <i class="bi bi-clock-history"></i>
                    <%= toISTDateString(p.createdAt) %>
                    <span class="ms-2"><i class="bi bi-eye"></i> <%= p.views || 0 %> views</span>
                    <span class="ms-2"><i class="bi bi-heart-fill"></i> <%= p.likesCount || 0 %></span>
                    <span class="ms-2"><i class="bi bi-share"></i> <%= p.shares || 0 %></span>
                  </small>
                </p>
              </div>
              <div class="card-footer bg-white border-top-0">
                <button onclick="viewPost('<%= p._id %>')" class="btn btn-outline-primary w-100">View Post</button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <div class="mb-4">
          <i class="bi bi-search display-1 text-muted"></i>
        </div>
        <h3>No content found</h3>
        <p class="text-muted">Try adjusting your filters or check back later for new content.</p>
      </div>
    <% } %>
  </div>
</section>

<%- contentFor('title') %>Content Library

<!-- JavaScript for Enhanced Functionality -->
<%- contentFor('extraScripts') %>
<script>
document.addEventListener('DOMContentLoaded', function() {


  // Enhanced form handling with auto-submit for filters
  const form = document.getElementById('contentFilterForm');
  const mediaTypeFilter = document.getElementById('mediaTypeFilter');
  const artistFilter = document.getElementById('artistFilter');
  const sortFilter = document.getElementById('sortFilter');

  let searchTimeout;

  // Auto-submit on filter changes
  [mediaTypeFilter, artistFilter, sortFilter].forEach(filter => {
    if (filter) {
      filter.addEventListener('change', function() {
        clearTimeout(searchTimeout);
        form.submit();
      });
    }
  });

  // Enhanced form submission with loading state
  if (form) {
    form.addEventListener('submit', function() {
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Searching...';
        submitBtn.disabled = true;
        submitBtn.classList.add('loading');

        // Re-enable after a delay (in case of errors)
        setTimeout(() => {
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
          submitBtn.classList.remove('loading');
        }, 5000);
      }
    });
  }

  // Highlight search terms in results
  const searchTerm = '<%= currentFilters.search || "" %>';
  if (searchTerm.trim()) {
    highlightSearchTerms(searchTerm.trim());
  }

  // Function to highlight search terms
  function highlightSearchTerms(term) {
    if (!term) return;

    const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    const contentCards = document.querySelectorAll('.content-card');

    contentCards.forEach(card => {
      const title = card.querySelector('.card-title');
      const description = card.querySelector('.card-text');

      if (title && !title.querySelector('mark')) {
        const originalText = title.textContent;
        if (regex.test(originalText)) {
          title.innerHTML = originalText.replace(regex, '<mark class="bg-warning text-dark rounded px-1">$1</mark>');
        }
      }

      if (description && !description.querySelector('mark')) {
        const originalText = description.textContent;
        if (regex.test(originalText)) {
          description.innerHTML = originalText.replace(regex, '<mark class="bg-warning text-dark rounded px-1">$1</mark>');
        }
      }
    });
  }

  // Show active filter indicators
  function updateFilterIndicators() {
    const hasFilters = '<%= currentFilters.mediaType || currentFilters.artist || currentFilters.sort !== "latest" %>';

    if (hasFilters) {
      const filterHeader = document.querySelector('.card-header h5');
      if (filterHeader && !filterHeader.querySelector('.badge')) {
        filterHeader.innerHTML += ' <span class="badge bg-light text-primary ms-2">Filters Active</span>';
      }
    }
  }

  updateFilterIndicators();

  // Handle filter toggle icon rotation
  const filterCollapse = document.getElementById('filterCollapse');
  const filterToggleIcon = document.getElementById('filterToggleIcon');

  if (filterCollapse && filterToggleIcon) {
    filterCollapse.addEventListener('show.bs.collapse', function () {
      filterToggleIcon.classList.remove('bi-chevron-down');
      filterToggleIcon.classList.add('bi-chevron-up');
    });

    filterCollapse.addEventListener('hide.bs.collapse', function () {
      filterToggleIcon.classList.remove('bi-chevron-up');
      filterToggleIcon.classList.add('bi-chevron-down');
    });
  }
  
  // Handle post viewing from content library
  window.viewPost = function(postId) {
    // Show loading indicator immediately
    const loadingIndicator = `
      <div id="loadingModal" class="modal fade" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content" style="background:#0f0f1e; border:1px solid #333;">
            <div class="modal-body text-center py-5">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-3 text-white">Loading post...</p>
            </div>
          </div>
        </div>
      </div>
    `;
    
    // Add loading modal to DOM if not already present
    if (!document.getElementById('loadingModal')) {
      document.body.insertAdjacentHTML('beforeend', loadingIndicator);
    }
    
    // Show loading modal immediately
    const loadingModalEl = document.getElementById('loadingModal');
    const loadingModal = new bootstrap.Modal(loadingModalEl);
    loadingModal.show();
    
    // Try to use the post viewer if available
    if (typeof window.viewPost === 'function') {
      // Hide loading modal and show actual post
      loadingModal.hide();
      window.viewPost(postId);
    } else {
      // Fallback: redirect to post detail page
      window.location.href = `/posts/view/${postId}`;
    }
  };
});
</script>

<style>
/* Enhanced styles for content library */
.content-card {
  transition: all 0.3s ease;
  border: none;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  overflow: hidden;
}

.content-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

.content-thumbnail {
  height: 200px;
  object-fit: cover;
  transition: all 0.3s ease;
}

.content-card:hover .content-thumbnail {
  transform: scale(1.05);
}

.content-type-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  font-size: 0.75em;
  backdrop-filter: blur(10px);
  background: rgba(255, 255, 255, 0.9);
  color: #333;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Enhanced form styling */
.form-control:focus, .form-select:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
}

.input-group-text {
  border-color: #dee2e6;
}

.form-label {
  color: #495057;
  margin-bottom: 0.5rem;
}

/* Button enhancements */
.btn {
  border-radius: 8px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border: none;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #5b5bd6 0%, #7c3aed 100%);
}

/* Card enhancements */
.card {
  transition: all 0.3s ease;
  border-radius: 12px;
  overflow: hidden;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.1);
}

.card-header {
  border-radius: 12px 12px 0 0 !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}



.form-check-input:checked {
  background-color: #6366f1;
  border-color: #6366f1;
}

.form-check-label {
  color: #495057;
}

/* Badge styling */
.badge {
  font-size: 0.75em;
  padding: 0.5em 0.75em;
  border-radius: 6px;
}

/* Search highlighting */
mark {
  padding: 0.1em 0.3em;
  border-radius: 4px;
  background-color: #fff3cd;
  color: #856404;
  font-weight: 500;
}

/* Loading animation */
@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.6; }
  100% { opacity: 1; }
}

.loading {
  animation: pulse 1.5s infinite;
}

/* Filter indicator */
.badge.bg-light {
  color: #6366f1 !important;
  background-color: rgba(99, 102, 241, 0.1) !important;
  border: 1px solid rgba(99, 102, 241, 0.2);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .content-card {
    margin-bottom: 1.5rem;
  }

  .pagination {
    font-size: 0.9em;
  }

  .content-thumbnail {
    height: 150px;
  }

  .btn {
    margin-bottom: 0.5rem;
  }

  .d-flex.flex-wrap.gap-2 {
    justify-content: center;
  }

  #statsSection .row.g-3 > .col-md-2 {
    margin-bottom: 1rem;
  }
}

/* Smooth transitions for all interactive elements */
* {
  transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}
</style>
