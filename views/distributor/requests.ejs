<%- include('../partials/distributor-header') %>

<h2 class="fw-bold mb-1 text-white">Artist Requests</h2>
<p class="text-white-50 mb-4">Manage distribution requests from artists who purchased your packages.</p>

<div class="mb-4">
  <button class="btn btn-outline-light rounded-pill px-4" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
    <i class="bi bi-funnel me-2"></i>Filter Requests
  </button>
</div>

<div class="collapse mb-5" id="filterCollapse">
  <div class="glass-card-dark p-4">
    <form action="/distributor-dashboard/requests" method="GET" class="row g-3">
      <div class="col-md-4">
        <label class="form-label text-white-75">Status</label>
        <select name="status" class="form-select bg-dark border-secondary text-white">
          <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>All Statuses</option>
          <option value="pending" <%= currentStatus === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="completed" <%= currentStatus === 'completed' ? 'selected' : '' %>>Completed</option>
          <option value="rejected" <%= currentStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label text-white-75">Search by Bill No.</label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-hash"></i></span>
          <input type="text" name="billNumber" class="form-control bg-dark border-secondary text-white" placeholder="RAPIRA-XXXX" value="<%= typeof searchBill !== 'undefined' ? searchBill : '' %>">
        </div>
      </div>
      <div class="col-md-3">
        <label class="form-label text-white-75">Search by Email</label>
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-envelope"></i></span>
          <input type="text" name="email" class="form-control bg-dark border-secondary text-white" placeholder="artist@example.com" value="<%= typeof searchEmail !== 'undefined' ? searchEmail : '' %>">
        </div>
      </div>
      <div class="col-md-3">
        <label class="form-label text-white-75">Filter by State/City</label>
        <select name="state" class="form-select bg-dark border-secondary text-white">
          <option value="">All Locations</option>
          <% if (typeof statesList !== 'undefined' && statesList.length > 0) { %>
            <% statesList.forEach(s => { %>
              <option value="<%= s %>" <%= typeof searchState !== 'undefined' && searchState.toLowerCase() === s.toLowerCase() ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <div class="col-12 mt-4 d-flex justify-content-end gap-2">
        <a href="/distributor-dashboard/requests" class="btn btn-outline-secondary px-4">Clear</a>
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-2"></i> Apply Filters</button>
      </div>
    </form>
  </div>
</div>

<div class="glass-card-dark pe-0 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" style="color: #fff;">
      <thead>
        <tr>
          <th class="ps-4 py-3" style="color: #bbb !important; background-color: transparent !important;">Bill No. & Artist</th>
          <th class="py-3" style="color: #bbb !important; background-color: transparent !important;">Content & Package</th>
          <th class="py-3" style="color: #bbb !important; background-color: transparent !important;">Req. Date</th>
          <th class="py-3" style="color: #bbb !important; background-color: transparent !important;">Status & Payment</th>
          <th class="pe-4 py-3 text-end" style="color: #bbb !important; background-color: transparent !important;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (requests && requests.length > 0) { %>
          <% requests.forEach(reqObj => { %>
            <tr style="background-color: transparent !important;">
              <td class="ps-4" style="background-color: transparent !important;">
                <div class="d-flex flex-column text-start">
                  <span class="badge bg-dark border border-secondary text-white-50 mb-2 align-self-start" style="font-size: 0.7rem;"><i class="bi bi-hash text-primary"></i> <%= reqObj.receiptNumber %></span>
                  <div class="d-flex align-items-center">
                    <img src="<%= (reqObj.artist.profileImage && reqObj.artist.profileImage !== '/images/default-profile.svg') ? reqObj.artist.profileImage : ('https://ui-avatars.com/api/?name=' + encodeURIComponent(reqObj.artist.name.charAt(0).toUpperCase()) + '&background=random&color=fff&bold=true') %>" 
                         class="rounded-circle me-3" width="35" height="35" style="object-fit: cover;">
                    <div>
                      <h6 class="fw-bold mb-0 text-white" style="font-size: 0.9rem;"><%= reqObj.artist.name %></h6>
                      <p class="text-white-50 mb-0" style="font-size: 0.75rem;"><%= reqObj.artist.email %></p>
                    </div>
                  </div>
                </div>
              </td>
              <td style="background-color: transparent !important;">
                <div class="fw-bold text-white mb-1"><%= reqObj.contentTitle %></div>
                <div class="d-flex gap-2 align-items-center">
                  <span class="badge bg-primary bg-opacity-10 text-primary text-uppercase border border-primary border-opacity-25" style="font-size: 0.65rem;"><%= reqObj.contentType %></span>
                  <span class="text-white-50" style="font-size: 0.75rem;">Pkg: <%= reqObj.package ? reqObj.package.name : 'Unknown' %> (<%= reqObj.price > 0 ? '₹' + reqObj.price : 'FREE' %>)</span>
                </div>
              </td>
              <td style="background-color: transparent !important;">
                <div class="text-white-50 small"><%= new Date(reqObj.createdAt).toLocaleDateString() %></div>
              </td>
              <td style="background-color: transparent !important;">
                <div class="d-flex flex-column gap-1 align-items-start">
                  <span class="badge rounded-pill <%= reqObj.status === 'completed' ? 'bg-success' : reqObj.status === 'pending' ? 'bg-warning text-dark' : reqObj.status === 'in-progress' ? 'bg-info text-dark' : 'bg-danger' %>" style="font-size: 0.65rem;">
                    <%= reqObj.status.toUpperCase() %>
                  </span>
                  <span class="badge rounded-pill <%= reqObj.paymentStatus === 'paid' || reqObj.paymentStatus === 'free' ? 'bg-success bg-opacity-10 text-success border border-success' : 'bg-danger bg-opacity-10 text-danger border border-danger' %>" style="font-size: 0.65rem;">
                    <%= reqObj.paymentStatus === 'paid' ? 'Paid' : (reqObj.paymentStatus === 'free' ? 'FREE' : 'Unpaid') %>
                  </span>
                </div>
              </td>
              <td class="pe-4 text-end" style="background-color: transparent !important;">
                <div class="d-flex gap-1 justify-content-end">
                  <a href="/distributor-dashboard/request/<%= reqObj._id %>" class="btn btn-sm btn-outline-info rounded-pill px-2" title="View Details">
                    <i class="bi bi-eye"></i>
                  </a>
                  <button class="btn btn-sm btn-primary rounded-pill px-3" onclick="updateStatus('<%= reqObj._id %>', '<%= reqObj.status %>', '<%= reqObj.adminNotes || '' %>')">
                    Process
                  </button>
                  <form action="/distributor-dashboard/request/<%= reqObj._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Remove this request from your dashboard completely?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete record">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-5" style="background-color: transparent !important;">
              <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
              <p class="text-white-50 mb-0">No distribution requests available at the moment.</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Status Update Modal -->
<div class="modal fade" id="statusModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content glass-card-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title fw-bold text-white">Update Request Status</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="statusForm" method="POST">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label text-white">Update Status To:</label>
            <select name="status" id="status_val" class="form-select" required>
              <option value="pending">Pending</option>
              <option value="in-progress">In Progress</option>
              <option value="completed">Completed / Distributed</option>
              <option value="rejected">Rejected</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label text-white">Internal Notes / Response to Artist</label>
            <textarea name="adminNotes" id="notes_val" class="form-control" rows="4" placeholder="Enter links to distributed platforms (if completed) or rejection reason..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4">Save Status</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/distributor-footer', { extraScripts: '<script>function updateStatus(id, currentStatus, currentNotes) { const form = document.getElementById("statusForm"); form.action = "/distributor-dashboard/requests/" + id + "/status"; document.getElementById("status_val").value = currentStatus; document.getElementById("notes_val").value = currentNotes; new bootstrap.Modal(document.getElementById("statusModal")).show(); }</script>' }) %>
