<%- include('../partials/distributor-header') %>

<!-- Flash Messages -->
<% if (typeof success !== 'undefined' && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="glass-card-dark mb-4">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <h5 class="text-white mb-2">Distribution Earnings & Logs</h5>
      <p class="text-white-50 mb-0">Track all earnings from your artist distribution packages.</p>
    </div>
    <div class="text-end">
      <h3 class="text-success mb-0">₹<%= lifetimeTotal.toFixed(2) %></h3>
      <p class="text-white-50 small mb-0">Total Lifetime Earnings</p>
    </div>
  </div>
</div>

<div class="glass-card-dark">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
      <h5 class="mb-0 text-white">Earnings History</h5>
      <span class="badge bg-success bg-opacity-10 text-success border border-success">₹<%= totalEarnings.toFixed(2) %> Filtered</span>
    </div>
    <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="<%= (filters.dateFrom || filters.dateTo || filters.email || filters.state || (filters.status && filters.status !== 'all') || (filters.paymentStatus && filters.paymentStatus !== 'all')) ? 'true' : 'false' %>" aria-controls="filterCollapse">
      <i class="bi bi-funnel"></i> Filters
    </button>
  </div>
  
  <div class="collapse <%= (filters.dateFrom || filters.dateTo || filters.email || filters.state || (filters.status && filters.status !== 'all') || (filters.paymentStatus && filters.paymentStatus !== 'all')) ? 'show' : '' %>" id="filterCollapse">
    <div class="card-body border-bottom border-light border-opacity-10" style="background: rgba(0,0,0,0.2) !important;">
      <form action="/distributor-dashboard/earnings" method="GET" class="row g-3">
        <div class="col-md-3">
          <label class="form-label text-white-50 small">Date From</label>
          <input type="date" name="dateFrom" class="form-control" value="<%= filters.dateFrom || '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label text-white-50 small">Date To</label>
          <input type="date" name="dateTo" class="form-control" value="<%= filters.dateTo || '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label text-white-50 small">Email Search</label>
          <input type="text" name="email" class="form-control" placeholder="artist@example.com" value="<%= filters.email || '' %>">
        </div>
        <div class="col-md-2">
          <label class="form-label text-white-50 small">Location</label>
          <select name="state" class="form-select">
            <option value="">All Locations</option>
            <% if (typeof statesList !== 'undefined' && statesList.length > 0) { %>
              <% statesList.forEach(s => { %>
                <option value="<%= s %>" <%= filters.state && filters.state.toLowerCase() === s.toLowerCase() ? 'selected' : '' %>><%= s %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label text-white-50 small">Order Status</label>
          <select name="status" class="form-select">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="in-progress" <%= filters.status === 'in-progress' ? 'selected' : '' %>>In Progress</option>
            <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
            <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label text-white-50 small">Payment Status</label>
          <select name="paymentStatus" class="form-select">
            <option value="all" <%= filters.paymentStatus === 'all' ? 'selected' : '' %>>All</option>
            <option value="paid" <%= filters.paymentStatus === 'paid' ? 'selected' : '' %>>Paid</option>
            <option value="free" <%= filters.paymentStatus === 'free' ? 'selected' : '' %>>Free</option>
          </select>
        </div>
        <div class="col-12 mt-3 d-flex justify-content-end gap-2">
          <% if (filters.dateFrom || filters.dateTo || filters.email || filters.state || (filters.status && filters.status !== 'all') || (filters.paymentStatus && filters.paymentStatus !== 'all')) { %>
            <a href="/distributor-dashboard/earnings" class="btn btn-outline-danger px-4" title="Clear Filters">Clear</a>
          <% } %>
          <button type="submit" class="btn btn-primary px-4">Apply Filters</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card-body pt-0 mt-3">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>Date</th>
            <th>Artist</th>
            <th>Content</th>
            <th>Package</th>
            <th>Amount Paid</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (earningsData && earningsData.length > 0) { %>
            <% earningsData.forEach(earning => { %>
              <tr>
                <td class="text-white-50"><%= new Date(earning.createdAt).toLocaleDateString() %><br><small><%= new Date(earning.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small></td>
                <td>
                  <div class="d-flex align-items-center">
                    <img src="<%= (earning.artist && earning.artist.profileImage && earning.artist.profileImage !== '/images/default-profile.svg') ? earning.artist.profileImage : ('https://ui-avatars.com/api/?name=' + encodeURIComponent(earning.artist ? earning.artist.name.charAt(0).toUpperCase() : 'A') + '&background=random&color=fff&bold=true') %>" width="32" height="32" class="rounded-circle me-2 object-fit-cover" alt="">
                    <span class="text-white"><%= earning.artist ? earning.artist.name : 'Unknown Artist' %></span>
                  </div>
                </td>
                <td class="fw-bold text-white">
                  <%= earning.contentTitle %><br>
                  <span class="badge bg-secondary text-white mt-1" style="font-size: 0.65rem;"><%= earning.contentType %></span>
                </td>
                <td class="text-white"><%= earning.package ? earning.package.name : 'Unknown Package' %></td>
                <td class="fw-bold text-success"><%= earning.price > 0 ? '₹' + Number(earning.price).toFixed(2) : 'FREE' %></td>
                <td>
                  <span class="badge rounded-pill <%= earning.status === 'completed' ? 'bg-success bg-opacity-10 text-success border border-success' : 'bg-warning bg-opacity-10 text-warning border border-warning' %>"><%= earning.status.toUpperCase() %></span>
                </td>
                <td class="text-end">
                  <a href="/distributor-dashboard/request/<%= earning._id %>" class="btn btn-sm btn-outline-light rounded-pill mb-1">View Details</a>
                  <form action="/distributor-dashboard/request/<%= earning._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Remove this earning record from your dashboard completely?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete record">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-white-50">
                <i class="bi bi-wallet2 fs-1 text-muted d-block mb-3"></i>
                <h5 class="text-white">No earnings found</h5>
                <p class="mb-4">No earnings found for the selected period or filters.</p>
                <% if (filters.dateFrom || filters.dateTo || filters.email || filters.state || (filters.status && filters.status !== 'all') || (filters.paymentStatus && filters.paymentStatus !== 'all')) { %>
                  <a href="/distributor-dashboard/earnings" class="btn btn-outline-light rounded-pill"><i class="bi bi-x-circle me-1"></i> Clear Filters</a>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/distributor-footer') %>
