<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Dashboard' %> - Rapira Admin</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('./partials/admin-sidebar', { path: typeof currentPath !== 'undefined' ? currentPath : '/admin' }) %>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
          <button class="btn btn-primary me-3" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>
          <h1 class="fw-bold mb-0"><%= typeof title !== 'undefined' ? title : 'Admin Dashboard' %></h1>
        </div>
        <% if (typeof headerButtons !== 'undefined') { %>
          <div>
            <%- headerButtons %>
          </div>
        <% } %>
      </div>

      <%- body %>
    </div>
  </div>

  <!-- Mobile Admin Toggle -->
  <button class="btn admin-toggle d-md-none" id="adminToggle">
    <i class="bi bi-list"></i>
  </button>



  <!-- Bootstrap 5 JS Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery (for some components) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Custom JS -->
  <script src="/js/main.js"></script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
