<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Too Many Requests</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .rate-limit-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-radius: 15px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      padding: 2rem;
      text-align: center;
      max-width: 500px;
      width: 90%;
      margin: 1rem;
    }
    
    .rate-limit-icon {
      font-size: 3rem;
      color: #ff6b6b;
      margin-bottom: 1rem;
    }
    
    .rate-limit-title {
      color: #333;
      font-size: 2rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }
    
    .rate-limit-message {
      color: #666;
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }
    
    .retry-after {
      background: #f8f9fa;
      border-radius: 10px;
      padding: 1rem;
      margin: 1.5rem 0;
      font-size: 1.1rem;
      color: #495057;
    }
    
    .retry-after span {
      font-weight: 600;
      color: #667eea;
    }
    
    .reload-btn {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none;
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 25px;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .reload-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }
    
    .reload-btn:active {
      transform: translateY(0);
    }
    
    .back-home {
      margin-top: 1rem;
      color: #6c757d;
      text-decoration: none;
      font-size: 0.9rem;
    }
    
    .back-home:hover {
      color: #495057;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="rate-limit-card">
    <div class="rate-limit-icon">
      <i class="bi bi-exclamation-triangle"></i>
    </div>
    
    <h1 class="rate-limit-title">Too Many Requests</h1>
    
    <p class="rate-limit-message">
      You have made too many requests in a short period of time. Please slow down and try again later.
    </p>
    
    <div class="retry-after">
      <p>You can try again in: <span id="countdown"><%= retryAfter %> seconds</span></p>
    </div>
    
    <button class="reload-btn" onclick="window.location.reload()">
      <i class="bi bi-arrow-repeat"></i>
      Reload Page
    </button>
    
    <a href="/" class="back-home">
      <i class="bi bi-house-door"></i>
      Back to Home
    </a>
  </div>

  <script>
    // Update countdown timer
    let seconds = <%= retryAfter %>;
    const countdownElement = document.getElementById('countdown');
    
    const updateCountdown = () => {
      if (seconds > 0) {
        countdownElement.textContent = seconds + ' seconds';
        seconds--;
        setTimeout(updateCountdown, 1000);
      } else {
        countdownElement.textContent = '0 seconds';
      }
    };
    
    // Start countdown
    if (seconds > 0) {
      setTimeout(updateCountdown, 1000);
    }
    
    // Auto-refresh after countdown
    setTimeout(() => {
      window.location.reload();
    }, <%= retryAfter %> * 1000);
  </script>
</body>
</html>