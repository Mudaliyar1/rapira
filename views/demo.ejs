<!-- Custom CSS for Demo Page -->
<style>
  .demo-steps {
    position: relative;
  }

  .demo-step {
    display: flex;
    align-items: flex-start;
    position: relative;
  }

  .demo-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 40px;
    left: 20px;
    width: 2px;
    height: calc(100% - 20px);
    background: linear-gradient(to bottom, var(--primary), transparent);
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gradient-primary);
    color: white;
    font-weight: bold;
    margin-right: 15px;
    flex-shrink: 0;
    z-index: 1;
  }

  .step-content {
    flex-grow: 1;
  }

  .demo-button-container {
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(30, 30, 30, 0.8);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    min-height: 200px;
  }

  .demo-button-container .btn {
    transform: scale(1);
    transition: all 0.3s ease;
  }

  .demo-button-container .btn:hover {
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
  }

  /* Button animation */
  .demo-button-container .btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: 0.5s;
  }

  .demo-button-container .btn:hover::after {
    left: 100%;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.4);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(255, 255, 255, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
    }
  }

  .animate-pulse {
    animation: pulse 2s infinite;
  }

  .nav-pills .nav-link {
    color: white;
    border-radius: 0;
    padding: 10px 20px;
    transition: all 0.3s ease;
  }

  .nav-pills .nav-link:hover,
  .nav-pills .nav-link.active {
    background-color: var(--primary);
    color: white;
  }
</style>

<!-- Custom JavaScript for Demo Page -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          window.scrollTo({
            top: target.offsetTop - 80,
            behavior: 'smooth'
          });
        }
      });
    });

    // Active nav pill based on scroll position
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    window.addEventListener('scroll', function() {
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop - 100;
        const sectionHeight = section.offsetHeight;
        if (pageYOffset >= sectionTop && pageYOffset < sectionTop + sectionHeight) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });

    // No demo modal functionality needed anymore as we're using direct links
  });
</script>
