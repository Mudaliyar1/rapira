<!-- Enhanced JavaScript for Filter Toggle, Sorting and Wishlist -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterCollapse = document.getElementById('filterCollapse');
  const filterToggleChevron = document.getElementById('filterToggleChevron');
  const filterToggleText = document.getElementById('filterToggleText');
  const filterToggleBtn = document.getElementById('filterToggleBtn');

  // Ensure initial collapsed state is explicitly set
  if (filterCollapse && filterToggleChevron && filterToggleText) {
    filterCollapse.addEventListener('show.bs.collapse', function() {
      filterToggleChevron.classList.remove('bi-chevron-down');
      filterToggleChevron.classList.add('bi-chevron-up');
      filterToggleText.textContent = 'Hide Filters';
      if (filterToggleBtn) filterToggleBtn.setAttribute('aria-expanded', 'true');
    });

    filterCollapse.addEventListener('hide.bs.collapse', function() {
      filterToggleChevron.classList.remove('bi-chevron-up');
      filterToggleChevron.classList.add('bi-chevron-down');
      filterToggleText.textContent = 'Show Filters';
      if (filterToggleBtn) filterToggleBtn.setAttribute('aria-expanded', 'false');
    });
  }
});

// Handle sort change with query string preservation
function handleSortChange(sortValue) {
  const url = new URL(window.location.href);
  url.searchParams.set('sort', sortValue);
  url.searchParams.set('page', '1'); // reset to page 1 on sort change
  window.location.href = url.toString();
}

// Client-side wishlist toggle
function toggleWishlist(button, productId) {
  button.classList.toggle('active');
  const icon = button.querySelector('i');
  if (button.classList.contains('active')) {
    icon.classList.remove('bi-heart');
    icon.classList.add('bi-heart-fill');
  } else {
    icon.classList.remove('bi-heart-fill');
    icon.classList.add('bi-heart');
  }
}
</script>
