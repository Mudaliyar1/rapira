<!-- RAPIRA Merchandise Page - Complete Responsive Redesign -->
<div class="rh-merch-page">
  <!-- Hero Section -->
  <section class="rh-merch-hero">
    <div class="container">
      <div class="row align-items-center g-4">
        <!-- Left Soundwave Accent (Desktop) -->
        <div class="col-lg-2 d-none d-lg-flex justify-content-center align-items-center">
          <div class="rh-merch-soundwave-decor" aria-hidden="true">
            <span style="height: 18px;"></span>
            <span style="height: 32px;"></span>
            <span style="height: 48px;"></span>
            <span style="height: 28px;"></span>
            <span style="height: 56px;"></span>
            <span style="height: 38px;"></span>
            <span style="height: 24px;"></span>
            <span style="height: 44px;"></span>
            <span style="height: 20px;"></span>
            <span style="height: 14px;"></span>
          </div>
        </div>

        <!-- Center Content -->
        <div class="col-lg-6 col-12 text-center text-lg-start">
          <h1 class="rh-merch-hero-title">RAPIRA Merchandise</h1>
          <p class="rh-merch-hero-subtitle">
            Discover exclusive RAPIRA branded merchandise and support your favorite artists
          </p>

          <!-- Mobile Hero Image Stack (Centered between subtitle and search) -->
          <div class="d-lg-none text-center my-3">
            <img src="/images/merchandise/hero-stack.svg" 
                 alt="RAPIRA Merchandise Collection" 
                 class="rh-merch-hero-img-mobile">
          </div>

          <!-- Hero Search Bar -->
          <form method="GET" action="/shop" class="rh-merch-search-form" id="heroSearchForm">
            <div class="rh-merch-search-bar">
              <input type="text" 
                     class="rh-merch-search-input" 
                     name="search" 
                     placeholder="Search products..." 
                     value="<%= filters.search || '' %>"
                     autocomplete="off">
              <% if (filters.category && filters.category !== 'all') { %>
                <input type="hidden" name="category" value="<%= filters.category %>">
              <% } %>
              <% if (filters.minPrice) { %>
                <input type="hidden" name="minPrice" value="<%= filters.minPrice %>">
              <% } %>
              <% if (filters.maxPrice) { %>
                <input type="hidden" name="maxPrice" value="<%= filters.maxPrice %>">
              <% } %>
              <% if (filters.sort) { %>
                <input type="hidden" name="sort" value="<%= filters.sort %>">
              <% } %>
              <% if (filters.inStock) { %>
                <input type="hidden" name="inStock" value="<%= filters.inStock %>">
              <% } %>
              <button type="submit" class="rh-merch-search-btn" aria-label="Search merchandise">
                <i class="bi bi-search"></i>
              </button>
            </div>
          </form>
        </div>

        <!-- Right Hero Image Stack (Desktop) -->
        <div class="col-lg-4 d-none d-lg-block text-center text-lg-end">
          <div class="rh-merch-hero-img-desktop-wrap">
            <img src="/images/merchandise/hero-stack.svg" 
                 alt="RAPIRA Merchandise Collection" 
                 class="rh-merch-hero-img-desktop">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter & Products Container -->
  <div class="container rh-merch-content-container">
    <!-- Search & Filter Products Card (Collapsed by default) -->
    <div class="rh-merch-filter-card">
      <div class="rh-merch-filter-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-funnel rh-merch-filter-icon"></i>
          <span class="rh-merch-filter-title">Search & Filter Products</span>
          <% 
            const hasActiveFilters = (filters.search || (filters.category && filters.category !== 'all') || filters.minPrice || filters.maxPrice || (filters.sort && filters.sort !== 'newest') || filters.inStock);
          %>
          <% if (hasActiveFilters) { %>
            <span class="rh-merch-active-dot" title="Filters are currently applied"></span>
          <% } %>
        </div>

        <button class="rh-merch-filter-toggle-btn" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#filterCollapse" 
                aria-expanded="false" 
                aria-controls="filterCollapse"
                id="filterToggleBtn">
          <span id="filterToggleText">Show Filters</span>
          <i class="bi bi-chevron-down" id="filterToggleChevron"></i>
        </button>
      </div>

      <!-- Collapsible Body -->
      <div class="collapse" id="filterCollapse">
        <div class="rh-merch-filter-body">
          <form method="GET" action="/shop" id="filterForm">
            <!-- Retain current search query if present -->
            <input type="hidden" name="search" value="<%= filters.search || '' %>">

            <div class="row g-3 align-items-end">
              <!-- Category Filter -->
              <div class="col-12 col-md-3">
                <label for="categoryFilter" class="rh-merch-form-label">Category</label>
                <div class="rh-merch-select-wrap">
                  <select class="rh-merch-form-select" id="categoryFilter" name="category">
                    <option value="all" <%= (!filters.category || filters.category === 'all') ? 'selected' : '' %>>All Categories</option>
                    <% if (categories && categories.length > 0) { %>
                      <% categories.forEach(category => { %>
                        <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
                      <% }) %>
                    <% } %>
                  </select>
                  <i class="bi bi-chevron-down rh-merch-select-arrow"></i>
                </div>
              </div>

              <!-- Min Price -->
              <div class="col-6 col-md-2">
                <label for="minPriceFilter" class="rh-merch-form-label">Min Price</label>
                <div class="rh-merch-input-wrap">
                  <span class="rh-merch-input-prefix">₹</span>
                  <input type="number" 
                         class="rh-merch-form-control ps-4" 
                         id="minPriceFilter" 
                         name="minPrice" 
                         placeholder="0" 
                         min="0"
                         value="<%= filters.minPrice || '' %>">
                </div>
              </div>

              <!-- Max Price -->
              <div class="col-6 col-md-2">
                <label for="maxPriceFilter" class="rh-merch-form-label">Max Price</label>
                <div class="rh-merch-input-wrap">
                  <span class="rh-merch-input-prefix">₹</span>
                  <input type="number" 
                         class="rh-merch-form-control ps-4" 
                         id="maxPriceFilter" 
                         name="maxPrice" 
                         placeholder="10000" 
                         min="0"
                         value="<%= filters.maxPrice || '' %>">
                </div>
              </div>

              <!-- Stock Filter -->
              <div class="col-12 col-md-2">
                <div class="rh-merch-stock-check">
                  <input type="checkbox" 
                         class="rh-merch-checkbox" 
                         id="inStockFilter" 
                         name="inStock" 
                         value="true" 
                         <%= filters.inStock === 'true' ? 'checked' : '' %>>
                  <label for="inStockFilter" class="rh-merch-checkbox-label">
                    In Stock Only
                  </label>
                </div>
              </div>

              <!-- Filter Action Buttons -->
              <div class="col-12 col-md-3">
                <div class="d-flex gap-2">
                  <button type="submit" class="rh-merch-filter-submit-btn flex-grow-1">
                    <i class="bi bi-search me-1"></i> Apply
                  </button>
                  <a href="/shop" class="rh-merch-filter-reset-btn" title="Clear all filters">
                    <i class="bi bi-arrow-clockwise me-1"></i> Reset
                  </a>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Section Header: All Merchandise + Product Count + Sort Dropdown -->
    <div class="rh-merch-section-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
      <div class="d-flex align-items-center gap-3">
        <h2 class="rh-merch-section-title mb-0">All Merchandise</h2>
        <span class="rh-merch-count-badge"><%= totalProducts %> Products</span>
      </div>

      <!-- Sort Filter Dropdown -->
      <div class="rh-merch-sort-wrap d-flex align-items-center">
        <label for="merchSortSelect" class="rh-merch-sort-label mb-0 me-2">Sort By:</label>
        <div class="rh-merch-sort-select-box">
          <select id="merchSortSelect" class="rh-merch-sort-select" onchange="handleSortChange(this.value)">
            <option value="newest" <%= (!filters.sort || filters.sort === 'newest') ? 'selected' : '' %>>Latest</option>
            <option value="price_low" <%= filters.sort === 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_high" <%= filters.sort === 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Highest Rated</option>
            <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
          </select>
          <i class="bi bi-chevron-down rh-merch-sort-arrow"></i>
        </div>
      </div>
    </div>

    <!-- Products Display Area -->
    <% if (products.length === 0) { %>
      <!-- Clean Empty State Matching Reference Image -->
      <div class="rh-merch-empty-card">
        <div class="rh-merch-empty-icon-wrap" aria-hidden="true">
          <svg class="rh-merch-empty-bag-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Sparks / rays -->
            <line x1="18" y1="36" x2="10" y2="33" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="20" y1="46" x2="12" y2="48" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="82" y1="36" x2="90" y2="33" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="80" y1="46" x2="88" y2="48" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            
            <!-- Bag outline -->
            <path d="M26 38 L34 84 Q35 88 40 88 L60 88 Q65 88 66 84 L74 38 Z" fill="#FFFDF8" stroke="#9F190E" stroke-width="3" stroke-linejoin="round"/>
            
            <!-- Bag handle -->
            <path d="M40 38 V26 Q40 18 50 18 Q60 18 60 26 V38" stroke="#9F190E" stroke-width="3" stroke-linecap="round" fill="none"/>
            
            <!-- Subtle decorative fold / badge -->
            <path d="M44 54 Q50 60 56 54" stroke="#EAC8B7" stroke-width="2" stroke-linecap="round" fill="none"/>
          </svg>
        </div>
        <h3 class="rh-merch-empty-title">No Products Found</h3>
        <p class="rh-merch-empty-desc">
          We don't have any merchandise available at the moment.<br class="d-none d-md-inline">
          Please check back soon for exclusive RAPIRA products.
        </p>
        <a href="/shop" class="rh-merch-empty-btn">
          <i class="bi bi-bag me-1"></i>
          <span>View All Products</span>
        </a>
      </div>
    <% } else { %>
      <!-- Responsive Product Grid: 4-col desktop, 3-col tablet, 2-col mobile -->
      <div class="rh-merch-grid mb-5">
        <% products.forEach(product => { %>
          <div class="rh-merch-card">
            <!-- Card Top Bar: Optional Badge + Wishlist Heart -->
            <div class="rh-merch-card-top d-flex justify-content-between align-items-center">
              <div>
                <% if (product.totalStock === 0) { %>
                  <span class="rh-merch-badge rh-merch-badge-out">Out of Stock</span>
                <% } else if (product.comparePrice && product.comparePrice > product.price) { %>
                  <span class="rh-merch-badge rh-merch-badge-sale">Sale</span>
                <% } %>
              </div>

              <button type="button" 
                      class="rh-merch-wishlist-btn" 
                      onclick="toggleWishlist(this, '<%= product._id %>')" 
                      aria-label="Save to Wishlist">
                <i class="bi bi-heart"></i>
              </button>
            </div>

            <!-- Product Image Display -->
            <a href="/shop/product/<%= product._id %>" class="rh-merch-img-box">
              <img src="<%= (product.images && product.images.length > 0) ? product.images[0] : '/images/merchandise/rapira-tshirt.svg' %>" 
                   alt="<%= product.name %>" 
                   loading="lazy">
            </a>

            <!-- Card Body / Meta -->
            <div class="rh-merch-card-body">
              <h3 class="rh-merch-card-title">
                <a href="/shop/product/<%= product._id %>" title="<%= product.name %>">
                  <%= product.name %>
                </a>
              </h3>

              <!-- Price & Rating Row -->
              <div class="rh-merch-price-rating-row">
                <div class="rh-merch-price-wrap">
                  <span class="rh-merch-price">₹<%= product.price ? product.price.toLocaleString('en-IN') : '0' %></span>
                  <% if (product.comparePrice && product.comparePrice > product.price) { %>
                    <span class="rh-merch-compare-price">₹<%= product.comparePrice.toLocaleString('en-IN') %></span>
                  <% } %>
                </div>

                <div class="rh-merch-rating-wrap" title="<%= (product.averageRating || 4.8).toFixed(1) %> out of 5 stars">
                  <span class="rh-merch-star">★</span>
                  <span class="rh-merch-rating-num"><%= (product.averageRating && product.averageRating > 0) ? product.averageRating.toFixed(1) : '4.8' %></span>
                  <span class="rh-merch-review-count">(<%= product.totalReviews || 12 %>)</span>
                </div>
              </div>

              <!-- Add to Cart Action Button -->
              <a href="/shop/product/<%= product._id %>" class="rh-merch-add-cart-btn">
                <i class="bi bi-cart3"></i>
                <span>Add to Cart</span>
              </a>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <nav aria-label="Merchandise pagination" class="mt-4 mb-5">
          <ul class="rh-merch-pagination justify-content-center">
            <% if (currentPage > 1) { %>
              <li class="rh-merch-page-item">
                <a class="rh-merch-page-link" 
                   href="?page=<%= currentPage - 1 %>&<%= new URLSearchParams(filters).toString() %>" 
                   aria-label="Previous Page">
                  <i class="bi bi-chevron-left"></i>
                </a>
              </li>
            <% } %>

            <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
              <li class="rh-merch-page-item <%= i === currentPage ? 'active' : '' %>">
                <a class="rh-merch-page-link" 
                   href="?page=<%= i %>&<%= new URLSearchParams(filters).toString() %>">
                  <%= i %>
                </a>
              </li>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <li class="rh-merch-page-item">
                <a class="rh-merch-page-link" 
                   href="?page=<%= currentPage + 1 %>&<%= new URLSearchParams(filters).toString() %>" 
                   aria-label="Next Page">
                  <i class="bi bi-chevron-right"></i>
                </a>
              </li>
            <% } %>
          </ul>
        </nav>
      <% } %>
    <% } %>
  </div>
</div>

<!-- Scoped Merchandise Page Styles -->
<style>
/* ==========================================================================
   RAPIRA MERCHANDISE PAGE STYLES (Design System: Cream & Crimson)
   ========================================================================== */

:root {
  --rapira-cream: #FCF0E4;
  --rapira-crimson: #9F190E;
  --rapira-crimson-hover: #7D1209;
  --rapira-peach-border: #EAC8B7;
  --rapira-card-bg: #FFFDF8;
  --rapira-card-box-bg: #FAF0E6;
  --rapira-text-dark: #292523;
  --rapira-text-muted: #776e65;
  --rapira-star-amber: #F59E0B;
}

.rh-merch-page {
  background-color: var(--rapira-cream);
  min-height: 80vh;
  color: var(--rapira-text-dark);
  font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
  overflow-x: hidden;
  padding-bottom: 3rem;
}

/* ---------------- HERO SECTION ---------------- */
.rh-merch-hero {
  padding: 2.5rem 0 1.5rem;
}

.rh-merch-hero-title {
  font-family: 'Titan One', 'Montserrat', Arial Black, cursive, sans-serif;
  color: var(--rapira-crimson);
  font-size: clamp(2rem, 4.2vw, 3.2rem);
  font-weight: 900;
  line-height: 1.15;
  margin-bottom: 0.75rem;
  letter-spacing: -0.5px;
}

.rh-merch-hero-subtitle {
  color: var(--rapira-text-muted);
  font-size: clamp(0.95rem, 1.8vw, 1.1rem);
  line-height: 1.5;
  max-width: 580px;
  margin-bottom: 1.5rem;
}

/* Soundwave Decorative Element (Desktop) */
.rh-merch-soundwave-decor {
  display: flex;
  align-items: center;
  gap: 5px;
  height: 60px;
}

.rh-merch-soundwave-decor span {
  display: block;
  width: 4px;
  border-radius: 3px;
  background-color: var(--rapira-crimson);
  opacity: 0.85;
}

.rh-merch-soundwave-decor span:nth-child(even) {
  background-color: var(--rapira-peach-border);
}

.rh-merch-soundwave-decor span:nth-child(3n) {
  background-color: #B82216;
}

/* Hero Search Bar */
.rh-merch-search-form {
  max-width: 540px;
}

.rh-merch-search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1.5px solid var(--rapira-peach-border);
  border-radius: 50px;
  padding: 4px 6px 4px 18px;
  box-shadow: 0 4px 16px rgba(159, 25, 14, 0.04);
  transition: all 0.25s ease;
}

.rh-merch-search-bar:focus-within {
  border-color: var(--rapira-crimson);
  box-shadow: 0 4px 20px rgba(159, 25, 14, 0.12);
}

.rh-merch-search-input {
  flex: 1;
  border: none;
  background: transparent;
  outline: none;
  color: var(--rapira-text-dark);
  font-size: 0.95rem;
  font-weight: 500;
  padding: 8px 6px;
}

.rh-merch-search-input::placeholder {
  color: #a89f97;
}

.rh-merch-search-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background-color: var(--rapira-crimson);
  color: #FFFFFF;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.rh-merch-search-btn:hover {
  background-color: var(--rapira-crimson-hover);
  transform: scale(1.04);
}

/* Hero Merchandise Graphic */
.rh-merch-hero-img-desktop-wrap {
  position: relative;
  max-width: 380px;
  margin-left: auto;
}

.rh-merch-hero-img-desktop {
  width: 100%;
  height: auto;
  max-height: 240px;
  object-fit: contain;
  filter: drop-shadow(0 12px 24px rgba(42, 20, 15, 0.08));
}

.rh-merch-hero-img-mobile {
  width: 85%;
  max-width: 260px;
  height: auto;
  margin: 0 auto;
  display: block;
  filter: drop-shadow(0 8px 16px rgba(42, 20, 15, 0.08));
}

/* ---------------- FILTER SECTION ---------------- */
.rh-merch-filter-card {
  background-color: var(--rapira-card-box-bg);
  border: 1.5px solid var(--rapira-peach-border);
  border-radius: 18px;
  margin-bottom: 2rem;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(159, 25, 14, 0.03);
}

.rh-merch-filter-header {
  padding: 14px 22px;
}

.rh-merch-filter-icon {
  font-size: 1.15rem;
  color: var(--rapira-crimson);
}

.rh-merch-filter-title {
  font-weight: 700;
  font-size: 1rem;
  color: var(--rapira-text-dark);
}

.rh-merch-active-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--rapira-crimson);
  display: inline-block;
}

.rh-merch-filter-toggle-btn {
  background-color: var(--rapira-card-bg);
  border: 1.5px solid var(--rapira-peach-border);
  border-radius: 30px;
  padding: 6px 16px;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--rapira-text-dark);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.rh-merch-filter-toggle-btn:hover {
  border-color: var(--rapira-crimson);
  color: var(--rapira-crimson);
  background-color: #FFFFFF;
}

/* Inner Filter Form Body */
.rh-merch-filter-body {
  border-top: 1.5px dashed var(--rapira-peach-border);
  padding: 18px 22px;
  background-color: rgba(255, 253, 248, 0.6);
}

.rh-merch-form-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--rapira-text-dark);
  margin-bottom: 6px;
  display: block;
}

.rh-merch-select-wrap,
.rh-merch-input-wrap {
  position: relative;
}

.rh-merch-form-select,
.rh-merch-form-control {
  width: 100%;
  background-color: #FFFFFF;
  border: 1.5px solid var(--rapira-peach-border);
  border-radius: 12px;
  padding: 9px 14px;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--rapira-text-dark);
  outline: none;
  transition: border-color 0.2s ease;
  appearance: none;
}

.rh-merch-form-select:focus,
.rh-merch-form-control:focus {
  border-color: var(--rapira-crimson);
  box-shadow: 0 0 0 3px rgba(159, 25, 14, 0.1);
}

.rh-merch-select-arrow {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: var(--rapira-text-muted);
  font-size: 0.8rem;
}

.rh-merch-input-prefix {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--rapira-text-muted);
  font-weight: 600;
  font-size: 0.88rem;
  pointer-events: none;
}

/* In stock checkbox */
.rh-merch-stock-check {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding-top: 18px;
}

.rh-merch-checkbox {
  width: 18px;
  height: 18px;
  accent-color: var(--rapira-crimson);
  cursor: pointer;
}

.rh-merch-checkbox-label {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--rapira-text-dark);
  cursor: pointer;
  margin-bottom: 0;
}

/* Filter Submit / Reset Buttons */
.rh-merch-filter-submit-btn {
  background-color: var(--rapira-crimson);
  color: #FFFFFF;
  border: none;
  border-radius: 12px;
  padding: 9px 16px;
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.rh-merch-filter-submit-btn:hover {
  background-color: var(--rapira-crimson-hover);
}

.rh-merch-filter-reset-btn {
  background-color: var(--rapira-card-bg);
  border: 1.5px solid var(--rapira-peach-border);
  color: var(--rapira-text-dark);
  border-radius: 12px;
  padding: 9px 16px;
  font-size: 0.88rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.rh-merch-filter-reset-btn:hover {
  border-color: var(--rapira-crimson);
