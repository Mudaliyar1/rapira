<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Processing Payment - RAPIRA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .payment-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            max-width: 500px;
            width: 100%;
        }
        .spinner-border {
            width: 3rem;
            height: 3rem;
        }
        .btn-gradient-purple {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
        }
        .btn-gradient-purple:hover {
            background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
            color: white;
        }
    </style>
</head>
<body>
    <div class="payment-card p-5 text-center">
        <div class="mb-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        
        <h3 class="mb-3">Processing Your Order</h3>
        <p class="text-muted mb-4">Please wait while we prepare your payment...</p>
        
        <!-- Order Summary -->
        <div class="bg-light p-3 rounded mb-4">
            <h6 class="mb-2"><%= product.name %></h6>
            <small class="text-muted">
                Size: <%= selectedSize %> | Quantity: <%= selectedQuantity %><br>
                Total: ₹<%= totalAmount %>
            </small>
        </div>
        
        <div class="d-grid gap-2">
            <button id="openPaymentBtn" class="btn btn-gradient-purple btn-lg">
                <i class="bi bi-credit-card me-2"></i>Open Payment Gateway
            </button>
            <a href="/shop/product/<%= product._id %>" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Cancel & Go Back
            </a>
        </div>
    </div>

    <!-- Razorpay Script -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        // Auto-open Razorpay on page load (same as subscription)
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Payment redirect page loaded');
            
            // Auto-open payment after 2 seconds
            setTimeout(function() {
                openPayment();
            }, 2000);
            
            // Also add click handler for manual trigger
            document.getElementById('openPaymentBtn').addEventListener('click', openPayment);
        });

        function openPayment() {
            console.log('Opening Razorpay payment gateway');
            
            // Razorpay options (exact copy from subscription)
            var options = {
                key: '<%= key %>',
                amount: <%= order.amount %>,
                currency: '<%= order.currency %>',
                name: 'RAPIRA',
                description: '<%= product.name %> - Buy Now',
                order_id: '<%= order.id %>',
                handler: function(response) {
                    console.log('Payment successful:', response);
                    
                    // Create hidden form for payment verification (same as subscription)
                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/shop/verify-buy-now-payment';

                    var fields = {
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_signature: response.razorpay_signature,
                        productId: '<%= product._id %>',
                        size: '<%= selectedSize %>',
                        quantity: '<%= selectedQuantity %>'
                    };

                    for (var key in fields) {
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = key;
                        input.value = fields[key];
                        form.appendChild(input);
                    }

                    document.body.appendChild(form);
                    form.submit();
                },
                prefill: {
                    name: '<%= currentUser.name %>',
                    email: '<%= currentUser.email %>'
                },
                theme: {
                    color: '#6366f1'
                },
                modal: {
                    ondismiss: function() {
                        console.log('Payment cancelled by user');
                        
                        // Show cancellation message
                        document.querySelector('.payment-card').innerHTML = `
                            <div class="text-center">
                                <i class="bi bi-x-circle text-danger" style="font-size: 3rem;"></i>
                                <h4 class="mt-3 mb-3">Payment Cancelled</h4>
                                <p class="text-muted mb-4">Your payment was cancelled. No charges have been made.</p>
                                <div class="d-grid gap-2">
                                    <button onclick="openPayment()" class="btn btn-gradient-purple">
                                        <i class="bi bi-arrow-clockwise me-2"></i>Try Again
                                    </button>
                                    <a href="/shop/product/<%= product._id %>" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left me-2"></i>Back to Product
                                    </a>
                                </div>
                            </div>
                        `;
                    }
                }
            };

            // Create Razorpay instance and open checkout
            var rzp = new Razorpay(options);
            rzp.open();
        }
    </script>
</body>
</html>
