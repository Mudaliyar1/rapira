<!-- RAPIRA Cart Page - Complete Responsive Redesign -->
<div class="rh-cart-page py-4 py-md-5">
  <div class="container rh-cart-container">
    
    <% if (!cart || !cart.items || cart.items.length === 0) { %>
      <!-- ================= EMPTY CART STATE ================= -->
      <div class="rh-cart-empty-card">
        <div class="rh-cart-empty-icon-wrap" aria-hidden="true">
          <svg class="rh-cart-empty-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Sparkles / energy rays -->
            <line x1="18" y1="36" x2="10" y2="33" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="20" y1="46" x2="12" y2="48" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="82" y1="36" x2="90" y2="33" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="80" y1="46" x2="88" y2="48" stroke="#9F190E" stroke-width="2.5" stroke-linecap="round"/>
            
            <!-- Cart basket -->
            <path d="M22 28 H30 L38 66 H74 L82 36 H33" stroke="#9F190E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            
            <!-- Wheels -->
            <circle cx="42" cy="76" r="6" stroke="#9F190E" stroke-width="2.5" fill="#FFFDF8"/>
            <circle cx="70" cy="76" r="6" stroke="#9F190E" stroke-width="2.5" fill="#FFFDF8"/>

            <!-- Musical soundwave motif inside cart -->
            <g transform="translate(44, 40)">
              <rect x="0" y="6" width="2.5" height="12" rx="1.2" fill="#EAC8B7"/>
              <rect x="5" y="2" width="2.5" height="18" rx="1.2" fill="#9F190E"/>
              <rect x="10" y="0" width="2.5" height="22" rx="1.2" fill="#B82216"/>
              <rect x="15" y="3" width="2.5" height="16" rx="1.2" fill="#9F190E"/>
              <rect x="20" y="7" width="2.5" height="10" rx="1.2" fill="#EAC8B7"/>
            </g>
          </svg>
        </div>

        <h1 class="rh-cart-empty-title">Your Cart is Empty</h1>
        <p class="rh-cart-empty-desc">
          You haven't added any merchandise to your cart yet.<br class="d-none d-md-inline">
          Explore RAPIRA merchandise and support your favorite artists.
        </p>
        
        <a href="/shop" class="rh-cart-empty-btn">
          <i class="bi bi-bag me-2"></i>
          <span>Explore Merchandise</span>
        </a>
      </div>

    <% } else { %>
      <!-- ================= POPULATED CART STATE ================= -->
      <!-- Cart Header -->
      <div class="rh-cart-header mb-4">
        <h1 class="rh-cart-title mb-0">
          My Cart 
          <span class="rh-cart-count-badge">(<%= cart.totalItems %> <%= cart.totalItems === 1 ? 'Item' : 'Items' %>)</span>
        </h1>
      </div>

      <div class="row g-4 align-items-start">
        <!-- Left: Cart Items List -->
        <div class="col-lg-8">
          <div class="rh-cart-items-card">
            <% cart.items.forEach((item, index) => { %>
              <div class="rh-cart-item-row <%= index === cart.items.length - 1 ? 'rh-cart-item-row-last' : '' %>" 
                   data-product-id="<%= item.product ? (item.product._id || item.product) : '' %>" 
                   data-size="<%= item.size %>">
                
                <!-- Desktop & Tablet Grid Row -->
                <div class="rh-cart-item-desktop d-none d-md-flex align-items-center">
                  <!-- Product Image -->
                  <a href="/shop/product/<%= item.product ? (item.product._id || item.product) : '' %>" class="rh-cart-item-img-box">
                    <img src="<%= (item.product && item.product.images && item.product.images.length > 0) ? item.product.images[0] : '/images/merchandise/rapira-tshirt.svg' %>" 
                         alt="<%= item.product ? item.product.name : 'Product' %>">
                  </a>

                  <!-- Product Name & Size -->
                  <div class="rh-cart-item-info flex-grow-1 ps-3 pe-2">
                    <h3 class="rh-cart-item-name mb-1">
                      <a href="/shop/product/<%= item.product ? (item.product._id || item.product) : '' %>">
                        <%= item.product ? item.product.name : 'RAPIRA Merchandise' %>
                      </a>
                    </h3>
                    <p class="rh-cart-item-meta mb-0">Size: <%= item.size %></p>
                  </div>

                  <!-- Unit Price -->
                  <div class="rh-cart-item-price-col text-end px-3">
                    <span class="rh-cart-item-unit-price">₹<%= item.price ? item.price.toLocaleString('en-IN') : '0' %></span>
                    <% if (item.product && item.product.comparePrice && item.product.comparePrice > item.price) { %>
                      <div class="rh-cart-item-compare-price">₹<%= item.product.comparePrice.toLocaleString('en-IN') %></div>
                    <% } %>
                  </div>

                  <!-- Quantity Controls Pill -->
                  <div class="rh-cart-qty-pill mx-2">
                    <button type="button" 
                            class="rh-cart-qty-btn" 
                            onclick="updateQuantity('<%= item.product ? (item.product._id || item.product) : '' %>', '<%= item.size %>', <%= item.quantity - 1 %>)"
                            aria-label="Decrease quantity">
                      <i class="bi bi-dash"></i>
                    </button>
                    <span class="rh-cart-qty-val"><%= item.quantity %></span>
                    <button type="button" 
                            class="rh-cart-qty-btn" 
                            onclick="updateQuantity('<%= item.product ? (item.product._id || item.product) : '' %>', '<%= item.size %>', <%= item.quantity + 1 %>)"
                            aria-label="Increase quantity">
                      <i class="bi bi-plus"></i>
                    </button>
                  </div>

                  <!-- Line Total -->
                  <div class="rh-cart-item-total-col text-end ps-3 pe-2">
                    <span class="rh-cart-item-line-total">₹<%= ((item.price || 0) * (item.quantity || 1)).toLocaleString('en-IN') %></span>
                  </div>

                  <!-- Remove Action -->
                  <div class="rh-cart-item-remove-col ps-2">
                    <button type="button" 
                            class="rh-cart-remove-btn" 
                            onclick="removeItem('<%= item.product ? (item.product._id || item.product) : '' %>', '<%= item.size %>')"
                            title="Remove item" 
                            aria-label="Remove <%= item.product ? item.product.name : 'item' %>">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </div>
                </div>

                <!-- Mobile Layout (<= 767px) -->
                <div class="rh-cart-item-mobile d-flex flex-column d-md-none">
                  <div class="d-flex align-items-center mb-2">
                    <a href="/shop/product/<%= item.product ? (item.product._id || item.product) : '' %>" class="rh-cart-item-img-box-sm flex-shrink-0">
                      <img src="<%= (item.product && item.product.images && item.product.images.length > 0) ? item.product.images[0] : '/images/merchandise/rapira-tshirt.svg' %>" 
                           alt="<%= item.product ? item.product.name : 'Product' %>">
                    </a>
                    <div class="ps-3 flex-grow-1">
                      <h3 class="rh-cart-item-name-sm mb-1">
                        <a href="/shop/product/<%= item.product ? (item.product._id || item.product) : '' %>">
                          <%= item.product ? item.product.name : 'RAPIRA Merchandise' %>
                        </a>
                      </h3>
                      <p class="rh-cart-item-meta mb-0">Size: <%= item.size %></p>
                    </div>
                  </div>

                  <!-- Bottom Row: Price, Quantity Pill, Remove Action -->
                  <div class="d-flex justify-content-between align-items-center pt-2">
                    <div class="rh-cart-mobile-price-wrap">
                      <span class="rh-cart-item-unit-price">₹<%= item.price ? item.price.toLocaleString('en-IN') : '0' %></span>
                      <% if (item.product && item.product.comparePrice && item.product.comparePrice > item.price) { %>
                        <span class="rh-cart-item-compare-price ms-1">₹<%= item.product.comparePrice.toLocaleString('en-IN') %></span>
                      <% } %>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                      <!-- Quantity Controls -->
                      <div class="rh-cart-qty-pill">
                        <button type="button" 
                                class="rh-cart-qty-btn" 
                                onclick="updateQuantity('<%= item.product ? (item.product._id || item.product) : '' %>', '<%= item.size %>', <%= item.quantity - 1 %>)"
                                aria-label="Decrease quantity">
                          <i class="bi bi-dash"></i>
                        </button>
                        <span class="rh-cart-qty-val"><%= item.quantity %></span>
                        <button type="button" 
                                class="rh-cart-qty-btn" 
                                onclick="updateQuantity('<%= item.product ? (item.product._id || item.product) : '' %>', '<%= item.size %>', <%= item.quantity + 1 %>)"
                                aria-label="Increase quantity">
                          <i class="bi bi-plus"></i>
                        </button>
                      </div>

                      <!-- Remove Action -->
                      <button type="button" 
                              class="rh-cart-remove-btn" 
                              onclick="removeItem('<%= item.product ? (item.product._id || item.product) : '' %>', '<%= item.size %>')"
                              title="Remove item" 
                              aria-label="Remove <%= item.product ? item.product.name : 'item' %>">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  </div>
                </div>

              </div>
            <% }) %>

            <!-- Continue Shopping Link -->
            <div class="rh-cart-continue-wrap pt-3 mt-2">
              <a href="/shop" class="rh-cart-continue-link">
                <i class="bi bi-chevron-left me-1"></i>
                <span>Continue Shopping</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Order Summary Card -->
        <div class="col-lg-4">
          <div class="rh-cart-summary-card">
            <h2 class="rh-cart-summary-title mb-3">Order Summary</h2>

            <!-- Subtotal -->
            <div class="rh-cart-summary-row d-flex justify-content-between align-items-center mb-2">
              <span class="rh-cart-summary-label">Subtotal (<%= cart.totalItems %> <%= cart.totalItems === 1 ? 'item' : 'items' %>)</span>
              <span class="rh-cart-summary-value">₹<%= (cart.totalAmount || 0).toLocaleString('en-IN') %></span>
            </div>

            <!-- Dynamic Discount Calculation if comparePrice exists -->
            <% 
              let totalSavings = 0;
              if (cart.items && cart.items.length > 0) {
                cart.items.forEach(it => {
                  if (it.product && it.product.comparePrice && it.product.comparePrice > it.price) {
                    totalSavings += (it.product.comparePrice - it.price) * it.quantity;
                  }
                });
              }
            %>
            <% if (totalSavings > 0) { %>
              <div class="rh-cart-summary-row rh-cart-discount-row d-flex justify-content-between align-items-center mb-2">
                <span class="rh-cart-summary-label">Discount</span>
                <span class="rh-cart-discount-value">-₹<%= totalSavings.toLocaleString('en-IN') %></span>
              </div>
            <% } %>

            <!-- Shipping -->
            <div class="rh-cart-summary-row d-flex justify-content-between align-items-center mb-3">
              <span class="rh-cart-summary-label">Shipping</span>
              <span class="rh-cart-shipping-value">₹0</span>
            </div>

            <hr class="rh-cart-summary-divider my-3">

            <!-- Total Amount -->
            <div class="rh-cart-summary-row rh-cart-total-row d-flex justify-content-between align-items-center mb-4">
              <span class="rh-cart-total-label">Total Amount</span>
              <span class="rh-cart-total-value">₹<%= (cart.finalAmount || cart.totalAmount || 0).toLocaleString('en-IN') %></span>
            </div>

            <!-- Proceed to Checkout Button -->
            <a href="/shop/checkout" class="rh-cart-checkout-btn w-100">
              <span>Proceed to Checkout</span>
              <i class="bi bi-arrow-right ms-2"></i>
            </a>

            <!-- Security Assurance Notice -->
            <div class="text-center mt-3">
              <small class="rh-cart-security-note">
                <i class="bi bi-shield-check me-1"></i>
                Secure checkout with 256-bit SSL encryption
              </small>
            </div>
          </div>
        </div>
      </div>
    <% } %>

  </div>
</div>

<!-- ================= SCOPED CART STYLES ================= -->
<style>
/* ---------------- BASE VARIABLES ---------------- */
:root {
  --rapira-cream: #FCF0E4;
  --rapira-crimson: #9F190E;
  --rapira-crimson-hover: #7D1209;
  --rapira-peach-border: #EAC8B7;
  --rapira-card-bg: #FFFDF8;
  --rapira-box-bg: #FAF0E6;
  --rapira-text-dark: #292523;
  --rapira-text-muted: #776e65;
  --rapira-discount-green: #16A34A;
}

.rh-cart-page {
  background-color: var(--rapira-cream);
  min-height: 80vh;
  color: var(--rapira-text-dark);
  font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
  overflow-x: hidden;
}

.rh-cart-container {
  max-width: 1140px;
}

/* ---------------- HEADER ---------------- */
.rh-cart-title {
  font-family: 'Titan One', 'Montserrat', Arial Black, cursive, sans-serif;
  color: var(--rapira-crimson);
  font-size: clamp(1.8rem, 3.5vw, 2.4rem);
  font-weight: 900;
  letter-spacing: -0.5px;
}

.rh-cart-count-badge {
  font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--rapira-text-muted);
  margin-left: 6px;
}

/* ---------------- EMPTY STATE ---------------- */
.rh-cart-empty-card {
  max-width: 620px;
  margin: 3rem auto 4rem;
  background-color: var(--rapira-card-bg);
  border: 1.5px solid var(--rapira-peach-border);
  border-radius: 24px;
  padding: 3.5rem 2rem;
  text-align: center;
  box-shadow: 0 6px 24px rgba(159, 25, 14, 0.04);
}

.rh-cart-empty-icon-wrap {
  width: 90px;
  height: 90px;
  margin: 0 auto 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rh-cart-empty-svg {
  width: 85px;
  height: 85px;
}

.rh-cart-empty-title {
  font-family: 'Titan One', 'Montserrat', Arial Black, cursive, sans-serif;
  color: var(--rapira-crimson);
  font-size: 1.85rem;
  font-weight: 900;
  margin-bottom: 0.75rem;
}

.rh-cart-empty-desc {
  color: var(--rapira-text-muted);
  font-size: 0.95rem;
  line-height: 1.6;
  max-width: 440px;
  margin: 0 auto 1.85rem;
}

.rh-cart-empty-btn {
  background-color: var(--rapira-crimson);
  color: #FFFFFF;
  border-radius: 30px;
  padding: 12px 30px;
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: all 0.2s ease;
  box-shadow: 0 4px 14px rgba(159, 25, 14, 0.15);
}

.rh-cart-empty-btn:hover {
  background-color: var(--rapira-crimson-hover);
  color: #FFFFFF;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(159, 25, 14, 0.25);
}

/* ---------------- ITEMS CARD (POPULATED) ---------------- */
.rh-cart-items-card {
  background-color: var(--rapira-card-bg);
  border: 1.5px solid var(--rapira-peach-border);
  border-radius: 20px;
  padding: 24px 28px;
  box-shadow: 0 4px 16px rgba(159, 25, 14, 0.03);
}

.rh-cart-item-row {
  border-bottom: 1px solid var(--rapira-peach-border);
  padding: 18px 0;
}

.rh-cart-item-row:first-child {
  padding-top: 6px;
}

.rh-cart-item-row-last {
  border-bottom: 1px solid var(--rapira-peach-border);
  margin-bottom: 8px;
}

/* Product image container */
.rh-cart-item-img-box {
  width: 76px;
  height: 76px;
  background-color: var(--rapira-box-bg);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-decoration: none;
  flex-shrink: 0;
  border: 1px solid rgba(234, 200, 183, 0.5);
}

.rh-cart-item-img-box img {
  width: 80%;
  height: 80%;
  object-fit: contain;
  transition: transform 0.2s ease;
}

.rh-cart-item-img-box:hover img {
  transform: scale(1.08);
}

/* Product name & meta */
.rh-cart-item-name {
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.35;
}

.rh-cart-item-name a {
  color: var(--rapira-text-dark);
  text-decoration: none;
  transition: color 0.2s ease;
}

.rh-cart-item-name a:hover {
  color: var(--rapira-crimson);
}

.rh-cart-item-meta {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--rapira-text-muted);
}

/* Price columns */
.rh-cart-item-unit-price {
  font-size: 1rem;
  font-weight: 700;
  color: var(--rapira-text-dark);
}

.rh-cart-item-compare-price {
  font-size: 0.82rem;
  color: var(--rapira-text-muted);
  text-decoration: line-through;
}

.rh-cart-item-line-total {
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--rapira-text-dark);
  min-width: 60px;
  display: inline-block;
}

/* Quantity selector pill [ - 1 + ] */
.rh-cart-qty-pill {
  display: inline-flex;
  align-items: center;
  background-color: #FFFFFF;
  border: 1.5px solid var(--rapira-peach-border);
  border-radius: 30px;
  padding: 3px 6px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
}

.rh-cart-qty-btn {
  background: transparent;
  border: none;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--rapira-text-dark);
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  padding: 0;
}

.rh-cart-qty-btn:hover {
  background-color: var(--rapira-box-bg);
  color: var(--rapira-crimson);
}

.rh-cart-qty-val {
  min-width: 28px;
  text-align: center;
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--rapira-text-dark);
  user-select: none;
}

/* Remove Trash button */
.rh-cart-remove-btn {
  background: transparent;
  border: none;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--rapira-text-muted);
  font-size: 1.05rem;
  cursor: pointer;
  transition: all 0.2s ease;
  padding: 0;
}

.rh-cart-remove-btn:hover {
  color: var(--rapira-crimson);
  background-color: #FEE2E2;
}

/* Continue Shopping Link */
.rh-cart-continue-link {
  color: var(--rapira-crimson);
  font-weight: 700;
  font-size: 0.92rem;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: all 0.2s ease;
}

.rh-cart-continue-link:hover {
  color: var(--rapira-crimson-hover);
  text-decoration: underline;
  transform: translateX(-2px);
}

/* ---------------- ORDER SUMMARY CARD ---------------- */
.rh-cart-summary-card {
  background-color: var(--rapira-card-bg);
  border: 1.5px solid var(--rapira-peach-border);
  border-radius: 20px;
  padding: 24px 26px;
  box-shadow: 0 4px 16px rgba(159, 25, 14, 0.03);
  position: sticky;
  top: 96px;
}

.rh-cart-summary-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--rapira-text-dark);
}

.rh-cart-summary-label {
  font-size: 0.9rem;
  color: var(--rapira-text-muted);
  font-weight: 500;
}

.rh-cart-summary-value {
  font-size: 0.95rem;
  color: var(--rapira-text-dark);
  font-weight: 700;
}

.rh-cart-discount-value {
  font-size: 0.95rem;
  color: var(--rapira-discount-green);
  font-weight: 700;
}

.rh-cart-shipping-value {
  font-size: 0.95rem;
  color: var(--rapira-text-dark);
  font-weight: 700;
}

.rh-cart-summary-divider {
  border-color: var(--rapira-peach-border);
  opacity: 0.8;
}

.rh-cart-total-label {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--rapira-text-dark);
}

.rh-cart-total-value {
  font-size: 1.3rem;
  font-weight: 900;
  color: var(--rapira-text-dark);
}

.rh-cart-checkout-btn {
  background-color: var(--rapira-crimson);
  color: #FFFFFF;
  border-radius: 12px;
  padding: 13px 20px;
  font-size: 0.98rem;
  font-weight: 700;
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.2s ease;
  box-shadow: 0 4px 12px rgba(159, 25, 14, 0.18);
}

.rh-cart-checkout-btn:hover {
  background-color: var(--rapira-crimson-hover);
  color: #FFFFFF;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(159, 25, 14, 0.25);
}

.rh-cart-security-note {
  color: var(--rapira-text-muted);
  font-size: 0.78rem;
  font-weight: 500;
}

/* ---------------- MOBILE RESPONSIVE ADAPTATIONS ---------------- */
@media (max-width: 767px) {
  .rh-cart-title {
    font-size: 1.65rem;
  }

  .rh-cart-count-badge {
    font-size: 0.95rem;
  }

  .rh-cart-items-card {
    padding: 16px 18px;
    border-radius: 16px;
  }

  .rh-cart-item-row {
    padding: 14px 0;
  }

  .rh-cart-item-img-box-sm {
    width: 60px;
    height: 60px;
    background-color: var(--rapira-box-bg);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid rgba(234, 200, 183, 0.5);
  }

  .rh-cart-item-img-box-sm img {
    width: 82%;
    height: 82%;
    object-fit: contain;
  }

  .rh-cart-item-name-sm {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .rh-cart-item-name-sm a {
    color: var(--rapira-text-dark);
    text-decoration: none;
  }

  .rh-cart-qty-pill {
    padding: 2px 4px;
  }

  .rh-cart-qty-btn {
    width: 32px;
    height: 32px;
  }

  .rh-cart-summary-card {
    position: static;
    padding: 18px 20px;
    border-radius: 16px;
  }

  .rh-cart-empty-card {
    padding: 2.5rem 1.25rem;
    border-radius: 18px;
    margin: 2rem auto;
  }

  .rh-cart-empty-title {
    font-size: 1.5rem;
  }

  .rh-cart-empty-desc {
    font-size: 0.88rem;
  }
}
</style>

<!-- ================= CART JAVASCRIPT ================= -->
<script>
async function updateQuantity(productId, size, newQuantity) {
  if (newQuantity < 1) {
    if (confirm('Remove this item from your cart?')) {
      removeItem(productId, size);
    }
    return;
  }

  try {
    const response = await fetch('/shop/cart/update', {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        productId: productId,
        size: size,
        quantity: newQuantity
      })
    });

    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert(result.message || 'Error updating cart');
    }
  } catch (error) {
    console.error('Update quantity error:', error);
    alert('Error updating cart');
  }
}

async function removeItem(productId, size) {
  if (!confirm('Are you sure you want to remove this item from your cart?')) {
    return;
  }

  try {
    const response = await fetch('/shop/cart/remove', {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        productId: productId,
        size: size
      })
    });

    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert(result.message || 'Error removing item');
    }
  } catch (error) {
    console.error('Remove item error:', error);
    alert('Error removing item');
  }
}
</script>
