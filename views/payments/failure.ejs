<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card text-center">
        <div class="card-body p-5">
          <div class="mb-4">
            <div class="bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 100px; height: 100px;">
              <i class="bi bi-x-lg" style="font-size: 3rem;"></i>
            </div>
            <h2 class="fw-bold">Payment Failed</h2>
            <p class="text-muted mb-0">We couldn't process your payment. No charges have been made.</p>
          </div>
          
          <div class="alert alert-danger mb-4">
            <p class="mb-0">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              There was an issue with your payment. This could be due to insufficient funds, incorrect card details, or a temporary issue with the payment gateway.
            </p>
          </div>
          
          <p class="mb-4">Please try again or use a different payment method.</p>
          
          <div class="d-flex justify-content-center gap-3">
            <a href="javascript:history.back()" class="btn btn-primary px-4">
              <i class="bi bi-arrow-counterclockwise me-1"></i> Try Again
            </a>
            <a href="/concerts" class="btn btn-outline-secondary px-4">
              <i class="bi bi-calendar-event me-1"></i> Back to Concerts
            </a>
          </div>
        </div>
      </div>
      
      <div class="card mt-4">
        <div class="card-body p-4">
          <h5 class="card-title fw-bold mb-3">Need Help?</h5>
          <p class="card-text mb-0">If you continue to face issues with payment, please contact our support team at <a href="mailto:support@rapira.com">support@rapira.com</a> or call us at <strong>+91 1234567890</strong>.</p>
        </div>
      </div>
    </div>
  </div>
</div>
