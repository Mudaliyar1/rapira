<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h3 class="mb-0">Book <%= bookingData.name %></h3>
        </div>
        <div class="card-body">
          <div class="mb-4">
            <h5>Details</h5>
            <p><strong><%= bookingData.type === 'artist' ? 'Artist' : 'Role' %>:</strong> <%= bookingData.name %></p>
            <p><strong>Location:</strong> <%= bookingData.location %></p>
            <p><strong>Description:</strong> <%= bookingData.description %></p>
          </div>

          <hr class="my-4">

          <h5 class="mb-3">Your Information</h5>
          <form action="/find-my-artist/book/<%= bookingData.type %>/<%= bookingData.id %>" method="POST">
            <div class="mb-3">
              <label for="name" class="form-label">Your Name *</label>
              <input type="text" class="form-control" id="name" name="name" required>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Email Address *</label>
              <input type="email" class="form-control" id="email" name="email" required>
            </div>

            <div class="mb-3">
              <label for="phone" class="form-label">Phone Number *</label>
              <input type="tel" class="form-control" id="phone" name="phone" required>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="eventCity" class="form-label">Event City *</label>
                <input type="text" class="form-control" id="eventCity" name="eventCity" required>
              </div>

              <div class="col-md-6 mb-3">
                <label for="eventState" class="form-label">Event State *</label>
                <input type="text" class="form-control" id="eventState" name="eventState" required>
              </div>
            </div>

            <div class="mb-3">
              <label for="eventDate" class="form-label">Event Date *</label>
              <input type="date" class="form-control" id="eventDate" name="eventDate" required min="<%= new Date().toISOString().split('T')[0] %>">
            </div>

            <div class="mb-3">
              <label for="notes" class="form-label">Additional Notes</label>
              <textarea class="form-control" id="notes" name="notes" rows="5" placeholder="Please provide any additional details about your event or specific requirements"></textarea>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-primary btn-lg">Submit Booking Request</button>
              <a href="/find-my-artist" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
