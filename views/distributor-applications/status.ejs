<%- contentFor('body') %>

<div class="container py-5" style="max-width: 900px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 fw-bold">Distributor Application Status</h3>
    <a href="/users/job-portal" class="btn btn-outline-dark btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Portal</a>
  </div>

  <% if (applications && applications.length > 0) { %>
    <div class="card shadow-sm border-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th>Submitted Date</th>
              <th>Company/Name</th>
              <th>Location</th>
              <th>Registration Fee</th>
              <th class="text-center">Status</th>
              <th>Admin Notes</th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(application => { %>
              <tr class="align-middle">
                <td><%= toISTDateString(application.createdAt) %></td>
                <td class="fw-bold"><%= application.companyName %></td>
                <td><%= application.location %></td>
                <td>
                  <span class="badge <%= application.paymentStatus === 'paid' ? 'bg-success' : application.paymentStatus === 'n/a' ? 'bg-secondary' : 'bg-warning text-dark' %>">
                    <%= application.paymentStatus === 'paid' ? 'Paid' : application.paymentStatus === 'n/a' ? 'Free' : 'Unpaid' %>
                  </span>
                  <% if (application.registrationFee > 0 && application.paymentStatus !== 'paid') { %>
                    <a href="/distributor-applications/payment/<%= application._id %>" class="btn btn-sm btn-link text-primary p-0 ms-2">Pay ₹<%= application.registrationFee %></a>
                  <% } %>
                </td>
                <td class="text-center">
                  <span class="badge rounded-pill <%= application.status === 'approved' ? 'bg-success' : application.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark' %>">
                    <%= application.status.charAt(0).toUpperCase() + application.status.slice(1) %>
                  </span>
                </td>
                <td class="text-muted small"><%= application.adminNotes || '-' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card shadow-sm">
      <div class="card-body text-center py-5">
        <div class="mb-3">
          <i class="bi bi-broadcast text-muted" style="font-size: 3rem;"></i>
        </div>
        <p class="mb-4">You haven't submitted a distributor application yet.</p>
        <a href="/distributor-applications/apply" class="btn btn-primary px-4">Apply Now</a>
      </div>
    </div>
  <% } %>
</div>
