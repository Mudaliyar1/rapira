<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Complete Payment - Distributor Application</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    body { background: #f8f9fa; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .payment-card { max-width: 450px; width: 100%; border: 0; box-shadow: 0 1rem 3rem rgba(0,0,0,0.1); border-radius: 1.5rem; overflow: hidden; }
    .btn-pay { background: #6f42c1; border-color: #6f42c1; color: white; padding: 12px; font-weight: bold; font-size: 1.1rem; }
    .btn-pay:hover { background: #5a32a3; border-color: #5a32a3; color: white; }
    .brand-accent { color: #6f42c1; font-weight: 800; letter-spacing: -1px; }
  </style>
</head>
<body>
  <div class="payment-card card">
    <div class="card-header bg-white text-center py-4 border-0">
      <h2 class="brand-accent mb-1">RAPIRA</h2>
      <p class="text-muted small">Secure Payment Portal</p>
    </div>
    <div class="card-body p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-4 mb-3">
          <i class="bi bi-broadcast fs-1 text-primary"></i>
        </div>
        <h4 class="fw-bold">Distributor Registration</h4>
        <p class="text-secondary small">For: <%= application.companyName %></p>
      </div>

      <div class="bg-light p-3 rounded-4 mb-4">
        <div class="d-flex justify-content-between mb-2">
          <span class="text-secondary">Registration Fee</span>
          <span class="fw-bold fs-5">₹<%= application.registrationFee %></span>
        </div>
        <div class="d-flex justify-content-between border-top pt-2">
          <span class="text-dark fw-bold">Total Amount Payable</span>
          <span class="text-primary fw-bold fs-4">₹<%= application.registrationFee %></span>
        </div>
      </div>

      <div class="d-grid gap-3">
        <button id="rzp-button" class="btn btn-pay rounded-pill">
          <i class="bi bi-shield-lock-fill me-2"></i> Pay Now with Razorpay
        </button>
        <a href="/distributor-applications/cancel-payment/<%= application._id %>" class="btn btn-outline-danger btn-sm rounded-pill py-2">
           <i class="bi bi-x-circle me-1"></i> Cancel Application & Go Back
        </a>
      </div>

      <div class="mt-4 text-center">
        <img src="https://instamojo.com/blog/wp-content/uploads/2021/05/Instamojo_Trust_Badge.png" alt="Trusted Payments" style="height: 40px; opacity: 0.6;">
        <p class="text-muted small mt-2"><i class="bi bi-lock-fill"></i> Secure 256-bit SSL Encrypted Payment</p>
      </div>
    </div>
  </div>

  <form action="/distributor-applications/verify-payment/<%= application._id %>" method="POST" id="payment-verify-form">
    <input type="hidden" name="razorpay_payment_id" id="razorpay_payment_id">
    <input type="hidden" name="razorpay_order_id" id="razorpay_order_id">
    <input type="hidden" name="razorpay_signature" id="razorpay_signature">
  </form>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    const options = {
      key: "<%= keyId %>",
      amount: "<%= order.amount %>",
      currency: "INR",
      name: "Rapira Distribution Hub",
      description: "Music Distributor Registration Fee",
      image: "/images/logo.png",
      order_id: "<%= order.id %>",
      handler: function (response) {
        document.getElementById('razorpay_payment_id').value = response.razorpay_payment_id;
        document.getElementById('razorpay_order_id').value = response.razorpay_order_id;
        document.getElementById('razorpay_signature').value = response.razorpay_signature;
        document.getElementById('payment-verify-form').submit();
      },
      prefill: {
        name: "<%= currentUser.name %>",
        email: "<%= currentUser.email %>",
        contact: "<%= application.mobileNumber %>"
      },
      theme: { color: "#6f42c1" }
    };
    const rzp = new Razorpay(options);
    document.getElementById('rzp-button').onclick = function(e){
      rzp.open();
      e.preventDefault();
    }
  </script>
</body>
</html>
