<%- contentFor('body') %>

<div class="container py-5" style="max-width: 900px;">
  <div class="card shadow-sm">
    <div class="card-header bg-dark text-white p-4">
      <h4 class="mb-0 fw-bold">Apply as Music Distributor</h4>
      <p class="mb-0 text-white-50">Join our network of distributors and help artists reach global platforms.</p>
    </div>
    <div class="card-body p-4">
      <form action="/distributor-applications/apply" method="POST" enctype="multipart/form-data" id="distributorForm">
        <div class="row g-4">
          <div class="col-md-6">
            <label class="form-label fw-bold">Company/Individual Name *</label>
            <input type="text" name="companyName" class="form-control" placeholder="Enter company or stage name" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Mobile Number *</label>
            <input type="text" name="mobileNumber" class="form-control" maxlength="10" placeholder="10-digit mobile number" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Website</label>
            <input type="url" name="website" class="form-control" placeholder="https://example.com">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Instagram Profile</label>
            <input type="url" name="instagramLink" class="form-control" placeholder="https://instagram.com/yourprofile">
          </div>
          <div class="col-12">
            <label class="form-label fw-bold">Experience in Music Distribution *</label>
            <textarea name="experience" class="form-control" rows="3" placeholder="Tell us about your distribution history, number of clients, etc." required></textarea>
          </div>
          <div class="col-12">
            <label class="form-label fw-bold">Platforms you distribute to *</label>
            <div class="row row-cols-2 row-cols-sm-3 g-2 mt-1">
              <% const platforms = ['Spotify', 'Apple Music', 'JioSaavn', 'Gaana', 'YouTube Music', 'Amazon Music', 'Tidal', 'Deezer', 'Boomplay']; %>
              <% platforms.forEach(platform => { %>
                <div class="col">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="platforms" value="<%= platform %>" id="plat_<%= platform %>">
                    <label class="form-check-label" for="plat_<%= platform %>"><%= platform %></label>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">State *</label>
            <select name="state" id="stateSelect" class="form-select" required onchange="updateLocationValue()">
              <option value="">Select State</option>
              <option value="Andhra Pradesh">Andhra Pradesh</option>
              <option value="Arunachal Pradesh">Arunachal Pradesh</option>
              <option value="Assam">Assam</option>
              <option value="Bihar">Bihar</option>
              <option value="Chhattisgarh">Chhattisgarh</option>
              <option value="Goa">Goa</option>
              <option value="Gujarat">Gujarat</option>
              <option value="Haryana">Haryana</option>
              <option value="Himachal Pradesh">Himachal Pradesh</option>
              <option value="Jharkhand">Jharkhand</option>
              <option value="Karnataka">Karnataka</option>
              <option value="Kerala">Kerala</option>
              <option value="Madhya Pradesh">Madhya Pradesh</option>
              <option value="Maharashtra">Maharashtra</option>
              <option value="Manipur">Manipur</option>
              <option value="Meghalaya">Meghalaya</option>
              <option value="Mizoram">Mizoram</option>
              <option value="Nagaland">Nagaland</option>
              <option value="Odisha">Odisha</option>
              <option value="Punjab">Punjab</option>
              <option value="Rajasthan">Rajasthan</option>
              <option value="Sikkim">Sikkim</option>
              <option value="Tamil Nadu">Tamil Nadu</option>
              <option value="Telangana">Telangana</option>
              <option value="Tripura">Tripura</option>
              <option value="Uttar Pradesh">Uttar Pradesh</option>
              <option value="Uttarakhand">Uttarakhand</option>
              <option value="West Bengal">West Bengal</option>
              <option value="Andaman and Nicobar Islands">Andaman and Nicobar Islands</option>
              <option value="Chandigarh">Chandigarh</option>
              <option value="Dadra and Nagar Haveli and Daman and Diu">Dadra and Nagar Haveli and Daman and Diu</option>
              <option value="Delhi">Delhi</option>
              <option value="Jammu and Kashmir">Jammu and Kashmir</option>
              <option value="Ladakh">Ladakh</option>
              <option value="Lakshadweep">Lakshadweep</option>
              <option value="Puducherry">Puducherry</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">City *</label>
            <input type="text" name="city" id="cityInput" class="form-control" placeholder="Enter your city" required oninput="updateLocationValue()">
          </div>
          <input type="hidden" name="location" id="locationInput">
          <div class="col-md-6">
            <label class="form-label fw-bold">ID Proof Type *</label>
            <select name="idProofType" class="form-select" required>
              <option value="">Select ID Proof</option>
              <option value="Aadhaar Card">Aadhaar Card</option>
              <option value="PAN Card">PAN Card</option>
              <option value="Driving License">Driving License</option>
              <option value="GST Certificate">GST Certificate</option>
              <option value="Passport">Passport</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label fw-bold">Upload ID Proof (JPG/PNG, max 5MB) *</label>
            <input type="file" name="idProofFile" class="form-control" accept=".jpg,.jpeg,.png" required>
          </div>
          <div class="col-12">
            <div class="p-3 bg-black text-white rounded border d-flex align-items-start">
              <input class="form-check-input me-3 mt-1 flex-shrink-0" type="checkbox" id="agree" name="agreedToTerms" required style="cursor: pointer; width: 1.25rem; height: 1.25rem;">
              <label class="form-check-label small mb-0" for="agree" style="cursor: pointer; line-height: 1.5;">
                I understand that my application is subject to review by the Rapira team. I agree to pay the registration fee (if applicable) and platform commission on successful distribution services.
              </label>
            </div>
          </div>
          <div class="col-12 d-flex gap-2 justify-content-end">
            <% const distFee = (websiteSettings && websiteSettings.registrationFees && websiteSettings.registrationFees.distributorRegistrationFee > 0) ? websiteSettings.registrationFees.distributorRegistrationFee : 0; %>
            <a href="/users/job-portal" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn px-5  text-white" style="background-color: #6f42c1; border-color: #6f42c1;">
              <% if (distFee > 0) { %>
                <i class="bi bi-credit-card me-2"></i>Pay ₹<%= distFee %> & Submit
              <% } else { %>
                <i class="bi bi-check-circle me-2"></i>Submit Application
              <% } %>
            </button>
          </div>
        </div>
      </form>
</div>

<script>
  function updateLocationValue() {
    const state = document.getElementById('stateSelect').value;
    const city = document.getElementById('cityInput').value;
    const locationInput = document.getElementById('locationInput');
    
    if (state && city) {
      locationInput.value = city + ", " + state;
    } else {
      locationInput.value = "";
    }
  }
</script>

