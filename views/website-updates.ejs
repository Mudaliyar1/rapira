<div class="container-fluid py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
      <div class="text-center mb-5" data-aos="fade-down" data-aos-duration="800">
        <div class="mb-4">
          <i class="bi bi-megaphone-fill text-primary" style="font-size: 3rem; opacity: 0.8;"></i>
        </div>
        <h1 class="display-4 fw-bold gradient-text-purple mb-3">Website Updates</h1>
        <p class="lead text-muted mb-0">Stay informed about the latest changes and improvements</p>
      </div>

      <% if (updates.length === 0) { %>
        <div class="text-center py-5" data-aos="fade-up" data-aos-duration="800">
          <div class="mb-4">
            <i class="bi bi-megaphone display-1 text-muted" style="opacity: 0.3;"></i>
          </div>
          <h5 class="mt-3 fw-bold">No updates available</h5>
          <p class="text-muted">Check back later for website updates and improvements</p>
          <div class="mt-4">
            <i class="bi bi-arrow-repeat text-muted" style="font-size: 2rem; opacity: 0.3;"></i>
          </div>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% updates.forEach((update, index) => { %>
            <div class="col-lg-12" data-aos="zoom-in-up" data-aos-delay="<%= index * 100 %>" data-aos-duration="800">
              <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5">
                  <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="flex-grow-1">
                      <div class="d-flex flex-wrap align-items-center mb-3">
                        <h5 class="card-title fw-bold mb-0 me-3">
                          <%= update.title %>
                        </h5>
                        <% if (update.priority === 'critical') { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Critical
                          </span>
                        <% } else if (update.priority === 'high') { %>
                          <span class="badge bg-warning-subtle text-warning border border-warning">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>High Priority
                          </span>
                        <% } else if (update.priority === 'medium') { %>
                          <span class="badge bg-info-subtle text-info border border-info">
                            <i class="bi bi-info-circle-fill me-1"></i>Important
                          </span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success border border-success">
                            <i class="bi bi-check-circle-fill me-1"></i>Update
                          </span>
                        <% } %>
                      </div>
                      
                      <div class="d-flex flex-wrap align-items-center text-muted small mb-3">
                        <span class="d-flex align-items-center me-4 mb-2 mb-md-0">
                          <i class="bi bi-person-circle me-2"></i>
                          <strong><%= update.author ? update.author.name : 'System' %></strong>
                        </span>
                        <span class="d-flex align-items-center me-4 mb-2 mb-md-0">
                          <i class="bi bi-calendar-event me-2"></i>
                          <%= update.timestamp.toLocaleDateString() %> <%= update.timestamp.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                        </span>
                        <span class="d-flex align-items-center mb-2 mb-md-0">
                          <i class="bi bi-tag-fill me-2"></i>
                          <% if (update.tags && update.tags.length > 0) { %>
                            <% update.tags.slice(0, 3).forEach((tag, tagIndex) => { %>
                              <span class="badge bg-primary-subtle text-primary border border-primary me-1" style="font-size: 0.75em;"><%= tag %></span>
                            <% }) %>
                            <% if (update.tags.length > 3) { %>
                              <span class="badge bg-secondary-subtle text-secondary border border-secondary" style="font-size: 0.75em;">+<%= update.tags.length - 3 %> more</span>
                            <% } %>
                          <% } else { %>
                            <span class="text-muted">No tags</span>
                          <% } %>
                        </span>
                      </div>
                    </div>
                  </div>
                  
                  <div class="update-description mb-4">
                    <p class="card-text fs-5 text-white mb-0"><%= update.description %></p>
                  </div>
                  

                  
                  <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <div class="d-flex align-items-center">
                      <i class="bi bi-clock-history text-muted me-2"></i>
                      <small class="text-muted">
                        Posted <%= new Date(update.timestamp).toLocaleString() %>
                      </small>
                    </div>
                    <button class="btn btn-primary btn-sm rounded-pill px-4" type="button" data-bs-toggle="collapse" data-bs-target="#update-<%= update._id %>-details" aria-expanded="false" aria-controls="update-<%= update._id %>-details">
                      <i class="bi bi-chevron-down me-1"></i>Read More
                    </button>
                  </div>
                  
                  <div class="collapse mt-4" id="update-<%= update._id %>-details">
                    <div class="card card-body border-0 bg-dark text-light rounded-3 p-4">
                      <h6 class="mb-3 fw-bold bg-white rounded px-3 py-2" style="display: inline-block; color: black !important;">
                        <i class="bi bi-file-text-fill me-2"></i>Full Update Details
                      </h6>
                      <div class="text-light mt-3">
                        <%= update.content %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        
        <% if (updates.length > 1) { %>
        <nav aria-label="Page navigation" class="mt-5">
          <ul class="pagination justify-content-center">
            <li class="page-item disabled">
              <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
            </li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
              <a class="page-link" href="#">Next</a>
            </li>
          </ul>
        </nav>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<script>
// Initialize AOS animations when the page loads
if (typeof AOS !== 'undefined') {
  AOS.init({
    duration: 800,
    easing: 'ease-in-out',
    once: false,
    offset: 100
  });
}

// Add smooth scrolling for anchor links
function smoothScrollTo(target) {
  const element = document.querySelector(target);
  if (element) {
    element.scrollIntoView({
      behavior: 'smooth',
      block: 'start'
    });
  }
}

// Add animation to buttons on hover
document.addEventListener('DOMContentLoaded', function() {
  const buttons = document.querySelectorAll('.btn');
  buttons.forEach(button => {
    button.addEventListener('mouseenter', function() {
      this.classList.add('animate__animated', 'animate__pulse');
    });
    
    button.addEventListener('animationend', function() {
      this.classList.remove('animate__animated', 'animate__pulse');
    });
  });
});
</script>