<% 
  const footerPath = (typeof path !== 'undefined' && path) || '';
  const isCreamFooter = !footerPath.startsWith('/admin');
%>
<footer class="rapira-site-footer <%= isCreamFooter ? 'rapira-homepage-footer rapira-auth-footer rapira-about-footer rapira-content-footer' : 'text-white' %> py-5 <%= isCreamFooter ? 'mt-0' : 'mt-5' %>" style="<%= isCreamFooter ? 'background-color: #FCF0E4 !important;' : 'background-color: #000;' %>">
  <div class="container">
    <div class="row g-4 justify-content-between rapira-footer-row">
      <!-- Column 1: Brand & Platform Mission -->
      <div class="col-12 col-lg-3 col-md-6 mb-3 rapira-footer-col">
        <a class="navbar-brand d-inline-block mb-2 text-decoration-none" href="/">
          <span class="fs-2 fw-bold footer-brand">RAPIRA</span>
        </a>
        <p class="small footer-tagline mb-3">
          A dynamic platform for Indian rap artists and fans to connect, discover, and experience hip-hop culture.
        </p>
        <div class="social-icons d-flex gap-2 mb-2">
          <a href="#" aria-label="Instagram" class="social-icon-pill" title="Instagram"><i class="bi bi-instagram"></i></a>
          <a href="#" aria-label="Twitter" class="social-icon-pill" title="Twitter / X"><i class="bi bi-twitter-x"></i></a>
          <a href="#" aria-label="YouTube" class="social-icon-pill" title="YouTube"><i class="bi bi-youtube"></i></a>
          <a href="#" aria-label="Spotify" class="social-icon-pill" title="Spotify"><i class="bi bi-spotify"></i></a>
        </div>
      </div>

      <!-- Column 2: Discover -->
      <div class="col-12 col-md-3 col-lg-2 mb-3 rapira-footer-col">
        <h6 class="footer-heading mb-3">Discover</h6>
        <% if (!menuSettings || (menuSettings.discoverMenu && menuSettings.discoverMenu.items.home !== false)) { %>
          <a href="/" class="footer-link small mb-2">Home</a>
        <% } %>
        <% if (!menuSettings || (menuSettings.discoverMenu && menuSettings.discoverMenu.items.concerts !== false)) { %>
          <a href="/concerts" class="footer-link small mb-2">Concerts</a>
        <% } %>
        <% if (!menuSettings || (menuSettings.discoverMenu && menuSettings.discoverMenu.items.artists !== false)) { %>
          <a href="/artists" class="footer-link small mb-2">Artists</a>
        <% } %>
        <% if (!menuSettings || (menuSettings.discoverMenu && menuSettings.discoverMenu.items.about !== false)) { %>
          <a href="/about" class="footer-link small mb-2">About Us</a>
        <% } %>
        <% if (!menuSettings || (menuSettings.helpSupportMenu && menuSettings.helpSupportMenu.items.contact !== false)) { %>
          <a href="/contact" class="footer-link small mb-2">Contact</a>
        <% } %>
      </div>

      <!-- Column 3: Services & Demos -->
      <div class="col-12 col-md-3 col-lg-2 mb-3 rapira-footer-col">
        <h6 class="footer-heading mb-3">Services</h6>
        <a href="/demo/artist" class="footer-link small mb-2">Artist Demo</a>
        <a href="/demo/concert" class="footer-link small mb-2">Concert Demo</a>
        <a href="/demo/ticket" class="footer-link small mb-2">Ticket Demo</a>
        <a href="/demo/content" class="footer-link small mb-2">Content Demo</a>
        <a href="/demo/subscription" class="footer-link small mb-2">Subscription Demo</a>
      </div>

      <!-- Column 4: Shop & Policies -->
      <div class="col-12 col-md-3 col-lg-2 mb-3 rapira-footer-col">
        <h6 class="footer-heading mb-3">Shop & Policies</h6>
        <a href="/shop" class="footer-link small mb-2">Explore Shop</a>
        <a href="/shopping-policy" class="footer-link small mb-2">Shopping Policy</a>
        <a href="/refund-policy" class="footer-link small mb-2">Refund Policy</a>
        <a href="/subscription-policy" class="footer-link small mb-2">Subscription Policy</a>
      </div>

      <!-- Column 5: Support & Legal -->
      <div class="col-12 col-md-6 col-lg-3 mb-3 rapira-footer-col">
        <h6 class="footer-heading mb-3">Help & Support</h6>
        <a href="/demo" class="footer-link small mb-2">Help Center</a>
        <a href="/faq" class="footer-link small mb-2">FAQ</a>
        <a href="/terms-of-service" class="footer-link small mb-2">Terms of Service</a>
        <a href="/privacy-policy" class="footer-link small mb-2">Privacy Policy</a>
        <a href="/document-id-policy" class="footer-link small mb-2">Document & ID Policy</a>
        <a href="/event-attending-policy" class="footer-link small mb-2">Event Attending Policy</a>
      </div>
    </div>

    <!-- Bottom Bar: Dividers & Legal Credits -->
    <div class="footer-bottom-bar mt-4 pt-4 border-top">
      <div class="row align-items-center">
        <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
          <p class="mb-0 small footer-copy-line">&copy; <%= new Date().getFullYear() %> Rapira. All rights reserved.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0 small footer-copy-line">Business: Vijaykumar Mudaliyar | Developed with &hearts; for Indian Hip-Hop</p>
        </div>
      </div>
    </div>
  </div>
</footer>
