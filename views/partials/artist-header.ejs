<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Artist Dashboard' %> - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (typeof extraStyles !== 'undefined') { %>
    <%- extraStyles %>
  <% } %>
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white p-0" id="artistSidebar">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0 text-primary fw-bold">Artist Dashboard</h5>
        <button class="btn btn-sm btn-outline-light" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <% if (artist.user.profileImage) { %>
              <img src="<%= artist.user.profileImage %>" alt="<%= artist.user.name %>" class="rounded-circle" width="48" height="48">
            <% } else { %>
              <i class="bi bi-person-circle fs-1"></i>
            <% } %>
          </div>
          <div>
            <h6 class="mb-0"><%= artist.user.name %></h6>
            <small class="text-muted">Artist</small>
          </div>
        </div>
        <ul class="nav flex-column">
          <!-- Main Navigation -->
          <li class="nav-item mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Main</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/dashboard" class="nav-link text-white p-2 rounded <%= currentPath === '/artists/dashboard' ? 'active bg-primary' : '' %>">
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
          </li>

          <!-- Content Management -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Content</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/manage-content" class="nav-link text-white p-2 rounded <%= currentPath === '/artists/manage-content' ? 'active bg-primary' : '' %>">
              <i class="bi bi-collection me-2"></i> Manage Content
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/manage-concerts" class="nav-link text-white p-2 rounded <%= currentPath === '/artists/manage-concerts' ? 'active bg-primary' : '' %>">
              <i class="bi bi-calendar-event me-2"></i> Manage Concerts
            </a>
          </li>
          <% if (artist.artistLevel === 'Intermediate' || artist.artistLevel === 'Established') { %>
          <li class="nav-item mb-2">
            <a href="/concerts/create" class="nav-link text-white p-2 rounded <%= currentPath === '/concerts/create' ? 'active bg-primary' : '' %>">
              <i class="bi bi-calendar-plus me-2"></i> Create Concert
            </a>
          </li>
          <% } %>

          <!-- Learning & Development -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Learning</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/learning" class="nav-link text-white p-2 rounded <%= currentPath === '/learning' ? 'active bg-primary' : '' %>">
              <i class="bi bi-book me-2"></i> Learning Modules
            </a>
          </li>

          <!-- Communication -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Communication</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/messages" class="nav-link text-white p-2 rounded <%= currentPath === '/messages' || currentPath === '/messages/find' ? 'active bg-primary' : '' %>">
              <i class="bi bi-chat-dots me-2"></i> Messages
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/messages/find" class="nav-link text-white p-2 rounded <%= currentPath === '/messages/find' ? 'active bg-primary' : '' %>">
              <i class="bi bi-people me-2"></i> Connect with Others
            </a>
          </li>

          <!-- Account -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Account</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/edit-profile" class="nav-link text-white p-2 rounded <%= currentPath === '/artists/edit-profile' ? 'active bg-primary' : '' %>">
              <i class="bi bi-pencil-square me-2"></i> Edit Profile
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/artists/<%= artist._id %>" class="nav-link text-white p-2 rounded">
              <i class="bi bi-eye me-2"></i> View Public Profile
            </a>
          </li>

          <!-- Navigation -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Navigation</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/" class="nav-link text-white p-2 rounded">
              <i class="bi bi-arrow-left me-2"></i> Back to Site
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/auth/logout" class="nav-link text-white p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
          <button class="btn btn-primary d-none d-md-block me-3" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>
          <h1 class="fw-bold mb-0"><%= typeof title !== 'undefined' ? title : 'Artist Dashboard' %></h1>
        </div>
      </div>

  <!-- Sidebar Overlay for Mobile -->
  <div class="sidebar-overlay" style="display: none;"></div>
