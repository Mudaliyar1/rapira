<!-- Artist Posts Display - Server Side Rendering -->
<% if (posts && posts.length > 0) { %>
  <div class="row g-3 mb-4">
    <% posts.forEach((post, idx) => { 
      const media = post.media || {};
      const mediaType = media.mediaType || 'image';
      const mediaUrl = media.url || '';
    %>
      <div class="col-md-4 col-lg-3 mb-3">
        <a href="/posts/view/<%= post._id %>" style="text-decoration: none;">
          <div class="card h-100 post-card-item" style="background: #1a1a2e; border: 1px solid #333; border-radius: 12px; overflow: hidden; cursor: pointer; transition: all 0.3s;">
            
            <!-- Media -->
            <div style="position: relative; aspect-ratio: 1; overflow: hidden; background: #0f0f0f;">
              <% if (mediaType === 'image') { %>
                <img src="<%= mediaUrl %>" alt="post" style="width: 100%; height: 100%; object-fit: cover;">
              <% } else { %>
                <video style="width: 100%; height: 100%; object-fit: cover;" muted>
                  <source src="<%= mediaUrl %>">
                </video>
              <% } %>
              
              <!-- Overlay on hover -->
              <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s;" class="hover-overlay">
                <div style="display: flex; gap: 20px; color: white; text-align: center;">
                  <div style="display: flex; flex-direction: column; align-items: center;">
                    <i class="bi bi-heart-fill" style="font-size: 1.5rem; margin-bottom: 5px; color: #ff006e;"></i>
                    <span><%= post.likesCount || 0 %></span>
                  </div>
                  <div style="display: flex; flex-direction: column; align-items: center;">
                    <i class="bi bi-share" style="font-size: 1.5rem; margin-bottom: 5px; color: #00d4ff;"></i>
                    <span><%= post.shares || 0 %></span>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Info -->
            <div class="card-body p-3" style="background: #151525;">
              <p class="text-white small mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= post.caption ? post.caption.substring(0, 100) : '(no caption)' %>
              </p>
              <% if (post.hashtags && post.hashtags.length > 0) { %>
                <p class="text-info small mb-0">
                  <% post.hashtags.slice(0, 2).forEach(tag => { %>
                    <span>#<%= tag %></span> 
                  <% }); %>
                </p>
              <% } %>
            </div>
          </div>
        </a>
      </div>
    <% }); %>
  </div>

  <style>
    .post-card-item:hover .hover-overlay {
      opacity: 1 !important;
    }
    .post-card-item:hover {
      border-color: #00d4ff !important;
      box-shadow: 0 8px 24px rgba(0, 212, 255, 0.2);
      transform: translateY(-5px);
    }
  </style>

<% } else { %>
  <!-- No Posts -->
  <div class="text-center py-5">
    <i class="bi bi-images" style="font-size: 60px; color: #444; display: block; margin-bottom: 15px;"></i>
    <h5 class="text-muted">No posts yet</h5>
    <p class="text-muted">This artist hasn't shared any posts yet</p>
  </div>
<% } %>
