<!-- Artist Posts Display - Server Side Rendering (RAPIRA Cream & Crimson Theme) -->
<% if (posts && posts.length > 0) { %>
  <div class="rh-ap-posts-grid mb-4">
    <% posts.forEach((post) => { 
      const media = post.media || {};
      const mediaType = media.mediaType || 'image';
      const mediaUrl = media.url || '';
      const commentsCount = Array.isArray(post.comments) ? post.comments.length : 0;
      const likesCount = typeof post.likesCount === 'number' ? post.likesCount : (Array.isArray(post.likes) ? post.likes.length : 0);
    %>
      <div class="rh-ap-post-card" onclick="viewPost('<%= post._id %>')" role="button" tabindex="0" aria-label="View post by <%= post.caption ? post.caption.substring(0, 30) : 'artist' %>">
        <div class="rh-ap-post-media-wrap">
          <% if (mediaType === 'image') { %>
            <img src="<%= mediaUrl %>" alt="Post thumbnail" class="rh-ap-post-img" loading="lazy" onerror="this.onerror=null; this.src='/images/default-concert.jpg';">
          <% } else if (mediaType === 'video') { %>
            <video class="rh-ap-post-video" muted preload="metadata">
              <source src="<%= mediaUrl %>">
            </video>
            <div class="rh-ap-play-badge" aria-label="Video post">
              <i class="bi bi-play-fill"></i>
            </div>
          <% } else if (mediaType === 'audio') { %>
            <div class="rh-ap-post-audio-fallback">
              <i class="bi bi-music-note-beamed"></i>
            </div>
          <% } %>

          <!-- Bottom Stats Overlay -->
          <div class="rh-ap-post-overlay">
            <span class="rh-ap-stat-pill">
              <i class="bi bi-heart-fill"></i> <%= likesCount %>
            </span>
            <span class="rh-ap-stat-pill">
              <i class="bi bi-chat-fill"></i> <%= commentsCount %>
            </span>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <!-- Clean Empty State for Posts -->
  <div class="rh-ap-empty-card py-5 text-center">
    <div class="rh-ap-empty-icon mb-3">
      <div class="rh-ap-icon-bubble">
        <i class="bi bi-images"></i>
      </div>
    </div>
    <h5 class="rh-ap-empty-title mb-1">No posts yet</h5>
    <p class="rh-ap-empty-desc mb-0">This artist hasn't shared any posts yet.</p>
  </div>
<% } %>
