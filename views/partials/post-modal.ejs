<!-- Post Viewer Modal (Centered, Not Fullscreen) -->
<div class="modal fade" id="post-viewer" tabindex="-1" aria-hidden="true" data-bs-backdrop="true" data-bs-keyboard="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="background: #1a1a2e; border: 1px solid #333; border-radius: 16px; overflow: hidden;">
      
      <!-- Close Button - Positioned at top right of modal content -->
      <button type="button" class="btn-close btn-close-white position-absolute" data-bs-dismiss="modal" aria-label="Close" style="top: 15px; right: 15px; z-index: 1060;"></button>
      
      <div class="modal-body p-0" style="max-height: 90vh; overflow-y: auto;">
        
        <!-- Post Card -->
        <div id="post-modal-content" class="post-container">
          
          <!-- Post Header -->
          <div class="post-header" style="display: flex; align-items: center; gap: 15px; padding: 20px; border-bottom: 1px solid #333;">
            <img id="post-artist-img" src="" alt="Artist" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; border: 2px solid #00d4ff; cursor: pointer;">
            <div class="artist-info">
              <a id="post-artist-link" href="#" style="text-decoration: none;">
                <h6 id="post-artist-name" class="mb-0 text-white" style="font-weight: 600; cursor: pointer; transition: color 0.2s;">Artist Name</h6>
              </a>
              <p id="post-created-at" class="mb-0 text-muted" style="font-size: 0.9rem;">Just now</p>
            </div>
          </div>
          
          <!-- Post Media -->
          <div id="post-media-container" style="background: #000; display: flex; align-items: center; justify-content: center; width: 100%; max-height: 500px; overflow: hidden; position: relative;">
            <!-- Image or Video will be inserted here -->
          </div>
          
          <!-- Post Info -->
          <div class="post-info" style="padding: 20px;">
            
            <!-- Stats -->
            <div class="post-stats" style="display: flex; gap: 30px; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #333; justify-content: space-around;">
              <div style="text-align: center;">
                <strong id="post-likes-count" style="display: block; font-size: 1.3rem; color: #00d4ff;">0</strong>
                <small style="color: #999;">Likes</small>
              </div>
              <div style="text-align: center;">
                <strong id="post-shares-count" style="display: block; font-size: 1.3rem; color: #00d4ff;">0</strong>
                <small style="color: #999;">Shares</small>
              </div>
              <div style="text-align: center;">
                <strong id="post-views-count" style="display: block; font-size: 1.3rem; color: #00d4ff;">0</strong>
                <small style="color: #999;">Views</small>
              </div>
            </div>
            
            <!-- Action Buttons - Only for logged-in users -->
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <div class="action-buttons" style="display: flex; gap: 15px; align-items: center; justify-content: center; padding: 15px 0; margin-bottom: 15px; border-bottom: 1px solid #333;">
                <!-- Like Button -->
                <button id="post-modal-like-btn" style="background: rgba(255, 255, 255, 0.05); border: 2px solid rgba(255, 255, 255, 0.2); cursor: pointer; padding: 12px; transition: all 0.3s ease; border-radius: 50%; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center;">
                  <i class="bi bi-heart" style="font-size: 1.6rem; color: #fff; pointer-events: none;"></i>
                </button>
                
                <!-- Share Button -->
                <button id="post-modal-share-btn" style="background: rgba(0, 212, 255, 0.1); border: 2px solid rgba(0, 212, 255, 0.3); cursor: pointer; padding: 12px; transition: all 0.3s ease; border-radius: 50%; width: 55px; height: 55px; display: flex; align-items: center; justify-content: center;">
                  <i class="bi bi-share" style="font-size: 1.6rem; color: #00d4ff; pointer-events: none;"></i>
                </button>
              </div>
            <% } else { %>
              <!-- Login message for non-logged-in users -->
              <div style="text-align: center; padding: 15px 0; margin-bottom: 15px; border-bottom: 1px solid #333;">
                <p class="mb-0 text-muted" style="font-size: 0.95rem;">
                  <i class="bi bi-lock me-2"></i>
                  <a href="/auth/login" class="text-decoration-none text-primary fw-bold">Login to like and share</a>
                </p>
              </div>
            <% } %>
            
            <!-- Caption with Read More -->
            <div style="margin-bottom: 15px;">
              <p id="post-caption" class="post-caption" style="font-size: 1rem; margin-bottom: 8px; line-height: 1.6; color: #fff; word-wrap: break-word; overflow-wrap: break-word;"></p>
              <button id="read-more-btn" onclick="toggleReadMore()" style="display: none; background: none; border: none; color: #00d4ff; cursor: pointer; padding: 0; font-size: 0.9rem; font-weight: 600; text-decoration: underline;">Read More</button>
            </div>
            
            <!-- Hashtags -->
            <div id="post-hashtags" class="post-hashtags" style="margin-bottom: 15px; display: flex; flex-wrap: wrap; gap: 8px;">
              <!-- Hashtags will be inserted here -->
            </div>
            
            <!-- Login Message -->
            <div id="post-login-message" class="login-message text-center" style="display: none;">
              <p class="mb-0 text-muted">Please log in to like and share posts</p>
            </div>
            
          </div>
        </div>
        
      </div>
    </div>
  </div>
</div>
