<!-- Post Viewer Modal -->
<div class="modal fade" id="post-viewer" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content" style="background:#0f0f1a; color:#fff; border:1px solid #222;">
			<div class="modal-header" style="border-color:#222;">
				<div class="d-flex align-items-center gap-2">
					<img id="post-artist-img" src="/images/default-profile.svg" alt="artist" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">
					<div class="d-flex flex-column">
						<strong id="post-artist-name" style="font-size:0.95rem;">Artist</strong>
						<small id="post-time-ago" class="text-muted">Just now</small>
					</div>
				</div>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div id="post-media" class="d-flex justify-content-center" style="max-height:70vh;">
					<!-- media will be injected here -->
				</div>
				<div class="mt-3">
					<p id="post-caption" class="mb-2" style="white-space:pre-wrap;"></p>
					<div id="post-hashtags" class="text-info small"></div>
				</div>
			</div>
			<div class="modal-footer d-flex justify-content-between" style="border-color:#222;">
				<div class="d-flex align-items-center gap-3 text-muted">
					<span><i id="post-like-icon" class="bi bi-heart"></i> <span id="post-likes-count">0</span></span>
					<span><i class="bi bi-share"></i> <span id="post-shares-count">0</span></span>
				</div>
				<div class="d-flex gap-2">
					<button id="post-like-btn" class="btn btn-outline-light">
						<i class="bi bi-heart"></i> Like
					</button>
					<button id="post-share-btn" class="btn btn-outline-light">
						<i class="bi bi-share"></i> Share
					</button>
				</div>
			</div>
		</div>
	</div>
</div>
