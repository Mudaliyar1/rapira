<!-- RAPIRA Post Viewer Modal (Redesigned Editorial Cream & Crimson) -->
<div class="modal fade rh-viewer-modal" id="post-viewer" tabindex="-1" aria-hidden="true" data-bs-backdrop="true" data-bs-keyboard="true">
  <div class="modal-dialog modal-dialog-centered rh-viewer-dialog">
    <div class="modal-content rh-viewer-content">
      
      <!-- Close Button -->
      <button type="button" class="rh-viewer-close-btn" data-bs-dismiss="modal" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>

      <div class="modal-body p-0 rh-viewer-body">
        <div id="post-modal-content" class="rh-viewer-layout">
          
          <!-- LEFT / TOP: Media Container Panel -->
          <div class="rh-viewer-media-panel">
            <!-- Mobile Compact Artist Header (visible on < 992px) -->
            <div class="rh-viewer-mobile-header d-lg-none">
              <div class="rh-viewer-artist-meta">
                <img id="post-artist-img-mobile" src="/images/default-profile.svg" alt="Artist" class="rh-viewer-artist-avatar">
                <div class="rh-viewer-artist-info">
                  <a id="post-artist-link-mobile" href="#" class="rh-viewer-artist-link">
                    <span id="post-artist-name-mobile" class="rh-viewer-artist-name">Artist Name</span>
                  </a>
                  <span id="post-created-at-mobile" class="rh-viewer-post-date">Just now</span>
                </div>
              </div>
            </div>

            <!-- Media Container -->
            <div id="post-media-container" class="rh-viewer-media-viewport">
              <!-- Dynamically populated: Audio visualizer, video player, or responsive image -->
              <div class="rh-viewer-loading">
                <div class="spinner-border text-danger" role="status">
                  <span class="visually-hidden">Loading media...</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- RIGHT: Content Information & Engagement Sidebar -->
          <div class="rh-viewer-info-panel">
            
            <!-- Desktop Artist Header (visible on >= 992px) -->
            <div class="rh-viewer-desktop-header d-none d-lg-flex">
              <img id="post-artist-img" src="/images/default-profile.svg" alt="Artist" class="rh-viewer-artist-avatar">
              <div class="rh-viewer-artist-info">
                <a id="post-artist-link" href="#" class="rh-viewer-artist-link">
                  <h6 id="post-artist-name" class="rh-viewer-artist-name mb-0">Artist Name</h6>
                </a>
                <span id="post-created-at" class="rh-viewer-post-date">Just now</span>
              </div>
            </div>

            <!-- Scrollable Content Details -->
            <div class="rh-viewer-scrollable-body">
              <!-- Caption & Read More -->
              <div class="rh-viewer-caption-block">
                <p id="post-caption" class="rh-viewer-caption"></p>
                <button id="read-more-btn" onclick="toggleReadMore()" class="rh-viewer-read-more" type="button" style="display: none;">Read More</button>
              </div>
              
              <!-- Hashtags -->
              <div id="post-hashtags" class="rh-viewer-hashtags"></div>

              <!-- Engagement Statistics Row -->
              <div class="rh-viewer-stats-grid">
                <div class="rh-viewer-stat-card">
                  <span class="rh-viewer-stat-val" id="post-likes-count">0</span>
                  <span class="rh-viewer-stat-lbl">Likes</span>
                </div>
                <div class="rh-viewer-stat-card">
                  <span class="rh-viewer-stat-val" id="post-shares-count">0</span>
                  <span class="rh-viewer-stat-lbl">Shares</span>
                </div>
                <div class="rh-viewer-stat-card">
                  <span class="rh-viewer-stat-val" id="post-views-count">0</span>
                  <span class="rh-viewer-stat-lbl">Views</span>
                </div>
                <div class="rh-viewer-stat-card clickable" onclick="openPostViewerComments()">
                  <span class="rh-viewer-stat-val" id="post-comments-count">0</span>
                  <span class="rh-viewer-stat-lbl">Comments</span>
                </div>
                <div class="rh-viewer-stat-card clickable d-none" id="post-reports-stat" onclick="openPostViewerReport()">
                  <span class="rh-viewer-stat-val text-danger" id="post-reports-count">0</span>
                  <span class="rh-viewer-stat-lbl">Reports</span>
                </div>
              </div>

              <!-- Engagement Action Buttons -->
              <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                <div class="rh-viewer-actions-row">
                  <!-- Like Button -->
                  <button id="post-modal-like-btn" class="rh-viewer-action-btn rh-viewer-like-btn" title="Like Post" type="button">
                    <i class="bi bi-heart"></i>
                    <span class="rh-viewer-action-label">Like</span>
                  </button>
                  
                  <!-- Share Button -->
                  <button id="post-modal-share-btn" class="rh-viewer-action-btn" title="Share Post" type="button">
                    <i class="bi bi-share"></i>
                    <span class="rh-viewer-action-label">Share</span>
                  </button>

                  <!-- Comments Button -->
                  <button onclick="openPostViewerComments()" id="post-modal-comments-btn" class="rh-viewer-action-btn" title="Comments" type="button">
                    <i class="bi bi-chat-dots"></i>
                    <span class="rh-viewer-action-label">Comment</span>
                  </button>
                  
                  <!-- Report Button -->
                  <button onclick="openPostViewerReport()" id="post-modal-report-btn" class="rh-viewer-action-btn" title="Report Post" type="button">
                    <i class="bi bi-flag"></i>
                    <span class="rh-viewer-action-label">Report</span>
                  </button>
                </div>
              <% } else { %>
                <div class="rh-viewer-login-prompt">
                  <i class="bi bi-lock me-1"></i>
                  <a href="/auth/login" class="rh-viewer-login-link">Log in to like, share, and comment</a>
                </div>
              <% } %>

              <!-- Login message container fallback -->
              <div id="post-login-message" class="login-message text-center" style="display: none;">
                <p class="mb-0 text-muted">Please log in to like and share posts</p>
              </div>

              <!-- Inline Comments Section -->
              <div id="post-inline-comments-section" class="rh-viewer-comments-section">
                <div class="rh-viewer-comments-header">
                  <i class="bi bi-chat-dots-fill text-danger me-2"></i>
                  <span class="fw-bold">Comments (<span id="post-inline-comments-count">0</span>)</span>
                </div>
                
                <!-- Comments List -->
                <div id="post-inline-comments-list" class="rh-viewer-comments-list">
                  <div class="text-center text-muted py-3">Loading comments...</div>
                </div>
              </div>
            </div>

            <!-- Add Comment Input (Pinned at Bottom of Info Panel) -->
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <div class="rh-viewer-comment-input-wrap">
                <input type="text" id="postViewerNewComment" class="form-control rh-viewer-comment-input" placeholder="Add a comment...">
                <button class="btn rh-viewer-comment-submit-btn" id="submitPostViewerCommentBtn" type="button" aria-label="Send Comment">
                  <i class="bi bi-send-fill"></i>
                </button>
              </div>
            <% } else { %>
              <div class="rh-viewer-comment-login-msg">
                <a href="/auth/login">Log in to join the conversation</a>
              </div>
            <% } %>
            
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.currentUserId = "<%= (typeof currentUser !== 'undefined' && currentUser && (currentUser._id || currentUser.id)) ? (currentUser._id || currentUser.id).toString() : '' %>";
</script>

<!-- Report Modal (Cream & Crimson) -->
<div class="modal fade" id="postViewerReportModal" tabindex="-1" style="z-index: 1070;">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rh-report-modal-content">
      <div class="modal-header rh-report-modal-header">
        <h5 class="modal-title" style="color: #9F190E; font-family: 'Titan One', sans-serif;">
          <i class="bi bi-flag-fill me-2"></i>Report Post
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <p style="color: #25211F; font-size: 0.95rem; margin-bottom: 12px;">Please let us know why you are reporting this content:</p>
        <textarea id="postViewerReportReason" class="form-control rh-report-textarea" rows="4" placeholder="Describe the issue..."></textarea>
      </div>
      <div class="modal-footer rh-report-modal-footer">
        <button type="button" class="btn rh-btn-cancel" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn rh-btn-submit" id="submitPostViewerReportBtn">Submit Report</button>
      </div>
    </div>
  </div>
</div>
