
<!-- Website Update Notification Banner -->
<div id="websiteUpdateBanner" class="alert alert-info mb-0 website-update-banner d-none" role="alert">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center flex-nowrap overflow-hidden" style="flex-wrap: nowrap !important;">
        <i class="bi bi-megaphone-fill me-1"></i>
        <strong class="me-2" style="white-space: nowrap;">New Update:</strong>
        <strong id="updateTitle" class="text-truncate" style="white-space: nowrap;">Loading update information...</strong>
      </div>
      <div class="d-flex align-items-center">
        <a href="#" id="updateLink" class="btn btn-sm btn-primary me-2">View Details</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" onclick="dismissUpdateBanner()"></button>
      </div>
    </div>
  </div>
</div>

<style>
  .website-update-banner {
    display: block !important;
    padding: 0.5rem 1rem !important;
    min-height: auto;
  }
  
  .website-update-banner .container {
    padding: 0;
  }
  
  .website-update-banner .d-flex {
    gap: 0.25rem;
  }
  
  .website-update-banner .flex-nowrap,
  .website-update-banner .d-flex {
    flex-wrap: nowrap !important;
    white-space: nowrap;
  }
  
  .website-update-banner.closing {
    opacity: 0;
    transform: translateY(-100%);
    transition: all 0.5s ease-in-out;
  }
  
  .website-update-banner.d-none {
    display: none !important;
  }
  
  .website-update-banner .text-truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
  }
  
  /* Compact layout for small devices */
  @media (max-width: 576px) {
    .website-update-banner {
      padding: 0.25rem 0.5rem !important;
      font-size: 0.875rem;
    }
    
    .website-update-banner .text-truncate {
      max-width: 100px;
    }
    
    .website-update-banner .btn-sm {
      padding: 0.125rem 0.25rem !important;
      font-size: 0.75rem;
    }
  }
  
  @media (max-width: 400px) {
    .website-update-banner .text-truncate {
      max-width: 70px;
    }
  }
</style>

