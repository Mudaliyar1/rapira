<script>
// Function to dismiss the update banner
function dismissUpdateBanner() {
  const banner = document.getElementById('websiteUpdateBanner');
  if (banner) {
    // Add closing animation class before hiding
    banner.classList.add('closing');
    
    // Wait for animation to complete before hiding
    setTimeout(() => {
      // Remove the element from the layout flow completely
      banner.style.display = 'none';
      banner.style.visibility = 'hidden';
      // Add d-none class as backup
      banner.classList.add('d-none');
      // Remove the closing class to reset for next time
      banner.classList.remove('closing');
      
      // Store in localStorage that this update has been dismissed
      const updateId = banner.dataset.updateId;
      if (updateId) {
        localStorage.setItem('dismissedUpdate_' + updateId, 'true');
      }
    }, 500); // Match the animation duration (0.5s)
  }
}

// Function to show the update banner
function showUpdateBanner(update) {
  const banner = document.getElementById('websiteUpdateBanner');
  const title = document.getElementById('updateTitle');
  const link = document.getElementById('updateLink');
  
  if (banner && title && link) {
    // Truncate title to 5 characters with ellipsis if it exceeds 5 characters
    let displayTitle = update.title || '';
    if (displayTitle.length > 5) {
      displayTitle = displayTitle.substring(0, 5) + '...';
    }
    title.textContent = displayTitle;
    link.href = '/website-updates/' + update._id;  // Link to specific update
    // Ensure the link works properly
    link.onclick = function(e) {
      e.preventDefault();
      // Navigate to the specific update page
      window.location.href = '/website-updates/' + update._id;
      return false;
    };
    banner.dataset.updateId = update._id;
    
    // Remove d-none class and ensure banner is visible
    banner.classList.remove('d-none');
    banner.style.display = 'block';
    
    // Auto-hide after 8 seconds if not interacted with (within the 5-10 second range)
    setTimeout(() => {
      if (!banner.classList.contains('d-none') && !banner.classList.contains('closing')) {
        // Add closing animation before hiding
        banner.classList.add('closing');
        
        // Wait for animation to complete before hiding
        setTimeout(() => {
          // Remove the element from the layout flow completely
          banner.style.display = 'none';
          banner.style.visibility = 'hidden';
          // Add d-none class as backup
          banner.classList.add('d-none');
          // Remove the closing class to reset for next time
          banner.classList.remove('closing');
        }, 500); // Match the animation duration (0.5s)
      }
    }, 8000);
  }
}

// Check for website updates when page loads
document.addEventListener('DOMContentLoaded', async function() {
  // Only show the update banner on the home page
  if (window.location.pathname === '/' || window.location.pathname === '') {
    // First, check if we have cached update data in localStorage
    const cachedUpdate = localStorage.getItem('cachedWebsiteUpdate');
    
    if (cachedUpdate) {
      try {
        const updateData = JSON.parse(cachedUpdate);
        const cacheTimestamp = localStorage.getItem('cachedWebsiteUpdateTimestamp');
        const cacheExpiry = 24 * 60 * 60 * 1000; // 24 hours in milliseconds
        
        // Check if cache is still valid (not older than 24 hours)
        if (cacheTimestamp && (Date.now() - parseInt(cacheTimestamp)) < cacheExpiry) {
          // Show the banner immediately with cached data
          const hasBeenDismissed = localStorage.getItem('dismissedUpdate_' + updateData._id) === 'true';
          if (!hasBeenDismissed) {
            showUpdateBanner(updateData);
          }
        }
      } catch (e) {
        console.error('Error parsing cached update:', e);
      }
    }
    
    try {
      // Fetch the latest active website update for ALL users
      const response = await fetch('/api/latest-website-update');
      if (response.ok) {
        const update = await response.json();
        if (update) {
          // Check if this update has already been dismissed
          const hasBeenDismissed = localStorage.getItem('dismissedUpdate_' + update._id) === 'true';
          if (!hasBeenDismissed) {
            // Update the cached data
            localStorage.setItem('cachedWebsiteUpdate', JSON.stringify(update));
            localStorage.setItem('cachedWebsiteUpdateTimestamp', Date.now().toString());
            
            // Show the banner with fresh data
            showUpdateBanner(update);
          } else {
            // If the current update has been dismissed, clear the cache
            localStorage.removeItem('cachedWebsiteUpdate');
            localStorage.removeItem('cachedWebsiteUpdateTimestamp');
          }
        } else {
          // If no update is returned, clear the cache
          localStorage.removeItem('cachedWebsiteUpdate');
          localStorage.removeItem('cachedWebsiteUpdateTimestamp');
        }
      }
    } catch (error) {
      console.error('Error fetching website update:', error);
    }
  }
});
</script>
