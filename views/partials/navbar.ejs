
<nav class="navbar navbar-expand-lg navbar-dark navbar-glass">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <span class="fs-4 fw-bold gradient-text-purple">RAPIRA</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <!-- Discover Dropdown -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= typeof path !== 'undefined' && (path === '/' || path && (path.startsWith('/content') || path.startsWith('/concerts') || path.startsWith('/daily-concerts') || (path.startsWith('/artists') && !path.includes('dashboard')))) ? 'active' : '' %>"
             href="#" id="discoverDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-compass me-1"></i> Discover
          </a>
          <ul class="dropdown-menu glass-card-dark" aria-labelledby="discoverDropdown">
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path === '/' ? 'active' : '' %>" href="/"><i class="bi bi-house-door me-2"></i>Home</a></li>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/content') ? 'active' : '' %>" href="/content"><i class="bi bi-collection me-2"></i>Content Library</a></li>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/concerts') ? 'active' : '' %>" href="/concerts"><i class="bi bi-music-note-beamed me-2"></i>Concerts</a></li>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/daily-concerts') ? 'active' : '' %>" href="/daily-concerts"><i class="bi bi-calendar-event me-2"></i>Daily Concerts</a></li>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/artists') && !path.includes('dashboard') ? 'active' : '' %>" href="/artists"><i class="bi bi-person-badge me-2"></i>Artists</a></li>
          </ul>
        </li>

        <!-- Services Dropdown -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= typeof path !== 'undefined' && path && (path.startsWith('/team-requirement') || path.startsWith('/find-my-artist')) ? 'active' : '' %>"
             href="#" id="servicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-gear me-1"></i> Services
          </a>
          <ul class="dropdown-menu glass-card-dark" aria-labelledby="servicesDropdown">
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/team-requirement') ? 'active' : '' %>" href="/team-requirement"><i class="bi bi-people-fill me-2"></i>Team Requirement</a></li>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/find-my-artist') ? 'active' : '' %>" href="/find-my-artist"><i class="bi bi-search me-2"></i>Find My Artist</a></li>
          </ul>
        </li>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (typeof isArtist !== 'undefined' && isArtist) { %>
            <li class="nav-item">
              <a class="nav-link <%= typeof path !== 'undefined' && path && path.includes('dashboard') ? 'active' : '' %>" href="/artists/dashboard">Artist Dashboard</a>
            </li>
          <% } %>
          <% if (typeof isAdmin !== 'undefined' && isAdmin || typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
            <li class="nav-item">
              <a class="nav-link <%= typeof path !== 'undefined' && path && path.startsWith('/admin') ? 'active' : '' %>" href="/admin">Admin Dashboard</a>
            </li>
          <% } %>
        <% } %>
      </ul>
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <% if (typeof currentUser !== 'undefined' && currentUser && typeof hasRoles !== 'undefined' && hasRoles && typeof isArtist !== 'undefined' && !isArtist) { %>
          <li class="nav-item me-2">
            <a class="nav-link position-relative" href="/messages">
              <i class="bi bi-chat-dots"></i> Messages
            </a>
          </li>
        <% } %>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <% if (currentUser.profileImage) { %>
                <img src="<%= currentUser.profileImage %>" alt="Profile" class="rounded-circle me-2" width="32" height="32" style="object-fit: cover; border: 2px solid var(--primary);">
              <% } else { %>
                <i class="bi bi-person-circle me-2"></i>
              <% } %>
              <%= currentUser.name %>
            </a>
            <ul class="dropdown-menu glass-card-dark dropdown-menu-end" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item text-white" href="/users/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
              <li><a class="dropdown-item text-white" href="/tickets"><i class="bi bi-ticket-perforated me-2"></i>My Tickets</a></li>
              <% if (typeof isAdmin !== 'undefined' && isAdmin || typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
              <li><a class="dropdown-item text-white" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
              <% } %>
              <% if (typeof hasRoles !== 'undefined' && hasRoles && typeof isArtist !== 'undefined' && !isArtist) { %>
              <li><a class="dropdown-item text-white" href="/messages"><i class="bi bi-chat-dots me-2"></i>Messages</a></li>
              <li><a class="dropdown-item text-white" href="/messages/find"><i class="bi bi-people me-2"></i>Connect with Artists</a></li>
              <% } %>
              <li><hr class="dropdown-divider border-secondary"></li>
              <li><a class="dropdown-item text-white" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item me-2">
            <a class="nav-link btn-glass px-3 rounded-pill" href="/auth/login"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
          </li>
          <li class="nav-item">
            <a class="nav-link btn btn-gradient-purple px-3 rounded-pill" href="/auth/register"><i class="bi bi-person-plus me-1"></i> Register</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
