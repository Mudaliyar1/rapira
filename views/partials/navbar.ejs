
<nav class="navbar navbar-expand-lg navbar-dark navbar-glass">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <% if (typeof headerSettings !== 'undefined' && headerSettings) { %>
        <% if (headerSettings.brandType === 'logo' || headerSettings.brandType === 'both') { %>
          <% if (headerSettings.logoUrl) { %>
            <img src="<%= headerSettings.logoUrl %>" alt="<%= headerSettings.brandText || 'Logo' %>"
                 style="height: <%= headerSettings.logoHeight || 45 %>px; width: auto;"
                 class="<%= headerSettings.brandType === 'both' ? 'me-2' : '' %>">
          <% } %>
        <% } %>
        <% if (headerSettings.brandType === 'text' || (headerSettings.brandType === 'both' && headerSettings.showBrandText)) { %>
          <span class="fs-4 fw-bold gradient-text-purple"><%= headerSettings.brandText || 'RAPIRA' %></span>
        <% } %>
      <% } else { %>
        <!-- Fallback to default -->
        <span class="fs-4 fw-bold gradient-text-purple">RAPIRA</span>
      <% } %>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <!-- Discover Dropdown -->
        <% if (typeof menuSettings !== 'undefined' && menuSettings && menuSettings.discoverMenu && menuSettings.discoverMenu.enabled) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= typeof path !== 'undefined' && (path === '/' || path && (path.startsWith('/content') || path.startsWith('/concerts') || path.startsWith('/daily-concerts') || (path.startsWith('/artists') && !path.includes('dashboard')))) ? 'active' : '' %>"
             href="#" id="discoverDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-compass me-1"></i> Discover
          </a>
          <ul class="dropdown-menu glass-card-dark" aria-labelledby="discoverDropdown">
            <% if (menuSettings.discoverMenu.items.home) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path === '/' ? 'active' : '' %>" href="/"><i class="bi bi-house-door me-2"></i>Home</a></li>
            <% } %>
            <% if (menuSettings.discoverMenu.items.contentLibrary) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/content') ? 'active' : '' %>" href="/content"><i class="bi bi-collection me-2"></i>Content Library</a></li>
            <% } %>
            <% if (menuSettings.discoverMenu.items.concerts) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/concerts') ? 'active' : '' %>" href="/concerts"><i class="bi bi-music-note-beamed me-2"></i>Concerts</a></li>
            <% } %>
            <% if (menuSettings.discoverMenu.items.dailyConcerts) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/daily-concerts') ? 'active' : '' %>" href="/daily-concerts"><i class="bi bi-calendar-event me-2"></i>Daily Concerts</a></li>
            <% } %>
            <% if (menuSettings.discoverMenu.items.artists) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/artists') && !path.includes('dashboard') ? 'active' : '' %>" href="/artists"><i class="bi bi-person-badge me-2"></i>Artists</a></li>
            <% } %>
          </ul>
        </li>
        <% } %>

        <!-- Services Dropdown -->
        <% if (typeof menuSettings !== 'undefined' && menuSettings && menuSettings.servicesMenu && menuSettings.servicesMenu.enabled) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= typeof path !== 'undefined' && path && (path.startsWith('/team-requirement') || path.startsWith('/find-my-artist') || path.startsWith('/subscriptions')) ? 'active' : '' %>"
             href="#" id="servicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-gear me-1"></i> Services
          </a>
          <ul class="dropdown-menu glass-card-dark" aria-labelledby="servicesDropdown">
            <% if (menuSettings.servicesMenu.items.teamRequirement) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/team-requirement') ? 'active' : '' %>" href="/team-requirement"><i class="bi bi-people-fill me-2"></i>Team Requirement</a></li>
            <% } %>
            <% if (menuSettings.servicesMenu.items.findMyArtist) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/find-my-artist') ? 'active' : '' %>" href="/find-my-artist"><i class="bi bi-search me-2"></i>Find My Artist</a></li>
            <% } %>
            <% if (menuSettings.servicesMenu.items.subscriptions) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path.startsWith('/subscriptions') ? 'active' : '' %>" href="/subscriptions"><i class="bi bi-star me-2"></i>Subscriptions</a></li>
            <% } %>
          </ul>
        </li>
        <% } %>

        <!-- Help & Support Dropdown -->
        <% if (typeof menuSettings !== 'undefined' && menuSettings && menuSettings.helpSupportMenu && menuSettings.helpSupportMenu.enabled) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= typeof path !== 'undefined' && path && (path === '/contact' || path === '/terms-of-service' || path === '/privacy-policy' || path === '/refund-policy' || path === '/subscription-policy' || path === '/demo') ? 'active' : '' %>"
             href="#" id="helpDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-question-circle me-1"></i> Help & Support
          </a>
          <ul class="dropdown-menu glass-card-dark" aria-labelledby="helpDropdown">
            <% if (menuSettings.helpSupportMenu.items.demo) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path === '/demo' ? 'active' : '' %>" href="/demo"><i class="bi bi-play-circle me-2"></i>Interactive Demo</a></li>
            <% } %>
            <% if (menuSettings.helpSupportMenu.items.contact || menuSettings.helpSupportMenu.items.termsOfService || menuSettings.helpSupportMenu.items.privacyPolicy || menuSettings.helpSupportMenu.items.refundPolicy || menuSettings.helpSupportMenu.items.subscriptionPolicy) { %>
            <li><hr class="dropdown-divider border-secondary"></li>
            <% } %>
            <% if (menuSettings.helpSupportMenu.items.contact) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path === '/contact' ? 'active' : '' %>" href="/contact"><i class="bi bi-envelope me-2"></i>Contact Us</a></li>
            <% } %>
            <% if (menuSettings.helpSupportMenu.items.termsOfService) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path === '/terms-of-service' ? 'active' : '' %>" href="/terms-of-service"><i class="bi bi-file-text me-2"></i>Terms of Service</a></li>
            <% } %>
            <% if (menuSettings.helpSupportMenu.items.privacyPolicy) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path === '/privacy-policy' ? 'active' : '' %>" href="/privacy-policy"><i class="bi bi-shield-lock me-2"></i>Privacy Policy</a></li>
            <% } %>
            <% if (menuSettings.helpSupportMenu.items.refundPolicy) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path === '/refund-policy' ? 'active' : '' %>" href="/refund-policy"><i class="bi bi-cash-coin me-2"></i>Refund Policy</a></li>
            <% } %>
            <% if (menuSettings.helpSupportMenu.items.subscriptionPolicy) { %>
            <li><a class="dropdown-item text-white <%= typeof path !== 'undefined' && path && path === '/subscription-policy' ? 'active' : '' %>" href="/subscription-policy"><i class="bi bi-star me-2"></i>Subscription Policy</a></li>
            <% } %>
          </ul>
        </li>
        <% } %>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (typeof isArtist !== 'undefined' && isArtist) { %>
            <li class="nav-item">
              <a class="nav-link <%= typeof path !== 'undefined' && path && path.includes('dashboard') ? 'active' : '' %>" href="/artists/dashboard">Artist Dashboard</a>
            </li>
          <% } %>
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <li class="nav-item">
              <a class="nav-link <%= typeof path !== 'undefined' && path && path.startsWith('/admin') ? 'active' : '' %>" href="/admin">Admin Dashboard</a>
            </li>
          <% } %>
        <% } %>
      </ul>
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <div class="d-flex flex-column flex-lg-row align-items-center">
          <!-- Internet Speed Display -->
          <li class="nav-item me-lg-2 d-flex align-items-center">
            <div class="internet-speed-display" id="internetSpeedDisplay">
              <i class="bi bi-speedometer2 me-1"></i>
              <span id="internetSpeedValue">Measuring...</span>
              <span class="speed-indicator ms-1">
                <span class="speed-bar"></span>
                <span class="speed-bar"></span>
                <span class="speed-bar"></span>
                <span class="speed-bar"></span>
              </span>
            </div>
          </li>

          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <!-- Login Timer Display -->
          <li class="nav-item me-lg-2 d-flex align-items-center">
            <div class="login-timer-display" id="loginTimerDisplay">
              <i class="bi bi-clock-history me-1"></i>
              <span id="loginTimerValue">00:00:00</span>
            </div>
          </li>
          <% } %>
        </div>
        <% if (typeof currentUser !== 'undefined' && currentUser && typeof hasRoles !== 'undefined' && hasRoles && typeof isArtist !== 'undefined' && !isArtist) { %>
          <li class="nav-item me-2">
            <a class="nav-link position-relative" href="/messages">
              <i class="bi bi-chat-dots"></i> Messages
            </a>
          </li>
        <% } %>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <img src="<%= currentUser.profileImage || '/images/default-profile.svg' %>"
                   alt="Profile"
                   class="rounded-circle me-2"
                   width="32" height="32"
                   style="object-fit: cover; border: 2px solid var(--primary);"
                   onerror="this.onerror=null; this.src='/images/default-profile.svg';">
              <%= currentUser.name %>
            </a>
            <ul class="dropdown-menu glass-card-dark dropdown-menu-end" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item text-white" href="/users/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
              <li><a class="dropdown-item text-white" href="/tickets"><i class="bi bi-ticket-perforated me-2"></i>My Tickets</a></li>
              <li><a class="dropdown-item text-white" href="/subscriptions/my-subscriptions"><i class="bi bi-star me-2"></i>My Subscriptions</a></li>
              <% if (typeof hasRoles !== 'undefined' && hasRoles && typeof isArtist !== 'undefined' && !isArtist) { %>
              <li><a class="dropdown-item text-white" href="/messages"><i class="bi bi-chat-dots me-2"></i>Messages</a></li>
              <li><a class="dropdown-item text-white" href="/messages/find"><i class="bi bi-people me-2"></i>Connect with Artists</a></li>
              <% } %>
              <li><hr class="dropdown-divider border-secondary"></li>
              <li><a class="dropdown-item text-white" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
            </ul>
          </li>
        <% } else { %>
          <div class="auth-buttons-container d-flex">
            <li class="nav-item me-2">
              <a class="btn btn-outline-light px-3 rounded-pill auth-btn" href="/auth/login"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
            </li>
            <li class="nav-item">
              <a class="btn btn-gradient-purple px-3 rounded-pill auth-btn" href="/auth/register"><i class="bi bi-person-plus me-1"></i> Register</a>
            </li>
          </div>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
