<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Venue Dashboard' %> - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile-images.css">
  <!-- Venue Dashboard CSS -->
  <link rel="stylesheet" href="/css/venue-dashboard.css">
  <!-- Loading Spinner CSS -->
  <link rel="stylesheet" href="/css/loading-spinner.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (typeof extraStyles !== 'undefined') { %>
    <%- extraStyles %>
  <% } %>
</head>
<body>
  <div class="admin-layout venue-content">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white p-0" id="venueSidebar">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0" style="color: var(--secondary) !important;">
          <i class="bi bi-building me-1"></i>Venue Dashboard
        </h5>
        <button class="btn btn-sm btn-outline-light" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <img src="<%= (typeof currentUser !== 'undefined' && currentUser.profileImage) ? currentUser.profileImage : '/images/default-profile.svg' %>"
                 alt="<%= typeof currentUser !== 'undefined' ? currentUser.name : 'User' %>"
                 class="rounded-circle"
                 width="48" height="48"
                 style="object-fit: cover;"
                 onerror="this.onerror=null; this.src='/images/default-profile.svg';">
          </div>
          <div>
            <h6 class="mb-0"><%= typeof currentUser !== 'undefined' ? currentUser.name : 'Venue Owner' %></h6>
            <small class="text-muted">Venue Manager</small>
          </div>
        </div>
        <ul class="nav flex-column">
          <!-- Main Navigation -->
          <li class="nav-item mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Main</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/venues" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/venues' ? 'active bg-primary' : '' %>">
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
          </li>

          <!-- Venues Management -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Venues</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/venues" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/venues' ? 'active bg-primary' : '' %>">
              <i class="bi bi-building me-2"></i> My Venues
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/venue-requests" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/venue-requests' ? 'active bg-primary' : '' %>">
              <i class="bi bi-file-earmark-text me-2"></i> Venue Requests
            </a>
          </li>

          <!-- Bookings & Events -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Events</span>
            </div>
          </li>
          <% if (typeof venue !== 'undefined' && venue) { %>
            <li class="nav-item mb-2">
              <a href="/users/venues/<%= venue._id %>/bookings" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath.includes('/bookings') ? 'active bg-primary' : '' %>">
                <i class="bi bi-calendar-event me-2"></i> Bookings
              </a>
            </li>
          <% } else { %>
            <li class="nav-item mb-2">
              <a href="#" class="nav-link text-white p-2 rounded disabled" style="opacity: 0.5; cursor: not-allowed;" title="View a venue first">
                <i class="bi bi-calendar-event me-2"></i> Bookings
              </a>
            </li>
          <% } %>
          <li class="nav-item mb-2">
            <a href="#" class="nav-link text-white p-2 rounded" onclick="alert('Select a venue to view concerts'); return false;">
              <i class="bi bi-music-note-beamed me-2"></i> Concerts
            </a>
          </li>

          <!-- Analytics & Reports -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Analytics</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="#" class="nav-link text-white p-2 rounded" onclick="alert('Analytics coming soon'); return false;">
              <i class="bi bi-graph-up me-2"></i> Revenue
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="#" class="nav-link text-white p-2 rounded" onclick="alert('Analytics coming soon'); return false;">
              <i class="bi bi-bar-chart me-2"></i> Analytics
            </a>
          </li>

          <!-- Account Management -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Account</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/profile" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/profile' ? 'active bg-primary' : '' %>">
              <i class="bi bi-person me-2"></i> Profile
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/edit-profile" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/edit-profile' ? 'active bg-primary' : '' %>">
              <i class="bi bi-gear me-2"></i> Edit Profile
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/change-password" class="nav-link text-white p-2 rounded <%= typeof currentPath !== 'undefined' && currentPath === '/users/change-password' ? 'active bg-primary' : '' %>">
              <i class="bi bi-lock me-2"></i> Change Password
            </a>
          </li>

          <!-- Logout -->
          <li class="nav-item mt-3 mb-2 border-top border-secondary pt-3">
            <a href="/logout" class="nav-link text-danger p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 sticky-top bg-dark py-2 px-3 rounded">
        <div class="d-flex align-items-center">
          <button class="btn btn-outline-light me-2 p-1" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>
          <h2 class="fw-bold mb-0 fs-4" style="color: white;">
            <%= typeof title !== 'undefined' ? title : 'Venue Dashboard' %>
          </h2>
        </div>
        <div class="d-flex align-items-center gap-2">
          <a href="/" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-house me-1"></i> Home
          </a>
          <div class="dropdown">
            <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle me-1"></i> <%= typeof currentUser !== 'undefined' ? currentUser.name : 'User' %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/users/profile"><i class="bi bi-person me-2"></i>Profile</a></li>
              <li><a class="dropdown-item" href="/users/settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Flash Messages -->
      <% if (typeof locals.messages !== 'undefined') { %>
        <% if (messages.error && messages.error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Error!</strong>
            <% messages.error.forEach(msg => { %>
              <div><%= msg %></div>
            <% }); %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (messages.success && messages.success.length > 0) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <strong>Success!</strong>
            <% messages.success.forEach(msg => { %>
              <div><%= msg %></div>
            <% }); %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (messages.info && messages.info.length > 0) { %>
          <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            <% messages.info.forEach(msg => { %>
              <div><%= msg %></div>
            <% }); %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
      <% } %>

      <!-- Page Content -->
      <div class="venue-dashboard-content">
        <%- body %>
      </div>
    </div>
  </div>

  <!-- Loading Spinner -->
  <div id="loadingSpinner" class="loading-spinner" style="display: none;">
    <div class="spinner-content">
      <div class="spinner"></div>
      <p id="spinnerText">Loading...</p>
    </div>
  </div>

  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Loading Spinner JS -->
  <script src="/js/loading-spinner.js"></script>
  <script>
    // Sidebar Toggle
    document.getElementById('sidebarToggle')?.addEventListener('click', function() {
      const sidebar = document.getElementById('venueSidebar');
      sidebar?.classList.toggle('show');
    });

    document.getElementById('closeSidebar')?.addEventListener('click', function() {
      const sidebar = document.getElementById('venueSidebar');
      sidebar?.classList.remove('show');
    });

    // Initialize tooltips
    document.addEventListener('DOMContentLoaded', function() {
      const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });

      // Initialize spinner
      if (typeof LoadingSpinner !== 'undefined') {
        new LoadingSpinner().init();
      }
    });
  </script>
  <% if (typeof extraScripts !== 'undefined') { %>
    <%- extraScripts %>
  <% } %>
</body>
</html>
