<% if(typeof success !== 'undefined' && success && success.length > 0) { %>
  <div class="container mt-3">
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% } %>

<% if(typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="container mt-3">
    <div class="alert alert-danger alert-dismissible fade show fw-bold" role="alert" style="font-size: 1.05rem;">
      <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% } %>

<% if(typeof warning !== 'undefined' && warning && warning.length > 0) { %>
  <div class="container mt-3">
    <div class="alert alert-warning alert-dismissible fade show fw-bold" role="alert">
      <i class="bi bi-exclamation-circle-fill me-2"></i><%= warning %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% } %>

<% if(typeof info !== 'undefined' && info && info.length > 0) { %>
  <div class="container mt-3">
    <div class="alert alert-info alert-dismissible fade show" role="alert">
      <i class="bi bi-info-circle-fill me-2"></i><%= info %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% } %>
