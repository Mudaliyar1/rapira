<div id="stories-bar" class="d-flex gap-3 overflow-auto py-2" style="padding-left: 20px;">
  <!-- Filled by client via /stories/feed -->
</div>

<style>
  #story-media {
    transition: transform 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55), opacity 0.6s ease-in-out;
  }
  
  #story-media.transition-out {
    transform: rotateY(90deg) scale(0.8);
    opacity: 0;
  }
  
  #story-media.transition-in {
    transform: rotateY(0deg) scale(1);
    opacity: 1;
  }
  
  .story-progress-bars {
    display: flex !important;
    gap: 8px !important;
    padding: 12px 15px !important;
    background: rgba(0, 0, 0, 0.6) !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  
  .story-progress-bar {
    flex: 1 !important;
    height: 4px !important;
    background: rgba(139, 69, 255, 0.4) !important;
    border-radius: 3px !important;
    overflow: hidden !important;
    position: relative !important;
  }
  
  .story-progress-bar.viewed {
    background: rgba(139, 69, 255, 0.95) !important;
  }
  
  .story-progress-bar.active {
    background: rgba(139, 69, 255, 0.5) !important;
  }
  
  .story-progress-fill {
    height: 100% !important;
    background: #8b45ff !important;
    border-radius: 3px !important;
    width: 0% !important;
  }
  
  .story-progress-bar.active .story-progress-fill {
    animation: fillProgress 5s linear forwards !important;
  }
  
  @keyframes fillProgress {
    from { width: 0%; }
    to { width: 100%; }
  }
</style>

<div id="story-viewer" class="modal fade" tabindex="-1" data-bs-backdrop="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-white p-0">
      <div class="modal-body p-0 position-relative" style="perspective: 1000px;">
        <!-- Progress bars overlay - at very top -->
        <div class="story-progress-bars w-100" id="story-progress-container" style="display: flex !important; gap: 8px !important; padding: 12px 15px !important; background: rgba(0, 0, 0, 0.8) !important; width: 100% !important; box-sizing: border-box !important;">
          <!-- Filled by client -->
        </div>
        
        <!-- Artist header overlay -->
        <div class="position-absolute top-0 start-0 w-100 d-flex justify-content-between align-items-center p-3" style="z-index: 10; background: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent); padding-top: 30px !important;">
          <div class="d-flex align-items-center gap-2">
            <img id="story-artist-img" src="" class="rounded-circle" style="width:32px;height:32px;object-fit:cover" onerror="this.src='/images/default-profile.svg'" />
            <div class="d-flex flex-column">
              <span id="story-artist-name" class="fw-bold text-white">Artist</span>
              <small id="story-time-ago" class="text-white-50" style="font-size: 0.75rem; line-height: 1;">&nbsp;</small>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        
        <!-- Story media -->
        <div id="story-media" class="w-100 transition-in" style="max-height: 70vh; min-height: 500px; display:flex; align-items:center; justify-content:center; background:#000; margin-top: 30px;"></div>
        
        <!-- Story controls overlay -->
        <div class="position-absolute bottom-0 start-0 w-100 p-3" style="z-index: 10; background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div id="story-caption" class="small text-white"></div>
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <button class="btn btn-link text-white p-0" id="like-story-btn" style="font-size: 1.5rem;">
                <i class="bi bi-heart" id="like-icon"></i>
              </button>
            <% } else { %>
              <a href="/auth/login" class="btn btn-link text-primary p-0" style="font-size: 0.85rem; text-decoration: underline;">
                <i class="bi bi-lock me-1"></i>Login to like
              </a>
            <% } %>
          </div>
          <div class="d-flex justify-content-end align-items-center">
            <div>
              <button class="btn btn-sm btn-outline-light me-2" id="prev-story">Prev</button>
              <button class="btn btn-sm btn-outline-light" id="next-story">Next</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
</div>