<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Distributor Dashboard' %> - Rapira</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile-images.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (typeof extraStyles !== 'undefined') { %>
    <%- extraStyles %>
  <% } %>
</head>

<body>
  <div class="admin-layout artist-content">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white p-0" id="distributorSidebar">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0 text-primary fw-bold">Distributor Panel</h5>
        <button class="btn btn-sm btn-outline-light" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <img src="<%= (distributorUser && distributorUser.profileImage && distributorUser.profileImage !== '/images/default-profile.svg') ? distributorUser.profileImage : ('https://ui-avatars.com/api/?name=' + (distributorUser ? encodeURIComponent(distributorUser.name) : 'Distributor') + '&background=random&color=fff&bold=true') %>"
                 alt="<%= distributorUser ? distributorUser.name : 'Distributor' %>"
                 class="rounded-circle"
                 width="48" height="48"
                 style="object-fit: cover;"
                 onerror="this.onerror=null; this.src='/images/default-profile.svg';">
          </div>
          <div>
            <h6 class="mb-0 text-white"><%= distributorUser ? distributorUser.name : 'Distributor' %></h6>
            <small class="text-muted">Distributor</small>
          </div>
        </div>
        <ul class="nav flex-column">
          <!-- Main Navigation -->
          <li class="nav-item mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Management</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/distributor-dashboard" class="nav-link text-white p-2 rounded <%= currentPath === '/distributor-dashboard' ? 'active bg-primary' : '' %>">
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/distributor-dashboard/packages" class="nav-link text-white p-2 rounded <%= currentPath === '/distributor-dashboard/packages' ? 'active bg-primary' : '' %>">
              <i class="bi bi-box-seam me-2"></i> Packages
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/distributor-dashboard/requests" class="nav-link text-white p-2 rounded <%= currentPath === '/distributor-dashboard/requests' ? 'active bg-primary' : '' %>">
              <i class="bi bi-journal-text me-2"></i> Distribution Requests
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/distributor-dashboard/earnings" class="nav-link text-white p-2 rounded <%= currentPath === '/distributor-dashboard/earnings' ? 'active bg-primary' : '' %>">
              <i class="bi bi-wallet2 me-2"></i> Earnings
            </a>
          </li>



          <!-- Account -->
          <li class="nav-item mt-3 mb-2">
            <div class="sidebar-heading d-flex align-items-center px-2 py-1">
              <span class="text-muted small text-uppercase fw-bold">Account</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <a href="/users/profile" class="nav-link text-white p-2 rounded">
              <i class="bi bi-person me-2"></i> My Profile
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/" class="nav-link text-white p-2 rounded">
              <i class="bi bi-house me-2"></i> Back to Site
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/auth/logout" class="nav-link text-white p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
          <button class="btn btn-primary me-3" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>
          <h1 class="fw-bold mb-0 text-white"><%= typeof title !== 'undefined' ? title : 'Distributor Dashboard' %></h1>
        </div>
      </div>
