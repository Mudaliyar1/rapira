<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Producer Dashboard' %> - Rapira</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/profile-images.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (typeof extraStyles !== 'undefined') { %>
    <%- extraStyles %>
  <% } %>
</head>
<body>
  <div class="admin-layout artist-content">
    <div class="admin-sidebar bg-dark text-white p-0" id="producerSidebar">
      <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary">
        <h5 class="mb-0 text-info fw-bold">Producer Dashboard</h5>
        <button class="btn btn-sm btn-outline-light" id="closeSidebar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="p-3">
        <div class="admin-profile d-flex align-items-center mb-4">
          <div class="admin-avatar me-3">
            <img src="<%= (producerUser && producerUser.profileImage) ? producerUser.profileImage : '/images/default-profile.svg' %>"
                 alt="Producer"
                 class="rounded-circle"
                 width="48" height="48"
                 style="object-fit: cover;"
                 onerror="this.onerror=null; this.src='/images/default-profile.svg';">
          </div>
          <div>
            <h6 class="mb-0"><%= producerUser ? producerUser.name : 'Producer' %></h6>
            <small class="text-muted">Producer</small>
          </div>
        </div>

        <ul class="nav flex-column">
          <li class="nav-item mb-2">
            <a href="/producer-dashboard" class="nav-link text-white p-2 rounded <%= currentPath === '/producer-dashboard' ? 'active bg-primary' : '' %>">
              <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/messages" class="nav-link text-white p-2 rounded <%= currentPath.startsWith('/messages') ? 'active bg-primary' : '' %>">
              <i class="bi bi-chat-dots me-2"></i> Message Artists
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/messages/find" class="nav-link text-white p-2 rounded <%= currentPath === '/messages/find' ? 'active bg-primary' : '' %>">
              <i class="bi bi-people me-2"></i> Find Artists
            </a>
          </li>
          <li class="nav-item mt-3 mb-2">
            <a href="/users/profile" class="nav-link text-white p-2 rounded">
              <i class="bi bi-person me-2"></i> My Profile
            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/auth/logout" class="nav-link text-white p-2 rounded">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="admin-content">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
          <button class="btn btn-primary d-none d-md-block me-3" id="sidebarToggle">
            <i class="bi bi-list"></i>
          </button>
          <h1 class="fw-bold mb-0"><%= typeof title !== 'undefined' ? title : 'Producer Dashboard' %></h1>
        </div>
      </div>
