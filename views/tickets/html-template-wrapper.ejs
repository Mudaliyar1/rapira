<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rapira Concert Ticket</title>
  <style>
    body {
      font-family: 'Helvetica', 'Arial', sans-serif;
      margin: 0;
      padding: 20px;
      background-color: #f5f5f5;
      color: #333;
    }
    .ticket-container {
      max-width: 800px;
      margin: 0 auto;
      background-color: #fff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }
    .ticket-header {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: white;
      padding: 20px;
      text-align: center;
      position: relative;
    }
    .ticket-header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
    }
    .ticket-status {
      position: absolute;
      top: 20px;
      right: 20px;
      background-color: #fff;
      color: #333;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
    }
    .ticket-body {
      padding: 30px;
    }
    .concert-info {
      display: flex;
      margin-bottom: 30px;
      border-bottom: 1px dashed #ddd;
      padding-bottom: 20px;
    }
    .concert-details {
      flex: 3;
    }
    .concert-date {
      flex: 1;
      text-align: center;
      background-color: #f8f9fa;
      border-radius: 10px;
      padding: 15px;
      margin-left: 20px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .concert-title {
      font-size: 22px;
      font-weight: 700;
      margin: 0 0 10px 0;
      color: #333;
    }
    .concert-info-item {
      margin-bottom: 5px;
      color: #555;
    }
    .concert-info-item i {
      width: 20px;
      color: #6366f1;
      margin-right: 5px;
    }
    .info-section {
      display: flex;
      margin-bottom: 30px;
    }
    .info-column {
      flex: 1;
      padding-right: 20px;
    }
    .info-title {
      font-size: 18px;
      font-weight: 700;
      margin: 0 0 15px 0;
      color: #333;
      border-bottom: 2px solid #6366f1;
      padding-bottom: 5px;
      display: inline-block;
    }
    .info-item {
      margin-bottom: 15px;
    }
    .info-label {
      font-weight: 600;
      color: #555;
      margin-bottom: 5px;
      display: block;
    }
    .info-value {
      color: #333;
    }
    .ticket-footer {
      background-color: #f8f9fa;
      padding: 20px;
      text-align: center;
      border-top: 1px solid #eee;
    }
    .logo {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .logo img {
      height: 30px;
      margin-right: 10px;
    }
    .logo-text {
      font-weight: 700;
      color: #333;
    }
    .month {
      text-transform: uppercase;
      font-size: 14px;
      font-weight: 600;
      color: #6366f1;
    }
    .day {
      font-size: 32px;
      font-weight: 700;
      line-height: 1;
      color: #333;
    }
    .barcode {
      text-align: center;
      margin: 20px 0;
    }
    .barcode-img {
      height: 50px;
      max-width: 80%;
    }
    .disclaimer {
      font-size: 12px;
      color: #777;
      text-align: center;
      margin-top: 20px;
    }
    .text-center {
      text-align: center;
    }
    .qr-code-container {
      background-color: white;
      padding: 10px;
      border-radius: 8px;
      display: inline-block;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      margin: 0 auto;
    }

    /* Button styles */
    .action-buttons {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 20px;
      margin-bottom: 20px;
      padding: 10px;
      background-color: #f8f9fa;
      border-radius: 8px;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 12px;
      border-radius: 4px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      font-size: 0.8rem;
      border: none;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background-color: #6c5ce7;
      color: white;
    }

    .btn-info {
      background-color: #00cec9;
      color: white;
    }

    .btn-secondary {
      background-color: #b2bec3;
      color: white;
    }

    .btn i {
      margin-right: 5px;
    }

    @media print {
      body {
        background-color: #fff;
        padding: 0;
      }
      .ticket-container {
        box-shadow: none;
        max-width: 100%;
      }
      .action-buttons {
        display: none;
      }
    }
  </style>
</head>
<body>
  <%- include('html-template', { ticket, concert, isDeletedConcert, refundRequest }) %>

  <% if (typeof downloadMode === 'undefined' || !downloadMode) { %>
  <div class="action-buttons">
    <% if (typeof refundRequest !== 'undefined' && refundRequest) { %>
      <a href="/refund-requests/view/<%= refundRequest._id %>" class="btn btn-info">
        <i class="bi bi-eye"></i> View Refund Request
      </a>
    <% } %>
    <a href="/tickets/<%= ticket._id %>/download" class="btn btn-primary">
      <i class="bi bi-download"></i> Download PDF
    </a>
    <a href="/tickets" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Back to Tickets
    </a>
  </div>
  <% } %>

  <style>
    /* Add Bootstrap Icons */
    @import url("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css");
  </style>
</body>
</html>
