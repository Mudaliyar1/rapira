<link rel="stylesheet" href="/css/ticket-details.css">

<section class="ticket-stage py-5">
  <div class="container ticket-shell">
    <div class="ticket-topbar mb-4">
      <div>
        <p class="ticket-kicker mb-1">Rapira Pass</p>
        <h1 class="ticket-page-title mb-0">Ticket Details</h1>
      </div>
      <a href="/tickets" class="btn btn-outline-light btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to My Tickets
      </a>
    </div>

    <% if (concert && concert.status === 'cancelled' && ticket.paymentStatus !== 'refunded' && (!refundRequest || refundRequest.status !== 'approved')) { %>
      <div class="ticket-alert ticket-alert-warning mb-4">
        <h5 class="mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Concert Cancelled</h5>
        <p class="mb-0">This event was cancelled. You can request a refund below.</p>
      </div>
    <% } %>

    <% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %>
      <div class="ticket-alert ticket-alert-danger mb-4">
        <h5 class="mb-1"><i class="bi bi-x-octagon-fill me-2"></i>Ticket Refunded</h5>
        <p class="mb-0">This ticket is refunded and cannot be used for entry.</p>
      </div>
    <% } %>

    <% 
      const qty = ticket.quantity || 1;
      const validatedCount = ticket.validatedTicketsCount || 0;
      const remaining = Math.max(0, qty - validatedCount);

      let bookingHours = (concert && concert.venueBooking && concert.venueBooking.bookingHours) ? concert.venueBooking.bookingHours : 1;
      let startTime12hr = concert ? String(concert.time || '').trim() : '';
      let endTime12hr = '';

      const to12 = (h, m) => {
        const p = h >= 12 ? 'PM' : 'AM';
        let hh = h % 12;
        if (hh === 0) hh = 12;
        return `${hh}:${String(m).padStart(2, '0')} ${p}`;
      };

      if (concert) {
        const rawTime = String(concert.time || '').trim();
        const plainMatch = rawTime.match(/^(\d{1,2}):(\d{2})$/);
        const amPmMatch = rawTime.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);

        if (plainMatch || amPmMatch) {
          let h = plainMatch ? parseInt(plainMatch[1], 10) : parseInt(amPmMatch[1], 10);
          const m = plainMatch ? parseInt(plainMatch[2], 10) : parseInt(amPmMatch[2], 10);

          if (amPmMatch) {
            const period = amPmMatch[3].toUpperCase();
            if (period === 'PM' && h < 12) h += 12;
            if (period === 'AM' && h === 12) h = 0;
          }

          startTime12hr = to12(h, m);
          let endHour = h + bookingHours;
          if (endHour >= 24) {
            endHour -= 24;
            endTime12hr = `${to12(endHour, m)} (+1 day)`;
          } else {
            endTime12hr = to12(endHour, m);
          }
        } else {
          endTime12hr = rawTime || 'Not set';
        }
      }

      const cardStatus = ticket.paymentStatus === 'completed' ? 'Confirmed' : (ticket.paymentStatus === 'refunded' ? 'Refunded' : ticket.paymentStatus);
      const canAskRefund = !ticket.attended;
      const canDeleteTicket = concert && isPastConcert;
    %>

    <div class="ticket-main-card">
      <div class="ticket-main-head">
        <div>
          <p class="ticket-kicker mb-1">Entry Pass</p>
          <h2 class="ticket-title mb-1"><%= isDeletedConcert ? 'Concert Unavailable' : concert.title %></h2>
          <p class="ticket-subtitle mb-0"><%= isDeletedConcert ? 'This concert record was removed.' : 'Keep this page ready at entry gate.' %></p>
        </div>
        <div class="ticket-status-stack">
          <% if (typeof refundRequest !== 'undefined' && refundRequest) { %>
            <span class="status-pill refund-pill">Refund: <%= refundRequest.status.charAt(0).toUpperCase() + refundRequest.status.slice(1) %></span>
          <% } %>
          <span class="status-pill"><%= cardStatus %></span>
        </div>
      </div>

      <% if (!isDeletedConcert) { %>
      <div class="ticket-schedule-grid">
        <div class="schedule-box">
          <span class="label">Date</span>
          <span class="value"><%= toISTDateString(concert.date) %></span>
        </div>
        <div class="schedule-box">
          <span class="label">Starts At</span>
          <span class="value"><%= startTime12hr %></span>
        </div>
        <div class="schedule-box">
          <span class="label">Ends At</span>
          <span class="value"><%= endTime12hr %></span>
        </div>
        <div class="schedule-box">
          <span class="label">Duration</span>
          <span class="value"><%= bookingHours %> hour<%= bookingHours > 1 ? 's' : '' %></span>
        </div>
      </div>
      <% } %>

      <div class="ticket-info-grid mt-4">
        <div class="info-panel">
          <h5 class="panel-title">Ticket Info</h5>
          <div class="row-line"><span>Ticket Number</span><strong><%= ticket.ticketNumber %></strong></div>
          <div class="row-line"><span>Quantity</span><strong><%= qty %> ticket<%= qty > 1 ? 's' : '' %></strong></div>
          <div class="row-line"><span>Booked On</span><strong><%= toISTDateString(ticket.purchaseDate) %></strong></div>
          <% if (!isDeletedConcert) { %>
            <div class="row-line"><span>Venue</span><strong><%= concert.venue && concert.venue.name ? concert.venue.name : (concert.venueName || 'Venue') %>, <%= concert.city %></strong></div>
            <% if (concert.venue && concert.venue.googleMapsLink) { %>
              <div class="row-line"><span>Google Location</span><strong><a href="<%= concert.venue.googleMapsLink %>" target="_blank" rel="noopener noreferrer">Open in Google Maps</a></strong></div>
            <% } %>
          <% } %>
        </div>

        <div class="info-panel">
          <h5 class="panel-title">Who Can Enter</h5>
          <% if (ticket.attendees && ticket.attendees.length > 0) { %>
            <% ticket.attendees.forEach((attendee, i) => { %>
              <div class="attendee-chip">
                <div>
                  <div class="attendee-name">Attendee <%= i + 1 %>: <%= attendee.name %></div>
                  <small>Age: <%= attendee.age %></small>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p class="mb-0 text-light">No attendee details found.</p>
          <% } %>
        </div>

        <div class="info-panel">
          <h5 class="panel-title">Payment</h5>
          <% if (ticket.paymentId) { %>
            <div class="row-line"><span>Payment ID</span><strong><%= ticket.paymentId %></strong></div>
          <% } %>
          <div class="row-line"><span>Paid</span><strong>₹<%= ticket.totalAmount %></strong></div>
          <% if (ticket.discountApplied && ticket.discountType === 'subscription' && ticket.originalAmount) { %>
            <div class="row-line"><span>Original</span><strong><s>₹<%= ticket.originalAmount %></s></strong></div>
            <div class="row-line"><span>Discount</span><strong class="text-success"><%= ticket.discountPercentage %>%</strong></div>
            <div class="row-line"><span>You Saved</span><strong class="text-success">₹<%= ticket.originalAmount - ticket.totalAmount %></strong></div>
          <% } %>
          <% if (ticket.commissionApplied && ticket.commissionPercentage) { %>
            <div class="row-line"><span>Platform Fee</span><strong class="text-warning">₹<%= ticket.commissionAmount %> (<%= ticket.commissionPercentage %>%)</strong></div>
          <% } %>
        </div>

        <div class="info-panel qr-panel">
          <h5 class="panel-title">Gate QR</h5>
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=<%= ticket._id %>" alt="Ticket QR" class="qr-image">
          <p class="qr-note mb-0">Show this at the entry gate.</p>
        </div>
      </div>

      <div class="attendance-strip mt-4">
        <div>
          <h6 class="mb-1">Attendance</h6>
          <p class="mb-0">
            <%= validatedCount %> validated / <%= qty %> total
            <% if (remaining > 0) { %>
              | <%= remaining %> left
            <% } %>
          </p>
        </div>
        <div class="attendance-badge <%= validatedCount > 0 ? 'ok' : 'pending' %>">
          <%= validatedCount > 0 ? 'Used' : 'Not Used Yet' %>
        </div>
      </div>

      <div class="ticket-actions mt-4">
        <% if (canAskRefund) { %>
          <a href="/refund-requests/request/<%= ticket._id %>" class="btn btn-warning action-btn">
            <i class="bi bi-arrow-counterclockwise me-2"></i><%= concert && concert.status === 'cancelled' ? 'Issue Refund Request' : 'Refund' %>
          </a>
        <% } %>
        <a href="/tickets/<%= ticket._id %>/download" class="btn btn-primary action-btn">
          <i class="bi bi-download me-2"></i>Download
        </a>
        <% if (canDeleteTicket) { %>
          <a href="/tickets/<%= ticket._id %>/delete" class="btn btn-danger action-btn" onclick="return confirm('Download ticket first as backup. Continue to delete?')">
            <i class="bi bi-trash me-2"></i>Delete
          </a>
        <% } %>
        <a href="/tickets" class="btn btn-light action-btn">
          <i class="bi bi-arrow-left me-2"></i>Back
        </a>
      </div>
    </div>

    <% if (!isDeletedConcert && concert && concert.artist && concert.artist.user) { %>
      <div class="artist-mini-card mt-4">
        <img src="<%= concert.artist.user.profileImage %>" alt="<%= concert.artist.user.name %>" class="artist-avatar" onerror="this.onerror=null;this.src='/images/default-profile.svg';">
        <div>
          <h6 class="mb-1"><%= concert.artist.user.name %></h6>
          <small class="text-white-50">Performer</small>
        </div>
        <a href="/artists/<%= concert.artist._id %>" class="btn btn-outline-light btn-sm ms-auto">View Artist</a>
      </div>
    <% } %>
  </div>
</section>

