<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticket Validation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body {
      background-color: #121212;
      color: #fff;
      min-height: 100vh;
      display: flex;
      align-items: center;
    }
    .scanner-overlay {
      position: relative;
      width: 300px;
      height: 300px;
      margin: 0 auto;
      border: 3px solid #007bff;
      border-radius: 10px;
      overflow: hidden;
    }
    .scanner-line {
      position: absolute;
      width: 100%;
      height: 3px;
      background-color: #007bff;
      box-shadow: 0 0 10px #007bff;
      animation: scan 2s infinite linear;
    }
    @keyframes scan {
      0% { top: 0; }
      50% { top: 100%; }
      100% { top: 0; }
    }
    .status-icon {
      font-size: 3rem;
    }
    .card {
      background-color: #1e1e1e;
      border: 1px solid #333;
    }
    .btn-primary {
      background-color: #007bff;
      border-color: #007bff;
    }
    .btn-outline-light {
      border-color: #666;
    }
    .btn-outline-light:hover {
      background-color: #333;
    }
    /* Ensure proper display states */
    .d-none {
      display: none !important;
    }
  </style>
</head>
<body>
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="text-center mb-5">
          <h1 class="display-5 fw-bold">Venue Ticket Validation</h1>
          <p class="lead text-white-50">Scan QR codes or enter ticket numbers to validate entry</p>
        </div>
        
        <% if (error) { %>
        <!-- Error Message -->
        <div class="card border-danger mb-4">
          <div class="card-body text-center">
            <div class="status-icon text-danger mb-3">
              <i class="bi bi-x-circle-fill"></i>
            </div>
            <h3 class="text-danger">Invalid Validation Link</h3>
            <p class="text-white"><%= error %></p>
            <p class="text-white-50">Please contact your administrator for a new validation link.</p>
          </div>
        </div>
        <% } else { %>
        
        <!-- Scanner Section -->
        <div class="card mb-4" id="scannerSection">
          <div class="card-body text-center">
            <h5 class="card-title mb-4">Scan QR Code</h5>
            <div class="scanner-overlay mb-3" id="scannerOverlay">
              <div class="scanner-line"></div>
            </div>
            <p class="text-white-50">Position QR code within the frame to scan</p>
            <button class="btn btn-outline-light btn-sm mt-2" id="manualToggle">
              <i class="bi bi-keyboard"></i> Enter Manually
            </button>
          </div>
        </div>
        
        <!-- Manual Input Section -->
        <div class="card mb-4 d-none" id="manualInputSection">
          <div class="card-body">
            <h5 class="card-title mb-3">Enter Ticket Number</h5>
            <div class="mb-3">
              <label for="ticketNumber" class="form-label">Ticket Number</label>
              <input type="text" class="form-control bg-dark text-white border-secondary" 
                     id="ticketNumber" placeholder="e.g., RPR-20251215-801203">
            </div>
            <button class="btn btn-primary w-100 mb-2" id="validateBtn">Validate Ticket</button>
            <button class="btn btn-outline-light btn-sm w-100" id="scanToggle">
              <i class="bi bi-qr-code-scan"></i> Scan QR Code
            </button>
          </div>
        </div>
        
        <!-- Result Card -->
        <div class="card d-none" id="resultCard">
          <div class="card-body text-center">
            <div id="resultIcon" class="status-icon mb-3"></div>
            <h3 id="resultTitle" class="mb-3"></h3>
            <p id="resultMessage" class="text-white mb-4"></p>
            
            <!-- Ticket Details -->
            <div id="ticketDetails" class="text-start d-none">
              <hr class="border-secondary">
              <h5 class="text-white">Ticket Details</h5>
              <div class="row">
                <div class="col-6">
                  <small class="text-white-50">Ticket ID</small>
                  <p id="ticketId" class="text-white mb-1"></p>
                </div>
                <div class="col-6">
                  <small class="text-white-50">Concert</small>
                  <p id="concertTitle" class="text-white mb-1"></p>
                </div>
              </div>
              <div class="row">
                <div class="col-6">
                  <small class="text-white-50">Date</small>
                  <p id="concertDate" class="text-white mb-1"></p>
                </div>
                <div class="col-6">
                  <small class="text-white-50">Ticket Holder</small>
                  <p id="ticketHolder" class="text-white mb-1"></p>
                </div>
              </div>
              <div class="row">
                <div class="col-6">
                  <small class="text-white-50">Quantity</small>
                  <p id="ticketQuantity" class="text-white mb-1"></p>
                </div>
                <div class="col-6">
                  <small class="text-white-50">Status</small>
                  <p id="ticketStatus" class="text-white mb-1"></p>
                </div>
              </div>
            </div>
            
            <button class="btn btn-outline-light mt-4" id="newValidation">
              <i class="bi bi-arrow-repeat"></i> New Validation
            </button>
          </div>
        </div>
        
        <% } %>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/html5-qrcode@2.3.8/minified/html5-qrcode.min.js"></script>
  <script>
    // Only run scanner initialization if there's no error
    <% if (!error) { %>
    // DOM Elements
    const scannerSection = document.getElementById('scannerSection');
    const scannerOverlay = document.getElementById('scannerOverlay');
    const manualToggle = document.getElementById('manualToggle');
    const manualInputSection = document.getElementById('manualInputSection');
    const scanToggle = document.getElementById('scanToggle');
    const ticketNumber = document.getElementById('ticketNumber');
    const validateBtn = document.getElementById('validateBtn');
    const resultCard = document.getElementById('resultCard');
    const resultIcon = document.getElementById('resultIcon');
    const resultTitle = document.getElementById('resultTitle');
    const resultMessage = document.getElementById('resultMessage');
    const ticketDetails = document.getElementById('ticketDetails');
    const ticketId = document.getElementById('ticketId');
    const concertTitle = document.getElementById('concertTitle');
    const concertDate = document.getElementById('concertDate');
    const ticketHolder = document.getElementById('ticketHolder');
    const ticketQuantity = document.getElementById('ticketQuantity');
    const ticketStatus = document.getElementById('ticketStatus');
    const newValidation = document.getElementById('newValidation');

    let html5QrCode;
    let isScanning = false;
    
    // Initialize QR Scanner
    function initScanner() {
      console.log("Initializing scanner...");
      
      // Clean up any existing scanner
      if (html5QrCode) {
        stopScanner().then(() => {
          html5QrCode = new Html5Qrcode("scannerOverlay");
          startScanner();
        }).catch(() => {
          html5QrCode = new Html5Qrcode("scannerOverlay");
          startScanner();
        });
      } else {
        html5QrCode = new Html5Qrcode("scannerOverlay");
        startScanner();
      }
    }

    // Start the scanner with proper error handling
    function startScanner() {
      const config = {
        fps: 10,
        qrbox: { width: 250, height: 250 },
        aspectRatio: 1.0
      };
      
      html5QrCode.start(
        { facingMode: "environment" },
        config,
        (decodedText, decodedResult) => {
          // QR code scanned successfully
          console.log("QR Code scanned:", decodedText);
          validateTicketFromQR(decodedText);
        },
        (errorMessage) => {
          // Quietly ignore scan failures but log to console for debugging
          console.log("QR Scan error (ignored):", errorMessage);
        }
      ).then(() => {
        console.log("Scanner started successfully");
        isScanning = true;
      }).catch(err => {
        console.error("Unable to start scanning", err);
        showMessage("Camera access denied. Please enable camera permissions.", "danger");
      });
    }

    // Stop QR Scanner
    function stopScanner() {
      if (html5QrCode && isScanning) {
        return html5QrCode.stop().then(() => {
          isScanning = false;
          console.log("Scanner stopped successfully");
        }).catch(err => {
          console.error("Unable to stop scanning", err);
          isScanning = false; // Force state update even if stop fails
        });
      }
      // Return a resolved promise if no scanner to stop
      return Promise.resolve();
    }
    
    // Validate ticket from QR code
    async function validateTicketFromQR(qrData) {
      try {
        // Extract ticket ID from QR code data (assuming it's a URL with ticket ID)
        const url = new URL(qrData);
        const ticketId = url.searchParams.get('ticket') || url.pathname.split('/').pop();
        
        if (ticketId) {
          await validateTicketById(ticketId);
        } else {
          showMessage('Invalid QR code format', 'danger');
        }
      } catch (error) {
        // If not a valid URL, treat as direct ticket ID
        await validateTicketById(qrData);
      }
    }
    
    // Validate ticket function
    async function validateTicket() {
      const ticketNum = ticketNumber.value.trim();
      const token = '<%= token || "" %>'; // Get token from template
      
      if (!ticketNum) {
        showMessage('Please enter a ticket number', 'danger');
        return;
      }
      
      // Note: We're not checking token validity here because it's checked server-side
      // Even if the token is invalid, we'll let the server handle the error response
      
      try {
        // Show loading state
        validateBtn.disabled = true;
        validateBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Validating...';
        
        // Call validation API with token
        const response = await fetch(`/api/tickets/validate/${token}/${encodeURIComponent(ticketNum)}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          }
        });
        
        const data = await response.json();
        
        if (response.ok) {
          showResult(true, data);
        } else {
          showResult(false, data);
        }
      } catch (error) {
        console.error('Validation error:', error);
        showResult(false, { message: 'Network error. Please try again.' });
      } finally {
        // Reset button state
        validateBtn.disabled = false;
        validateBtn.innerHTML = 'Validate Ticket';
      }
    }
    
    // Validate ticket by ID
    async function validateTicketById(ticketId) {
      const token = '<%= token || "" %>'; // Get token from template
      
      // Note: We're not checking token validity here because it's checked server-side
      // Even if the token is invalid, we'll let the server handle the error response
      
      try {
        // Call validation API with token
        const response = await fetch(`/api/tickets/validate/${token}/${encodeURIComponent(ticketId)}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          }
        });
        
        const data = await response.json();
        
        if (response.ok) {
          showResult(true, data);
        } else {
          showResult(false, data);
        }
      } catch (error) {
        console.error('Validation error:', error);
        showResult(false, { message: 'Network error. Please try again.' });
      }
    }
    
    // Show message
    function showMessage(message, type) {
      // For now, just log to console
      console.log(`${type}: ${message}`);
    }
    
    // Show validation result
    function showResult(isValid, data) {
      // Hide scanner/manual input
      scannerSection.classList.add('d-none');
      manualInputSection.classList.add('d-none');
      
      // Show result
      resultCard.classList.remove('d-none');
      
      if (isValid) {
        // Check if ticket is already validated
        const isAlreadyValidated = data.message && data.message.includes('already validated');
        
        if (isAlreadyValidated) {
          // Show in red for already validated tickets
          resultIcon.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger"></i>';
          resultIcon.className = 'status-icon text-danger';
          resultTitle.textContent = 'Ticket Already Validated';
          resultTitle.className = 'text-danger';
          resultMessage.textContent = 'This ticket was previously validated and marked as attended';
          
          // Show ticket details with red accent
          if (data.ticket) {
            ticketDetails.classList.remove('d-none');
            ticketId.textContent = data.ticket.ticketNumber || data.ticket._id;
            concertTitle.textContent = data.ticket.concert.title;
            concertDate.textContent = toISTDateString(data.ticket.concert.date);
            ticketHolder.textContent = data.ticket.user.name;
            ticketQuantity.textContent = data.ticket.quantity;
            ticketStatus.innerHTML = `<span class="badge bg-danger">ALREADY ATTENDED</span>`;
          }
        } else {
          // Show in green for newly validated tickets
          resultIcon.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i>';
          resultIcon.className = 'status-icon text-success';
          resultTitle.textContent = 'Valid Ticket';
          resultTitle.className = 'text-success';
          resultMessage.textContent = data.message || 'Ticket is valid and has been marked as attended';
          
          // Show ticket details
          if (data.ticket) {
            ticketDetails.classList.remove('d-none');
            ticketId.textContent = data.ticket.ticketNumber || data.ticket._id;
            concertTitle.textContent = data.ticket.concert.title;
            concertDate.textContent = toISTDateString(data.ticket.concert.date);
            ticketHolder.textContent = data.ticket.user.name;
            ticketQuantity.textContent = data.ticket.quantity;
            ticketStatus.innerHTML = `<span class="badge bg-success">ATTENDED</span>`;
          }
        }
      } else {
        resultIcon.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i>';
        resultIcon.className = 'status-icon text-danger';
        resultTitle.textContent = 'Invalid Ticket';
        resultTitle.className = 'text-danger';
        resultMessage.textContent = data.message || 'This ticket is not valid';
        ticketDetails.classList.add('d-none');
      }
    }
    
    // Reset validation form
    function resetValidation() {
      console.log("Resetting validation form");
      
      // Hide result card
      resultCard.classList.add('d-none');
      
      // Clear input
      ticketNumber.value = '';
      
      // Show scanner by default
      scannerSection.classList.remove('d-none');
      manualInputSection.classList.add('d-none');
      
      // Restart scanner if needed
      if (isScanning) {
        stopScanner().then(() => {
          initScanner();
        });
      } else {
        initScanner();
      }
    }
    
    // Event Listeners
    document.addEventListener('DOMContentLoaded', function() {
      console.log("DOM loaded, initializing validation page");
      
      // Initialize scanner
      console.log("Initializing scanner...");
      initScanner();
      
      // Toggle between scanner and manual input
      manualToggle.addEventListener('click', function() {
        console.log("Manual toggle clicked");
        scannerSection.classList.add('d-none');
        manualInputSection.classList.remove('d-none');
        stopScanner();
      });
      
      scanToggle.addEventListener('click', function() {
        console.log("Scan toggle clicked");
        manualInputSection.classList.add('d-none');
        scannerSection.classList.remove('d-none');
        initScanner();
      });
      
      // Validate button
      validateBtn.addEventListener('click', function() {
        console.log("Validate button clicked");
        validateTicket();
      });
      
      // New validation button
      newValidation.addEventListener('click', function() {
        console.log("New validation button clicked");
        resetValidation();
      });
      
      // Enter key in ticket number field
      ticketNumber.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          console.log("Enter key pressed in ticket number field");
          validateTicket();
        }
      });
    });
    
    // Cleanup on page unload
    window.addEventListener('beforeunload', function() {
      stopScanner();
    });
    <% } %>
  </script>
</body>
</html>