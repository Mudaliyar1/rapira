<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simple Camera Test</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #121212;
      color: #fff;
      min-height: 100vh;
      padding: 20px;
    }
    #video {
      width: 100%;
      max-width: 400px;
      height: 300px;
      border: 2px dashed #007bff;
      border-radius: 10px;
      background-color: #1e1e1e;
    }
    .card {
      background-color: #1e1e1e;
      border: 1px solid #333;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="text-center mb-4">
          <h1 class="display-6 fw-bold">Simple Camera Test</h1>
          <p class="lead text-white-50">Basic camera access test</p>
        </div>
        
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title mb-3">Camera Test</h5>
            
            <div class="text-center mb-3">
              <video id="video" autoplay playsinline></video>
            </div>
            
            <div class="d-grid gap-2">
              <button class="btn btn-primary" id="startBtn">Start Camera</button>
              <button class="btn btn-outline-light" id="stopBtn">Stop Camera</button>
            </div>
            
            <div class="mt-3">
              <h6>Status: <span id="status">Not started</span></h6>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // DOM Elements
    const video = document.getElementById('video');
    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');
    const status = document.getElementById('status');
    
    let stream = null;
    
    // Update status
    function updateStatus(text, isError = false) {
      status.textContent = text;
      status.className = isError ? 'text-danger' : 'text-success';
    }
    
    // Start camera
    async function startCamera() {
      try {
        updateStatus('Requesting camera access...');
        
        // Get camera stream
        stream = await navigator.mediaDevices.getUserMedia({ 
          video: { 
            facingMode: 'environment',
            width: { ideal: 1280 },
            height: { ideal: 720 }
          } 
        });
        
        // Attach stream to video element
        video.srcObject = stream;
        updateStatus('Camera active');
        
      } catch (err) {
        console.error('Camera error:', err);
        updateStatus('Error: ' + err.message, true);
      }
    }
    
    // Stop camera
    function stopCamera() {
      if (stream) {
        const tracks = stream.getTracks();
        tracks.forEach(track => track.stop());
        stream = null;
        video.srcObject = null;
        updateStatus('Camera stopped');
      }
    }
    
    // Event listeners
    startBtn.addEventListener('click', startCamera);
    stopBtn.addEventListener('click', stopCamera);
  </script>
</body>
</html>