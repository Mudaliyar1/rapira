<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rapira Concert Ticket</title>
  <style>
    body {
      font-family: 'Helvetica', 'Arial', sans-serif;
      margin: 0;
      padding: 20px;
      background-color: #f5f5f5;
      color: #333;
    }
    .ticket-container {
      max-width: 800px;
      margin: 0 auto;
      background-color: #fff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }
    .ticket-header {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: white;
      padding: 20px;
      text-align: center;
      position: relative;
    }
    .ticket-header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
    }
    .ticket-status {
      position: absolute;
      top: 20px;
      right: 20px;
      background-color: #fff;
      color: #333;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
    }
    .ticket-body {
      padding: 30px;
    }
    .concert-info {
      display: flex;
      margin-bottom: 30px;
      border-bottom: 1px dashed #ddd;
      padding-bottom: 20px;
    }
    .concert-details {
      flex: 3;
    }
    .concert-date {
      flex: 1;
      text-align: center;
      background-color: #f8f9fa;
      border-radius: 10px;
      padding: 15px;
      margin-left: 20px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .concert-title {
      font-size: 22px;
      font-weight: 700;
      margin: 0 0 10px 0;
      color: #333;
    }
    .concert-info-item {
      margin-bottom: 5px;
      color: #555;
    }
    .concert-info-item i {
      width: 20px;
      color: #6366f1;
      margin-right: 5px;
    }
    .info-section {
      display: flex;
      margin-bottom: 30px;
    }
    .info-column {
      flex: 1;
      padding-right: 20px;
    }
    .info-title {
      font-size: 18px;
      font-weight: 700;
      margin: 0 0 15px 0;
      color: #333;
      border-bottom: 2px solid #6366f1;
      padding-bottom: 5px;
      display: inline-block;
    }
    .info-item {
      margin-bottom: 15px;
    }
    .info-label {
      font-weight: 600;
      color: #555;
      margin-bottom: 5px;
      display: block;
    }
    .info-value {
      color: #333;
    }
    .ticket-footer {
      background-color: #f8f9fa;
      padding: 20px;
      text-align: center;
      border-top: 1px solid #eee;
    }
    .logo {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .logo img {
      height: 30px;
      margin-right: 10px;
    }
    .logo-text {
      font-weight: 700;
      color: #333;
    }
    .month {
      text-transform: uppercase;
      font-size: 14px;
      font-weight: 600;
      color: #6366f1;
    }
    .day {
      font-size: 32px;
      font-weight: 700;
      line-height: 1;
      color: #333;
    }
    .barcode {
      text-align: center;
      margin: 20px 0;
      position: relative;
    }
    .barcode-img {
      height: 50px;
      max-width: 80%;
    }
    .disclaimer {
      font-size: 12px;
      color: #777;
      text-align: center;
      margin-top: 20px;
    }
    .text-center {
      text-align: center;
    }
    .qr-code-container {
      background-color: white;
      padding: 10px;
      border-radius: 8px;
      display: inline-block;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      margin: 0 auto;
      position: relative;
    }

    .qr-code-container.refunded,
    .barcode.refunded {
      opacity: 0.5;
    }

    /* Refunded ticket styles */
    .refunded-watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-30deg);
      font-size: 80px;
      font-weight: 900;
      color: rgba(220, 53, 69, 0.2);
      text-transform: uppercase;
      pointer-events: none;
      z-index: 10;
    }

    .refund-alert {
      background-color: rgba(220, 53, 69, 0.8);
      color: #ffffff;
      border: 1px solid rgba(220, 53, 69, 0.9);
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 20px;
      text-align: center;
    }

    .refund-alert h3 {
      margin-top: 0;
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
    }

    .refund-alert.pending {
      background-color: rgba(255, 193, 7, 0.7);
      color: #000000;
      border: 1px solid rgba(255, 193, 7, 0.8);
    }

    .refund-alert.pending h3 {
      color: #000000;
    }

    @media print {
      body {
        background-color: #fff;
        padding: 0;
      }
      .ticket-container {
        box-shadow: none;
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="ticket-container" style="position: relative;">
    <% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %>
      <div class="refunded-watermark">REFUNDED</div>
    <% } %>

    <div class="ticket-header">
      <h1>Concert Ticket</h1>
      <div class="ticket-status">
        <% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %>
          Refunded
        <% } else { %>
          <%= ticket.paymentStatus === 'completed' ? 'Confirmed' : ticket.paymentStatus %>
        <% } %>
      </div>
    </div>

    <div class="ticket-body">
      <% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %>
        <div class="refund-alert">
          <h3><i>⚠️</i> This Ticket Has Been Refunded</h3>
          <p>This ticket is no longer valid for entry. The refund has been processed and the amount will be credited to your bank account within 7-10 business days.</p>
        </div>
      <% } else if (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'pending') { %>
        <div class="refund-alert pending">
          <h3><i>⏳</i> Refund Pending</h3>
          <p>Your refund request for this ticket is currently under review. You will be notified once it is processed.</p>
          <p style="font-size: 12px; margin-top: 10px;">
            <strong>Request Date:</strong> <%= new Date(refundRequest.createdAt).toLocaleString() %>
          </p>
        </div>
      <% } %>
      <div class="concert-info">
        <div class="concert-details">
          <% if (isDeletedConcert) { %>
            <h2 class="concert-title">Concert Unavailable</h2>
            <p class="concert-info-item">
              <i>⚠️</i> This concert has been removed
            </p>
          <% } else { %>
            <h2 class="concert-title"><%= concert.title %></h2>
            <p class="concert-info-item">
              <i>📅</i> <%= new Date(concert.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>
            <p class="concert-info-item">
              <i>🕒</i> Concert Time: <%= concert.time %>
            </p>
            <% 
              // Get booking hours from concert venue booking data
              let bookingHours = (concert.venueBooking && concert.venueBooking.bookingHours) ? concert.venueBooking.bookingHours : 1;
              
              // Parse time and convert to 12-hour format with AM/PM
              let timeMatch = concert.time.match(/^(\d{1,2}):(\d{2})$/);
              let displayTime = concert.time;
              let startTime12hr = concert.time;
              let endTime12hr = '';
              
              if (timeMatch) {
                let hours = parseInt(timeMatch[1]);
                let minutes = timeMatch[2];
                
                // Convert to 12-hour format for start time
                let startAmPm = hours >= 12 ? 'PM' : 'AM';
                let startHour12 = hours % 12;
                if (startHour12 === 0) startHour12 = 12;
                startTime12hr = `${startHour12}:${minutes} ${startAmPm}`;
                
                // Calculate end time
                let endHours = hours + bookingHours;
                let endAmPm = endHours >= 12 ? 'PM' : 'AM';
                let endHour12 = endHours % 12;
                if (endHour12 === 0) endHour12 = 12;
                
                // Handle day overflow
                if (endHours >= 24) {
                  endHours = endHours - 24;
                  endAmPm = endHours >= 12 ? 'PM' : 'AM';
                  endHour12 = endHours % 12;
                  if (endHour12 === 0) endHour12 = 12;
                  endTime12hr = `${endHour12}:${minutes} ${endAmPm} (+1 day)`;
                } else {
                  endTime12hr = `${endHour12}:${minutes} ${endAmPm}`;
                }
              }
            %>
            <p class="concert-info-item">
              <i>⏱️</i> Duration: <%= bookingHours %> hour<%= bookingHours > 1 ? 's' : '' %>
            </p>
            <p class="concert-info-item">
              <i>▶️</i> Start Time: <%= startTime12hr %>
            </p>
            <p class="concert-info-item">
              <i>⏹️</i> End Time: <%= endTime12hr %>
            </p>
            <p class="concert-info-item">
              <i>📍</i> <%= concert.venue && concert.venue.name ? concert.venue.name : (concert.venueName || 'Venue') %>
              <% if (concert.venue && concert.venue.address) { %>
                <br><small style="color: #888; margin-left: 25px;">
                  <%= concert.venue.address %>
                  <% if (concert.venue.city) { %>, <%= concert.venue.city %><% } %>
                  <% if (concert.venue.state) { %>, <%= concert.venue.state %><% } %>
                  <% if (concert.venue.pincode) { %> - <%= concert.venue.pincode %><% } %>
                </small>
                <% if (concert.venue.googleMapsLink) { %>
                  <br><small style="margin-left: 25px; margin-top: 5px;">
                    <a href="<%= concert.venue.googleMapsLink %>" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                      📍 View on Google Maps
                    </a>
                  </small>
                <% } %>
              <% } else { %>
                <br><small style="color: #888; margin-left: 25px;">Full address will be provided closer to event date</small>
              <% } %>
            </p>
          <% } %>
        </div>
        <% if (!isDeletedConcert) { %>
          <div class="concert-date">
            <div class="month"><%= new Date(concert.date).toLocaleDateString('en-US', { month: 'short' }) %></div>
            <div class="day"><%= new Date(concert.date).getDate() %></div>
          </div>
        <% } %>
      </div>

      <div class="info-section">
        <div class="info-column">
          <h3 class="info-title">Ticket Information</h3>
          <div class="info-item">
            <span class="info-label">Ticket Number:</span>
            <span class="info-value"><%= ticket.ticketNumber %></span>
          </div>
          <div class="info-item">
            <span class="info-label">Quantity:</span>
            <span class="info-value"><%= ticket.quantity %> ticket<%= ticket.quantity > 1 ? 's' : '' %></span>
          </div>
          <div class="info-item">
            <span class="info-label">Purchase Date:</span>
            <span class="info-value"><%= new Date(ticket.purchaseDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
          </div>
        </div>
        <div class="info-column">
          <h3 class="info-title">Attendee Details</h3>
          <% ticket.attendees.forEach((attendee, index) => { %>
            <div class="info-item">
              <span class="info-label">Attendee <%= index + 1 %>:</span>
              <span class="info-value"><%= attendee.name %> (Age: <%= attendee.age %>)</span>
            </div>
          <% }); %>
        </div>
      </div>

      <% if (ticket.paymentId) { %>
        <div class="info-section">
          <div class="info-column">
            <h3 class="info-title">Payment Information</h3>
            <div class="info-item">
              <span class="info-label">Payment ID:</span>
              <span class="info-value"><%= ticket.paymentId %></span>
            </div>
            <div class="info-item">
              <span class="info-label">Amount Paid:</span>
              <span class="info-value">₹<%= ticket.totalAmount %></span>
            </div>
            <div class="info-item">
              <span class="info-label">Payment Status:</span>
              <span class="info-value">Completed</span>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Attendance Status -->
      <div class="info-section">
        <div class="info-column">
          <h3 class="info-title">Attendance Status</h3>
          <% 
            const validatedTicketsCount = ticket.validatedTicketsCount || 0;
            const totalTickets = ticket.quantity || 1;
            const remainingTickets = Math.max(0, totalTickets - validatedTicketsCount);
          %>
          <% if (validatedTicketsCount > 0) { %>
            <div style="background-color: rgba(40, 167, 69, 0.1); border: 1px solid rgba(40, 167, 69, 0.3); border-radius: 8px; padding: 15px; margin-top: 10px;">
              <div style="display: flex; align-items: center;">
                <span style="font-size: 24px; color: #28a745; margin-right: 10px;">✓</span>
                <div>
                  <h4 style="margin: 0 0 5px 0; color: #28a745;"><%= validatedTicketsCount %> of <%= totalTickets %> Ticket<%= totalTickets > 1 ? 's' : '' %> Validated</h4>
                  <p style="margin: 0; color: #666; font-size: 14px;">Successfully validated <%= validatedTicketsCount %> out of <%= totalTickets %> ticket<%= totalTickets > 1 ? 's' : '' %> for this purchase.</p>
                  <% if (ticket.attendedAt) { %>
                    <p style="margin: 5px 0 0 0; color: #888; font-size: 12px;">Last validated on <%= new Date(ticket.attendedAt).toLocaleString() %></p>
                  <% } %>
                  <% if (remainingTickets > 0) { %>
                    <p style="margin: 5px 0 0 0; color: #888; font-size: 12px;"><%= remainingTickets %> ticket<%= remainingTickets > 1 ? 's' : '' %> remaining to be validated</p>
                  <% } %>
                </div>
              </div>
            </div>
          <% } else { %>
            <div style="background-color: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3); border-radius: 8px; padding: 15px; margin-top: 10px;">
              <div style="display: flex; align-items: center;">
                <span style="font-size: 24px; color: #ffc107; margin-right: 10px;">⚠</span>
                <div>
                  <h4 style="margin: 0 0 5px 0; color: #ffc107;">No Tickets Validated Yet</h4>
                  <p style="margin: 0; color: #666; font-size: 14px;">This ticket has not been validated at the venue entrance yet.</p>
                  <p style="margin: 5px 0 0 0; color: #888; font-size: 12px;">Total tickets in this purchase: <%= totalTickets %></p>
                  <p style="margin: 5px 0 0 0; color: #888; font-size: 12px;">Tickets remaining to validate: <%= totalTickets %></p>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- QR Code Section -->
      <div class="info-section">
        <div class="info-column">
          <h3 class="info-title">Ticket QR Code</h3>
          <% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %>
            <p style="color: #721c24;"><strong>NOTICE:</strong> This QR code is no longer valid as the ticket has been refunded.</p>
          <% } else { %>
            <p>Scan this QR code at the venue entrance for quick verification.</p>
          <% } %>
        </div>
        <div class="info-column text-center">
          <div class="qr-code-container<% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %> refunded<% } %>">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= ticket._id %>" alt="Ticket QR Code" style="max-width: 150px;">
            <% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %>
              <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background-color: rgba(255,255,255,0.7);">
                <span style="color: #dc3545; font-weight: bold; font-size: 24px;">INVALID</span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="barcode<% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %> refunded<% } %>">
        <img class="barcode-img" src="https://barcode.tec-it.com/barcode.ashx?data=<%= ticket._id %>&code=Code128&multiplebarcodes=false&translate-esc=false&unit=Fit&dpi=96&imagetype=Gif&rotation=0&color=%23000000&bgcolor=%23ffffff&codepage=&qunit=Mm&quiet=0" alt="Barcode">
        <% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %>
          <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center;">
            <div style="background-color: rgba(255,255,255,0.7); padding: 5px 15px; border-radius: 4px;">
              <span style="color: #dc3545; font-weight: bold;">INVALID BARCODE</span>
            </div>
          </div>
        <% } %>
      </div>

      <div class="disclaimer">
        <% if (ticket.paymentStatus === 'refunded' || (typeof refundRequest !== 'undefined' && refundRequest && refundRequest.status === 'approved')) { %>
          This ticket has been refunded and is no longer valid for entry. Please do not attempt to use this ticket.
        <% } else { %>
          Please present this ticket at the venue entrance. This ticket is valid for one-time entry only.
        <% } %>
      </div>
    </div>

    <div class="ticket-footer">
      <div class="logo">
        <span class="logo-text">Rapira - Indian Rap Music Platform</span>
      </div>
    </div>
  </div>
</body>
</html>
