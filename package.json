{
  "name": "rapira",
  "version": "1.0.0",
  "description": "A dynamic platform for Indian rap artists",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "create-admin": "node scripts/create-admin.js",
    "reset-admin": "node scripts/reset-admin.js",
    "make-super-admin": "node scripts/make-super-admin.js",
    "use:dev": "node scripts/switch-env.js dev && echo \"Switched to development environment\"",
    "use:prod": "node scripts/switch-env.js prod && echo \"Switched to production environment\"",
    "fix:sessions": "node scripts/fix-sessions.js",
    "security-check": "node scripts/check-security.js",
    "precommit": "npm run security-check",
    "test": "jest --testTimeout=30000",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:merchandise": "jest tests/merchandise.test.js",
    "init:team-updates": "node scripts/init-team-updates.js"
  },
  "keywords": [
    "rap",
    "music",
    "concerts",
    "artists",
    "india"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.0.0",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "method-override": "^3.0.0",
    "mongodb": "^6.21.0",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^7.0.12",
    "puppeteer": "^24.8.2",
    "razorpay": "^2.9.1",
    "sharp": "^0.34.2",
    "sib-api-v3-sdk": "^8.5.0",
    "streamifier": "^0.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.6",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "models/**/*.js",
      "routes/**/*.js",
      "utils/**/*.js",
      "!tests/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "overrides": {
    "form-data": "^4.0.0",
    "qs": "^6.13.0",
    "multer": "^1.4.5-lts.1",
    "tar-fs": "^3.0.5"
  }
}
